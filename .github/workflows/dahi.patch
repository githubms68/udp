index 0000000..2dfcfde
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiSpeedRingView.kt
@@ -0,0 +1,346 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.os.SystemClock
+import android.util.AttributeSet
+import android.view.View
+import kotlin.math.abs
+import kotlin.math.min
+
+/**
+ * 大海版「指尖生花」：速度环（汽车码表式）。
+ *
+ * 位置：**预编辑行的左端**，接在编码文字（如 `dy`）的后面。
+ * 预编辑行本身就是一条水平 [android.widget.LinearLayout]，把它塞进这个容器的
+ * children 末尾，编码框一出现，环就自动跟着文字往右排 —— 不用算文字宽度，
+ * 也不会被候选词或工具栏按钮挡住。
+ *
+ * 表盘：
+ *  · 起点在正下方（18 点方向），顺时针扫过右侧、顶部、左侧，像汽车码表；
+ *  · 满圈 = [FULL_SCALE] **字/分**（不是百分比），数字就是真实速度；
+ *  · 单位是"字/分"，和「段落小结」同一个口径（以前这里是键/分，大约是字/分的两倍，
+ *    所以看起来总是偏大）；
+ *  · 只有 1 个采样点时不显示（[DahiSpeedMeter] 负责），静止 4 秒后自动隐去。
+ */
+class DahiSpeedRingView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+    private val density = resources.displayMetrics.density
+
+    private fun dp(value: Float): Float = value * density
+
+    private val ringPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeCap = Paint.Cap.ROUND
+        }
+
+    private val numPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.LEFT
+            isSubpixelText = true
+            typeface = Typeface.DEFAULT_BOLD
+        }
+
+    private val arcRect = RectF()
+    private val metrics = Paint.FontMetrics()
+
+    /** 平滑后的显示值：目标速度一变，指针是滑过去的，不是瞬移。 */
+    private var display = 0f
+
+    /** 上一次用于测量的缩放，变化时触发一次 requestLayout。 */
+    private var lastUserScale = -1f
+
+    /** 测量时按几位数字算宽（下限 3 位：1~2 位时底板不忽宽忽窄，4 位才扩一格）。 */
+    private var measureDigits = 3
+
+    /** 上一帧真实布局到的高度（AT_MOST 下拿不到行高，用它算宽度才准）。 */
+    private var lastLayoutHeight = 0
+
+    /**
+     * 预编辑底板的实际底色 + 校正后的四个颜色（底环 / 弧 / 脉冲 / 数字）。
+     *
+     * 白键盘 + 亮色模式下，高光色的数字几乎看不见 —— 所以画之前按底色做一次对比度校正；
+     * 对比度本来就够（深色主题）时原样返回，暗色模式一点不变。结果按
+     * 「配色 + 底色 + 圈数」缓存，逐帧绘制不重复计算。
+     */
+    private var toneKey: Triple<DahiKeyPalette.Colors, Int, Int>? = null
+    private val tones = IntArray(4)
+
+    /** 上一帧的整圈数，用来判断"刚转满一圈"。 */
+    private var lastLaps = 0
+
+    /** 刚转满一圈的时刻（uptimeMillis），0 表示还没闪过。 */
+    private var lapPulseAt = 0L
+
+    init {
+        numPaint.textSize = 9.5f * resources.displayMetrics.scaledDensity
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+    }
+
+    /**
+     * 环的几何（半径/字号）**只在这里算一次**，measure 与 draw 共用同一个结果。
+     *
+     * 之前两边各算一遍，而 AT_MOST 时拿不到真实行高（用 22dp 顶替），一旦真实行高不是 22dp
+     * （浮窗候选的行高更矮）→ 测量出来的宽度比实际绘制需要的窄 → 数字个位被切。
+     */
+    private class RingGeom(
+        val radius: Float,
+        val textSize: Float,
+    )
+
+    /** 几何缓存：onDraw 每帧都会要，避免每帧 new 一个对象。 */
+    private var geomCacheKey = Int.MIN_VALUE
+    private var geomCache = RingGeom(0f, 0f)
+
+    private fun geomFor(rawHeight: Int): RingGeom {
+        val cacheKey = (rawHeight shl 10) or (DahiKeyEffectsConfig.speedRingScale and 0x3FF)
+        if (cacheKey == geomCacheKey) return geomCache
+        // 行高夹在 16~52dp：预编辑行是 wrap_content，AT_MOST 传下来的「可用高度上限」可能几百 dp，
+        // 直接拿它算会得到比屏幕还宽的宽度 → 父级宽度变化 → 再量 → 死循环（界面卡死）。
+        val rowH = rawHeight.coerceIn(dp(16f).toInt(), dp(52f).toInt())
+        val scale = (rowH / dp(26f)).coerceIn(1f, 1.9f) * (DahiKeyEffectsConfig.speedRingScale / 100f)
+        val radius = min(dp(8.5f) * scale, rowH / 2f - dp(1.5f)).coerceAtLeast(dp(4f))
+        // 字号按缩放放大，但**上限压到行高的 66%**：以前 200% 时字号线性放大到 19sp，
+        // 比行高还高，数字顶部/底部被竖直裁掉（右侧看着像被切，其实是字形溢出）。
+        val baseTextSize = 9.5f * resources.displayMetrics.scaledDensity
+        val textSize = (baseTextSize * scale).coerceAtMost(rowH * 0.66f).coerceAtLeast(baseTextSize * 0.85f)
+        geomCacheKey = cacheKey
+        geomCache = RingGeom(radius, textSize)
+        return geomCache
+    }
+
+    /**
+     * 宽度 = 环 + 间距 + 数字实测宽。数字至少按 3 位留（1~2 位时底板不忽宽忽窄），
+     * 涨到 4 位才扩一格；右侧留 2.5dp 让数字避开底板右端圆角。
+     */
+    override fun onMeasure(
+        widthMeasureSpec: Int,
+        heightMeasureSpec: Int,
+    ) {
+        val h = MeasureSpec.getSize(heightMeasureSpec)
+        if (h <= 0) {
+            super.onMeasure(widthMeasureSpec, heightMeasureSpec)
+            return
+        }
+        val heightMode = MeasureSpec.getMode(heightMeasureSpec)
+        val outHeight = if (heightMode == MeasureSpec.EXACTLY) h else dp(22f).toInt()
+        // 算宽度时的行高：AT_MOST 传下来的是「可用高度上限」不是行高，优先用上一帧真实布局到的高度
+        val geomHeight =
+            when {
+                heightMode == MeasureSpec.EXACTLY -> h
+                lastLayoutHeight > 0 -> lastLayoutHeight
+                else -> outHeight
+            }
+        val geom = geomFor(geomHeight)
+        numPaint.textSize = geom.textSize
+        val textWidth = numPaint.measureText("8".repeat(measureDigits))
+        val desired = (dp(1.5f) + geom.radius * 2f + dp(2.5f) + textWidth + dp(2.5f)).toInt()
+        setMeasuredDimension(resolveSize(desired, widthMeasureSpec), outHeight)
+    }
+
+    /**
+     * 速度一变就重绘。
+     *
+     * 为什么需要它：静止 4 秒后 [onDraw] 会主动停止重绘（省电）。以前没有这个通知，
+     * 停下来之后再接着打，数字会一直是 0 —— 因为没有任何东西去触发一帧重绘，
+     * 画面上只剩背景那块底。
+     */
+    private val onSpeedChanged: () -> Unit = {
+        if (isAttachedToWindow) postInvalidateOnAnimation()
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        DahiSpeedMeter.addListener(onSpeedChanged)
+    }
+
+    override fun onDetachedFromWindow() {
+        DahiSpeedMeter.removeListener(onSpeedChanged)
+        super.onDetachedFromWindow()
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val now = SystemClock.uptimeMillis()
+        // 只看「速度环」自己的开关，不再看总开关：总开关只负责「一键全关 / 全开」这个动作，
+        // 关掉之后用户仍然可以单独把速度环打开 —— 有人只想要速度、不想要键盘上满地动效。
+        if (!DahiKeyEffectsConfig.speedRing) {
+            display = 0f
+            resetLaps()
+            return
+        }
+        // 「速度环大小」改了之后立即重新量一次（宽度是按缩放算的）
+        val userScaleNow = DahiKeyEffectsConfig.speedRingScale / 100f
+        if (lastUserScale != userScaleNow) {
+            lastUserScale = userScaleNow
+            requestLayout()
+        }
+        val target = DahiSpeedMeter.cpm(now).toFloat()
+        display += (target - display) * SMOOTHING
+        if (abs(target - display) < 0.5f) display = target
+        if (!DahiSpeedMeter.isActive(now) && display <= 0.5f) {
+            display = 0f
+            // 环隐去后再出现，要从"第 1 圈"重新算，否则上一次的圈数会让这次不闪
+            resetLaps()
+            return
+        }
+
+        val palette = DahiKeyPalette.resolve()
+        val cy = height / 2f
+        // 与 onMeasure 共用同一套几何：宽度就是按它算出来的，不会再出现「量得窄、画得宽」
+        val geom = geomFor(height)
+        val r = geom.radius
+        val cx = dp(1.5f) + r
+        numPaint.textSize = geom.textSize
+        // 行高或数字位数一变就重新量宽（底板像预编辑文字那样贴着内容走）。
+        // 只在这些「输入参数」变化时请求，收敛后自然停止，不会陷入测量死循环。
+        if (lastLayoutHeight != height) {
+            lastLayoutHeight = height
+            requestLayout()
+        }
+        val digits = display.toInt().toString().length.coerceAtLeast(3)
+        if (digits != measureDigits) {
+            measureDigits = digits
+            requestLayout()
+        }
+
+        // 不设上限：满一圈后接着转第二圈、第三圈……（数字也继续涨）
+        val turns = (display / FULL_SCALE).coerceAtLeast(0f)
+        val fraction = turns - kotlin.math.floor(turns.toDouble()).toFloat()
+        val fullLaps = kotlin.math.floor(turns.toDouble()).toInt()
+        // 圈层换色：第 1 圈主色 → 第 2 圈辅色 + 提亮 12%（最醒目）→ 第 3 圈辅色原色。
+        // 明度排序按「使用频率」配，而不是按速度高低（具体取色见 updateTones）。
+        val lapAlpha = (240 + fullLaps * 6).coerceAtMost(255)
+        val lapStroke = dp(1.7f) + dp(0.3f) * fullLaps.coerceAtMost(3)
+        val flash = pulseStrength(now, fullLaps)
+
+        // 按底板底色校正颜色（深色主题下与原来完全一致，白底上自动压深）
+        updateTones(palette, fullLaps)
+
+        // 底环（轨道）也跟着换色，整条环的"档位"一眼可辨，不再是同一圈灰色
+        ringPaint.strokeWidth = dp(1.7f)
+        ringPaint.color = withAlpha(tones[0], 58)
+        canvas.drawCircle(cx, cy, r, ringPaint)
+
+        if (turns > 0f) {
+            ringPaint.color = withAlpha(tones[1], lapAlpha)
+            ringPaint.strokeWidth = lapStroke
+            arcRect.set(cx - r, cy - r, cx + r, cy + r)
+            // 90° = 正下方（18 点），角度递增即顺时针 → 从底部往上转，与码表一致
+            val sweep = if (fullLaps > 0 && fraction < 0.02f) 360f else 360f * fraction
+            canvas.drawArc(arcRect, START_ANGLE, sweep, false, ringPaint)
+
+            // 满圈脉冲：刚转满一圈的瞬间，整条弧用高光色闪一下（0.34 秒线性衰减），
+            // 给"过线"一个瞬时的强提示 —— 静态换色负责持续可读，脉冲负责那一刻的察觉。
+            if (flash > 0f && sweep > 0f) {
+                ringPaint.color = withAlpha(tones[2], (250 * flash).toInt())
+                ringPaint.strokeWidth = lapStroke + dp(2.2f) * flash
+                canvas.drawArc(arcRect, START_ANGLE, sweep, false, ringPaint)
+            }
+        }
+
+        numPaint.color = withAlpha(tones[3], 248)
+        numPaint.getFontMetrics(metrics)
+        val baseline = cy - (metrics.ascent + metrics.descent) / 2f
+        canvas.drawText(display.toInt().toString(), cx + r + dp(2.5f), baseline, numPaint)
+
+        if (DahiSpeedMeter.isActive(now) || display > 0.5f || flash > 0f) postInvalidateOnAnimation()
+    }
+
+    private fun resetLaps() {
+        lastLaps = 0
+        lapPulseAt = 0L
+    }
+
+    /**
+     * 满圈脉冲强度（1 → 0 线性衰减）。
+     *
+     * 只在圈数"上涨"时重新点火；间隔小于 [PULSE_GUARD_MS] 的抖动不再重置，
+     * 免得速度在 240 上下浮动时一次接一次地闪。
+     */
+    private fun pulseStrength(
+        now: Long,
+        laps: Int,
+    ): Float {
+        if (laps > lastLaps && (lapPulseAt == 0L || now - lapPulseAt > PULSE_GUARD_MS)) {
+            lapPulseAt = now
+        }
+        lastLaps = laps
+        if (lapPulseAt == 0L) return 0f
+        val t = (now - lapPulseAt) / PULSE_MS.toFloat()
+        return if (t in 0f..1f) 1f - t else 0f
+    }
+
+    /** 朝白色方向提亮 [amount]（0~1），用于让同一色系的相邻档位拉开明度。 */
+    private fun lighten(
+        color: Int,
+        amount: Float,
+    ): Int = Color.rgb(
+        (Color.red(color) + (255 - Color.red(color)) * amount).toInt().coerceIn(0, 255),
+        (Color.green(color) + (255 - Color.green(color)) * amount).toInt().coerceIn(0, 255),
+        (Color.blue(color) + (255 - Color.blue(color)) * amount).toInt().coerceIn(0, 255),
+    )
+
+    /**
+     * 计算并缓存四个颜色（底环 / 弧 / 脉冲 / 数字），全部按**预编辑底板实际底色**校正对比度。
+     *
+     * 数字用最高门槛（4.5:1，正文级可读）；环的描边是图形，2.2:1 够用又不损失换圈的色相差异
+     * （如果门槛定太高，浅底上所有档位都会被压成深黑，换圈就看不出来了）。
+     */
+    private fun updateTones(
+        palette: DahiKeyPalette.Colors,
+        laps: Int,
+    ) {
+        val backdrop = DahiContrast.preeditBackdrop()
+        val key = Triple(palette, backdrop, laps)
+        if (key == toneKey) return
+        val lapColor =
+            when {
+                laps <= 0 -> palette.primary
+                laps == 1 -> lighten(palette.secondary, 0.12f)
+                else -> palette.secondary
+            }
+        tones[0] = DahiContrast.readableOn(lapColor, backdrop, 1.5f)
+        tones[1] = DahiContrast.readableOn(lapColor, backdrop, 2.2f)
+        tones[2] = DahiContrast.readableOn(palette.glow, backdrop, 1.8f)
+        tones[3] = DahiContrast.readableOn(palette.glow, backdrop, 4.5f)
+        toneKey = key
+    }
+
+    private fun withAlpha(
+        color: Int,
+        alpha: Int,
+    ): Int = Color.argb(alpha.coerceIn(0, 255), Color.red(color), Color.green(color), Color.blue(color))
+
+    companion object {
+        /** 控件宽度（dp）：环 + 右侧三位数字。主键盘与浮窗候选共用这个值。 */
+        const val WIDTH_DP = 46
+
+        /** 满圈对应的速度上限（字/分）。显示的数字是真实速度，不受它影响。 */
+        const val FULL_SCALE = 240f
+
+        /** 18 点方向 = canvas 的 90°。 */
+        const val START_ANGLE = 90f
+
+        const val SMOOTHING = 0.22f
+
+        /** 满圈脉冲的衰减时长（毫秒）。 */
+        const val PULSE_MS = 340L
+
+        /** 两次脉冲之间的最小间隔，防止速度在整圈线附近抖动时连环闪。 */
+        const val PULSE_GUARD_MS = 400L
+    }
+}
