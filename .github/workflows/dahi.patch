+    /**
+     * 点时段分布的柱子：看那一格的数据。
+     *
+     * 数据全都已经在 [DahiInputStats.Bucket] 里（hours / weekdays 两张表），
+     * 不需要新增任何存储，也不会影响输入法主路径 —— 纯展示。
+     */
+    private fun onHourBarTapped(index: Int) {
+        val ctx = requireContext()
+        val snap = runCatching { DahiInputStats.snapshot(period) }.getOrNull() ?: return
+        val isHour = hourMode == DahiHourChartView.Mode.HOURS
+        val label: String
+        val chars: Long
+        val total: Long
+        val rank: Int
+        val cells: Int
+        if (isHour) {
+            val hour = index.coerceIn(0, 23)
+            chars = snap.hours[hour.toString()] ?: 0L
+            total = snap.hours.values.sum()
+            val sorted = (0..23).sortedByDescending { snap.hours[it.toString()] ?: 0L }
+            rank = sorted.indexOf(hour) + 1
+            cells = 24
+            label = "$hour:00–${(hour + 1) % 24}:00"
+        } else {
+            // 显示顺序与图表一致：周一 … 周日
+            val order = listOf(2, 3, 4, 5, 6, 7, 1)
+            val day = order.getOrNull(index) ?: return
+            chars = snap.weekdays[day.toString()] ?: 0L
+            total = snap.weekdays.values.sum()
+            val sorted = order.sortedByDescending { snap.weekdays[it.toString()] ?: 0L }
+            rank = sorted.indexOf(day) + 1
+            cells = 7
+            val names = resources.getStringArray(R.array.dahi_week_names)
+            label = names.getOrElse(index) { "" }
+        }
+        if (total <= 0L) return
+        val text =
+            getString(
+                R.string.dahi_stats_slot_summary,
+                label,
+                chars,
+                formatPct(chars.toDouble() / total),
+                rank,
+                cells,
+            )
+        runCatching {
+            AlertDialog
+                .Builder(ctx)
+                .setTitle(if (isHour) R.string.dahi_stats_by_hour else R.string.dahi_stats_by_week)
+                .setMessage(text)
+                .setPositiveButton(android.R.string.ok, null)
+                .show()
+        }
+    }
