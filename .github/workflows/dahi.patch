@@ -0,0 +1,742 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.SharedPreferences
+import android.content.res.Configuration
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Matrix
+import android.graphics.drawable.Drawable
+import android.media.MediaPlayer
+import android.net.Uri
+import android.util.Base64
+import android.view.Surface
+import android.view.TextureView
+import android.view.View
+import android.widget.ImageView
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.data.theme.ColorManager
+import com.osfans.trime.util.appContext
+import org.json.JSONObject
+import timber.log.Timber
+import java.io.File
+import java.lang.ref.WeakReference
+
+/**
+ * 客户端「自定义键盘背景」（大海版）。
+ *
+ * 纯 App 层实现：**不写入 / 修改任何主题 yaml、`trime.yaml` 或用户方案**，因此与任何第三方主题互不冲突：
+ * - 总开关开启：用用户的图片 / 动图 / 视频覆盖当前主题自带的键盘背景；
+ * - 总开关关闭：完全不生效，主题自带背景照常显示。
+ *
+ * 支持：相册选图（含手动裁剪）、**GIF 动图**、**视频**、高斯模糊、透明度、填充模式、
+ * 横竖屏分别设置、候选栏单独背景；并可作为独立选项纳入「备份与还原」。
+ *
+ * 存储：默认 SharedPreferences（键前缀 `dahi_keybg_`），文件位于 `filesDir/dahi_keybg/`。
+ */
+object DahiKeyboardBackground {
+    const val KEY_PREFIX = "dahi_keybg_"
+    const val KEY_ENABLED = "dahi_keybg_enabled"
+    const val KEY_SEPARATE = "dahi_keybg_separate"
+    const val KEY_PORTRAIT = "dahi_keybg_portrait"
+    const val KEY_LANDSCAPE = "dahi_keybg_landscape"
+    const val KEY_MODE = "dahi_keybg_mode"
+    private const val KEY_MODE_PORTRAIT = "dahi_keybg_mode_portrait"
+    private const val KEY_MODE_LANDSCAPE = "dahi_keybg_mode_landscape"
+    private const val KEY_MODE_CANDIDATE = "dahi_keybg_mode_candidate"
+    private const val KEY_MODE_VIDEO = "dahi_keybg_mode_video"
+    const val KEY_OPACITY = "dahi_keybg_opacity"
+    const val KEY_BLUR = "dahi_keybg_blur"
+    const val KEY_SOURCE = "dahi_keybg_source"
+    const val KEY_CAND_ENABLED = "dahi_keybg_cand_enabled"
+    const val KEY_CAND_IMAGE = "dahi_keybg_candit"
+    const val KEY_VIDEO = "dahi_keybg_video"
+
+    /** 背景来源：相册 / 文件选择（静态或 GIF）。 */
+    const val SOURCE_GALLERY = 0
+
+    /** 背景来源：视频。 */
+    const val SOURCE_VIDEO = 2
+
+    /** 模糊滑块上限。 */
+    const val MAX_BLUR = 40
+
+    /** 备份时视频文件的大小上限（字节），超过则不纳入备份，避免备份文件过大。 */
+    private const val MAX_BACKUP_VIDEO_BYTES = 4 * 1024 * 1024
+
+    /** 图片加载上限边长（超过则按 inSampleSize 下采样，避免大图导致输入法进程 OOM）。 */
+    private const val MAX_DIM = 1920
+
+    private const val TAG = "DahiKeyboardBackground"
+
+    /** 填充模式。 */
+    enum class Mode { STRETCH, CENTER, TILE, FIT }
+
+    /** 图片用途槽位。 */
+    enum class Slot { PORTRAIT, LANDSCAPE, CANDIDATE, VIDEO }
+
+    private val prefs: SharedPreferences
+        get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    private fun dir(): File = File(appContext.filesDir, "dahi_keybg").apply { mkdirs() }
+
+    fun portraitFile(): File = File(dir(), "portrait.img")
+
+    fun landscapeFile(): File = File(dir(), "landscape.img")
+
+    fun candidateFile(): File = File(dir(), "candidate.img")
+
+    fun videoFile(): File = File(dir(), "background.mp4")
+
+    private fun fileFor(slot: Slot): File = when (slot) {
+        Slot.PORTRAIT -> portraitFile()
+        Slot.LANDSCAPE -> landscapeFile()
+        Slot.CANDIDATE -> candidateFile()
+        Slot.VIDEO -> videoFile()
+    }
+
+    private fun keyFor(slot: Slot): String = when (slot) {
+        Slot.PORTRAIT -> KEY_PORTRAIT
+        Slot.LANDSCAPE -> KEY_LANDSCAPE
+        Slot.CANDIDATE -> KEY_CAND_IMAGE
+        Slot.VIDEO -> KEY_VIDEO
+    }
+
+    // ---------------- 偏好读写 ----------------
+
+    fun isEnabled(): Boolean = prefs.getBoolean(KEY_ENABLED, false)
+
+    fun setEnabled(v: Boolean) {
+        prefs.edit { putBoolean(KEY_ENABLED, v) }
+        refresh()
+    }
+
+    fun isSeparate(): Boolean = prefs.getBoolean(KEY_SEPARATE, false)
+
+    fun setSeparate(v: Boolean) {
+        prefs.edit { putBoolean(KEY_SEPARATE, v) }
+        refresh()
+    }
+
+    private fun modeKeyFor(slot: Slot): String = when (slot) {
+        Slot.PORTRAIT -> KEY_MODE_PORTRAIT
+        Slot.LANDSCAPE -> KEY_MODE_LANDSCAPE
+        Slot.CANDIDATE -> KEY_MODE_CANDIDATE
+        Slot.VIDEO -> KEY_MODE_VIDEO
+    }
+
+    /**
+     * 指定槽位的填充模式。每个槽位（竖屏背景 / 横屏背景 / 候选栏背景 / 视频背景）
+     * 各自独立保存；从未单独设置过时回退到旧版全局值，保证升级不丢设置。
+     */
+    fun modeFor(slot: Slot): Mode {
+        val legacy = prefs.getInt(KEY_MODE, Mode.CENTER.ordinal)
+        val o = prefs.getInt(modeKeyFor(slot), legacy)
+        return Mode.values().getOrElse(o) { Mode.CENTER }
+    }
+
+    fun setModeFor(
+        slot: Slot,
+        m: Mode,
+    ) {
+        prefs.edit { putInt(modeKeyFor(slot), m.ordinal) }
+        refresh()
+    }
+
+    /** 当前键盘背景所用的槽位（横竖屏分别设置时按方向取）。 */
+    fun keyboardSlot(): Slot = if (isSeparate() && isLandscape()) Slot.LANDSCAPE else Slot.PORTRAIT
+
+    /** 键盘背景当前的填充模式。 */
+    fun mode(): Mode = modeFor(keyboardSlot())
+
+    fun setMode(m: Mode) = setModeFor(keyboardSlot(), m)
+
+    fun opacityPercent(): Int = prefs.getInt(KEY_OPACITY, 100).coerceIn(0, 100)
+
+    fun setOpacityPercent(v: Int) {
+        prefs.edit { putInt(KEY_OPACITY, v.coerceIn(0, 100)) }
+        refresh()
+    }
+
+    fun blurRadius(): Int = prefs.getInt(KEY_BLUR, 0).coerceIn(0, MAX_BLUR)
+
+    fun setBlurRadius(v: Int) {
+        prefs.edit { putInt(KEY_BLUR, v.coerceIn(0, MAX_BLUR)) }
+        refresh()
+    }
+
+    /**
+     * 背景来源。只保留「相册 / 文件」「视频」两种；
+     * 「内置图库」已下线，历史遗留的来源值一律回落到相册，避免背景空白。
+     */
+    fun source(): Int = if (prefs.getInt(KEY_SOURCE, SOURCE_GALLERY) == SOURCE_VIDEO) SOURCE_VIDEO else SOURCE_GALLERY
+
+    fun setSource(v: Int) {
+        prefs.edit { putInt(KEY_SOURCE, if (v == SOURCE_VIDEO) SOURCE_VIDEO else SOURCE_GALLERY) }
+        refresh()
+    }
+
+    fun isCandidateBarEnabled(): Boolean = prefs.getBoolean(KEY_CAND_ENABLED, false)
+
+    fun setCandidateBarEnabled(v: Boolean) {
+        prefs.edit { putBoolean(KEY_CAND_ENABLED, v) }
+        refresh()
+    }
+
+    fun isLandscape(): Boolean = appContext.resources.configuration.orientation == Configuration.ORIENTATION_LANDSCAPE
+
+    fun hasPortrait(): Boolean = portraitFile().exists()
+
+    fun hasLandscape(): Boolean = landscapeFile().exists()
+
+    fun hasCandidate(): Boolean = candidateFile().exists()
+
+    fun hasVideo(): Boolean = videoFile().exists()
+
+    // ---------------- 图片 / 动图 / 视频导入 ----------------
+
+    /** 读取 URI 的全部字节；失败返回 null。 */
+    fun readUriBytes(uri: Uri): ByteArray? = runCatching {
+        appContext.contentResolver.openInputStream(uri)?.use { it.readBytes() }
+    }.getOrNull()?.takeIf { it.isNotEmpty() }
+
+    /** 从字节下采样解码为位图；失败返回 null。 */
+    fun decodeImage(bytes: ByteArray): Bitmap? = runCatching { decodeDownscaled(bytes) }.getOrNull()
+
+    private fun decodeDownscaled(bytes: ByteArray): Bitmap? {
+        var sample = 1
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+        if (bounds.outWidth > 0 && bounds.outHeight > 0) {
+            while (bounds.outWidth / (sample * 2) >= MAX_DIM || bounds.outHeight / (sample * 2) >= MAX_DIM) sample *= 2
+        }
+        val opts = BitmapFactory.Options().apply { inSampleSize = sample }
+        return BitmapFactory.decodeByteArray(bytes, 0, bytes.size, opts)
+    }
+
+    /**
+     * 读取相册图片并下采样解码为位图；失败返回 null。
+     *
+     * 采用**一次性读出全部字节再解码**：部分相册/文件管理器返回的流不可重复读取、
+     * 或不支持流式 `decodeStream`，直接读字节最稳。
+     */
+    fun decodeFromUri(uri: Uri): Bitmap? {
+        val bytes = readUriBytes(uri)
+        if (bytes == null) {
+            Timber.tag(TAG).w("decodeFromUri: 无法读取图片字节 uri=%s", uri)
+            return null
+        }
+        val bmp = decodeImage(bytes)
+        if (bmp == null) Timber.tag(TAG).w("decodeFromUri: 图片解码失败 bytes=%d", bytes.size)
+        return bmp
+    }
+
+    /** 保存裁剪好的位图到对应槽位；成功返回 true。 */
+    fun importBitmap(
+        bmp: Bitmap,
+        slot: Slot,
+    ): Boolean = runCatching {
+        val target = fileFor(slot)
+        target.outputStream().use { bmp.compress(Bitmap.CompressFormat.JPEG, 90, it) }
+        prefs.edit {
+            putString(keyFor(slot), target.name)
+            if (slot == Slot.CANDIDATE) {
+                putBoolean(KEY_CAND_ENABLED, true)
+            } else {
+                putBoolean(KEY_ENABLED, true)
+                putInt(KEY_SOURCE, SOURCE_GALLERY)
+            }
+        }
+        refresh()
+        true
+    }.getOrDefault(false)
+
+    /** 原样保存字节（用于 GIF 动图与视频）；成功返回 true。 */
+    fun importRawBytes(
+        bytes: ByteArray,
+        slot: Slot,
+    ): Boolean = runCatching {
+        val target = fileFor(slot)
+        target.writeBytes(bytes)
+        prefs.edit {
+            putString(keyFor(slot), target.name)
+            if (slot == Slot.CANDIDATE) {
+                putBoolean(KEY_CAND_ENABLED, true)
+            } else {
+                putBoolean(KEY_ENABLED, true)
+                putInt(KEY_SOURCE, if (slot == Slot.VIDEO) SOURCE_VIDEO else SOURCE_GALLERY)
+            }
+        }
+        refresh()
+        true
+    }.getOrDefault(false)
+
+    fun resetImage(slot: Slot) {
+        stopVideo()
+        runCatching { fileFor(slot).delete() }
+        prefs.edit { remove(keyFor(slot)) }
+        refresh()
+    }
+
+    // ---------------- 位图 / 动图缓存与加载 ----------------
+
+    private class Layer {
+        var raw: Bitmap? = null
+        var rawKey: String? = null
+        var out: Bitmap? = null
+        var outKey: String? = null
+    }
+
+    private val keyboardLayer = Layer()
+    private val candidateLayer = Layer()
+    private var gifKey: String? = null
+    private var gifDrawable: Drawable? = null
+
+    private fun loadLayer(
+        layer: Layer,
+        key: String,
+        blur: Int,
+        rawProvider: () -> Bitmap?,
+    ): Bitmap? {
+        val outKey = "$key|blur=$blur"
+        if (layer.outKey == outKey) return layer.out
+        val raw =
+            if (layer.rawKey == key) {
+                layer.raw
+            } else {
+                rawProvider()?.also {
+                    layer.raw = it
+                    layer.rawKey = key
+                }
+            }
+        val src = raw ?: return null
+        val out = if (blur > 0) DahiImageEffects.blur(src, blur) else src
+        layer.out = out
+        layer.outKey = outKey
+        return out
+    }
+
+    private fun keyboardRawBitmap(): Bitmap? {
+        val file = keyboardFile() ?: return null
+        return runCatching { BitmapFactory.decodeFile(file.absolutePath) }.getOrNull()
+    }
+
+    private fun keyboardFile(): File? {
+        val portrait = portraitFile()
+        val landscape = landscapeFile()
+        return if (!isSeparate()) {
+            if (portrait.exists()) portrait else landscape.takeIf { it.exists() }
+        } else {
+            if (isLandscape()) landscape.takeIf { it.exists() } else portrait.takeIf { it.exists() }
+        }
+    }
+
+    private fun keyboardKey(): String = when {
+        source() == SOURCE_VIDEO -> "video"
+        else -> keyboardFile()?.let { it.absolutePath + ":" + it.lastModified() } ?: "none"
+    }
+
+    /** 键盘背景当前应显示的位图；总开关关闭 / 动图 / 视频时返回 null。 */
+    fun effectiveKeyboardBitmap(): Bitmap? {
+        if (!isEnabled() || source() == SOURCE_VIDEO) return null
+        return loadLayer(keyboardLayer, keyboardKey(), blurRadius()) { keyboardRawBitmap() }
+    }
+
+    /** 设置页预览用：不受总开关影响，便于用户先看效果。 */
+    fun previewBitmap(): Bitmap? {
+        if (source() == SOURCE_VIDEO) return null
+        return loadLayer(keyboardLayer, keyboardKey(), blurRadius()) { keyboardRawBitmap() }
+    }
+
+    /** 设置页预览用：当前左侧背景是否为 GIF 动图（用于决定是否直接播放动图）。 */
+    fun previewGifDrawable(): Drawable? {
+        if (source() != SOURCE_GALLERY || !isEnabled()) return null
+        val file = keyboardFile() ?: return null
+        return gifDrawableFor(file, keyboardSlot())
+    }
+
+    private fun gifDrawableFor(
+        file: File,
+        slot: Slot,
+    ): Drawable? {
+        val m = modeFor(slot)
+        val key = file.absolutePath + ":" + file.lastModified() + ":" + opacityPercent() + ":" + m.ordinal
+        if (key == gifKey) return gifDrawable
+        val bytes = runCatching { file.readBytes() }.getOrNull() ?: return null
+        val drawable = DahiGifDrawable.create(bytes, m, alpha())
+        gifKey = key
+        gifDrawable = drawable
+        return drawable
+    }
+
+    private fun candidateRawBitmap(): Bitmap? {
+        val file = candidateFile()
+        if (!file.exists()) return null
+        return runCatching { BitmapFactory.decodeFile(file.absolutePath) }.getOrNull()
+    }
+
+    private fun candidateKey(): String = if (!isCandidateBarEnabled()) {
+        "off"
+    } else {
+        candidateFile().let { it.absolutePath + ":" + it.lastModified() }
+    }
+
+    /** 候选栏单独背景当前应显示的位图；未启用 / 无图 / 动图时返回 null。 */
+    fun effectiveCandidateBitmap(): Bitmap? {
+        if (!isCandidateBarEnabled()) return null
+        return loadLayer(candidateLayer, candidateKey(), blurRadius()) { candidateRawBitmap() }
+    }
+
+    // ---------------- 应用到视图 ----------------
+
+    private var keyboardTarget: WeakReference<ImageView>? = null
+    private var barTarget: WeakReference<View>? = null
+    private var barDefaultBackground: Drawable? = null
+    private var videoTarget: WeakReference<TextureView>? = null
+    private var mediaPlayer: MediaPlayer? = null
+    private var videoWidth = 0
+    private var videoHeight = 0
+    private var listenerRegistered = false
+
+    private val changeListener =
+        SharedPreferences.OnSharedPreferenceChangeListener { _, key ->
+            if (key != null && key.startsWith(KEY_PREFIX)) {
+                invalidateCaches()
+                keyboardTarget?.get()?.let { applyTo(it) }
+                applyBar()
+                applyVideo()
+            }
+        }
+
+    private fun invalidateCaches() {
+        listOf(keyboardLayer, candidateLayer).forEach {
+            it.raw = null
+            it.rawKey = null
+            it.out = null
+            it.outKey = null
+        }
+        gifKey = null
+        gifDrawable = null
+    }
+
+    private fun ensureListener() {
+        if (listenerRegistered) return
+        runCatching { prefs.registerOnSharedPreferenceChangeListener(changeListener) }
+        listenerRegistered = true
+    }
+
+    /** 由 [com.osfans.trime.ime.core.InputView] 在创建键盘背景视图时调用。 */
+    fun attach(view: ImageView) {
+        keyboardTarget = WeakReference(view)
+        ensureListener()
+        applyTo(view)
+    }
+
+    /** 由 [com.osfans.trime.ime.core.InputView] 在创建视频背景视图时调用。 */
+    fun attachVideo(view: TextureView) {
+        videoTarget = WeakReference(view)
+        view.surfaceTextureListener =
+            object : TextureView.SurfaceTextureListener {
+                override fun onSurfaceTextureAvailable(
+                    surface: android.graphics.SurfaceTexture,
+                    width: Int,
+                    height: Int,
+                ) {
+                    startVideoIfNeeded()
+                }
+
+                override fun onSurfaceTextureSizeChanged(
+                    surface: android.graphics.SurfaceTexture,
+                    width: Int,
+                    height: Int,
+                ) = Unit
+
+                override fun onSurfaceTextureDestroyed(surface: android.graphics.SurfaceTexture): Boolean {
+                    stopVideo()
+                    return true
+                }
+
+                override fun onSurfaceTextureUpdated(surface: android.graphics.SurfaceTexture) = Unit
+            }
+        view.addOnLayoutChangeListener { _, _, _, _, _, _, _, _, _ -> applyVideoTransform() }
+        view.addOnAttachStateChangeListener(
+            object : View.OnAttachStateChangeListener {
+                override fun onViewAttachedToWindow(v: View) = startVideoIfNeeded()
+
+                override fun onViewDetachedFromWindow(v: View) = stopVideo()
+            },
+        )
+        ensureListener()
+        applyVideo()
+    }
+
+    /** 由输入栏挂钩：把整条候选栏底色换成用户图片（不影响主题 yaml）。 */
+    fun attachCandidateBar(
+        view: View,
+        defaultBackground: Drawable?,
+    ) {
+        barTarget = WeakReference(view)
+        barDefaultBackground = defaultBackground
+        ensureListener()
+        applyBar()
+    }
+
+    /** 偏好变化后立即刷新已挂载的键盘背景、候选栏与视频（设置页改动即时可见）。 */
+    fun refresh() {
+        invalidateCaches()
+        keyboardTarget?.get()?.let { applyTo(it) }
+        applyBar()
+        applyVideo()
+    }
+
+    private fun alpha(): Int = (opacityPercent() / 100f * 255f).toInt().coerceIn(0, 255)
+
+    /** 把当前设置绘制到 [view]；未启用或无图片时回退到主题自带背景。 */
+    fun applyTo(view: ImageView) {
+        if (!isEnabled()) {
+            restoreThemeBackground(view)
+            return
+        }
+        if (source() == SOURCE_VIDEO) {
+            // 视频由 TextureView 绘制，这里保持透明
+            runCatching { view.setImageDrawable(null) }
+            return
+        }
+        if (source() == SOURCE_GALLERY) {
+            val file = keyboardFile()
+            val gif = file?.let { gifDrawableFor(it, keyboardSlot()) }
+            if (gif != null) {
+                view.scaleType = ImageView.ScaleType.FIT_XY
+                view.setImageDrawable(gif)
+                return
+            }
+        }
+        val bmp = effectiveKeyboardBitmap()
+        if (bmp == null) {
+            restoreThemeBackground(view)
+            return
+        }
+        view.scaleType = ImageView.ScaleType.FIT_XY
+        view.setImageDrawable(DahiKeyboardBackgroundDrawable(bmp, modeFor(keyboardSlot()), alpha()))
+    }
+
+    private fun restoreThemeBackground(view: ImageView) {
+        view.scaleType = ImageView.ScaleType.CENTER_CROP
+        runCatching { view.setImageDrawable(ColorManager.getDrawable("keyboard_background")) }
+    }
+
+    private fun applyBar() {
+        val view = barTarget?.get() ?: return
+        val gif =
+            if (isCandidateBarEnabled()) {
+                candidateFile().takeIf { it.exists() }?.let { gifDrawableFor(it, Slot.CANDIDATE) }
+            } else {
+                null
+            }
+        val bmp = if (gif == null) effectiveCandidateBitmap() else null
+        view.background =
+            when {
+                gif != null -> gif
+                bmp != null -> DahiKeyboardBackgroundDrawable(bmp, modeFor(Slot.CANDIDATE), alpha())
+                else -> barDefaultBackground
+            }
+    }
+
+    /**
+     * 按当前填充模式为视频设置变换（TextureView 默认把画面拉伸铺满）：
+     * - 拉伸铺满：铺满整个键盘，画面会被拉伸变形；
+     * - 适应：完整显示整段视频，四周留空、**不变形**；
+     * - 居中：等比铺满后居中裁剪，铺满且**不变形**（推荐）；
+     * - 重复平铺：视频无法平铺，按「居中」显示。
+     */
+    private fun applyVideoTransform() {
+        val view = videoTarget?.get() ?: return
+        val vw = videoWidth
+        val vh = videoHeight
+        val w = view.width.toFloat()
+        val h = view.height.toFloat()
+        if (vw <= 0 || vh <= 0 || w <= 0f || h <= 0f) {
+            runCatching { view.setTransform(null) }
+            return
+        }
+        val matrix = Matrix()
+        val vm = modeFor(Slot.VIDEO)
+        if (vm == Mode.STRETCH) {
+            // 默认即拉伸铺满
+        } else {
+            // 等比缩放（保持原始宽高比）：
+            //  - 适应（FIT）：整段视频完整显示，四周留空、不变形；
+            //  - 居中（CENTER）/ 平铺（TILE 回退）：等比放大到铺满并居中裁剪，不变形
+            val s = if (vm == Mode.FIT) minOf(w / vw, h / vh) else maxOf(w / vw, h / vh)
+            val kx = s * vw / w
+            val ky = s * vh / h
+            matrix.setScale(kx, ky)
+            matrix.postTranslate((w - w * kx) / 2f, (h - h * ky) / 2f)
+        }
+        runCatching { view.setTransform(matrix) }
+    }
+
+    private fun applyVideo() {
+        val view = videoTarget?.get() ?: return
+        val file = videoFile()
+        val active = isEnabled() && source() == SOURCE_VIDEO && file.exists()
+        if (!active) {
+            stopVideo()
+            view.visibility = View.GONE
+            return
+        }
+        view.visibility = View.VISIBLE
+        startVideoIfNeeded()
+        applyVideoTransform()
+    }
+
+    private fun setVideoSize(
+        w: Int,
+        h: Int,
+    ) {
+        videoWidth = w
+        videoHeight = h
+        applyVideoTransform()
+    }
+
+    /** 键盘可见性变化时暂停 / 续播视频背景（省电；TextureView 仍保留，只是不再解码）。 */
+    fun setVideoPlayback(active: Boolean) {
+        val player = mediaPlayer ?: return
+        runCatching {
+            if (active) {
+                if (!player.isPlaying) player.start()
+            } else if (player.isPlaying) {
+                player.pause()
+            }
+        }
+    }
+
+    private fun startVideoIfNeeded() {
+        if (mediaPlayer != null) return
+        val view = videoTarget?.get() ?: return
+        val file = videoFile()
+        if (!isEnabled() || source() != SOURCE_VIDEO || !file.exists()) return
+        if (!view.isAvailable) return
+        runCatching {
+            val player =
+                MediaPlayer().apply {
+                    setDataSource(file.absolutePath)
+                    isLooping = true
+                    setVolume(0f, 0f)
+                    setSurface(Surface(view.surfaceTexture))
+                    setOnPreparedListener { player ->
+                        setVideoSize(player.videoWidth, player.videoHeight)
+                        player.start()
+                    }
+                    setOnVideoSizeChangedListener { _, w, h -> setVideoSize(w, h) }
+                    prepareAsync()
+                }
+            mediaPlayer = player
+        }.onFailure {
+            Timber.tag(TAG).w(it, "startVideoIfNeeded 失败")
+            stopVideo()
+        }
+    }
+
+    private fun stopVideo() {
+        val player = mediaPlayer ?: return
+        mediaPlayer = null
+        videoWidth = 0
+        videoHeight = 0
+        runCatching {
+            player.setOnPreparedListener(null)
+            if (player.isPlaying) player.stop()
+            player.reset()
+            player.release()
+        }
+    }
+
+    // ---------------- 备份 / 还原 ----------------
+
+    /** 导出为 JSON 文本；从未设置过时返回 null（备份里不出现该项）。 */
+    fun exportStateJson(): String? {
+        val hasImage = listOf(Slot.PORTRAIT, Slot.LANDSCAPE, Slot.CANDIDATE).any { fileFor(it).exists() }
+        val enabled = isEnabled()
+        if (!hasImage && !hasVideo() && !enabled) return null
+        val o = JSONObject()
+        o.put("enabled", enabled)
+        o.put("separate", isSeparate())
+        o.put("mode", prefs.getInt(KEY_MODE, Mode.CENTER.ordinal))
+        o.put("modePortrait", modeFor(Slot.PORTRAIT).ordinal)
+        o.put("modeLandscape", modeFor(Slot.LANDSCAPE).ordinal)
+        o.put("modeCandidate", modeFor(Slot.CANDIDATE).ordinal)
+        o.put("modeVideo", modeFor(Slot.VIDEO).ordinal)
+        o.put("opacity", prefs.getInt(KEY_OPACITY, 100))
+        o.put("blur", prefs.getInt(KEY_BLUR, 0))
+        o.put("source", source())
+        o.put("candEnabled", isCandidateBarEnabled())
+        o.put("portrait", encodeFile(Slot.PORTRAIT) ?: JSONObject.NULL)
+        o.put("landscape", encodeFile(Slot.LANDSCAPE) ?: JSONObject.NULL)
+        o.put("candidate", encodeFile(Slot.CANDIDATE) ?: JSONObject.NULL)
+        o.put("video", encodeFile(Slot.VIDEO, MAX_BACKUP_VIDEO_BYTES) ?: JSONObject.NULL)
+        return o.toString()
+    }
+
+    fun importStateJson(text: String?) {
+        if (text.isNullOrEmpty()) return
+        runCatching {
+            val o = JSONObject(text)
+            stopVideo()
+            prefs.edit {
+                putBoolean(KEY_ENABLED, o.optBoolean("enabled", false))
+                putBoolean(KEY_SEPARATE, o.optBoolean("separate", false))
+                val legacyMode = o.optInt("mode", Mode.CENTER.ordinal)
+                putInt(KEY_MODE, legacyMode)
+                putInt(KEY_MODE_PORTRAIT, o.optInt("modePortrait", legacyMode))
+                putInt(KEY_MODE_LANDSCAPE, o.optInt("modeLandscape", legacyMode))
+                putInt(KEY_MODE_CANDIDATE, o.optInt("modeCandidate", legacyMode))
+                putInt(KEY_MODE_VIDEO, o.optInt("modeVideo", legacyMode))
+                putInt(KEY_OPACITY, o.optInt("opacity", 100))
+                putInt(KEY_BLUR, o.optInt("blur", 0))
+                putInt(KEY_SOURCE, o.optInt("source", SOURCE_GALLERY))
+                putBoolean(KEY_CAND_ENABLED, o.optBoolean("candEnabled", false))
+            }
+            writeFile(Slot.PORTRAIT, optBase64(o, "portrait"))
+            writeFile(Slot.LANDSCAPE, optBase64(o, "landscape"))
+            writeFile(Slot.CANDIDATE, optBase64(o, "candidate"))
+            writeFile(Slot.VIDEO, optBase64(o, "video"))
+            refresh()
+        }.onFailure { Timber.tag(TAG).w(it, "importStateJson 失败") }
+    }
+
+    private fun encodeFile(
+        slot: Slot,
+        maxBytes: Int = Int.MAX_VALUE,
+    ): String? {
+        val file = fileFor(slot)
+        if (!file.exists() || file.length() > maxBytes) return null
+        return runCatching { Base64.encodeToString(file.readBytes(), Base64.NO_WRAP) }.getOrNull()
+    }
+
+    private fun writeFile(
+        slot: Slot,
+        base64: String?,
+    ) {
+        val file = fileFor(slot)
+        if (base64.isNullOrEmpty()) {
+            runCatching { file.delete() }
+            return
+        }
+        runCatching { file.writeBytes(Base64.decode(base64, Base64.DEFAULT)) }
+    }
+
+    private fun optBase64(
+        o: JSONObject,
+        name: String,
+    ): String? {
+        val value = o.opt(name) ?: return null
+        if (value == JSONObject.NULL) return null
+        return (value as? String)?.ifEmpty { null }
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyboardBackgroundDrawable.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyboardBackgroundDrawable.kt
