+    /**
+     * 条目长按菜单（**自绘**，不使用 PopupMenu）。
+     *
+     * PopupMenu 是独立窗口：ima / 豆包 / 应用内「输入测试」在它出现的瞬间会把输入法窗口
+     * 收起，并把输入会话作废 —— 之后所有提交都「返回成功、内容被丢弃」，
+     * 连「收起再显示」也救不回那根旧连接（r132 实测）。
+     * 自绘层只是浮层视图树里的一个普通 View，不创建窗口，宿主就不会有任何反应。
+     */
+    private fun showItemMenu(
+        bean: DatabaseBean,
+        isCollection: Boolean,
+        anchor: View,
+    ) {
+        val actions = SearchItemActions(isCollection)
+        val items = ArrayList<DahiWindowPanel.Item>()
+
+        fun add(
+            icon: Int,
+            label: Int,
+            action: () -> Unit,
+        ) {
+            items.add(DahiWindowPanel.Item(icon, ctx.getString(label), action = action))
+        }
+
+        // 长文本时「查看全文」放最顶部：菜单一弹出就能点到，不用滑到第 10 项去找（r136）
+        if (bean.text.orEmpty().length > FULL_TEXT_HINT) {
+            add(R.drawable.ic_baseline_notes_24, R.string.dahi_cp_view_full) { actions.onViewFull(bean) }
+        }
+        add(R.drawable.ic_baseline_edit_24, R.string.edit) { actions.onEdit(bean.id) }
+        add(R.drawable.ic_baseline_share_24, R.string.share) { actions.onShare(bean) }
+        add(R.drawable.ic_baseline_view_comfy_24, R.string.word_segment) { actions.onSegment(bean) }
+        if (!isCollection) {
+            add(R.drawable.ic_baseline_star_24, R.string.collect) { actions.onCollect(bean) }
+        }
+        if (bean.pinned) {
+            add(R.drawable.ic_outline_push_pin_24, R.string.simple_key_unpin) { actions.onUnpin(bean.id) }
+        } else {
+            add(R.drawable.ic_baseline_push_pin_24, R.string.simple_key_pin) { actions.onPin(bean.id) }
+        }
+        add(R.drawable.ic_baseline_checklist_24, R.string.dahi_cp_batch_mode) { actions.onBatchSelect(bean) }
+        add(R.drawable.ic_baseline_delete_24, R.string.delete) { actions.onDelete(bean.id) }
+        add(R.drawable.ic_baseline_folder_24, R.string.dahi_cp_category) { actions.onSetCategory(bean, root) }
+        add(R.drawable.ic_dahi_phrase_add_24, R.string.dahi_cp_set) { actions.onSetCustomPhrase(bean) }
