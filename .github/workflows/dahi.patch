+
+    /** 语音上屏时是否也落字（默认开）。有人不希望说话时屏幕上飞字。 */
+    var collectVoice: Boolean
+        get() = runCatching { prefs().getBoolean(KEY_COLLECT_VOICE, true) }.getOrDefault(true)
+        set(value) = prefs().edit { putBoolean(KEY_COLLECT_VOICE, value) }
+
+    /** 剪贴板 / 其他非键盘上屏时是否落字（默认开）。 */
+    var collectClipboard: Boolean
