+    <string name="dahi_keybg_gif_saved">Animated background set (plays automatically)</string>
+    <string name="dahi_keybg_crop_title">Crop background image</string>
+    <string name="dahi_keybg_crop_hint">Drag the image to reposition it and pinch to zoom (zoom out to see the whole image). The whole area is the final visible range.</string>
