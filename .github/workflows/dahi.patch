new file mode 100644
index 0000000..2798b60
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/data/db/asr/AsrHistoryStore.kt
@@ -0,0 +1,151 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dahi
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.db.asr
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * 识别历史的读写入口（含清理策略）。
+ *
+ * 清理与剪贴板同构：按天数 + 按条数，两者同时生效、先到先清；
+ * 天数设 0 = 永久保留，条数设 0 = 不限条数。
+ */
+object AsrHistoryStore {
+    private const val PREFS = "dahi_asr_history"
+    private const val KEY_KEEP_DAYS = "keep_days"
+    private const val KEY_KEEP_COUNT = "keep_count"
+    private const val KEY_RECORD_AUDIO = "record_audio"
+
+    const val DEFAULT_KEEP_DAYS = 30
+    const val DEFAULT_KEEP_COUNT = 1000
+
+    private const val DAY_MS = 24 * 60 * 60 * 1000L
+
+    private fun prefs(context: Context) = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    fun keepDays(context: Context): Int = prefs(context).getInt(KEY_KEEP_DAYS, DEFAULT_KEEP_DAYS)
+
+    fun setKeepDays(
+        context: Context,
+        days: Int,
+    ) {
+        prefs(context).edit().putInt(KEY_KEEP_DAYS, days).apply()
+    }
+
+    fun keepCount(context: Context): Int = prefs(context).getInt(KEY_KEEP_COUNT, DEFAULT_KEEP_COUNT)
+
+    fun setKeepCount(
+        context: Context,
+        count: Int,
+    ) {
+        prefs(context).edit().putInt(KEY_KEEP_COUNT, count).apply()
+    }
+
+    fun recordAudio(context: Context): Boolean = prefs(context).getBoolean(KEY_RECORD_AUDIO, false)
+
+    fun setRecordAudio(
+        context: Context,
+        on: Boolean,
+    ) {
+        prefs(context).edit().putBoolean(KEY_RECORD_AUDIO, on).apply()
+    }
+
+    /** 记一条历史；文本为空直接丢弃（空白语音不该污染历史）。 */
+    suspend fun record(
+        context: Context,
+        text: String,
+        rawText: String? = null,
+        engine: String,
+        source: String,
+        durRecordMs: Long = 0,
+        durAsrMs: Long = 0,
+        durPostMs: Long = 0,
+        durCommitMs: Long = 0,
+        audioPath: String? = null,
+    ) {
+        val trimmed = text.trim()
+        if (trimmed.isEmpty()) return
+        withContext(Dispatchers.IO) {
+            runCatching {
+                val dao = AsrHistoryDatabase.get(context).dao()
+                dao.insert(
+                    AsrHistoryBean(
+                        text = trimmed,
+                        rawText = rawText ?: trimmed,
+                        engine = engine,
+                        source = source,
+                        chars = trimmed.length,
+                        durRecordMs = durRecordMs,
+                        durAsrMs = durAsrMs,
+                        durPostMs = durPostMs,
+                        durCommitMs = durCommitMs,
+                        audioPath = audioPath,
+                    ),
+                )
+                prune(dao, context)
+            }
+        }
+    }
+
+    private suspend fun prune(
+        dao: AsrHistoryDao,
+        context: Context,
+    ) {
+        val days = keepDays(context)
+        if (days > 0) {
+            runCatching { dao.deleteOlderThan(System.currentTimeMillis() - days * DAY_MS) }
+        }
+        val keep = keepCount(context)
+        if (keep > 0) {
+            runCatching { dao.trimToCount(keep) }
+        }
+    }
+
+    /** 按关键词（可空）取最近若干条。IO 线程执行，可在任意协程里调用。 */
+    suspend fun list(
+        context: Context,
+        query: String? = null,
+        limit: Int = 500,
+    ): List<AsrHistoryBean> = withContext(Dispatchers.IO) {
+        runCatching {
+            val dao = AsrHistoryDatabase.get(context).dao()
+            if (query.isNullOrBlank()) dao.recent(limit) else dao.search(query.trim(), limit)
+        }.getOrDefault(emptyList())
+    }
+
+    suspend fun find(
+        context: Context,
+        id: Long,
+    ): AsrHistoryBean? = withContext(Dispatchers.IO) {
+        runCatching { AsrHistoryDatabase.get(context).dao().find(id) }.getOrNull()
+    }
+
+    suspend fun delete(
+        context: Context,
+        ids: List<Long>,
+    ) {
+        if (ids.isEmpty()) return
+        withContext(Dispatchers.IO) {
+            runCatching { AsrHistoryDatabase.get(context).dao().deleteByIds(ids) }
+        }
+    }
+
+    suspend fun clear(context: Context) {
+        withContext(Dispatchers.IO) {
+            runCatching { AsrHistoryDatabase.get(context).dao().clear() }
+        }
+    }
+
+    /** 马上按当前策略清一次（设置页改完策略后调用，立刻生效）。 */
+    suspend fun pruneNow(context: Context) {
+        withContext(Dispatchers.IO) {
+            runCatching { prune(AsrHistoryDatabase.get(context).dao(), context) }
+        }
+    }
+}
