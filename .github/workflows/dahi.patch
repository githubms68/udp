+    // ---------------- 尺寸选项顺序 ----------------
+
+    /**
+     * 当前尺寸顺序（全量 field）。
+     *
+     * 容错：pref 里已不存在的 field 会被丢弃；**新版本新增的选项**自动追加到末尾
+     * （结构保证，无需调用方兜底）。
+     */
+    private fun readSizeOrder(): List<String> {
+        val saved = mutableListOf<String>()
+        runCatching {
+            val raw = prefs.getString(KEY_SIZE_ORDER, null) ?: return@runCatching
+            val arr = JSONArray(raw)
+            for (i in 0 until arr.length()) {
+                val f = arr.optString(i)
+                if (f.isNotEmpty() && saved.none { it == f } && SIZE_ITEMS.any { it.field == f }) {
+                    saved.add(f)
+                }
+            }
+        }
+        // 补全缺失项（首次使用 / 新选项），保持默认顺序
+        val missing = SIZE_ITEMS.map { it.field }.filterNot { f -> saved.any { it == f } }
+        return saved + missing
+    }
+
+    private fun writeSizeOrder(order: List<String>) {
+        val json = JSONArray()
+        order.forEach { json.put(it) }
+        prefs.edit { putString(KEY_SIZE_ORDER, json.toString()) }
+    }
+
+    /** 渲染用：`Triple(组名, 组标题 res, 组内按用户顺序的尺寸项)`。 */
+    fun sizeSections(): List<Triple<String, Int, List<SizeItem>>> {
+        val byField = SIZE_ITEMS.associateBy { it.field }
+        val order = readSizeOrder()
+        return SIZE_SECTIONS.map { (section, members) ->
+            val items = order.mapNotNull { f -> byField[f]?.takeIf { members.contains(f) } }
+            Triple(section, SIZE_SECTION_LABELS.getValue(section), items)
+        }
+    }
+
+    /** 保存用户自定义尺寸顺序（全量 field；非法 / 重复 / 缺失的会被过滤补齐）。 */
+    fun setSizeOrder(order: List<String>) {
+        val valid = LinkedHashSet<String>()
+        order.forEach { f -> if (SIZE_ITEMS.any { it.field == f }) valid.add(f) }
+        if (valid.isEmpty()) return
+        // 补齐缺项到尾部，保证存回的一定是完整的 28 项
+        SIZE_ITEMS.forEach { valid.add(it.field) }
+        writeSizeOrder(valid.toList())
+    }
+
+    /** 恢复默认尺寸顺序（只清顺序，**不动**已调整的数值）。 */
+    fun resetSizeOrder() {
+        prefs.edit { remove(KEY_SIZE_ORDER) }
+    }
+
+    // ---------------- 颜色选项顺序 ----------------
+
+    /**
+     * 当前颜色顺序（全量组名）。
+     *
+     * 容错同尺寸：pref 里已不存在的组名会被丢弃；新版本新增的分组自动追加到末尾。
+     */
+    private fun readColorOrder(): List<String> {
+        val saved = mutableListOf<String>()
+        runCatching {
+            val raw = prefs.getString(KEY_COLOR_ORDER, null) ?: return@runCatching
+            val arr = JSONArray(raw)
+            for (i in 0 until arr.length()) {
+                val f = arr.optString(i)
+                if (f.isNotEmpty() && saved.none { it == f } && COLOR_GROUPS.any { it.first == f }) {
+                    saved.add(f)
+                }
+            }
+        }
+        val missing = COLOR_GROUPS.map { it.first }.filterNot { f -> saved.any { it == f } }
+        return saved + missing
+    }
+
+    private fun writeColorOrder(order: List<String>) {
+        val json = JSONArray()
+        order.forEach { json.put(it) }
+        prefs.edit { putString(KEY_COLOR_ORDER, json.toString()) }
+    }
+
+    /** 渲染用：`Triple(分类名, 分类标题 res, 分类内按用户顺序的颜色分组名)`。 */
+    fun colorSections(): List<Triple<String, Int, List<String>>> {
+        val order = readColorOrder()
+        return COLOR_SECTIONS.map { (section, members) ->
+            val groups = order.filter { members.contains(it) }
+            Triple(section, COLOR_SECTION_LABELS.getValue(section), groups)
+        }
+    }
+
+    /** 保存用户自定义颜色顺序（全量组名；非法 / 重复 / 缺失的会被过滤补齐）。 */
+    fun setColorOrder(order: List<String>) {
+        val valid = LinkedHashSet<String>()
+        order.forEach { f -> if (COLOR_GROUPS.any { it.first == f }) valid.add(f) }
+        if (valid.isEmpty()) return
+        COLOR_GROUPS.forEach { valid.add(it.first) }
+        writeColorOrder(valid.toList())
+    }
+
+    /** 恢复默认颜色顺序（只清顺序，**不动**已覆盖的颜色值）。 */
+    fun resetColorOrder() {
+        prefs.edit { remove(KEY_COLOR_ORDER) }
+    }
