+    }
+
+    /** 某一组的全选 / 取消全选。 */
+    private fun toggleAll(finding: DahiHealth.Finding) {
+        val keys = finding.entries.map { "${finding.id}:${it.key}" }
+        val allChecked = keys.isNotEmpty() && keys.all { it in checked }
+        if (allChecked) {
+            checked.removeAll(keys.toSet())
+        } else {
+            checked.addAll(keys)
+        }
+        // 复选框状态跟着一起变：整页重建比逐个找 View 简单可靠
+        renderReport(report ?: return)
+    }
+
+    private fun updateButtons() {
+        val n = checked.size
+        // 旧按钮随 removeView 脱离视图树（parent == null），顺手丢掉引用
+        cleanButtons.removeAll { it.parent == null }
+        undoButtons.removeAll { it.parent == null }
+        val hasUndo = DahiHealth.hasUndo()
+        cleanButtons.forEach {
+            it.isEnabled = n > 0
+            it.text = getString(R.string.dahi_health_clean, n)
+        }
+        undoButtons.forEach { it.isEnabled = hasUndo }
+    }
+
+    private fun confirmClean() {
+        val r = report ?: return
+        // 按检查项分组：一个 finding 一次清理（不同组的清理逻辑完全不同）
+        val groups = HashMap<DahiHealth.Finding, MutableList<DahiHealth.Entry>>()
+        r.findings.forEach { f ->
+            f.entries.forEach { e ->
+                if ("${f.id}:${e.key}" in checked) groups.getOrPut(f) { ArrayList() }.add(e)
+            }
+        }
+        val total = groups.values.sumOf { it.size }
+        if (total == 0) {
+            Toast.makeText(requireContext(), R.string.dahi_health_clean_none, Toast.LENGTH_SHORT).show()
+            return
+        }
+        val names = groups.keys.joinToString("、") { getString(it.titleRes) }
+        AlertDialog
+            .Builder(requireContext())
+            .setTitle(R.string.dahi_health_confirm_title)
+            .setMessage(getString(R.string.dahi_health_confirm_body, names, total))
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ -> doClean(groups) }
+            .show()
+    }
+
+    private fun doClean(groups: Map<DahiHealth.Finding, List<DahiHealth.Entry>>) {
+        lifecycleScope.launch {
+            var done = 0
+            val failed = ArrayList<String>()
+            groups.forEach { (finding, entries) ->
+                runCatching { DahiHealth.clean(finding, entries) }
+                    .onSuccess { done += it }
+                    .onFailure { failed.add(getString(finding.titleRes)) }
+            }
+            if (failed.isEmpty()) {
+                Toast.makeText(
+                    requireContext(),
+                    getString(R.string.dahi_health_clean_done, done),
+                    Toast.LENGTH_SHORT,
+                ).show()
+            } else {
+                Toast
+                    .makeText(
+                        requireContext(),
+                        getString(R.string.dahi_health_clean_failed) + "：" + failed.joinToString("、"),
+                        Toast.LENGTH_SHORT,
+                    ).show()
+            }
+            scan()
+        }
+    }
+
+    private fun copyAll() {
+        val r = report ?: return
+        val sb = StringBuilder()
+        r.findings.forEach { f ->
+            sb.append("## ").append(getString(f.titleRes)).append('\n')
+            f.entries.forEach { e ->
+                sb.append(e.label)
+                if (e.extra.isNotEmpty()) sb.append("  ").append(e.extra)
+                sb.append('\n')
+            }
+            sb.append('\n')
+        }
+        val cm = requireContext().getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+        cm.setPrimaryClip(ClipData.newPlainText("dahi-health", sb.toString()))
+        Toast.makeText(requireContext(), R.string.dahi_health_copied, Toast.LENGTH_SHORT).show()
+    }
+
+    private fun sectionTitle(titleRes: Int): TextView = TextView(requireContext()).apply {
+        setText(titleRes)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        setTypeface(typeface, Typeface.BOLD)
+        setPadding(0, dp(18), 0, dp(4))
+    }
+
+    private fun dahiAccent(): Int = requireContext().styledColor(android.R.attr.colorAccent)
+}
diff --git a/app/src/main/java/com/osfans/trime/ui/main/settings/DahiHeatmapView.kt b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiHeatmapView.kt
new file mode 100644
index 0000000..b165a19
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiHeatmapView.kt
@@ -0,0 +1,247 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.os.SystemClock
+import android.util.AttributeSet
+import android.view.MotionEvent
+import android.view.View
+import com.osfans.trime.ime.custom.DahiInputStats
+import java.util.Locale
+
+/**
+ * 键盘热力图。
+ *
+ * 布局来自**输入法实际构建出来的键盘**（每个键的相对 x / 宽度 / 高度），
+ * 所以它画的一定是你自己的键位排布 —— 换主题、改列数都会跟着变，不是写死的 QWERTY。
+ *
+ * 颜色深浅按该键在所选周期内的按压次数映射；底部空行自动留白。
+ */
+class DahiHeatmapView
+@JvmOverloads
+constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+    private val cellPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val labelPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.CENTER
+            color = 0xFF1A1A1A.toInt()
+        }
+    private val rect = RectF()
+
+    private var rows: List<List<DahiInputStats.HeatKey>> = emptyList()
+    private var counts: Map<String, Long> = emptyMap()
+    private var maxCount = 1L
+
+    /**
+     * 每个格子的命中区域（每次 [onDraw] 重建）。
+     *
+     * 因为格子位置是按键盘比例算出来的，只能等画完才知道在屏幕上的坐标，
+     * 所以命中测试统一放在绘制阶段收集、触摸阶段查表。
+     */
+    private val hitCells = mutableListOf<Pair<RectF, String>>()
+
+    /** 轻点某个键：回传键名，由调用方决定显示什么。 */
+    var onKeyTap: ((String) -> Unit)? = null
+
+    private var downX = 0f
+    private var downY = 0f
+    private var downAt = 0L
+
+    /** 供 [submit] 使用：数据为空时显示空状态。 */
+    val isEmpty: Boolean
+        get() = rows.isEmpty()
+
+    fun submit(
+        layout: List<List<DahiInputStats.HeatKey>>,
+        heat: Map<String, Long>,
+    ) {
+        rows = layout
+        counts = heat
+        maxCount = (heat.values.maxOrNull() ?: 1L).coerceAtLeast(1L)
+        requestLayout()
+        invalidate()
+    }
+
+    /**
+     * 轻点某个键 → 交给 [onKeyTap] 显示该键次数；点在键与键之间的空白 → 交回给
+     * 外部的点击监听（也就是原来的「点一下重新取数据」）。
+     */
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                downX = event.x
+                downY = event.y
+                downAt = SystemClock.uptimeMillis()
+            }
+            MotionEvent.ACTION_UP -> {
+                val slop = dp(10f, resources.displayMetrics.density)
+                val dx = event.x - downX
+                val dy = event.y - downY
+                val still = dx * dx + dy * dy <= slop * slop
+                if (still && SystemClock.uptimeMillis() - downAt < 800L) {
+                    val hit =
+                        hitCells.firstOrNull {
+                            it.second.isNotEmpty() && it.first.contains(event.x, event.y)
+                        }
+                    if (hit != null) {
+                        onKeyTap?.invoke(hit.second)
+                        return true
+                    }
+                }
+            }
+        }
+        return super.onTouchEvent(event)
+    }
+
+    override fun onMeasure(
+        widthMeasureSpec: Int,
+        heightMeasureSpec: Int,
+    ) {
+        val width = MeasureSpec.getSize(widthMeasureSpec)
+        if (rows.isEmpty() || width <= 0) {
+            setMeasuredDimension(width, 0)
+            return
+        }
+        val density = resources.displayMetrics.density
+        var total = 0f
+        rows.forEach { _ ->
+            total += rowHeightPx(density) + dp(3f, density)
+        }
+        setMeasuredDimension(width, total.toInt().coerceAtLeast(1))
+    }
+
+    /**
+     * 热力图行高：固定 dp，**不再跟随主题的 `key.height`**。
+     *
+     * 原来用「主题按键高 × 0.7」当像素，但那个值是键盘坐标系里的数值，
+     * 直接当像素会在不同主题 / 不同密度下差出好几倍：
+     *   - fira 主题 → 每行都低于「两行」阈值，键名被百分比整个顶掉；
+     *   - Q 主题 → 只有最上面那排数字键刚好踩线，同样看不到数字。
+     * 统计视图应以可读性优先，所以行高固定；宽度仍按键盘比例缩放，键盘形状不丢。
+     */
+    private fun rowHeightPx(density: Float): Float = dp(36f, density)
+
+    private fun dp(
+        value: Float,
+        density: Float,
+    ): Float = value * density
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (rows.isEmpty() || width <= 0) return
+        val density = resources.displayMetrics.density
+        val extent = rows.flatten().maxOfOrNull { it.x + it.width }?.coerceAtLeast(0.01f) ?: 1f
+        val usable = width.toFloat()
+        // 分母只算「当前这块键盘上真实存在的键」。
+        // 用全局 keyHeat 求和会把历史上别的键盘按过的键也算进来，
+        // 于是换一把新键盘后，同名的键（尤其是顶排数字键）会莫名其妙带着旧百分比。
+        val visibleLabels = rows.flatten().map { it.label }.filter { it.isNotEmpty() }.toSet()
+        val total = counts.filterKeys { it in visibleLabels }.values.sum()
+        hitCells.clear()
+        var top = 0f
+        rows.forEach { row ->
+            val h = rowHeightPx(density)
+            row.forEach { key ->
+                val left = key.x / extent * usable
+                val w = (key.width / extent * usable).coerceAtLeast(1f)
+                val gap = dp(1.5f, density)
+                rect.set(left + gap, top + gap, left + w - gap, top + h - gap)
+                val count = counts[key.label] ?: 0L
+                val t = if (maxCount > 0) count.toFloat() / maxCount else 0f
+                hitCells.add(RectF(rect) to key.label)
+                cellPaint.color = heatColor(t)
+                canvas.drawRoundRect(rect, gap * 2, gap * 2, cellPaint)
+                if (key.label.isNotEmpty()) {
+                    drawKeyText(canvas, key.label, count, total, rect)
+                }
+            }
+            top += h + dp(3f, density)
+        }
+    }
+
+    /**
+     * 在格子里画「键名 + 占比」。
+     *
+     * 占比是这个图最想看的数据，所以：
+     * - 格子够大 → 两行：上行键名、下行百分比；
+     * - 格子偏小 → 只画百分比（信息优先于键名）；
+     * - 没按过 → 只画键名（淡色），不显示 0%。
+     */
+    private fun drawKeyText(
+        canvas: Canvas,
+        label: String,
+        count: Long,
+        total: Long,
+        cell: RectF,
+    ) {
+        val density = resources.displayMetrics.density
+        val h = cell.height()
+        val w = cell.width()
+        if (h < dp(12f, density) || w < dp(12f, density)) return
+
+        val pct = if (total > 0) count * 100.0 / total else 0.0
+        val pctText =
+            when {
+                count <= 0L -> ""
+                pct >= 9.95 -> String.format(Locale.US, "%.0f%%", pct)
+                pct >= 0.05 -> String.format(Locale.US, "%.1f%%", pct)
+                else -> ""
+            }
+        val name = if (label.length > 3) label.take(2) else label
+        val showName = w >= dp(22f, density)
+        val twoLines = showName && pctText.isNotEmpty() && h >= dp(30f, density)
+
+        labelPaint.textAlign = Paint.Align.CENTER
+        labelPaint.color = labelColor
+        if (twoLines) {
+            labelPaint.textSize = minOf(h * 0.34f, w * 1.1f)
+            labelPaint.alpha = 255
+            canvas.drawText(name, cell.centerX(), cell.centerY() - h * 0.06f, labelPaint)
+            labelPaint.textSize = minOf(h * 0.30f, w * 1.1f)
+            labelPaint.alpha = 205
+            canvas.drawText(pctText, cell.centerX(), cell.centerY() + h * 0.34f, labelPaint)
+        } else {
+            val text = if (pctText.isNotEmpty()) pctText else name
+            labelPaint.textSize = minOf(h * 0.5f, w * 1.15f)
+            labelPaint.alpha = if (pctText.isNotEmpty()) 255 else 150
+            val baseline = cell.centerY() - (labelPaint.descent() + labelPaint.ascent()) / 2f
+            canvas.drawText(text, cell.centerX(), baseline, labelPaint)
+        }
+        labelPaint.alpha = 255
+    }
+
+    private var labelColor: Int = 0xFF1A1A1A.toInt()
+
+    /** 设置标签颜色（深色主题下由调用方传入浅色）。 */
+    fun setLabelColor(color: Int) {
+        labelColor = color
+        invalidate()
+    }
+
+    /**
+     * 强度 → 颜色。
+     *
+     * 冷端是几乎透明的浅灰，热端是饱和的橙红；用两段插值保证中低强度也能分辨。
+     */
+    private fun heatColor(t: Float): Int {
+        val v = t.coerceIn(0f, 1f)
+        val alpha = (30 + 200 * v).toInt()
+        val r = (200 + 55 * v).toInt().coerceIn(0, 255)
+        val g = (230 - 130 * v).toInt().coerceIn(0, 255)
+        val b = (255 - 210 * v).toInt().coerceIn(0, 255)
+        return Color.argb(alpha, r, g, b)
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ui/main/settings/DahiHourChartView.kt b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiHourChartView.kt
new file mode 100644
index 0000000..2e4616b
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiHourChartView.kt
@@ -0,0 +1,193 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.util.AttributeSet
+import android.view.View
+import androidx.core.content.ContextCompat
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiInputStats
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+
+/**
+ * 时段分布柱状图（自绘）：**按小时**（24 根）或**按星期**（7 根）。
+ *
+ * 设计取舍：
+ * - **竖柱而不是热力方块**：时间是连续轴，柱状天然表达"几点高几点低"；
+ * - **颜色跟高度走**：柱子越高越实、越低越淡，扫一眼就知道高峰在哪；
+ * - **峰值单独标出来**：柱顶画一个小圆点 + 换成暖色，不用读数字也能看出最活跃的时段；
+ * - 小时模式只画 5 个刻度（0/6/12/18/23）：24 个数字在窄屏必然挤成一团；星期模式 7 根够宽，全画。
+ */
+class DahiHourChartView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+    /** 两种统计维度。 */
+    enum class Mode {
+        HOURS,
+        WEEKDAYS,
+    }
+
+    /** 点某根柱子：回传下标（小时模式下 0~23，星期模式下 0~6 = 周一~周日）。 */
+    var onBarClick: ((Int) -> Unit)? = null
+
+    private var downX = 0f
+
+    private var ratios: List<Float> = emptyList()
+    private var labels: List<String> = emptyList()
+    private var peakIndex = -1
+
+    /** 小时模式只标这几个刻度；星期模式每根都标。 */
+    private var sparseTicks = true
+
+    private val accent =
+        runCatching { context.styledColor(android.R.attr.colorAccent) }
+            .getOrElse { ContextCompat.getColor(context, android.R.color.holo_blue_dark) }
+
+    private val warm = 0xFFFF9A5B.toInt()
+
+    private val emptyColor = 0x22808080
+
+    init {
+        // 走标准点击通路：手指一动父容器照样能滚，只有真的点一下才触发 performClick
+        isClickable = true
+    }
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    private val labelPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textSize = dp(10f)
+            color =
+                runCatching { context.styledColor(android.R.attr.textColorSecondary) }
+                    .getOrElse { 0xFF888888.toInt() }
+        }
+
+    /** 提交统计数据。 */
+    fun submit(
+        data: DahiInputStats.Bucket,
+        mode: Mode = Mode.HOURS,
+    ) {
+        when (mode) {
+            Mode.HOURS -> {
+                ratios = (0..23).map { data.hourRatio(it).toFloat() }
+                labels = (0..23).map { it.toString() }
+                peakIndex = data.busiestHour()?.first ?: -1
+                sparseTicks = true
+            }
+
+            Mode.WEEKDAYS -> {
+                // 显示顺序按「周一 .. 周日」：Calendar 里周日是 1，摆到最后更符合中文习惯
+                val order = listOf(2, 3, 4, 5, 6, 7, 1)
+                val weekNames = context.resources.getStringArray(R.array.dahi_week_names)
+                ratios = order.map { data.weekdayRatio(it).toFloat() }
+                labels = order.mapIndexed { index, _ -> weekNames.getOrElse(index) { "" } }
+                val peakDay = data.busiestWeekday()?.first ?: -1
+                peakIndex = order.indexOf(peakDay)
+                sparseTicks = false
+            }
+        }
+        invalidate()
+    }
+
+    override fun onTouchEvent(event: android.view.MotionEvent): Boolean {
+        if (event.actionMasked == android.view.MotionEvent.ACTION_DOWN) downX = event.x
+        return super.onTouchEvent(event)
+    }
+
+    override fun performClick(): Boolean {
+        super.performClick()
+        if (ratios.isEmpty()) return true
+        val slot = width.toFloat() / ratios.size
+        val idx = (downX / slot).toInt()
+        if (idx in ratios.indices) onBarClick?.invoke(idx)
+        return true
+    }
+
+    override fun onMeasure(
+        widthMeasureSpec: Int,
+        heightMeasureSpec: Int,
+    ) {
+        val width =
+            if (MeasureSpec.getMode(widthMeasureSpec) == MeasureSpec.UNSPECIFIED) {
+                dp(300)
+            } else {
+                MeasureSpec.getSize(widthMeasureSpec)
+            }
+        setMeasuredDimension(width, dp(108))
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (ratios.isEmpty()) return
+        val labelH = dp(16f)
+        val chartH = height - labelH
+        if (chartH <= 0f) return
+
+        val n = ratios.size
+        val gap = dp(3f)
+        val barW = ((width - gap * (n - 1)) / n).coerceAtLeast(1f)
+        val maxRatio = ratios.maxOrNull() ?: 0f
+
+        ratios.forEachIndexed { index, ratio ->
+            val left = index * (barW + gap)
+            val norm = if (maxRatio > 0f) ratio / maxRatio else 0f
+            val barH = if (ratio <= 0f) dp(2f) else (chartH * norm).coerceAtLeast(dp(4f))
+            paint.color =
+                when {
+                    ratio <= 0f -> emptyColor
+                    index == peakIndex -> warm
+                    else -> withAlpha(accent, (0.35f + 0.65f * norm).coerceIn(0.35f, 1f))
+                }
+            canvas.drawRoundRect(
+                RectF(left, chartH - barH, left + barW, chartH),
+                barW / 2.4f,
+                barW / 2.4f,
+                paint,
+            )
+            if (index == peakIndex && ratio > 0f) {
+                paint.color = warm
+                canvas.drawCircle(left + barW / 2f, chartH - barH - dp(4f), dp(2.2f), paint)
+            }
+        }
+
+        if (sparseTicks) {
+            // 小时模式：只在 0 / 6 / 12 / 18 / 23 写数字
+            listOf(0, 6, 12, 18, 23).forEach { hour ->
+                val left = hour * (barW + gap)
+                val text = labels.getOrElse(hour) { "" }
+                val textW = labelPaint.measureText(text)
+                val x =
+                    when (hour) {
+                        0 -> 0f
+                        23 -> width - textW
+                        else -> left + barW / 2f - textW / 2f
+                    }
+                canvas.drawText(text, x, height - dp(2f), labelPaint)
+            }
+        } else {
+            labels.forEachIndexed { index, text ->
+                val left = index * (barW + gap)
+                val textW = labelPaint.measureText(text)
+                canvas.drawText(text, left + barW / 2f - textW / 2f, height - dp(2f), labelPaint)
+            }
+        }
+    }
+
+    private fun withAlpha(
+        color: Int,
+        alpha: Float,
+    ): Int {
+        val a = (alpha * 255).toInt().coerceIn(0, 255)
+        return (color and 0x00FFFFFF) or (a shl 24)
+    }
+}
