index 0000000..a9aaec3
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyboardBackgroundDrawable.kt
@@ -0,0 +1,92 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.graphics.Bitmap
+import android.graphics.BitmapShader
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.drawable.Drawable
+
+/**
+ * 把用户图片按「拉伸铺满 / 居中（裁剪铺满）/ 重复平铺」绘制到键盘背景，并带整体透明度。
+ *
+ * 居中模式采用**居中裁剪**（按目标宽高比裁剪源图中心区域），因此绝不会拉伸变形。
+ */
+class DahiKeyboardBackgroundDrawable(
+    private val bitmap: Bitmap,
+    private val mode: DahiKeyboardBackground.Mode,
+    alpha: Int,
+) : Drawable() {
+    private val paint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val src = Rect()
+    private val dst = RectF()
+
+    init {
+        paint.alpha = alpha.coerceIn(0, 255)
+    }
+
+    override fun draw(canvas: Canvas) {
+        val b = bounds
+        if (b.isEmpty) return
+        when (mode) {
+            DahiKeyboardBackground.Mode.STRETCH -> canvas.drawBitmap(bitmap, null, b, paint)
+            DahiKeyboardBackground.Mode.CENTER -> {
+                val bw = b.width().toFloat()
+                val bh = b.height().toFloat()
+                val iw = bitmap.width.toFloat()
+                val ih = bitmap.height.toFloat()
+                if (bw <= 0f || bh <= 0f || iw <= 0f || ih <= 0f) return
+                val scale = maxOf(bw / iw, bh / ih)
+                val cropW = (bw / scale).toInt().coerceIn(1, bitmap.width)
+                val cropH = (bh / scale).toInt().coerceIn(1, bitmap.height)
+                val left = (bitmap.width - cropW) / 2
+                val top = (bitmap.height - cropH) / 2
+                src.set(left, top, left + cropW, top + cropH)
+                dst.set(b.left.toFloat(), b.top.toFloat(), b.right.toFloat(), b.bottom.toFloat())
+                canvas.drawBitmap(bitmap, src, dst, paint)
+            }
+            DahiKeyboardBackground.Mode.FIT -> {
+                val bw = b.width().toFloat()
+                val bh = b.height().toFloat()
+                val iw = bitmap.width.toFloat()
+                val ih = bitmap.height.toFloat()
+                if (bw <= 0f || bh <= 0f || iw <= 0f || ih <= 0f) return
+                val s = minOf(bw / iw, bh / ih)
+                val dw = iw * s
+                val dh = ih * s
+                val left = b.left + (bw - dw) / 2f
+                val top = b.top + (bh - dh) / 2f
+                dst.set(left, top, left + dw, top + dh)
+                canvas.drawBitmap(bitmap, null, dst, paint)
+            }
+            DahiKeyboardBackground.Mode.TILE -> {
+                paint.shader = BitmapShader(bitmap, Shader.TileMode.REPEAT, Shader.TileMode.REPEAT)
+                canvas.drawRect(b, paint)
+                paint.shader = null
+            }
+        }
+    }
+
+    override fun setAlpha(alpha: Int) {
+        paint.alpha = alpha.coerceIn(0, 255)
+        invalidateSelf()
+    }
+
+    override fun setColorFilter(colorFilter: ColorFilter?) {
+        paint.colorFilter = colorFilter
+        invalidateSelf()
+    }
+
+    @Deprecated("Deprecated in Java")
+    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+}
