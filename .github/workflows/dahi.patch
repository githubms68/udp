+    // ---------------- 批量选择 ----------------
+
+    /**
+     * 通知列表刷新。
+     *
+     * 必须延后一帧：条目长按菜单是 PopupMenu，它关闭时会引发一次重新布局，
+     * 此刻若同步调用 `notifyDataSetChanged()`，RecyclerView 会抛
+     * `IllegalStateException: Cannot call this method while RecyclerView is computing a layout or scrolling`
+     * ——输入法进程随之崩溃，用户看到的就是「键盘收回、整个界面消失」。
+     */
+    private fun notifyResults(id: Int? = null) {
+        listView.post {
+            runCatching {
+                if (id == null) resultAdapter.notifyAllChanged() else resultAdapter.notifyIdChanged(id)
+            }
+        }
+    }
+
+    private fun enterBatch(initialId: Int?) {
+        batchMode = true
+        if (initialId != null) selectedIds.add(initialId)
+        searchRow.visibility = View.GONE
+        batchBar.visibility = View.VISIBLE
+        notifyResults()
+        updateBatchCount()
+    }
+
+    private fun exitBatch() {
+        batchMode = false
+        selectedIds.clear()
+        searchRow.visibility = View.VISIBLE
+        batchBar.visibility = View.GONE
+        notifyResults()
+    }
+
+    private fun toggleSelection(id: Int) {
+        if (!selectedIds.add(id)) selectedIds.remove(id)
+        notifyResults(id)
+        updateBatchCount()
+    }
+
+    private fun selectAll() {
+        selectedIds.clear()
+        selectedIds.addAll(resultAdapter.allIds())
+        notifyResults()
+        updateBatchCount()
+    }
+
+    private fun updateBatchCount() {
+        batchCount.text = ctx.getString(R.string.dahi_cp_batch_count, selectedIds.size)
+    }
+
+    /**
+     * 这条正文在当前结果里算不算「收藏夹那一份」。
+     *
+     * 剪贴板与收藏是两个独立的库，id 会重复，所以只能按正文判来源。
+     * 单选某个库时范围本身已经决定了归属；「全部」范围里两个库都有同一段文字时，
+     * 列表显示的是剪贴板那一份（去重优先剪贴板），因此按剪贴板处理。
+     */
+    private fun isFavRow(text: String): Boolean = when (scope) {
+        1 -> false
+        2 -> true
+        else -> text in inFavTexts && text !in inClipTexts
+    }
+
+    /** 该 id 是否属于收藏夹（见 [isFavRow]）。 */
+    private fun isCollectionId(id: Int): Boolean {
+        val text = resultAdapter.textOf(id) ?: return false
+        return isFavRow(text)
+    }
