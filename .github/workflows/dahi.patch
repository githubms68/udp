@@ -0,0 +1,103 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.view.View
+import com.osfans.trime.R
+
+/**
+ * 某一次词出现的时间分布：24 根小柱。
+ *
+ * 只做「画」这一件事：外部把 counts[24] 交进来即可。
+ */
+class DahiWordSlotChartView(
+    context: Context,
+) : View(context) {
+    private val barPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val axisPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val gridPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val rect = RectF()
+    private var counts = IntArray(24)
+    private var accent = 0xFF3B82F6.toInt()
+
+    init {
+        axisPaint.color = 0x80808080.toInt()
+        axisPaint.textSize = dp(9f)
+        gridPaint.color = 0x33808080
+        gridPaint.strokeWidth = dp(1f)
+    }
+
+    private fun dp(v: Float): Float = v * resources.displayMetrics.density
+
+    fun setAccent(color: Int) {
+        accent = color
+    }
+
+    fun submit(values: IntArray) {
+        counts = if (values.size == 24) values else IntArray(24)
+        invalidate()
+    }
+
+    override fun onMeasure(
+        widthMeasureSpec: Int,
+        heightMeasureSpec: Int,
+    ) {
+        setMeasuredDimension(
+            MeasureSpec.getSize(widthMeasureSpec),
+            dp(92f).toInt().coerceAtMost(MeasureSpec.getSize(heightMeasureSpec).takeIf { it > 0 } ?: Int.MAX_VALUE),
+        )
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        val max = counts.maxOrNull()?.coerceAtLeast(1) ?: 1
+        val w = width.toFloat()
+        val h = height.toFloat()
+        val labelBand = dp(14f)
+        val bottom = h - labelBand
+        val slot = w / 24f
+        val gap = slot * 0.22f
+
+        // 每小时的格子线：24 格一眼可数，柱子落在哪一格不用猜
+        for (i in 0..24) {
+            val x = (i * slot).coerceIn(0f, w)
+            canvas.drawLine(x, bottom - dp(3f), x, bottom, gridPaint)
+        }
+
+        barPaint.color = accent
+        counts.forEachIndexed { i, c ->
+            val ratio = c.toFloat() / max
+            val barH = (bottom - dp(4f)) * ratio
+            rect.set(
+                i * slot + gap / 2f,
+                bottom - barH,
+                (i + 1) * slot - gap / 2f,
+                bottom,
+            )
+            // 没数据的柱子留一条淡底，看得出是 24 格
+            barPaint.alpha = if (c == 0) 40 else 200
+            canvas.drawRoundRect(rect, dp(2f), dp(2f), barPaint)
+        }
+
+        // 刻度与「时段分布」一致：0 / 6 / 12 / 18 / 23（23 右对齐，别被裁掉）
+        listOf(0, 6, 12, 18, 23).forEach { hour ->
+            val text = context.getString(R.string.dahi_stats_hour_unit, hour)
+            val tw = axisPaint.measureText(text)
+            val x =
+                when (hour) {
+                    0 -> 0f
+                    23 -> w - tw
+                    else -> hour * slot + slot / 2f - tw / 2f
+                }
+            canvas.drawText(text, x, h - dp(2f), axisPaint)
+        }
+    }
+}
