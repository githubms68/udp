+
+package com.osfans.trime.ui.main.settings
+
+/**
+ * 分享图的四套配色。
+ *
+ * 统计分享图（DahiStatsImage）、年度回顾（DahiYearReviewImage）、
+ * 打字风格卡（DahiStyleCardImage）共用同一份定义与同一个偏好键
+ * （`dahi_stats_image_template`），用户选过一次，三处都是同一个风格。
+ */
+internal object DahiSharePalette {
+    class Palette(
+        val bgTop: Int,
+        val bgBottom: Int,
+        val card: Int,
+        val textMain: Int,
+        val textSub: Int,
+        val textDim: Int,
+        val accent: Int,
+        val accentWarm: Int,
+        val divider: Int,
+    )
+
+    /** 半透明版 accent，用作标签 chip 的底色。 */
+    fun tint(
+        color: Int,
+        alpha: Int,
+    ): Int = (color and 0x00FFFFFF) or ((alpha and 0xFF) shl 24)
+
+    fun of(id: String): Palette = when (id) {
+        "ink" ->
+            Palette(
+                bgTop = 0xFFF7F4EE.toInt(),
+                bgBottom = 0xFFEFE9DE.toInt(),
+                card = 0xFFFFFFFF.toInt(),
+                textMain = 0xFF2B2A26.toInt(),
+                textSub = 0xFF6B6558.toInt(),
+                textDim = 0xFF9A9384.toInt(),
+                accent = 0xFF3C6E8F.toInt(),
+                accentWarm = 0xFFB4652F.toInt(),
+                divider = 0x22000000,
+            )
+        "neon" ->
+            Palette(
+                bgTop = 0xFF12081F.toInt(),
+                bgBottom = 0xFF1B0F2E.toInt(),
+                card = 0xFF241535.toInt(),
+                textMain = 0xFFF4E9FF.toInt(),
+                textSub = 0xFFB79FD6.toInt(),
+                textDim = 0xFF7A6795.toInt(),
+                accent = 0xFF35E0C8.toInt(),
+                accentWarm = 0xFFE05FA8.toInt(),
+                divider = 0x33FFFFFF,
+            )
+        "sand" ->
+            Palette(
+                bgTop = 0xFF2A2118.toInt(),
+                bgBottom = 0xFF3A2E20.toInt(),
+                card = 0xFF443626.toInt(),
+                textMain = 0xFFF3E9DA.toInt(),
+                textSub = 0xFFC4B29A.toInt(),
+                textDim = 0xFF8D7C66.toInt(),
+                accent = 0xFFE0A85F.toInt(),
+                accentWarm = 0xFFD97B4A.toInt(),
+                divider = 0x33FFFFFF,
+            )
+        else ->
+            Palette(
+                bgTop = 0xFF0E1118.toInt(),
+                bgBottom = 0xFF171E2B.toInt(),
+                card = 0xFF1C2433.toInt(),
+                textMain = 0xFFF2F5FA.toInt(),
+                textSub = 0xFFA9B4C6.toInt(),
+                textDim = 0xFF6B7688.toInt(),
+                accent = 0xFF7AA2F7.toInt(),
+                accentWarm = 0xFFF7A26B.toInt(),
+                divider = 0x33FFFFFF,
+            )
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ui/main/settings/DahiStatsImage.kt b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiStatsImage.kt
new file mode 100644
index 0000000..a27a1af
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiStatsImage.kt
@@ -0,0 +1,1510 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import androidx.appcompat.content.res.AppCompatResources
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiDailyHistory
+import com.osfans.trime.ime.custom.DahiInputStats
+import com.osfans.trime.ime.custom.DahiWordHidden
+import com.osfans.trime.ime.custom.DahiVoiceStats
+import java.util.Locale
+
+/**
+ * 把输入统计画成分享长图（二期 / 三期）。
+ *
+ * 两种版式：
+ * - **简版**：段位卡 + 四个核心数字 + 方案与称号，发群里一眼看完；
+ * - **详细**：再加输入速度（含「键/秒」节奏）、候选质量、词长 / 码长分布、键盘热力。
+ *
+ * 设计要点：
+ * 1. 先测量后绘制 —— 内容高度靠一遍「空跑」算出来，不会出现底部被裁掉或大片留白；
+ * 2. 图标全部用 [Canvas] 画（闪电 / 靶心 / 书），不打包任何图片资源，任何机型都能显示；
+ * 3. 热力格子**同时画键名与百分比** —— 只画百分比的话，分享出去对方根本不知道是哪个键；
+ * 4. 全部内容只有统计数字，**不含任何输入内容**，天然脱敏。
+ */
+object DahiStatsImage {
+    private const val WIDTH = 1080
+    private const val PAD = 56f
+    private const val RADIUS = 28f
+
+    /**
+     * 分享图配色模板。**只换配色、不换版式** ——
+     * 版式一变就要维护四套布局，而用户真正想要的只是「换个感觉发出去更好看」。
+     */
+    enum class Template(val id: String) {
+        /** 默认：深海夜色（原版）。 */
+        DEEP("deep"),
+
+        /** 宣纸：浅底深字，适合截图贴到浅色网页 / 文档里。 */
+        INK("ink"),
+
+        /** 霓虹：深底青紫，适合社交平台。 */
+        NEON("neon"),
+
+        /** 暖沙：暖褐底 + 琥珀色，护眼、柔和。 */
+        SAND("sand"),
+        ;
+
+        companion object {
+            fun of(id: String?): Template = values().firstOrNull { it.id == id } ?: DEEP
+        }
+    }
+
+    private class Palette(
+        val bgTop: Int,
+        val bgBottom: Int,
+        val cardBg: Int,
+        val chipBg: Int,
+        val trackBg: Int,
+        val textMain: Int,
+        val textSub: Int,
+        val textDim: Int,
+        val accent: Int,
+        val accent2: Int,
+        val warm: Int,
+        val good: Int,
+    )
+
+    private fun paletteOf(t: Template): Palette = when (t) {
+        Template.DEEP ->
+            Palette(
+                Color.parseColor("#0E1118"), Color.parseColor("#171E2B"), Color.parseColor("#1B2230"),
+                Color.parseColor("#212A3B"), Color.parseColor("#2A3346"), Color.parseColor("#FFFFFF"),
+                Color.parseColor("#98A4BC"), Color.parseColor("#6B7688"), Color.parseColor("#5B8CFF"),
+                Color.parseColor("#8B6BFF"), Color.parseColor("#FF9A5B"), Color.parseColor("#4ADE80"),
+            )
+
+        Template.INK ->
+            Palette(
+                Color.parseColor("#F7F7F4"), Color.parseColor("#ECEDE8"), Color.parseColor("#FFFFFF"),
+                Color.parseColor("#F1F2EE"), Color.parseColor("#DFE1DB"), Color.parseColor("#1A1D22"),
+                Color.parseColor("#565E6B"), Color.parseColor("#8A919D"), Color.parseColor("#2F6BFF"),
+                Color.parseColor("#7A4DFF"), Color.parseColor("#C2622A"), Color.parseColor("#2E9E5B"),
+            )
+
+        Template.NEON ->
+            Palette(
+                Color.parseColor("#07070C"), Color.parseColor("#120C1F"), Color.parseColor("#151021"),
+                Color.parseColor("#1D1630"), Color.parseColor("#261C3C"), Color.parseColor("#FFFFFF"),
+                Color.parseColor("#BBA9E6"), Color.parseColor("#7C6B9E"), Color.parseColor("#22D3EE"),
+                Color.parseColor("#F472B6"), Color.parseColor("#FBBF24"), Color.parseColor("#34D399"),
+            )
+
+        Template.SAND ->
+            Palette(
+                Color.parseColor("#14110C"), Color.parseColor("#1E1911"), Color.parseColor("#221D15"),
+                Color.parseColor("#2B241A"), Color.parseColor("#352D21"), Color.parseColor("#FBF6EC"),
+                Color.parseColor("#CDBFA8"), Color.parseColor("#94896F"), Color.parseColor("#E0A458"),
+                Color.parseColor("#D97757"), Color.parseColor("#F2C14E"), Color.parseColor("#8BC48A"),
+            )
+    }
+
+    // 当前生效的配色（由 [applyPalette] 在每次 render 开始时按模板设置；
+    // render 是 @Synchronized 的，因此测量与绘制两遍之间不会被别的模板插队）
+    private var bgTop = Color.parseColor("#0E1118")
+    private var bgBottom = Color.parseColor("#171E2B")
+    private var cardBg = Color.parseColor("#1B2230")
+    private var chipBg = Color.parseColor("#212A3B")
+    private var trackBg = Color.parseColor("#2A3346")
+    private var textMain = Color.parseColor("#FFFFFF")
+    private var textSub = Color.parseColor("#98A4BC")
+    private var textDim = Color.parseColor("#6B7688")
+    private var accent = Color.parseColor("#5B8CFF")
+    private var accent2 = Color.parseColor("#8B6BFF")
+    private var warm = Color.parseColor("#FF9A5B")
+    private var good = Color.parseColor("#4ADE80")
+
+    /** 词云「浮起」用的阴影色：浅底用暗影、深底用亮影（深底上黑色阴影等于看不见）。 */
+    private var cloudShadow = 0x66000000
+
+    /** 当前模板是不是浅色底（宣纸）。 */
+    private var lightBg = false
+
+    private fun applyPalette(t: Template) {
+        val p = paletteOf(t)
+        bgTop = p.bgTop
+        bgBottom = p.bgBottom
+        cardBg = p.cardBg
+        chipBg = p.chipBg
+        trackBg = p.trackBg
+        textMain = p.textMain
+        textSub = p.textSub
+        textDim = p.textDim
+        accent = p.accent
+        accent2 = p.accent2
+        warm = p.warm
+        good = p.good
+        // textMain 亮 → 深色底 → 用白色阴影（看起来像微光）；反之用黑色阴影
+        val lum =
+            (
+                0.299 * Color.red(p.textMain) +
+                    0.587 * Color.green(p.textMain) +
+                    0.114 * Color.blue(p.textMain)
+            ) / 255.0
+        // textMain 深 → 浅色底（宣纸）；textMain 白 → 深色底
+        lightBg = lum < 0.5
+        cloudShadow = if (lightBg) 0x66000000 else 0x77FFFFFF
+    }
+
+    // ------------------------------------------------------------------ 对外入口
+
+    /** 生成分享图。[detailed] = true 为详细版，[template] 为配色模板。 */
+    @Synchronized
+    fun render(
+        ctx: Context,
+        period: DahiInputStats.Period,
+        detailed: Boolean,
+        showHeat: Boolean = true,
+        showSchemas: Boolean = true,
+        showAdvice: Boolean = true,
+        showVoice: Boolean = true,
+        showHours: Boolean = true,
+        showCloud: Boolean = true,
+        template: Template = Template.DEEP,
+        showDaily: Boolean = true,
+        showSpeed: Boolean = true,
+        showCandidate: Boolean = true,
+        showDistribution: Boolean = true,
+        showChips: Boolean = true,
+    ): Bitmap {
+        applyPalette(template)
+        val model =
+            sample(
+                ctx,
+                period,
+                detailed,
+                showHeat,
+                showSchemas,
+                showAdvice,
+                showVoice,
+                showHours,
+                showCloud,
+                showDaily,
+                showSpeed,
+                showCandidate,
+                showDistribution,
+                showChips,
+            )
+        // 第一遍：画在 1×1 画布上，只为算出真实高度
+        val height = draw(Canvas(Bitmap.createBitmap(1, 1, Bitmap.Config.ARGB_8888)), model).toInt()
+            .coerceIn(420, 8000)
+        val bitmap = Bitmap.createBitmap(WIDTH, height, Bitmap.Config.ARGB_8888)
+        draw(Canvas(bitmap), model)
+        return bitmap
+    }
+
+    // ------------------------------------------------------------------ 数据
