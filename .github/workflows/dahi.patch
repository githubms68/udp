+    /** 「最近备份：11-04 07:20（3 小时前）」；没备份过就说清楚。 */
+    private fun lastBackupSummary(): String {
+        val t = runCatching { prefs.dahiLastManualBackup.getValue() }.getOrDefault(0L)
+        if (t <= 0L) return getString(R.string.dahi_last_backup_never)
+        val fmt = java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.getDefault())
+        val agoMs = System.currentTimeMillis() - t
+        val ago =
+            when {
+                agoMs < 3600_000L -> getString(R.string.dahi_ago_minutes, (agoMs / 60_000L).coerceAtLeast(1))
+                agoMs < 86_400_000L -> getString(R.string.dahi_ago_hours, agoMs / 3600_000L)
+                else -> getString(R.string.dahi_ago_days, agoMs / 86_400_000L)
+            }
+        return getString(R.string.dahi_last_backup_value, fmt.format(java.util.Date(t)), ago)
+    }
+
+    /** 自动备份记录：列出最近几份，可恢复 / 清空（清空要二次确认）。 */
+    private fun showAutoBackupDialog() {
+        val ctx = requireContext()
+        val items = com.osfans.trime.data.backup.DahiAutoBackup.list()
+        if (items.isEmpty()) {
+            android.widget.Toast
+                .makeText(ctx, R.string.dahi_auto_backup_empty, android.widget.Toast.LENGTH_SHORT)
+                .show()
+            return
+        }
+        viewLifecycleOwner.lifecycleScope.launch {
+            // 每份都要读文件数条目，放 IO 线程（最多几份）
+            val labels =
+                withContext(Dispatchers.IO) {
+                    val fmt = java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.getDefault())
+                    val json =
+                        kotlinx.serialization.json.Json {
+                            ignoreUnknownKeys = true
+                            encodeDefaults = false
+                        }
+                    items
+                        .map { item ->
+                            val tag =
+                                if (item.isSnapshot) {
+                                    getString(R.string.dahi_auto_backup_snapshot, item.reason.orEmpty())
+                                } else {
+                                    getString(R.string.dahi_auto_backup_daily)
+                                }
+                            val counts =
+                                runCatching {
+                                    val d =
+                                        json.decodeFromString(
+                                            com.osfans.trime.data.backup.BackupData.serializer(),
+                                            item.file.readText(),
+                                        )
+                                    (d.clipboard?.size ?: 0) to (d.collection?.size ?: 0)
+                                }.getOrDefault(0 to 0)
+                            "${fmt.format(java.util.Date(item.time))}  ·  $tag  ·  " +
+                                getString(R.string.dahi_diag_backup_counts, counts.first, counts.second) +
+                                "  ·  ${item.sizeBytes / 1024} KB"
+                        }.toTypedArray()
+                }
+            if (!isAdded) return@launch
+            androidx.appcompat.app.AlertDialog
+                .Builder(ctx)
+                .setTitle(R.string.dahi_auto_backup_records)
+                .setItems(labels) { _, which ->
+                    val item = items[which]
+                    androidx.appcompat.app.AlertDialog
+                        .Builder(ctx)
+                        .setTitle(R.string.dahi_auto_backup_restore_title)
+                        .setMessage(getString(R.string.dahi_auto_backup_restore_message, labels[which]))
+                        .setPositiveButton(android.R.string.ok) { _, _ ->
+                            lifecycleScope.launch {
+                                val ok = com.osfans.trime.data.backup.DahiAutoBackup.restore(item)
+                                android.widget.Toast
+                                    .makeText(
+                                        ctx,
+                                        if (ok) R.string.dahi_auto_backup_restored else R.string.dahi_backup_failure,
+                                        android.widget.Toast.LENGTH_SHORT,
+                                    ).show()
+                            }
+                        }.setNegativeButton(android.R.string.cancel, null)
+                        .show()
+                }.setNeutralButton(R.string.dahi_auto_backup_clear) { _, _ ->
+                    // 删数据一律二次确认
+                    androidx.appcompat.app.AlertDialog
+                        .Builder(ctx)
+                        .setTitle(R.string.dahi_auto_backup_clear)
+                        .setMessage(getString(R.string.dahi_auto_backup_clear_confirm, items.size))
+                        .setPositiveButton(android.R.string.ok) { _, _ ->
+                            val n = com.osfans.trime.data.backup.DahiAutoBackup.clearAll()
+                            android.widget.Toast
+                                .makeText(
+                                    ctx,
+                                    getString(R.string.dahi_auto_backup_cleared, n),
+                                    android.widget.Toast.LENGTH_SHORT,
+                                ).show()
+                        }.setNegativeButton(android.R.string.cancel, null)
+                        .show()
+                }.setNegativeButton(android.R.string.cancel, null)
+                .show()
+        }
+    }
+
+    /** 保留份数：每日备份 / 操作前快照各一份，可恢复默认。 */
+    private fun showKeepCountDialog() {
+        val ctx = requireContext()
+        val daily = prefs.dahiAutoBackupKeepDaily
+        val snap = prefs.dahiAutoBackupKeepSnapshot
+        val box =
+            android.widget.LinearLayout(ctx).apply {
+                orientation = android.widget.LinearLayout.VERTICAL
+                setPadding(ctx.dp(20), ctx.dp(8), ctx.dp(20), 0)
+            }
+        fun input(
+            label: String,
+            value: Int,
+        ): android.widget.EditText {
+            val tv =
+                android.widget.TextView(ctx).apply {
+                    text = label
+                    setPadding(0, ctx.dp(10), 0, 0)
+                }
+            box.addView(tv)
+            return android.widget.EditText(ctx).apply {
+                setText(value.toString())
+                inputType = android.text.InputType.TYPE_CLASS_NUMBER
+                setSingleLine()
+                box.addView(this)
+            }
+        }
+        val dailyInput = input(getString(R.string.dahi_auto_backup_keep_daily), daily.getValue())
+        val snapInput = input(getString(R.string.dahi_auto_backup_keep_snap), snap.getValue())
+        androidx.appcompat.app.AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_auto_backup_keep)
+            .setView(box)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val d = dailyInput.text.toString().toIntOrNull()?.coerceIn(1, 20) ?: 3
+                val sn = snapInput.text.toString().toIntOrNull()?.coerceIn(1, 20) ?: 5
+                daily.setValue(d)
+                snap.setValue(sn)
+            }.setNeutralButton(R.string.dahi_auto_backup_keep_reset) { _, _ ->
+                daily.setValue(com.osfans.trime.data.backup.DahiAutoBackup.DEFAULT_DAILY_KEEP)
+                snap.setValue(com.osfans.trime.data.backup.DahiAutoBackup.DEFAULT_SNAPSHOT_KEEP)
+            }.setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
     override fun onDestroy() {
