+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.util.appContext
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * 候选词手动排序（大海版）。
+ *
+ * 纯 App 层实现：不修改 Rime 引擎、JNI 与用户方案，
+ * 而是记录「某个输入编码下候选词的自定义顺序」，在
+ * [com.osfans.trime.core.Rime] 生成候选列表时按记录重排「显示顺序」，
+ * 选择/删除时再把显示下标映射回 Rime 原始下标。
+ *
+ * 存储在默认 SharedPreferences（键 `dahi_candidate_order`，JSON），随「备份与还原」一起导出。
+ */
+object DahiCandidateOrder {
+    /** 偏好键（供备份 / 还原按名引用）。 */
+    const val PREF_KEY = "dahi_candidate_order"
+    private const val KEY_MAP = PREF_KEY
+
+    /** 「自定义短语」候选在排序中的哨兵键（不会与真实候选文本冲突）。 */
+    const val PHRASE = "\u0000dahi:phrase\u0000"
+
+    /** 排序动作：前移 / 后移 / 置顶 / 垫底 / 移到上一页 / 下一页 / 页首 / 页尾。 */
+    enum class Move { UP, DOWN, TOP, BOTTOM, PREV_PAGE, NEXT_PAGE, PAGE_TOP, PAGE_BOTTOM }
+
+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    @Volatile
+    private var orders: MutableMap<String, MutableList<String>>? = null
+
+    init {
+        // 外部写入（例如「备份与还原」恢复）后自动失效缓存，无需重启即可生效
+        runCatching {
+            prefs.registerOnSharedPreferenceChangeListener { _, key ->
+                if (key == KEY_MAP) orders = null
+            }
+        }
+    }
+
+    /** 最近一次候选更新时的输入编码与其「原始候选顺序」（由 Rime 写入）。 */
+    private var currentInput: String = ""
+    private var currentOriginal: List<String> = emptyList()
+
+    /** 最近一次更新时所在的候选页与页大小（用于「移到上页 / 下页 / 页首 / 页尾」）。 */
+    private var currentPage: Int = 0
+    private var currentPageSize: Int = 6
+
+    private fun load(): MutableMap<String, MutableList<String>> {
+        orders?.let { return it }
+        val map = linkedMapOf<String, MutableList<String>>()
+        runCatching {
+            val raw = prefs.getString(KEY_MAP, null)
+            if (!raw.isNullOrEmpty()) {
+                val json = JSONObject(raw)
+                json.keys().forEach { key ->
+                    val arr = json.optJSONArray(key) ?: return@forEach
+                    val list = ArrayList<String>(arr.length())
+                    for (i in 0 until arr.length()) list.add(arr.optString(i))
+                    map[key] = list
+                }
+            }
+        }
+        orders = map
+        return map
+    }
+
+    private fun save() {
+        val map = orders ?: return
+        val json = JSONObject()
+        map.forEach { (key, list) -> json.put(key, JSONArray(list)) }
+        prefs.edit { putString(KEY_MAP, json.toString()) }
+    }
+
+    private fun normalize(input: String): String = input.trim().lowercase()
+
+    /**
+     * 批量导入「编码 → 候选词顺序」（来自 Rime 调频词表）。
+     *
+     * [merge] = true：该编码已有的顺序**保留**，导入的词追加在后 —— 不会覆盖用户手工调过的部分；
+     * [merge] = false：整体替换该编码的顺序。
+     *
+     * 只写本机的排序表，**不碰 Rime 词典 / 用户词库**；
+     * 导入的词若当前候选里不存在，读取时会被自动忽略（displayOrder 只认原始候选里有的词），
+     * 所以导入一份别的词库的表也不会把候选弄乱。
+     *
+     * @return (写入的编码数, 新增的词条数)
+     */
+    fun importOrders(
+        incoming: Map<String, List<String>>,
+        merge: Boolean,
+    ): Pair<Int, Int> {
+        if (incoming.isEmpty()) return 0 to 0
+        val map = load()
+        var codes = 0
+        var words = 0
+        incoming.forEach { (rawCode, list) ->
+            val code = normalize(rawCode)
+            if (code.isEmpty() || list.isEmpty()) return@forEach
+            val target: MutableList<String> =
+                if (merge) {
+                    map[code] ?: mutableListOf()
+                } else {
+                    mutableListOf()
+                }
+            val seen = target.toHashSet()
+            list.forEach { w ->
+                val word = w.trim()
+                if (word.isNotEmpty() && seen.add(word)) {
+                    target.add(word)
+                    words++
+                }
+            }
+            if (target.isNotEmpty()) {
+                map[code] = target
+                codes++
+            }
+        }
+        save()
+        return codes to words
+    }
+
+    /** 记录当前输入与其原始候选文本顺序（每次候选更新时由 Rime 调用）。 */
+    fun setCurrent(
+        input: String,
+        originalTexts: List<String>,
+        page: Int = 0,
+        pageSize: Int = 6,
+    ) {
+        currentInput = normalize(input)
+        currentOriginal = originalTexts
+        currentPage = page.coerceAtLeast(0)
+        currentPageSize = pageSize.coerceAtLeast(1)
+    }
+
+    /** 应用用户自定义顺序后的显示顺序；无记录时原样返回 [originalTexts]。 */
+    fun displayOrder(
+        input: String,
+        originalTexts: List<String>,
+    ): List<String> {
+        val saved = load()[normalize(input)] ?: return originalTexts
+        if (saved.isEmpty()) return originalTexts
+        val originalSet = originalTexts.toHashSet()
+        val seen = HashSet<String>()
+        val result = ArrayList<String>(originalTexts.size)
+        for (t in saved) {
+            if (t in originalSet && seen.add(t)) result.add(t)
+        }
+        for (t in originalTexts) {
+            if (seen.add(t)) result.add(t)
+        }
+        return result
+    }
+
+    /** 前移/后移/置顶当前输入下的某个候选词，返回顺序是否发生变化。 */
+    fun move(
+        text: String,
+        move: Move,
+    ): Boolean {
+        if (currentInput.isEmpty()) return false
+        val list = displayOrder(currentInput, currentOriginal).toMutableList()
+        val idx = list.indexOf(text)
+        if (idx < 0) return false
+        val pageStart = currentPage * currentPageSize
+        val target =
+            when (move) {
+                Move.UP -> idx - 1
+                Move.DOWN -> idx + 1
+                Move.TOP -> 0
+                Move.BOTTOM -> list.size - 1
+                Move.PREV_PAGE -> pageStart - currentPageSize
+                Move.NEXT_PAGE -> pageStart + currentPageSize
+                Move.PAGE_TOP -> pageStart
+                Move.PAGE_BOTTOM -> pageStart + currentPageSize - 1
+            }
+        val dst = target.coerceIn(0, list.size - 1)
+        if (dst == idx) return false
+        list.removeAt(idx)
+        list.add(dst, text)
+        load()[currentInput] = list
+        save()
+        return true
+    }
+
+    /**
+     * 让当前输入下的**某一个**候选词「归位」：把它放回 Rime 原始候选里的位置，
+     * 其余候选保持各自的调整不变。返回顺序是否发生变化。
+     */
+    fun resetOne(text: String): Boolean {
+        if (currentInput.isEmpty()) return false
+        val entry = load()[currentInput] ?: return false
+        if (entry.isEmpty()) return false
+        val current = displayOrder(currentInput, currentOriginal).toMutableList()
+        val idx = current.indexOf(text)
+        if (idx < 0) return false
+        val originalIdx = currentOriginal.indexOf(text)
+        if (originalIdx < 0) return false
+        if (idx == originalIdx) return false
+        current.removeAt(idx)
+        current.add(originalIdx.coerceIn(0, current.size), text)
+        if (current == currentOriginal) {
+            load().remove(currentInput)
+        } else {
+            load()[currentInput] = current
+        }
+        save()
+        return true
+    }
+
+    fun hasCustom(input: String): Boolean = load().containsKey(normalize(input))
+
+    /**
+     * 全部自定义排序记录：`输入码 → 该编码下的顺序表`。
+     *
+     * 排序表里可能混有「自定义短语」的哨兵项（[PHRASE]），这里过滤掉，
+     * 只返回真正被用户调整过的词；空表（只剩哨兵）不返回。
+     */
+    fun entries(): List<Pair<String, List<String>>> = load()
+        .map { (key, list) -> key to list.filter { it != PHRASE } }
+        .filter { it.second.isNotEmpty() }
+        .sortedBy { it.first }
+
+    /**
+     * 从某个输入码的顺序表里删掉指定词（词库体检清理「失效项」用）。
+     *
+     * 与 [remove] 不同：只去掉这些词，其余排序保留；表里若只剩哨兵项就把整个码删掉。
+     */
+    fun removeWords(
+        input: String,
+        words: Collection<String>,
+    ): Boolean {
+        val key = normalize(input)
+        val map = load()
+        val list = map[key] ?: return false
+        val before = list.size
+        list.removeAll(words.toSet())
+        if (list.size == before) return false
+        if (list.none { it != PHRASE }) map.remove(key) else map[key] = list
+        save()
+        return true
+    }
+
+    /** 删除某个输入码的全部排序记录；返回是否真的有记录被删。 */
+    fun remove(input: String): Boolean {
+        val map = load()
+        if (map.remove(normalize(input)) == null) return false
+        save()
+        return true
+    }
+
+    /** 清空全部排序记录（不改动自定义短语本身）。 */
+    fun clearAll(): Boolean {
+        val map = load()
+        if (map.isEmpty()) return false
+        map.clear()
+        save()
+        return true
+    }
+}
