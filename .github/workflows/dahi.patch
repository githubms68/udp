+    private fun renderVoice() {
+        val ctx = requireContext()
+        val career = DahiVoiceStats.statOf(DahiInputStats.Period.CAREER)
+        if (career.count == 0L) {
+            voiceTodayView?.text = getString(R.string.dahi_stats_voice_empty)
+            voiceTotalView?.text = ""
+            return
+        }
+        // 与打字统计同步：顶部选「本周」，这里第一行就是本周的语音账；
+        // 选「生涯」时第二行本来就是累计，第一行再写一遍就重复了，直接不显示。
+        val current = DahiVoiceStats.statOf(period)
+        val last = DahiVoiceStats.snapshot()
+        voiceTodayView?.text =
+            when {
+                // 选「生涯」时第二行本来就是累计，第一行再写一遍会重复
+                period == DahiInputStats.Period.CAREER -> ""
+                // 本周期一次语音都没有：写「0 次 · 共 0:00 · 0 字」很吓人，也不像人话
+                current.count == 0L -> ctx.getString(R.string.dahi_stats_voice_period_empty, periodName())
+                else ->
+                    ctx.getString(
+                        R.string.dahi_stats_voice_period,
+                        periodName(),
+                        current.count,
+                        clock(current.ms),
+                        current.chars,
+                    )
+            }
+        val avg =
+            if (current.count > 0L) {
+                ctx.getString(
+                    R.string.dahi_stats_voice_avg,
+                    clock(current.avgMs),
+                    current.charsPerSession.toInt().toString(),
+                )
+            } else {
+                ""
+            }
+        val edit = if (DahiVoiceStats.isEditRateVisible()) current.editRate else null
+        val editText =
+            when {
+                !DahiVoiceStats.isEditRateVisible() -> ""
+                current.count == 0L -> ""
+                edit == null -> ctx.getString(R.string.dahi_stats_voice_edit_none)
+                else -> ctx.getString(R.string.dahi_stats_voice_edit, formatPct(edit))
+            }
+        val parts = listOf(avg, editText).filter { it.isNotEmpty() }.joinToString("   ")
+        val lastTime = lastTimeText(last.lastAt)
+        val lastLine =
+            if (lastTime.isEmpty()) {
+                ctx.getString(R.string.dahi_stats_voice_last, clock(last.lastMs), last.lastChars)
+            } else {
+                ctx.getString(R.string.dahi_stats_voice_last_at, lastTime, clock(last.lastMs), last.lastChars)
+            }
+        voiceTotalView?.text =
+            ctx.getString(R.string.dahi_stats_voice_total, career.count, clock(career.ms), career.chars) + "\n" +
+            (if (parts.isEmpty()) "" else parts + "\n") +
+            lastLine
+    }
