+                DahiStatsImage.render(
+                    ctx,
+                    period,
+                    detailed,
+                    heat,
+                    schemas,
+                    advice,
+                    voice,
+                    hours,
+                    cloud,
+                    template,
+                    daily,
+                    speed,
