@@ -0,0 +1,48 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.drawable.GradientDrawable
+
+/**
+ * 颜色色块的统一画法：**填充 + 跟随主题的描边**。
+ *
+ * 之前两处色块都硬编码了 `0x44FFFFFF` 描边：浅色主题下白描边叠在白底上，
+ * 而「未固定颜色」时填充本身又是透明的 —— 色块整体「消失」，用户找不到取色入口；
+ * 深色主题下也只是勉强能看出个轮廓。
+ *
+ * 这里改成取主题的 `textColorSecondary`（浅色主题=深灰、深色主题=浅灰），
+ * 两种背景下都有清晰边界；取不到时回退中性灰。
+ */
+object DahiColorSwatch {
+    /** 兜底描边色：中性灰，浅底深底都能看出边界。 */
+    private const val FALLBACK = 0x80808080.toInt()
+
+    fun draw(
+        ctx: Context,
+        fill: Int,
+        cornerDp: Float = 6f,
+    ): GradientDrawable = GradientDrawable().apply {
+        shape = GradientDrawable.RECTANGLE
+        setColor(fill)
+        val density = ctx.resources.displayMetrics.density
+        cornerRadius = cornerDp * density
+        setStroke(density.toInt().coerceAtLeast(1), strokeColor(ctx))
+    }
+
+    /** 描边色：优先跟随主题的次要文字色，拿不到时用中性灰（浅底深底都看得见）。 */
+    fun strokeColor(ctx: Context): Int {
+        val a = ctx.obtainStyledAttributes(intArrayOf(android.R.attr.textColorSecondary))
+        // getColorForState 而不是 defaultColor：后者是 API 24 才有的，这里要兼容更低的 minSdk
+        val color =
+            runCatching {
+                a.getColorStateList(0)?.getColorForState(intArrayOf(android.R.attr.state_enabled), FALLBACK)
+            }.getOrNull()
+        a.recycle()
+        return color ?: FALLBACK
+    }
+}
