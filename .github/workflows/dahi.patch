+
+package com.osfans.trime.ime.custom
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.data.db.ClipboardHelper
+import com.osfans.trime.data.db.CollectionHelper
+import com.osfans.trime.util.appContext
+import org.json.JSONArray
+
+/**
+ * 剪贴板 / 收藏夹「分类」的展示顺序与改名迁移。
+ *
+ * 分类名本身存在数据库的 `category` 列里；这里只额外保存**用户排定的顺序**
+ * （键 `dahi_category_order`，JSON 数组）。数据库里没有的分类会被忽略，
+ * 新出现（未记录过顺序）的分类自动追加到末尾，因此不会因为改名 / 删除而错乱。
+ */
+object DahiCategoryStore {
+    /** 偏好键（顺序表）。 */
+    const val PREF_KEY = "dahi_category_order"
+
+    /** 伪分类：全部（不筛选）。 */
+    const val KEY_ALL = "\u0000all"
+
+    /** 伪分类：未分类（分类为空）。 */
+    const val KEY_UNCATEGORIZED = "\u0000uncategorized"
+
+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    /** 已保存的顺序表。 */
+    fun savedOrder(): List<String> = runCatching {
+        val raw = prefs.getString(PREF_KEY, null) ?: return@runCatching emptyList()
+        val arr = JSONArray(raw)
+        (0 until arr.length()).mapNotNull { arr.optString(it).takeIf { s -> s.isNotEmpty() } }
+    }.getOrDefault(emptyList())
+
+    fun saveOrder(order: List<String>) {
+        prefs.edit { putString(PREF_KEY, JSONArray(order).toString()) }
+    }
+
+    /** 两个库合并去重后的原始分类名。 */
+    suspend fun allCategories(): List<String> {
+        val clip = runCatching { ClipboardHelper.categories() }.getOrDefault(emptyList())
+        val coll = runCatching { CollectionHelper.categories() }.getOrDefault(emptyList())
+        return (clip + coll).distinct()
+    }
+
+    /** 按用户设定顺序排好；未记录过的按名称排在后面。 */
+    fun ordered(names: List<String>): List<String> {
+        val index = savedOrder().withIndex().associate { it.value to it.index }
+        return names.sortedWith(compareBy({ index[it] ?: Int.MAX_VALUE }, { it }))
+    }
+
+    /**
+     * 两库合并 + 排序后，供筛选条 / 分类管理页使用。
+     *
+     * 这里把「顺序表里已登记、但暂时还没有条目」的分类也算进来：
+     * 用户先建好分类再往里放东西时，筛选条和分类管理页都能立刻看到它。
+     */
+    suspend fun loadOrdered(): List<String> = ordered(displayKeys())
+
+    /** 「全部 / 未分类 + 各真实分类」，用于筛选条与分类管理页（顺序表已包含它们）。 */
+    suspend fun displayKeys(): List<String> {
+        val names = (allCategories() + savedOrder()).distinct()
+        return (listOf(KEY_ALL, KEY_UNCATEGORIZED) + names).distinct()
+    }
+
+    /** 是否伪分类（全部 / 未分类）：只能调整顺序，不能改名或删除。 */
+    fun isPseudo(key: String): Boolean = key == KEY_ALL || key == KEY_UNCATEGORIZED
+
+    /** 新建一个空分类（只在顺序表里占位，条目可以稍后再归入）。 */
+    fun add(name: String) {
+        val trimmed = name.trim()
+        if (trimmed.isEmpty()) return
+        val order = savedOrder()
+        if (trimmed !in order) saveOrder(order + trimmed)
+    }
+
+    /** 把 [name] 在 [ordered] 中上移 / 下移 [delta] 位，返回新的顺序表。 */
+    fun moved(
+        ordered: List<String>,
+        name: String,
+        delta: Int,
+    ): List<String> {
+        val from = ordered.indexOf(name)
+        if (from < 0 || ordered.size < 2) return ordered
+        val to = (from + delta).coerceIn(0, ordered.size - 1)
+        if (to == from) return ordered
+        val list = ordered.toMutableList()
+        list.removeAt(from)
+        list.add(to, name)
+        return list
+    }
+
+    /** 改名（两个库一起改），并同步顺序表里的旧名字。 */
+    suspend fun rename(
+        oldName: String,
+        newName: String,
+    ) {
+        if (oldName == newName || isPseudo(oldName)) return
+        runCatching { ClipboardHelper.renameCategory(oldName, newName) }
+        runCatching { CollectionHelper.renameCategory(oldName, newName) }
+        val order = savedOrder()
+        if (oldName in order) saveOrder(order.map { if (it == oldName) newName else it })
+    }
+
+    /** 删除分类（条目保留，回到「未分类」），并把它从顺序表里去掉。 */
+    suspend fun delete(name: String) {
+        if (isPseudo(name)) return
+        runCatching { ClipboardHelper.clearCategory(name) }
+        runCatching { CollectionHelper.clearCategory(name) }
+        val order = savedOrder()
+        if (name in order) saveOrder(order.filter { it != name })
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiColorPickerDialog.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiColorPickerDialog.kt
