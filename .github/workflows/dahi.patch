index 0000000..600e9af
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiColorPickerDialog.kt
@@ -0,0 +1,414 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.drawable.BitmapDrawable
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.LayerDrawable
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewGroup
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.SeekBar
+import android.widget.TextView
+import androidx.appcompat.app.AlertDialog
+import com.osfans.trime.R
+
+/**
+ * 取色器（大海版）。
+ *
+ * 上半部分为**可视化选色区**：横向「色相条」选色相（彩虹条，拖动 / 点按），
+ * 下面「饱和度 / 明度」面板点哪选哪（横向白→纯色为饱和度，纵向上亮下暗为明度），
+ * 普通用户**一次点按即可选中想要的颜色**；
+ * 下方保留 **A / R / G / B 四通道滑块**，方便懂行的用户按数值精准配色。
+ * 两部分双向联动，实时色块（带棋盘格，可见透明度）+ 十六进制值同步显示。
+ *
+ * 用于「键盘主题样式」的颜色编辑；「恢复主题色」会清除该项覆盖。
+ */
+class DahiColorPickerDialog(
+    private val context: Context,
+    initial: Int,
+    private val onPicked: (Int) -> Unit,
+    private val onCleared: () -> Unit,
+) {
+    private var alphaChannel = Color.alpha(initial)
+    private var red = Color.red(initial)
+    private var green = Color.green(initial)
+    private var blue = Color.blue(initial)
+
+    private var hue = 0f
+    private var sat = 1f
+    private var value = 1f
+
+    private val density = context.resources.displayMetrics.density
+
+    private val swatch = View(context)
+    private val hexText = TextView(context).apply { textSize = 13f }
+
+    private lateinit var hueBar: HueBarView
+    private lateinit var svPanel: SvPanelView
+    private lateinit var alphaBar: SeekBar
+    private lateinit var redBar: SeekBar
+    private lateinit var greenBar: SeekBar
+    private lateinit var blueBar: SeekBar
+
+    private val checkerBitmap: Bitmap by lazy { makeCheckerBitmap() }
+
+    init {
+        val hsv = FloatArray(3)
+        Color.colorToHSV(initial, hsv)
+        hue = hsv[0]
+        sat = hsv[1]
+        value = hsv[2]
+    }
+
+    private fun argb(): Int = Color.argb(alphaChannel, red, green, blue)
+
+    fun show() {
+        val pad = (16 * density).toInt()
+        val root =
+            LinearLayout(context).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(pad, pad, pad, pad)
+                addView(
+                    swatch,
+                    LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        (48 * density).toInt(),
+                    ),
+                )
+                addView(hexText)
+                // —— 可视化选色区：色相条 + 饱和度 / 明度面板 ——
+                hueBar =
+                    HueBarView(context).apply {
+                        layoutParams =
+                            LinearLayout.LayoutParams(
+                                ViewGroup.LayoutParams.MATCH_PARENT,
+                                (26 * density).toInt(),
+                            )
+                        onHueChanged = { h ->
+                            // 注意：必须限定 this@DahiColorPickerDialog。
+                            // 本 lambda 声明在 HueBarView.apply{} 内，裸写 hue = h
+                            // 会赋给**视图自身**的 hue 属性，Dialog 字段不更新，
+                            // 随后 syncFromHsv() 读旧值 → 点按色相条完全没反应。
+                            this@DahiColorPickerDialog.hue = h
+                            svPanel.hue = h
+                            syncFromHsv()
+                        }
+                    }
+                addView(hueBar)
+                svPanel =
+                    SvPanelView(context).apply {
+                        layoutParams =
+                            LinearLayout.LayoutParams(
+                                ViewGroup.LayoutParams.MATCH_PARENT,
+                                (132 * density).toInt(),
+                            )
+                        hue = this@DahiColorPickerDialog.hue
+                        sat = this@DahiColorPickerDialog.sat
+                        value = this@DahiColorPickerDialog.value
+                        onSvChanged = { s, v ->
+                            // 同上：限定 Dialog，否则只改到 SvPanelView 自身属性。
+                            this@DahiColorPickerDialog.sat = s
+                            this@DahiColorPickerDialog.value = v
+                            syncFromHsv()
+                        }
+                    }
+                addView(svPanel)
+                // —— 精准通道滑块（A / R / G / B），懂行用户可精确配色 ——
+                addChannel(context.getString(R.string.dahi_style_channel_a), { alphaChannel }, { alphaChannel = it }) { alphaBar = it }
+                addChannel(context.getString(R.string.dahi_style_channel_r), { red }, { red = it }) { redBar = it }
+                addChannel(context.getString(R.string.dahi_style_channel_g), { green }, { green = it }) { greenBar = it }
+                addChannel(context.getString(R.string.dahi_style_channel_b), { blue }, { blue = it }) { blueBar = it }
+            }
+        syncBars()
+        updateSwatch()
+        AlertDialog
+            .Builder(context)
+            .setTitle(R.string.dahi_style_picker_title)
+            .setView(ScrollView(context).apply { addView(root) })
+            .setNeutralButton(R.string.dahi_style_picker_reset) { _, _ -> onCleared() }
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ -> onPicked(argb()) }
+            .show()
+    }
+
+    /** 添加一个 A/R/G/B 通道滑块：[label] 为名称，[get] 读当前值，[set] 写新值。 */
+    private fun LinearLayout.addChannel(
+        label: String,
+        get: () -> Int,
+        set: (Int) -> Unit,
+        onCreated: (SeekBar) -> Unit,
+    ) {
+        val labelView = TextView(context).apply { text = "$label ${get()}" }
+        val bar =
+            SeekBar(context).apply {
+                max = 255
+                progress = get()
+                setOnSeekBarChangeListener(
+                    object : SeekBar.OnSeekBarChangeListener {
+                        override fun onProgressChanged(
+                            seekBar: SeekBar?,
+                            value: Int,
+                            fromUser: Boolean,
+                        ) {
+                            if (!fromUser) return
+                            set(value)
+                            labelView.text = "$label $value"
+                            syncFromRgb()
+                        }
+
+                        override fun onStartTrackingTouch(seekBar: SeekBar?) = Unit
+
+                        override fun onStopTrackingTouch(seekBar: SeekBar?) = Unit
+                    },
+                )
+            }
+        addView(labelView)
+        addView(bar)
+        onCreated(bar)
+    }
+
+    /** 面板改动后：HSV → RGB，刷新滑块与色块。 */
+    private fun syncFromHsv() {
+        val c = Color.HSVToColor(alphaChannel, floatArrayOf(hue, sat, value))
+        red = Color.red(c)
+        green = Color.green(c)
+        blue = Color.blue(c)
+        syncBars()
+        updateSwatch()
+    }
+
+    /** 滑块改动后：RGB → HSV，刷新面板与色块。 */
+    private fun syncFromRgb() {
+        val hsv = FloatArray(3)
+        Color.colorToHSV(argb(), hsv)
+        hue = hsv[0]
+        sat = hsv[1]
+        value = hsv[2]
+        hueBar.hue = hue
+        svPanel.hue = hue
+        svPanel.sat = sat
+        svPanel.value = value
+        updateSwatch()
+    }
+
+    private fun syncBars() {
+        if (!::alphaBar.isInitialized) return
+        alphaBar.progress = alphaChannel
+        redBar.progress = red
+        greenBar.progress = green
+        blueBar.progress = blue
+    }
+
+    private fun updateSwatch() {
+        // 棋盘格底层（体现透明度）+ 实际颜色上层
+        val checker =
+            BitmapDrawable(context.resources, checkerBitmap).apply {
+                setTileModeXY(Shader.TileMode.REPEAT, Shader.TileMode.REPEAT)
+                setGravity(Gravity.FILL)
+            }
+        val colorLayer =
+            GradientDrawable().apply {
+                setColor(argb())
+                cornerRadius = 6 * density
+            }
+        swatch.background = LayerDrawable(arrayOf(checker, colorLayer))
+        hexText.text = String.format("#%08X", argb())
+    }
+
+    private fun makeCheckerBitmap(): Bitmap {
+        val bmp = Bitmap.createBitmap(2, 2, Bitmap.Config.ARGB_8888)
+        bmp.setPixel(0, 0, 0xFFE0E0E0.toInt())
+        bmp.setPixel(1, 0, 0xFFB0B0B0.toInt())
+        bmp.setPixel(0, 1, 0xFFB0B0B0.toInt())
+        bmp.setPixel(1, 1, 0xFFE0E0E0.toInt())
+        return bmp
+    }
+
+    /** 色相条：横向彩虹，点按 / 拖动选色相（0–360）。 */
+    private class HueBarView(
+        context: Context,
+    ) : View(context) {
+        var onHueChanged: ((Float) -> Unit)? = null
+
+        var hue: Float = 0f
+            set(v) {
+                field = v.coerceIn(0f, 360f)
+                invalidate()
+            }
+
+        private val density = resources.displayMetrics.density
+        private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val linePaint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.STROKE
+                strokeCap = Paint.Cap.ROUND
+            }
+        private val rect = RectF()
+        private val radius = 8 * density
+
+        init {
+            isClickable = true
+            isFocusable = false
+        }
+
+        override fun onSizeChanged(
+            w: Int,
+            h: Int,
+            oldw: Int,
+            oldh: Int,
+        ) {
+            super.onSizeChanged(w, h, oldw, oldh)
+            rect.set(density, density, w - density, h - density)
+            val colors = IntArray(361) { Color.HSVToColor(floatArrayOf(it.toFloat(), 1f, 1f)) }
+            fillPaint.shader =
+                LinearGradient(rect.left, 0f, rect.right, 0f, colors, null, Shader.TileMode.CLAMP)
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            canvas.drawRoundRect(rect, radius, radius, fillPaint)
+            val x = rect.left + rect.width() * (hue / 360f)
+            // 指示线：黑色打底 + 白色主线，任意色相上都清晰
+            linePaint.strokeWidth = 4 * density
+            linePaint.color = Color.BLACK
+            canvas.drawLine(x, rect.top + 2 * density, x, rect.bottom - 2 * density, linePaint)
+            linePaint.strokeWidth = 2 * density
+            linePaint.color = Color.WHITE
+            canvas.drawLine(x, rect.top + 2 * density, x, rect.bottom - 2 * density, linePaint)
+        }
+
+        override fun onTouchEvent(event: MotionEvent): Boolean {
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE -> {
+                    parent?.requestDisallowInterceptTouchEvent(true)
+                    val h = ((event.x - rect.left) / rect.width().coerceAtLeast(1f)) * 360f
+                    hue = h
+                    onHueChanged?.invoke(h)
+                    return true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL ->
+                    parent?.requestDisallowInterceptTouchEvent(false)
+            }
+            return super.onTouchEvent(event)
+        }
+    }
+
+    /** 饱和度 / 明度面板：横向 = 饱和度（白→纯色），纵向 = 明度（上亮下暗），点按 / 拖动选色。 */
+    private class SvPanelView(
+        context: Context,
+    ) : View(context) {
+        var onSvChanged: ((Float, Float) -> Unit)? = null
+
+        var hue: Float = 0f
+            set(v) {
+                field = v
+                updateSatShader()
+                invalidate()
+            }
+
+        var sat: Float = 0.6f
+            set(v) {
+                field = v.coerceIn(0f, 1f)
+                invalidate()
+            }
+
+        var value: Float = 1f
+            set(v) {
+                field = v.coerceIn(0f, 1f)
+                invalidate()
+            }
+
+        private val density = resources.displayMetrics.density
+        private val satPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val valuePaint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val borderPaint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                style = Paint.Style.STROKE
+                strokeWidth = density
+                color = Color.argb(0x60, 0x80, 0x80, 0x80)
+            }
+        private val thumbPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val radius = 8 * density
+
+        init {
+            isClickable = true
+            isFocusable = false
+        }
+
+        private fun updateSatShader() {
+            val hueColor = Color.HSVToColor(floatArrayOf(hue, 1f, 1f))
+            satPaint.shader =
+                LinearGradient(
+                    0f,
+                    0f,
+                    width.toFloat(),
+                    0f,
+                    Color.WHITE,
+                    hueColor,
+                    Shader.TileMode.CLAMP,
+                )
+        }
+
+        override fun onSizeChanged(
+            w: Int,
+            h: Int,
+            oldw: Int,
+            oldh: Int,
+        ) {
+            super.onSizeChanged(w, h, oldw, oldh)
+            updateSatShader()
+            valuePaint.shader =
+                LinearGradient(0f, 0f, 0f, h.toFloat(), Color.TRANSPARENT, Color.BLACK, Shader.TileMode.CLAMP)
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            val w = width.toFloat()
+            val h = height.toFloat()
+            canvas.drawRoundRect(0f, 0f, w, h, radius, radius, satPaint)
+            canvas.drawRoundRect(0f, 0f, w, h, radius, radius, valuePaint)
+            canvas.drawRoundRect(0f, 0f, w, h, radius, radius, borderPaint)
+            // 准星：白环 + 黑点，任意底色上都可见
+            val cx = w * sat
+            val cy = h * (1f - value)
+            thumbPaint.style = Paint.Style.STROKE
+            thumbPaint.strokeWidth = 3 * density
+            thumbPaint.color = Color.WHITE
+            canvas.drawCircle(cx, cy, 7 * density, thumbPaint)
+            thumbPaint.style = Paint.Style.FILL
+            thumbPaint.color = Color.BLACK
+            canvas.drawCircle(cx, cy, 2.5f * density, thumbPaint)
+        }
+
+        override fun onTouchEvent(event: MotionEvent): Boolean {
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE -> {
+                    parent?.requestDisallowInterceptTouchEvent(true)
+                    val s = (event.x / width.toFloat().coerceAtLeast(1f)).coerceIn(0f, 1f)
+                    val v = (1f - event.y / height.toFloat().coerceAtLeast(1f)).coerceIn(0f, 1f)
+                    sat = s
+                    value = v
+                    onSvChanged?.invoke(s, v)
+                    return true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL ->
+                    parent?.requestDisallowInterceptTouchEvent(false)
+            }
+            return super.onTouchEvent(event)
+        }
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiContrast.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiContrast.kt
new file mode 100644
index 0000000..ed8b16a
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiContrast.kt
@@ -0,0 +1,111 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.graphics.Color
+import com.osfans.trime.data.theme.ColorManager
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.pow
+
+/**
+ * 颜色对比度工具：保证「画在某个底色上的前景色」在任何主题下都读得清。
+ *
+ * 为什么需要它：指尖生花的取色是三色体系（主色 / 辅色 / 高光），高光色天生接近白 ——
+ * 深色键盘上好看，换成**白色键盘 + 亮色模式**就几乎看不见（速度环右侧的数字是最明显的受害者）。
+ * 直接在配色里改深又会让深色主题变糊，两边互相打脸。
+ *
+ * 所以取色不动，**画的时候按实际底色校正**：对比度够就原样返回（暗色主题一点不变），
+ * 不够就往黑/白方向压，直到达到 WCAG 的最低对比度。
+ */
+object DahiContrast {
+    private const val WHITE = 0xFFFFFFFF.toInt()
+    private const val BLACK = 0xFF000000.toInt()
+
+    /** 相对亮度（WCAG 2.x，0 = 纯黑，1 = 纯白）。 */
+    fun luminance(color: Int): Float {
+        fun channel(c: Int): Float {
+            val s = c / 255f
+            return if (s <= 0.03928f) s / 12.92f else ((s + 0.055f) / 1.055f).pow(2.4f)
+        }
+        return 0.2126f * channel(Color.red(color)) +
+            0.7152f * channel(Color.green(color)) +
+            0.0722f * channel(Color.blue(color))
+    }
+
+    /** 对比度（1 = 完全一样，21 = 纯黑对纯白）。 */
+    fun ratio(
+        a: Int,
+        b: Int,
+    ): Float {
+        val la = luminance(a)
+        val lb = luminance(b)
+        return (max(la, lb) + 0.05f) / (min(la, lb) + 0.05f)
+    }
+
+    /** [over] 以 [alpha]（0~1）叠在 [under] 上的结果色（不含透明度）。 */
+    fun blend(
+        over: Int,
+        under: Int,
+        alpha: Float,
+    ): Int {
+        val a = alpha.coerceIn(0f, 1f)
+        fun mix(x: Int, y: Int): Int = (x * a + y * (1f - a)).toInt().coerceIn(0, 255)
+        return Color.rgb(
+            mix(Color.red(over), Color.red(under)),
+            mix(Color.green(over), Color.green(under)),
+            mix(Color.blue(over), Color.blue(under)),
+        )
+    }
+
+    /**
+     * 让 [fg] 在 [bg] 上达到 [minRatio] 的对比度。
+     *
+     * 对比度已达标就**原样返回**（暗色主题/深色键盘完全不受影响）；
+     * 不达标则保持色相、逐步朝黑或白（取与背景亮度相反的方向）压，压到 100% 仍不够就退回纯黑/纯白。
+     */
+    fun readableOn(
+        fg: Int,
+        bg: Int,
+        minRatio: Float = 4.5f,
+    ): Int {
+        if (ratio(fg, bg) >= minRatio) return fg
+        val towardWhite = luminance(bg) < 0.5f
+        val target = if (towardWhite) WHITE else BLACK
+        for (step in 1..20) {
+            val candidate = blend(target, fg, step / 20f)
+            if (ratio(candidate, bg) >= minRatio) return candidate
+        }
+        return target
+    }
+
+    /** 与 [color] 明暗相反的颜色，用来画描边（浅字配深边、深字配浅边）。 */
+    fun opposite(color: Int): Int = if (luminance(color) > 0.5f) BLACK else WHITE
+
+    /**
+     * 键盘背景的近似底色。
+     *
+     * 背景图主题取不到真实颜色，这里退到主题色 —— 只用它来决定「往黑还是往白压」，
+     * 真实可读性靠描边兜底（见 DahiKeyEffectOverlay.drawReadableText）。
+     */
+    fun keyboardBackdrop(): Int = runCatching { ColorManager.getColor("keyboard_back_color") }
+        .recoverCatching { ColorManager.getColor("back_color") }
+        .getOrDefault(0xFF202020.toInt())
+
+    /**
+     * 预编辑框底板的实际颜色：`text_back_color` 可能半透明，要先叠在键盘底色上。
+     *
+     * 速度环的数字画在这块底板上，所以判断对比度必须用这个「合成后」的颜色，
+     * 而不是直接用 text_back_color —— 否则半透明浅底会算错方向。
+     */
+    fun preeditBackdrop(): Int {
+        val board = runCatching { ColorManager.getColor("text_back_color") }.getOrNull()
+        val under = keyboardBackdrop()
+        if (board == null) return under
+        return blend(board, under, Color.alpha(board) / 255f)
+    }
+}
