+
+package com.osfans.trime.ime.custom
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.R
+import com.osfans.trime.data.theme.model.ToolBar
+import com.osfans.trime.util.appContext
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * 工具栏按钮的**本地自定义**（大海版）。
+ *
+ * 背景：同文的工具按钮是主题 YAML 里定义的（`tool_bar/buttons`），
+ * 想藏掉一个、换个顺序，就得改 YAML —— 而改 YAML 的门槛对普通用户太高，
+ * 且主题一升级就被覆盖。
+ *
+ * 这里在**应用层**做三件事，完全不碰用户的主题文件：
+ *
+ * 1. **隐藏**：某个按钮不想要了，勾掉即可；
+ * 2. **排序**：顺序记在偏好里（`dahi_toolbar_layout`），左→右即用户在键盘上看到的顺序；
+ * 3. **内置按钮池**：主题里没定义的常用按钮（设置菜单 / 剪贴板 / 输入统计 / 悬浮键盘）
+ *    也能加进来 —— 这一条是关键，否则「只能删不能加」体验很残缺。
+ *
+ * 一键恢复默认 = 清空偏好，回到主题原样。
+ */
+object DahiToolbarConfig {
+    /** 偏好键（供备份 / 还原按名引用）。 */
+    const val PREF_KEY = "dahi_toolbar_layout"
+
+    private const val KEY_ORDER = "order"
+    private const val KEY_HIDDEN = "hidden"
+    private const val KEY_EXTRAS = "extras"
+
+    /**
+     * 内置按钮池：不依赖主题，随大海版一起提供。
+     *
+     * 原则是「**给足选择**」——这些动作在本应用里都有入口，用户想放几个、放哪些，自己决定。
+     * [id] 会写进偏好，**改名会导致用户配置失效**，只能加不能改。
+     */
+    enum class Extra(
+        val id: String,
+        val labelRes: Int,
+        val iconRes: Int,
+    ) {
+        /** 左上角的设置菜单（与「更多」按钮同一个窗口）。 */
+        MENU("menu", R.string.dahi_toolbar_extra_menu, R.drawable.ic_baseline_more_horiz_24),
+
+        /** 剪贴板。 */
+        CLIPBOARD("clipboard", R.string.dahi_toolbar_extra_clipboard, R.drawable.ic_dahi_clipboard_24),
+
+        /** 收起键盘（默认放在最右侧）。 */
+        HIDE("hide", R.string.dahi_toolbar_extra_hide, R.drawable.ic_baseline_arrow_drop_down_24),
+
+        /** 输入统计。 */
+        STATS("stats", R.string.dahi_toolbar_extra_stats, R.drawable.ic_dahi_stats),
+
+        /** 短语与排序。 */
+        MANAGE("manage", R.string.dahi_toolbar_extra_manage, R.drawable.ic_baseline_tune_24),
+
+        /** 剪贴板分类。 */
+        CATEGORY("category", R.string.dahi_toolbar_extra_category, R.drawable.ic_baseline_snippet_folder_24),
+
+        /** 键盘背景。 */
+        KEYBG("keybg", R.string.dahi_toolbar_extra_keybg, R.drawable.ic_dahi_background_24),
+
+        /** 键盘主题（颜色 / 尺寸的样式编辑页）。 */
+        STYLE("style", R.string.dahi_toolbar_extra_style, R.drawable.ic_dahi_style_24),
+
+        /** 工具栏按钮（本页）。 */
+        TOOLBAR("toolbar", R.string.dahi_toolbar_extra_toolbar, R.drawable.ic_baseline_view_comfy_24),
+
+        /** 输入方案。 */
+        SCHEMA("schema", R.string.dahi_toolbar_extra_schema, R.drawable.ic_round_view_list_24),
+
+        /** 虚拟键盘设置。 */
+        KEYBOARD("keyboard", R.string.dahi_toolbar_extra_keyboard, R.drawable.ic_baseline_keyboard_24),
+
+        /** 主题。 */
+        THEME("theme", R.string.dahi_toolbar_extra_theme, R.drawable.ic_baseline_color_lens_24),
+
+        /** 备份与还原。 */
+        BACKUP("backup", R.string.dahi_toolbar_extra_backup, R.drawable.ic_baseline_lock_24),
+
+        /** 用户词典。 */
+        USERDICT("userdict", R.string.dahi_toolbar_extra_userdict, R.drawable.ic_baseline_book_24),
+
+        /** 语音输入开关。 */
+        VOICE("voice", R.string.dahi_toolbar_extra_voice, R.drawable.ic_baseline_mic_24),
+
+        /** 悬浮键盘开关。 */
+        FLOATING("floating", R.string.dahi_toolbar_extra_floating, R.drawable.ic_dahi_resize_24),
+
+        /** 声情意象。 */
+        VOICEIMAGERY("voiceimagery", R.string.dahi_toolbar_extra_voiceimagery, R.drawable.ic_dahi_music_note_24),
+
+        /** 指尖生花（按键动效 / 音效 / 打字速度）。 */
+        KEYFX("keyfx", R.string.dahi_ke_title, R.drawable.ic_dahi_keyfx_24),
+
+        /** 测试输入（打开应用并弹出测试输入框）。 */
+        TESTINPUT("testinput", R.string.dahi_toolbar_extra_testinput, R.drawable.ic_input_box),
+
+        /** 搜索设置项。 */
+        SEARCH("search", R.string.dahi_toolbar_extra_search, R.drawable.ic_baseline_search_24),
+
+        /** 诊断信息（导出机型 / 主题 / 方案等排查信息）。 */
+        DIAGNOSTICS("diagnostics", R.string.dahi_toolbar_extra_diagnostics, R.drawable.ic_baseline_warning_24),
+
+        /** 剪贴板设置。 */
+        CLIPSET("clipset", R.string.dahi_toolbar_extra_clipset, R.drawable.ic_baseline_content_copy_24),
+
+        /** 直接打开剪贴板搜索（比「点剪贴板再点搜索」少一步）。 */
+        CLIPSEARCH("clipsesearch", R.string.dahi_toolbar_extra_clipsesearch, R.drawable.ic_dahi_clip_search_24),
+
+        /** 候选窗口设置。 */
+        CANDIDATES("candidates", R.string.dahi_toolbar_extra_candidates, R.drawable.ic_baseline_list_alt_24),
+
+        /** 高级设置。 */
+        ADVANCED("advanced", R.string.dahi_toolbar_extra_advanced, R.drawable.ic_baseline_checklist_24),
+
+        /** 一键部署（重新部署方案 / 词库）。 */
+        DEPLOY("deploy", R.string.dahi_toolbar_extra_deploy, R.drawable.ic_baseline_sync_24),
+
+        /** 切换手机输入法（调起系统输入法选择器）。 */
+        IME_SWITCH("ime_switch", R.string.dahi_toolbar_extra_ime_switch, R.drawable.ic_dahi_ime_switch_24),
+
+        /** 打开本应用。 */
+        APP("app", R.string.dahi_toolbar_extra_app, R.drawable.ic_baseline_settings_24),
+
+        /** 最近用过的词（把最近上屏的词当成一屏候选）。 */
+        RECENT("recent", R.string.dahi_toolbar_extra_recent, R.drawable.ic_dahi_recent),
+    }
+
+    /**
+     * 工具栏上的一个条目。
+     *
+     * [button] 非空 = 来自主题；[extra] 非空 = 来自内置池。
+     * [key] 是持久化用的稳定标识（主题按钮用 action 字符串，内置按钮用 `extra:<id>`）。
+     */
+    data class Item(
+        val key: String,
+        val action: String,
+        val button: ToolBar.Button?,
+        val extra: Extra?,
+    ) {
+        /** 给设置页显示的名字。 */
+        fun displayName(): String = extra?.let { appContext.getString(it.labelRes) }
+            ?: action.ifEmpty { appContext.getString(R.string.dahi_toolbar_unnamed) }
+    }
+
+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    // ------------------------------------------------------------------ 读写
+
+    private fun readJson(): JSONObject = runCatching {
+        JSONObject(prefs.getString(PREF_KEY, null) ?: "{}")
+    }.getOrDefault(JSONObject())
+
+    private fun readArray(key: String): List<String> {
+        val arr = readJson().optJSONArray(key) ?: return emptyList()
+        val list = ArrayList<String>(arr.length())
+        for (i in 0 until arr.length()) {
+            val v = arr.optString(i)
+            if (v.isNotEmpty()) list.add(v)
+        }
+        return list
+    }
+
+    private fun write(
+        order: List<String>,
+        hidden: List<String>,
+        extras: List<String>,
+    ) {
+        val json = JSONObject()
+        json.put(KEY_ORDER, JSONArray(order))
+        json.put(KEY_HIDDEN, JSONArray(hidden))
+        json.put(KEY_EXTRAS, JSONArray(extras))
+        prefs.edit { putString(PREF_KEY, json.toString()) }
+    }
+
+    fun order(): List<String> = readArray(KEY_ORDER)
+
+    fun hidden(): Set<String> = readArray(KEY_HIDDEN).toSet()
+
+    /**
+     * 默认启用的内置按钮：**一个都不开**。
+     *
+     * 之前这里默认开了「收起键盘」，结果主题自带 hide 按钮时工具栏最右会出现两个，
+     * 所以改为默认全关 —— 需要的人自己在设置里勾。
+     */
+    private val defaultExtras = emptySet<String>()
+
+    /**
+     * 已启用的内置按钮。
+     *
+     * 从未配置过时返回 [defaultExtras]；一旦用户保存过，就完全尊重保存值
+     * （此时「收起键盘」也可以被用户关掉）。
+     */
+    fun enabledExtras(): Set<String> {
+        if (!prefs.contains(PREF_KEY)) return defaultExtras
+        if (!readJson().has(KEY_EXTRAS)) return defaultExtras
+        return readArray(KEY_EXTRAS).toSet()
+    }
+
+    fun setOrder(value: List<String>) = write(value, hidden().toList(), enabledExtras().toList())
+
+    fun setHidden(value: Set<String>) = write(order(), value.toList(), enabledExtras().toList())
+
+    fun setExtras(value: Set<String>) = write(order(), hidden().toList(), value.toList())
+
+    /**
+     * 默认顺序（**从右到左**）：内置的「收起键盘」排第一（= 键盘最右边），
+     * 其余按主题原顺序跟在后面。这样装好就能像平时一样点最右边把键盘收起来。
+     */
+    fun defaultOrder(all: List<Item>): List<String> {
+        val list = ArrayList<String>(all.size)
+        defaultExtras.forEach { id -> list.add("extra:$id") }
+        all.forEach { item -> list.add(item.key) }
+        return list
+    }
+
+    /** 实际生效的顺序（从右到左）：用户保存过就用用户的，否则用默认。 */
+    fun effectiveOrder(all: List<Item>): List<String> {
+        val saved = order()
+        return if (saved.isEmpty()) defaultOrder(all) else saved
+    }
+
+    /** 是否做过任何自定义（用于判断要不要显示「已自定义」提示）。 */
+    fun isCustomized(): Boolean = prefs.contains(PREF_KEY) &&
+        (order().isNotEmpty() || hidden().isNotEmpty() || enabledExtras().isNotEmpty())
+
+    /**
+     * 一键恢复主题默认：清掉全部偏好。
+     */
+    fun reset() {
+        prefs.edit { remove(PREF_KEY) }
+    }
+
+    // ------------------------------------------------------------- 长按动作
+
+    /**
+     * 长按动作表：`按钮 key → 目标动作 id`。
+     *
+     * 存在独立的偏好键里（不混进 [PREF_KEY] 的 JSON），这样重置排序/显示不会顺手清掉长按设置。
+     * 目标动作复用内置按钮池的 id（如 `stats` / `clipboard`），点击时直接走同一个回调。
+     */
+    private const val PREF_LONGPRESS = "dahi_toolbar_longpress"
+
+    fun longPressMap(): Map<String, String> {
+        val raw = prefs.getString(PREF_LONGPRESS, null) ?: return emptyMap()
+        return runCatching {
+            val json = JSONObject(raw)
+            json.keys().asSequence().associateWith { json.optString(it) }
+        }.getOrDefault(emptyMap())
+    }
+
+    fun longPressOf(key: String): String? = longPressMap()[key]?.takeIf { it.isNotEmpty() }
+
+    fun setLongPress(
+        key: String,
+        target: String?,
+    ) {
+        val map = longPressMap().toMutableMap()
+        if (target.isNullOrEmpty()) map.remove(key) else map[key] = target
+        val json = JSONObject()
+        map.forEach { (k, v) -> json.put(k, v) }
+        prefs.edit { putString(PREF_LONGPRESS, json.toString()) }
+    }
+
+    fun clearLongPress() {
+        prefs.edit { remove(PREF_LONGPRESS) }
+    }
+
+    // ------------------------------------------------------------------ 组装
+
+    /** 主题里定义的全部按钮（保持 YAML 顺序）。 */
+    fun themeItems(raw: List<ToolBar.Button>): List<Item> = raw.mapIndexed { index, button ->
+        Item(
+            key = button.action.ifEmpty { "#$index" },
+            action = button.action,
+            button = button,
+            extra = null,
+        )
+    }
+
+    /** 内置池条目（无论是否启用都返回，设置页需要列出来给用户勾选）。 */
+    fun extraItems(): List<Item> = Extra.entries.map { extra ->
+        Item(key = "extra:${extra.id}", action = "", button = null, extra = extra)
+    }
+
+    /**
+     * 实际要显示的条目，**从右到左**（与同文 `tool_bar/buttons` 的原始语义一致）。
+     *
+     * 顺序规则：先按用户保存的顺序排，用户没提过的条目按主题原顺序追加；
+     * 最后统一剔除被隐藏的项。这样即使主题升级新增了按钮，也会自动出现在末尾，
+     * 不会因为「用户没排序过它」而消失。
+     *
+     * 设置页展示的列表与这里**同序**：列表第一项 = 键盘最右边。
+     */
+    fun visibleItems(raw: List<ToolBar.Button>): List<Item> {
+        val all = themeItems(raw) + extraItems()
+        val byKey = all.associateBy { it.key }
+        val hidden = hidden()
+        val enabled = enabledExtras()
+        val pool = all.filter { item ->
+            if (item.extra != null) item.extra.id in enabled else true
+        }
+        val seen = HashSet<String>(pool.size)
+        val result = ArrayList<Item>(pool.size)
+        effectiveOrder(all).forEach { key ->
+            val item = byKey[key] ?: return@forEach
+            if (item !in pool) return@forEach
+            if (item.key in hidden) return@forEach
+            if (seen.add(item.key)) result.add(item)
+        }
+        pool.forEach { item ->
+            if (item.key in hidden) return@forEach
+            if (seen.add(item.key)) result.add(item)
+        }
+        return result
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiTypingStyle.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiTypingStyle.kt
new file mode 100644
index 0000000..3f2e783
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiTypingStyle.kt
@@ -0,0 +1,135 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import com.osfans.trime.R
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+import kotlin.math.roundToInt
+
+/**
+ * 「我的打字风格」。
+ *
+ * 全部基于已有的每日历史（[DahiDailyHistory]）现算：**不新增采集、不落盘**，
+ * 所以这个页面的数字和输入报告、年度回顾永远是同一份数据。
+ *
+ * 判定只用四个维度，够用且不会互相打架：
+ * 1. 时段（深夜 / 清晨 / 白天）—— 最能一眼认出「这是谁」的一条；
+ * 2. 速度（字 / 分钟，按有效输入时长算，不含思考与切窗口）；
+ * 3. 份量（日均字数）；
+ * 4. 连续性（最长连续天数，≥30 天才给标签，否则人人都有就没意义）。
+ */
+object DahiTypingStyle {
+    /** 深夜定义与全局一致：23 点至次日 4 点。 */
+    private val NIGHT_HOURS = intArrayOf(23, 0, 1, 2, 3, 4)
+    private val DAWN_HOURS = intArrayOf(5, 6, 7)
+
+    private const val NIGHT_SHARE = 0.35
+    private const val DAWN_SHARE = 0.22
+    private const val FAST_SPEED = 60.0
+    private const val STEADY_SPEED = 25.0
+    private const val CHATTY_DAILY = 3000L
+    private const val DAILY_WRITER = 800L
+    private const val LONG_STREAK = 30
+
+    data class Style(
+        /** 主标签，卡片上最大那行字。 */
+        val title: String,
+        /** 一句话解释主标签是怎么来的。 */
+        val subtitle: String,
+        /** 3~4 个小标签。 */
+        val tags: List<String>,
+        val totalChars: Long,
+        val days: Int,
+        val dailyChars: Long,
+        val avgSpeed: Double,
+        val streak: Int,
+        val nightPct: Int,
+    )
+
+    /** 没有可用历史时返回 null —— 页面据此整块隐藏，不显示一堆 0。 */
+    fun compute(ctx: Context): Style? {
+        val days =
+            runCatching { DahiDailyHistory.all(ctx) }
+                .getOrDefault(emptyList())
+                .filter { it.chars > 0L }
+        if (days.isEmpty()) return null
+
+        val totalChars = days.sumOf { it.chars }
+        if (totalChars <= 0L) return null
+
+        val hours = IntArray(24)
+        days.forEach { d ->
+            d.hours.forEachIndexed { i, v -> if (i in hours.indices) hours[i] += v }
+        }
+        val hourSum = hours.sum().coerceAtLeast(1)
+        val night = NIGHT_HOURS.sumOf { hours[it] }
+        val dawn = DAWN_HOURS.sumOf { hours[it] }
+        val nightShare = night.toDouble() / hourSum
+        val dawnShare = dawn.toDouble() / hourSum
+
+        val activeMs = days.sumOf { it.activeMs }
+        val avgSpeed = if (activeMs > 0L) totalChars * 60_000.0 / activeMs else 0.0
+        val dailyChars = totalChars / days.size
+        val streak = longestStreak(days.mapNotNull { runCatching { LocalDate.parse(it.date) }.getOrNull() })
+
+        val timeTag =
+            when {
+                nightShare >= NIGHT_SHARE -> R.string.dahi_ts_owl
+                dawnShare >= DAWN_SHARE -> R.string.dahi_ts_early
+                else -> R.string.dahi_ts_day
+            }
+        val speedTag =
+            when {
+                avgSpeed >= FAST_SPEED -> R.string.dahi_ts_fast
+                avgSpeed >= STEADY_SPEED -> R.string.dahi_ts_steady
+                else -> R.string.dahi_ts_slow
+            }
+        val volumeTag =
+            when {
+                dailyChars >= CHATTY_DAILY -> R.string.dahi_ts_chatty
+                dailyChars >= DAILY_WRITER -> R.string.dahi_ts_daily
+                else -> R.string.dahi_ts_thrifty
+            }
+
+        val tags = mutableListOf(ctx.getString(timeTag), ctx.getString(speedTag), ctx.getString(volumeTag))
+        if (streak >= LONG_STREAK) tags.add(ctx.getString(R.string.dahi_ts_streak))
+
+        val nightPct = (nightShare * 100).roundToInt()
+        val subtitle =
+            when {
+                nightShare >= NIGHT_SHARE -> ctx.getString(R.string.dahi_ts_desc_night, nightPct)
+                dawnShare >= DAWN_SHARE -> ctx.getString(R.string.dahi_ts_desc_dawn, (dawnShare * 100).roundToInt())
+                else -> ctx.getString(R.string.dahi_ts_desc_day)
+            }
+
+        return Style(
+            title = ctx.getString(timeTag),
+            subtitle = subtitle,
+            tags = tags,
+            totalChars = totalChars,
+            days = days.size,
+            dailyChars = dailyChars,
+            avgSpeed = avgSpeed,
+            streak = streak,
+            nightPct = nightPct,
+        )
+    }
+
+    private fun longestStreak(dates: List<LocalDate>): Int {
+        if (dates.isEmpty()) return 0
+        val sorted = dates.distinct().sorted()
+        var best = 1
+        var cur = 1
+        for (i in 1 until sorted.size) {
+            cur = if (ChronoUnit.DAYS.between(sorted[i - 1], sorted[i]) == 1L) cur + 1 else 1
+            if (cur > best) best = cur
+        }
+        return best
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiUiTint.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiUiTint.kt
new file mode 100644
index 0000000..04e9c81
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiUiTint.kt
@@ -0,0 +1,131 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.app.Activity
+import android.content.res.Configuration
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.ColorFilter
+import android.graphics.PixelFormat
+import android.graphics.PorterDuff
+import android.graphics.drawable.ColorDrawable
+import android.graphics.drawable.Drawable
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.util.appContext
+
+/**
+ * 设置界面的「色调滤镜」（大海版）。
+ *
+ * 界面模式原本只有亮色 / 暗色 / 跟随系统，满足不了「护眼」这种需求 ——
+ * 换主题又会把整套配色重画，改不动别人的主题。
+ *
+ * 这里用**极轻的一层半透明色**覆盖在 Activity 内容之上（alpha 约 9%）：
+ * - 不拦截触摸（View 不消费事件，直接穿透到下层），不影响任何点击；
+ * - 不改主题、不改资源，所以任何页面都能立刻生效；
+ * - 读不到颜色（0）时整层移除，等于没开。
+ *
+ * 只作用于设置界面，键盘与输入不受影响 —— 用户在键盘上真正在意的是主题配色。
+ *
+ * **深色 / 浅色两套叠加方式**（这是「亮色模式下看不出效果」的根因）：
+ * - 深色底上用普通半透明色（SRC_OVER）就够了，浅色叠上去自然会亮一点；
+ * - 浅色底上同样 9% 的半透明色几乎被白色吃掉，肉眼看不到。
+ *   所以浅色模式改用 **MULTIPLY**：把颜色和白色混成很浅的底色再乘上去，
+ *   白底会被明显染成淡绿 / 淡黄，而黑字仍然是黑的，可读性不受影响。
+ */
+object DahiUiTint {
+    const val PREF_KEY = "dahi_ui_tint"
+    private const val TAG = "dahi_ui_tint_overlay"
+
+    /** 预设色调（alpha 已经写在颜色里）。0 = 关闭。 */
+    val presets: List<Int> =
+        listOf(
+            0,
+            0x187BC47F.toInt(), // 护眼淡绿
+            0x18FFC46B.toInt(), // 暖米黄
+            0x182F8BE0.toInt(), // 静谧淡蓝
+            0x18956BE0.toInt(), // 淡紫
+            0x14808080.toInt(), // 中性灰（压亮度）
+        )
+
+    /** 新装默认色调：静谧淡蓝（与默认的暗色界面配套）。用户改过就按改的来，包括改成「关闭」。 */
+    private val defaultColor = 0x182F8BE0.toInt()
+
+    private fun prefs() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    fun color(): Int = prefs().getInt(PREF_KEY, defaultColor)
+
+    fun setColor(value: Int) {
+        prefs().edit { putInt(PREF_KEY, value) }
+    }
+
+    /** 把当前色调应用到某个 Activity（幂等，可反复调用）。 */
+    fun apply(activity: Activity) {
+        val root = activity.findViewById<ViewGroup>(android.R.id.content) ?: return
+        val exist = root.findViewWithTag<View>(TAG)
+        val value = color()
+        if (value == 0) {
+            if (exist != null) root.removeView(exist)
+            return
+        }
+        val night = isNight(activity)
+        if (exist != null) {
+            exist.background = backgroundFor(value, night)
+            return
+        }
+        val overlay =
+            View(activity).apply {
+                tag = TAG
+                isClickable = false
+                isFocusable = false
+                background = backgroundFor(value, night)
+            }
+        root.addView(overlay, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))
+    }
+
+    private fun isNight(activity: Activity): Boolean = (activity.resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) ==
+        Configuration.UI_MODE_NIGHT_YES
+
+    private fun backgroundFor(
+        value: Int,
+        night: Boolean,
+    ): Drawable = if (night) {
+        // 深色：半透明覆盖，稍微提一点不透明度（16%），在纯黑底上才看得见
+        ColorDrawable((value and 0x00FFFFFF) or (0x2A shl 24))
+    } else {
+        // 浅色：MULTIPLY 一层很淡的底色，白底会被明显染色，黑字仍然黑
+        MultiplyDrawable(lighten(value, 0.68f))
+    }
+
+    /** 把颜色往白色方向拉 [keep] 之外的部分（keep 越小越接近白，MULTIPLY 越柔和）。 */
+    private fun lighten(
+        color: Int,
+        keep: Float,
+    ): Int {
+        fun mix(c: Int): Int = (c * keep + 255 * (1f - keep)).toInt().coerceIn(0, 255)
+        return Color.rgb(mix(Color.red(color)), mix(Color.green(color)), mix(Color.blue(color)))
+    }
+
+    /** 用 MULTIPLY 混合整层内容的 Drawable（只在浅色模式下使用）。 */
+    private class MultiplyDrawable(
+        private val color: Int,
+    ) : Drawable() {
+        override fun draw(canvas: Canvas) {
+            canvas.drawColor(color, PorterDuff.Mode.MULTIPLY)
+        }
+
+        override fun setAlpha(alpha: Int) = Unit
+
+        override fun setColorFilter(colorFilter: ColorFilter?) = Unit
+
+        @Deprecated("Deprecated in Drawable")
+        override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiVoiceStats.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiVoiceStats.kt
new file mode 100644
index 0000000..b80960d
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiVoiceStats.kt
@@ -0,0 +1,465 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import android.content.SharedPreferences
+import android.os.Handler
+import android.os.Looper
+import androidx.core.content.edit
+import java.time.DayOfWeek
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+
+/**
+ * 语音输入统计（大海版）。
+ *
+ * 为什么单独一份存储、而不并进 [DahiInputStats]：
+ * - 打字统计的每个数字都来自键盘事件（击键 / 选词 / 退格），语音根本没有这些事件，
+ *   硬塞进去会让「键/秒」「码长」「首选率」这些派生指标失真；
+ * - 独立存储 = **零干扰**：语音统计坏了不会影响打字统计，反之亦然；
+ * - 数据量只有一个 JSON（几个 Long），内存与性能开销可以忽略（每次会话结束写一次）。
+ *
+ * 字数来源：**由 ASR 回调直接给出**（[onVoiceText]），不再依赖 `commitText` 是否被调用 ——
+ * 实测「ASR 结果上屏」与「会话结束回调」的先后顺序不稳定，靠输入法侧的
+ * commit 去数，经常数到 0。
+ */
+object DahiVoiceStats {
+    private const val PREF = "dahi_voice_stats"
+    private const val KEY_JSON = "json"
+
+    /** 「语音后改动比例」是否展示（默认展示）。 */
+    private const val KEY_SHOW_EDIT_RATE = "show_edit_rate"
+
+    /** 会话结束后等这么久再结算：给 ASR 的 commitText 留出落地时间。 */
+    private const val SETTLE_DELAY_MS = 900L
+
+    private var prefs: SharedPreferences? = null
+    private var cache: Data? = null
+
+    /**
+     * 一个周期（今日 / 本周 / 本月 / 今年）内的语音账。
+     *
+     * [stamp] 是周期标识（如日 = yyyyMMdd、周 = yyyyWW、月 = yyyyMM、年 = yyyy），
+     * 取值变化时自动从 0 开始累加 —— 和打字统计一样，不需要定时清零任务。
+     */
+    data class PeriodStat(
+        var stamp: Int = 0,
+        var count: Long = 0L,
+        var ms: Long = 0L,
+        var chars: Long = 0L,
+        /** 该周期内「语音后改动」的退格次数。 */
+        var edits: Long = 0L,
+    ) {
+        /** 改字率（退格口径）；没有字数时返回 null。 */
+        val editRate: Double?
+            get() = if (chars > 0L) (edits.toDouble() / chars).coerceIn(0.0, 1.0) else null
+
+        val avgMs: Long get() = if (count > 0L) ms / count else 0L
+
+        val charsPerSession: Double get() = if (count > 0L) chars.toDouble() / count else 0.0
+    }
+
+    /** 一次语音会话的账。 */
+    data class Data(
+        var count: Long = 0L,
+        var ms: Long = 0L,
+        var chars: Long = 0L,
+        var lastMs: Long = 0L,
+        var lastChars: Long = 0L,
+
+        /** 最近一次语音结算的时间戳（毫秒）；0 表示老数据没有记录。 */
+        var lastAt: Long = 0L,
+
+        /** 观察到的语音段数（上屏后光标被跟踪成功、且拿到了最终文本）。 */
+        var corrCount: Long = 0L,
+
+        /** 被观察段落的原文总字数（分母）。 */
+        var origChars: Long = 0L,
+
+        /** 用户最终改动掉的字数（Levenshtein 距离累加，分子）。 */
+        var editChars: Long = 0L,
+
+        /** 语音上屏后短时间内按退格的次数（改字率的另一个来源）。 */
+        var backspaceEdits: Long = 0L,
+
+        /** 分周期账户：day / week / month / year。 */
+        var periods: MutableMap<String, PeriodStat> = mutableMapOf(),
+    ) {
+        val avgMs: Long get() = if (count > 0) ms / count else 0L
+
+        val charsPerSec: Double get() = if (ms > 0) chars * 1000.0 / ms else 0.0
+
+        /**
+         * 改字率：语音上屏的文字里，被用户事后改掉的比例（0~1）。
+         *
+         * 这是「识别准不准」的可观测代理指标 —— 识别错得多，用户删改就多。
+         * 样本极少时也照实显示，但界面会补一句「样本少，仅供参考」。
+         */
+        val correctionRate: Double
+            get() = if (corrCount > 0 && origChars > 0) (editChars.toDouble() / origChars).coerceIn(0.0, 1.0) else 0.0
+
+        /**
+         * 改字率（退格口径）：语音上屏后 20 秒内的退格次数 ÷ 语音字数。
+         *
+         * 这个口径**不依赖外部 App 的纠错上报**，任何时候都能算出来，
+         * 是「说完之后马上返工」的直接度量。没有语音字数时返回 null。
+         */
+        val editRate: Double?
+            get() = if (chars > 0) (backspaceEdits.toDouble() / chars).coerceIn(0.0, 1.0) else null
+
+        /** 平均每次语音的字数。 */
+        val charsPerSession: Double get() = if (count > 0) chars.toDouble() / count else 0.0
+    }
+
+    fun init(context: Context) {
+        if (prefs != null) return
+        prefs = context.applicationContext.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+        showEditRate = prefs?.getBoolean(KEY_SHOW_EDIT_RATE, true) ?: true
+        cache = load()
+    }
+
+    /** 是否展示「语音后改动比例」（统计页开关；分享图 / 分享文本跟随同一开关）。 */
+    fun isEditRateVisible(): Boolean = showEditRate
+
+    fun setEditRateVisible(value: Boolean) {
+        showEditRate = value
+        prefs?.edit { putBoolean(KEY_SHOW_EDIT_RATE, value) }
+    }
+
+    private val handler by lazy { Handler(Looper.getMainLooper()) }
+
+    /** 最近一次语音会话结算的时间（用于把之后的退格归到「语音返工」）。 */
+    @Volatile
+    private var lastVoiceEndAt = 0L
+
+    /** 是否展示「语音后改动比例」，默认开；关掉后统计页 / 分享图 / 分享文本都不再出现该项。 */
+    @Volatile
+    private var showEditRate = true
+
+    /** 语音结束后多久内的退格算「语音返工」。 */
+    private const val EDIT_WINDOW_MS = 20_000L
+
+    /**
+     * 用户按了一次退格：若在语音结束后 [EDIT_WINDOW_MS] 内，算一次「语音返工」。
+     *
+     * 只记次数、不记内容；这是「改字率」在没有外部纠错上报时的可用替代口径。
+     */
+    fun onBackspace() {
+        val end = lastVoiceEndAt
+        if (end <= 0L) return
+        if (System.currentTimeMillis() - end > EDIT_WINDOW_MS) return
+        val d = ensure()
+        d.backspaceEdits++
+        // 同时记到当前周期的桶里（与 settle 用同一套 stamp）
+        PERIOD_KEYS.forEach { key ->
+            val stamp = stampOf(key)
+            val stat = d.periods.getOrPut(key) { PeriodStat(stamp = stamp) }
+            if (stat.stamp == stamp) stat.edits++
+        }
+        save(d)
+    }
+
+    /** 当前会话是否还在"收数"（begin ~ 延迟结算之间）。 */
+    @Volatile
+    private var collecting = false
+    private var sessionStart = 0L
+    private var sessionChars = 0L
+    private var pendingDuration = 0L
+
+    private val settleRunnable = Runnable { settle() }
+
+    /** 语音会话开始（按住说话 / 点开麦克风的那一刻）。 */
+    fun begin() {
+        handler.removeCallbacks(settleRunnable)
+        // 上一次如果还没结算（极端时序），先结掉，避免数据串到这一次
+        settle()
+        sessionStart = System.currentTimeMillis()
+        sessionChars = 0L
+        pendingDuration = 0L
+        collecting = true
+    }
+
+    fun isActive(): Boolean = collecting
+
+    /**
+     * ASR 最终文本（由语音回调直接给出）。
+     *
+     * 这就是本次语音真正上屏的字数 —— 不经过输入法的 commit 路径，
+     * 因此不受「谁是先谁后」影响。
+     */
+    fun onVoiceText(text: String) {
+        if (!collecting || text.isEmpty()) return
+        sessionChars += text.count { it.code > 0x2E80 }
+    }
+
+    /**
+     * 语音会话结束：算时长，然后**延迟一小会儿**再结算，
+     * 让 ASR 的 commitText / onVoiceText 有时间落地。
+     */
+    fun end() {
+        if (!collecting) return
+        val duration = (System.currentTimeMillis() - sessionStart).coerceAtLeast(0L)
+        // 少于 400ms 的多半是误触，不计入
+        if (duration < 400L) {
+            collecting = false
+            return
+        }
+        pendingDuration = duration
+        handler.removeCallbacks(settleRunnable)
+        handler.postDelayed(settleRunnable, SETTLE_DELAY_MS)
+    }
+
+    private fun settle() {
+        handler.removeCallbacks(settleRunnable)
+        if (!collecting) return
+        collecting = false
+        val duration = pendingDuration
+        pendingDuration = 0L
+        if (duration < 400L) return
+        // 一次都没上屏文字（取消 / 识别失败）不算一次会话，否则「33 次才 87 字」这种数没法看
+        if (sessionChars <= 0L) return
+        lastVoiceEndAt = System.currentTimeMillis()
+        val data = ensure()
+        data.count++
+        data.ms += duration
+        data.lastMs = duration
+        data.lastAt = lastVoiceEndAt
+        data.chars += sessionChars
+        data.lastChars = sessionChars
+        addToPeriods(data, duration)
+        save(data)
+    }
+
+    /** 把一次会话同时记进 4 个周期桶（stamp 变了就先归零）。 */
+    private fun addToPeriods(
+        data: Data,
+        duration: Long,
+    ) {
+        PERIOD_KEYS.forEach { key ->
+            val stamp = stampOf(key)
+            val stat = data.periods.getOrPut(key) { PeriodStat() }
+            if (stat.stamp != stamp) {
+                stat.stamp = stamp
+                stat.count = 0L
+                stat.ms = 0L
+                stat.chars = 0L
+                stat.edits = 0L
+            }
+            stat.count++
+            stat.ms += duration
+            stat.chars += sessionChars
+        }
+    }
+
+    /**
+     * 周期标识（内部用，只要自洽即可）。
+     *
+     * **边界必须与 [DahiInputStats] 一致**：那边是 LocalDate + 周一起算，
+     * 这边早期用的是 [java.util.Calendar.WEEK_OF_YEAR]，它受系统「一周从哪天开始」影响，
+     * 会在周界上和打字统计错开一天（表现为「本周」两项数字对不上）。
+     */
+    private fun stampOf(
+        key: String,
+        at: Long = System.currentTimeMillis(),
+    ): Int {
+        val zone = ZoneId.systemDefault()
+        val day: LocalDate = Instant.ofEpochMilli(at).atZone(zone).toLocalDate()
+        return when (key) {
+            "day" -> day.toEpochDay().toInt()
+            "week" -> day.with(DayOfWeek.MONDAY).toEpochDay().toInt()
+            "month" -> day.year * 100 + day.monthValue
+            else -> day.year
+        }
+    }
+
+    private val PERIOD_KEYS = listOf("day", "week", "month", "year")
+
+    /**
+     * 某个周期的语音账（今日 / 本周 / 本月 / 今年 / 生涯）。
+     *
+     * 生涯走全局字段，其余走 [Data.periods]；stamp 对不上（已经翻篇）就返回空账。
+     */
+    fun statOf(period: DahiInputStats.Period): PeriodStat {
+        val d = ensure()
+        if (period == DahiInputStats.Period.CAREER) {
+            return PeriodStat(
+                stamp = 0,
+                count = d.count,
+                ms = d.ms,
+                chars = d.chars,
+                edits = d.backspaceEdits,
+            )
+        }
+        val key =
+            when (period) {
+                DahiInputStats.Period.TODAY -> "day"
+                DahiInputStats.Period.WEEK -> "week"
+                DahiInputStats.Period.MONTH -> "month"
+                else -> "year"
+            }
+        val stamp = stampOf(key)
+        val stat = d.periods[key]
+        return if (stat != null && stat.stamp == stamp) stat else PeriodStat()
+    }
+
+    /**
+     * 一次「语音上屏 → 用户定稿」的观测结果（由 ASR 纠错跟踪器在结算时调用）。
+     *
+     * **不落盘原文**：这里只把两者的编辑距离累加进总账，原始文本用完即弃，
+     * 因此统计里看不出用户说过什么，隐私上是安全的。
+     */
+    fun onCorrection(
+        original: String,
+        final: String,
+    ) {
+        val src = original.trim()
+        if (src.isEmpty()) return
+        val dst = final.trim()
+        // 用户后来又打了大量文字（光标后文本远超原文长度）时，说明这次观测已被污染，直接丢弃
+        if (dst.length > src.length + 20) return
+        val edits = editDistance(src, dst).coerceAtMost(src.length)
+        val d = ensure()
+        d.corrCount++
+        d.origChars += src.length
+        d.editChars += edits
+        save(d)
+    }
+
+    /** 标准 Levenshtein 距离（滚动数组，O(n) 空间；几十字的文本开销可忽略）。 */
+    private fun editDistance(
+        a: String,
+        b: String,
+    ): Int {
+        if (a == b) return 0
+        if (a.isEmpty()) return b.length
+        if (b.isEmpty()) return a.length
+        var prev = IntArray(b.length + 1) { it }
+        var cur = IntArray(b.length + 1)
+        for (i in 1..a.length) {
+            cur[0] = i
+            val ca = a[i - 1]
+            for (j in 1..b.length) {
+                val cost = if (ca == b[j - 1]) 0 else 1
+                cur[j] = minOf(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
+            }
+            val swap = prev
+            prev = cur
+            cur = swap
+        }
+        return prev[b.length]
+    }
+
+    fun snapshot(): Data = ensure().copy()
+
+    /**
+     * 「最近一次」发生在什么时候：今天只给 HH:mm，不在今天带上「月-日」。
+     *
+     * 统计页 / 分享文本 / 分享图都用这一个函数，避免三处写法各一套、时间对不上。
+     * 老数据没有 lastAt（=0）时返回空串，调用方回退成不带时间的写法。
+     */
+    fun lastTimeText(
+        at: Long = snapshot().lastAt,
+        now: Long = System.currentTimeMillis(),
+    ): String {
+        if (at <= 0L) return ""
+        val zone = ZoneId.systemDefault()
+        val t = Instant.ofEpochMilli(at).atZone(zone)
+        val today = Instant.ofEpochMilli(now).atZone(zone).toLocalDate()
+        return if (t.toLocalDate() == today) {
+            String.format(java.util.Locale.US, "%02d:%02d", t.hour, t.minute)
+        } else {
+            String.format(java.util.Locale.US, "%d-%02d %02d:%02d", t.monthValue, t.dayOfMonth, t.hour, t.minute)
+        }
+    }
+
+    private fun ensure(): Data {
+        cache?.let { return it }
+        val d = load()
+        cache = d
+        return d
+    }
+
+    private fun readPeriods(o: org.json.JSONObject): MutableMap<String, PeriodStat> {
+        val result = mutableMapOf<String, PeriodStat>()
+        val json = o.optJSONObject("periods") ?: return result
+        json.keys().forEach { key ->
+            val p = json.optJSONObject(key) ?: return@forEach
+            result[key] =
+                PeriodStat(
+                    stamp = p.optInt("stamp"),
+                    count = p.optLong("count"),
+                    ms = p.optLong("ms"),
+                    chars = p.optLong("chars"),
+                    edits = p.optLong("edits"),
+                )
+        }
+        return result
+    }
+
+    private fun load(): Data {
+        val raw = prefs?.getString(KEY_JSON, null) ?: return Data()
+        return runCatching {
+            val o = org.json.JSONObject(raw)
+            Data(
+                count = o.optLong("count"),
+                ms = o.optLong("ms"),
+                chars = o.optLong("chars"),
+                lastMs = o.optLong("lastMs"),
+                lastChars = o.optLong("lastChars"),
+                lastAt = o.optLong("lastAt"),
+                corrCount = o.optLong("corrCount"),
+                origChars = o.optLong("origChars"),
+                editChars = o.optLong("editChars"),
+                backspaceEdits = o.optLong("backspaceEdits"),
+                periods = readPeriods(o),
+            )
+        }.getOrDefault(Data())
+    }
+
+    /** 清空语音统计（含分周期桶）；打字统计完全不受影响。 */
+    fun clear() {
+        cache = Data()
+        prefs?.edit { remove(KEY_JSON) }
+        // 会话态一起归零，否则「清空后马上按退格」还会被算进旧的返工窗口
+        lastVoiceEndAt = 0L
+        collecting = false
+        sessionChars = 0L
+        pendingDuration = 0L
+        handler.removeCallbacks(settleRunnable)
+    }
+
+    private fun save(data: Data) {
+        cache = data
+        val o = org.json.JSONObject()
+        o.put("count", data.count)
+        o.put("ms", data.ms)
+        o.put("chars", data.chars)
+        o.put("lastMs", data.lastMs)
+        o.put("lastChars", data.lastChars)
+        o.put("lastAt", data.lastAt)
+        o.put("corrCount", data.corrCount)
+        o.put("origChars", data.origChars)
+        o.put("editChars", data.editChars)
+        o.put("backspaceEdits", data.backspaceEdits)
+        val periodsJson = org.json.JSONObject()
+        data.periods.forEach { (key, stat) ->
+            periodsJson.put(
+                key,
+                org.json.JSONObject().apply {
+                    put("stamp", stat.stamp)
+                    put("count", stat.count)
+                    put("ms", stat.ms)
+                    put("chars", stat.chars)
+                    put("edits", stat.edits)
+                },
+            )
+        }
+        o.put("periods", periodsJson)
+        prefs?.edit { putString(KEY_JSON, o.toString()) }
+    }
+}
