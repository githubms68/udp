+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="dahi_plain_title">导出为明文文件（慎用！）</string>
+    <string name="dahi_plain_summary">把剪贴板/收藏夹/短语等数据导出为明文可读的文本或 CSV，方便在其他设备使用</string>
+    <string name="dahi_plain_format">选择导出格式</string>
+    <string name="dahi_plain_fmt_txt">TXT — 分段的可读文本</string>
+    <string name="dahi_plain_fmt_csv">CSV — 可用 Excel 打开</string>
+    <string name="dahi_plain_fmt_rime">rime custom_phrase — 仅短语，可直接给 rime 用</string>
+    <string name="dahi_plain_warning">导出的文件不是加密的。一旦保存，任何有存储权限的应用（文件管理器、网盘自动备份、相册扫描等）都可能读到它，请妥善保管、用完及时删除。
+
+如果你只是想在电脑上查看，推荐用「加密备份 + 离线单文件解密器」—— 文件仍然是加密的，解密在你自己的浏览器里完成。
+
+在你选择保存位置之前，数据不会离开本机。</string>
+    <string name="dahi_plain_file_warning">本文件是明文 —— 任何拿到它的人都能读取，用完请删除。</string>
