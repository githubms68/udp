new file mode 100644
index 0000000..3e0cbef
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiMenuFragment.kt
@@ -0,0 +1,197 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.os.Bundle
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.CheckBox
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import androidx.appcompat.app.AlertDialog
+import androidx.fragment.app.Fragment
+import com.osfans.trime.R
+import com.osfans.trime.ime.switches.DahiMenuConfig
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+
+/**
+ * 键盘左上角「设置菜单」的排序与显示控制（大海版）。
+ *
+ * 这个菜单是同文最常用的入口（换主题、选方案、部署、各种设置页），
+ * 但条目顺序一直写死在代码里。这里允许：
+ * - **显示 / 隐藏**：不用的入口直接勾掉；
+ * - **顶 / ↑ / ↓ / 底**：把常用的挪到前面；
+ * - **恢复默认**：清空自定义。
+ *
+ * 注意事项：
+ * - 只作用于**固定条目**；方案决定的开关项（简繁、标点等）不参与；
+ * - 菜单最底部的「编辑此菜单」**不能**被隐藏或排序 —— 否则改坏了就进不来；
+ * - 改完不用重启输入法，下次打开菜单就是新顺序（菜单每次都会重建）。
+ */
+class DahiMenuFragment : Fragment() {
+    private lateinit var content: LinearLayout
+    private var items: MutableList<DahiMenuConfig.Item> = mutableListOf()
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        content =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(28))
+            }
+        return ScrollView(ctx).apply { addView(content) }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        reload()
+    }
+
+    /** 展示顺序：用户排过的优先，没提过的按默认顺序追加（隐藏项也要列出来，供勾选）。 */
+
+    /** 深/浅色模式都看得清的主题色（不要再用硬编码灰，深色下会看不清）。 */
+    private fun dahiAccent(): Int = requireContext().styledColor(android.R.attr.colorAccent)
+
+    private fun dahiText2(): Int = requireContext().styledColor(android.R.attr.textColorSecondary)
+
+    private fun loadItems(): MutableList<DahiMenuConfig.Item> {
+        val byType = DahiMenuConfig.ALL.associateBy { it.type.name }
+        val list = ArrayList<DahiMenuConfig.Item>(DahiMenuConfig.ALL.size)
+        DahiMenuConfig.order().forEach { key ->
+            byType[key]?.let { item -> if (list.none { it.type == item.type }) list.add(item) }
+        }
+        DahiMenuConfig.ALL.forEach { item -> if (list.none { it.type == item.type }) list.add(item) }
+        return list
+    }
+
+    private fun isVisible(item: DahiMenuConfig.Item): Boolean = item.type.name !in DahiMenuConfig.hidden()
+
+    private fun reload() {
+        items = loadItems()
+        val ctx = requireContext()
+        content.removeAllViews()
+        content.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_menu_tip)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+                setTextColor(dahiText2())
+                setPadding(0, 0, 0, ctx.dp(10))
+            },
+        )
+        items.forEachIndexed { index, item -> content.addView(row(item, index)) }
+        content.addView(
+            Button(ctx).apply {
+                setText(R.string.dahi_menu_reset)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                layoutParams =
+                    LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+                        .apply { topMargin = ctx.dp(18) }
+                setOnClickListener { confirmReset() }
+            },
+        )
+    }
+
+    private fun row(
+        item: DahiMenuConfig.Item,
+        index: Int,
+    ): View {
+        val ctx = requireContext()
+        val visible = isVisible(item)
+        val row =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(0, ctx.dp(2), 0, ctx.dp(2))
+            }
+        row.addView(
+            CheckBox(ctx).apply {
+                isChecked = visible
+                setOnCheckedChangeListener { _, checked -> setVisible(item, checked) }
+            },
+        )
+        row.addView(
+            TextView(ctx).apply {
+                setText(item.labelRes)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                // 同上：跟随系统深浅色，用 alpha 表达「已启用 / 已隐藏」
+                alpha = if (visible) 1f else 0.45f
+                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+            },
+        )
+        row.addView(arrowButton("顶", enabled = index > 0) { moveTo(index, 0) })
+        row.addView(arrowButton("↑", enabled = index > 0) { moveTo(index, index - 1) })
+        row.addView(arrowButton("↓", enabled = index < items.size - 1) { moveTo(index, index + 1) })
+        row.addView(arrowButton("底", enabled = index < items.size - 1) { moveTo(index, items.size - 1) })
+        return row
+    }
+
+    private fun arrowButton(
+        text: String,
+        enabled: Boolean,
+        onTap: () -> Unit,
+    ): TextView {
+        val ctx = requireContext()
+        return TextView(ctx).apply {
+            setText(text)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+            gravity = Gravity.CENTER
+            setPadding(ctx.dp(12), ctx.dp(6), ctx.dp(12), ctx.dp(6))
+            alpha = if (enabled) 1f else 0.3f
+            isEnabled = enabled
+            setOnClickListener { if (enabled) onTap() }
+        }
+    }
+
+    private fun setVisible(
+        item: DahiMenuConfig.Item,
+        visible: Boolean,
+    ) {
+        val hidden = DahiMenuConfig.hidden().toMutableSet()
+        if (visible) hidden.remove(item.type.name) else hidden.add(item.type.name)
+        DahiMenuConfig.setHidden(hidden)
+        reload()
+    }
+
+    private fun moveTo(
+        index: Int,
+        target: Int,
+    ) {
+        if (index !in items.indices || target !in items.indices || index == target) return
+        val item = items.removeAt(index)
+        items.add(target, item)
+        DahiMenuConfig.setOrder(items.map { it.type.name })
+        reload()
+    }
+
+    private fun confirmReset() {
+        val ctx = requireContext()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_menu_reset)
+            .setMessage(R.string.dahi_menu_reset_msg)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                DahiMenuConfig.reset()
+                reload()
+                Toast.makeText(ctx, R.string.dahi_menu_reset_done, Toast.LENGTH_SHORT).show()
+            }.show()
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ui/main/settings/DahiPhraseSuggestFragment.kt b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiPhraseSuggestFragment.kt
