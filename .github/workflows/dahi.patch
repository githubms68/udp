+    var speedRingScale: Int
+        get() = runCatching { prefs().getInt(KEY_RING_SCALE, 100) }.getOrDefault(100).coerceIn(60, 200)
+        set(value) = prefs().edit { putInt(KEY_RING_SCALE, value.coerceIn(60, 200)) }
