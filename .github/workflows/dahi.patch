+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.os.Bundle
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.PopupMenu
+import android.widget.TextView
+import android.widget.Toast
+import androidx.appcompat.app.AlertDialog
+import androidx.fragment.app.Fragment
+import androidx.recyclerview.widget.ItemTouchHelper
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.osfans.trime.R
+import com.osfans.trime.ui.main.HomeEntry
+import com.osfans.trime.ui.main.HomeGroup
+import com.osfans.trime.ui.main.HomeLayout
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+
+/**
+ * 「设置项排序」页（大海版）。
+ *
+ * 首页是按分组显示的长列表，**排序页必须显示同样的分组头** ——
+ * 否则拖动时根本不知道自己挪到了哪个组里。本页因此：
+ * - 按分组渲染「组名 + 该组条目」，与首页完全一致；
+ * - **拖动即排序，也可以拖到别的组里**（跨组拖动 = 改这一项的分组归属）；
+ * - 右侧常驻「上移 / 下移」，点「⋮」可置顶 / 垫底 / 恢复默认；
+ * - 顶部「分组名称」可给 6 个组任意改名，底部「恢复默认」一键回到出厂。
+ */
+class HomeLayoutSettingsFragment : Fragment() {
+    private lateinit var adapter: LayoutAdapter
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(16))
+            }
+
+        column.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_order_tip)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setTextColor(ctx.styledColor(android.R.attr.textColorSecondary))
+            },
+        )
+
+        // 分组名可以按自己的习惯改（分组只是视觉分隔，不改变任何入口层级）
+        column.addView(
+            Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                setText(R.string.dahi_group_rename)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                gravity = Gravity.START
+                setPadding(0, ctx.dp(4), 0, ctx.dp(8))
+                setOnClickListener { showGroupNames() }
+            },
+        )
+
+        val recycler =
+            RecyclerView(ctx).apply {
+                layoutManager = LinearLayoutManager(ctx)
+                isVerticalScrollBarEnabled = false
+            }
+        adapter = LayoutAdapter()
+        recycler.adapter = adapter
+        ItemTouchHelper(
+            object : ItemTouchHelper.SimpleCallback(
+                ItemTouchHelper.UP or ItemTouchHelper.DOWN,
+                0,
+            ) {
+                override fun getMovementFlags(
+                    recyclerView: RecyclerView,
+                    viewHolder: RecyclerView.ViewHolder,
+                ): Int {
+                    // 分组标题是分隔线，不参与拖动
+                    val pos = viewHolder.bindingAdapterPosition
+                    if (pos >= 0 && adapter.items.getOrNull(pos) is Row.Header) return 0
+                    return super.getMovementFlags(recyclerView, viewHolder)
+                }
+
+                override fun onMove(
+                    recyclerView: RecyclerView,
+                    viewHolder: RecyclerView.ViewHolder,
+                    target: RecyclerView.ViewHolder,
+                ): Boolean {
+                    val from = viewHolder.bindingAdapterPosition
+                    val to = target.bindingAdapterPosition
+                    if (adapter.items.getOrNull(from) !is Row.Entry) return false
+                    adapter.move(from, to)
+                    return true
+                }
+
+                override fun clearView(
+                    recyclerView: RecyclerView,
+                    viewHolder: RecyclerView.ViewHolder,
+                ) {
+                    super.clearView(recyclerView, viewHolder)
+                    // 松手后统一结算：算出每一项现在属于哪个组，并把同组条目聚到一起
+                    adapter.commit()
+                }
+
+                override fun onSwiped(
+                    viewHolder: RecyclerView.ViewHolder,
+                    direction: Int,
+                ) = Unit
+            },
+        ).attachToRecyclerView(recycler)
+
+        column.addView(
+            recycler,
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f),
+        )
+
+        column.addView(
+            Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                setText(R.string.dahi_order_reset)
+                setOnClickListener {
+                    HomeLayout.reset()
+                    adapter.refresh()
+                    Toast.makeText(ctx, R.string.dahi_order_reset_done, Toast.LENGTH_SHORT).show()
+                }
+            },
+        )
+
+        return column
+    }
+
+    /** 分组名称：点某一组改名，或一键恢复默认。 */
+    private fun showGroupNames() {
+        val ctx = requireContext()
+        val groups = HomeGroup.values()
+        val names = groups.map { HomeLayout.groupTitle(it) }.toTypedArray()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_group_rename)
+            .setItems(names) { _, which -> renameGroup(groups[which]) }
+            .setNeutralButton(R.string.dahi_group_rename_reset) { _, _ ->
+                HomeLayout.resetGroupTitles()
+                adapter.refresh()
+                Toast.makeText(ctx, R.string.dahi_group_rename_reset_done, Toast.LENGTH_SHORT).show()
+            }.show()
+    }
+
+    private fun renameGroup(group: HomeGroup) {
+        val ctx = requireContext()
+        val current = HomeLayout.groupTitle(group)
+        val input =
+            EditText(ctx).apply {
+                setText(current)
+                setSingleLine()
+                setSelection(text.length)
+            }
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(getString(R.string.dahi_group_rename_x, current))
+            .setView(input)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                HomeLayout.setGroupTitle(group, input.text.toString())
+                adapter.refresh()
+                Toast.makeText(ctx, R.string.dahi_group_rename_done, Toast.LENGTH_SHORT).show()
+            }.setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun actionButton(
+        ctx: android.content.Context,
+        labelRes: Int,
+        id: Int,
+    ): TextView = TextView(ctx).apply {
+        this.id = id
+        setText(labelRes)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+        gravity = Gravity.CENTER
+        setPadding(ctx.dp(10), ctx.dp(6), ctx.dp(10), ctx.dp(6))
+    }
+
+    /** 列表里的一行：分组标题或某个设置项。 */
+    private sealed class Row {
+        data class Header(val group: HomeGroup) : Row()
+
+        data class Entry(val entry: HomeEntry) : Row()
+    }
+
+    private inner class LayoutAdapter : RecyclerView.Adapter<RecyclerView.ViewHolder>() {
+        val items: MutableList<Row> = buildRows()
+
+        override fun getItemViewType(position: Int): Int = if (items[position] is Row.Header) TYPE_HEADER else TYPE_ENTRY
+
+        override fun onCreateViewHolder(
+            parent: ViewGroup,
+            viewType: Int,
+        ): RecyclerView.ViewHolder {
+            val ctx = parent.context
+            return if (viewType == TYPE_HEADER) {
+                val header =
+                    LinearLayout(ctx).apply {
+                        orientation = LinearLayout.HORIZONTAL
+                        gravity = Gravity.CENTER_VERTICAL
+                        setPadding(0, ctx.dp(14), 0, ctx.dp(6))
+                    }
+                header.addView(
+                    TextView(ctx).apply {
+                        id = android.R.id.text1
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                        setTypeface(typeface, android.graphics.Typeface.BOLD)
+                        layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+                    },
+                )
+                header.addView(
+                    TextView(ctx).apply {
+                        id = android.R.id.text2
+                        setText(R.string.dahi_group_rename)
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                        setTextColor(ctx.styledColor(android.R.attr.textColorSecondary))
+                        setPadding(ctx.dp(8), 0, 0, 0)
+                    },
+                )
+                HeaderHolder(header)
+            } else {
+                val row =
+                    LinearLayout(ctx).apply {
+                        orientation = LinearLayout.HORIZONTAL
+                        gravity = Gravity.CENTER_VERTICAL
+                        setPadding(ctx.dp(12), ctx.dp(10), 0, ctx.dp(10))
+                    }
+                row.addView(
+                    TextView(ctx).apply {
+                        id = android.R.id.title
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+                        layoutParams =
+                            LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+                    },
+                )
+                // 行内固定按钮：上移 / 下移（最常用的两个动作，不藏进菜单）
+                row.addView(actionButton(ctx, R.string.dahi_order_up, android.R.id.button2))
+                row.addView(actionButton(ctx, R.string.dahi_order_down, android.R.id.button3))
+                row.addView(
+                    TextView(ctx).apply {
+                        id = android.R.id.button1
+                        setText("\u22ee")
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f)
+                        setPadding(ctx.dp(12), ctx.dp(2), ctx.dp(12), ctx.dp(2))
+                    },
+                )
+                EntryHolder(row)
+            }
+        }
+
+        override fun onBindViewHolder(
+            holder: RecyclerView.ViewHolder,
+            position: Int,
+        ) {
+            val ctx = holder.itemView.context
+            when (val row = items[position]) {
+                is Row.Header -> {
+                    val group = row.group
+                    holder.itemView.findViewById<TextView>(android.R.id.text1)?.text =
+                        HomeLayout.groupTitle(group)
+                    holder.itemView.findViewById<TextView>(android.R.id.text2)?.setOnClickListener {
+                        renameGroup(group)
+                    }
+                }
+
+                is Row.Entry -> {
+                    val entry = row.entry
+                    holder.itemView.findViewById<TextView>(android.R.id.title)?.text = ctx.getString(entry.title)
+                    holder.itemView.findViewById<TextView>(android.R.id.button1)?.setOnClickListener { anchor ->
+                        showMenu(anchor, entry)
+                    }
+                    holder.itemView.findViewById<TextView>(android.R.id.button2)?.setOnClickListener {
+                        HomeLayout.moveUp(entry.key)
+                        refresh()
+                    }
+                    holder.itemView.findViewById<TextView>(android.R.id.button3)?.setOnClickListener {
+                        HomeLayout.moveDown(entry.key)
+                        refresh()
+                    }
+                }
+            }
+        }
+
+        override fun getItemCount(): Int = items.size
+
+        fun move(
+            from: Int,
+            to: Int,
+        ) {
+            if (from < 0 || to < 0 || from >= items.size || to >= items.size || from == to) return
+            val moved = items.removeAt(from)
+            items.add(to, moved)
+            notifyItemMoved(from, to)
+        }
+
+        /**
+         * 拖动结束结算：
+         * 1. 每一项的分组 = 它上方最近的那个分组标题（所以拖进别的组就换了归属）；
+         * 2. 把同组条目按标题顺序聚到一起，写回顺序，避免「同组被拆成好几段」。
+         */
+        fun commit() {
+            val buckets = LinkedHashMap<HomeGroup, MutableList<String>>()
+            var current: HomeGroup? = null
+            items.forEach { row ->
+                when (row) {
+                    is Row.Header -> current = row.group
+                    is Row.Entry -> {
+                        val group = current ?: HomeLayout.groupOf(row.entry.key)
+                        buckets.getOrPut(group) { mutableListOf() }.add(row.entry.key)
+                    }
+                }
+            }
+            if (buckets.isEmpty()) return
+            HomeLayout.saveOrder(buckets.values.flatten())
+            buckets.forEach { (group, keys) ->
+                keys.forEach { key ->
+                    // 与默认分组相同的就不写覆盖，避免偏好里堆一堆无意义的值
+                    HomeLayout.setGroupOf(key, group.takeIf { it != HomeLayout.defaultGroupOf(key) })
+                }
+            }
+            refresh()
+        }
+
+        fun refresh() {
+            items.clear()
+            items.addAll(buildRows())
+            notifyDataSetChanged()
+        }
+
+        private fun showMenu(
+            anchor: View,
+            entry: HomeEntry,
+        ) {
+            val ctx = anchor.context
+            PopupMenu(ctx, anchor).apply {
+                menu.add(0, ACTION_TOP, 0, R.string.dahi_order_top)
+                menu.add(0, ACTION_BOTTOM, 1, R.string.dahi_order_bottom)
+                menu.add(0, ACTION_RESET, 2, R.string.dahi_order_reset)
+                setOnMenuItemClickListener { item ->
+                    when (item.itemId) {
+                        ACTION_TOP -> HomeLayout.moveTop(entry.key)
+                        ACTION_BOTTOM -> HomeLayout.moveBottom(entry.key)
+                        ACTION_RESET -> HomeLayout.reset()
+                    }
+                    refresh()
+                    true
+                }
+                show()
+            }
+        }
+    }
+
+    private class HeaderHolder(view: View) : RecyclerView.ViewHolder(view)
+
+    private class EntryHolder(view: View) : RecyclerView.ViewHolder(view)
+
+    private fun buildRows(): MutableList<Row> {
+        val rows = ArrayList<Row>()
+        var last: HomeGroup? = null
+        HomeLayout.orderedEntries().forEach { entry ->
+            val group = HomeLayout.groupOf(entry.key)
+            if (group != last) {
+                rows.add(Row.Header(group))
+                last = group
+            }
+            rows.add(Row.Entry(entry))
+        }
+        return rows
+    }
+
+    private companion object {
+        const val TYPE_HEADER = 0
+        const val TYPE_ENTRY = 1
+        const val ACTION_TOP = 1
+        const val ACTION_BOTTOM = 2
+        const val ACTION_RESET = 3
+    }
+}
