+    /** 方案对比：每个方案一行（字数 / 均速 / 首选率 + 按字数占比的条）。 */
+
+    /** 时段分布卡：24 根柱 + 一句「最活跃」。 */
+    private fun drawHoursCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        // 卡片高度比原来多 20：底下那句「最活跃 …」以前会压到横轴上的时间数字
+        val h = 320f
+        card(canvas, top, h)
+        sectionTitle(canvas, top, m.l.hours)
+        val left = PAD + 28f
+        val right = WIDTH - PAD - 28f
+        val gap = 4f
+        val barW = (right - left - gap * 23f) / 24f
+        val chartTop = top + 92f
+        val chartBottom = top + h - 70f
+        val chartH = chartBottom - chartTop
+        var maxRatio = 0.0
+        for (hour in 0..23) maxRatio = maxOf(maxRatio, m.bucket.hourRatio(hour))
+        val peak = m.bucket.busiestHour()?.first ?: -1
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        for (hour in 0..23) {
+            val ratio = m.bucket.hourRatio(hour)
+            val norm = if (maxRatio > 0) (ratio / maxRatio).toFloat() else 0f
+            val barH = if (ratio <= 0.0) 3f else (chartH * norm).coerceAtLeast(6f)
+            val x = left + hour * (barW + gap)
+            paint.color =
+                when {
+                    ratio <= 0.0 -> 0x22808080
+                    hour == peak -> warm
+                    else -> accent
+                }
+            canvas.drawRoundRect(
+                RectF(x, chartBottom - barH, x + barW, chartBottom),
+                barW / 2.4f,
+                barW / 2.4f,
+                paint,
+            )
+        }
+        listOf(0, 6, 12, 18, 23).forEach { hour ->
+            val x = left + hour * (barW + gap)
+            val text = hour.toString()
+            val textW = tp(18f, textDim).measureText(text)
+            canvas.drawText(
+                text,
+                when (hour) {
+                    0 -> left
+                    23 -> right - textW
+                    else -> x + barW / 2f - textW / 2f
+                },
+                chartBottom + 26f,
+                tp(18f, textDim),
+            )
+        }
+        val peakText =
+            m.bucket.busiestHour()?.let { p ->
+                "${two(p.first)}:00–${two((p.first + 1) % 24)}:00 · ${pct(p.second)}"
+            } ?: "—"
+        canvas.drawText("${m.l.busiest}  $peakText", left, top + h - 12f, tp(21f, textSub))
+        return top + h
+    }
+
+    /** 每日输入卡：近 30 天的柱子，最忙那天用暖色，底部写一句「最忙 …」。 */
+    private fun drawDailyCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        val h = 300f
+        card(canvas, top, h)
+        sectionTitle(canvas, top, m.l.dailyTitle)
+        val bars = m.dailyBars
+        if (bars.isEmpty()) return top + h
+        val left = PAD + 28f
+        val right = WIDTH - PAD - 28f
+        val chartTop = top + 92f
+        val chartBottom = top + h - 70f
+        val chartH = chartBottom - chartTop
+        val n = bars.size
+        // 只有两三天数据时，柱宽上限 46，避免拉成两条大色块
+        val slot = minOf((right - left) / n, 46f)
+        val startX = left + ((right - left) - slot * n) / 2f
+        val gap = (slot * 0.24f).coerceAtLeast(1f).coerceAtMost(5f)
+        val max = (bars.maxOfOrNull { it.chars } ?: 1L).coerceAtLeast(1L)
+        val peakIdx = bars.indices.maxByOrNull { bars[it].chars } ?: -1
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        bars.forEachIndexed { i, item ->
+            val norm = item.chars.toFloat() / max
+            val barH = if (item.chars <= 0L) 3f else (chartH * norm).coerceAtLeast(6f)
+            val x = startX + i * slot
+            paint.color = if (i == peakIdx) warm else accent
+            paint.alpha =
+                when {
+                    item.chars <= 0L -> 0x22
+                    item.weekend -> 130
+                    else -> 220
+                }
+            canvas.drawRoundRect(
+                RectF(x + gap / 2f, chartBottom - barH, x + slot - gap / 2f, chartBottom),
+                3f,
+                3f,
+                paint,
+            )
+        }
+        // 首 / 尾两个日期，中间那根不标，避免挤在一起
+        val firstLabel = bars.first().label
+        val lastLabel = bars.last().label
+        canvas.drawText(firstLabel, startX, chartBottom + 26f, tp(18f, textDim))
+        val lastW = tp(18f, textDim).measureText(lastLabel)
+        canvas.drawText(lastLabel, startX + slot * n - lastW, chartBottom + 26f, tp(18f, textDim))
+        if (m.busiestDayText.isNotEmpty()) {
+            canvas.drawText(m.busiestDayText, left, top + h - 12f, tp(21f, textSub))
+        }
+        return top + h
+    }
+
+    /** 词云卡：字号 = 词频，螺旋排布。 */
+    private fun drawCloudCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        // 与 App 内的词云视图保持同一口径（那边是 MAX_WORDS = 40），
+        // 否则分享图里的词明显比屏幕上少，像是「数据丢了」。
+        val h = 600f
+        card(canvas, top, h)
+        // 与 App 内词云共用「光晕背景」开关：开启时卡片里加一层极淡的径向渐变
+        val glowOn =
+            runCatching {
+                com.osfans.trime.data.prefs.AppPrefs.defaultInstance().profile.dahiWordCloudGlow.getValue()
+            }.getOrDefault(false)
+        // 与 App 内共用「倾斜」开关
+        val tiltOn =
+            runCatching {
+                com.osfans.trime.data.prefs.AppPrefs.defaultInstance().profile.dahiWordCloudTilt.getValue()
+            }.getOrDefault(true)
+        // 与 App 内共用「浮起阴影」开关
+        val shadowOn =
+            runCatching {
+                com.osfans.trime.data.prefs.AppPrefs.defaultInstance().profile.dahiWordCloudShadow.getValue()
+            }.getOrDefault(true)
+        if (glowOn) {
+            val cx = WIDTH / 2f
+            val cy = top + h * 0.56f
+            val shader =
+                android.graphics.RadialGradient(
+                    cx,
+                    cy,
+                    h * 0.5f,
+                    intArrayOf((accent and 0x00FFFFFF) or (0x24 shl 24), 0x00000000),
+                    floatArrayOf(0f, 1f),
+                    Shader.TileMode.CLAMP,
+                )
+            val glowPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { this.shader = shader }
+            canvas.drawCircle(cx, cy, h * 0.5f, glowPaint)
+        }
+        sectionTitle(canvas, top, m.l.wordcloud)
+        val words = m.bucket.wordFreq.entries.sortedByDescending { it.value }.take(40)
+        if (words.isEmpty()) return top + h
+        val maxCount = words.first().value.coerceAtLeast(1L)
+        val areaLeft = PAD + 26f
+        val areaTop = top + 80f
+        val areaRight = WIDTH - PAD - 26f
+        val areaBottom = top + h - 26f
+        val cx = (areaLeft + areaRight) / 2f
+        val cy = (areaTop + areaBottom) / 2f
+        val rects = ArrayList<RectF>(words.size)
+        words.forEachIndexed { rank, entry ->
+            val word = entry.key
+            val count = entry.value
+            val norm = (count.toDouble() / maxCount).toFloat().coerceIn(0f, 1f)
+            // 颜色按「排名」分档：词频都一样时（刚用不久）也不会整片同色
+            val pos = if (words.size <= 1) 0f else rank.toFloat() / (words.size - 1)
+            val size = 17f + 22f * norm
+            // 五档配色：词频从高到低走「暖金 → 强调紫 → 强调蓝 → 正文 → 弱化」，
+            // 比单色更像词云，也仍然是同一套模板色，不会跟主题打架
+            val color =
+                when {
+                    pos < 0.20f -> warm
+                    pos < 0.45f -> accent2
+                    pos < 0.70f -> accent
+                    pos < 0.90f -> textMain
+                    else -> textDim
+                }
+            val paint = tp(size, color, norm > 0.40f)
+            // 长词细、短词粗，和 App 内词云保持同一套观感
+            paint.typeface =
+                when {
+                    word.length <= 2 -> Typeface.DEFAULT_BOLD
+                    word.length == 3 -> Typeface.DEFAULT
+                    else -> runCatching { Typeface.create("sans-serif-light", Typeface.NORMAL) }
+                        .getOrDefault(Typeface.DEFAULT)
+                }
+            // 最高频那几个词加一层极淡阴影：在卡片底上"浮"起来一点，层次感更强。
+            // 阴影色跟着模板走：深色模板用亮影，否则黑色阴影在深底上完全看不见。
+            if (rank < 5 && shadowOn) {
+                runCatching { paint.setShadowLayer(13f, 0f, 2.5f, cloudShadow) }
+            }
+            val textW = paint.measureText(word)
+            val textH = size * 1.15f
+            var angle = 0f
+            var radius = 0f
+            var placed = false
+            while (!placed && radius < (areaRight - areaLeft)) {
+                val px = cx + radius * kotlin.math.cos(angle.toDouble()).toFloat()
+                val py = cy + radius * kotlin.math.sin(angle.toDouble()).toFloat() * 0.62f
+                val rect = RectF(px - textW / 2f, py - textH / 2f, px + textW / 2f, py + textH / 2f)
+                val inside =
+                    rect.left >= areaLeft && rect.top >= areaTop &&
+                        rect.right <= areaRight && rect.bottom <= areaBottom
+                if (inside && rects.none { RectF.intersects(it, rect) }) {
+                    rects.add(rect)
+                    // 与 App 内词云同一套倾斜规则：越常用越正，其余轻微倾斜，画面更有错落感
+                    val tilt = if (tiltOn && norm <= 0.6f) ((word.hashCode() % 13) - 6).toFloat() else 0f
+                    if (tilt == 0f) {
+                        canvas.drawText(word, rect.left, rect.bottom - size * 0.12f, paint)
+                    } else {
+                        canvas.save()
+                        canvas.rotate(tilt, rect.centerX(), rect.centerY())
+                        canvas.drawText(word, rect.left, rect.bottom - size * 0.12f, paint)
+                        canvas.restore()
+                    }
+                    placed = true
+                }
+                angle += 0.42f
+                radius += 5f
+            }
+        }
+        return top + h
+    }
+
+    /**
+     * 语音输入卡。
+     *
+     * 与统计页 / 分享文本**同一套口径、同一套行**：
+     *   第一行 4 格 = 本周期（会话 / 字数 / 字每次 / 语音后改动）
+     *   第二行     = 累计
+     *   第三行     = 最近一次（带时间点）
+     * 以前这里只有 4 格、而且取的是生涯数据，跟卡片标题对不上。
+     */
+    private fun drawVoiceCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+        v: DahiVoiceStats.PeriodStat,
+    ): Float {
+        val l = m.l
+        val h = 254f
+        card(canvas, top, h)
+        sectionTitle(canvas, top, l.voiceTitle + " · " + m.periodLabel)
+        val cells =
+            mutableListOf(
+                l.voiceSessions to v.count.toString(),
+                l.voiceChars to v.chars.toString(),
+                l.voicePerSession to v.charsPerSession.toInt().toString(),
+            )
+        val edit = if (DahiVoiceStats.isEditRateVisible()) v.editRate else null
+        if (edit != null) cells += l.voiceAcc to pct(edit)
+        val left = PAD + 28f
+        val right = WIDTH - PAD - 28f
+        val step = (right - left) / cells.size
+        cells.forEachIndexed { index, cell ->
+            val x = left + step * index
+            canvas.drawText(cell.second, x, top + 106f, tp(32f, textMain, true))
+            canvas.drawText(cell.first, x, top + 138f, tp(18f, textDim))
+        }
+        var y = top + 180f
+        if (m.voiceCareerText.isNotEmpty()) {
+            canvas.drawText(m.voiceCareerText, left, y, tp(20f, textDim))
+            y += 30f
+        }
+        if (m.voiceLastText.isNotEmpty()) {
+            canvas.drawText(m.voiceLastText, left, y, tp(20f, textDim))
+        }
+        return top + h
+    }
+
+    /** 小时 → 两位数字。 */
+    private fun two(value: Int): String = if (value < 10) "0$value" else value.toString()
+
+    /** 毫秒 → `m:ss`（语音时长）。 */
+    private fun mmss(ms: Long): String {
+        val total = ms / 1000
+        return String.format(java.util.Locale.US, "%d:%02d", total / 60, total % 60)
+    }
+
+    private fun drawSchemaCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        val l = m.l
+        val rows = m.schemas.take(4)
+        // 每行三段：方案名 → 进度条 → 一行小字。
+        // 原来行高 74、小字基线紧跟条底（+14），19f 的字顶会压到条上；
+        // 现在把基线拉到条底 +30，行高 82，彻底分开。
+        val rowH = 82f
+        val h = 112f + rows.size * rowH
+        card(canvas, top, h)
+        sectionTitle(canvas, top, l.schemaCompare)
+        val max = (rows.maxOfOrNull { it.chars } ?: 1L).coerceAtLeast(1L)
+        val barLeft = PAD + 28f
+        val barRight = WIDTH - PAD - 28f
+        var y = top + 104f
+        rows.forEach { row ->
+            val namePaint = tp(23f, textMain, true)
+            canvas.drawText(fit(namePaint, row.name, barRight - barLeft), barLeft, y, namePaint)
+            val barTop = y + 14f
+            val ratio = (row.chars.toDouble() / max).toFloat().coerceIn(0.03f, 1f)
+            canvas.drawRoundRect(RectF(barLeft, barTop, barRight, barTop + 10f), 5f, 5f, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = trackBg })
+            canvas.drawRoundRect(
+                RectF(barLeft, barTop, barLeft + (barRight - barLeft) * ratio, barTop + 10f),
+                5f,
+                5f,
+                Paint(Paint.ANTI_ALIAS_FLAG).apply { color = accent },
+            )
+            canvas.drawText(
+                "${l.chars} ${row.chars}  ·  ${l.speed} ${f1(row.avgSpeed)}  ·  ${l.firstpick} ${pct(row.firstPick)}",
+                barLeft,
+                barTop + 40f,
+                tp(19f, textDim),
+            )
+            y += rowH
+        }
+        return top + h
+    }
+
+    /** 文字截断（超宽时补省略号），避免长方案名压到别的元素上。 */
+    private fun fit(
+        paint: Paint,
+        text: String,
+        maxWidth: Float,
+    ): String {
+        if (paint.measureText(text) <= maxWidth) return text
+        var end = text.length
+        while (end > 1 && paint.measureText(text.substring(0, end) + "…") > maxWidth) end--
+        return text.substring(0, end) + "…"
+    }
+
+    /** 输入速度卡：极速 / 均速两个大数字，下面挂「键/秒」与码长。 */
+    private fun drawSpeedCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        val l = m.l
+        val h = 196f
+        card(canvas, top, h)
+        sectionTitle(canvas, top, l.speedTitle)
+        val b = m.bucket
+        val half = (WIDTH - PAD * 2 - 56f) / 2f
+        val left = PAD + 28f
+        canvas.drawText("${l.fastest} · ${l.spm}", left, top + 84f, tp(21f, textSub))
+        canvas.drawText(f1(b.fastest), left, top + 142f, tp(54f, warm, true))
+        canvas.drawText("${l.keys} ${f2(b.keysPerSec)} ${l.kps}", left, top + 176f, tp(20f, textDim))
+        val x2 = left + half
+        canvas.drawText("${l.average} · ${l.spm}", x2, top + 84f, tp(21f, textSub))
+        canvas.drawText(f1(b.avgSpeed), x2, top + 142f, tp(54f, accent, true))
+        canvas.drawText("${l.codelen} ${f1(b.avgCodeLen)} ${l.unitKey}", x2, top + 176f, tp(20f, textDim))
+        return top + h
+    }
+
+    /** 候选质量卡：首选率 / 翻页率 / 平均位置 / 上屏次数。 */
+    private fun drawCandidateCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        val l = m.l
+        val b = m.bucket
+        val h = 168f
+        card(canvas, top, h)
+        sectionTitle(canvas, top, l.candidate)
+        val items = listOf(
+            pct(b.firstPickRatio) to l.firstpick,
+            pct(b.pageFlipRatio) to l.frameflip,
+            f1(b.avgPickIndex) to l.avgpick,
+            b.commits.toString() to l.commits,
+        )
+        val cellW = (WIDTH - PAD * 2 - 56f) / 4f
+        items.forEachIndexed { i, item ->
+            val left = PAD + 28f + cellW * i
+            canvas.drawText(item.first, left, top + 104f, tp(33f, textMain, true))
+            canvas.drawText(item.second, left, top + 136f, tp(19f, textSub))
+        }
+        return top + h
+    }
+
+    /** 词长 / 码长分布卡。 */
+    private fun drawDistributionCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        val l = m.l
+        val wordRows = barRows(m.bucket.wordLen)
+        val codeRows = barRows(m.bucket.codeLen)
+        val inner = 28f
+        val h = 60f + 30f + wordRows.size * 42f + 34f + 30f + codeRows.size * 42f + 28f
+        card(canvas, top, h)
+        var y = top + 46f
+        canvas.drawText(l.wordlen, PAD + inner, y, tp(23f, textSub))
+        y += 30f
+        y = drawBars(canvas, y, m.bucket.wordLen, l.unitChar, wordRows)
+        y += 34f
+        canvas.drawText(l.codelenDist, PAD + inner, y, tp(23f, textSub))
+        y += 30f
+        drawBars(canvas, y, m.bucket.codeLen, l.unitKey, codeRows)
+        return top + h
+    }
+
+    private fun barRows(data: Map<String, Long>): List<Pair<String, Long>> = data.entries
+        .sortedBy { it.key.toIntOrNull() ?: Int.MAX_VALUE }
+        .take(6)
+        .map { it.key to it.value }
+
+    private fun drawBars(
+        canvas: Canvas,
+        top: Float,
+        data: Map<String, Long>,
+        unit: String,
+        rows: List<Pair<String, Long>>,
+    ): Float {
+        val total = data.values.sum()
+        var y = top
+        if (total <= 0L || rows.isEmpty()) {
+            canvas.drawText("—", PAD + 28f, y + 14f, tp(21f, textDim))
+            return y + 30f
+        }
+        val labelPaint = tp(20f, textSub)
+        val valuePaint = tp(20f, textMain).apply { textAlign = Paint.Align.RIGHT }
+        val track = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = trackBg }
+        val fill = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = accent }
+        val barLeft = PAD + 132f
+        val barRight = WIDTH - PAD - 108f
+        rows.forEach { row ->
+            val ratio = (row.second.toDouble() / total).coerceIn(0.0, 1.0)
+            canvas.drawText("${row.first}$unit", PAD + 28f, y + 14f, labelPaint)
+            canvas.drawRoundRect(RectF(barLeft, y + 2f, barRight, y + 18f), 8f, 8f, track)
+            val w = ((barRight - barLeft) * ratio).toFloat()
+            if (w > 1f) canvas.drawRoundRect(RectF(barLeft, y + 2f, barLeft + w, y + 18f), 8f, 8f, fill)
+            canvas.drawText(String.format(Locale.US, "%.0f%%", ratio * 100), WIDTH - PAD - 28f, y + 14f, valuePaint)
+            y += 42f
+        }
+        return y
+    }
+
+    /** 键盘热力卡：每个格子**键名 + 百分比**，按使用频率上色。 */
+    private fun drawHeatCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        val l = m.l
+        val layout = m.layout
+        val counts = m.bucket.keyHeat
+        // 与 App 内热力图同一口径：分母只算当前布局里存在的键
+        val visibleLabels = layout.flatten().map { it.label }.filter { it.isNotEmpty() }.toSet()
+        val total = counts.filterKeys { it in visibleLabels }.values.sum()
+        val max =
+            (counts.filterKeys { it in visibleLabels }.values.maxOrNull() ?: 0L).coerceAtLeast(1L)
+        val rowH = 84f
+        val rowGap = 8f
+        val inner = 24f
+        val headH = 100f
+        val h = headH + layout.size * (rowH + rowGap) + 20f
+        card(canvas, top, h)
+        sectionTitle(canvas, top, l.heat)
+
+        val topKey = counts.entries.maxByOrNull { it.value }
+        if (topKey != null && total > 0) {
+            canvas.drawText(
+                "${l.heatTop} ${topKey.key} ${String.format(Locale.US, "%.1f%%", topKey.value * 100.0 / total)}",
+                PAD + 24f,
+                top + 74f,
+                tp(21f, textDim),
+            )
+        }
+
+        val usable = WIDTH - PAD * 2 - inner * 2
+        val extent = layout.flatten().maxOfOrNull { it.x + it.width }?.coerceAtLeast(0.01f) ?: 1f
+        var y = top + headH
+        layout.forEach { row ->
+            row.forEach { key ->
+                val left = PAD + inner + key.x / extent * usable
+                val w = (key.width / extent * usable).coerceAtLeast(1f)
+                val rect = RectF(left + 2f, y, left + w - 2f, y + rowH)
+                val count = counts[key.label] ?: 0L
+                val t = if (max > 0) count.toFloat() / max else 0f
+                canvas.drawRoundRect(rect, 10f, 10f, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = heatColor(t) })
+                if (key.label.isNotEmpty()) drawHeatText(canvas, key.label, count, total, rect, t)
+            }
+            y += rowH + rowGap
+        }
+        return top + h
+    }
+
+    /**
+     * 格子里的文字：**上行键名、下行百分比**。
+     *
+     * 窄键（功能键区的小键）放不下两行时只画键名 —— 键名比百分比重要，
+     * 没有键名这张图就是一堆无意义的色块。
+     */
+    private fun drawHeatText(
+        canvas: Canvas,
+        label: String,
+        count: Long,
+        total: Long,
+        cell: RectF,
+        intensity: Float,
+    ) {
+        val w = cell.width()
+        if (w < 26f || cell.height() < 20f) return
+        val dark = intensity > 0.55f
+        val name = if (label.length > 3) label.take(2) else label
+        val namePaint = tp(
+            if (w > 62f) 23f else 17f,
+            if (dark) Color.parseColor("#10131A") else textMain,
+            true,
+        ).apply { textAlign = Paint.Align.CENTER }
+        val pctText = when {
+            count <= 0L || total <= 0L -> ""
+            count * 100.0 / total >= 9.95 -> String.format(Locale.US, "%.0f%%", count * 100.0 / total)
+            else -> String.format(Locale.US, "%.1f%%", count * 100.0 / total)
+        }
+        if (w >= 56f && pctText.isNotEmpty()) {
+            canvas.drawText(name, cell.centerX(), cell.centerY() - 4f, namePaint)
+            val pctPaint = tp(19f, if (dark) Color.parseColor("#2A2F3A") else textSub).apply {
+                textAlign = Paint.Align.CENTER
+            }
+            canvas.drawText(pctText, cell.centerX(), cell.centerY() + 24f, pctPaint)
+        } else {
+            canvas.drawText(name, cell.centerX(), cell.centerY() + 8f, namePaint)
+        }
+    }
+
+    // ------------------------------------------------------------------ 画布工具
+
+    private fun tp(
+        size: Float,
+        color: Int,
+        bold: Boolean = false,
+    ): Paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        this.color = color
+        textSize = size
+        if (bold) typeface = Typeface.DEFAULT_BOLD
+    }
+
+    private fun card(
+        canvas: Canvas,
+        top: Float,
+        h: Float,
+        left: Float = PAD,
+        width: Float = WIDTH - PAD * 2,
+        radius: Float = RADIUS,
+        gradient: Boolean = false,
+        /** 0 = 用当前模板的卡片底色；非 0 = 用这个颜色（如「效率诊断」的暖色卡）。 */
+        bg: Int = 0,
+    ) {
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        paint.color = if (bg != 0) bg else cardBg
+        if (gradient) {
+            paint.shader = LinearGradient(
+                left,
+                top,
+                left + width,
+                top + h,
+                Color.parseColor("#28345A"),
+                Color.parseColor("#1B2230"),
+                Shader.TileMode.CLAMP,
+            )
+        }
+        canvas.drawRoundRect(RectF(left, top, left + width, top + h), radius, radius, paint)
+    }
+
+    private fun sectionTitle(
+        canvas: Canvas,
+        top: Float,
+        text: String,
+    ) {
+        canvas.drawRect(PAD + 2f, top + 24f, PAD + 8f, top + 44f, Paint().apply { color = accent })
+        canvas.drawText(text, PAD + 20f, top + 42f, tp(23f, textMain, true))
+    }
+
+    /** 冷 → 热：深蓝灰 → 蓝 → 亮蓝 → 橙 → 红。 */
+    private fun heatColor(t: Float): Int {
+        val v = t.coerceIn(0f, 1f)
+        return when {
+            v <= 0f -> Color.parseColor("#242B39")
+            v < 0.25f -> lerpColor("#26303F", "#2E4A8F", v / 0.25f)
+            v < 0.55f -> lerpColor("#2E4A8F", "#4C7BFF", (v - 0.25f) / 0.30f)
+            v < 0.80f -> lerpColor("#4C7BFF", "#FFA34C", (v - 0.55f) / 0.25f)
+            else -> lerpColor("#FFA34C", "#FF5F45", (v - 0.80f) / 0.20f)
+        }
+    }
+
+    private fun lerpColor(
+        from: String,
+        to: String,
+        t: Float,
+    ): Int {
+        val a = Color.parseColor(from)
+        val b = Color.parseColor(to)
+        val f = t.coerceIn(0f, 1f)
+        return Color.rgb(
+            (Color.red(a) + (Color.red(b) - Color.red(a)) * f).toInt(),
+            (Color.green(a) + (Color.green(b) - Color.green(a)) * f).toInt(),
+            (Color.blue(a) + (Color.blue(b) - Color.blue(a)) * f).toInt(),
+        )
+    }
+
+    // ------------------------------------------------------------------ 数字格式
+
+    private fun f1(v: Double): String = if (v <= 0.0) "—" else String.format(Locale.US, "%.1f", v)
+
+    private fun f2(v: Double): String = if (v <= 0.0) "—" else String.format(Locale.US, "%.2f", v)
+
+    private fun pct(v: Double): String = if (v <= 0.0) "—" else String.format(Locale.US, "%.0f%%", v * 100)
+}
