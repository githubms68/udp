+
+    /**
+     * 批量「拼接上屏」：把选中的条目按列表顺序合成一段，一次上屏。
+     *
+     * 分隔符做成可选，是因为用途差别很大 —— 整理清单要换行，
+     * 塞进搜索框或命令行要空格 / 直接相连。
+     */
+    private fun promptBatchJoin() {
+        val texts = resultAdapter.textsInSelectionOrder(selectedIds)
+        if (texts.isEmpty()) {
+            Toast.makeText(ctx, R.string.dahi_cp_join_empty, Toast.LENGTH_SHORT).show()
+            return
+        }
+        val labels =
+            arrayOf(
+                ctx.getString(R.string.dahi_cp_join_sep_newline),
+                ctx.getString(R.string.dahi_cp_join_sep_blank),
+                ctx.getString(R.string.dahi_cp_join_sep_space),
+                ctx.getString(R.string.dahi_cp_join_sep_comma),
+                ctx.getString(R.string.dahi_cp_join_sep_none),
+            )
+        val seps = arrayOf("\n", "\n\n", " ", "，", "")
+        val dialog =
+            android.app.AlertDialog
+                .Builder(ctx)
+                .setTitle(R.string.dahi_cp_join_title)
+                .setItems(labels) { _, which -> commitJoined(texts, seps[which]) }
+                .setNegativeButton(R.string.cancel, null)
+                .create()
+        service.showDialog(dialog)
+    }
+
+    private fun commitJoined(
+        texts: List<String>,
+        sep: String,
+    ) {
+        val joined = texts.joinToString(sep)
+        // 整段一次提交（含换行）：r137 实验证明按行拆提交并非必需，
+        // ima / 应用内「输入测试」对带换行的整段 commitText 也照收。
+        val ok = ClipboardSearchBridge.withBypass { service.commitTextToHost(joined) }
+        if (ok) {
+            Toast.makeText(ctx, ctx.getString(R.string.dahi_cp_join_done, texts.size), Toast.LENGTH_SHORT).show()
+            exitBatch()
+            keepAlive()
+        } else {
+            // 切窗口的瞬间输入连接可能还没回来：稍等再试一次（与单条上屏同一套兜底）
+            root.postDelayed(
+                {
+                    val retry = ClipboardSearchBridge.withBypass { service.commitTextToHost(joined) }
+                    if (retry) {
+                        Toast.makeText(ctx, ctx.getString(R.string.dahi_cp_join_done, texts.size), Toast.LENGTH_SHORT).show()
+                        exitBatch()
+                        keepAlive()
+                    } else {
+                        Toast.makeText(ctx, R.string.dahi_cp_paste_no_connection, Toast.LENGTH_SHORT).show()
+                    }
+                },
+                140,
+            )
+        }
+    }
+
+    /** 批量归类（「未分类」= 清空分类）。 */
+    private fun promptBatchMove(anchor: View) {
+        val ids = selectedIds.toList()
+        if (ids.isEmpty()) {
+            Toast.makeText(ctx, R.string.dahi_cp_batch_empty, Toast.LENGTH_SHORT).show()
+            return
+        }
+        service.lifecycleScope.launch {
+            val keys =
+                runCatching { DahiCategoryStore.loadOrdered() }.getOrDefault(emptyList())
+                    .filterNot { it == DahiCategoryStore.KEY_ALL }
+            // 一个分类都没有就别摆一个空列表，直接进「新建分类」
+            if (keys.isEmpty()) {
+                promptBatchNewCategory()
+                return@launch
+            }
+            // 选中的条目原本属于哪些分类：全部一致就勾出那一项，不一致一律不勾
+            val distinctCats = ids.map { resultAdapter.categoryOf(it) }.distinct()
+            val currentCat = distinctCats.singleOrNull()
+            val mixedCats = distinctCats.size > 1
+            val items = ArrayList<DahiWindowPanel.Item>(keys.size + 1)
+            keys.forEach { key ->
+                val label =
+                    if (key == DahiCategoryStore.KEY_UNCATEGORIZED) {
+                        ctx.getString(R.string.dahi_cp_category_uncategorized)
+                    } else {
+                        key
+                    }
+                val target = key.takeIf { it != DahiCategoryStore.KEY_UNCATEGORIZED }
+                val marked = !mixedCats && currentCat == target
+                items.add(DahiWindowPanel.Item(DahiWindowPanel.iconFolder, label, highlighted = marked) { moveBatchTo(ids, target) })
+            }
+            // 末尾追加「＋ 新建分类…」：选完名字直接建好并把这批条目归进去
+            items.add(DahiWindowPanel.Item(DahiWindowPanel.iconAdd, ctx.getString(R.string.dahi_cp_category_new)) { promptBatchNewCategory() })
+            windowPanel.showList(anchor, items)
+        }
+    }
+
+    /** 批量归类落到数据库（[target] 为 null = 清空分类）。 */
+    private fun moveBatchTo(
+        ids: List<Int>,
+        target: String?,
+    ) {
+        service.lifecycleScope.launch {
+            ids.forEach { id ->
+                if (isCollectionId(id)) {
+                    CollectionHelper.updateCategory(id, target)
+                } else {
+                    ClipboardHelper.updateCategory(id, target)
+                }
+            }
+            exitBatch()
+            refreshResults()
+            reattachOverlay()
+            Toast
+                .makeText(
+                    ctx,
+                    ctx.getString(R.string.dahi_cp_batch_done, ids.size),
+                    Toast.LENGTH_SHORT,
+                ).show()
+        }
+    }
+
+    /**
+     * 批量归类时「新建分类」：用键盘上方的单行浮层取名，
+     * 确认后建好分类、把这批条目一并归入，再恢复搜索结果。
+     *
+     * 输入浮层与搜索结果共用键盘上方那一格，所以先收起结果；取消或确认后都会恢复。
+     */
+    private fun promptBatchNewCategory() {
+        val ids = selectedIds.toList()
+        if (ids.isEmpty()) {
+            Toast.makeText(ctx, R.string.dahi_cp_batch_empty, Toast.LENGTH_SHORT).show()
+            return
+        }
+        // 不先 hideBottomOverlay：showBottomOverlay 内部就是「先移除再挂新的」，同一帧完成，
+        // 中间不会出现「只有键盘」的矮窗口状态（ima 会对这种高度突变重新 bind）。
+        val prompt =
+            DahiPhrasePromptOverlay(
+                ctx,
+                theme,
+                service,
+                windowManager,
+                ctx.getString(R.string.dahi_cp_category_new),
+            ) { name ->
+                val trimmed = name.trim()
+                if (trimmed.isEmpty()) {
+                    restoreSearchOverlay()
+                } else {
+                    DahiCategoryStore.add(trimmed)
+                    service.lifecycleScope.launch {
+                        ids.forEach { id ->
+                            if (isCollectionId(id)) {
+                                CollectionHelper.updateCategory(id, trimmed)
+                            } else {
+                                ClipboardHelper.updateCategory(id, trimmed)
+                            }
+                        }
+                        exitBatch()
+                        refreshResults()
+                        restoreSearchOverlay()
+                        Toast
+                            .makeText(
+                                ctx,
+                                ctx.getString(R.string.dahi_cp_batch_done, ids.size),
+                                Toast.LENGTH_SHORT,
+                            ).show()
+                    }
+                }
+            }
+        prompt.onCancel = { restoreSearchOverlay() }
+        // 顺序：先切窗口（onDetached 会清桥），再接桥，最后挂浮层
+        windowManager.attachWindow(KeyboardWindow)
+        prompt.activateBridge()
+        service.showBottomOverlay(prompt.root, prompt.heightPx)
+    }
+
+    /** 从输入浮层返回搜索结果（批量条状态保持不变）。 */
+    private fun restoreSearchOverlay() {
+        // 顺序：先切窗口（可能触发 onDetached 清桥），再接桥，最后挂浮层。
+        // 另外必须把 onReattach 指回搜索浮层 —— 短语浮层刚把它改成自己了，
+        // 不改回来的话，下一次宿主重 bind 会把短语输入框挂到搜索结果上面。
+        windowManager.attachWindow(KeyboardWindow)
+        ClipboardSearchBridge.activate(
+            onText = { appendText(it) },
+            onBackspace = { backspace() },
+        )
+        ClipboardSearchBridge.onReattach = { reattachOverlay() }
+        service.showBottomOverlay(root, heightPx)
+    }
+
+    // ---------------------------------------------------------------- 撤销
+
+    /** 撤销条的刷新令牌：延时任务醒来时若令牌变了，说明已被覆盖，直接退出。 */
+    private var undoToken = 0
+
+    /**
+     * 撤销条：浮在结果列表底部的小胶囊，「已删除 N 条 · 撤销」。
+     *
+     * 与剪贴板主页面同一套交互：删除后 5 秒内可一键恢复，
+     * 否则删错了只能靠备份，代价太大。
+     */
+    private val undoBar: TextView by lazy {
+        TextView(ctx).apply {
+            setTextColor(0xFFFFFFFF.toInt())
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            gravity = Gravity.CENTER
+            setPadding(dp(18), dp(9), dp(18), dp(9))
+            background =
+                GradientDrawable().apply {
+                    cornerRadius = dp(20).toFloat()
+                    setColor(0xF02B2B2B.toInt())
+                }
+            visibility = View.GONE
+            setOnClickListener { performUndo() }
+        }
+    }
+
+    private fun ensureUndoBar() {
+        if (undoBar.parent != null) return
+        listFrame.addView(
+            undoBar,
+            FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+            ).apply {
+                gravity = Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL
+                bottomMargin = dp(16)
+            },
+        )
+    }
+
+    /** 删除后显示 5 秒，文字里带秒数倒计时。 */
+    private fun showUndoBar() {
+        ensureUndoBar()
+        val token = ++undoToken
+        undoBar.visibility = View.VISIBLE
+
+        fun tick(left: Int) {
+            if (token != undoToken) return
+            if (left <= 0) {
+                hideUndoBar()
+                ClipboardHelper.clearUndoStash()
+                return
+            }
+            undoBar.text = ctx.getString(R.string.dahi_cp_deleted_undo_sec, ClipboardHelper.undoCount(), left)
+            // 用主线程 Handler 而不是 undoBar.postDelayed：
+            // 浮层被宿主收起时 View 会 detach，挂在 View 上的定时任务会跟着停，
+            // 撤销胶囊的倒计时就不会继续走。
+            mainHandler.postDelayed({ tick(left - 1) }, 1000)
+        }
+        tick(5)
+    }
+
+    private fun hideUndoBar() {
+        undoToken++
+        undoBar.visibility = View.GONE
+    }
+
+    private fun performUndo() {
+        hideUndoBar()
+        service.lifecycleScope.launch {
+            val ok = runCatching { ClipboardHelper.undoLastDelete() }.getOrDefault(false)
+            refreshResults()
+            if (ok) Toast.makeText(ctx, R.string.dahi_cp_undo_done, Toast.LENGTH_SHORT).show()
+        }
+    }
+
+    /** 批量删除（二次确认）。 */
+    private fun promptBatchDelete() {
+        val ids = selectedIds.toList()
+        if (ids.isEmpty()) {
+            Toast.makeText(ctx, R.string.dahi_cp_batch_empty, Toast.LENGTH_SHORT).show()
+            return
+        }
+        val sources = ids.associateWith { isCollectionId(it) }
+        val dialog =
+            android.app.AlertDialog
+                .Builder(ctx)
+                .setTitle(R.string.delete)
+                .setMessage(ctx.getString(R.string.dahi_cp_batch_delete_msg, ids.size))
+                .setPositiveButton(R.string.ok) { _, _ ->
+                    service.lifecycleScope.launch {
+                        // 删之前先留一份（带来源），5 秒内可整批撤销
+                        val stash =
+                            sources.mapNotNull { (id, collection) ->
+                                runCatching {
+                                    if (collection) CollectionHelper.get(id) else ClipboardHelper.get(id)
+                                }.getOrNull()?.let { it to collection }
+                            }
+                        sources.forEach { (id, isCollection) ->
+                            if (isCollection) {
+                                runCatching { CollectionHelper.delete(id) }
+                            } else {
+                                runCatching { ClipboardHelper.delete(id) }
+                            }
+                        }
+                        if (stash.isNotEmpty()) {
+                            ClipboardHelper.stashMixedForUndo(stash)
+                            showUndoBar()
+                        }
+                        exitBatch()
+                        refreshResults()
+                        reattachOverlay()
+                        keepAlive()
+                    }
+                }.setNegativeButton(R.string.cancel, null)
+                .create()
+        service.showDialog(dialog)
+    }
+
+    private fun render() {
+        queryView.text = query
+        applyScopeStyle()
+        clearButton.visibility = if (query.isEmpty()) View.GONE else View.VISIBLE
+        refreshHistory()
+        refreshResults()
+    }
+
+    /** 拉取并过滤结果（长按菜单改动数据后也可单独刷新）。 */
+    private fun refreshResults() {
+        refreshJob?.cancel()
+        refreshJob =
+            service.lifecycleScope.launch {
+                val clip = runCatching { ClipboardHelper.exportBeans() }.getOrDefault(emptyList())
+                val coll = runCatching { CollectionHelper.exportBeans() }.getOrDefault(emptyList())
+                // 多关键词：空格（含全角空格 / 制表符）分隔，全部出现才算命中（AND）
+                val tokens = query.split(' ', '\u3000', '\t').filter { it.isNotBlank() }
+                highlightTokens = tokens
+                val cat = categoryFilter
+                fun matched(b: DatabaseBean): Boolean {
+                    val raw = b.text.orEmpty()
+                    if (cat != null) {
+                        val beanCat = b.category.orEmpty()
+                        // CAT_NONE = 只看未分类
+                        if (if (cat == CAT_NONE) beanCat.isNotEmpty() else beanCat != cat) return false
+                    }
+                    if (tokens.isNotEmpty() && tokens.any { !raw.contains(it, ignoreCase = true) }) return false
+                    return when (typeFilter) {
+                        1 -> looksLikeNumber(raw)
+                        2 -> looksLikeUrl(raw)
+                        3 -> isPureNumber(raw)
+                        4 -> isPureUrl(raw)
+                        5 -> looksLikeDate(raw)
+                        6 -> looksLikeEmail(raw)
+                        7 -> looksLikeIp(raw)
+                        else -> true
+                    }
+                }
+                val clipMatched = clip.filter { matched(it) }
+                val collMatched = coll.filter { matched(it) }
+                // 「全部」才是混排去重；单选一个库时不做去重，
+                // 否则「同一段文字两边都有」就永远看不到 / 删不掉收藏夹那一份。
+                val shown: List<DatabaseBean> =
+                    when (scope) {
+                        1 -> clipMatched
+                        2 -> collMatched
+                        else -> {
+                            val seen = HashSet<String>()
+                            (clipMatched + collMatched).filter { seen.add(it.text.orEmpty()) }
+                        }
+                    }
+                // 两个库各自命中过哪些正文。注意按「命中集」而不是「显示集」记录，
+                // 否则被去重隐藏掉的那一份就查不到了（这正是「全部里看不到藏」的成因）。
+                inClipTexts.clear()
+                inClipTexts.addAll(clipMatched.map { it.text.orEmpty() })
+                inFavTexts.clear()
+                inFavTexts.addAll(collMatched.map { it.text.orEmpty() })
+                resultAdapter.submit(sortResults(shown))
+                if (batchMode) updateBatchCount()
+            }
+    }
+
+    /**
+     * 给搜索结果排序：置顶永远在最前（与窗口列表一致），其余按当前排序方式。
+     * 搜索结果是本地列表，直接排就行 —— 不必像窗口那样下沉到 SQL。
+     */
+    private fun sortResults(list: List<DatabaseBean>): List<DatabaseBean> {
+        val base: Comparator<DatabaseBean> =
+            when (sort) {
+                ClipSort.TIME_DESC -> compareByDescending { it.time }
+                ClipSort.TIME_ASC -> compareBy { it.time }
+                ClipSort.LEN_ASC -> compareBy { it.text?.length ?: 0 }
+                ClipSort.LEN_DESC -> compareByDescending { it.text?.length ?: 0 }
+                ClipSort.FREQ_DESC -> compareByDescending { it.useCount }
+                ClipSort.FREQ_ASC -> compareBy { it.useCount }
+            }
+        return list.sortedWith(compareByDescending<DatabaseBean> { it.pinned }.then(base))
+    }
+
+    /**
+     * 点结果条目上屏。
+     *
+     * 这里**不退出**浮层：用户常要连续粘几条，每次退出再点「搜索」太麻烦。
+     * 用 [ClipboardSearchBridge.withBypass] 让这次提交真正上屏；
+     * 搜索词保留，可以直接再点其它条目。
+     */
+    private fun pick(bean: DatabaseBean) {
+        val text = bean.text ?: return
+        val ok = ClipboardSearchBridge.withBypass { service.commitTextToHost(text) }
+        if (ok) {
+            // 频数 +1（「频数」排序用，界面不显示）：按这条属于哪个库累加
+            service.lifecycleScope.launch {
+                runCatching {
+                    if (isFavRow(text)) CollectionHelper.bumpUse(bean.id) else ClipboardHelper.bumpUse(bean.id)
+                }
+            }
+            // 搜到了、也真的用上了 —— 这才算一次有效搜索，值得进历史
+            ClipSearchHistory.remember(ctx, query)
+            historyState = null
+            hintCommitted(text)
+        } else {
+            // ima 这类应用切窗口时会短暂丢掉输入连接：稍等一下再试一次
+            root.postDelayed(
+                {
+                    val retry = ClipboardSearchBridge.withBypass { service.commitTextToHost(text) }
+                    if (retry) {
+                        hintCommitted(text)
+                    } else {
+                        Toast.makeText(ctx, R.string.dahi_cp_paste_no_connection, Toast.LENGTH_SHORT).show()
+                    }
+                },
+                140,
+            )
+        }
+        // 个别宿主在上屏后会重排窗口把键盘收掉，兜一下
+        root.postDelayed({ reattachOverlay() }, 220)
+    }
+
+    /** 上屏后的即时反馈：浮层挡着输入框，不给提示用户根本不知道点成没成功。 */
+    private fun hintCommitted(text: String) {
+        val shown = if (text.length > 12) text.take(12) + "…" else text
+        Toast
+            .makeText(ctx, ctx.getString(R.string.dahi_cp_pasted, shown), Toast.LENGTH_SHORT)
+            .show()
+    }
+
+    /**
+     * 兜底：浮层内弹出菜单 / 对话框后，个别 ROM 会连带收起键盘（浮层随之一并消失）。
+     * 键盘已隐藏时才重新请求显示并重挂浮层，正常情况零副作用。
+     */
+    private fun reattachOverlay() {
+        if (root.parent != null) {
+            // 浮层还挂在窗口树上：只要补桥。但**键盘可能已经被宿主收起**
+            // （点长按菜单时 ima / 应用内输入框会走一次 finish → 窗口隐藏），
+            // 这种情况下只补桥是没用的，必须把输入法自己请求回来。
+            // 注意：键盘在、浮层也在时这里什么都不做，不会产生多余的布局抖动。
+            if (!ClipboardSearchBridge.active) rebindBridge()
+            if (!service.isInputViewShown) runCatching { service.forceShowSelf() }
+            return
+        }
+        // 浮层已经不在窗口树上：把键盘要回来，再把浮层挂回去
+        runCatching { service.forceShowSelf() }
+        service.showBottomOverlay(root, heightPx)
+        rebindBridge()
+    }
+
+    /**
+     * 菜单动作结束后的存活兜底。
+     *
+     * ima 的聊天页、应用内「输入测试」这类对输入法窗口尺寸敏感的宿主，在
+     * 「数据库变了 → 列表重新布局」这一刻会把键盘收掉（有的还会连带把浮层一起收）。
+     * 表现就是：点删除 / 置顶 / 收藏，搜索窗口和键盘瞬间缩回，5 秒撤销胶囊一闪而过。
+     *
+     * 这里在动作结束后隔两段时间各检查一次：浮层没了就重挂、键盘没了就要回来。
+     * 已退出搜索（closed）则一律不做，避免把用户关掉的窗口又冒出来。
+     */
+    private fun keepAlive() {
+        mainHandler.postDelayed({ if (!closed) reattachOverlay() }, 350L)
+        mainHandler.postDelayed({ if (!closed) reattachOverlay() }, 1000L)
+    }
+
+    /** 把输入桥重新指向本浮层，并登记「被宿主重建输入视图后如何重挂」。 */
+    fun rebindBridge() {
+        ClipboardSearchBridge.activate(
+            onText = { appendText(it) },
+            onBackspace = { backspace() },
+        )
+        ClipboardSearchBridge.onReattach = { reattachOverlay() }
+    }
+
+    /**
+     * 收起搜索浮层，但**保留输入桥**。
+     *
+     * 用于「从搜索切到另一个浮层」（设为短语 / 新建分类）的过渡：
+     * 桥一旦 reset，宿主重 bind 时 onStartInputView 就认为「没在搜索」，会把新浮层清掉。
+     */
+    private fun leaveSearchKeepingBridge() {
+        refreshJob?.cancel()
+        windowPanel.dismiss()
+        service.hideBottomOverlay()
+        service.dahiSetOverlayNoContentInset(false)
+    }
+
+    /** 退出搜索：清理桥接与浮层，回到键盘。 */
+    fun exit() {
+        closed = true
+        refreshJob?.cancel()
+        windowPanel.dismiss()
+        ClipboardSearchBridge.reset()
+        service.hideBottomOverlay()
+        service.dahiSetOverlayNoContentInset(false)
+        windowManager.attachWindow(KeyboardWindow)
+    }
+}
