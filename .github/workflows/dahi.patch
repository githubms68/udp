+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import com.osfans.trime.BuildConfig
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiDailyHistory
+import com.osfans.trime.ime.custom.DahiInputStats
+import com.osfans.trime.ime.custom.DahiWordHidden
+import com.osfans.trime.ime.custom.DahiVoiceStats
+import java.time.LocalDate
+import java.util.Locale
+
+/**
+ * 把输入统计渲染成**纯文本**（三期）。
+ *
+ * 用途：论坛、微信收藏、笔记里粘贴图片不如粘贴文字方便；也有人只想把数字抄进自己的表格。
+ * 文本版只包含统计数字，同样不含任何输入内容。
+ *
+ * 版式原则（这是分享文本好不好看的关键）：
+ * 1. **分行有节奏**：用 `━━━` 分隔成「段位 → 综合 → 节奏 → 分布 → 热力 → 出处」六块，
+ *    每块自己讲一件事，扫一眼就懂；
+ * 2. **不依赖列对齐**：一行一项用 ` · ` 串起来，任何字体、任何语言都不会错位；
+ *    （中英混排时按字符数补空格，必然在别的设备上歪掉）
+ * 3. **分布用条形**：`███░░░░░░░` 十格宽，一眼看出主次，比一串百分比好读；
+ * 4. **境界有表情**：境界名旁边跟一个对应的 emoji，转发时更有辨识度。
+ */
+object DahiStatsText {
+    private const val BAR_FULL = "█"
+    private const val BAR_EMPTY = "░"
+    private const val BAR_WIDTH = 10
+    private val SEP = "━".repeat(14)
+
+    /**
+     * 生成纯文本。[period] 决定统计范围。
+     *
+     * 四个开关与分享图的勾选项一一对应 —— 有人只想发数字，有人想连诊断和建议一起发。
+     */
+    fun render(
+        ctx: Context,
+        period: DahiInputStats.Period,
+        showHeat: Boolean = true,
+        showSchemas: Boolean = true,
+        showAdvice: Boolean = true,
+        showVoice: Boolean = true,
+        showHours: Boolean = true,
+        showCloud: Boolean = true,
+    ): String {
+        ctxHolderNames = ctx.resources.getStringArray(R.array.dahi_week_names)
+        ctxHolderLayout = runCatching { DahiInputStats.lastLayout() }.getOrNull()
+        labelSpace = ctx.getString(R.string.dahi_stats_key_space)
+        labelEnter = ctx.getString(R.string.dahi_stats_key_enter)
+        val bucket = DahiInputStats.snapshot(period)
+        // 词云里被隐藏的词，文字版也一起跳过（与图片共用同一份名单）
+        runCatching { bucket.wordFreq.keys.removeAll(DahiWordHidden.load(ctx)) }
+        val career = DahiInputStats.snapshot(DahiInputStats.Period.CAREER)
+        val rank = DahiInputStats.rankOf(career.chars)
+        val basis = if (period == DahiInputStats.Period.CAREER) career else bucket
+        val title = DahiInputStats.titleOf(basis)
+        val schema = DahiInputStats.activeSchemaName()
+        val sb = StringBuilder()
+
+        // ---------------- 抬头
+        sb.append("🌊 ").append(ctx.getString(R.string.dahi_stats_title))
+            .append(" · ").append(periodLabel(ctx, period))
+            .append('\n')
+        sb.append("   ").append(LocalDate.now().toString()).append('\n')
+        // 近 30 天日均：与分享图同一口径（有输入的那些天求平均，少于 3 天不显示）
+        runCatching {
+            val days = DahiDailyHistory.recent(ctx, 30).filter { it.chars > 0 }
+            if (days.size >= 3) {
+                val avg = days.sumOf { it.chars } / days.size
+                sb.append("   ")
+                    .append(
+                        ctx.getString(
+                            R.string.dahi_stats_image_daily_avg,
+                            java.text.DecimalFormat("###,###").format(avg),
+                        ),
+                    ).append('\n')
+            }
+        }
+        sb.append(SEP).append('\n').append('\n')
+
+        // ---------------- 段位
+        sb.append(realmEmoji(rank.realm)).append(' ')
+            .append(rank.realm).append(" Lv.").append(rank.level)
+        if (title.isNotEmpty()) sb.append(" 「").append(title).append('」')
+        sb.append('\n')
+        sb.append("   ").append(ctx.getString(R.string.dahi_stats_exp))
+            .append(' ').append(rank.inLevel).append(" / ").append(rank.levelSpan)
+            .append("  ·  ").append(ctx.getString(R.string.dahi_stats_career))
+            .append(' ').append(career.chars).append(' ')
+            .append(ctx.getString(R.string.dahi_stats_unit_char))
+            .append('\n').append('\n')
+
+        // ---------------- 综合
+        sb.append("📊 ").append(ctx.getString(R.string.dahi_stats_overview)).append('\n')
+        sb.append("   ")
+            .append(ctx.getString(R.string.dahi_stats_chars)).append(' ').append(bucket.chars)
+            .append(" · ").append(ctx.getString(R.string.dahi_stats_keys)).append(' ').append(bucket.totalKeys)
+            .append('\n')
+        sb.append("   ")
+            .append(ctx.getString(R.string.dahi_stats_speed)).append(' ').append(f1(bucket.avgSpeed))
+            .append(" · ").append(ctx.getString(R.string.dahi_stats_fastest)).append(' ').append(f1(bucket.fastest))
+            .append('\n')
+        sb.append("   ")
+            .append(ctx.getString(R.string.dahi_stats_correction)).append(' ').append(pct(bucket.correctionRatio))
+            .append(" · ").append(ctx.getString(R.string.dahi_stats_perkey)).append(' ').append(f2(bucket.charsPerKey))
+            .append(' ').append(ctx.getString(R.string.dahi_stats_unit_perkey))
+            .append('\n').append('\n')
+
+        // ---------------- 节奏 / 候选质量
+        sb.append("⚡ ").append(ctx.getString(R.string.dahi_stats_speed_title)).append('\n')
+        sb.append("   ")
+            .append(ctx.getString(R.string.dahi_stats_kps)).append(' ').append(f2(bucket.keysPerSec))
+            .append(' ').append(ctx.getString(R.string.dahi_stats_unit_kps))
+            .append(" · ").append(ctx.getString(R.string.dahi_stats_codelen)).append(' ')
+            .append(f2(bucket.avgCodeLen)).append(' ').append(ctx.getString(R.string.dahi_stats_unit_key))
+            .append('\n')
+        sb.append("   ")
+            .append(ctx.getString(R.string.dahi_stats_firstpick)).append(' ').append(pct(bucket.firstPickRatio))
+            .append(" · ").append(ctx.getString(R.string.dahi_stats_frameflip)).append(' ').append(pct(bucket.pageFlipRatio))
+            .append(" · ").append(ctx.getString(R.string.dahi_stats_avgpick)).append(' ').append(f1(bucket.avgPickIndex))
+            .append('\n')
+        sb.append("   ")
+            .append(ctx.getString(R.string.dahi_stats_commits)).append(' ').append(bucket.commits)
+            .append('\n').append('\n')
+
+        // ---------------- 效率诊断（一句话）
+        if (showAdvice) {
+            val advice = adviceText(ctx, DahiInputStats.adviceOf(basis))
+            if (advice.isNotEmpty()) {
+                sb.append("💡 ").append(ctx.getString(R.string.dahi_stats_text_advice)).append('\n')
+                sb.append("   ").append(advice).append('\n').append('\n')
+            }
+        }
+
+        // ---------------- 语音输入（与统计页同一套口径：本周期一行 + 累计一行）
+        val voiceNow = DahiVoiceStats.statOf(period)
+        val voiceAll = DahiVoiceStats.statOf(DahiInputStats.Period.CAREER)
+        if (showVoice && voiceAll.count > 0L) {
+            sb.append("🎙 ").append(ctx.getString(R.string.dahi_stats_voice)).append('\n')
+            // 选「生涯」时下面那行累计就是全部，第一行再写一遍会重复
+            if (period != DahiInputStats.Period.CAREER && voiceNow.count > 0L) {
+                sb.append("   ")
+                    .append(
+                        ctx.getString(
+                            R.string.dahi_stats_voice_period,
+                            periodLabel(ctx, period),
+                            voiceNow.count,
+                            mmss(voiceNow.ms),
+                            voiceNow.chars,
+                        ),
+                    )
+                    .append('\n')
+            }
+            sb.append("   ")
+                .append(ctx.getString(R.string.dahi_stats_voice_total, voiceAll.count, mmss(voiceAll.ms), voiceAll.chars))
+                .append(" · ")
+                .append(ctx.getString(R.string.dahi_stats_voice_avg, mmss(voiceAll.avgMs), voiceAll.charsPerSession.toInt().toString()))
+            // 用户可在统计页关掉「语音后改动比例」；关掉后分享文本里也不出现
+            if (DahiVoiceStats.isEditRateVisible()) {
+                val edit = voiceAll.editRate
+                sb.append(" · ")
+                    .append(
+                        if (edit == null) {
+                            ctx.getString(R.string.dahi_stats_voice_edit_none)
+                        } else {
+                            ctx.getString(R.string.dahi_stats_voice_edit, pct(edit))
+                        },
+                    )
+            }
+            // 「最近一次」—— 统计页与分享图也有这一行，三处必须一致
+            val last = DahiVoiceStats.snapshot()
+            if (last.lastMs > 0L) {
+                val at = DahiVoiceStats.lastTimeText(last.lastAt)
+                sb.append('\n').append("   ")
+                    .append(
+                        if (at.isEmpty()) {
+                            ctx.getString(R.string.dahi_stats_voice_last, mmss(last.lastMs), last.lastChars)
+                        } else {
+                            ctx.getString(R.string.dahi_stats_voice_last_at, at, mmss(last.lastMs), last.lastChars)
+                        },
+                    )
+            }
+            sb.append('\n').append('\n')
+        }
+        sb.append(SEP).append('\n').append('\n')
+
+        // ---------------- 分布
+        val wordLines = bars(bucket.wordLen, ctx.getString(R.string.dahi_stats_unit_char))
+        if (wordLines.isNotEmpty()) {
+            sb.append("📈 ").append(ctx.getString(R.string.dahi_stats_wordlen)).append('\n')
+            wordLines.forEach { sb.append("   ").append(it).append('\n') }
+            sb.append('\n')
+        }
+        val codeLines = bars(bucket.codeLen, ctx.getString(R.string.dahi_stats_unit_key))
+        if (codeLines.isNotEmpty()) {
+            sb.append("📈 ").append(ctx.getString(R.string.dahi_stats_codelen_dist)).append('\n')
+            codeLines.forEach { sb.append("   ").append(it).append('\n') }
+            sb.append('\n')
+        }
+
+        // ---------------- 方案对比
+        if (showSchemas) {
+            val schemas = DahiInputStats.schemaSummary().take(5)
+            if (schemas.size > 1) {
+                sb.append("🏷 ").append(ctx.getString(R.string.dahi_stats_scheme_compare)).append('\n')
+                val max = (schemas.maxOfOrNull { it.chars } ?: 1L).coerceAtLeast(1L)
+                schemas.forEach { row ->
+                    val ratio = (row.chars.toDouble() / max).coerceIn(0.0, 1.0)
+                    sb.append("   ").append(row.name).append('\n')
+                    sb.append("   ").append(bar(ratio)).append(' ')
+                        .append(row.chars).append(ctx.getString(R.string.dahi_stats_unit_char))
+                        .append(" · ").append(f1(row.avgSpeed))
+                        .append(" · ").append(pct(row.firstPick))
+                        .append('\n')
+                }
+                sb.append('\n')
+            }
+        }
+
+        // ---------------- 热力 Top
+        val hot = hotKeys(bucket)
+        if (showHeat && hot.isNotEmpty()) {
+            sb.append("⌨️ ").append(ctx.getString(R.string.dahi_stats_heat_top)).append('\n')
+            hot.chunked(3).forEach { line ->
+                sb.append("   ").append(line.joinToString(" · ")).append('\n')
+            }
+            sb.append('\n')
+        }
+
+        sb.append(SEP).append('\n').append('\n')
+
+        // ---------------- 时段分布
+        if (showHours) {
+            val peak = bucket.busiestHour()
+            val peakDay = bucket.busiestWeekday()
+            if (peak != null || peakDay != null) {
+                sb.append("🕐 ").append(ctx.getString(R.string.dahi_stats_hours)).append('\n')
+                if (peak != null) {
+                    sb.append("   ")
+                        .append(ctx.getString(R.string.dahi_stats_peak_hour)).append(' ')
+                        .append(hhmm(peak.first)).append("–").append(hhmm((peak.first + 1) % 24))
+                        .append(" · ").append(pct(peak.second))
+                        .append('\n')
+                }
+                if (peakDay != null) {
+                    sb.append("   ")
+                        .append(ctx.getString(R.string.dahi_stats_busiest)).append(' ')
+                        .append(weekName(peakDay.first))
+                        .append(" · ").append(pct(peakDay.second))
+                        .append('\n')
+                }
+                sb.append('\n')
+            }
+        }
+
+        // ---------------- 词云
+        if (showCloud) {
+            val words = bucket.wordFreq.entries.sortedByDescending { it.value }.take(12)
+            if (words.isNotEmpty()) {
+                sb.append("☁ ").append(ctx.getString(R.string.dahi_stats_wordcloud)).append('\n')
+                sb.append("   ").append(words.joinToString(" · ") { "${it.key} ${it.value}" })
+                    .append('\n').append('\n')
+            }
+        }
+
+        // ---------------- 出处
+        if (schema.isNotEmpty()) {
+            sb.append("◉ ").append(ctx.getString(R.string.dahi_stats_scheme)).append("  ").append(schema).append('\n')
+        }
+        sb.append("◉ ").append(ctx.getString(R.string.dahi_stats_frontend)).append("  ")
+            .append(ctx.getString(R.string.dahi_stats_brand)).append(' ').append(BuildConfig.BUILD_VERSION_NAME)
+            .append('\n')
+        sb.append("◉ ").append(ctx.getString(R.string.dahi_stats_privacy)).append("  ")
+            .append(ctx.getString(R.string.dahi_stats_text_privacy_msg))
+            .append('\n')
+
+        return sb.toString()
+    }
+
+    /** 小时 → `HH:00`。 */
+    private fun hhmm(hour: Int): String = String.format(Locale.US, "%02d:00", hour % 24)
+
+    /** Calendar.DAY_OF_WEEK（1=周日）→ 本地化「周几」。 */
+    private fun weekName(day: Int): String {
+        val names = ctxHolderNames ?: return day.toString()
+        val index = if (day == 1) 6 else day - 2
+        return names.getOrElse(index) { day.toString() }
+    }
+
+    /** 星期名（在 render 里赋值，避免把 ctx 传进每个小工具）。 */
+    private var ctxHolderNames: Array<String>? = null
+
+    /** 当前键盘布局（render 里赋值；只用于「最高频」算百分比）。 */
+    private var ctxHolderLayout: List<List<DahiInputStats.HeatKey>>? = null
+
+    /** 不可见键的显示名（同上，render 里赋值）。 */
+    private var labelSpace: String = " "
+
+    private var labelEnter: String = "\n"
+
+    /** 毫秒 → `m:ss`（语音时长用）。 */
+    private fun mmss(ms: Long): String {
+        val total = ms / 1000
+        return String.format(Locale.US, "%d:%02d", total / 60, total % 60)
+    }
+
+    /** 把 [DahiInputStats.Advice] 映射成一句人话（与分享图同一套文案）。 */
+    private fun adviceText(
+        ctx: Context,
+        advice: DahiInputStats.Advice,
+    ): String = when (advice) {
+        DahiInputStats.Advice.NONE -> ""
+        DahiInputStats.Advice.OK -> ctx.getString(R.string.dahi_stats_advice_ok)
+        DahiInputStats.Advice.FAST -> ctx.getString(R.string.dahi_stats_advice_fast)
+        DahiInputStats.Advice.DICT -> ctx.getString(R.string.dahi_stats_advice_dict)
+        DahiInputStats.Advice.PAGING -> ctx.getString(R.string.dahi_stats_advice_paging)
+        DahiInputStats.Advice.CORRECTION -> ctx.getString(R.string.dahi_stats_advice_correction)
+        DahiInputStats.Advice.CODELEN -> ctx.getString(R.string.dahi_stats_advice_codelen)
+    }
+
+    /** 分布：`1字  35%  ███░░░░░░░`。百分比定宽 4 字符，条形固定 10 格，所以能对齐。 */
+    private fun bars(
+        data: Map<String, Long>,
+        unit: String,
+    ): List<String> {
+        val total = data.values.sum()
+        if (total <= 0L) return emptyList()
+        return data.entries
+            .sortedBy { it.key.toIntOrNull() ?: Int.MAX_VALUE }
+            .take(6)
+            .map { entry ->
+                val ratio = entry.value.toDouble() / total
+                "${(entry.key + unit).padEnd(6)}${pct(ratio).padStart(4)}  ${bar(ratio)}"
+            }
+    }
+
+    private fun bar(ratio: Double): String {
+        val filled = Math.round(ratio * BAR_WIDTH).toInt().coerceIn(0, BAR_WIDTH)
+        return BAR_FULL.repeat(filled) + BAR_EMPTY.repeat(BAR_WIDTH - filled)
+    }
+
+    /** 最常用的几个键（按次数倒序，取 5 个）。 */
+    private fun hotKeys(bucket: DahiInputStats.Bucket): List<String> {
+        // 与热力图一致：只按「当前布局里存在的键」求和，避免换键盘后百分比虚高
+        val labels =
+            ctxHolderLayout?.flatten()?.map { it.label }?.filter { it.isNotEmpty() }?.toSet().orEmpty()
+        val total =
+            if (labels.isEmpty()) {
+                bucket.heatTotal
+            } else {
+                bucket.keyHeat.filterKeys { it in labels }.values.sum()
+            }
+        if (total <= 0L) return emptyList()
+        return bucket.keyHeat.entries
+            .sortedByDescending { it.value }
+            .take(5)
+            .map { (key, count) ->
+                // 空格 / 换行这类不可见键直接打出来会变成「4.2%」，看起来像少了键名
+                val label =
+                    when {
+                        key.isBlank() -> labelSpace
+                        key == "\n" -> labelEnter
+                        else -> key
+                    }
+                "$label ${String.format(Locale.US, "%.1f%%", count * 100.0 / total)}"
+            }
+    }
+
+    /** 境界对应的表情，让转发出去的文字有辨识度。 */
+    private fun realmEmoji(realm: String): String = when {
+        realm.contains("仙") -> "🚀"
+        realm.contains("化") -> "🔥"
+        realm.contains("应手") -> "⚡"
+        realm.contains("游刃") -> "🌊"
+        realm.contains("渐熟") -> "🌿"
+        realm.contains("入门") -> "🌱"
+        else -> "✍️"
+    }
+
+    private fun periodLabel(
+        ctx: Context,
+        period: DahiInputStats.Period,
+    ): String = ctx.getString(
+        when (period) {
+            DahiInputStats.Period.TODAY -> R.string.dahi_stats_today
+            DahiInputStats.Period.WEEK -> R.string.dahi_stats_week
+            DahiInputStats.Period.MONTH -> R.string.dahi_stats_month
+            DahiInputStats.Period.YEAR -> R.string.dahi_stats_year
+            DahiInputStats.Period.CAREER -> R.string.dahi_stats_career
+        },
+    )
+
+    private fun f1(v: Double): String = if (v <= 0.0) "—" else String.format(Locale.US, "%.1f", v)
+
+    private fun f2(v: Double): String = if (v <= 0.0) "—" else String.format(Locale.US, "%.2f", v)
+
+    private fun pct(v: Double): String = if (v <= 0.0) "—" else String.format(Locale.US, "%.0f%%", v * 100)
+}
