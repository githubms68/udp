+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiYearReviewImage.kt
@@ -0,0 +1,272 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiReport
+import java.text.DecimalFormat
+import java.util.Locale
+
+/**
+ * 「年度回顾」长图。
+ *
+ * 与「输入报告」长图的区别：报告讲的是「这个月 / 今年各项指标」，
+ * 回顾只讲一件事 —— **这一年你是怎么打字的**：一个字数、一条月度柱、一条速度曲线、
+ * 几个年度关键词。数字少、留白多，适合直接发朋友圈。
+ *
+ * 配色与统计分享图共用同一套四模板（deep / ink / neon / sand，见 DahiSharePalette），
+ * 选过一次就记住（同一个偏好键），不必每张图重新选。
+ *
+ * 数据全部来自 [DahiReport.build] 与已有的每日历史，**不新增任何采集**。
+ */
+object DahiYearReviewImage {
+    private const val WIDTH = 1080
+    private const val PAD = 72f
+
+    // 1720 装不下「关键词卡 + 底部两块」（实测会超出约 90px 被裁），放宽到 2000。
+    private const val HEIGHT = 2000
+
+    private val numFmt = DecimalFormat("###,###")
+
+    private fun num(v: Long): String = numFmt.format(v)
+
+    private fun tp(
+        size: Float,
+        color: Int,
+        bold: Boolean = false,
+    ): Paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        textSize = size
+        this.color = color
+        typeface = if (bold) Typeface.DEFAULT_BOLD else Typeface.DEFAULT
+    }
+
+    /**
+     * 渲染年度回顾。
+     *
+     * @param year 年份标题，例如 "2026"
+     * @param data 年度聚合（含字数、天数、速度曲线、关键词等）
+     * @param monthlyChars 12 个月的输入字数（下标 0 = 一月）
+     * @param template 配色模板 id：deep / ink / neon / sand
+     */
+    fun render(
+        ctx: Context,
+        year: String,
+        data: DahiReport.Data,
+        monthlyChars: LongArray,
+        template: String = "deep",
+    ): Bitmap {
+        val p = DahiSharePalette.of(template)
+        val bmp = Bitmap.createBitmap(WIDTH, HEIGHT, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bmp)
+        val w = WIDTH.toFloat()
+
+        // 背景渐变
+        val bg = Paint(Paint.ANTI_ALIAS_FLAG)
+        bg.shader =
+            LinearGradient(
+                0f,
+                0f,
+                0f,
+                HEIGHT.toFloat(),
+                p.bgTop,
+                p.bgBottom,
+                Shader.TileMode.CLAMP,
+            )
+        canvas.drawRect(0f, 0f, w, HEIGHT.toFloat(), bg)
+
+        val cardPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = p.card }
+        val dividerPaint =
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                color = p.divider
+                strokeWidth = 2f
+            }
+
+        var y = 86f
+
+        // ── 顶部：品牌 + 年份 ──
+        canvas.drawText("同文输入法 · 大海版", PAD, y, tp(26f, p.textDim))
+        y += 96f
+
+        canvas.drawText(year, PAD, y, tp(112f, p.textMain, true))
+        canvas.drawText(ctx.getString(R.string.dahi_year_review_subtitle), PAD, y + 44f, tp(30f, p.textSub))
+        y += 100f
+
+        canvas.drawLine(PAD, y, w - PAD, y, dividerPaint)
+        y += 78f
+
+        // ── 英雄数字：全年字数 ──
+        canvas.drawText(ctx.getString(R.string.dahi_year_review_chars), PAD, y, tp(28f, p.textSub))
+        y += 132f
+        val heroNum = num(data.chars)
+        val hero = tp(136f, p.textMain, true)
+        canvas.drawText(heroNum, PAD, y, hero)
+        canvas.drawText("字", PAD + hero.measureText(heroNum) + 14f, y, tp(34f, p.textSub))
+        y += 56f
+
+        // ── 三列小统计 ──
+        val colW = (w - PAD * 2) / 3f
+        val cells =
+            listOf(
+                ctx.getString(R.string.dahi_year_review_days) to "${data.days}",
+                ctx.getString(R.string.dahi_year_review_speed) to String.format(Locale.US, "%.1f", data.avgSpeed),
+                ctx.getString(R.string.dahi_report_late) to "${data.lateDays}",
+            )
+        cells.forEachIndexed { i, (label, value) ->
+            val x = PAD + colW * i
+            canvas.drawText(label, x, y, tp(24f, p.textDim))
+            canvas.drawText(value, x, y + 56f, tp(44f, p.textMain, true))
+        }
+        y += 132f
+
+        // ── 12 个月柱状 ──
+        canvas.drawRoundRect(RectF(PAD, y, w - PAD, y + 340f), 28f, 28f, cardPaint)
+        canvas.drawText(ctx.getString(R.string.dahi_year_review_monthly), PAD + 36f, y + 52f, tp(26f, p.textSub))
+
+        val chartTop = y + 88f
+        val chartBottom = y + 300f
+        val chartLeft = PAD + 36f
+        val chartRight = w - PAD - 36f
+        val maxMonth = (monthlyChars.maxOrNull() ?: 0L).coerceAtLeast(1L)
+        val barGap = 10f
+        val barW = (chartRight - chartLeft - barGap * 11) / 12f
+        val barPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = p.accent }
+        val barMaxPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = p.accentWarm }
+        val monthLabel = tp(18f, p.textDim)
+        val busiestMonth = monthlyChars.indices.maxByOrNull { monthlyChars[it] } ?: -1
+        for (i in 0 until 12) {
+            val v = if (i < monthlyChars.size) monthlyChars[i] else 0L
+            val ratio = if (v <= 0L) 0f else v.toFloat() / maxMonth
+            val bh = (chartBottom - chartTop) * ratio
+            val left = chartLeft + (barW + barGap) * i
+            if (bh > 0f) {
+                canvas.drawRoundRect(
+                    RectF(left, chartBottom - bh, left + barW, chartBottom),
+                    6f,
+                    6f,
+                    if (i == busiestMonth) barMaxPaint else barPaint,
+                )
+            }
+            val label = "${i + 1}"
+            canvas.drawText(
+                label,
+                left + barW / 2f - monthLabel.measureText(label) / 2f,
+                chartBottom + 28f,
+                monthLabel,
+            )
+        }
+        y += 340f + 56f
+
+        // ── 速度曲线 ──
+        canvas.drawRoundRect(RectF(PAD, y, w - PAD, y + 320f), 28f, 28f, cardPaint)
+        canvas.drawText(ctx.getString(R.string.dahi_year_review_speed_curve), PAD + 36f, y + 52f, tp(26f, p.textSub))
+
+        val pts = data.line
+        if (pts.size >= 2) {
+            val cl = PAD + 36f
+            val cr = w - PAD - 36f
+            val ct = y + 88f
+            val cb = y + 270f
+            val maxSpeed = pts.maxOf { it.speed }.coerceAtLeast(0.001)
+            val minSpeed = pts.map { it.speed }.filter { it > 0.0 }.minOrNull() ?: 0.0
+            // 纵轴从「最小非零值的一半」起，避免个别慢周把曲线压平
+            val floor = (minSpeed * 0.5).coerceAtLeast(0.0)
+            val span = (maxSpeed - floor).coerceAtLeast(0.001)
+            val path = Path()
+            pts.forEachIndexed { i, point ->
+                val x = cl + (cr - cl) * i / (pts.size - 1).toFloat()
+                val ratio = ((point.speed - floor) / span).coerceIn(0.0, 1.0).toFloat()
+                val py = cb - (cb - ct) * ratio
+                if (i == 0) path.moveTo(x, py) else path.lineTo(x, py)
+            }
+            val stroke =
+                Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                    color = p.accent
+                    style = Paint.Style.STROKE
+                    strokeWidth = 5f
+                    strokeCap = Paint.Cap.ROUND
+                    strokeJoin = Paint.Join.ROUND
+                }
+            canvas.drawPath(path, stroke)
+            canvas.drawText(
+                String.format(Locale.US, "峰值 %.1f 字/分", data.peakSpeed),
+                cl,
+                cb + 36f,
+                tp(22f, p.textDim),
+            )
+        } else {
+            canvas.drawText(
+                ctx.getString(R.string.dahi_report_no_words),
+                PAD + 36f,
+                y + 150f,
+                tp(24f, p.textDim),
+            )
+        }
+        y += 320f + 56f
+
+        // ── 年度关键词 ──
+        canvas.drawRoundRect(RectF(PAD, y, w - PAD, y + 300f), 28f, 28f, cardPaint)
+        canvas.drawText(ctx.getString(R.string.dahi_year_review_keywords), PAD + 36f, y + 52f, tp(26f, p.textSub))
+
+        val words = data.topWords.take(8)
+        if (words.isEmpty()) {
+            canvas.drawText(
+                ctx.getString(R.string.dahi_report_no_words),
+                PAD + 36f,
+                y + 130f,
+                tp(24f, p.textDim),
+            )
+        } else {
+            var cx = PAD + 36f
+            var cy = y + 108f
+            val wordPaint = tp(34f, p.textMain)
+            val countPaint = tp(20f, p.textDim)
+            words.forEach { (word, count) ->
+                val wWidth = wordPaint.measureText(word)
+                val cWidth = countPaint.measureText(" $count")
+                val need = wWidth + cWidth + 28f
+                if (cx + need > w - PAD - 36f) {
+                    cx = PAD + 36f
+                    cy += 62f
+                }
+                canvas.drawText(word, cx, cy, wordPaint)
+                canvas.drawText(" $count", cx + wWidth + 4f, cy, countPaint)
+                cx += need
+            }
+        }
+        y += 300f + 56f
+
+        // ── 底部：最忙的一天 + 最长连续 ──
+        canvas.drawText(ctx.getString(R.string.dahi_year_review_busiest), PAD, y, tp(24f, p.textDim))
+        canvas.drawText(
+            if (data.busiestDayChars > 0L) "${data.busiestDayLabel} · ${num(data.busiestDayChars)} 字" else "—",
+            PAD,
+            y + 44f,
+            tp(30f, p.textSub, true),
+        )
+        canvas.drawText(ctx.getString(R.string.dahi_year_review_streak), w / 2f, y, tp(24f, p.textDim))
+        canvas.drawText("${data.streak} 天", w / 2f, y + 44f, tp(30f, p.textSub, true))
+        y += 120f
+
+        canvas.drawText(
+            "由「同文输入法 · 大海版」生成 · 数据没有离开这台设备",
+            PAD,
+            HEIGHT - 56f,
+            tp(20f, p.textDim),
+        )
+
+        return bmp
+    }
+}
