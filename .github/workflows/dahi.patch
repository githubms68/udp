+    private enum class ChipKind { SPEED, ACCURACY, BREADTH }
+
+    /** 属性 chip：小图标 + 名称 + 评级。 */
+    private fun drawAttrChip(
+        canvas: Canvas,
+        x: Float,
+        top: Float,
+        kind: ChipKind,
+        name: String,
+        grade: String,
+    ): Float {
+        val h = 54f
+        val w = 228f
+        canvas.drawRoundRect(
+            RectF(x, top, x + w, top + h),
+            27f,
+            27f,
+            Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#2C374D") },
+        )
+        val iconCy = top + h / 2f
+        drawAttrIcon(canvas, kind, x + 30f, iconCy)
+        canvas.drawText(name, x + 52f, iconCy + 8f, tp(22f, textSub))
+        canvas.drawText(
+            grade,
+            x + w - 22f,
+            iconCy + 11f,
+            tp(29f, gradeColor(grade), true).apply { textAlign = Paint.Align.RIGHT },
+        )
+        return x + w
+    }
+
+    private fun gradeColor(grade: String): Int = when {
+        grade.startsWith("S") -> good
+        grade.startsWith("A") -> accent
+        grade.startsWith("B") -> warm
+        else -> textSub
+    }
+
+    /** 三个小图标：闪电 / 靶心 / 书。全部矢量绘制，不依赖字体里的 emoji。 */
+    private fun drawAttrIcon(
+        canvas: Canvas,
+        kind: ChipKind,
+        cx: Float,
+        cy: Float,
+    ) {
+        val p = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = 2.6f
+            strokeCap = Paint.Cap.ROUND
+            strokeJoin = Paint.Join.ROUND
+        }
+        when (kind) {
+            ChipKind.SPEED -> {
+                p.color = warm
+                val path = Path().apply {
+                    moveTo(cx + 4f, cy - 12f)
+                    lineTo(cx - 7f, cy + 1f)
+                    lineTo(cx - 1f, cy + 1f)
+                    lineTo(cx - 3f, cy + 12f)
+                    lineTo(cx + 8f, cy - 2f)
+                    lineTo(cx + 2f, cy - 2f)
+                    close()
+                }
+                canvas.drawPath(path, p)
+            }
+            ChipKind.ACCURACY -> {
+                p.color = accent
+                canvas.drawCircle(cx, cy, 11f, p)
+                canvas.drawCircle(cx, cy, 5.5f, p)
+                canvas.drawCircle(cx, cy, 1.6f, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = accent })
+            }
+            ChipKind.BREADTH -> {
+                p.color = accent2
+                canvas.drawRoundRect(RectF(cx - 11f, cy - 10f, cx + 11f, cy + 10f), 3f, 3f, p)
+                canvas.drawLine(cx, cy - 10f, cx, cy + 10f, p)
+            }
+        }
+    }
+
+    /** 段位徽章：外发光 + 渐变环 + 内圆 + 境界首字。 */
+    private fun drawBadge(
+        canvas: Canvas,
+        cx: Float,
+        cy: Float,
+        radius: Float,
+        realm: String,
+    ) {
+        canvas.drawCircle(cx, cy, radius + 10f, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#2E5B8CFF") })
+        val ring = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = 4f
+            shader = LinearGradient(
+                cx - radius,
+                cy - radius,
+                cx + radius,
+                cy + radius,
+                accent2,
+                accent,
+                Shader.TileMode.CLAMP,
+            )
+        }
+        canvas.drawCircle(cx, cy, radius - 2f, ring)
+        canvas.drawCircle(cx, cy, radius - 9f, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#2A3450") })
+        canvas.drawText(
+            realm.take(1).ifEmpty { "·" },
+            cx,
+            cy + 16f,
+            tp(44f, textMain, true).apply { textAlign = Paint.Align.CENTER },
+        )
+    }
