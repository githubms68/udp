diff --git a/app/src/main/res/values-zh-rCN/strings_dahi_privacy.xml b/app/src/main/res/values-zh-rCN/strings_dahi_privacy.xml
new file mode 100644
index 0000000..e4b90d9
--- /dev/null
+++ b/app/src/main/res/values-zh-rCN/strings_dahi_privacy.xml
@@ -0,0 +1,58 @@
+<?xml version="1.0" encoding="utf-8"?>
+
+<resources>
+    <string name="dahi_privacy_title">隐私体检</string>
+    <string name="dahi_privacy_claim_title">这个输入法，连不上网。</string>
+    <string name="dahi_privacy_claim_body">不是「关掉了网络」，是安装包里没有申请任何 INTERNET（联网）权限 —— 这是两件完全不同的事。</string>
+    <string name="dahi_privacy_perm_section">它申请了哪些权限</string>
+    <string name="dahi_privacy_loading">读取中…</string>
+    <string name="dahi_privacy_data_section">数据都在哪</string>
+    <string name="dahi_privacy_out_section">哪些东西会离开这台设备</string>
+    <string name="dahi_privacy_out_clip">剪贴板内容 —— 不会离开（除非你自己导出或分享）</string>
+    <string name="dahi_privacy_out_stats">输入统计 —— 不会离开（除非你自己导出或分享）</string>
+    <string name="dahi_privacy_out_crash">崩溃日志 —— 只写本机文件，不自动上传</string>
+    <string name="dahi_privacy_out_voice">语音识别 —— 本应用不上传音频。识别由你安装的「说点啥」完成，音频不经过本应用。</string>
+    <string name="dahi_privacy_backup_section">加密备份怎么存</string>
+    <string name="dahi_privacy_backup_body">加密导出：AES-256-GCM 加密（PBKDF2-HMAC-SHA256 派生密钥，20 万次迭代），密钥由你设置的密码派生，文件里没有任何明文。\n\n每日自动备份（若开启，仅含剪贴板与收藏夹）为明文 JSON，只存在应用私有目录 —— 其他应用读不到，也不联网上传。</string>
