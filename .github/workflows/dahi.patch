@@ -0,0 +1,200 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.util.AttributeSet
+import android.view.MotionEvent
+import android.view.View
+import androidx.annotation.ColorInt
+import com.osfans.trime.ime.custom.DahiDailyHistory
+import splitties.dimensions.dp
+import java.time.LocalDate
+
+/**
+ * 每日输入量的趋势柱图。
+ *
+ * 只做「画」和「点」两件事：数据由外部 [submit]，点击通过 [onDayClick] 回调。
+ * 柱高按字数归一化；最短的那天也会留一点点高度，免得看起来像没数据。
+ */
+class DahiDailyTrendView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+    private val barPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val labelPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val rect = RectF()
+
+    /**
+     * 一根柱子。
+     *
+     * 日视图和月视图共用这一个结构：外部把「标签 + 字数 + 两个配色标志」算好交进来，
+     * 点柱子时只回传下标，由调用方决定是弹「当天」还是「当月」。
+     */
+    data class Item(
+        val label: String,
+        val chars: Long,
+        /** 深夜（23 点后 / 凌晨 0–4 点）→ 画成暖橙。 */
+        val late: Boolean = false,
+        /** 周末 → 淡一档。 */
+        val weekend: Boolean = false,
+    )
+
+    private var items: List<Item> = emptyList()
+
+    private var accent = 0xFF5B8CFF.toInt()
+    private var dim = 0x66808080
+
+    /** 点某一根柱子：回传下标，由调用方决定弹什么。 */
+    var onBarClick: ((Int) -> Unit)? = null
+
+    init {
+        labelPaint.color = dim
+        labelPaint.textSize = dp(9f)
+        isClickable = true
+    }
+
+    @Suppress("unused")
+    fun setAccent(
+        @ColorInt color: Int,
+    ) {
+        accent = color
+        barPaint.color = color
+        invalidate()
+    }
+
+    /** 熬夜柱用的暖色（与词云里那档橙一致）。 */
+    private var lateColor = 0xFFFF9A5B.toInt()
+
+    fun setLateColor(
+        @ColorInt color: Int,
+    ) {
+        lateColor = color
+        invalidate()
+    }
+
+    fun setLabelColor(
+        @ColorInt color: Int,
+    ) {
+        dim = color
+        labelPaint.color = color
+        invalidate()
+    }
+
+    fun submit(list: List<Item>) {
+        items = list
+        invalidate()
+    }
+
+    companion object {
+        /** 由日期算出「周末 / 深夜」两个配色标志（日视图用）。返回值 = (weekend, late)。 */
+        fun flagsOf(
+            date: String,
+            peakHour: Int,
+            hours: List<Int> = emptyList(),
+            chars: Long = 0L,
+        ): Pair<Boolean, Boolean> {
+            val d = runCatching { LocalDate.parse(date) }.getOrNull()
+            val weekend = d?.dayOfWeek?.value?.let { it >= 6 } ?: false
+            // 熬夜 = 峰值在深夜，或深夜字数达标（与输入报告、分享图共用同一函数）
+            val late = DahiDailyHistory.isLateNightDay(peakHour, hours, chars)
+            return weekend to late
+        }
+    }
+
+    override fun onMeasure(
+        widthMeasureSpec: Int,
+        heightMeasureSpec: Int,
+    ) {
+        val h = dp(126f).toInt()
+        val w = MeasureSpec.getSize(widthMeasureSpec)
+        setMeasuredDimension(w, h)
+    }
+
+    private fun barArea(): RectF = RectF(0f, dp(6f), width.toFloat(), height - dp(16f))
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        val area = barArea()
+        if (items.isEmpty()) {
+            labelPaint.textSize = dp(11f)
+            val text = context.getString(com.osfans.trime.R.string.dahi_stats_daily_empty)
+            val tw = labelPaint.measureText(text)
+            canvas.drawText(text, (width - tw) / 2f, area.centerY(), labelPaint)
+            labelPaint.textSize = dp(9f)
+            return
+        }
+        val max = (items.maxOfOrNull { it.chars } ?: 1L).coerceAtLeast(1L)
+        val n = items.size
+        // 只有一两天数据时，柱子会被拉成一整条横杠 —— 给个宽度上限，改成居中显示
+        val slot = minOf(area.width() / n, dp(30f))
+        val left = area.left + (area.width() - slot * n) / 2f
+        // 柱子多（90 天 / 全部）时把缝隙收到最小，否则每根只剩一两个像素
+        val gap = (slot * 0.24f).coerceAtLeast(dp(0.5f)).coerceAtMost(dp(3f))
+        barPaint.color = accent
+        items.forEachIndexed { i, item ->
+            val ratio = item.chars.toFloat() / max
+            // 有一点数据就至少给条小尾巴，看得出「这天有输入」
+            val h = (area.height() * ratio).coerceAtLeast(if (item.chars > 0) dp(2f) else 0f)
+            rect.set(
+                left + i * slot + gap / 2f,
+                area.bottom - h,
+                left + (i + 1) * slot - gap / 2f,
+                area.bottom,
+            )
+            // 熬夜 = 暖橙；周末 = 淡一档；其余用强调色
+            barPaint.color = if (item.late) lateColor else accent
+            barPaint.alpha =
+                when {
+                    item.chars <= 0L -> 45
+                    item.weekend -> 120
+                    else -> 210
+                }
+            canvas.drawRoundRect(rect, dp(2f), dp(2f), barPaint)
+        }
+        // 只标首 / 中 / 尾三个日期，多了必然挤
+        val marks = listOf(0, n / 2, n - 1).distinct().filter { it in 0 until n }
+        marks.forEach { i ->
+            val text = items[i].label
+            val tw = labelPaint.measureText(text)
+            val cx = left + (i + 0.5f) * slot
+            val x =
+                when (i) {
+                    0 -> left
+                    n - 1 -> left + slot * n - tw
+                    else -> cx - tw / 2f
+                }
+            canvas.drawText(text, x, height - dp(3f), labelPaint)
+        }
+    }
+
+    private var downX = 0f
+
+    // 走「isClickable + performClick」这条标准通路：
+    // 手指一动超过 touchSlop 父容器就会接管滚动（统计页要能正常上下滑），
+    // 只有真的点一下才触发 performClick，不会在滑动结束时误弹窗口。
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (event.actionMasked == MotionEvent.ACTION_DOWN) downX = event.x
+        return super.onTouchEvent(event)
+    }
+
+    override fun performClick(): Boolean {
+        super.performClick()
+        if (items.isNotEmpty()) {
+            val area = barArea()
+            val slot = minOf(area.width() / items.size, dp(30f))
+            val left = area.left + (area.width() - slot * items.size) / 2f
+            val idx = ((downX - left) / slot).toInt()
+            if (idx in items.indices) onBarClick?.invoke(idx)
+        }
+        return true
+    }
+}
