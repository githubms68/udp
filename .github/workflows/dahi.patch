+import androidx.fragment.app.Fragment
+import androidx.navigation.fragment.findNavController
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiCustomPhrase
+import com.osfans.trime.ime.custom.DahiPhraseStats
+import com.osfans.trime.ime.custom.DahiPhraseSuggest
+import com.osfans.trime.ui.main.NavigationRoute
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+
+/**
+ * 「常用语学习」页。
+ *
+ * 三个视图（顶部切换）：
+ * 1. **待存为短语** —— 反复逐字打出的句子，可一键存成短语（含批量、向导）；
+ * 2. **已设短语** —— 已经存成短语的清单：逐字输入几次、短语调出几次、省了多少字、上次调出多久前；
+ *    并标出「快要忘记」（很久没调出过）的条目；
+ * 3. **复习** —— 不计分的闪卡：看正文回忆编码，自评三档，按间隔重复安排下次。
+ *
+ * 术语（界面上必须统一，避免「手打/调出」到底指什么的歧义）：
+ * - **逐字输入**：不用短语、按编码一个字一个字打出整句；
+ * - **短语调出**：用短语编码（如 `sd`）一次打出整句。
+ */
+class DahiPhraseSuggestFragment : Fragment() {
+    private companion object {
+        const val MODE_PENDING = 0
+        const val MODE_SAVED = 1
+        const val MODE_REVIEW = 2
+    }
+
+    /** 批量勾选（只作用于「待存为短语」视图）。 */
+    private val picked = LinkedHashSet<String>()
+
+    private var mode = MODE_PENDING
+
+    private var reviewList: List<DahiPhraseStats.Meta> = emptyList()
+    private var reviewIndex = 0
+    private var reviewDone = 0
+    private var reviewShown = false
+
+    /** 打字测试：用户输入的编码（rebuild 会重建视图，必须单独存）。 */
+    private var reviewInput = ""
+
+    /** 打字测试：刚刚打对了（此时直接露出编码，不用再点「显示编码」）。 */
+    private var reviewRight = false
+
+    /** 打字测试：打错了，界面提示「再试一次」。 */
+    private var reviewWrong = false
+
+    private var lenView: TextView? = null
+    private var countView: TextView? = null
+    private var scroll: ScrollView? = null
+
+    /** 「已忽略」区块的根视图；用于从顶部一键跳过去。 */
+    private var ignoredAnchor: View? = null
+    private var tabRow: LinearLayout? = null
+    private var bodyBox: LinearLayout? = null
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(28))
+            }
+
+        column.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_phrase_suggest_title)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 21f)
+                setTypeface(typeface, Typeface.BOLD)
+            },
+        )
+        column.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_phrase_suggest_intro)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setLineSpacing(ctx.dp(2).toFloat(), 1f)
+                setPadding(0, ctx.dp(6), 0, ctx.dp(10))
+            },
+        )
+        column.addView(
+            Switch(ctx).apply {
+                setText(R.string.dahi_phrase_suggest_switch)
+                isChecked = DahiPhraseSuggest.isEnabled()
+                setOnCheckedChangeListener { _, on ->
+                    if (on) {
+                        DahiPhraseSuggest.setEnabled(true)
+                        rebuild()
+                    } else {
+                        AlertDialog
+                            .Builder(ctx)
+                            .setMessage(R.string.dahi_phrase_suggest_switch_off_confirm)
+                            .setNegativeButton(android.R.string.cancel) { d, _ ->
+                                d.dismiss()
+                                isChecked = true
+                            }.setPositiveButton(android.R.string.ok) { _, _ ->
+                                DahiPhraseSuggest.setEnabled(false)
+                                picked.clear()
+                                rebuild()
+                            }.show()
+                    }
+                }
+            },
+        )
+        column.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_phrase_suggest_switch_desc)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setLineSpacing(ctx.dp(2).toFloat(), 1f)
+                setPadding(0, ctx.dp(4), 0, ctx.dp(6))
+            },
+        )
+        lenView =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setTextColor(dahiAccent())
+                setPadding(0, ctx.dp(2), 0, ctx.dp(8))
+                isClickable = true
+                setOnClickListener { promptLenRange() }
+            }
+        lenView?.let { column.addView(it) }
+        countView =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setTextColor(dahiAccent())
+                setPadding(0, ctx.dp(2), 0, ctx.dp(8))
+                isClickable = true
+                setOnClickListener { promptCountRange() }
+            }
+        countView?.let { column.addView(it) }
+        column.addView(
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                // 「一键转快打（Top 10）」字数多，给它 2 份宽度；「新建快打」1 份就够，
+                // 否则前者的字被挤、后者的边框又比字宽一大截
+                addView(
+                    wideButton(getString(R.string.dahi_phrase_suggest_wizard), 2f) { promptWizard() },
+                )
+                addView(
+                    wideButton(getString(R.string.dahi_phrase_suggest_new), 1f) { promptNewPhrase() },
+                )
+            },
+        )
+
+        tabRow = LinearLayout(ctx).apply {
+            orientation = LinearLayout.HORIZONTAL
+            setPadding(0, ctx.dp(10), 0, ctx.dp(4))
+        }
+        tabRow?.let { column.addView(it) }
+
+        bodyBox = LinearLayout(ctx).apply { orientation = LinearLayout.VERTICAL }
+        bodyBox?.let { column.addView(it) }
+
+        return ScrollView(ctx).apply {
+            addView(column)
+            this@DahiPhraseSuggestFragment.scroll = this
+        }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        rebuild()
+    }
+
+    override fun onResume() {
+        super.onResume()
+        rebuild()
+    }
+
+    // ---------------------------------------------------------------- 渲染
+
+    private fun rebuild() {
+        lenView?.text =
+            getString(R.string.dahi_phrase_suggest_len_range, DahiPhraseSuggest.minLen(), DahiPhraseSuggest.maxLen())
+        countView?.text = getString(R.string.dahi_phrase_suggest_count_range, DahiPhraseSuggest.minCount())
+        rebuildTabs()
+        bodyBox?.removeAllViews()
+        when (mode) {
+            MODE_PENDING -> renderPending()
+            MODE_SAVED -> renderSaved()
+            else -> renderReview()
+        }
+    }
+
+    private fun rebuildTabs() {
+        val row = tabRow ?: return
+        val ctx = requireContext()
+        row.removeAllViews()
+        val pending = DahiPhraseSuggest.list().size
+        val saved = DahiPhraseStats.list().size
+        val due = DahiPhraseStats.summary().due
+        addTab(row, getString(R.string.dahi_phrase_suggest_tab_pending, pending), mode == MODE_PENDING) {
+            mode = MODE_PENDING
+            rebuild()
+        }
+        addTab(row, getString(R.string.dahi_phrase_suggest_tab_saved, saved), mode == MODE_SAVED) {
+            mode = MODE_SAVED
+            rebuild()
+        }
+        addTab(row, getString(R.string.dahi_phrase_suggest_tab_review, due), mode == MODE_REVIEW) {
+            mode = MODE_REVIEW
+            startReview(dueOnly = true)
+        }
+    }
+
+    private fun addTab(
+        row: LinearLayout,
+        label: String,
+        active: Boolean,
+        onClick: () -> Unit,
+    ) {
+        val ctx = requireContext()
+        row.addView(
+            TextView(ctx).apply {
+                text = label
+                gravity = android.view.Gravity.CENTER
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setTextColor(if (active) android.graphics.Color.WHITE else android.graphics.Color.GRAY)
+                background =
+                    android.graphics.drawable.GradientDrawable().apply {
+                        cornerRadius = ctx.dp(14).toFloat()
+                        setColor(if (active) 0xFF3B82F6.toInt() else 0x22808080)
+                    }
+                setPadding(ctx.dp(12), ctx.dp(7), ctx.dp(12), ctx.dp(7))
+                isClickable = true
+                setOnClickListener { onClick() }
+                layoutParams =
+                    LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ).apply { rightMargin = ctx.dp(8) }
+            },
+        )
+    }
+
+    // ---------------------------------------------------------------- ① 待存为短语
+
+    private fun renderPending() {
+        val ctx = requireContext()
+        val box = bodyBox ?: return
+        val items = DahiPhraseSuggest.list()
+
+        if (items.isEmpty()) {
+            box.addView(
+                TextView(ctx).apply {
+                    setText(R.string.dahi_phrase_suggest_empty)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                    setPadding(0, dp(16), 0, 0)
+                },
+            )
+        } else {
+            box.addView(termHint())
+            box.addView(sortRow())
+            box.addView(bulkRow(items.size))
+            box.addView(jumpRow())
+            items.forEach { item -> box.addView(pendingRow(item.text, item.count, item.saving, items.size)) }
+        }
+        box.addView(ignoredArea())
+    }
+
+    /** 术语说明：把「逐字输入」「短语调出」讲清楚，避免歧义。 */
+    private fun termHint(): TextView = TextView(requireContext()).apply {
+        setText(R.string.dahi_phrase_suggest_term_tip)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+        setLineSpacing(dp(2).toFloat(), 1f)
+        setPadding(0, dp(2), 0, dp(2))
+    }
+
+    private fun bulkRow(total: Int): View {
+        val ctx = requireContext()
+        return LinearLayout(ctx).apply {
+            orientation = LinearLayout.HORIZONTAL
+            addView(
+                bulkButton(
+                    getString(
+                        if (total > 0 && picked.size >= total) {
+                            R.string.dahi_health_unselect_all
+                        } else {
+                            R.string.dahi_phrase_suggest_select_all
+                        },
+                    ),
+                ) {
+                    val all = DahiPhraseSuggest.list().map { it.text }
+                    if (picked.size >= all.size && all.isNotEmpty()) picked.clear() else picked.addAll(all)
+                    rebuild()
+                },
+            )
+            addView(
+                bulkButton(getString(R.string.dahi_phrase_suggest_bulk_ignore, picked.size)) {
+                    confirmBulkIgnore()
+                }.apply { isEnabled = picked.isNotEmpty() },
+            )
+            addView(
+                bulkButton(getString(R.string.dahi_phrase_suggest_bulk_copy, picked.size)) {
+                    copyPicked()
+                }.apply { isEnabled = picked.isNotEmpty() },
+            )
+        }
+    }
+
+    /**
+     * 批量忽略要**二次确认**。
+     *
+     * 忽略是「从列表里消失」这种不可见的后果 —— 列表长的时候用户很容易连点，
+     * 而且条目一旦忽略就要翻到最底下的「已忽略」才能找回。所以按钮只负责确认，
+     * 真正执行放在对话框的「确定」里，并给一条 Toast 回执。
+     */
+    private fun confirmBulkIgnore() {
+        val ctx = requireContext()
+        val n = picked.size
+        if (n <= 0) return
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(getString(R.string.dahi_phrase_suggest_bulk_ignore, n))
+            .setMessage(getString(R.string.dahi_phrase_suggest_bulk_ignore_confirm, n))
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                picked.forEach { DahiPhraseSuggest.ignore(it) }
+                picked.clear()
+                Toast.makeText(ctx, getString(R.string.dahi_phrase_suggest_bulk_ignored, n), Toast.LENGTH_SHORT).show()
+                rebuild()
+            }.show()
+    }
+
+    /**
+     * 「已忽略 N 条 ↓ 点此跳到底部」。
+     *
+     * 列表几百条时，「已忽略」区在最末尾，要滑很多屏才看得到 —— 这里给一个直达入口。
+     */
+    private fun jumpRow(): View {
+        val ctx = requireContext()
+        val count = DahiPhraseSuggest.ignoredList().size
+        return TextView(ctx).apply {
+            text =
+                if (count > 0) {
+                    getString(R.string.dahi_phrase_suggest_jump_ignored, count)
+                } else {
+                    ""
+                }
+            visibility = if (count > 0) View.VISIBLE else View.GONE
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+            setTextColor(dahiAccent())
+            setPadding(0, 0, 0, dp(4))
+            isClickable = true
+            setOnClickListener { scrollToIgnored() }
+        }
+    }
+
+    private fun scrollToIgnored() {
+        val target = ignoredAnchor ?: return
+        val sv = scroll ?: return
+        sv.post {
+            // target.top 是相对 bodyBox 的，还要加上 bodyBox 自己在 column 里的偏移
+            val bodyTop = (target.parent as? View)?.top ?: 0
+            runCatching { sv.smoothScrollTo(0, (bodyTop + target.top).coerceAtLeast(0)) }
+        }
+    }
+
+    private fun scrollToTop() {
+        val sv = scroll ?: return
+        sv.post { runCatching { sv.smoothScrollTo(0, 0) } }
+    }
