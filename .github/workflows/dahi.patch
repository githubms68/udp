+
+    /** 「画心」模式下画满一颗之后，第二颗心怎么处理： */
+    enum class HeartCycle(
+        val key: String,
+        val labelRes: Int,
+    ) {
+        /** 新字落到同一位置时先清掉旧字（看得最清楚，默认）。 */
+        REPLACE("replace", R.string.dahi_ke_heart_replace),
+
+        /** 直接叠上去（旧字被压住）。 */
+        OVERLAY("overlay", R.string.dahi_ke_heart_overlay),
+
+        /** 画满一颗立即清空，从头再画。 */
+        CLEAR("clear", R.string.dahi_ke_heart_clear),
+    }
+
+    /** 画心大小（80~150%，默认 100）。心本身还会受键盘高度/屏宽自动约束。 */
+    var heartScale: Int
+        get() = runCatching { prefs().getInt(KEY_HEART_SCALE, 100) }.getOrDefault(100).coerceIn(80, 150)
+        set(value) = prefs().edit { putInt(KEY_HEART_SCALE, value.coerceIn(80, 150)) }
+
+    /** 画满一颗之后怎么画第二颗。 */
+    var heartCycle: HeartCycle
+        get() {
+            val raw = runCatching { prefs().getString(KEY_HEART_CYCLE, "") }.getOrNull()
+            return HeartCycle.entries.firstOrNull { it.key == raw } ?: HeartCycle.REPLACE
+        }
+        set(value) = prefs().edit { putString(KEY_HEART_CYCLE, value.key) }
+
+    /** 落到底部那行字的字号（sp，12~30，默认 17）。 */
+    var glyphTextSize: Int
+        get() = runCatching { prefs().getInt(KEY_GLYPH_TEXT_SIZE, 17) }.getOrDefault(17).coerceIn(12, 30)
+        set(value) = prefs().edit { putInt(KEY_GLYPH_TEXT_SIZE, value.coerceIn(12, 30)) }
+
+    /** 每行放几个字（4~16，默认 12）；超过就换到上面一行，最多两行。 */
+    var glyphPerLine: Int
+        get() = runCatching { prefs().getInt(KEY_GLYPH_PER_LINE, 12) }.getOrDefault(12).coerceIn(4, 16)
+        set(value) = prefs().edit { putInt(KEY_GLYPH_PER_LINE, value.coerceIn(4, 16)) }
+
+    /** 底部那行字的对齐方式。 */
+    var glyphAlign: GlyphAlign
+        get() {
+            val raw = runCatching { prefs().getString(KEY_GLYPH_ALIGN, "") }.getOrNull()
+            return GlyphAlign.entries.firstOrNull { it.key == raw } ?: GlyphAlign.CENTER
+        }
+        set(value) = prefs().edit { putString(KEY_GLYPH_ALIGN, value.key) }
+
+    /** 潮汐形态。 */
+    var tideStyle: TideStyle
+        get() {
+            val raw = runCatching { prefs().getString(KEY_TIDE_STYLE, "") }.getOrNull()
+            return TideStyle.entries.firstOrNull { it.key == raw } ?: TideStyle.SOFT
+        }
+        set(value) = prefs().edit { putString(KEY_TIDE_STYLE, value.key) }
+
+    /**
+     * 隐藏空格键上的文字（主题自定义文字，或 label 为空时自动显示的方案名）。
+     *
+     * 为什么放在这里：段落小结落在键盘底部那一带，空格键上如果有字，两串字会叠在一起。
+     * 默认关 —— 只有确实觉得互相干扰的人才需要打开。
+     */
+    var hideSpaceLabel: Boolean
+        get() = runCatching { prefs().getBoolean(KEY_HIDE_SPACE_LABEL, false) }.getOrDefault(false)
+        set(value) = prefs().edit { putBoolean(KEY_HIDE_SPACE_LABEL, value) }
+
+    var summary: Boolean
+        get() = runCatching { prefs().getBoolean(KEY_SUMMARY, true) }.getOrDefault(true)
+        set(value) = prefs().edit { putBoolean(KEY_SUMMARY, value) }
+
+    /** 音效总开关（默认关）。 */
+    var soundEnabled: Boolean
+        get() = runCatching { prefs().getBoolean(KEY_SOUND_ENABLED, false) }.getOrDefault(false)
+        set(value) = prefs().edit { putBoolean(KEY_SOUND_ENABLED, value) }
+
+    var soundStyle: SoundStyle
+        get() {
+            val raw = runCatching { prefs().getString(KEY_SOUND_STYLE, "") }.getOrNull()
+            return SoundStyle.entries.firstOrNull { it.key == raw } ?: SoundStyle.BLUE
+        }
+        set(value) = prefs().edit { putString(KEY_SOUND_STYLE, value.key) }
+
+    // ---------------------------------------------------------------- 一键开关
+
+    /** 视觉相关的开关是否都开着（不含音效）—— 用来显示「一键开关」的状态。 */
+    fun isAllOn(): Boolean = enabled && windTrail && speedRing && tide && summary && collect
+
+    /**
+     * 一键全关：动效、速度可视化、落字成句、音效**全部关掉**。
+     * 用在不适合有动静的场合 —— 一次点掉，不用一个个找。
+     */
+    fun setAllOff() {
+        enabled = false
+        windTrail = false
+        speedRing = false
+        tide = false
+        summary = false
+        collect = false
+        soundEnabled = false
+    }
+
+    /**
+     * 一键全开：把视觉相关的开关全部打开，但**不动音效**。
+     * 很多人只想要动效、不想要声音，所以音效必须自己手动打开。
+     */
+    fun setAllOn() {
+        enabled = true
+        windTrail = true
+        speedRing = true
+        tide = true
+        summary = true
+        collect = true
+    }
+
+    /** 0~100。 */
+    var soundVolume: Int
+        get() = runCatching { prefs().getInt(KEY_SOUND_VOLUME, 40) }.getOrDefault(40).coerceIn(0, 100)
+        set(value) = prefs().edit { putInt(KEY_SOUND_VOLUME, value.coerceIn(0, 100)) }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyPalette.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyPalette.kt
new file mode 100644
index 0000000..cf172ed
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyPalette.kt
@@ -0,0 +1,109 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.graphics.Color
+import com.osfans.trime.R
+import com.osfans.trime.data.theme.ColorManager
+
+/**
+ * 大海版「指尖生花」的配色。
+ *
+ * 动效不是单色系：每种效果会从三个角色里取色 ——
+ *  · primary  主体（涟漪外环、水花、潮汐、速度环、残影、飞字）
+ *  · secondary 辅色（涟漪内环、星尘的另一半）
+ *  · glow     高光（水花亮珠、潮汐浪尖）
+ *  · ink      墨色（墨飞专用，由主色自动压暗得到，永远比主体深）
+ *
+ * 配色来源三选一：
+ *  1. 跟随主题：取当前主题的 `candidate_text_color`，辅色/高光由它自动派生；
+ *  2. 8 套预设：每套三个颜色已经配好，切换即变；
+ *  3. 自定义：用户只挑**一个**主色，辅色与高光按色相 +18°、亮度 +12%/+50% 自动派生，
+ *     保证不会出现两个颜色打架（不用让用户配三个色）。
+ */
+object DahiKeyPalette {
+    data class Colors(
+        val primary: Int,
+        val secondary: Int,
+        val glow: Int,
+        val ink: Int,
+    )
+
+    enum class Preset(
+        val key: String,
+        val labelRes: Int,
+        val primary: Int,
+        val secondary: Int,
+        val glow: Int,
+    ) {
+        SEA("sea", R.string.dahi_ke_palette_sea, 0xFF4FC3F7.toInt(), 0xFF81D4FA.toInt(), 0xFFE1F5FE.toInt()),
+        PEACH("peach", R.string.dahi_ke_palette_peach, 0xFFFF8A65.toInt(), 0xFFFFB74D.toInt(), 0xFFFFE0B2.toInt()),
+        JADE("jade", R.string.dahi_ke_palette_jade, 0xFF4DB6AC.toInt(), 0xFF80CBC4.toInt(), 0xFFE0F2F1.toInt()),
+        GOLD("gold", R.string.dahi_ke_palette_gold, 0xFFFFCA28.toInt(), 0xFFFFD54F.toInt(), 0xFFFFF8E1.toInt()),
+        INK("ink", R.string.dahi_ke_palette_ink, 0xFF37474F.toInt(), 0xFF546E7A.toInt(), 0xFFB0BEC5.toInt()),
+        DUSK("dusk", R.string.dahi_ke_palette_dusk, 0xFFB39DDB.toInt(), 0xFFCE93D8.toInt(), 0xFFEDE7F6.toInt()),
+        SAKURA("sakura", R.string.dahi_ke_palette_sakura, 0xFFF48FB1.toInt(), 0xFFFFCDD2.toInt(), 0xFFFCE4EC.toInt()),
+        PINE("pine", R.string.dahi_ke_palette_pine, 0xFF66BB6A.toInt(), 0xFFA5D6A7.toInt(), 0xFFE8F5E9.toInt()),
+    }
+
+    /** 跟随主题。 */
+    const val KEY_THEME = "theme"
+
+    /** 自定义主色。 */
+    const val KEY_CUSTOM = "custom"
+
+    private const val DEFAULT_PRIMARY = 0xFF4FC3F7.toInt()
+
+    /** 解析当前配色（每帧调用一次，ColorManager 自己有缓存，开销可忽略）。 */
+    fun resolve(): Colors {
+        val key = DahiKeyEffectsConfig.paletteKey
+        return when {
+            key == KEY_THEME -> {
+                val base =
+                    runCatching { ColorManager.getColor("candidate_text_color") }
+                        .getOrElse { DEFAULT_PRIMARY }
+                fromBase(base)
+            }
+
+            key == KEY_CUSTOM -> {
+                val base = DahiKeyEffectsConfig.customColor
+                fromBase(if (base == 0) DEFAULT_PRIMARY else base)
+            }
+
+            else -> {
+                val preset = Preset.entries.firstOrNull { it.key == key } ?: Preset.SEA
+                Colors(
+                    primary = preset.primary,
+                    secondary = preset.secondary,
+                    glow = preset.glow,
+                    ink = derive(preset.primary, 0f, -0.55f),
+                )
+            }
+        }
+    }
+
+    /** 从单个主色派生整套（跟随主题 / 自定义都走这里）。 */
+    private fun fromBase(base: Int): Colors = Colors(
+        primary = base,
+        secondary = derive(base, 18f, 0.12f),
+        glow = derive(base, 0f, 0.5f),
+        ink = derive(base, 0f, -0.55f),
+    )
+
+    /** HSV 里改色相与亮度；饱和度保持，保证派生色和主色是一家人。 */
+    private fun derive(
+        base: Int,
+        hueShift: Float,
+        brightnessScale: Float,
+    ): Int {
+        val hsv = FloatArray(3)
+        Color.colorToHSV(base, hsv)
+        hsv[0] = ((hsv[0] + hueShift) % 360f + 360f) % 360f
+        hsv[2] = (hsv[2] * (1f + brightnessScale)).coerceIn(0.05f, 1f)
+        return Color.HSVToColor(hsv)
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyPreviewView.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyPreviewView.kt
new file mode 100644
index 0000000..f3e6744
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiKeyPreviewView.kt
@@ -0,0 +1,412 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.Shader
+import android.os.SystemClock
+import android.util.AttributeSet
+import android.view.View
+import com.osfans.trime.data.theme.ColorManager
+import com.osfans.trime.data.theme.ThemeManager
+
+/**
+ * 「样式编辑」实时预览（自绘）。
+ *
+ * 直接读取当前主题（**已含样式覆盖**）的颜色与尺寸，画出一段迷你键盘：
+ * 顶部候选栏（预编辑 / 首选高亮 / 普通候选 + 序号 / 注释 / 分割线）、
+ * 中部按键行（含按下态、边框、阴影、上标符号）、上方气泡（普通 + 高亮）。
+ *
+ * 布局采用**按带宽测算的流式排布**（不再用固定百分比坐标）：
+ * - 每个候选词按实际文字宽度依次向右排，放不下就停止，因此**不会互相重叠**；
+ * - 预编辑文字与注释各占一侧，并做了宽度截断；
+ * - 气泡只在上方确有空间时才画，且始终避开候选栏；
+ * - 按键高度 / 文字字号 / 符号字号全部跟随尺寸设置，滑动即可见变化。
+ *
+ * 样例背景用固定的装饰渐变，便于直观看出「按键是否透出背景」。
+ */
+class DahiKeyPreviewView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+    private val density = resources.displayMetrics.density
+    private val scaledDensity = resources.displayMetrics.scaledDensity
+
+    private val bgPaint = Paint()
+    private val keyPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val borderPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+        }
+    private val textPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.CENTER
+        }
+    private val candPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val candTextPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.LEFT
+        }
+    private val candCommentPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.RIGHT
+        }
+    private val candLabelPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.LEFT
+        }
+    private val preeditPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.LEFT
+        }
+    private val shadowPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val symbolPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.LEFT
+        }
+    private val popupTextPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.CENTER
+        }
+
+    private fun color(
+        key: String,
+        default: Int,
+    ): Int = runCatching { ColorManager.getColor(key) }.getOrDefault(default)
+
+    private var bgCache: Bitmap? = null
+    private var bgCacheAt = 0L
+    private val bgImagePaint = Paint(Paint.FILTER_BITMAP_FLAG)
+
+    /** 真实键盘背景（已含裁剪 / 模糊）。1.5 秒内复用缓存，避免每帧重新解码。 */
+    private fun loadBackgroundBitmap(): Bitmap? {
+        val now = SystemClock.elapsedRealtime()
+        if (now - bgCacheAt < 1500L) return bgCache
+        bgCacheAt = now
+        bgCache = runCatching { DahiKeyboardBackground.effectiveKeyboardBitmap() }.getOrNull()
+        return bgCache
+    }
+
+    /** 按「居中铺满」绘制背景图，并套用设置里的背景透明度。 */
+    private fun drawBackgroundBitmap(
+        canvas: Canvas,
+        bitmap: Bitmap,
+        w: Float,
+        h: Float,
+    ) {
+        val bw = bitmap.width
+        val bh = bitmap.height
+        if (bw <= 0 || bh <= 0) return
+        val scale = maxOf(w / bw, h / bh)
+        val sw = (w / scale).toInt().coerceIn(1, bw)
+        val sh = (h / scale).toInt().coerceIn(1, bh)
+        val left = (bw - sw) / 2
+        val top = (bh - sh) / 2
+        bgImagePaint.alpha = (DahiKeyboardBackground.opacityPercent() * 255 / 100).coerceIn(0, 255)
+        canvas.drawBitmap(bitmap, Rect(left, top, left + sw, top + sh), RectF(0f, 0f, w, h), bgImagePaint)
+    }
+
+    /** 垂直居中的基线。 */
+    private fun baselineOf(
+        paint: Paint,
+        centerY: Float,
+    ): Float = centerY - (paint.descent() + paint.ascent()) / 2f
+
+    /** 把 [text] 截断到 [maxWidth] 以内（超出部分用省略号），避免与其他内容重叠。 */
+    private fun fitText(
+        paint: Paint,
+        text: String,
+        maxWidth: Float,
+    ): String {
+        if (text.isEmpty() || maxWidth <= 0f) return ""
+        if (paint.measureText(text) <= maxWidth) return text
+        var end = text.length - 1
+        while (end > 0 && paint.measureText(text, 0, end) > maxWidth) end--
+        return if (end <= 1) "" else text.substring(0, end - 1) + "…"
+    }
+
+    private class CandItem(
+        val label: String,
+        val text: String,
+        val highlighted: Boolean,
+    )
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        val w = width.toFloat()
+        val h = height.toFloat()
+        if (w <= 0f || h <= 0f) return
+
+        // 背景：若已启用「自定义键盘背景」，直接用真实背景图铺底 —— 这样样式页看到的就是
+        // 「半透明按键 + 你的背景图」的最终合成效果；否则用固定装饰渐变，便于看清按键透明度。
+        val bg = loadBackgroundBitmap()
+        if (bg != null) {
+            drawBackgroundBitmap(canvas, bg, w, h)
+        } else {
+            bgPaint.shader =
+                LinearGradient(
+                    0f,
+                    0f,
+                    w,
+                    h,
+                    intArrayOf(0xFF3A1C71.toInt(), 0xFFD76D77.toInt(), 0xFFFFAF7B.toInt()),
+                    null,
+                    Shader.TileMode.CLAMP,
+                )
+            canvas.drawRect(0f, 0f, w, h, bgPaint)
+        }
+
+        val style = ThemeManager.activeTheme.generalStyle
+        // 按键间距：不再夹在 2~8dp —— 夹住之后把「横向间距」调到 10 以上，预览毫无反应。
+        val gap = (style.horizontalGap.toFloat() * density).coerceIn(0f, 20f * density)
+        // 候选栏自己的两项：以前预览完全没读，所以「候选间距 / 候选内边距」调了不动。
+        val candSpacing = (style.candidateSpacing * density).coerceIn(0f, 30f * density)
+        val candPad = (style.candidatePadding * density).coerceIn(0f, 30f * density)
+        // 键盘左右内边距 = keyboardPadding 基础值 + 各自的 Left / Right
+        val kbPadL = ((style.keyboardPadding + style.keyboardPaddingLeft) * density).coerceIn(0f, 44f * density)
+        val kbPadR = ((style.keyboardPadding + style.keyboardPaddingRight) * density).coerceIn(0f, 44f * density)
+        // 按键文字的微调偏移
+        val textShiftX = style.keyTextOffsetX * density
+        val textShiftY = style.keyTextOffsetY * density
+        val round = style.roundCorner * density
+        val border = style.keyBorder * density
+        val shadow = style.shadowRadius * density
+        val edge = kbPadL
+        // 候选栏的左右内边距单独一套（candidatePadding），不与按键边距混用
+        val candEdge = candPad.coerceAtLeast(gap * 0.5f)
+        val innerW = (w - kbPadL - kbPadR).coerceAtLeast(1f)
+
+        // ---------- 垂直分带：候选栏 / 气泡 / **两行**按键，互不重叠 ----------
+        //
+        // 画两行而不是一行，是为了让「纵向间距（verticalGap）」也看得见 ——
+        // 只有一行时这个参数改了完全没有反馈。
+        val candH = (style.candidateViewHeight * density * 0.62f).coerceIn(h * 0.28f, h * 0.36f)
+        val rowGap = (style.verticalGap.toFloat() * density).coerceIn(density, 10f * density)
+        val bottom = h - gap * 0.6f
+        val popupWanted = if (style.popupHeight > 0) {
+            (style.popupHeight * density * 0.5f).coerceAtMost(h * 0.13f)
+        } else {
+            0f
+        }
+        val reserved = candH + gap * 2f + (if (popupWanted > 0f) popupWanted + gap * 1.5f else 0f)
+        val roomForKeys = (bottom - reserved).coerceAtLeast(h * 0.16f)
+        val rawKeyH = (style.keyHeight.takeIf { it > 0 }?.toFloat() ?: 44f) * density * 0.9f
+        // 单键高度上限 = 给两行 + 行间距留出空间后的结果；下限给一点点，保证再小也画得出来
+        val maxKeyH = ((roomForKeys - rowGap) / 2f).coerceAtLeast(h * 0.045f)
+        val keyH = rawKeyH.coerceIn(h * 0.045f, maxKeyH)
+        val keyTop = bottom - (keyH * 2f + rowGap)
+        val keyBottom = bottom
+
+        var popupH = 0f
+        var popupTop = 0f
+        if (popupWanted > 0f) {
+            val room = keyTop - gap * 1.5f - (candH + gap)
+            popupH = popupWanted.coerceAtMost(room.coerceAtLeast(0f))
+            if (popupH < h * 0.04f) popupH = 0f
+            if (popupH > 0f) popupTop = keyTop - gap * 1.5f - popupH
+        }
+
+        val candRound = style.candidateCornerRadius * density
+
+        // ---------- 1. 候选栏 ----------
+        candPaint.color = color("candidate_background", 0xCC000000.toInt())
+        canvas.drawRoundRect(0f, 0f, w, candH, candRound, candRound, candPaint)
+        val candBorder = style.candidateBorder.toFloat() * density
+        if (candBorder > 0f) {
+            borderPaint.strokeWidth = candBorder
+            borderPaint.color = color("key_border_color", Color.TRANSPARENT)
+            canvas.drawRoundRect(0f, 0f, w, candH, candRound, candRound, borderPaint)
+        }
+
+        // 1.1 预编辑行：左边预编辑文字，右边注释（各自截断，不会撞在一起）
+        val preTop = candH * 0.06f
+        // 注释区高度跟随「注释高度」；没设置过就用候选栏高度的三分之一
+        val preH =
+            if (style.commentHeight > 0) {
+                (style.commentHeight * density).coerceIn(candH * 0.18f, candH * 0.55f)
+            } else {
+                candH * 0.34f
+            }
+        candPaint.color = color("text_back_color", Color.TRANSPARENT)
+        canvas.drawRoundRect(
+            candEdge,
+            preTop,
+            w - candEdge,
+            preTop + preH,
+            candRound * 0.5f,
+            candRound * 0.5f,
+            candPaint,
+        )
+        val preCenterY = preTop + preH / 2f
+        val preTextY = baselineOf(preeditPaint, preCenterY)
+        preeditPaint.textSize = style.candidateTextSize * scaledDensity
+        preeditPaint.color = color("text_color", Color.WHITE)
+        candCommentPaint.textSize = (style.commentTextSize * scaledDensity).coerceAtLeast(1f)
+        candCommentPaint.color = color("comment_text_color", Color.LTGRAY)
+        val comment = "注释 symbol"
+        val commentMaxW = innerW * 0.40f
+        val shownComment = fitText(candCommentPaint, comment, commentMaxW)
+        val commentW = if (shownComment.isEmpty()) 0f else candCommentPaint.measureText(shownComment)
+        val preMaxW = innerW - gap * 2f - commentW - gap * 2f
+        val shownPreedit = fitText(preeditPaint, "ni'hao", preMaxW)
+        canvas.drawText(shownPreedit, candEdge * 1.2f, preTextY, preeditPaint)
+        if (shownComment.isNotEmpty()) {
+            canvas.drawText(shownComment, w - candEdge * 1.2f, baselineOf(candCommentPaint, preCenterY), candCommentPaint)
+        }
+
+        // 1.2 候选行：按文字实际宽度向右排布，放不下就停（不会重叠）
+        val rowTop = candH * 0.47f
+        val rowH = candH * 0.36f
+        val rowCenterY = rowTop + rowH / 2f
+        val rowTextY = baselineOf(candTextPaint, rowCenterY)
+        candTextPaint.textSize = style.candidateTextSize * scaledDensity
+        candLabelPaint.textSize = (style.candidateTextSize * 0.82f * scaledDensity).coerceAtLeast(1f)
+        val nText = color("candidate_text_color", Color.WHITE)
+        val items =
+            listOf(
+                CandItem("1", "你好", true),
+                CandItem("2", "世界", false),
+                CandItem("3", "键盘", false),
+                CandItem("4", "输入", false),
+            )
+        var cursor = candEdge * 1.1f
+        val limit = w - candEdge * 1.1f
+        items.forEach { item ->
+            val labelW = candLabelPaint.measureText(item.label)
+            candTextPaint.color = if (item.highlighted) color("hilited_candidate_text_color", Color.WHITE) else nText
+            val textW = candTextPaint.measureText(item.text)
+            // 候选词之间的间隔 = 序号→文字的内距 + 「候选间距」设置本身
+            val itemW = labelW + gap * 0.6f + textW + candSpacing.coerceAtLeast(gap * 0.5f) + gap * 0.5f
+            if (cursor + itemW > limit) return@forEach
+            if (item.highlighted) {
+                candPaint.color = color("hilited_candidate_back_color", Color.TRANSPARENT)
+                canvas.drawRoundRect(
+                    cursor - gap * 0.5f,
+                    rowTop,
+                    cursor + itemW - gap * 0.9f,
+                    rowTop + rowH,
+                    candRound * 0.4f,
+                    candRound * 0.4f,
+                    candPaint,
+                )
+            }
+            candLabelPaint.color =
+                if (item.highlighted) color("hilited_label_color", nText) else color("label_color", nText)
+            canvas.drawText(item.label, cursor, baselineOf(candLabelPaint, rowCenterY), candLabelPaint)
+            canvas.drawText(item.text, cursor + labelW + gap * 0.8f, rowTextY, candTextPaint)
+            cursor += itemW
+        }
+        // 分割线
+        borderPaint.strokeWidth = maxOf(1f, density * 0.5f)
+        borderPaint.color = color("candidate_separator_color", Color.TRANSPARENT)
+        canvas.drawLine(candEdge, candH - 1f, w - candEdge, candH - 1f, borderPaint)
+
+        // ---------- 2. 气泡（只在确有空间时画，且避开候选栏） ----------
+        val textColor = color("key_text_color", Color.WHITE)
+        val textColorHl = color("hilited_key_text_color", textColor)
+        val borderColor = color("key_border_color", Color.TRANSPARENT)
+        val backColor = color("key_back_color", 0x33000000)
+        val backColorHl = color("hilited_key_back_color", backColor)
+        val symbolColor = color("key_symbol_color", Color.LTGRAY)
+
+        val cols = 5
+        val unitW = ((innerW - gap * (cols - 1)) / cols).coerceAtLeast(1f)
+        val keyW = unitW
+        val pressedIndex = 2
+
+        if (popupH > 0f) {
+            val popupW =
+                (style.popupWidth * density * 0.7f)
+                    .coerceIn(keyW * 0.6f, keyW * 1.6f)
+                    .coerceAtMost((w - kbPadL - kbPadR - gap) / 2f)
+            val pressedCenterX = kbPadL + pressedIndex * (keyW + gap) + keyW / 2f
+            var popupLeft = pressedCenterX - popupW
+            popupLeft = popupLeft.coerceIn(kbPadL, (w - kbPadR - popupW * 2f - gap).coerceAtLeast(kbPadL))
+            val popupBack = color("popup_back_color", Color.DKGRAY)
+            val popupText = color("popup_text_color", Color.WHITE)
+            candPaint.color = popupBack
+            canvas.drawRoundRect(popupLeft, popupTop, popupLeft + popupW, popupTop + popupH, round, round, candPaint)
+            val hlLeft = popupLeft + popupW + gap
+            candPaint.color = color("hilited_popup_back_color", popupBack)
+            canvas.drawRoundRect(hlLeft, popupTop, hlLeft + popupW, popupTop + popupH, round, round, candPaint)
+            popupTextPaint.textSize = (style.popupTextSize * scaledDensity * 0.7f).coerceAtLeast(1f)
+            popupTextPaint.color = popupText
+            canvas.drawText(
+                "气",
+                popupLeft + popupW / 2f,
+                baselineOf(popupTextPaint, popupTop + popupH / 2f),
+                popupTextPaint,
+            )
+            popupTextPaint.color = color("hilited_popup_text_color", popupText)
+            canvas.drawText(
+                "亮",
+                hlLeft + popupW / 2f,
+                baselineOf(popupTextPaint, popupTop + popupH / 2f),
+                popupTextPaint,
+            )
+        }
+
+        // ---------- 3. 按键行 ----------
+        // 键盘底带（键盘底色，垫在按键下面）
+        candPaint.color = color("keyboard_back_color", Color.TRANSPARENT)
+        canvas.drawRoundRect(
+            0f,
+            keyTop - gap,
+            w,
+            keyBottom + gap,
+            candRound,
+            candRound,
+            candPaint,
+        )
+
+        textPaint.textSize = style.keyTextSize * scaledDensity
+        val labelSymbolSize = (style.symbolTextSize.takeIf { it > 0f } ?: (style.keyTextSize * 0.7f)) * scaledDensity
+        val labelRows = listOf(listOf("q", "w", "e", "r", "t"), listOf("a", "s", "d", "f", "g"))
+        val symbolRows = listOf(listOf("1", "2", "3", "4", "5"), listOf("!", "@", "#", "$", "%"))
+        for ((row, labels) in labelRows.withIndex()) {
+            val symbols = symbolRows[row]
+            val rowTop = keyTop + row * (keyH + rowGap)
+            for (i in 0 until cols) {
+                val left = kbPadL + i * (keyW + gap)
+                val right = left + keyW
+                val top = rowTop
+                val bottomOfKey = top + keyH
+                val pressed = row == 0 && i == pressedIndex
+                if (shadow > 0f) {
+                    shadowPaint.color = color("shadow_color", 0x66000000)
+                    canvas.drawRoundRect(left, top + shadow, right, bottomOfKey + shadow, round, round, shadowPaint)
+                }
+                keyPaint.color = if (pressed) backColorHl else backColor
+                canvas.drawRoundRect(left, top, right, bottomOfKey, round, round, keyPaint)
+                if (border > 0f) {
+                    borderPaint.strokeWidth = border
+                    borderPaint.color = borderColor
+                    canvas.drawRoundRect(left, top, right, bottomOfKey, round, round, borderPaint)
+                }
+                textPaint.color = if (pressed) textColorHl else textColor
+                canvas.drawText(
+                    labels[i],
+                    left + keyW / 2f + textShiftX,
+                    baselineOf(textPaint, top + keyH / 2f) + textShiftY,
+                    textPaint,
+                )
+                // 上标符号（符号 / 提示字号）
+                symbolPaint.textSize = labelSymbolSize.coerceAtLeast(1f)
+                symbolPaint.color = symbolColor
+                canvas.drawText(symbols[i], left + density * 3f, top + labelSymbolSize, symbolPaint)
+            }
+        }
+    }
+}
