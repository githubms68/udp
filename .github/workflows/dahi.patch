@@ -0,0 +1,1370 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.os.SystemClock
+import android.util.AttributeSet
+import android.view.KeyEvent
+import android.view.View
+import com.osfans.trime.R
+import kotlin.math.ceil
+import kotlin.math.cos
+import kotlin.math.min
+import kotlin.math.sin
+import kotlin.random.Random
+
+/**
+ * 大海版「指尖生花」：按键动效 / 速度可视化层。
+ *
+ * 一条盖在键盘之上的**透明** View（不消费触摸，事件自动穿透到下面的按键），
+ * 统一绘制所有效果。刻意不在每个按键上挂动画：
+ *  · 逐键建 View / 逐键 invalidate 在低端机上直接掉帧；
+ *  · 统一一层还能共用一套速度统计与配色。
+ *
+ * 包含：
+ *  · 按键动效（8 种）：水花 / 涟漪 / 星尘 / 墨飞 / 萤火 / 花瓣 / 碎钻 / 声波
+ *  · 落字成句：上屏的每个汉字从**它自己的键位**飞向键盘底部，连成一句（独立开关）
+ *  · 速度可视化：潮汐（键盘下沿，4 种形态，一律从左往右流）、疾风残影、段落小结
+ *  · 速度环不在这里画 —— 它挂在预编辑行里（[DahiSpeedRingView]），永远接在编码右侧
+ *
+ * 配色不是单色：每种效果按 [DahiKeyPalette.Colors] 的 primary / secondary / glow 取色，
+ * 水墨单独用 ink。静止时不重绘（[needsFrames] 为 false 就不 postInvalidate）。
+ */
+class DahiKeyEffectOverlay @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+    private val density = resources.displayMetrics.density
+
+    private fun dp(value: Float): Float = value * density
+
+    private val stroke =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+        }
+
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    private val textPaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textAlign = Paint.Align.CENTER
+            isSubpixelText = true
+        }
+
+    /**
+     * 粒子：ring=涟漪环，drop=水花，star=星尘，ink=墨点，firefly=萤火，
+     * petal=花瓣（画成旋转的扁圆），spark=碎钻（十字星芒）。
+     * color 在生成时就定好（多色不靠绘制时算）。
+     */
+    private class Particle(
+        val kind: Int,
+        var x: Float,
+        var y: Float,
+        var vx: Float,
+        var vy: Float,
+        val size: Float,
+        val color: Int,
+        val born: Long,
+        val maxLife: Long,
+        val spin: Float = 0f,
+    )
+
+    /** 疾风残影：按下时那颗键的矩形。 */
+    private class Trail(
+        val rect: RectF,
+        val born: Long,
+    )
+
+    /** 落字成句：一个正在从键位飞向底部的字。 */
+    private class Glyph(
+        val ch: String,
+        val fromX: Float,
+        val fromY: Float,
+        val tx: Float,
+        val ty: Float,
+        val color: Int,
+        val startAt: Long,
+    )
+
+    /** 已经落到底部句子里的字。 */
+    private class Landed(
+        val ch: String,
+        val x: Float,
+        val y: Float,
+        val color: Int,
+    )
+
+    /** 一次按键（编码键 / 数字选字键）的位置：落字成句据此决定每个字从哪个键起飞。 */
+    private class KeyHit(
+        val code: Int,
+        val x: Float,
+        val y: Float,
+    )
+
+    private val particles = ArrayList<Particle>(72)
+    private val trails = ArrayList<Trail>(6)
+    private val glyphs = ArrayList<Glyph>(8)
+    private val landed = ArrayList<Landed>(24)
+
+    /** 句子落定后的淡出起点（0 = 当前没有句子）。 */
+    private var lineFadeAt = 0L
+
+    /** 当前句子里下一个空位（跨多次上屏累计，上限 = 每行字数 × 行数）。 */
+    private var slot = 0
+
+    /** 「画心」模式的数据：X 就是一个字的落点（6 行 × 7 列 = 24 字一颗心）。 */
+    private val heartGrid =
+        arrayOf(
+            " X   X ",
+            "XXX XXX",
+            "XXXXXXX",
+            " XXXXX ",
+            "  XXX  ",
+            "   X   ",
+        )
+
+    private val heartPoints: List<Pair<Int, Int>> by lazy {
+        val list = ArrayList<Pair<Int, Int>>(24)
+        heartGrid.forEachIndexed { row, line ->
+            line.forEachIndexed { col, c -> if (c == 'X') list.add(col to row) }
+        }
+        list
+    }
+
+    /**
+     * 「画心」的字距与字号：取「用户设的字号」与「键盘装得下」两者的较小值，
+     * 再乘「画心大小」（80%~150%）。这样调大字号心会跟着大，但不会被键盘顶部裁掉。
+     */
+    private fun heartMetrics(): Pair<Float, Float> {
+        val cols = heartGrid[0].length
+        val rows = heartGrid.size
+        val scale = DahiKeyEffectsConfig.heartScale / 100f
+        val wanted = dp(DahiKeyEffectsConfig.glyphTextSize.toFloat()) * GLYPH_ADVANCE_RATIO * scale
+        // 上限放宽到「屏宽 88% / 键盘高 78%」：以前按 52% 卡，心永远到不了顶，
+        // 滑块怎么拖都被同一个上限吃掉，看起来完全没反应。
+        val maxAdvByWidth = (width * 0.88f) / cols
+        val maxAdvByHeight = (height * 0.78f) / rows
+        val adv = wanted.coerceAtMost(min(maxAdvByWidth, maxAdvByHeight)).coerceAtLeast(dp(6f))
+        return adv to (adv / GLYPH_ADVANCE_RATIO)
+    }
+
+    /** 已经画满几颗心（句子清空时归零）。 */
+    private var heartCount = 0
+
+    /** ❤ 提示显示到什么时候。 */
+    private var heartHintUntil = 0L
+
+    /** 本轮输入按过的编码键（字母 / 数字），上屏时清空。 */
+    private val keyTrail = ArrayDeque<KeyHit>()
+
+    private var lastKeyAt = 0L
+    private var lastKeyX = 0f
+    private var lastKeyY = 0f
+
+    private var tidePhase = 0f
+    private var lastFrameAt = 0L
+
+    private var paraChars = 0
+    private var paraStartAt = 0L
+    private var paraLastCommitAt = 0L
+
+    /** 本段落真正在打字的时间（不含停顿）。 */
+    private var paraActiveMs = 0L
+    private var summaryText = ""
+    private var summaryUntil = 0L
+
+    private val tidePath = Path()
+    private val tideCrest = Path()
+    private val tmpInts = IntArray(2)
+    private val tmpInts2 = IntArray(2)
+
+    private val summaryCheck =
+        Runnable {
+            maybeShowSummary()
+        }
+
+    /** 固定引用：detach 时要判断「总线上的回调还是不是我」。 */
+    private val keyDownHandler: (View, Int) -> Unit = { view, code -> onKeyDown(view, code) }
+    private val commitHandler: (String) -> Unit = { text -> onCommit(text) }
+
+    /** 挂上事件总线。 */
+    fun attach() {
+        DahiKeyEffectBus.onKeyDown = keyDownHandler
+        DahiKeyEffectBus.onCommit = commitHandler
+        DahiKeySound.ensure()
+    }
+
+    fun detach() {
+        // 只摘掉**自己**注册的那份。
+        // InputView 重建（切主题 / 改设置）时，新视图的 attach 先跑、旧视图的 detach 后跑；
+        // 以前这里无条件置空，等于把新实例刚注册的回调一起抹掉 —— 现象就是
+        // 「刚装上能动，切一次主题之后所有按键动效全没了，只剩一帧残留的潮汐」。
+        if (DahiKeyEffectBus.onKeyDown === keyDownHandler) DahiKeyEffectBus.onKeyDown = null
+        if (DahiKeyEffectBus.onCommit === commitHandler) DahiKeyEffectBus.onCommit = null
+        removeCallbacks(summaryCheck)
+        particles.clear()
+        trails.clear()
+        clearSentence()
+        keyTrail.clear()
+        lastFrameAt = 0L
+    }
+
+    /**
+     * 跟着窗口走：InputView 被重新挂到窗口（切主题、改样式）时重新注册。
+     * 配合 [detach] 里的「只摘自己」，无论新旧视图的 attach/detach 谁先谁后都不会丢事件。
+     */
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        attach()
+    }
+
+    override fun onDetachedFromWindow() {
+        detach()
+        super.onDetachedFromWindow()
+    }
+
+    private fun invalidateAnim() {
+        if (isAttachedToWindow) postInvalidateOnAnimation()
+    }
+
+    // ---------------------------------------------------------------- 事件
+
+    private fun onKeyDown(
+        view: View,
+        keyCode: Int,
+    ) {
+        val now = SystemClock.uptimeMillis()
+        val gap = if (lastKeyAt > 0L) now - lastKeyAt else 0L
+        locateCenter(view)?.let { (cx, cy) ->
+            lastKeyX = cx
+            lastKeyY = cy
+        }
+        // 速度只统计「打字键」：字符键、数字键、空格。
+        // 退格/方向/回车不算 —— 长按退格清屏时每秒能刷出 20 次，会被算成上千字/分（明显失真）。
+        if (isRhythmKey(keyCode)) DahiSpeedMeter.record(now)
+        // 段落小结的分母：只累加「真正在打字」的时间（相邻间隔 > MAX_GAP 视为停顿，不计）
+        if (paraStartAt == 0L) paraStartAt = now
+        if (gap in 1..DahiSpeedMeter.MAX_GAP_MS) paraActiveMs += gap
+        lastKeyAt = now
+        // 字母 / 数字键才是「编码键」：空格、退格、回车不进轨迹，
+        // 否则空格上屏时最后一个"键"永远是空格，字就只能从底部原地掉 —— 这就是以前那句
+        // 「只有从空格飞到底部」的根因。
+        if (isCodeKey(keyCode)) {
+            keyTrail.addLast(KeyHit(keyCode, lastKeyX, lastKeyY))
+            while (keyTrail.size > MAX_KEY_TRAIL) keyTrail.removeFirst()
+        }
+        scheduleSummaryCheck()
+        if (!DahiKeyEffectsConfig.enabled) {
+            invalidateAnim()
+            return
+        }
+        val palette = DahiKeyPalette.resolve()
+        val intensity = DahiKeyEffectsConfig.intensity
+        val mul = 0.6f + 0.4f * intensity
+        if (DahiKeyEffectsConfig.windTrail) {
+            keyRect(view)?.let { rect ->
+                trails.add(Trail(rect, now))
+                while (trails.size > 4) trails.removeAt(0)
+            }
+        }
+        when (DahiKeyEffectsConfig.style) {
+            DahiKeyEffectsConfig.Style.WATER -> spawnWater(lastKeyX, lastKeyY, mul, now, palette)
+            DahiKeyEffectsConfig.Style.RIPPLE -> spawnRipple(lastKeyX, lastKeyY, mul, now, palette)
+            DahiKeyEffectsConfig.Style.STAR -> spawnStar(lastKeyX, lastKeyY, mul, now, palette)
+            DahiKeyEffectsConfig.Style.INK -> spawnInk(lastKeyX, lastKeyY, mul, now, palette)
+            DahiKeyEffectsConfig.Style.FIREFLY -> spawnFirefly(lastKeyX, lastKeyY, mul, now, palette)
+            DahiKeyEffectsConfig.Style.PETAL -> spawnPetal(lastKeyX, lastKeyY, mul, now, palette)
+            DahiKeyEffectsConfig.Style.SPARK -> spawnSpark(lastKeyX, lastKeyY, mul, now, palette)
+            DahiKeyEffectsConfig.Style.ECHO -> spawnEcho(lastKeyX, lastKeyY, mul, now, palette)
+        }
+        invalidateAnim()
+    }
+
+    private fun onCommit(text: String) {
+        // 先把来源取走（取完即复位）：即使这条文本不落字，也不能让标记留到下一次上屏
+        val source = DahiKeyEffectBus.consumeSource()
+        if (text.isEmpty()) return
+        val now = SystemClock.uptimeMillis()
+        val hanzi = text.filter { isHanzi(it) }
+        if (hanzi.isEmpty()) return
+
+        // 本轮按键轨迹无论用不用得上都要清掉（否则下一句会拿到上一次的键位）
+        val hits = ArrayList(keyTrail)
+        keyTrail.clear()
+
+        // 段落小结：起点从"第一次按键"算，而不是"第一次上屏"算。
+        // 以前用上屏时刻当起点，第一段的组字时间被漏掉，算出来就虚高（几百字/分）；
+        // 反过来如果这一段一直凑不满 6 个字又停手，起点会一直挂在很久以前，
+        // 下次再打就会算成"每分钟几个字"。两个极端都是这个起点造成的。
+        if (paraStartAt == 0L) paraStartAt = now
+        if (paraLastCommitAt > 0L && now - paraLastCommitAt > PARA_BREAK_MS) {
+            paraStartAt = now
+            paraChars = 0
+            paraActiveMs = 0L
+        }
+        paraChars += hanzi.length
+        paraLastCommitAt = now
+
+        // 平均码长（字/分 = 键/分 ÷ 码长）：只有真有编码键时才计入，语音上屏不污染
+        DahiSpeedMeter.recordCommit(now, hanzi.length, hits.size)
+
+        // 落字成句只受自己的开关控制：「按键动效」关掉只是不要键盘上那些花，
+        // 「落字成句」是上屏那一刻的效果，各管各的（一键开关仍然会把它们一起关掉）
+        if (DahiKeyEffectsConfig.collect && collectAllowed(source, hits.isNotEmpty())) {
+            spawnGlyphs(hanzi, hits, now)
+        }
+        invalidateAnim()
+    }
+
+    /**
+     * 落字成句：把上屏的每个汉字从「它自己那一段编码的最后一码所在键」抛向键盘底部。
+     *
+     * 键位怎么定（这也是用户提的两条规则）：
+     *  · 编码键按字数**均分**：`dy` 打「道义」→ 道从 d、义从 y；`bmma` 打「编码」→ 编从 m、码从 a；
+     *  · 末尾若是数字键（按数字选字上屏），最后一个字就从那个数字键起飞，
+     *    前面的字用剩下的编码键均分。
+     * 空格 / 回车 / 退格从不进入轨迹，所以「按空格上屏」不会再让字从空格原地掉。
+     */
+    private fun spawnGlyphs(
+        text: String,
+        hits: List<KeyHit>,
+        now: Long,
+    ) {
+        if (text.isEmpty()) return
+        val cfg = DahiKeyEffectsConfig
+        val n = text.length
+        val heart = cfg.collectHeart
+
+        val metrics = if (heart) heartMetrics() else null
+        val size = metrics?.second ?: dp(cfg.glyphTextSize.toFloat())
+        val adv = metrics?.first ?: (size * GLYPH_ADVANCE_RATIO)
+        // 字号调大时每行能放的字会变少：按屏宽自动收紧，避免字跑出屏幕
+        val usable = width - dp(16f)
+        val perLine = min(cfg.glyphPerLine.coerceIn(4, 16), (usable / adv).toInt().coerceAtLeast(4))
+        val lineGap = size * GLYPH_LINE_GAP_RATIO
+        val capacity = if (cfg.collectHeart) heartPoints.size * HEART_MAX_HEARTS else perLine * GLYPH_MAX_LINES
+
+        // 只在写满时重新起句。句子还在显示时新字要**追加**进去 ——
+        // 否则连打时每上屏一次就把上一句清掉，又回到"底部永远只有一两个字"。
+        if (slot >= capacity) clearSentence()
+
+        // 起点规则：
+        //  · 有按键轨迹 → 每个字从"它自己那一段编码的最后一码所在的键"起飞；
+        //    编码键按字数均分（dy 打「道义」→ 道从 d、义从 y；bmma 打「编码」→ 编从 m、码从 a）；
+        //    末尾若是数字选字键，最后一个字就从那个数字键起飞。
+        //  · 没有按键轨迹（语音输入 / 剪贴板 / 长按上屏）→ 从键盘上部中央飘落，
+        //    效果同样在，但看得出"不是从某个键掉下来的"。
+        val hasDigitTail = hits.isNotEmpty() && isDigitKey(hits.last().code)
+        val core = if (hasDigitTail) hits.subList(0, hits.size - 1) else hits
+        val fromKeys = hits.isNotEmpty()
+
+        val lineWidth = perLine * adv
+        val anchorX =
+            when (cfg.glyphAlign) {
+                DahiKeyEffectsConfig.GlyphAlign.LEFT -> dp(8f) + adv / 2f
+                DahiKeyEffectsConfig.GlyphAlign.RIGHT -> width - dp(8f) - lineWidth + adv / 2f
+                else -> width / 2f - lineWidth / 2f + adv / 2f
+            }
+        val baseY = height - dp(GLYPH_BASE_DP)
+        val palette = DahiKeyPalette.resolve()
+
+        text.forEachIndexed { i, ch ->
+            val key =
+                when {
+                    !fromKeys -> null
+                    hasDigitTail && i == n - 1 -> hits.last()
+                    core.isNotEmpty() -> {
+                        // 第 i 个字对应「前 i+1 个字应占的编码数」里的最后一码
+                        val end = ceil((i + 1).toFloat() * core.size / n).toInt()
+                        core[(end - 1).coerceIn(0, core.size - 1)]
+                    }
+
+                    else -> null
+                }
+
+            val index = slot
+            slot++
+            val row = index / perLine
+            val col = index % perLine
+
+            // 起飞点
+            val fx: Float
+            val fy: Float
+            if (key != null) {
+                fx = key.x
+                fy = key.y
+            } else {
+                // 非按键上屏（语音 / 剪贴板）：从左 / 中 / 右三个区域的**最上方**飘落 ——
+                // 下落距离更长、方向更散，比"从键盘中部冒出来"存在感强得多
+                val lane = (i % 3) - 1
+                fx = width * (0.5f + lane * 0.31f) + (Random.nextFloat() - 0.5f) * dp(26f)
+                fy = dp(3f)
+            }
+
+            // 目标点：「画心」模式按心形点阵，普通模式按行列
+            val targetX: Float
+            val targetY: Float
+            if (heart) {
+                val point = heartPoints[index % heartPoints.size]
+                val cols = heartGrid[0].length
+                val heartLeft = width / 2f - cols * adv / 2f
+                targetX = heartLeft + point.first * adv + adv / 2f
+                targetY = baseY - (heartGrid.size - 1 - point.second) * lineGap
+            } else {
+                targetX = anchorX + col * adv
+                targetY = baseY - row * lineGap
+            }
+
+            glyphs.add(
+                Glyph(
+                    ch = ch.toString(),
+                    fromX = fx,
+                    fromY = fy,
+                    tx = targetX,
+                    ty = targetY,
+                    color = if (i % 2 == 0) palette.primary else palette.secondary,
+                    startAt = now + i * GLYPH_STAGGER_MS,
+                ),
+            )
+        }
+    }
+
+    /** 清掉「已落定的句子」，但保留还在飞的字（它们属于下一句）。 */
+    private fun retireSentence() {
+        landed.clear()
+        heartCount = 0
+        if (glyphs.isEmpty()) {
+            slot = 0
+            lineFadeAt = 0L
+        }
+    }
+
+    /** 彻底清空（切换视图 / 句子写满）。 */
+
+    /**
+     * 「落字成句」按上屏来源分别放行：
+     *  · 有编码键 → 打字，只看总开关；
+     *  · 语音 → [DahiKeyEffectsConfig.collectVoice]；
+     *  · 剪贴板 / 其他非键盘上屏 → [DahiKeyEffectsConfig.collectClipboard]。
+     */
+    private fun collectAllowed(
+        source: DahiKeyEffectBus.Source,
+        fromKeys: Boolean,
+    ): Boolean = when {
+        fromKeys -> true
+        source == DahiKeyEffectBus.Source.VOICE -> DahiKeyEffectsConfig.collectVoice
+        else -> DahiKeyEffectsConfig.collectClipboard
+    }
+
+    private fun clearSentence() {
+        glyphs.clear()
+        landed.clear()
+        slot = 0
+        lineFadeAt = 0L
+    }
+
+    // ---------------------------------------------------------------- 粒子
+
+    private fun spawnRipple(
+        x: Float,
+        y: Float,
+        mul: Float,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        // 双环：外圈 primary、内圈 secondary，同一手感里出现两层颜色
+        particles.add(
+            Particle(
+                kind = KIND_RING,
+                x = x,
+                y = y,
+                vx = 0f,
+                vy = 0f,
+                size = dp(20f) * mul,
+                color = palette.primary,
+                born = now,
+                maxLife = (380f + 90f * mul).toLong(),
+            ),
+        )
+        particles.add(
+            Particle(
+                kind = KIND_RING,
+                x = x,
+                y = y,
+                vx = 0f,
+                vy = 0f,
+                size = dp(11f) * mul,
+                color = palette.secondary,
+                born = now,
+                maxLife = (300f + 70f * mul).toLong(),
+            ),
+        )
+    }
+
+    private fun spawnWater(
+        x: Float,
+        y: Float,
+        mul: Float,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        val count = (8 * mul).toInt().coerceIn(4, 16)
+        repeat(count) {
+            val color = if (Random.nextFloat() < 0.22f) palette.glow else palette.primary
+            particles.add(
+                Particle(
+                    kind = KIND_DROP,
+                    x = x + (Random.nextFloat() - 0.5f) * dp(16f),
+                    y = y + (Random.nextFloat() - 0.5f) * dp(6f),
+                    vx = (Random.nextFloat() - 0.5f) * dp(0.12f),
+                    vy = -dp(0.10f + Random.nextFloat() * 0.18f),
+                    size = dp(1.6f + Random.nextFloat() * 2.2f) * mul,
+                    color = color,
+                    born = now,
+                    maxLife = (420f + Random.nextFloat() * 220f).toLong(),
+                ),
+            )
+        }
+    }
+
+    private fun spawnStar(
+        x: Float,
+        y: Float,
+        mul: Float,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        val count = (6 * mul).toInt().coerceIn(3, 12)
+        repeat(count) {
+            val dice = Random.nextFloat()
+            val color =
+                when {
+                    dice < 0.25f -> palette.glow
+                    dice < 0.6f -> palette.secondary
+                    else -> palette.primary
+                }
+            particles.add(
+                Particle(
+                    kind = KIND_STAR,
+                    x = x + (Random.nextFloat() - 0.5f) * dp(22f),
+                    y = y + (Random.nextFloat() - 0.5f) * dp(10f),
+                    vx = (Random.nextFloat() - 0.5f) * dp(0.05f),
+                    vy = -dp(0.04f + Random.nextFloat() * 0.10f),
+                    size = dp(1.4f + Random.nextFloat() * 2.0f) * mul,
+                    color = color,
+                    born = now,
+                    maxLife = (620f + Random.nextFloat() * 320f).toLong(),
+                ),
+            )
+        }
+    }
+
+    private fun spawnInk(
+        x: Float,
+        y: Float,
+        mul: Float,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        val count = (3 * mul).toInt().coerceIn(2, 6)
+        repeat(count) {
+            // 水墨刻意用 ink（比主体深），墨飞才有墨的层次
+            particles.add(
+                Particle(
+                    kind = KIND_INK,
+                    x = x + (Random.nextFloat() - 0.5f) * dp(18f),
+                    y = y + (Random.nextFloat() - 0.5f) * dp(10f),
+                    vx = (Random.nextFloat() - 0.5f) * dp(0.05f),
+                    vy = (Random.nextFloat() - 0.5f) * dp(0.05f),
+                    size = dp(3f + Random.nextFloat() * 5f) * mul,
+                    color = palette.ink,
+                    born = now,
+                    maxLife = (520f + Random.nextFloat() * 260f).toLong(),
+                ),
+            )
+        }
+        trimParticles()
+    }
+
+    /** 萤火：几点光缓缓上浮、明灭，像夏夜的虫。 */
+    private fun spawnFirefly(
+        x: Float,
+        y: Float,
+        mul: Float,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        val count = (5 * mul).toInt().coerceIn(3, 9)
+        repeat(count) {
+            val color = if (Random.nextFloat() < 0.5f) palette.glow else palette.primary
+            particles.add(
+                Particle(
+                    kind = KIND_FIREFLY,
+                    x = x + (Random.nextFloat() - 0.5f) * dp(26f),
+                    y = y + (Random.nextFloat() - 0.5f) * dp(14f),
+                    vx = (Random.nextFloat() - 0.5f) * dp(0.02f),
+                    vy = -dp(0.02f + Random.nextFloat() * 0.035f),
+                    size = dp(1.3f + Random.nextFloat() * 1.6f) * mul,
+                    color = color,
+                    born = now,
+                    maxLife = (900f + Random.nextFloat() * 500f).toLong(),
+                    spin = 0.004f + Random.nextFloat() * 0.006f,
+                ),
+            )
+        }
+        trimParticles()
+    }
+
+    /** 花瓣：几片扁圆边转边飘，慢慢往下落。 */
+    private fun spawnPetal(
+        x: Float,
+        y: Float,
+        mul: Float,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        val count = (4 * mul).toInt().coerceIn(3, 7)
+        repeat(count) {
+            val color =
+                when (Random.nextInt(3)) {
+                    0 -> palette.secondary
+                    1 -> palette.glow
+                    else -> palette.primary
+                }
+            particles.add(
+                Particle(
+                    kind = KIND_PETAL,
+                    x = x + (Random.nextFloat() - 0.5f) * dp(18f),
+                    y = y + (Random.nextFloat() - 0.5f) * dp(10f),
+                    vx = (Random.nextFloat() - 0.5f) * dp(0.05f),
+                    vy = dp(0.008f + Random.nextFloat() * 0.016f),
+                    size = dp(2.4f + Random.nextFloat() * 2.4f) * mul,
+                    color = color,
+                    born = now,
+                    maxLife = (700f + Random.nextFloat() * 420f).toLong(),
+                    spin = (0.0016f + Random.nextFloat() * 0.0028f) * if (Random.nextBoolean()) 1f else -1f,
+                ),
+            )
+        }
+        trimParticles()
+    }
+
+    /** 碎钻：向四周溅开的十字星芒，一闪即隐。 */
+    private fun spawnSpark(
+        x: Float,
+        y: Float,
+        mul: Float,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        val count = (7 * mul).toInt().coerceIn(4, 12)
+        repeat(count) {
+            val angle = Random.nextFloat() * 6.2832f
+            val speed = dp(0.05f + Random.nextFloat() * 0.15f)
+            particles.add(
+                Particle(
+                    kind = KIND_SPARK,
+                    x = x,
+                    y = y,
+                    vx = waveCos(angle) * speed,
+                    vy = waveSin(angle) * speed,
+                    size = dp(2.6f + Random.nextFloat() * 3.4f) * mul,
+                    color = if (Random.nextFloat() < 0.4f) palette.glow else palette.primary,
+                    born = now,
+                    maxLife = (260f + Random.nextFloat() * 200f).toLong(),
+                    spin = angle,
+                ),
+            )
+        }
+        trimParticles()
+    }
+
+    /** 声波：三圈同心波快速扩散（按得越重、扩散越大）。 */
+    private fun spawnEcho(
+        x: Float,
+        y: Float,
+        mul: Float,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        val colors = intArrayOf(palette.primary, palette.secondary, palette.glow)
+        repeat(3) { i ->
+            particles.add(
+                Particle(
+                    kind = KIND_RING,
+                    x = x,
+                    y = y,
+                    vx = 0f,
+                    vy = 0f,
+                    size = dp(14f + 9f * i) * mul,
+                    color = colors[i],
+                    born = now + i * 55L,
+                    maxLife = (420f + 60f * i).toLong(),
+                ),
+            )
+        }
+    }
+
+    private fun trimParticles() {
+        while (particles.size > MAX_PARTICLES) particles.removeAt(0)
+    }
+
+    // ---------------------------------------------------------------- 绘制
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        val now = SystemClock.uptimeMillis()
+        val dt = if (lastFrameAt == 0L) 16f else (now - lastFrameAt).coerceIn(8L, 48L).toFloat()
+        lastFrameAt = now
+        val enabled = DahiKeyEffectsConfig.enabled
+        val palette = DahiKeyPalette.resolve()
+
+        // 关掉效果（或只关「落字成句」）时，把还在飞/还在显示的字清掉，
+        // 否则 needsFrames 会一直因为 landed 非空而重绘（白耗电），重开时还会冒出旧句子
+        if ((!enabled || !DahiKeyEffectsConfig.collect) && (glyphs.isNotEmpty() || landed.isNotEmpty())) {
+            clearSentence()
+        }
+
+        if (DahiKeyEffectsConfig.tide) drawTide(canvas, now, dt, palette)
+        if (enabled && DahiKeyEffectsConfig.windTrail) drawTrails(canvas, now, palette)
+        if (enabled) drawParticles(canvas, now, dt, palette)
+        if (DahiKeyEffectsConfig.collect) drawGlyphs(canvas, now, palette)
+        drawSummary(canvas, now, palette)
+
+        if (needsFrames(now, enabled)) {
+            postInvalidateOnAnimation()
+        } else {
+            lastFrameAt = 0L
+        }
+    }
+
+    private fun needsFrames(
+        now: Long,
+        enabled: Boolean,
+    ): Boolean {
+        if (enabled && particles.isNotEmpty()) return true
+        if (enabled && (glyphs.isNotEmpty() || landed.isNotEmpty())) return true
+        if (enabled && trails.any { now - it.born < TRAIL_LIFE_MS }) return true
+        if (now - lastKeyAt < 2600L) return true
+        if (now < summaryUntil) return true
+        return false
+    }
+
+    // -------- 潮汐：4 种形态，全部从左往右流
+
+    private fun drawTide(
+        canvas: Canvas,
+        now: Long,
+        dt: Float,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        val h = height.toFloat()
+        if (h <= 0f) return
+        val sens = DahiKeyEffectsConfig.tideSensitivity / 100f
+        // 潮汐用自己的速度映射：约 kpm 150 起明显，再乘用户可调的灵敏度（50~200%）
+        val speed = (DahiSpeedMeter.kpm(now) / 150f).coerceIn(0f, 2.4f) * sens
+        // 打完字后让水面慢慢落下来，别把"高浪"那一帧冻在屏幕上
+        val idle = ((now - lastKeyAt - 500L).coerceAtLeast(0L) / 2200f).coerceIn(0f, 1f)
+        val ampScale = 1f - idle * 0.8f
+        // 相位递增 + 波形里用 (x/λ - phase)：等相位点 x 随 phase 增大而右移 → 从左往右流
+        tidePhase += dt * (0.00045f + 0.0016f * speed) * sens
+        // 长时间挂在屏幕上时把相位折回来，避免 float 精度越用越粗
+        if (tidePhase > 1e5f) tidePhase -= 1e5f
+        val amp = ((dp(3f) + dp(10f) * speed) * ampScale).coerceIn(dp(1.5f), dp(40f))
+        val baseY = h - dp(2f)
+
+        when (DahiKeyEffectsConfig.tideStyle) {
+            DahiKeyEffectsConfig.TideStyle.SOFT -> drawSoftTide(canvas, palette, h, baseY, amp, speed, ampScale)
+            DahiKeyEffectsConfig.TideStyle.SWELL -> drawSwellTide(canvas, palette, h, baseY, amp, speed, ampScale)
+            DahiKeyEffectsConfig.TideStyle.BARS -> drawBarsTide(canvas, palette, baseY, amp, speed, ampScale)
+            DahiKeyEffectsConfig.TideStyle.STARS -> drawStarTide(canvas, palette, h, baseY, amp, speed, ampScale)
+        }
+    }
+
+    /** 浪线在 x 处的高度（SOFT / SWELL / STARS 共用）。 */
+    private fun crestY(
+        x: Float,
+        baseY: Float,
+        amp: Float,
+        layers: Int,
+    ): Float {
+        var offset = 0.62f * waveSin(x / dp(46f) - tidePhase) + 0.38f * waveSin(x / dp(27f) - tidePhase * 1.25f)
+        if (layers >= 3) offset += 0.28f * waveSin(x / dp(17f) - tidePhase * 1.7f)
+        return baseY - amp * offset
+    }
+
+    private fun fillTideBody(
+        canvas: Canvas,
+        color: Int,
+        h: Float,
+        baseY: Float,
+        amp: Float,
+        layers: Int,
+    ) {
+        tidePath.reset()
+        tidePath.moveTo(0f, h)
+        var x = 0f
+        while (x <= width.toFloat()) {
+            tidePath.lineTo(x, crestY(x, baseY, amp, layers))
+            x += dp(7f)
+        }
+        tidePath.lineTo(width.toFloat(), h)
+        tidePath.close()
+        fill.style = Paint.Style.FILL
+        fill.color = color
+        canvas.drawPath(tidePath, fill)
+    }
+
+    private fun strokeCrest(
+        canvas: Canvas,
+        color: Int,
+        widthPx: Float,
+        baseY: Float,
+        amp: Float,
+        layers: Int,
+    ) {
+        tideCrest.reset()
+        var first = true
+        var x = 0f
+        while (x <= width.toFloat()) {
+            val y = crestY(x, baseY, amp, layers)
+            if (first) {
+                tideCrest.moveTo(x, y)
+                first = false
+            } else {
+                tideCrest.lineTo(x, y)
+            }
+            x += dp(7f)
+        }
+        stroke.style = Paint.Style.STROKE
+        stroke.strokeWidth = widthPx
+        stroke.color = color
+        canvas.drawPath(tideCrest, stroke)
+    }
+
+    /** 缓浪：两层浪 + 浪尖高光，最快的速度起一点泡沫。 */
+    private fun drawSoftTide(
+        canvas: Canvas,
+        palette: DahiKeyPalette.Colors,
+        h: Float,
+        baseY: Float,
+        amp: Float,
+        speed: Float,
+        ampScale: Float,
+    ) {
+        fillTideBody(canvas, withAlpha(palette.primary, (40 + 50 * speed).toInt().coerceIn(28, 140)), h, baseY, amp, 2)
+        strokeCrest(canvas, withAlpha(palette.glow, (46 + 100 * speed).toInt().coerceIn(34, 180)), dp(1.1f), baseY, amp, 2)
+        if (speed > 0.8f) {
+            drawFoam(canvas, palette, baseY, amp, 2, (speed - 0.8f) / 1.6f, ampScale)
+        }
+    }
+
+    /** 叠浪：三层浪叠在一起，浪尖更高、更容易看出速度差，另加两层浪花。 */
+    private fun drawSwellTide(
+        canvas: Canvas,
+        palette: DahiKeyPalette.Colors,
+        h: Float,
+        baseY: Float,
+        amp: Float,
+        speed: Float,
+        ampScale: Float,
+    ) {
+        fillTideBody(canvas, withAlpha(palette.primary, (46 + 62 * speed).toInt().coerceIn(30, 160)), h, baseY, amp, 3)
+        // 后排浪：更高、更淡，交叠出"涌"的层次
+        fillTideBody(
+            canvas,
+            withAlpha(palette.secondary, (26 + 34 * speed * ampScale).toInt().coerceIn(16, 90)),
+            h,
+            baseY - dp(3f),
+            amp * 1.25f,
+            3,
+        )
+        strokeCrest(canvas, withAlpha(palette.glow, (52 + 120 * speed).toInt().coerceIn(36, 200)), dp(1.3f), baseY, amp, 3)
+        drawFoam(canvas, palette, baseY, amp, 3, (0.15f + speed * 0.5f).coerceIn(0f, 1f), ampScale)
+    }
+
+    /**
+     * 声纹：借鉴「声情意象」的声纹形态 —— 一排竖条，高度随速度起伏，
+     * 亮纹按相位从左往右推过去。
+     */
+    private fun drawBarsTide(
+        canvas: Canvas,
+        palette: DahiKeyPalette.Colors,
+        baseY: Float,
+        amp: Float,
+        speed: Float,
+        ampScale: Float,
+    ) {
+        val barW = dp(2.2f)
+        val step = barW + dp(4.2f)
+        fill.style = Paint.Style.FILL
+        var x = dp(1.5f)
+        while (x < width.toFloat()) {
+            // k 随 x 增大 → 同一条亮带在时间推进时整体右移
+            val k = x / dp(26f)
+            val v = 0.5f + 0.5f * waveSin(k - tidePhase * 2.4f)
+            val barH = (dp(1.4f) + (dp(2.5f) + amp * 1.6f) * v * ampScale).coerceAtLeast(dp(1f))
+            val alpha = (28 + 170 * v * (0.35f + 0.65f * speed)).toInt().coerceIn(20, 220)
+            fill.color = withAlpha(if (v > 0.72f) palette.glow else palette.primary, alpha)
+            canvas.drawRoundRect(x, baseY - barH, x + barW, baseY, barW / 2f, barW / 2f, fill)
+            x += step
+        }
+        stroke.style = Paint.Style.STROKE
+        stroke.strokeWidth = dp(0.9f)
+        stroke.color = withAlpha(palette.secondary, (48 + 60 * speed).toInt().coerceIn(28, 120))
+        canvas.drawLine(0f, baseY, width.toFloat(), baseY, stroke)
+    }
+
+    /** 星汐：细浪线 + 沿浪面从左往右漂的亮点。 */
+    private fun drawStarTide(
+        canvas: Canvas,
+        palette: DahiKeyPalette.Colors,
+        h: Float,
+        baseY: Float,
+        amp: Float,
+        speed: Float,
+        ampScale: Float,
+    ) {
+        fillTideBody(canvas, withAlpha(palette.primary, (26 + 34 * speed).toInt().coerceIn(18, 90)), h, baseY, amp, 2)
+        strokeCrest(canvas, withAlpha(palette.glow, (40 + 90 * speed).toInt().coerceIn(30, 160)), dp(0.9f), baseY, amp, 2)
+        // 亮点：位置由「序号 + 相位」直接算出（不建粒子，永不跳帧），边界处淡出避免瞬移
+        fill.style = Paint.Style.FILL
+        val count = 12
+        repeat(count) { i ->
+            val t = (i * 0.083f + tidePhase * 0.07f) % 1f
+            val fade = when {
+                t < 0.06f -> t / 0.06f
+                t > 0.94f -> (1f - t) / 0.06f
+                else -> 1f
+            }
+            val sx = t * width
+            val sy = crestY(sx, baseY, amp, 2) - dp(starOffset(i))
+            val r = dp(0.9f + 0.8f * waveSin(i * 1.7f + tidePhase * 3f))
+            fill.color = withAlpha(palette.glow, (200 * fade * (0.4f + 0.6f * speed)).toInt().coerceIn(0, 220))
+            canvas.drawCircle(sx, sy, r.coerceAtLeast(dp(0.6f)), fill)
+        }
+    }
+
+    /** 泡沫点：贴着浪尖、从左往右漂的小白点（按相位参数化，不需要粒子池）。 */
+    private fun drawFoam(
+        canvas: Canvas,
+        palette: DahiKeyPalette.Colors,
+        baseY: Float,
+        amp: Float,
+        layers: Int,
+        strength: Float,
+        ampScale: Float,
+    ) {
+        if (strength <= 0.02f) return
+        fill.style = Paint.Style.FILL
+        val count = (8 + 10 * strength).toInt()
+        repeat(count) { i ->
+            val t = (i * 0.137f + tidePhase * 0.16f) % 1f
+            val fade = when {
+                t < 0.08f -> t / 0.08f
+                t > 0.92f -> (1f - t) / 0.08f
+                else -> 1f
+            }
+            val sx = t * width
+            val chaos = waveSin(i * 2.3f + tidePhase * 5f) * dp(2.2f)
+            val sy = crestY(sx, baseY, amp, layers) - dp(0.8f) + chaos
+            val r = dp(0.7f + 1.1f * (0.5f + 0.5f * waveSin(i * 3.1f)))
+            fill.color = withAlpha(palette.glow, (200 * fade * strength * ampScale).toInt().coerceIn(0, 210))
+            canvas.drawCircle(sx, sy, r.coerceAtLeast(dp(0.5f)), fill)
+        }
+    }
+
+    /** 星汐亮点的固定高低错落（每 5 个循环一次，看起来不像一排等高的灯珠）。 */
+    private fun starOffset(i: Int): Float = ((i * 7) % 5) * 1.3f
+
+    // -------- 残影 / 粒子
+
+    private fun drawTrails(
+        canvas: Canvas,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        trails.removeAll { now - it.born > TRAIL_LIFE_MS }
+        if (trails.isEmpty()) return
+        val speed = (DahiSpeedMeter.kpm(now) / 180f).coerceIn(0f, 1.6f)
+        stroke.style = Paint.Style.STROKE
+        stroke.strokeWidth = dp(1.5f)
+        trails.forEach { trail ->
+            val progress = (now - trail.born).toFloat() / TRAIL_LIFE_MS.toFloat()
+            val alpha = ((1f - progress) * (70f + 110f * speed)).toInt().coerceIn(0, 200)
+            stroke.color = withAlpha(palette.primary, alpha)
+            val grow = dp(1.5f + 4f * speed) * progress
+            canvas.drawRoundRect(
+                RectF(
+                    trail.rect.left - grow,
+                    trail.rect.top - grow,
+                    trail.rect.right + grow,
+                    trail.rect.bottom + grow,
+                ),
+                dp(9f),
+                dp(9f),
+                stroke,
+            )
+        }
+    }
+
+    private fun drawParticles(
+        canvas: Canvas,
+        now: Long,
+        dt: Float,
+        @Suppress("UNUSED_PARAMETER") palette: DahiKeyPalette.Colors,
+    ) {
+        particles.removeAll { now - it.born > it.maxLife }
+        while (particles.size > MAX_PARTICLES) particles.removeAt(0)
+        if (particles.isEmpty()) return
+        for (p in particles) {
+            val age = (now - p.born).toFloat()
+            if (age < 0f) continue
+            val life = (age / p.maxLife.toFloat()).coerceIn(0f, 1f)
+            when (p.kind) {
+                KIND_RING -> {
+                    stroke.style = Paint.Style.STROKE
+                    stroke.strokeWidth = dp(2f) * (1f - life * 0.6f)
+                    stroke.color = withAlpha(p.color, ((1f - life) * 170f).toInt().coerceIn(0, 190))
+                    canvas.drawCircle(p.x, p.y, p.size * life, stroke)
+                }
+
+                KIND_DROP -> {
+                    p.vy += dp(0.0011f) * dt
+                    p.x += p.vx * dt
+                    p.y += p.vy * dt
+                    fill.style = Paint.Style.FILL
+                    fill.color = withAlpha(p.color, ((1f - life) * 210f).toInt().coerceIn(0, 220))
+                    canvas.drawCircle(p.x, p.y, p.size * (1f - life * 0.5f), fill)
+                }
+
+                KIND_STAR -> {
+                    p.x += p.vx * dt + waveSin(age / 120f) * dp(0.02f)
+                    p.y += p.vy * dt
+                    val twinkle = 0.55f + 0.45f * waveSin(age / 90f)
+                    fill.style = Paint.Style.FILL
+                    fill.color = withAlpha(p.color, ((1f - life) * 220f * twinkle).toInt().coerceIn(0, 230))
+                    canvas.drawCircle(p.x, p.y, p.size, fill)
+                }
+
+                KIND_FIREFLY -> {
+                    // 上浮 + 左右摇摆 + 明灭（呼吸）
+                    p.x += p.vx * dt + waveSin(age / 260f) * dp(0.03f)
+                    p.y += p.vy * dt
+                    val breath = 0.35f + 0.65f * (0.5f + 0.5f * waveSin(age / 210f))
+                    fill.style = Paint.Style.FILL
+                    fill.color = withAlpha(p.color, ((1f - life * 0.7f) * 230f * breath).toInt().coerceIn(0, 235))
+                    canvas.drawCircle(p.x, p.y, p.size * (0.8f + 0.4f * breath), fill)
+                }
+
+                KIND_PETAL -> {
+                    // 边转边飘：先转到角度、再压扁成花瓣形状
+                    p.x += p.vx * dt + waveSin(age / 180f) * dp(0.02f)
+                    p.y += p.vy * dt
+                    canvas.save()
+                    canvas.translate(p.x, p.y)
+                    canvas.rotate(p.spin * age)
+                    canvas.scale(1f, 0.42f)
+                    fill.style = Paint.Style.FILL
+                    fill.color = withAlpha(p.color, ((1f - life) * 215f).toInt().coerceIn(0, 225))
+                    canvas.drawCircle(0f, 0f, p.size, fill)
+                    canvas.restore()
+                }
+
+                KIND_SPARK -> {
+                    p.x += p.vx * dt
+                    p.y += p.vy * dt
+                    val len = p.size * (1f - life * 0.55f)
+                    stroke.style = Paint.Style.STROKE
+                    stroke.strokeWidth = dp(1.1f)
+                    stroke.color = withAlpha(p.color, ((1f - life) * 220f).toInt().coerceIn(0, 230))
+                    val cosA = waveCos(p.spin)
+                    val sinA = waveSin(p.spin)
+                    canvas.drawLine(p.x - cosA * len, p.y - sinA * len, p.x + cosA * len, p.y + sinA * len, stroke)
+                    canvas.drawLine(
+                        p.x - sinA * len * 0.55f,
+                        p.y + cosA * len * 0.55f,
+                        p.x + sinA * len * 0.55f,
+                        p.y - cosA * len * 0.55f,
+                        stroke,
+                    )
+                }
+
+                else -> {
+                    p.x += p.vx * dt
+                    p.y += p.vy * dt
+                    fill.style = Paint.Style.FILL
+                    fill.color = withAlpha(p.color, ((1f - life) * 150f).toInt().coerceIn(0, 170))
+                    canvas.drawCircle(p.x, p.y, p.size * (0.4f + life * 1.4f), fill)
+                }
+            }
+        }
+    }
+
+    /**
+     * 画一段「在任何键帽上都读得清」的文字：先描一圈**反色**细边，再填本色。
+     *
+     * 落字成句、段落小结、❤ 计数都画在键盘上，底下可能是白色键帽、深色键帽，甚至是背景图 ——
+     * 单靠调颜色兼顾不了所有情况（浅字在白键帽上糊、深字在深键帽上糊），
+     * 加一圈与字色明暗相反的描边最稳：浅字配深边、深字配浅边。
+     */
+    private fun drawReadableText(
+        canvas: Canvas,
+        text: String,
+        x: Float,
+        y: Float,
+        color: Int,
+        strokeDp: Float,
+    ) {
+        textPaint.style = Paint.Style.STROKE
+        textPaint.strokeWidth = dp(strokeDp)
+        textPaint.color = withAlpha(DahiContrast.opposite(color), (Color.alpha(color) * 0.6f).toInt().coerceIn(0, 200))
+        canvas.drawText(text, x, y, textPaint)
+        textPaint.style = Paint.Style.FILL
+        textPaint.color = color
+        canvas.drawText(text, x, y, textPaint)
+    }
+
+    // -------- 落字成句
+
+    private fun drawGlyphs(
+        canvas: Canvas,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        if (glyphs.isEmpty() && landed.isEmpty()) return
+        textPaint.textSize =
+            if (DahiKeyEffectsConfig.collectHeart) {
+                heartMetrics().second
+            } else {
+                dp(DahiKeyEffectsConfig.glyphTextSize.toFloat())
+            }
+
+        if (glyphs.isNotEmpty()) {
+            val finished = ArrayList<Glyph>(2)
+            for (g in glyphs) {
+                val raw = (now - g.startAt).toFloat()
+                if (raw < 0f) continue
+                val progress = raw / GLYPH_FLY_MS
+                if (progress >= 1f) {
+                    finished.add(g)
+                    continue
+                }
+                val e = 1f - (1f - progress) * (1f - progress) * (1f - progress)
+                // 二次贝塞尔：先往上一抛，再落到底部 —— 像被"捡起来"
+                val ctrlX = (g.fromX + g.tx) / 2f
+                val ctrlY = (min(g.fromY, g.ty) - dp(30f)).coerceAtLeast(dp(3f))
+                val inv = 1f - e
+                val x = inv * inv * g.fromX + 2f * inv * e * ctrlX + e * e * g.tx
+                val y = inv * inv * g.fromY + 2f * inv * e * ctrlY + e * e * g.ty
+                drawReadableText(
+                    canvas,
+                    g.ch,
+                    x,
+                    y,
+                    withAlpha(g.color, (255 * (0.55f + 0.45f * e)).toInt().coerceIn(0, 255)),
+                    1.8f,
+                )
+            }
+            if (finished.isNotEmpty()) {
+                glyphs.removeAll { it in finished }
+                val heartMode = DahiKeyEffectsConfig.collectHeart
+                val cycle = DahiKeyEffectsConfig.heartCycle
+                finished.forEach { g ->
+                    // 「逐字替换」：同一位置先清掉上一颗心的字，第二遍画才看得清
+                    if (heartMode && cycle == DahiKeyEffectsConfig.HeartCycle.REPLACE) {
+                        landed.removeAll {
+                            kotlin.math.abs(it.x - g.tx) < dp(1.5f) && kotlin.math.abs(it.y - g.ty) < dp(1.5f)
+                        }
+                    }
+                    landed.add(Landed(g.ch, g.tx, g.ty, g.color))
+                }
+                lineFadeAt = now + SENTENCE_HOLD_MS
+                // 「画心」模式：每填满一组点位 = 画成一颗心
+                if (heartMode && landed.size % heartPoints.size == 0) {
+                    heartCount++
+                    heartHintUntil = now + HEART_HINT_MS
+                    // 「整颗清空」：画满就把上一颗抹掉，从空白的下一颗开始
+                    if (cycle == DahiKeyEffectsConfig.HeartCycle.CLEAR) landed.clear()
+                }
+                invalidateAnim()
+            }
+        }
+
+        if (landed.isEmpty()) return
+        if (lineFadeAt <= 0L) {
+            retireSentence()
+            return
+        }
+        var alpha = 1f
+        if (now > lineFadeAt) {
+            val t = (now - lineFadeAt).toFloat() / SENTENCE_FADE_MS
+            if (t >= 1f) {
+                retireSentence()
+                return
+            }
+            alpha = 1f - t
+        }
+
+        // 「画心」模式：画满一颗就冒一个 ❤ ×N
+        if (DahiKeyEffectsConfig.collectHeart && heartCount > 0 && now < heartHintUntil) {
+            textPaint.textSize = dp(22f)
+            val y = height - dp(GLYPH_BASE_DP) - dp(heartGrid.size * 21f)
+            drawReadableText(canvas, "❤×$heartCount", width / 2f, y.coerceAtLeast(dp(24f)), 0xFFE53935.toInt(), 2.2f)
+        }
+
+        // 「连成一句」：字与字之间拉一条很淡的线（只在同一行时画，换行后不跨行连）
+        if (landed.size >= 2 && kotlin.math.abs(landed.first().y - landed.last().y) < dp(1f)) {
+            stroke.style = Paint.Style.STROKE
+            stroke.strokeWidth = dp(1.1f)
+            stroke.color = withAlpha(palette.primary, (70 * alpha).toInt().coerceIn(0, 90))
+            val y = landed.first().y + dp(5f)
+            canvas.drawLine(landed.first().x - dp(8f), y, landed.last().x + dp(8f), y, stroke)
+        }
+
+        landed.forEach { g ->
+            drawReadableText(canvas, g.ch, g.x, g.y, withAlpha(g.color, (250 * alpha).toInt().coerceIn(0, 255)), 2.0f)
+        }
+    }
+
+    // -------- 段落小结
+
+    private fun drawSummary(
+        canvas: Canvas,
+        now: Long,
+        palette: DahiKeyPalette.Colors,
+    ) {
+        if (summaryText.isEmpty() || now > summaryUntil) return
+        val remain = (summaryUntil - now).toFloat()
+        val fade = min(1f, remain / 380f)
+        textPaint.textSize = dp(14f)
+        // 底部正在显示「落字成句」时，摘要要抬到那句字的上方，否则两行会叠在一起
+        val y = if (landed.isNotEmpty()) landed.minOf { it.y } - dp(16f) else height - dp(58f)
+        textPaint.style = Paint.Style.FILL
+        textPaint.color = withAlpha(palette.primary, (250f * fade).toInt().coerceIn(0, 255))
+        canvas.drawText(summaryText, width / 2f, y, textPaint)
+    }
+
+    private fun scheduleSummaryCheck() {
+        removeCallbacks(summaryCheck)
+        if (!DahiKeyEffectsConfig.summary) return
+        postDelayed(summaryCheck, SUMMARY_IDLE_MS)
+    }
+
+    private fun maybeShowSummary() {
+        if (!DahiKeyEffectsConfig.summary) return
+        val now = SystemClock.uptimeMillis()
+        if (paraChars < PARA_MIN_CHARS || paraActiveMs <= 0L) {
+            // 不够一段就作废（否则起点会一直挂着，下次算出来是"每分钟几个字"）
+            paraChars = 0
+            paraStartAt = 0L
+            paraLastCommitAt = 0L
+            paraActiveMs = 0L
+            return
+        }
+        // 分母用「活跃打字时间」：想词、选词、停顿都不算，这才是真正的打字速度。
+        // 以前用墙钟时间，结果就是「不管打快打慢都是同一个数」——分母被最小跨度吃掉了。
+        val span = paraActiveMs.coerceAtLeast(500L)
+        val cpm = (paraChars * 60000L / span).toInt().coerceIn(0, 999)
+        summaryText = context.getString(R.string.dahi_ke_summary_text, cpm)
+        summaryUntil = now + 2200L
+        paraChars = 0
+        paraStartAt = 0L
+        paraLastCommitAt = 0L
+        paraActiveMs = 0L
+        invalidateAnim()
+    }
+
+    // ---------------------------------------------------------------- 工具
+
+    /** 是不是「编码键」：字母或数字（空格 / 退格 / 回车不算）。 */
+    private fun isCodeKey(keyCode: Int): Boolean = keyCode in KeyEvent.KEYCODE_A..KeyEvent.KEYCODE_Z || isDigitKey(keyCode)
+
+    private fun isDigitKey(keyCode: Int): Boolean = keyCode in KeyEvent.KEYCODE_0..KeyEvent.KEYCODE_9
+
+    /** 算进「打字速度」的键：字符键、数字键、空格。 */
+    private fun isRhythmKey(keyCode: Int): Boolean = isCodeKey(keyCode) || keyCode == KeyEvent.KEYCODE_SPACE
+
+    private fun withAlpha(
+        color: Int,
+        alpha: Int,
+    ): Int = Color.argb(alpha.coerceIn(0, 255), Color.red(color), Color.green(color), Color.blue(color))
+
+    private fun locateCenter(view: View): Pair<Float, Float>? {
+        if (view.width <= 0 || view.height <= 0) return null
+        view.getLocationInWindow(tmpInts)
+        getLocationInWindow(tmpInts2)
+        val cx = (tmpInts[0] - tmpInts2[0]).toFloat() + view.width / 2f
+        val cy = (tmpInts[1] - tmpInts2[1]).toFloat() + view.height / 2f
+        return cx to cy
+    }
+
+    private fun keyRect(view: View): RectF? {
+        if (view.width <= 0 || view.height <= 0) return null
+        view.getLocationInWindow(tmpInts)
+        getLocationInWindow(tmpInts2)
+        val left = (tmpInts[0] - tmpInts2[0]).toFloat()
+        val top = (tmpInts[1] - tmpInts2[1]).toFloat()
+        return RectF(left, top, left + view.width, top + view.height)
+    }
+
+    /** kotlin.math.sin / cos 只接受 Double，这里统一转一层，避免每处都写 .toDouble()。 */
+    private fun waveSin(value: Float): Float = sin(value.toDouble()).toFloat()
+
+    private fun waveCos(value: Float): Float = cos(value.toDouble()).toFloat()
+
+    private fun isHanzi(c: Char): Boolean = c.code in 0x4E00..0x9FFF || c.code in 0x3400..0x4DBF || c.code in 0xF900..0xFAFF
+
+    private companion object {
+        const val KIND_RING = 0
+        const val KIND_DROP = 1
+        const val KIND_STAR = 2
+        const val KIND_INK = 3
+        const val KIND_FIREFLY = 4
+        const val KIND_PETAL = 5
+        const val KIND_SPARK = 6
+
+        const val MAX_PARTICLES = 96
+        const val MAX_KEY_TRAIL = 12
+        const val TRAIL_LIFE_MS = 380L
+        const val GLYPH_FLY_MS = 560f
+        const val GLYPH_STAGGER_MS = 70L
+
+        /** 字距 = 字号 × 这个比例（略大于 1，字之间才不粘）。 */
+        const val GLYPH_ADVANCE_RATIO = 1.06f
+
+        /** 行距 = 字号 × 这个比例。 */
+        const val GLYPH_LINE_GAP_RATIO = 1.22f
+
+        /** 最多几行（第一行贴着键盘底部，第二行在它上面）。 */
+        const val GLYPH_MAX_LINES = 2
+
+        /** 「画心」模式最多连续画几颗心（画满就自动重新开始）。 */
+        const val HEART_MAX_HEARTS = 3
+
+        /** ❤ 提示停留时长。 */
+        const val HEART_HINT_MS = 2400L
+
+        const val GLYPH_BASE_DP = 46f
+
+        /** 少于这么多字不弹「段落小结」。 */
+        const val PARA_MIN_CHARS = 6
+
+        /** 两段上屏间隔超过它，就当成新的一段。 */
+        const val PARA_BREAK_MS = 8000L
+        const val SENTENCE_HOLD_MS = 2400L
+        const val SENTENCE_FADE_MS = 620f
+        const val SUMMARY_IDLE_MS = 1600L
+    }
+}
