+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.backup
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.JsonElement
+
+/**
+ * 备份数据模型。
+ *
+ * 出于隐私考虑，序列化后的明文 JSON 在落盘/导出前会整体加密（见 [BackupCrypto]），
+ * 因此磁盘上的备份文件不会以明文形式暴露剪贴板、收藏夹或首选项内容。
+ */
+@Serializable
+data class BackupData(
+    val format: String = FORMAT,
+    val version: Int = CURRENT_VERSION,
+    val timestamp: Long = System.currentTimeMillis(),
+    val appVersion: String? = null,
+    val preferences: Map<String, BackupPreference>? = null,
+    val clipboard: List<BackupBean>? = null,
+    val collection: List<BackupBean>? = null,
+    /** 声情意象（语音动效）参数，键前缀见 [com.osfans.trime.ime.voice.VoiceImagery.KEY_PREFIX]。 */
+    val voiceImagery: Map<String, BackupPreference>? = null,
+    /** 候选词排序（手动排序），偏好键见 [com.osfans.trime.ime.custom.DahiCandidateOrder.PREF_KEY]。 */
+    val candidateOrder: Map<String, BackupPreference>? = null,
+    /** 客户端自定义短语，偏好键见 [com.osfans.trime.ime.custom.DahiCustomPhrase.PREF_KEY]。 */
+    val customPhrase: Map<String, BackupPreference>? = null,
+    /** 键盘背景（设置 + 图片，JSON 文本），见 [com.osfans.trime.ime.custom.DahiKeyboardBackground]。 */
+    val keyboardBackground: String? = null,
+    /** 输入统计（聚合计数 JSON，不含任何输入内容），见 [com.osfans.trime.ime.custom.DahiInputStats]。 */
+    val inputStats: String? = null,
+    /** 词云隐藏名单（隐私配置），偏好键见 [com.osfans.trime.ime.custom.DahiWordHidden.PREF_KEY]。 */
+    val wordHidden: Map<String, BackupPreference>? = null,
+    /**
+     * 快打统计：JSON 文本 `{"stats": 调出次数与复习进度, "settings": 门槛/排序/开关/已忽略}`。
+     *
+     * 旧备份没有这个字段 → 反序列化为 null，界面上显示为「未包含」，不影响还原。
+     */
+    val phraseStats: String? = null,
+) {
+    companion object {
+        const val FORMAT = "dahi-trime-backup"
+        const val CURRENT_VERSION = 1
+    }
+}
+
+/** 单条偏好设置：[type] 为存储类型名，[value] 为对应的 JSON 值。 */
+@Serializable
+data class BackupPreference(
+    val type: String,
+    val value: JsonElement,
+)
+
+/** 剪贴板/收藏夹条目。 */
+@Serializable
+data class BackupBean(
+    val text: String? = null,
+    val html: String? = null,
+    val type: String = "TEXT",
+    val time: Long = 0L,
+    val pinned: Boolean = false,
+    val orderIndex: Int = 0,
+    /** 剪贴板分类名（旧备份没有该字段，还原为未分类）。 */
+    val category: String? = null,
+    /**
+     * 上屏次数（「频数」排序依据）。
+     * 旧备份没有该字段 → 反序列化为 0，不影响还原。
+     */
+    val useCount: Int = 0,
+)
