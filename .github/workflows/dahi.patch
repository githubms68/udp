+        val showHours: Boolean,
+        val showCloud: Boolean,
+        /** 「近 30 天 · 日均 N 字」这一句；空串表示天数太少、不显示。 */
+        val dailyAvgText: String = "",
+        /** 每日输入柱状图的柱子（近 30 天）；空表示不画这张卡。 */
+        val dailyBars: List<DahiDailyTrendView.Item> = emptyList(),
