+    private fun attachReorderHelper(
+        recyclerView: RecyclerView,
+        adapter: ClipboardAdapter,
+        persist: suspend (List<DatabaseBean>) -> Unit,
+    ) {
+        // 两列时必须允许左右拖动，否则同一行里换位拖不动；
+        // 单列只给上下，避免横向误触。
+        val directions =
+            if (entryColumns() >= 2) {
+                ItemTouchHelper.UP or ItemTouchHelper.DOWN or ItemTouchHelper.LEFT or ItemTouchHelper.RIGHT
+            } else {
+                ItemTouchHelper.UP or ItemTouchHelper.DOWN
+            }
+        val callback =
+            object : ItemTouchHelper.SimpleCallback(directions, 0) {
+                override fun onMove(
+                    recyclerView: RecyclerView,
+                    viewHolder: RecyclerView.ViewHolder,
+                    target: RecyclerView.ViewHolder,
+                ): Boolean = adapter.moveItem(viewHolder.bindingAdapterPosition, target.bindingAdapterPosition)
+
+                override fun onSwiped(
+                    viewHolder: RecyclerView.ViewHolder,
+                    direction: Int,
+                ) = Unit
+
+                // 由条目上的拖拽把手触发，避免与长按弹出菜单冲突
+                override fun isLongPressDragEnabled(): Boolean = false
+
+                override fun clearView(
+                    recyclerView: RecyclerView,
+                    viewHolder: RecyclerView.ViewHolder,
+                ) {
+                    super.clearView(recyclerView, viewHolder)
+                    val reordered = adapter.commitReorder()
+                    if (reordered.isNotEmpty()) {
+                        // 先按用户拖出来的顺序整表重绑（这一步是修复「显示两条一样」的关键），
+                        // 再写库；之后 Paging 数据到达时两边的顺序已经一致。
+                        adapter.applyReorderNow()
+                        service.lifecycleScope.launch { persist(reordered) }
+                        // 兜底：若数据没变化（拖回原位）不会触发刷新，1.2 秒后也把镜像撤掉
+                        recyclerView.postDelayed({ adapter.clearReorderMirror() }, 1200)
+                    }
+                }
+            }
+        val helper = ItemTouchHelper(callback)
+        helper.attachToRecyclerView(recyclerView)
+        adapter.onStartDrag = { helper.startDrag(it) }
+        // **必须**回填：adapter 里 applyReorderNow() / clearReorderMirror()
+        // 都是通过 boundRecyclerView 投递整表重绑的。这一行漏了，那两个函数
+        // 就一直是空转（`boundRecyclerView?.post` 直接短路），
+        // 表现就是「补丁改了、行为一点没变」。
+        adapter.boundRecyclerView = recyclerView
+    }
