new file mode 100644
index 0000000..1f7ad0e
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/PhraseCodeEditor.kt
@@ -0,0 +1,138 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.view.KeyEvent
+
+/**
+ * 候选长按 →「修改编码 / 设为快打」时的编码输入状态。
+ *
+ * 为什么不用 `AlertDialog + EditText`：输入法进程里弹 Dialog 会抢焦点，
+ * 软键盘虽在显示却被 Dialog 盖住，且那个 EditText 拿不到 IME 连接 ——
+ * 实测「点输入框什么都不弹，根本打不进字」。
+ *
+ * 所以改成：编码条画在**输入视图内部**（不抢焦点，键盘照常显示），
+ * 软键盘/物理键盘的按键在进入 Rime 之前先被 [acceptKeyEvent] 吃掉，
+ * 按位置换算成字符累加到 [buffer] —— 不组字、不弹候选，所见即所得。
+ *
+ * 空格或回车 = 确定，退格 = 删除末位，点「取消」= 放弃。
+ */
+object PhraseCodeEditor {
+    /** 编码最长长度（与短语库的宽松规则保持一致，足够覆盖双拼长码）。 */
+    private const val MAX_LENGTH = 12
+
+    @Volatile
+    var active: Boolean = false
+        private set
+
+    private var buffer = ""
+
+    /**
+     * 下一次输入字母/数字时，先把原编码整体清掉。
+     *
+     * 「修改编码」进来时默认显示的是旧编码，用户心里的下一个动作是「重新打一遍」——
+     * 若只能一个个退格，得先删十几次才能改；置位后第一次敲键就把旧码丢弃，
+     * 符合「重新输入即覆盖」的直觉。
+     */
+    private var replaceOnNextChar = false
+
+    private var onChange: ((String) -> Unit)? = null
+    private var onFinish: ((String?) -> Unit)? = null
+
+    fun start(
+        initial: String,
+        onChange: (String) -> Unit,
+        onFinish: (String?) -> Unit,
+    ) {
+        buffer = initial.take(MAX_LENGTH)
+        replaceOnNextChar = buffer.isNotEmpty()
+        this.onChange = onChange
+        this.onFinish = onFinish
+        active = true
+        onChange(buffer)
+    }
+
+    /**
+     * 吃掉一次按键；返回 true 表示「这次按键归我，别再交给 Rime」。
+     *
+     * 只接受小写字母 / 数字 / 撇号：编码本来就只允许这些，
+     * 其余按键（方向、符号、面板功能键）一律忽略但仍然吞掉，避免误触发。
+     */
+    fun acceptKeyEvent(
+        keyCode: Int,
+        metaState: Int,
+    ): Boolean {
+        if (!active) return false
+        when {
+            keyCode == KeyEvent.KEYCODE_DEL -> {
+                replaceOnNextChar = false
+                if (buffer.isEmpty()) {
+                    // 已经删空还继续退格 = 放弃编辑。
+                    // 没有这条兜底时，一旦「取消」按钮点不穿，编码条就会永远关不掉。
+                    finish(false)
+                    return true
+                }
+                buffer = buffer.dropLast(1)
+                onChange?.invoke(buffer)
+            }
+
+            keyCode == KeyEvent.KEYCODE_SPACE ||
+                keyCode == KeyEvent.KEYCODE_ENTER ||
+                keyCode == KeyEvent.KEYCODE_NUMPAD_ENTER -> finish(true)
+
+            keyCode in KeyEvent.KEYCODE_A..KeyEvent.KEYCODE_Z -> {
+                // 忽略 Shift：编码统一小写（normalize 也会再压一次）
+                append(('a'.code + (keyCode - KeyEvent.KEYCODE_A)).toChar())
+            }
+
+            keyCode in KeyEvent.KEYCODE_0..KeyEvent.KEYCODE_9 -> {
+                append(('0'.code + (keyCode - KeyEvent.KEYCODE_0)).toChar())
+            }
+
+            keyCode == KeyEvent.KEYCODE_APOSTROPHE -> append('\'')
+
+            else -> Unit
+        }
+        return true
+    }
+
+    private fun append(c: Char) {
+        if (replaceOnNextChar) {
+            replaceOnNextChar = false
+            buffer = ""
+        }
+        if (buffer.length < MAX_LENGTH) {
+            buffer += c
+            onChange?.invoke(buffer)
+        }
+    }
+
+    /**
+     * 兜底清空（输入视图重建、切到别的 App 时调）。
+     *
+     * 不清会把 [active] 卡在 true 上，之后**所有按键**都被这里吃掉 ——
+     * 表现为「键盘完全失灵、只能重启输入法」。
+     */
+    fun reset() {
+        active = false
+        buffer = ""
+        replaceOnNextChar = false
+        onChange = null
+        onFinish = null
+    }
+
+    /** [confirm] = true 表示提交（把 buffer 交给回调），false 表示取消。 */
+    fun finish(confirm: Boolean) {
+        if (!active) return
+        val result = if (confirm) buffer else null
+        active = false
+        val cb = onFinish
+        onFinish = null
+        onChange = null
+        buffer = ""
+        cb?.invoke(result)
+    }
+}
