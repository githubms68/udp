+    <!-- 键盘候选栏序号 -->
+    <string name="dahi_filter_enabled">Candidate filter (first / last character)</string>
+    <string name="dahi_filter_enabled_summary">Long-press a candidate: the menu offers “only starting with X / only ending with X”, to narrow candidates down to the same kind. When off, neither entry is shown.</string>
+    <string name="dahi_recent_enabled">Recently used words</string>
+    <string name="dahi_recent_enabled_summary">Show recently committed words as candidates: with no candidates (the bar shows only toolbar buttons), long-press any empty spot; or add the ↺ button in “Toolbar buttons”. Swipe left/right (or Page Up/Down) to turn pages; numbers follow how many items the page actually shows, and number keys commit by that index; in the unrolled list just tap the word. Exits after committing. Supports custom key binding — see “Advanced” on the home page</string>
