+    <string name="dahi_recent_menu">Recently used words</string>
+    <string name="dahi_recent_empty">Nothing recorded yet</string>
+    <string name="dahi_take_char">Take a character: long-press a candidate</string>
+    <string name="dahi_take_char_summary">Long-press a candidate, then tap “Take a character ›” to list every character of that word; tap one to commit only that character. Useful when a single character is hard to type but the word is easy (e.g. too many homophones in shuangpin). Off by default</string>
