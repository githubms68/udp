+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                setSingleLine()
+            }
+        box.addView(codeInput)
+        box.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_manage_phrase_text)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setPadding(0, dp(10), 0, 0)
+            },
+        )
+        val textInput =
+            EditText(ctx).apply {
+                setText(content)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                minLines = 2
+                gravity = Gravity.TOP or Gravity.START
+            }
+        box.addView(textInput)
+
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(if (code.isEmpty()) R.string.dahi_manage_new else R.string.dahi_manage_edit)
