index 0000000..0a31900
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiPhraseSuggest.kt
@@ -0,0 +1,308 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import com.osfans.trime.util.appContext
+import org.json.JSONObject
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Locale
+
+/**
+ * 「常用词句」：统计反复手打的短句，供用户一键存成自定义短语。
+ *
+ * 隐私与体积：
+ * - 只存「短句 + 每天的次数」，不存上下文、不存光标前后的内容，不联网；
+ * - 最多 [MAX_ITEMS] 条，只保留最近 [WINDOW_DAYS] 天的日期桶，超出的每次写入时裁掉；
+ * - 已经存成短语的句子不再出现（读取时与短语库比对）。
+ */
+object DahiPhraseSuggest {
+    data class Item(
+        val text: String,
+        /** 近 90 天手打次数。 */
+        val count: Int,
+        val last: Long,
+    ) {
+        /** 如果早存成短语，这 90 天本来可以少打多少字（粗略：次数 × 字数）。 */
+        val saving: Int get() = count * text.length
+    }
+
+    private const val PREF = "dahi_phrase_suggest_pref"
+    private const val KEY_DATA = "data"
+    private const val KEY_ENABLED = "enabled"
+    private const val KEY_IGNORED = "ignored"
+
+    const val WINDOW_DAYS = 90
+    private const val MAX_ITEMS = 500
+    private const val MIN_LEN = 2
+
+    /**
+     * 记录上限故意放到 20：用户以后把「提示字数范围」调宽调窄都不需要重新积累数据，
+     * 展示时再按设置过滤。
+     */
+    private const val MAX_LEN = 20
+
+    const val MIN_LEN_DEFAULT = 2
+    const val MAX_LEN_DEFAULT = 16
+    const val LEN_LIMIT = 20
+
+    private const val KEY_MIN_LEN = "min_len"
+    private const val KEY_MAX_LEN = "max_len"
+
+    /**
+     * 默认门槛：逐字输入 2 次以上才值得提示（可调，见 [minCount]）。
+     *
+     * 门槛故意做成设置项：有人 2 次就想看到，有人只想被提醒「已经打了 5 次以上」的句子，
+     * 硬编码成 2 会让后一种用户的列表里全是噪音。
+     */
+    const val SHOW_THRESHOLD = 2
+    const val MIN_COUNT_MIN = 1
+    const val MIN_COUNT_MAX = 99
+
+    private const val KEY_MIN_COUNT = "min_count"
+
+    /** 当前的次数门槛（≥ N 次才展示）。 */
+    fun minCount(): Int = prefs().getInt(KEY_MIN_COUNT, SHOW_THRESHOLD).coerceIn(MIN_COUNT_MIN, MIN_COUNT_MAX)
+
+    fun setMinCount(value: Int) {
+        prefs().edit().putInt(KEY_MIN_COUNT, value.coerceIn(MIN_COUNT_MIN, MIN_COUNT_MAX)).apply()
+    }
+
+    // ---------------------------------------------------------------- 排序方式
+
+    /** 排序：按「存成短语后能省下多少字」降序（默认，最贴近真实收益）。 */
+    const val SORT_SAVING = 0
+
+    /** 排序：按「近 90 天逐字输入次数」降序。 */
+    const val SORT_COUNT = 1
+
+    /** 排序：按「最近一次逐字输入」降序。 */
+    const val SORT_RECENT = 2
+
+    private const val KEY_SORT = "sort_mode"
+
+    fun sortMode(): Int = prefs().getInt(KEY_SORT, SORT_SAVING).coerceIn(SORT_SAVING, SORT_RECENT)
+
+    fun setSortMode(value: Int) {
+        prefs().edit().putInt(KEY_SORT, value.coerceIn(SORT_SAVING, SORT_RECENT)).apply()
+    }
+
+    private val lock = Any()
+
+    private fun prefs() = appContext!!.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+
+    fun isEnabled(): Boolean = prefs().getBoolean(KEY_ENABLED, true)
+
+    /** 提示的最短字数。 */
+    fun minLen(): Int = prefs().getInt(KEY_MIN_LEN, MIN_LEN_DEFAULT).coerceIn(MIN_LEN, LEN_LIMIT)
+
+    /** 提示的最长字数（不会小于 [minLen]）。 */
+    fun maxLen(): Int = prefs().getInt(KEY_MAX_LEN, MAX_LEN_DEFAULT).coerceIn(minLen(), LEN_LIMIT)
+
+    /**
+     * 设置提示的字数范围。
+     *
+     * 允许 `min == max`：只想看「正好 7 个字」的句子也能做到。
+     */
+    fun setLenRange(
+        min: Int,
+        max: Int,
+    ) {
+        val lo = min.coerceIn(MIN_LEN, LEN_LIMIT)
+        val hi = max.coerceIn(lo, LEN_LIMIT)
+        prefs().edit().putInt(KEY_MIN_LEN, lo).putInt(KEY_MAX_LEN, hi).apply()
+    }
+
+    fun setEnabled(value: Boolean) {
+        prefs().edit().putBoolean(KEY_ENABLED, value).apply()
+        if (!value) clear()
+    }
+
+    fun ignored(): Set<String> = prefs().getStringSet(KEY_IGNORED, emptySet())?.toSet() ?: emptySet()
+
+    fun ignore(text: String) {
+        val set = ignored().toMutableSet()
+        set.add(text)
+        prefs().edit().putStringSet(KEY_IGNORED, set).apply()
+    }
+
+    fun unignore(text: String) {
+        val set = ignored().toMutableSet()
+        if (set.remove(text)) prefs().edit().putStringSet(KEY_IGNORED, set).apply()
+    }
+
+    fun clearIgnored() {
+        prefs().edit().remove(KEY_IGNORED).apply()
+    }
+
+    /** 已忽略的条目（按名字排序，供界面逐条恢复）。 */
+    fun ignoredList(): List<String> = ignored().sorted()
+
+    fun clear() {
+        prefs().edit().remove(KEY_DATA).apply()
+    }
+
+    /**
+     * 备份用：导出这份独立偏好里的全部内容。
+     *
+     * 包括：统计开关、逐字计数库（只有句子与每日次数）、字数范围、次数门槛、排序方式、已忽略名单。
+     * 这些都是「快打常用语」的全部状态，缺一项换机后都要重新配。
+     */
+    fun exportStateJson(): String {
+        val p = prefs()
+        val json = JSONObject()
+        p.all.forEach { (k, v) ->
+            when (v) {
+                is Boolean, is Int, is Long, is Float, is String -> json.put(k, v)
+                is Set<*> -> {
+                    val arr = org.json.JSONArray()
+                    v.forEach { arr.put(it.toString()) }
+                    json.put(k, arr)
+                }
+            }
+        }
+        return json.toString()
+    }
+
+    /** 备份还原：按已知键逐个写回（未知键忽略，兼容旧备份）。 */
+    fun importStateJson(raw: String) {
+        if (raw.isEmpty()) return
+        val json = runCatching { JSONObject(raw) }.getOrNull() ?: return
+        val e = prefs().edit()
+        if (json.has(KEY_ENABLED)) e.putBoolean(KEY_ENABLED, json.optBoolean(KEY_ENABLED, true))
+        if (json.has(KEY_DATA)) e.putString(KEY_DATA, json.optString(KEY_DATA, "{}"))
+        if (json.has(KEY_MIN_LEN)) e.putInt(KEY_MIN_LEN, json.optInt(KEY_MIN_LEN, MIN_LEN_DEFAULT))
+        if (json.has(KEY_MAX_LEN)) e.putInt(KEY_MAX_LEN, json.optInt(KEY_MAX_LEN, MAX_LEN_DEFAULT))
+        if (json.has(KEY_MIN_COUNT)) e.putInt(KEY_MIN_COUNT, json.optInt(KEY_MIN_COUNT, SHOW_THRESHOLD))
+        if (json.has(KEY_SORT)) e.putInt(KEY_SORT, json.optInt(KEY_SORT, SORT_SAVING))
+        if (json.has(KEY_IGNORED)) {
+            val arr = json.optJSONArray(KEY_IGNORED)
+            val set = HashSet<String>()
+            if (arr != null) for (i in 0 until arr.length()) set.add(arr.optString(i))
+            e.putStringSet(KEY_IGNORED, set)
+        }
+        e.apply()
+    }
+
+    /** 每次上屏时调用：符合条件的短句累加一次。 */
+    fun note(text: String) {
+        if (appContext == null) return
+        if (!isEnabled()) return
+        val t = text.trim()
+        if (!looksLikePhrase(t)) return
+        synchronized(lock) {
+            val root = load()
+            val today = dayKey()
+            val obj = root.optJSONObject(t) ?: JSONObject()
+            obj.put("n", obj.optInt("n") + 1)
+            obj.put("t", System.currentTimeMillis())
+            val recent = recentKeys()
+            val days = obj.optJSONObject("d") ?: JSONObject()
+            days.put(today, days.optInt(today) + 1)
+            // 裁掉 90 天以前的日期桶
+            val stale = days.keys().asSequence().filter { it !in recent }.toList()
+            stale.forEach { days.remove(it) }
+            obj.put("d", days)
+            root.put(t, obj)
+            trim(root)
+            prefs().edit().putString(KEY_DATA, root.toString()).apply()
+        }
+    }
+
+    /** 近 90 天手打次数。 */
+    fun count90(text: String): Int {
+        val o = load().optJSONObject(text.trim()) ?: return 0
+        return count90(o)
+    }
+
+    /** 可展示的建议（按次数降序，已忽略 / 已存成短语 / 不足门槛的都不返回）。 */
+    fun list(): List<Item> {
+        val root = load()
+        val ignored = ignored()
+        val phrases = runCatching { DahiCustomPhrase.all().values.toSet() }.getOrDefault(emptySet())
+        val minLen = minLen()
+        val maxLen = maxLen()
+        val out = ArrayList<Item>()
+        val keys = root.keys()
+        while (keys.hasNext()) {
+            val k = keys.next()
+            if (k in ignored || k in phrases) continue
+            if (k.length !in minLen..maxLen) continue
+            val o = root.optJSONObject(k) ?: continue
+            val c = count90(o)
+            if (c < minCount()) continue
+            out.add(Item(k, c, o.optLong("t")))
+        }
+        // 三种排序口径（界面可切换，默认「省字数」）：
+        //  · 省字数 = 次数 × 句长 —— 3 次 × 9 字（27）会排在 8 次 × 2 字（16）前面，
+        //    这是**有意为之**：存 2 字词的短语几乎省不下什么，存长句才划算；
+        //  · 次数 —— 最常见的「我打得最多的是哪句」；
+        //  · 最近 —— 最近在反复打的，往往是当下正需要的。
+        return when (sortMode()) {
+            SORT_COUNT -> out.sortedWith(compareByDescending<Item> { it.count }.thenByDescending { it.saving })
+            SORT_RECENT -> out.sortedWith(compareByDescending<Item> { it.last }.thenByDescending { it.count })
+            else -> out.sortedWith(compareByDescending<Item> { it.saving }.thenByDescending { it.count })
+        }
+    }
+
+    // ---------------------------------------------------------------- 内部
+
+    private fun load(): JSONObject = runCatching { JSONObject(prefs().getString(KEY_DATA, "{}").orEmpty()) }.getOrDefault(JSONObject())
+
+    private fun count90(o: JSONObject): Int {
+        val days = o.optJSONObject("d") ?: return 0
+        val recent = recentKeys()
+        var sum = 0
+        val keys = days.keys()
+        while (keys.hasNext()) {
+            val k = keys.next()
+            if (k in recent) sum += days.optInt(k)
+        }
+        return sum
+    }
+
+    /** 超过 [MAX_ITEMS] 时按最后使用时间淘汰最旧的。 */
+    private fun trim(root: JSONObject) {
+        if (root.length() <= MAX_ITEMS) return
+        val items =
+            root
+                .keys()
+                .asSequence()
+                .mapNotNull { k -> root.optJSONObject(k)?.let { k to it.optLong("t") } }
+                .sortedBy { it.second }
+                .toList()
+        items.take(root.length() - MAX_ITEMS).forEach { root.remove(it.first) }
+    }
+
+    private fun dayKey(): String = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(System.currentTimeMillis())
+
+    private fun recentKeys(): Set<String> {
+        val set = HashSet<String>(WINDOW_DAYS * 2)
+        val fmt = SimpleDateFormat("yyyy-MM-dd", Locale.US)
+        val cal = Calendar.getInstance()
+        repeat(WINDOW_DAYS) {
+            set.add(fmt.format(cal.time))
+            cal.add(Calendar.DAY_OF_YEAR, -1)
+        }
+        return set
+    }
+
+    private val NOT_PHRASE =
+        Regex("(?i)(https?://|ftp://|www\\.|@|\\d{6,})")
+
+    /** 像「值得存成短语」的句子：2~16 字、至少两个汉字、不是链接/邮箱/号码。 */
+    private fun looksLikePhrase(t: String): Boolean {
+        if (t.length !in MIN_LEN..MAX_LEN) return false
+        if (t.any { it == '\n' || it == '\r' || it == '\u3000' }) return false
+        val han = t.count { it in '\u4e00'..'\u9fff' }
+        if (han < 2) return false
+        if (NOT_PHRASE.containsMatchIn(t)) return false
+        if (t.all { it.isDigit() || it in "-+() .:/" }) return false
+        return true
+    }
+}
