+        content.addView(
+            infoRow(
+                ctx.getString(R.string.dahi_vs_threads),
+                ctx.getString(R.string.dahi_vs_threads_value),
+                note = ctx.getString(R.string.dahi_vs_todo),
+            ),
+        )
+        content.addView(
+            infoRow(
+                ctx.getString(R.string.dahi_vs_unload),
+                ctx.getString(R.string.dahi_vs_unload_value),
+                note = ctx.getString(R.string.dahi_vs_todo),
+            ),
+        )
+        content.addView(
+            infoRow(
+                ctx.getString(R.string.dahi_vs_itn),
+                ctx.getString(R.string.dahi_vs_itn_value),
+                note = ctx.getString(R.string.dahi_vs_todo),
+            ),
+        )
+        // ---- 输入行为（内置离线专属，外部联动不生效） ----
+        content.addView(hint(ctx.getString(R.string.dahi_vs_sub_input)))
+        content.addView(
+            switchRow(
+                title = ctx.getString(R.string.dahi_vs_trim_punct),
+                summary = ctx.getString(R.string.dahi_vs_trim_punct_summary),
+                getter = { AsrEnginePrefs.trimEndPunctuation(ctx) },
+            ) { on -> AsrEnginePrefs.setTrimEndPunctuation(ctx, on) },
+        )
+        content.addView(
+            switchRow(
+                title = ctx.getString(R.string.dahi_vs_keep_screen_on),
+                summary = null,
+                getter = { AsrEnginePrefs.keepScreenOn(ctx) },
+            ) { on -> AsrEnginePrefs.setKeepScreenOn(ctx, on) },
+        )
+        content.addView(
+            switchRow(
+                title = ctx.getString(R.string.dahi_vs_auto_enter),
+                summary = null,
+                getter = { AsrEnginePrefs.autoEnter(ctx) },
+            ) { on -> AsrEnginePrefs.setAutoEnter(ctx, on) },
+        )
+        content.addView(
+            switchRow(
+                title = ctx.getString(R.string.dahi_vs_tap_toggle),
+                summary = ctx.getString(R.string.dahi_vs_tap_toggle_summary),
+                getter = { AsrEnginePrefs.tapToToggle(ctx) },
+            ) { on -> AsrEnginePrefs.setTapToToggle(ctx, on) },
+        )
+        content.addView(
+            switchRow(
+                title = ctx.getString(R.string.dahi_vs_filter_silence),
+                summary = ctx.getString(R.string.dahi_vs_filter_silence_summary),
+                getter = { AsrEnginePrefs.filterSilence(ctx) },
+            ) { on -> AsrEnginePrefs.setFilterSilence(ctx, on) },
+        )
+
+        // ---- 录音与判停 ----
+        content.addView(hint(ctx.getString(R.string.dahi_vs_sub_record)))
+        content.addView(
+            switchRow(
+                title = ctx.getString(R.string.dahi_vs_auto_stop),
+                summary = ctx.getString(R.string.dahi_vs_auto_stop_summary),
+                getter = { AsrEnginePrefs.autoStop(ctx) },
+            ) { on -> AsrEnginePrefs.setAutoStop(ctx, on) },
+        )
+        content.addView(
+            sliderRow(
+                title = ctx.getString(R.string.dahi_vs_silence_ms),
+                min = 300,
+                max = 3000,
+                value = AsrEnginePrefs.silenceMs(ctx),
+                format = { ctx.getString(R.string.dahi_vs_ms_unit, it) },
+                enabled = AsrEnginePrefs.autoStop(ctx),
+            ) { v -> AsrEnginePrefs.setSilenceMs(ctx, v) },
+        )
+        content.addView(
+            sliderRow(
+                title = ctx.getString(R.string.dahi_vs_sensitivity),
+                min = 1,
+                max = 10,
+                value = AsrEnginePrefs.sensitivity(ctx),
+                format = { ctx.getString(R.string.dahi_vs_level_unit, it) },
+                enabled = AsrEnginePrefs.autoStop(ctx),
+            ) { v -> AsrEnginePrefs.setSensitivity(ctx, v) },
+        )
+    }
+
+    /** 滑杆行：标题 + 当前值 + SeekBar。 */
+    private fun sliderRow(
+        title: String,
+        min: Int,
+        max: Int,
+        value: Int,
+        format: (Int) -> String,
+        enabled: Boolean = true,
+        onChange: (Int) -> Unit,
+    ): LinearLayout {
+        val ctx = requireContext()
+        val box =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(0, ctx.dp(8), 0, ctx.dp(8))
+            }
+        val head =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+            }
+        head.addView(
+            TextView(ctx).apply {
+                text = title
+                textSize = 16f
+                setTextColor(if (enabled) titleColor() else disabledColor())
+            },
+            LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f),
+        )
+        val valueView =
+            TextView(ctx).apply {
+                text = format(value)
+                textSize = 13f
+                setTextColor(summaryColor())
+            }
+        head.addView(valueView)
+        box.addView(head)
+        box.addView(
+            SeekBar(ctx).apply {
+                this.max = max - min
+                progress = (value - min).coerceIn(0, max - min)
+                isEnabled = enabled
+                setOnSeekBarChangeListener(
+                    object : SeekBar.OnSeekBarChangeListener {
+                        override fun onProgressChanged(
+                            seekBar: SeekBar?,
+                            progressValue: Int,
+                            fromUser: Boolean,
+                        ) {
+                            val v = min + progressValue
+                            valueView.text = format(v)
+                            if (fromUser) onChange(v)
+                        }
+
+                        override fun onStartTrackingTouch(seekBar: SeekBar?) {}
+
+                        override fun onStopTrackingTouch(seekBar: SeekBar?) {}
+                    },
+                )
+            },
+        )
+        return box
+    }
+
+    private fun showModelPickerDialog() {
+        val ctx = requireContext()
+        val models = runCatching { AsrModelManager.list(ctx) }.getOrDefault(emptyList())
+        if (models.isEmpty()) return
+        val current = AsrEnginePrefs.currentModel(ctx).ifBlank { models.first().name }
+        val labels = models.map { "${it.displayName}（${it.sizeText}）" }.toTypedArray()
+        val checked = models.indexOfFirst { it.name == current }.coerceAtLeast(0)
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_vs_model_pick_title)
+            .setSingleChoiceItems(labels, checked) { dialog, which ->
+                AsrEnginePrefs.setCurrentModel(ctx, models[which].name)
+                dialog.dismiss()
+                build()
+            }.setNeutralButton(R.string.dahi_vs_model_manage_title) { _, _ -> showModelManageDialog() }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun showModelManageDialog() {
+        val ctx = requireContext()
+        val models = runCatching { AsrModelManager.list(ctx) }.getOrDefault(emptyList())
+        if (models.isEmpty()) return
+        val items = models.map { getString(R.string.dahi_vs_model_delete_one, it.name) } + getString(R.string.dahi_vs_model_delete_all)
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_vs_model_manage_title)
+            .setItems(items.toTypedArray()) { _, which ->
+                if (which < models.size) {
+                    val model = models[which]
+                    AlertDialog
+                        .Builder(ctx)
+                        .setMessage(getString(R.string.dahi_vs_model_delete_confirm, model.name))
+                        .setNegativeButton(android.R.string.cancel, null)
+                        .setPositiveButton(android.R.string.ok) { _, _ ->
+                            AsrModelManager.delete(ctx, model.name)
+                            Toast.makeText(ctx, R.string.dahi_vs_model_deleted, Toast.LENGTH_SHORT).show()
+                            build()
+                        }.show()
+                } else {
+                    confirmClearModels()
+                }
+            }.show()
+    }
+
+    private fun confirmClearModels() {
+        val ctx = requireContext()
+        AlertDialog
+            .Builder(ctx)
+            .setMessage(R.string.dahi_vs_model_delete_all_confirm)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                AsrModelManager.deleteAll(ctx)
+                Toast.makeText(ctx, R.string.dahi_vs_model_deleted, Toast.LENGTH_SHORT).show()
+                build()
+            }.show()
+    }
+
+    // ---------------- 首选语音输入法 ----------------
+
+    private fun voiceInputMethods(): List<Pair<InputMethodInfo, InputMethodSubtype>> = runCatching { InputMethodUtils.voiceInputMethods() }.getOrDefault(emptyList())
+
+    private fun currentPreferredVoiceInputLabel(): String {
+        val ctx = requireContext()
+        val pkg = general.preferredVoiceInput.getValue()
+        if (pkg.isNullOrEmpty()) return getString(R.string.dahi_vs_preferred_none)
+        val method = voiceInputMethods().firstOrNull { it.first.packageName == pkg } ?: return pkg
+        return runCatching { method.first.loadLabel(ctx.packageManager).toString() }.getOrDefault(pkg)
+    }
+
+    private fun showPreferredVoiceInputDialog() {
+        val ctx = requireContext()
+        val methods = voiceInputMethods()
+        val labels = methods.map { runCatching { it.first.loadLabel(ctx.packageManager).toString() }.getOrDefault(it.first.packageName) }
+        val currentPkg = general.preferredVoiceInput.getValue()
+        val checked = methods.indexOfFirst { it.first.packageName == currentPkg }
+        val withNone = labels + ctx.getString(R.string.dahi_vs_preferred_none)
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.preferred_voice_input)
+            .setSingleChoiceItems(withNone.toTypedArray(), if (checked >= 0) checked else labels.size) { dialog, which ->
+                general.preferredVoiceInput.setValue(if (which < methods.size) methods[which].first.packageName else "")
+                dialog.dismiss()
+                build()
+            }.show()
+    }
+
+    // ---------------- 颜色 ----------------
+
+    private fun titleColor(): Int = themeColor(android.R.attr.textColorPrimary, 0xDE000000.toInt())
+
+    private fun summaryColor(): Int = themeColor(android.R.attr.textColorSecondary, 0x8A000000.toInt())
+
+    private fun disabledColor(): Int = 0x66808080
+
+    private fun themeColor(
+        attr: Int,
+        fallback: Int,
+    ): Int = runCatching {
+        val tv = android.util.TypedValue()
+        requireContext().theme.resolveAttribute(attr, tv, true)
+        if (tv.resourceId != 0) androidx.core.content.ContextCompat.getColor(requireContext(), tv.resourceId) else tv.data
+    }.getOrDefault(fallback)
+}
