@@ -0,0 +1,767 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.os.Bundle
+import android.view.Gravity
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.BaseAdapter
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.SeekBar
+import android.widget.Switch
+import android.widget.TextView
+import androidx.appcompat.app.AlertDialog
+import androidx.fragment.app.Fragment
+import com.osfans.trime.R
+import com.osfans.trime.data.prefs.AppPrefs
+import com.osfans.trime.ime.custom.DahiColorPickerDialog
+import com.osfans.trime.ime.custom.DahiKeyEffectsConfig
+import com.osfans.trime.ime.custom.DahiKeyPalette
+import com.osfans.trime.ime.custom.DahiKeySound
+import splitties.dimensions.dp
+
+/**
+ * 大海版「指尖生花」：按键动效 / 音效 / 打字速度。
+ *
+ * 全部落在 [DahiKeyEffectsConfig]（默认 SharedPreferences），输入法端每次按键现读，
+ * 改完立刻生效，不需要重建输入视图。纯代码搭 UI（和「工具栏按钮」那页同一套做法），
+ * 没有布局 XML，少一层 inflate 出错的可能。
+ *
+ * 首页条目只有四个字（和「声情意象」对齐），副标题只在这里出现。
+ */
+class DahiKeyEffectsFragment : Fragment() {
+    private lateinit var content: LinearLayout
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        content =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(28))
+            }
+        return ScrollView(ctx).apply { addView(content) }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        build()
+    }
+
+    private fun build() {
+        val ctx = requireContext()
+        content.removeAllViews()
+
+        content.addView(heading(ctx.getString(R.string.dahi_ke_title)))
+        content.addView(hint(ctx.getString(R.string.dahi_ke_subtitle)))
+        content.addView(hint(ctx.getString(R.string.dahi_ke_desc)))
+
+        // 一键开关：关 = 全部关（含音效）；开 = 只开视觉，音效不动
+        addSwitch(
+            R.string.dahi_ke_master,
+            R.string.dahi_ke_master_summary,
+            { DahiKeyEffectsConfig.isAllOn() },
+        ) { on ->
+            if (on) DahiKeyEffectsConfig.setAllOn() else DahiKeyEffectsConfig.setAllOff()
+            build()
