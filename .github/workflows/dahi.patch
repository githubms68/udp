index 0000000..3ddd2eb
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiHomeSlogan.kt
@@ -0,0 +1,204 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.R
+import com.osfans.trime.util.appContext
+import org.json.JSONArray
+import java.util.Calendar
+
+/**
+ * 设置首页标题下方那句小字（首页标语）的存取（大海版）。
+ *
+ * 三种显示方式：
+ * - **单条固定**：[PREF_KEY] 存文本；`null` = 默认标语，`""` = 不显示，其它 = 自定义；
+ * - **每次随机**：[KEY_POOL] 存候选句子（JSON 数组），每次进入首页随机取一句；
+ * - **按时段切换**：[KEY_SLOTS] 存时段方案（每行 `起始小时-结束小时|文本`）。
+ *
+ * 全部存在默认 SharedPreferences（`dahi_` 前缀），随「首选项」一起进加密备份。
+ */
+object DahiHomeSlogan {
+    /** 单条模式的偏好键。 */
+    const val PREF_KEY = "dahi_home_slogan"
+
+    /** 显示方式：single / random / time。 */
+    const val KEY_MODE = "dahi_home_slogan_mode"
+
+    /** 随机池（JSON 数组）。 */
+    const val KEY_POOL = "dahi_home_slogan_pool"
+
+    /** 时段方案原文。 */
+    const val KEY_SLOTS = "dahi_home_slogan_slots"
+
+    /** 长句标语横向滚动播放的开关。 */
+    const val KEY_MARQUEE = "dahi_home_slogan_marquee"
+
+    /** 示例时段方案。 */
+    val DEFAULT_SLOTS: String =
+        """
+        5-9|清晨好，愿你今天的第一句话说给自己听。
+        9-12|上午好，专注比忙碌更重要。
+        12-14|午间小憩，别忘了抬头看看窗外。
+        14-18|下午好，慢下来也没关系。
+        18-23|夜色渐起，把想说的话好好说完。
+        23-5|夜深了，早点睡。
+        """.trimIndent()
+
+    enum class Mode { SINGLE, RANDOM, TIME }
+
+    /** 一个时段方案条目。 */
+    data class Slot(
+        val startHour: Int,
+        val endHour: Int,
+        val text: String,
+    ) {
+        fun matches(hour: Int): Boolean = if (startHour <= endHour) {
+            hour in startHour until endHour
+        } else {
+            hour >= startHour || hour < endHour
+        }
+    }
+
+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    /** 随机模式下本进程缓存的句子，避免同一个界面反复变化。 */
+    @Volatile
+    private var randomPick: String? = null
+
+    /** 原始设置值：null = 默认；"" = 隐藏；其它 = 自定义文本。 */
+    fun raw(): String? = prefs.getString(PREF_KEY, null)
+
+    /** 四条预设（第 1 条即默认值）。 */
+    fun presets(): List<String> = listOf(
+        R.string.dahi_slogan_preset_1,
+        R.string.dahi_slogan_preset_2,
+        R.string.dahi_slogan_preset_3,
+        R.string.dahi_slogan_preset_4,
+    ).map { appContext.getString(it) }
+
+    /** 默认标语。 */
+    fun defaultText(): String = appContext.getString(R.string.dahi_slogan_preset_1)
+
+    // ---------- 显示方式 ----------
+
+    fun mode(): Mode = when (prefs.getString(KEY_MODE, null)) {
+        "random" -> Mode.RANDOM
+        "time" -> Mode.TIME
+        else -> Mode.SINGLE
+    }
+
+    fun setMode(mode: Mode) {
+        prefs.edit {
+            if (mode == Mode.SINGLE) remove(KEY_MODE) else putString(KEY_MODE, mode.name.lowercase())
+        }
+        randomPick = null
+    }
+
+    // ---------- 随机池 ----------
+
+    fun pool(): List<String> {
+        val saved =
+            runCatching {
+                val raw = prefs.getString(KEY_POOL, null) ?: return@runCatching emptyList()
+                val arr = JSONArray(raw)
+                (0 until arr.length())
+                    .map { arr.optString(it) }
+                    .filter { it.isNotBlank() }
+            }.getOrDefault(emptyList())
+        return saved.ifEmpty { presets() }
+    }
+
+    fun setPool(list: List<String>) {
+        val clean = list.map { it.trim() }.filter { it.isNotEmpty() }.distinct()
+        prefs.edit { putString(KEY_POOL, JSONArray(clean).toString()) }
+        randomPick = null
+    }
+
+    // ---------- 时段方案 ----------
+
+    fun slotsRaw(): String = prefs.getString(KEY_SLOTS, null) ?: DEFAULT_SLOTS
+
+    fun setSlots(raw: String) {
+        prefs.edit { putString(KEY_SLOTS, raw) }
+    }
+
+    /** 解析时段方案；格式不对的行直接忽略（不会因为一行笔误整段失效）。 */
+    fun parseSlots(raw: String): List<Slot> = raw
+        .lineSequence()
+        .map { it.trim() }
+        .filter { it.isNotEmpty() && !it.startsWith("#") }
+        .mapNotNull { line ->
+            val bar = line.indexOf('|')
+            if (bar <= 0) return@mapNotNull null
+            val text = line.substring(bar + 1).trim().ifEmpty { return@mapNotNull null }
+            val range = line.substring(0, bar).trim()
+            val dash = range.indexOf('-')
+            if (dash <= 0) return@mapNotNull null
+            val start = range.substring(0, dash).trim().toIntOrNull() ?: return@mapNotNull null
+            val end = range.substring(dash + 1).trim().toIntOrNull() ?: return@mapNotNull null
+            if (start !in 0..23 || end !in 0..23) return@mapNotNull null
+            Slot(start, end, text)
+        }.toList()
+
+    /** 时段方案里不合法的行数（用于提示）。 */
+    fun invalidSlotLines(raw: String): Int = raw
+        .lineSequence()
+        .map { it.trim() }
+        .count { it.isNotEmpty() && !it.startsWith("#") && parseSlots(it).isEmpty() }
+
+    // ---------- 取值 ----------
+
+    /** 当前应显示的文本（空字符串表示不显示）。 */
+    fun resolve(): String = when (mode()) {
+        Mode.SINGLE -> raw() ?: defaultText()
+        Mode.RANDOM -> {
+            randomPick
+                ?: pool().let { if (it.isEmpty()) defaultText() else it.random() }
+                    .also { randomPick = it }
+        }
+        Mode.TIME -> {
+            val hour = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
+            parseSlots(slotsRaw()).firstOrNull { it.matches(hour) }?.text ?: defaultText()
+        }
+    }
+
+    /** 兼容旧调用点。 */
+    fun current(): String = resolve()
+
+    /** 让随机模式下一次取到新的句子（进入首页时调用）。 */
+    fun refreshRandom() {
+        randomPick = null
+    }
+
+    /** 写入单条模式的设置：null = 恢复默认。 */
+    fun set(value: String?) {
+        prefs.edit {
+            if (value == null) remove(PREF_KEY) else putString(PREF_KEY, value)
+        }
+    }
+
+    /** 全部恢复默认（单条模式 + 默认标语 + 清空随机池与时段方案）。 */
+
+    /** 长句标语是否横向滚动播放（默认开）。 */
+    fun marqueeEnabled(): Boolean = prefs.getBoolean(KEY_MARQUEE, true)
+
+    fun setMarqueeEnabled(value: Boolean) {
+        prefs.edit { putBoolean(KEY_MARQUEE, value) }
+    }
+
+    fun reset() {
+        prefs.edit {
+            remove(PREF_KEY)
+            remove(KEY_MODE)
+            remove(KEY_POOL)
+            remove(KEY_SLOTS)
+        }
+        randomPick = null
+    }
+}
