+    /** 网络权限逐条判断：申请了就照实写，没申请就是「未申请」。 */
+    private fun netPermLine(
+        s: Snapshot,
+        full: String,
+        shown: String,
+    ): String {
+        val has = s.perms.any { it == full }
+        val state =
+            if (has) {
+                // 这两个权限只允许「看网络状态」，不具备收发数据的能力；
+                // 它们常被 WorkManager 之类的库自动加进来，所以照实说明，不含糊
+                getString(R.string.dahi_privacy_perm_granted_readonly)
+            } else {
+                getString(R.string.dahi_privacy_perm_none)
+            }
+        return "  $shown  $state"
+    }
+
+    /** 权限 → 一句人话。未收录的留空（只显示权限名）。 */
+    private fun permUse(name: String): String =
+        when {
+            name.contains("VIBRATE") -> getString(R.string.dahi_privacy_perm_vibrate)
+            name.contains("RECORD_AUDIO") -> getString(R.string.dahi_privacy_perm_mic)
+            name.contains("POST_NOTIFICATIONS") -> getString(R.string.dahi_privacy_perm_notify)
+            name.contains("BOOT_COMPLETED") -> getString(R.string.dahi_privacy_perm_boot)
+            name.contains("EXTERNAL_SPEECH") -> getString(R.string.dahi_privacy_perm_speech)
+            else -> ""
+        }
+
+    private fun dataText(s: Snapshot): String =
+        buildString {
+            append(getString(R.string.dahi_privacy_data_total, fmtSize(s.totalBytes))).append("\n\n")
+            append(getString(R.string.dahi_privacy_data_clip, s.clipCount, fmtSize(s.dbBytes))).append("\n")
+            append(getString(R.string.dahi_privacy_data_stats, s.statsDays, fmtSize(s.statsBytes))).append("\n")
+            append(getString(R.string.dahi_privacy_data_pref, fmtSize(s.prefBytes))).append("\n")
+            append(getString(R.string.dahi_privacy_data_rime, fmtSize(s.rimeBytes))).append("\n\n")
+            append(getString(R.string.dahi_privacy_data_where))
+        }
+
+    /** 「备份体检」：最近一次加密导出了没有、备份提醒开没开、每日自动备份状态。 */
+    private fun backupCheckText(s: Snapshot): String {
+        val fmt = java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.getDefault())
+        val manual =
+            if (s.lastManualBackupMs > 0L) {
+                getString(R.string.dahi_privacy_last_export, fmt.format(java.util.Date(s.lastManualBackupMs)))
+            } else {
+                getString(R.string.dahi_privacy_last_export_none)
+            }
+        val remind =
+            if (s.remindOn) {
+                getString(R.string.dahi_privacy_remind_on, s.remindDays)
+            } else {
+                getString(R.string.dahi_privacy_remind_off)
+            }
+        val auto =
+            if (!s.autoBackupOn) {
+                getString(R.string.dahi_privacy_auto_off)
+            } else if (s.autoBackupCount <= 0) {
+                getString(R.string.dahi_privacy_auto_on_none, s.autoBackupKeep)
+            } else {
+                getString(
+                    R.string.dahi_privacy_auto_on,
+                    s.autoBackupKeep,
+                    fmt.format(java.util.Date(s.lastAutoBackupMs)),
+                )
+            }
+        return buildString {
+            appendLine(manual)
+            appendLine(remind)
+            append(auto)
+        }
+    }
+
+    // ------------------------------------------------------------------ 分享 / 导出
+
+    private fun shareImage(templateId: String) {
+        val data = snap ?: return
+        val ctx = requireContext()
+        runCatching {
+            val bitmap =
+                DahiPrivacyImage.render(
+                    ctx,
+                    DahiPrivacyImage.Data(
+                        netPermCount = data.netPerms.size,
+                        permCount = data.perms.size,
+                        totalBytes = data.totalBytes,
+                        clipCount = data.clipCount,
+                        collCount = data.collCount,
+                        statsDays = data.statsDays,
+                    ),
+                    templateId,
+                )
+            val dir = File(ctx.cacheDir, "privacy").apply { mkdirs() }
+            val file = File(dir, "dahi-privacy-${System.currentTimeMillis()}.png")
+            file.outputStream().use { out -> bitmap.compress(Bitmap.CompressFormat.PNG, 100, out) }
+            val uri = FileProvider.getUriForFile(ctx, "${ctx.packageName}.fileprovider", file)
+            val intent =
+                Intent(Intent.ACTION_SEND).apply {
+                    type = "image/png"
+                    putExtra(Intent.EXTRA_STREAM, uri)
+                    addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                }
+            startActivity(Intent.createChooser(intent, getString(R.string.dahi_privacy_share)))
+        }.onFailure {
+            Toast.makeText(ctx, R.string.dahi_privacy_failed, Toast.LENGTH_SHORT).show()
+        }
+    }
+
+    private fun buildReport(): String {
+        val s = snap ?: return getString(R.string.dahi_privacy_loading)
+        return buildString {
+            appendLine(getString(R.string.dahi_privacy_title))
+            appendLine("=".repeat(24))
+            appendLine(permText(s))
+            appendLine()
+            appendLine(dataText(s))
+            appendLine()
+            appendLine(getString(R.string.dahi_privacy_backup_section))
+            appendLine(backupCheckText(s))
+        }
+    }
+
+
+    /** 分享前先选配色模板（与统计图共用同一份选择，选过就记住）。 */
+    private fun pickTemplate(onPick: (String) -> Unit) {
+        val ctx = requireContext()
+        val templates = DahiStatsImage.Template.values()
+        val names = resources.getStringArray(R.array.dahi_stats_tpl_names)
+        val prefs = PreferenceManager.getDefaultSharedPreferences(ctx)
+        val saved = prefs.getString(KEY_TEMPLATE, DahiStatsImage.Template.DEEP.id)
+        val current = templates.indexOfFirst { it.id == saved }.coerceAtLeast(0)
+        androidx.appcompat.app.AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_stats_share_tpl)
+            .setSingleChoiceItems(names, current) { dialog, which ->
+                dialog.dismiss()
+                val template = templates[which]
+                prefs.edit { putString(KEY_TEMPLATE, template.id) }
+                onPick(template.id)
+            }.setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun dahiAccent(): Int = requireContext().styledColor(android.R.attr.colorAccent)
+
+    private fun sectionTitle(
+        ctx: android.content.Context,
+        titleRes: Int,
+    ): TextView =
+        TextView(ctx).apply {
+            setText(titleRes)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+            setTypeface(typeface, Typeface.BOLD)
+            setPadding(0, ctx.dp(18), 0, ctx.dp(4))
+        }
+}
