@@ -0,0 +1,294 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.util.AttributeSet
+import android.view.View
+import androidx.core.content.ContextCompat
+import com.osfans.trime.R
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+
+/**
+ * 词云（自绘，无动画）。
+ *
+ * 为什么这么实现：
+ * - **不做动画、不做随机飞入**：打开统计页时才画一次，滚动也不会重算（布局结果缓存），
+ *   所以耗电与常驻内存都可以忽略；
+ * - **布局用「螺旋 + 矩形碰撞」**：从中心往外绕，找到第一个不重叠的位置；
+ *   比力导向简单得多，效果也够看；
+ * - 字号按频次映射（最常用最大），颜色越常用越实。
+ */
+class DahiWordCloudView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+    private data class Placed(
+        val text: String,
+        val x: Float,
+        val baseline: Float,
+        val size: Float,
+        val color: Int,
+        /** 轻微倾斜（-7°~7°），高频词不转，让画面有错落感又不影响阅读。 */
+        val angle: Float = 0f,
+    )
+
+    /** 点击某个词时回调（查看该词的时间分布）。 */
+    var onWordClick: ((String) -> Unit)? = null
+
+    /** 是否让非高频词轻微倾斜（默认开）。 */
+    var showTilt: Boolean = true
+        set(value) {
+            if (field == value) return
+            field = value
+            // 倾斜影响排版（旋转后的包围盒不同），必须重排
+            placed = emptyList()
+            layoutWidth = 0
+            invalidate()
+        }
+
+    /** 是否给最高频的几个词画一层「浮起」阴影（默认开，可在统计页关掉）。 */
+    var showShadow: Boolean = true
+        set(value) {
+            if (field == value) return
+            field = value
+            invalidate()
+        }
+
+    /** 是否画一层极淡的径向光晕（默认关，用户可在统计页打开）。 */
+    var showGlow: Boolean = false
+        set(value) {
+            if (field == value) return
+            field = value
+            invalidate()
+        }
+
+    private var touchX = 0f
+    private var touchY = 0f
+
+    /** 词云阴影色：跟着主题深浅走（深色主题用亮影、浅色主题用暗影）。 */
+    private val cloudShadow: Int by lazy {
+        val textColor = runCatching { context.styledColor(android.R.attr.textColorPrimary) }.getOrDefault(0)
+        val lum = (
+            0.299 * android.graphics.Color.red(textColor) +
+                0.587 * android.graphics.Color.green(textColor) +
+                0.114 * android.graphics.Color.blue(textColor)
+        ) / 255.0
+        // textMain 亮 → 深色底 → 用白色阴影（像微光）；反之用黑色阴影（像影子）
+        if (lum > 0.5) 0x66FFFFFF else 0x66000000
+    }
+
+    private var words: List<Pair<String, Long>> = emptyList()
+
+    private var placed: List<Placed> = emptyList()
+
+    private var layoutWidth = 0
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    private val accent =
+        runCatching { context.styledColor(android.R.attr.colorAccent) }
+            .getOrElse { ContextCompat.getColor(context, android.R.color.holo_blue_dark) }
+
+    private val warm = 0xFFFF9A5B.toInt()
+
+    /** 第三档颜色：主强调色的淡一档版本，用于低频词。 */
+    private val accent2 =
+        (accent and 0x00FFFFFF) or (0xCC shl 24)
+
+    init {
+        // 必须可点击，否则 super.onTouchEvent 在 DOWN 就返回 false，performClick 永远不来
+        isClickable = true
+    }
+
+    fun submit(list: List<Pair<String, Long>>) {
+        words = list
+        placed = emptyList()
+        layoutWidth = 0
+        invalidate()
+    }
+
+    override fun onMeasure(
+        widthMeasureSpec: Int,
+        heightMeasureSpec: Int,
+    ) {
+        val width =
+            if (MeasureSpec.getMode(widthMeasureSpec) == MeasureSpec.UNSPECIFIED) {
+                dp(320)
+            } else {
+                MeasureSpec.getSize(widthMeasureSpec)
+            }
+        setMeasuredDimension(width, dp(230))
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (words.isEmpty()) return
+        if (placed.isEmpty() || layoutWidth != width) buildLayout()
+        if (showGlow) {
+            // 极淡的径向光晕：中心亮、边缘透明，给词云一点"浮起来"的感觉
+            val r = minOf(width, height) * 0.62f
+            val shader =
+                android.graphics.RadialGradient(
+                    width / 2f,
+                    height / 2f,
+                    r,
+                    intArrayOf((accent and 0x00FFFFFF) or (0x2A shl 24), 0x00000000),
+                    floatArrayOf(0f, 1f),
+                    android.graphics.Shader.TileMode.CLAMP,
+                )
+            paint.reset()
+            paint.isAntiAlias = true
+            paint.shader = shader
+            canvas.drawCircle(width / 2f, height / 2f, r, paint)
+            paint.shader = null
+        }
+        placed.forEachIndexed { index, item ->
+            paint.textSize = item.size
+            paint.color = item.color
+            // 长词细、短词粗：视觉上更"词云"
+            paint.typeface =
+                when {
+                    item.text.length <= 2 -> boldFace
+                    item.text.length == 3 -> normalFace
+                    else -> lightFace
+                }
+            // 最高频的前两个词加一层「极淡的浮起」：
+            // 深色主题用亮色阴影（看起来像微微发光），浅色主题用暗色阴影（像真的影子）。
+            // 这和分享图是同一套观感，不是两套东西。
+            paint.clearShadowLayer()
+            if (index < 2 && showShadow) {
+                runCatching { paint.setShadowLayer(dp(6f), 0f, dp(1.5f), cloudShadow) }
+            }
+            if (item.angle == 0f) {
+                canvas.drawText(item.text, item.x, item.baseline, paint)
+            } else {
+                // 围绕文字中心旋转，避免整块偏出预算位置
+                val cx = item.x + paint.measureText(item.text) / 2f
+                val cy = item.baseline - item.size * 0.35f
+                canvas.save()
+                canvas.rotate(item.angle, cx, cy)
+                canvas.drawText(item.text, item.x, item.baseline, paint)
+                canvas.restore()
+            }
+        }
+        paint.clearShadowLayer()
+    }
+
+    private val boldFace = android.graphics.Typeface.DEFAULT_BOLD
+
+    private val normalFace = android.graphics.Typeface.DEFAULT
+
+    private val lightFace =
+        runCatching { android.graphics.Typeface.create("sans-serif-light", android.graphics.Typeface.NORMAL) }
+            .getOrDefault(android.graphics.Typeface.DEFAULT)
+
+    // 触摸：交给系统判断「点击还是滑动」。
+    // 以前 onTouchEvent 对所有事件都返回 true，等于把这个区域从父容器的滚动里挖走了一块，
+    // 在词云上滑动时页面纹丝不动。现在改成 isClickable + performClick：
+    //   · 点击（UP 且没超过 touchSlop）→ View 自己调 performClick，我们在这里找词；
+    //   · 滑动 → 父容器在 onInterceptTouchEvent 里拦截，给本 View 发 CANCEL，performClick 不会触发。
+    override fun onTouchEvent(event: android.view.MotionEvent): Boolean {
+        if (event.actionMasked == android.view.MotionEvent.ACTION_DOWN) {
+            touchX = event.x
+            touchY = event.y
+        }
+        return super.onTouchEvent(event)
+    }
+
+    override fun performClick(): Boolean {
+        super.performClick()
+        val hit =
+            placed.asReversed().firstOrNull { item ->
+                paint.textSize = item.size
+                val w = paint.measureText(item.text)
+                val h = item.size * 1.2f
+                touchX >= item.x - 4 && touchX <= item.x + w + 4 &&
+                    touchY >= item.baseline - h && touchY <= item.baseline + item.size * 0.3f
+            }
+        hit?.let { onWordClick?.invoke(it.text) }
+        return true
+    }
+
+    /** 计算一次布局（结果缓存，滚动/重绘都不会重算）。 */
+    private fun buildLayout() {
+        val top = words.take(MAX_WORDS)
+        if (top.isEmpty() || width <= 0) return
+        val maxCount = (top.maxOfOrNull { it.second } ?: 1L).coerceAtLeast(1L)
+        val rects = ArrayList<RectF>(top.size)
+        val result = ArrayList<Placed>(top.size)
+        val centerX = width / 2f
+        val centerY = height / 2f
+        // 先大后小：大词占好位置，小词再去填缝
+        top.sortedByDescending { it.second }.forEachIndexed { rank, (word, count) ->
+            val norm = (count.toDouble() / maxCount).toFloat().coerceIn(0f, 1f)
+            val size = dp(12f) + (dp(22f) - dp(12f)) * norm
+            paint.textSize = size
+            val textWidth = paint.measureText(word)
+            val textHeight = size * 1.15f
+            var angle = 0f
+            var radius = 0f
+            var found = false
+            while (!found && radius < centerX + centerY) {
+                val cx = centerX + radius * kotlin.math.cos(angle.toDouble()).toFloat()
+                val cy = centerY + radius * kotlin.math.sin(angle.toDouble()).toFloat() * 0.62f
+                val rect = RectF(cx - textWidth / 2f, cy - textHeight / 2f, cx + textWidth / 2f, cy + textHeight / 2f)
+                val inside = rect.left >= 0f && rect.top >= 0f && rect.right <= width && rect.bottom <= height
+                if (inside && rects.none { RectF.intersects(it, rect) }) {
+                    rects.add(rect)
+                    result.add(
+                        Placed(
+                            text = word,
+                            x = rect.left,
+                            baseline = rect.bottom - size * 0.12f,
+                            size = size,
+                            color = colorForRank(rank, top.size),
+                            // 高频词保持水平（好读），中低频按词做稳定的小角度倾斜
+                            angle = if (!showTilt || norm > 0.6f) 0f else ((word.hashCode() % 13) - 6).toFloat(),
+                        ),
+                    )
+                    found = true
+                }
+                angle += 0.42f
+                radius += dp(2.4f)
+            }
+        }
+        placed = result
+        layoutWidth = width
+    }
+
+    /** 越常用越实、越偏暖色。 */
+    /**
+     * 按「排名」分档上色，而不是只看次数比例。
+     *
+     * 以前用 count / maxCount：刚开始用、每个词都只出现 1 次时，norm 全是 1，
+     * 于是整片词云一个颜色。改成按排位分三档，再叠加频次带来的透明度差异，
+     * 即使次数全相同也有层次。
+     */
+    private fun colorForRank(
+        rank: Int,
+        total: Int,
+    ): Int {
+        val pos = if (total <= 1) 0f else rank.toFloat() / (total - 1)
+        val base =
+            when {
+                pos < 0.34f -> warm
+                pos < 0.67f -> accent
+                else -> accent2
+            }
+        val alpha = (230 - 120 * pos).toInt().coerceIn(110, 255)
+        return (base and 0x00FFFFFF) or (alpha shl 24)
+    }
+
+    private companion object {
+        const val MAX_WORDS = 40
+    }
+}
