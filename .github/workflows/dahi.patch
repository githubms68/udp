+    // ------------------------------------------------------------------ 绘制
+
+    /** 画完一遍，返回内容总高度（画布是 1×1 时等价于「测量」）。 */
+    private fun draw(
+        canvas: Canvas,
+        m: Model,
+    ): Float {
+        val l = m.l
+        val canvasH = canvas.height.toFloat()
+        if (canvasH > 2f) {
+            val shader = LinearGradient(0f, 0f, 0f, canvasH, bgTop, bgBottom, Shader.TileMode.CLAMP)
+            canvas.drawRect(0f, 0f, WIDTH.toFloat(), canvasH, Paint().apply { this.shader = shader })
+        }
+
+        var y = PAD + 30f
+        canvas.drawText(l.title, PAD, y, tp(38f, textMain, true))
+        y += 38f
+        canvas.drawText(m.periodLabel, PAD, y, tp(23f, textDim))
+        if (m.dailyAvgText.isNotEmpty()) {
+            // 一句话，不加图表：最近 30 天有输入的那些天平均下来每天多少字
+            val avgPaint = tp(21f, warm)
+            val w = avgPaint.measureText(m.dailyAvgText)
+            val leftText = tp(23f, textDim).measureText(m.periodLabel)
+            // 左边那串太长就干脆不画，避免叠在一起
+            if (PAD + leftText + 28f + w <= WIDTH - PAD) {
+                canvas.drawText(m.dailyAvgText, WIDTH - PAD - w, y, avgPaint)
+            }
+        }
+
+        y += 24f
+        y = drawRankCard(canvas, y, m)
+        if (m.showChips) {
+            y += 16f
+            y = drawChipRow(canvas, y, m)
+        }
+        if (m.advice.isNotEmpty()) {
+            y += 14f
+            y = drawAdvice(canvas, y, m.advice)
+        }
+        y += 16f
+        y = drawCoreNumbers(canvas, y, m)
+
+        // 每一块都只看自己的开关：精简版也能自选要哪几块，不再由 detailed 一刀切
+        if (m.showSpeed) {
+            y += 16f
+            y = drawSpeedCard(canvas, y, m)
+        }
+        if (m.showCandidate) {
+            y += 16f
+            y = drawCandidateCard(canvas, y, m)
+        }
+        if (m.schemas.isNotEmpty()) {
+            y += 16f
+            y = drawSchemaCard(canvas, y, m)
+        }
+        val voice = m.voice
+        if (m.showVoice && voice != null && voice.count > 0L) {
+            y += 16f
+            y = drawVoiceCard(canvas, y, m, voice)
+        }
+        if (m.showHours && m.bucket.busiestHour() != null) {
+            y += 16f
+            y = drawHoursCard(canvas, y, m)
+        }
+        if (m.showDaily && m.dailyBars.isNotEmpty()) {
+            y += 16f
+            y = drawDailyCard(canvas, y, m)
+        }
+        if (m.showCloud && m.bucket.wordFreq.isNotEmpty()) {
+            y += 16f
+            y = drawCloudCard(canvas, y, m)
+        }
+        if (m.showDistribution) {
+            y += 16f
+            y = drawDistributionCard(canvas, y, m)
+        }
+        if (m.layout.isNotEmpty()) {
+            y += 16f
+            y = drawHeatCard(canvas, y, m)
+        }
+
+        // 38 → 46：logo 放大到 42 之后，间距得跟着加，否则会压到上一张卡的底边
+        y += 56f
+        val footerPaint = tp(26f, textMain, true)
+        canvas.drawText(m.footer, PAD, y, footerPaint)
+        val mark = m.mark
+        if (mark != null) {
+            val footerW = footerPaint.measureText(m.footer)
+            val size = 52f
+            // 兜底：文字太长时把 logo 拉回画布内，避免右侧被裁掉
+            val left = minOf(PAD + footerW + 10f, WIDTH - PAD - size)
+            val paint =
+                Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                    // 不再用 SRC_IN 单色着色：那会把太极的「阳金 / 阴铜」两色抹成同一种颜色，
+                    // 缩放之后看上去就是一坨实心圆球。这里保留矢量原色。
+                    // 浅色模板（宣纸）上金色偏淡，整体压暗一档，仍保留两色差异。
+                    if (lightBg) {
+                        colorFilter =
+                            android.graphics.ColorMatrixColorFilter(
+                                android.graphics.ColorMatrix().apply { setScale(0.82f, 0.80f, 0.74f, 1f) },
+                            )
