+ * 首页的视觉分组。
+ *
+ * 不改变任何入口的层级（用户明确要求不做抽屉聚合、不减少入口），
+ * 只在「相邻两项分组不同」的地方插一条横线 + 组名，把长列表切成几段。
+ * 分组跟随用户自定义顺序：谁被拖到哪，段就跟着变；
+ * 也可以在「设置项排序」页把某一项拖到别的组里（覆盖见 [HomeLayout.groupOf]）。
+ */
+enum class HomeGroup(
+    @StringRes val title: Int,
+) {
+    /** 方案与词库。 */
