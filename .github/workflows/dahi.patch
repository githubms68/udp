+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="dahi_plain_title">匯出為明文檔案（慎用！）</string>
+    <string name="dahi_plain_summary">把剪貼板/收藏夾/短語等資料匯出為明文可讀的文字或 CSV，方便在其他裝置使用</string>
