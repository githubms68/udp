+    private class ResultHolder(
+        val ui: ClipboardBeanUi,
+    ) : RecyclerView.ViewHolder(ui.root)
+
+    private val resultAdapter =
+        object : RecyclerView.Adapter<ResultHolder>() {
+            private val items = ArrayList<DatabaseBean>()
+
+            fun submit(list: List<DatabaseBean>) {
+                items.clear()
+                items.addAll(list)
+                // 长按菜单是 PopupMenu，关闭时会引发一次重新布局。
+                // 此刻同步 notifyDataSetChanged 会抛
+                // `IllegalStateException: Cannot call this method while RecyclerView
+                //  is computing a layout or scrolling` —— 输入法进程随之崩溃，
+                // 用户看到的就是「点删除，整个界面连键盘一起弹下去」。
+                // 注意：这里**不能**用 listView.post —— listView 的初始化器里
+                // 有 `adapter = resultAdapter`，而本对象又是 resultAdapter 的初始化器，
+                // 引用它会形成「属性类型互相推断」的死循环，Kotlin 直接报
+                // Type checking has run into a recursive problem。
+                // mainHandler 类型明确，post 一样是投递到下一轮消息。
+                mainHandler.post {
+                    runCatching { notifyDataSetChanged() }
+                }
+            }
+
+            /** 全部可见结果的 id（批量「全选」用）。 */
+            fun allIds(): List<Int> = items.map { it.id }
+
+            /** 单条 id 的正文（用于判断它属于剪贴板还是收藏夹）。 */
+            fun textOf(id: Int): String? = items.firstOrNull { it.id == id }?.text
+
+            /** 单条 id 的分类（分类菜单里勾出当前归属用）。 */
+            fun categoryOf(id: Int): String? = items.firstOrNull { it.id == id }?.category
+
+            /**
+             * 选中条目的正文，**按用户勾选的先后顺序**返回（批量拼接用）。
+             *
+             * selectedIds 是 LinkedHashSet，天然保存了勾选顺序 —— 用户先点哪条，
+             * 拼出来就在前面，这才是「拼接」该有的行为（按列表顺序反而要重排）。
+             */
+            fun textsInSelectionOrder(ids: Collection<Int>): List<String> {
+                val byId = items.associateBy { it.id }
+                return ids.mapNotNull { byId[it]?.text }.filter { it.isNotEmpty() }
+            }
+
+            fun notifyIdChanged(id: Int) {
+                val pos = items.indexOfFirst { it.id == id }
+                if (pos >= 0) notifyItemChanged(pos)
+            }
+
+            fun notifyAllChanged() = notifyDataSetChanged()
+
+            override fun getItemCount(): Int = items.size
+
+            override fun onCreateViewHolder(
+                parent: ViewGroup,
+                viewType: Int,
+            ): ResultHolder = ResultHolder(ClipboardBeanUi(parent.context, theme))
+
+            override fun onBindViewHolder(
+                holder: ResultHolder,
+                position: Int,
+            ) {
+                val bean = items[position]
+                val selected = batchMode && bean.id in selectedIds
+                // 与剪贴板窗口同一套摘要规则：超长时末尾带 "…"，提示用户可以「查看全文」
+                val lines = ClipboardBeanUi.entryLines()
+                val text = ClipboardBeanUi.excerpt(bean.text.orEmpty(), lines, lines * ClipboardBeanUi.charsPerLine())
+                holder.ui.setBean(text, bean.pinned, highlightTokens)
+                // 只有「全部」范围需要标注来源：单选一个库时，范围按钮已经说明了。
+                // 而且只在**这条也在收藏夹里**时才标：「全部」里绝大多数条目本来就来自
+                // 剪贴板，逐行挂个「剪」纯属噪音。所以只可能出现两种徽标 ——
+                // 「藏」（只在收藏）与「剪藏」（两边都有）。
+                val inClip = text in inClipTexts
+                val inFav = text in inFavTexts
+                holder.ui.setSourceBadge(
+                    when {
+                        scope != 0 -> null
+                        inFav && inClip -> ctx.getString(R.string.dahi_cp_badge_both)
+                        inFav -> ctx.getString(R.string.dahi_cp_badge_coll)
+                        else -> null
+                    },
+                )
+                holder.ui.setSelectionMark(batchMode, selected)
+                holder.ui.root.alpha = if (selected) 0.6f else 1f
+                holder.ui.root.setOnClickListener {
+                    if (batchMode) toggleSelection(bean.id) else pick(bean)
+                }
+                holder.ui.root.setOnLongClickListener { v ->
+                    if (batchMode) {
+                        toggleSelection(bean.id)
+                        return@setOnLongClickListener true
+                    }
+                    // v 是长按的那一行：菜单贴着它弹出（与原来的 PopupMenu 观感一致）
+                    showItemMenu(bean, isFavRow(text), v)
+                    true
+                }
+            }
+        }
