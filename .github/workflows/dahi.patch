+    const val KEY_HEART_SCALE = PREFIX + "heart_scale"
+    const val KEY_HEART_CYCLE = PREFIX + "heart_cycle"
+    const val KEY_GLYPH_TEXT_SIZE = PREFIX + "glyph_text_size"
+    const val KEY_GLYPH_PER_LINE = PREFIX + "glyph_per_line"
