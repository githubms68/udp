@@ -0,0 +1,65 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.view.View
+
+/**
+ * 按键事件总线：把「按下了哪个键」「上屏了什么」广播给动效层。
+ *
+ * 为什么不直接在动效层里监听：按键发生在 [com.osfans.trime.ime.keyboard.KeyView]
+ * （另一个模块），而上屏出口在 TrimeInputMethodService，两边都不该反过来依赖 UI 层。
+ * 用一个空实现也无所谓的 object 做中转，两边各挂一行，耦合最小。
+ */
+object DahiKeyEffectBus {
+    /** 上屏来源：用来决定「落字成句」按哪一类开关走。 */
+    enum class Source { KEY, VOICE, CLIPBOARD }
+
+    /**
+     * 待定的来源：剪贴板 / 语音的入口在 commit 前调用 [expectVoice] / [expectClipboard]，
+     * commit 时被 [consumeSource] 取走一次并复位。默认（没标记）= 键盘打字。
+     */
+    @Volatile
+    private var pendingSource: Source? = null
+
+    fun expectVoice() {
+        pendingSource = Source.VOICE
+    }
+
+    fun expectClipboard() {
+        pendingSource = Source.CLIPBOARD
+    }
+
+    /** 取走待定来源（取完即复位）。 */
+    fun consumeSource(): Source {
+        val source = pendingSource ?: Source.KEY
+        pendingSource = null
+        return source
+    }
+
+    /**
+     * 按键按下。
+     *
+     * @param view 被按的键 View（动效层据此算键位中心）。
+     * @param keyCode 该键的 [android.view.KeyEvent] code —— 「落字成句」要靠它分辨
+     *   这是编码键、数字选字键还是空格/退格，从而决定每个字从哪个键起飞。
+     */
+    @Volatile
+    var onKeyDown: ((View, Int) -> Unit)? = null
+
+    /** 有内容真正上屏（in = 上屏文本）。 */
+    @Volatile
+    var onCommit: ((String) -> Unit)? = null
+
+    fun dispatchKeyDown(view: View, keyCode: Int) {
+        onKeyDown?.invoke(view, keyCode)
+    }
+
+    fun dispatchCommit(text: String) {
+        onCommit?.invoke(text)
+    }
+}
