@@ -0,0 +1,196 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.graphics.drawable.GradientDrawable
+import android.os.Bundle
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import androidx.core.content.ContextCompat
+import androidx.fragment.app.Fragment
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiColorPickerDialog
+import com.osfans.trime.ime.custom.DahiUiTint
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+
+/**
+ * 「界面色调」独立页（大海版）。
+ *
+ * 原本寄生在「高级」里，只有一个对话框入口；现在系列调整把它提到首页「外观与手感」组，
+ * 顺便做成**带色块的列表**：一眼看清有哪几档、当前是哪一档，末尾还能自己取色。
+ *
+ * 它只影响**设置界面**（在 Activity 内容之上叠一层很淡的颜色），
+ * 不改主题、不改资源、也不碰键盘 — 键盘配色请用「样式编辑」。
+ */
+class DahiUiTintFragment : Fragment() {
+    private var container: LinearLayout? = null
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(24))
+            }
+
+        column.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_ui_tint_desc)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setTextColor(ctx.styledColor(android.R.attr.textColorSecondary))
+                setPadding(0, 0, 0, ctx.dp(10))
+            },
+        )
+
+        val box = LinearLayout(ctx).apply { orientation = LinearLayout.VERTICAL }
+        this.container = box
+        column.addView(box)
+
+        column.addView(
+            Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                setText(R.string.dahi_ui_tint_custom_add)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                gravity = Gravity.START
+                setPadding(0, ctx.dp(10), 0, 0)
+                setOnClickListener { pickCustom() }
+            },
+        )
+
+        return ScrollView(ctx).apply { addView(column) }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        reload()
+    }
+
+    override fun onResume() {
+        super.onResume()
+        // 从别的页面回来时可能已经变了（比如恢复了备份）
+        reload()
+    }
+
+    private fun reload() {
+        val ctx = requireContext()
+        val box = container ?: return
+        box.removeAllViews()
+        val current = DahiUiTint.color()
+        val names = resources.getStringArray(R.array.dahi_ui_tint_names)
+        DahiUiTint.presets.forEachIndexed { index, value ->
+            val name =
+                when {
+                    value == 0 -> names.getOrElse(0) { "" }
+                    else -> names.getOrElse(index) { "" }
+                }
+            box.addView(row(name, value, value == current) { applyColor(value) })
+        }
+        // 自定义色不在预设里，单独补一行
+        if (current != 0 && DahiUiTint.presets.indexOf(current) < 0) {
+            val hex = String.format(java.util.Locale.US, "#%08X", current)
+            box.addView(
+                row(
+                    getString(R.string.dahi_ui_tint_custom_name, hex),
+                    current,
+                    true,
+                ) { },
+            )
+        }
+        // 说明当前状态
+        box.addView(
+            TextView(ctx).apply {
+                text = getString(R.string.dahi_ui_tint_current_hint)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setTextColor(ctx.styledColor(android.R.attr.textColorSecondary))
+                setPadding(0, ctx.dp(8), 0, 0)
+            },
+        )
+    }
+
+    private fun row(
+        name: String,
+        value: Int,
+        selected: Boolean,
+        onClick: () -> Unit,
+    ): View {
+        val ctx = requireContext()
+        val row =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(0, ctx.dp(10), 0, ctx.dp(10))
+                isClickable = true
+                setOnClickListener { onClick() }
+            }
+        val size = ctx.dp(34)
+        row.addView(
+            View(ctx).apply {
+                layoutParams = LinearLayout.LayoutParams(size, size)
+                background =
+                    GradientDrawable().apply {
+                        shape = GradientDrawable.OVAL
+                        setColor(if (value == 0) 0x00000000 else value)
+                        setStroke(
+                            ctx.dp(1),
+                            if (selected) {
+                                ContextCompat.getColor(ctx, R.color.toolbarForegroundColor)
+                            } else {
+                                0x33000000
+                            },
+                        )
+                    }
+            },
+        )
+        row.addView(
+            TextView(ctx).apply {
+                text = name
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+                setPadding(ctx.dp(14), 0, 0, 0)
+                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+            },
+        )
+        if (selected) {
+            row.addView(
+                TextView(ctx).apply {
+                    text = "✓"
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+                    setPadding(ctx.dp(8), 0, 0, 0)
+                },
+            )
+        }
+        return row
+    }
+
+    private fun applyColor(value: Int) {
+        DahiUiTint.setColor(value)
+        runCatching { DahiUiTint.apply(requireActivity()) }
+        reload()
+    }
+
+    private fun pickCustom() {
+        val current = DahiUiTint.color().takeIf { it != 0 } ?: DahiUiTint.presets[1]
+        DahiColorPickerDialog(
+            requireContext(),
+            current,
+            onPicked = { color -> applyColor(color) },
+            onCleared = { applyColor(0) },
+        ).show()
+    }
+}
