+ */
+object DahiMenuConfig {
+    const val PREF_KEY = "dahi_menu_layout"
+
+    private const val KEY_ORDER = "order"
+    private const val KEY_HIDDEN = "hidden"
+
+    /** 一个可配置的菜单项（与 [SwitchOptionEntry.Static.Type] 一一对应）。 */
+    data class Item(
+        val type: SwitchOptionEntry.Static.Type,
+        @param:StringRes val labelRes: Int,
+        @param:DrawableRes val iconRes: Int,
+    )
+
+    /**
+     * 菜单里的全部固定条目（顺序 = 默认顺序）。
+     *
+     * 这里必须与 [SwitchOptionWindow.buildStaticEntries] 保持一致：
+     * 新增菜单项时两处都要加，否则设置页里看不到它。
+     */
+    val ALL: List<Item> = listOf(
+        Item(SwitchOptionEntry.Static.Type.ThemeList, R.string.theme, R.drawable.ic_baseline_color_lens_24),
+        Item(SwitchOptionEntry.Static.Type.SchemaList, R.string.schemata, R.drawable.ic_round_view_list_24),
+        Item(SwitchOptionEntry.Static.Type.UpdateConfig, R.string.deploy, R.drawable.ic_baseline_sync_24),
+        Item(SwitchOptionEntry.Static.Type.Keyboard, R.string.virtual_keyboard, R.drawable.ic_baseline_keyboard_24),
+        Item(
+            SwitchOptionEntry.Static.Type.FloatingKeyboard,
+            R.string.dahi_floating_keyboard_menu_on,
+            R.drawable.ic_dahi_resize_24,
+        ),
+        Item(
+            SwitchOptionEntry.Static.Type.VoiceImagery,
+            R.string.dahi_vi_menu_entry,
+            R.drawable.ic_dahi_music_note_24,
+        ),
+        Item(
+            SwitchOptionEntry.Static.Type.KeyboardEffects,
+            R.string.dahi_ke_title,
+            R.drawable.ic_dahi_keyfx_24,
+        ),
+        Item(
+            SwitchOptionEntry.Static.Type.KeyboardBackground,
+            R.string.dahi_keybg_title,
+            R.drawable.ic_dahi_background_24,
+        ),
+        Item(SwitchOptionEntry.Static.Type.KeyStyle, R.string.dahi_style_title, R.drawable.ic_dahi_style_24),
+        Item(
+            SwitchOptionEntry.Static.Type.CategoryManage,
+            R.string.dahi_cat_manage_title,
+            R.drawable.ic_baseline_snippet_folder_24,
+        ),
+        Item(SwitchOptionEntry.Static.Type.DahiManage, R.string.dahi_manage_title, R.drawable.ic_dahi_phrase_order_24),
+        Item(
+            SwitchOptionEntry.Static.Type.PhraseSuggest,
+            R.string.dahi_phrase_suggest_entry,
+            R.drawable.ic_dahi_kuaida_24,
+        ),
+        Item(SwitchOptionEntry.Static.Type.InputStats, R.string.dahi_stats_title, R.drawable.ic_dahi_stats),
+        Item(
+            SwitchOptionEntry.Static.Type.DahiToolbar,
+            R.string.dahi_toolbar_title,
+            R.drawable.ic_baseline_view_comfy_24,
+        ),
+    )
+
+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    private fun readArray(key: String): List<String> {
+        val raw = prefs.getString(PREF_KEY, null) ?: return emptyList()
+        val arr = runCatching { JSONObject(raw).optJSONArray(key) }.getOrNull() ?: return emptyList()
+        val list = ArrayList<String>(arr.length())
+        for (i in 0 until arr.length()) {
+            val v = arr.optString(i)
+            if (v.isNotEmpty()) list.add(v)
+        }
+        return list
+    }
+
+    private fun write(
+        order: List<String>,
+        hidden: List<String>,
+    ) {
+        val json = JSONObject()
+        json.put(KEY_ORDER, JSONArray(order))
+        json.put(KEY_HIDDEN, JSONArray(hidden))
+        prefs.edit { putString(PREF_KEY, json.toString()) }
+    }
+
+    fun order(): List<String> = readArray(KEY_ORDER)
+
+    fun hidden(): Set<String> = readArray(KEY_HIDDEN).toSet()
+
+    fun setOrder(value: List<String>) = write(value, hidden().toList())
+
+    fun setHidden(value: Set<String>) = write(order(), value.toList())
+
+    fun reset() {
+        prefs.edit { remove(PREF_KEY) }
+    }
+
+    /** 实际生效的顺序：用户排过的在前，没提过的按默认顺序追加，最后剔除隐藏项。 */
+    fun effectiveItems(): List<Item> {
+        val byType = ALL.associateBy { it.type.name }
+        val hidden = hidden()
+        val seen = HashSet<String>(ALL.size)
+        val out = ArrayList<Item>(ALL.size)
+        order().forEach { key ->
+            val item = byType[key] ?: return@forEach
+            if (item.type.name in hidden) return@forEach
+            if (seen.add(item.type.name)) out.add(item)
+        }
+        fillMissing(ALL, out, seen, hidden) { it.type.name }
+        return out
+    }
+
+    /**
+     * 把「用户没排过」的项插到它默认顺序里**前一个邻居**之后，而不是一律追加到末尾。
+     *
+     * 菜单新增条目时（例如 v6 的「指尖生花」），老用户保存过 order，
+     * 直接追加会让新项跑到最底部，和默认位置差很远。
+     */
+    private fun <T> fillMissing(
+        all: List<T>,
+        out: MutableList<T>,
+        seen: MutableSet<String>,
+        hidden: Set<String>,
+        nameOf: (T) -> String,
+    ) {
+        all.forEach { item ->
+            val name = nameOf(item)
+            if (name in hidden) return@forEach
+            if (!seen.add(name)) return@forEach
+            val defaultIndex = all.indexOfFirst { nameOf(it) == name }
+            var insertAt = out.size
+            for (i in defaultIndex - 1 downTo 0) {
+                val prevName = nameOf(all[i])
+                val pos = out.indexOfFirst { nameOf(it) == prevName }
+                if (pos >= 0) {
+                    insertAt = pos + 1
+                    break
+                }
+            }
+            out.add(insertAt, item)
+        }
+    }
+
+    /** 给菜单用：排序 + 过滤。 */
+    fun apply(entries: Array<SwitchOptionEntry.Static>): Array<SwitchOptionEntry.Static> {
+        val byKey = entries.associateBy { it.type.name }
+        val hidden = hidden()
+        val seen = HashSet<String>(entries.size)
+        val out = ArrayList<SwitchOptionEntry.Static>(entries.size)
+        order().forEach { key ->
+            val entry = byKey[key] ?: return@forEach
+            if (entry.type.name in hidden) return@forEach
+            if (seen.add(entry.type.name)) out.add(entry)
+        }
+        fillMissing(entries.toList(), out, seen, hidden) { it.type.name }
+        return out.toTypedArray()
+    }
+}
