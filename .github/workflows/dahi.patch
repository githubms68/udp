@@ -0,0 +1,32 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dahi
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.db.asr
+
+import android.content.Context
+import androidx.room.Database
+import androidx.room.Room
+import androidx.room.RoomDatabase
+
+/** 识别历史独立库（asr.db）。加字段时记得同步提升 version 并写 Migration。 */
+@Database(entities = [AsrHistoryBean::class], version = 1)
+abstract class AsrHistoryDatabase : RoomDatabase() {
+    abstract fun dao(): AsrHistoryDao
+
+    companion object {
+        private const val DB_NAME = "asr.db"
+
+        @Volatile
+        private var instance: AsrHistoryDatabase? = null
+
+        fun get(context: Context): AsrHistoryDatabase = instance ?: synchronized(this) {
+            instance ?: Room
+                .databaseBuilder(context.applicationContext, AsrHistoryDatabase::class.java, DB_NAME)
+                .build()
+                .also { instance = it }
+        }
+    }
+}
