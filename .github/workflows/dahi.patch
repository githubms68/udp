+            box.addView(detailLine(ctx.getString(R.string.dahi_ah_record), fmtSeconds(bean.durRecordMs), false))
+            box.addView(detailLine(ctx.getString(R.string.dahi_ah_asr), fmtSeconds(bean.durAsrMs), false))
