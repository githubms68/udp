--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiReportImage.kt
@@ -0,0 +1,317 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Shader
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiReport
+import java.text.DecimalFormat
+import java.util.Locale
+
+/**
+ * 年度 / 月度报告的分享长图。
+ *
+ * 与统计分享图的区别：这里不讲"今天打了多少"，而是讲"这一年你是怎么打字的"——
+ * 数字少、留白多、中间一条速度曲线，适合发朋友圈。
+ */
+object DahiReportImage {
+    private const val WIDTH = 1080
+    private const val PAD = 64f
+
+    private class Palette(
+        val bgTop: Int,
+        val bgBottom: Int,
+        val cardBg: Int,
+        val textMain: Int,
+        val textSub: Int,
+        val textDim: Int,
+        val accent: Int,
+        val warm: Int,
+    )
+
+    private fun paletteOf(id: String): Palette =
+        when (id) {
+            "ink" ->
+                Palette(
+                    Color.parseColor("#F7F7F4"), Color.parseColor("#ECEDE8"), Color.parseColor("#FFFFFF"),
+                    Color.parseColor("#1A1D22"), Color.parseColor("#565E6B"), Color.parseColor("#8A919D"),
+                    Color.parseColor("#2F6BFF"), Color.parseColor("#C2622A"),
+                )
+
+            "neon" ->
+                Palette(
+                    Color.parseColor("#07070C"), Color.parseColor("#120C1F"), Color.parseColor("#151021"),
+                    Color.parseColor("#FFFFFF"), Color.parseColor("#BBA9E6"), Color.parseColor("#7C6B9E"),
+                    Color.parseColor("#22D3EE"), Color.parseColor("#FBBF24"),
+                )
+
+            "sand" ->
+                Palette(
+                    Color.parseColor("#14110C"), Color.parseColor("#1E1911"), Color.parseColor("#221D15"),
+                    Color.parseColor("#FBF6EC"), Color.parseColor("#CDBFA8"), Color.parseColor("#94896F"),
+                    Color.parseColor("#E0A458"), Color.parseColor("#F2C14E"),
+                )
+
+            else ->
+                Palette(
+                    Color.parseColor("#0E1118"), Color.parseColor("#171E2B"), Color.parseColor("#1B2230"),
+                    Color.parseColor("#FFFFFF"), Color.parseColor("#98A4BC"), Color.parseColor("#6B7688"),
+                    Color.parseColor("#5B8CFF"), Color.parseColor("#FF9A5B"),
+                )
+        }
+
+    @Synchronized
+    fun render(
+        ctx: Context,
+        data: DahiReport.Data,
+        templateId: String,
+    ): Bitmap {
+        val p = paletteOf(templateId)
+        val height = draw(ctx, Canvas(Bitmap.createBitmap(1, 1, Bitmap.Config.ARGB_8888)), data, p, 0f)
+            .toInt()
+            .coerceIn(900, 6000)
+        val bitmap = Bitmap.createBitmap(WIDTH, height, Bitmap.Config.ARGB_8888)
+        draw(ctx, Canvas(bitmap), data, p, height.toFloat())
+        return bitmap
+    }
+
+    private fun tp(
+        size: Float,
+        color: Int,
+        bold: Boolean = false,
+    ): Paint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textSize = size
+            this.color = color
+            isFakeBoldText = bold
+        }
+
+    private fun num(v: Long): String = DecimalFormat("###,###").format(v)
+
+    /** 按像素宽度折行（与隐私图同一套实现）。 */
+    private fun wrapLines(
+        text: String,
+        paint: Paint,
+        maxWidth: Float,
+    ): List<String> {
+        val out = ArrayList<String>()
+        var line = StringBuilder()
+        text.replace("\r", "").split('\n').forEachIndexed { index, para ->
+            if (index > 0) {
+                out.add(line.toString())
+                line = StringBuilder()
+            }
+            para.forEach { ch ->
+                line.append(ch)
+                if (paint.measureText(line.toString()) > maxWidth) {
+                    line.deleteCharAt(line.length - 1)
+                    if (line.isNotEmpty()) out.add(line.toString())
+                    line = StringBuilder().append(ch)
+                }
+            }
+        }
+        if (line.isNotEmpty()) out.add(line.toString())
+        return out
+    }
+
+    private fun draw(
+        ctx: Context,
+        canvas: Canvas,
+        d: DahiReport.Data,
+        p: Palette,
+        canvasH: Float,
+    ): Float {
+        if (canvasH > 2f) {
+            val shader = LinearGradient(0f, 0f, 0f, canvasH, p.bgTop, p.bgBottom, Shader.TileMode.CLAMP)
+            canvas.drawRect(0f, 0f, WIDTH.toFloat(), canvasH, Paint().apply { this.shader = shader })
+        }
+
+        // ---------- 标题 ----------
+        var y = PAD + 30f
+        canvas.drawText(
+            ctx.getString(
+                if (d.scope == DahiReport.Scope.YEAR) R.string.dahi_report_img_title_year else R.string.dahi_report_img_title_month,
+                d.title,
+            ),
+            PAD,
+            y,
+            tp(54f, p.textMain, true),
+        )
+        // 右上角品牌标记
+        DahiMark.load(ctx)?.let { mark ->
+            val size = 44f
+            canvas.drawBitmap(
+                mark,
+                null,
+                RectF(WIDTH - PAD - size, PAD - 8f, WIDTH - PAD, PAD - 8f + size),
+                Paint(Paint.ANTI_ALIAS_FLAG),
+            )
+        }
+        y += 34f
+        val subPaint = tp(24f, p.textDim)
+        wrapLines(ctx.getString(R.string.dahi_stats_share_footer), subPaint, WIDTH - PAD * 2).forEach { line ->
+            canvas.drawText(line, PAD, y, subPaint)
+            y += 30f
+        }
+
+        // ---------- 四个数字 ----------
+        y += 40f
+        val cardH = 250f
+        canvas.drawRoundRect(
+            RectF(PAD, y, WIDTH - PAD, y + cardH),
+            28f,
+            28f,
+            Paint(Paint.ANTI_ALIAS_FLAG).apply { color = p.cardBg },
+        )
+        val cells =
+            listOf(
+                ctx.getString(R.string.dahi_report_chars) to num(d.chars),
+                ctx.getString(R.string.dahi_report_commits) to num(d.commits),
+                ctx.getString(R.string.dahi_report_hours) to String.format(Locale.US, "%.1f", d.activeMinutes / 60.0),
+                ctx.getString(R.string.dahi_report_speed) to String.format(Locale.US, "%.1f", d.avgSpeed),
+            )
+        val cellW = (WIDTH - PAD * 2 - 48f) / 2f
+        cells.forEachIndexed { i, (label, value) ->
+            val cx = PAD + 24f + (i % 2) * cellW
+            val cy = y + 66f + (i / 2) * 96f
+            canvas.drawText(label, cx, cy, tp(24f, p.textSub))
+            canvas.drawText(value, cx, cy + 40f, tp(40f, p.textMain, true))
+        }
+
+        // ---------- 速度曲线 ----------
+        y += cardH + 40f
+        canvas.drawText(ctx.getString(R.string.dahi_report_curve), PAD, y, tp(30f, p.textMain, true))
+        y += 24f
+        val curveH = 260f
+        val curveTop = y
+        val curveBottom = y + curveH
+        val pts = d.line
+        if (pts.size >= 2) {
+            val maxSpeed = (pts.maxOfOrNull { it.speed } ?: 1.0).coerceAtLeast(1.0)
+            val minNonZero = pts.map { it.speed }.filter { it > 0.0 }.minOrNull() ?: 0.0
+            val minSpeed = (minNonZero * 0.5).coerceAtMost(maxSpeed * 0.8)
+            fun px(i: Int): Float = PAD + (WIDTH - PAD * 2) * i / (pts.size - 1).toFloat()
+            fun py(v: Double): Float {
+                val t = ((v - minSpeed) / (maxSpeed - minSpeed)).coerceIn(0.0, 1.0)
+                return (curveBottom - curveH * t).toFloat()
+            }
+            val line = Path()
+            val fill = Path()
+            pts.forEachIndexed { i, pt ->
+                if (i == 0) {
+                    line.moveTo(px(i), py(pt.speed))
+                    fill.moveTo(px(i), curveBottom)
+                    fill.lineTo(px(i), py(pt.speed))
+                } else {
+                    line.lineTo(px(i), py(pt.speed))
+                    fill.lineTo(px(i), py(pt.speed))
+                }
+            }
+            fill.lineTo(px(pts.size - 1), curveBottom)
+            fill.close()
+            canvas.drawPath(
+                fill,
+                Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                    shader =
+                        LinearGradient(
+                            0f, curveTop, 0f, curveBottom,
+                            (p.accent and 0x00FFFFFF) or (0x55000000), 0x00000000, Shader.TileMode.CLAMP,
+                        )
+                },
+            )
+            canvas.drawPath(
+                line,
+                Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                    style = Paint.Style.STROKE
+                    strokeWidth = 4f
+                    color = p.accent
+                },
+            )
+            // 峰值标注
+            val peakIndex = pts.indices.maxByOrNull { pts[it].speed } ?: 0
+            canvas.drawText(
+                String.format(Locale.US, "%.0f", pts[peakIndex].speed),
+                (px(peakIndex) - 20f).coerceIn(PAD, WIDTH - PAD - 40f),
+                py(pts[peakIndex].speed) - 14f,
+                tp(24f, p.warm, true),
+            )
+            // 首尾标签
+            canvas.drawText(pts.first().label, PAD, curveBottom + 30f, tp(22f, p.textDim))
+            val lastLabel = pts.last().label
+            val lw = tp(22f, p.textDim).measureText(lastLabel)
+            canvas.drawText(lastLabel, WIDTH - PAD - lw, curveBottom + 30f, tp(22f, p.textDim))
+        } else {
+            canvas.drawText(ctx.getString(R.string.dahi_report_empty), PAD, y + 60f, tp(26f, p.textDim))
+        }
+
+        // ---------- 三个「最」 ----------
+        y = curveBottom + 80f
+        val hourText =
+            if (d.busiestHour >= 0) {
+                String.format(Locale.US, "%02d:00–%02d:00", d.busiestHour, (d.busiestHour + 1) % 24)
+            } else {
+                "—"
+            }
+        val lines =
+            listOf(
+                ctx.getString(R.string.dahi_report_busiest_day) to
+                    if (d.busiestDayChars > 0L) "${d.busiestDayLabel} · ${num(d.busiestDayChars)}" else "—",
+                ctx.getString(R.string.dahi_report_busiest_hour) to hourText,
+                ctx.getString(R.string.dahi_report_late) to "${d.lateDays}",
+                ctx.getString(R.string.dahi_report_streak) to "${d.streak}",
+            )
+        lines.forEach { (label, value) ->
+            canvas.drawText(label, PAD, y, tp(26f, p.textSub))
+            val vp = tp(28f, p.textMain, true)
+            val vw = vp.measureText(value)
+            canvas.drawText(value, WIDTH - PAD - vw, y, vp)
+            y += 56f
+        }
+
+        // ---------- 常用词 ----------
+        if (d.topWords.isNotEmpty()) {
+            y += 16f
+            canvas.drawText(ctx.getString(R.string.dahi_stats_wordcloud), PAD, y, tp(30f, p.textMain, true))
+            y += 46f
+            val words = d.topWords.take(10).joinToString(" · ") { it.first }
+            // 一次画不完就截断：分享图不是词典，够看就行
+            var text = words
+            val paint = tp(28f, p.accent)
+            while (text.length > 4 && paint.measureText(text) > WIDTH - PAD * 2) {
+                text = text.substring(0, text.length - 2)
+            }
+            canvas.drawText(text, PAD, y, paint)
+            y += 20f
+        }
+
+        // ---------- 收尾 ----------
+        y += 60f
+        canvas.drawText(ctx.getString(R.string.dahi_report_img_footer), PAD, y, tp(26f, p.textDim))
+
+        // 底部署名右侧的品牌标记
+        DahiMark.load(ctx)?.let { mark ->
+            val size = 52f
+            val footerW = tp(26f, p.textMain, true).measureText(ctx.getString(R.string.dahi_stats_share_footer))
+            val left = minOf(PAD + footerW + 12f, WIDTH - PAD - size)
+            canvas.drawBitmap(
+                mark,
+                null,
+                android.graphics.RectF(left, y - size + 8f, left + size, y + 8f),
+                Paint(Paint.ANTI_ALIAS_FLAG).apply { alpha = 220 },
+            )
+        }
+        return y + PAD
+    }
+}
