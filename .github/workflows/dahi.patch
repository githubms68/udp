@@ -0,0 +1,285 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import com.osfans.trime.util.appContext
+import org.json.JSONObject
+
+/**
+ * 自定义短语的使用统计与复习调度。
+ *
+ * 为什么要单独一份：短语「设了以后就忘」是这个功能最大的隐患 ——
+ * 短语越存越多，用户既不记得编码，也不知道哪些真在用。
+ * 这里保存四类事实，界面据此生成「已设短语」列表与复习队列：
+ *
+ * - [created]    什么时候设的（用于「本月新增」「设了 N 天还没用过」）
+ * - [usedCount]  用编码调出过几次（真正在用）
+ * - [lastUsed]   最后一次调出的时间（用于「快要忘记」）
+ * - [level]/[nextAt]  复习自评结果与下次该复习的时间（间隔重复的最小实现）
+ *
+ * **统计口径**（界面文案必须与之严格一致，避免歧义）：
+ * - 这里的次数只算「用短语编码调出整句」；
+ * - 「不用短语、逐字打出整句」的次数由 [DahiPhraseSuggest] 单独统计（近 90 天）。
+ */
+object DahiPhraseStats {
+    /** 短语的一条统计记录。 */
+    data class Meta(
+        val code: String,
+        val text: String,
+        val created: Long,
+        val usedCount: Int,
+        val lastUsed: Long,
+        /** 复习自评：0 = 还没复习过；1 = 记不牢；2 = 还行；3 = 很熟。 */
+        val level: Int,
+        val reviewCount: Int,
+        val nextAt: Long,
+    ) {
+        /** 从设下到现在多少天（不足一天算 1 天）。 */
+        val ageDays: Int get() = (((System.currentTimeMillis() - created).coerceAtLeast(0)) / DAY_MS + 1).toInt()
+
+        /** 从未调出过，或距上次调出超过 [FADE_DAYS] 天且调出次数很少 —— 「快要忘记」。 */
+        val fading: Boolean
+            get() {
+                if (ageDays < 2) return false
+                val since = if (lastUsed <= 0) created else lastUsed
+                val days = (System.currentTimeMillis() - since) / DAY_MS
+                return days >= FADE_DAYS && usedCount <= 3
+            }
+
+        /** 累计省下的字数（= 调出次数 × 句长）。 */
+        val savedChars: Int get() = usedCount * text.length
+
+        val due: Boolean get() = nextAt > 0 && nextAt <= System.currentTimeMillis()
+    }
+
+    data class Summary(
+        val total: Int,
+        val addedThisMonth: Int,
+        val savedChars: Int,
+        val neverUsed: Int,
+        val fading: Int,
+        val due: Int,
+    )
+
+    private const val PREF = "dahi_phrase_stats_pref"
+    private const val KEY_DATA = "data"
+
+    private const val DAY_MS = 24L * 60 * 60 * 1000
+
+    /** 超过这么多天没调出过，就算「快要忘记」。 */
+    const val FADE_DAYS = 30
+
+    private val lock = Any()
+
+    private fun prefs() = appContext!!.getSharedPreferences(PREF, Context.MODE_PRIVATE)
+
+    private fun load(): JSONObject = runCatching { JSONObject(prefs().getString(KEY_DATA, "{}").orEmpty()) }.getOrDefault(JSONObject())
+
+    private fun save(root: JSONObject) {
+        prefs().edit().putString(KEY_DATA, root.toString()).apply()
+    }
+
+    // ---------------------------------------------------------------- 写入
+
+    /** 短语被创建（或首次被本模块看到）：记下时间并按新建处理。 */
+    fun ensure(
+        code: String,
+        text: String,
+    ) {
+        if (code.isEmpty()) return
+        synchronized(lock) {
+            val root = load()
+            val obj = root.optJSONObject(code)
+            val now = System.currentTimeMillis()
+            if (obj == null) {
+                val fresh = JSONObject()
+                fresh.put("t", text)
+                fresh.put("c", now)
+                // 新短语第二天才进入复习队列，不用刚设完就被考
+                fresh.put("next", now + DAY_MS)
+                root.put(code, fresh)
+                save(root)
+            } else if (obj.optString("t") != text) {
+                // 同一编码换了正文 = 当新建：次数与复习进度清零
+                obj.put("t", text)
+                obj.put("c", now)
+                obj.put("cnt", 0)
+                obj.put("last", 0)
+                obj.put("lv", 0)
+                obj.put("rc", 0)
+                obj.put("next", now + DAY_MS)
+                root.put(code, obj)
+                save(root)
+            }
+        }
+    }
+
+    /**
+     * 用快打编码调出一次。
+     *
+     * [code] 传的是**运行时看到的输入串**（双拼方案会插空格/撇号，甚至不间断空格），
+     * 不能直接当键用 —— 必须宽松归一后到短语库里反查真实键，否则会写出一个
+     * 与短语对不上的孤立记录（立刻被 prune 掉，界面就永远是「从未调出过」）。
+     */
+    fun noteUsed(
+        code: String,
+        text: String,
+    ) {
+        if (code.isEmpty()) return
+        val key = resolveKey(code)
+        if (key.isEmpty()) return
+        synchronized(lock) {
+            val root = load()
+            val now = System.currentTimeMillis()
+            val obj = root.optJSONObject(key) ?: JSONObject()
+            if (obj.optString("t") != text) {
+                obj.put("t", text)
+                if (!obj.has("c")) obj.put("c", now)
+            }
+            obj.put("cnt", obj.optInt("cnt") + 1)
+            obj.put("last", now)
+            root.put(key, obj)
+            save(root)
+        }
+    }
+
+    /** 把运行时输入串归一成短语库里的真实键（找不到就用宽松形态）。 */
+    private fun resolveKey(code: String): String {
+        val phrases = runCatching { DahiCustomPhrase.all() }.getOrDefault(emptyMap())
+        if (phrases.isEmpty()) return ""
+        if (phrases.containsKey(code)) return code
+        val loose = DahiCustomPhrase.loose(code)
+        if (loose.isEmpty()) return ""
+        if (phrases.containsKey(loose)) return loose
+        return phrases.keys.firstOrNull { DahiCustomPhrase.loose(it) == loose } ?: loose
+    }
+
+    /** 复习后自评：[level] 1 = 记不牢 / 2 = 还行 / 3 = 很熟。 */
+    fun review(
+        code: String,
+        level: Int,
+    ) {
+        synchronized(lock) {
+            val root = load()
+            val obj = root.optJSONObject(code) ?: return@synchronized
+            val lv = level.coerceIn(1, 3)
+            val times = obj.optInt("rc") + 1
+            obj.put("lv", lv)
+            obj.put("rc", times)
+            obj.put("ra", System.currentTimeMillis())
+            // 间隔重复的最小实现：基础间隔按自评，熟练次数每多一次翻倍（上限 8 倍）
+            val base = when (lv) {
+                1 -> 1L
+                2 -> 3L
+                else -> 7L
+            }
+            val mul = 1L shl minOf(times, 4)
+            obj.put("next", System.currentTimeMillis() + base * mul * DAY_MS)
+            root.put(code, obj)
+            save(root)
+        }
+    }
+
+    /** 清掉已经不存在的短语（用户在短语管理里删了）。 */
+    private fun prune(
+        root: JSONObject,
+        alive: Set<String>,
+    ) {
+        val stale = root.keys().asSequence().filter { it !in alive }.toList()
+        if (stale.isEmpty()) return
+        stale.forEach { root.remove(it) }
+        save(root)
+    }
+
+    // ---------------------------------------------------------------- 读取
+
+    /** 全部已设短语的统计（与当前短语库对齐，缺失的自动补建）。 */
+    fun list(): List<Meta> {
+        val phrases = runCatching { DahiCustomPhrase.all() }.getOrDefault(emptyMap())
+        if (phrases.isEmpty()) return emptyList()
+        synchronized(lock) {
+            val root = load()
+            prune(root, phrases.keys)
+            val out = ArrayList<Meta>(phrases.size)
+            var dirty = false
+            phrases.forEach { (code, text) ->
+                val obj = root.optJSONObject(code) ?: JSONObject().also {
+                    val now = System.currentTimeMillis()
+                    it.put("t", text)
+                    it.put("c", now)
+                    it.put("next", now + DAY_MS)
+                    root.put(code, it)
+                    dirty = true
+                }
+                out.add(
+                    Meta(
+                        code = code,
+                        text = text,
+                        created = obj.optLong("c", System.currentTimeMillis()),
+                        usedCount = obj.optInt("cnt"),
+                        lastUsed = obj.optLong("last"),
+                        level = obj.optInt("lv"),
+                        reviewCount = obj.optInt("rc"),
+                        nextAt = obj.optLong("next"),
+                    ),
+                )
+            }
+            if (dirty) save(root)
+            return out.sortedWith(compareByDescending<Meta> { it.usedCount }.thenByDescending { it.savedChars })
+        }
+    }
+
+    /** 复习队列：到期的最多 [limit] 条（从未复习的新短语排在后面）。 */
+    fun dueList(limit: Int = 10): List<Meta> {
+        val now = System.currentTimeMillis()
+        return list()
+            .filter { it.nextAt > 0 && it.nextAt <= now }
+            .sortedBy { it.nextAt }
+            .take(limit)
+    }
+
+    fun summary(): Summary {
+        val all = list()
+        val monthStart =
+            runCatching {
+                val cal = java.util.Calendar.getInstance()
+                cal.set(java.util.Calendar.DAY_OF_MONTH, 1)
+                cal.set(java.util.Calendar.HOUR_OF_DAY, 0)
+                cal.set(java.util.Calendar.MINUTE, 0)
+                cal.set(java.util.Calendar.SECOND, 0)
+                cal.timeInMillis
+            }.getOrDefault(0L)
+        return Summary(
+            total = all.size,
+            addedThisMonth = all.count { it.created >= monthStart },
+            savedChars = all.sumOf { it.savedChars },
+            neverUsed = all.count { it.usedCount == 0 },
+            fading = all.count { it.fading },
+            due = all.count { it.due },
+        )
+    }
+
+    fun clear() {
+        prefs().edit().remove(KEY_DATA).apply()
+    }
+
+    /**
+     * 备份用：把整份统计（编码 → 正文 / 调出次数 / 上次调出 / 复习档位 / 下次复习）原样导出。
+     *
+     * 这一步让「换机后调出次数与复习进度不丢」成为可能 —— 在此之前这份数据只在本机，
+     * 用户换机时辛苦积累的「哪条快打真在用、哪条快忘了」会直接归零。
+     */
+    fun exportStateJson(): String = prefs().getString(KEY_DATA, "{}").orEmpty()
+
+    /** 备份还原：整份覆盖（不做合并 —— 计数是累计值，合并没有意义）。 */
+    fun importStateJson(raw: String) {
+        if (raw.isEmpty()) return
+        runCatching { JSONObject(raw) }.getOrNull() ?: return
+        prefs().edit().putString(KEY_DATA, raw).apply()
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiPhraseSuggest.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiPhraseSuggest.kt
