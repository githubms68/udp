+                if (newCode.isEmpty() || newText.isEmpty()) {
+                    Toast.makeText(ctx, R.string.dahi_manage_phrase_invalid, Toast.LENGTH_SHORT).show()
+                    return@setPositiveButton
+                }
+                if (DahiCustomPhrase.loose(newCode) != DahiCustomPhrase.loose(code)) {
+                    // 编码变了：先删旧键，避免留下一条永远打不出来的孤儿短语
+                    DahiCustomPhrase.remove(code)
+                }
+                DahiCustomPhrase.put(newCode, newText)
+                renderPhrase()
+            }.show()
+    }
