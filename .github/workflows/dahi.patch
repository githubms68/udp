+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.backup
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.BuildConfig
+import com.osfans.trime.data.db.ClipboardHelper
+import com.osfans.trime.data.db.CollectionHelper
+import com.osfans.trime.data.db.DatabaseBean
+import com.osfans.trime.ime.custom.DahiCandidateOrder
+import com.osfans.trime.ime.custom.DahiCustomPhrase
+import com.osfans.trime.ime.custom.DahiInputStats
+import com.osfans.trime.ime.custom.DahiKeyboardBackground
+import com.osfans.trime.ime.custom.DahiPhraseStats
+import com.osfans.trime.ime.custom.DahiPhraseSuggest
+import com.osfans.trime.ime.custom.DahiWordHidden
+import com.osfans.trime.ime.voice.VoiceImagery
+import com.osfans.trime.util.appContext
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.boolean
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.float
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.long
+import org.json.JSONObject
+
+/**
+ * 备份/还原的核心逻辑：收集首选项、剪贴板与收藏夹数据，并以加密方式编码/解码。
+ */
+object BackupManager {
+    private val json =
+        Json {
+            prettyPrint = true
+            encodeDefaults = true
+            ignoreUnknownKeys = true
+        }
+
+    suspend fun createBackup(
+        includePreferences: Boolean,
+        includeClipboard: Boolean,
+        includeCollection: Boolean,
+        includeVoiceImagery: Boolean = false,
+        includeCandidateOrder: Boolean = false,
+        includeCustomPhrase: Boolean = false,
+        includeKeyboardBackground: Boolean = false,
+        includeInputStats: Boolean = false,
+        includeWordHidden: Boolean = false,
+        includePhraseStats: Boolean = false,
+    ): BackupData = BackupData(
+        timestamp = System.currentTimeMillis(),
+        appVersion = BuildConfig.BUILD_VERSION_NAME,
+        preferences = if (includePreferences) exportPreferences() else null,
+        clipboard = if (includeClipboard) ClipboardHelper.exportBeans().map { it.toBackupBean() } else null,
+        collection = if (includeCollection) CollectionHelper.exportBeans().map { it.toBackupBean() } else null,
+        voiceImagery = if (includeVoiceImagery) exportVoiceImagery() else null,
+        candidateOrder = if (includeCandidateOrder) exportCandidateOrder() else null,
+        customPhrase = if (includeCustomPhrase) exportCustomPhrase() else null,
+        keyboardBackground = if (includeKeyboardBackground) DahiKeyboardBackground.exportStateJson() else null,
+        inputStats = if (includeInputStats) DahiInputStats.exportJson() else null,
+        wordHidden = if (includeWordHidden) exportWordHidden() else null,
+        phraseStats = if (includePhraseStats) exportPhraseStats() else null,
+    )
+
+    fun encode(
+        data: BackupData,
+        password: CharArray,
+    ): ByteArray = BackupCrypto.encrypt(json.encodeToString(data).toByteArray(Charsets.UTF_8), password)
+
+    fun decode(
+        bytes: ByteArray,
+        password: CharArray,
+    ): BackupData = json.decodeFromString(BackupCrypto.decrypt(bytes, password).toString(Charsets.UTF_8))
+
+    suspend fun applyBackup(
+        data: BackupData,
+        restorePreferences: Boolean,
+        restoreClipboard: Boolean,
+        restoreCollection: Boolean,
+        restoreVoiceImagery: Boolean = false,
+        restoreCandidateOrder: Boolean = false,
+        restoreCustomPhrase: Boolean = false,
+        mergeCustomPhrase: Boolean = false,
+        restoreKeyboardBackground: Boolean = false,
+        restoreInputStats: Boolean = false,
+        restoreWordHidden: Boolean = false,
+        restorePhraseStats: Boolean = false,
+    ) {
+        // 过滤条件必须与导出时**完全一致**：否则会出现
+        // 「只还原首选项、不还原键盘背景」时，背景的设置项被写回、图片却没回来 ——
+        // 设置指向一个不存在的图片槽，打开设置页就是一片空白。
+        // 还原前先把当前状态存一份（免密、私有目录），万一还原错了还有退路
+        runCatching { DahiAutoBackup.snapshot("还原") }
+        if (restorePreferences) data.preferences?.let { importPreferences(it) { key -> isPlainPreference(key) } }
+        if (restoreClipboard) data.clipboard?.let { beans -> ClipboardHelper.restoreBeans(beans.map { it.toBean() }) }
+        if (restoreCollection) data.collection?.let { beans -> CollectionHelper.restoreBeans(beans.map { it.toBean() }) }
+        if (restoreVoiceImagery) data.voiceImagery?.let { importPreferences(it) { key -> key.startsWith(VoiceImagery.KEY_PREFIX) } }
+        if (restoreCandidateOrder) data.candidateOrder?.let { importPreferences(it) { key -> key == DahiCandidateOrder.PREF_KEY } }
+        if (restoreKeyboardBackground) data.keyboardBackground?.let { DahiKeyboardBackground.importStateJson(it) }
+        if (restoreInputStats) data.inputStats?.let { DahiInputStats.importJson(it) }
+        if (restorePhraseStats) data.phraseStats?.let { importPhraseStats(it) }
+        if (restoreWordHidden) {
+            data.wordHidden?.let { prefs -> importPreferences(prefs) { key -> key == DahiWordHidden.PREF_KEY } }
+        }
+        if (restoreCustomPhrase) {
+            data.customPhrase?.let { prefs ->
+                if (mergeCustomPhrase) {
+                    // 合并：把备份里的短语并入本机（同码以备份为准），不删除本机已有的其它短语
+                    prefs[DahiCustomPhrase.PREF_KEY]?.let { DahiCustomPhrase.mergeJson(it.value.jsonPrimitive.contentOrNull) }
+                } else {
+                    importPreferences(prefs) { key -> key == DahiCustomPhrase.PREF_KEY }
+                }
+            }
+        }
+    }
+
+    private fun exportPreferences(): Map<String, BackupPreference> = exportPreferencesByFilter(::isPlainPreference)
+
+    /**
+     * 哪些偏好算「普通首选项」（与独立勾选项互斥）。
+     *
+     * 声情意象 / 键盘背景 / 候选排序 / 自定义短语都有各自的勾选项与字段，
+     * 必须从「首选项」里排除，导出与还原共用同一套判断，避免两端口径不一致。
+     */
+    private fun isPlainPreference(key: String): Boolean = !key.startsWith(VoiceImagery.KEY_PREFIX) &&
+        !key.startsWith(DahiKeyboardBackground.KEY_PREFIX) &&
+        key != DahiCandidateOrder.PREF_KEY &&
+        key != DahiCustomPhrase.PREF_KEY &&
+        key != DahiWordHidden.PREF_KEY
+
+    /** 单独导出声情意象参数，便于备份时独立勾选。 */
+    private fun exportVoiceImagery(): Map<String, BackupPreference> = exportPreferencesByFilter { key -> key.startsWith(VoiceImagery.KEY_PREFIX) }
+
+    /** 单独导出候选词排序，便于备份时独立勾选。 */
+    private fun exportCandidateOrder(): Map<String, BackupPreference> = exportPreferencesByFilter { key -> key == DahiCandidateOrder.PREF_KEY }
+
+    /** 单独导出词云隐藏名单，便于备份时独立勾选。 */
+    private fun exportWordHidden(): Map<String, BackupPreference> = exportPreferencesByFilter { key -> key == DahiWordHidden.PREF_KEY }
+
+    /** 单独导出客户端自定义短语，便于备份时独立勾选。 */
+    private fun exportCustomPhrase(): Map<String, BackupPreference> = exportPreferencesByFilter { key -> key == DahiCustomPhrase.PREF_KEY }
+
+    /**
+     * 快打统计：调出次数 / 复习进度 / 门槛与排序 / 已忽略名单。
+     *
+     * 这两份数据存在各自的独立偏好文件里（不进默认 SharedPreferences），
+     * 所以不会被「首选项」那一项带出去，必须单独打包。
+     */
+    private fun exportPhraseStats(): String {
+        val root = JSONObject()
+        root.put("stats", DahiPhraseStats.exportStateJson())
+        root.put("settings", JSONObject(DahiPhraseSuggest.exportStateJson()))
+        return root.toString()
+    }
+
+    private fun importPhraseStats(raw: String) {
+        val root = runCatching { JSONObject(raw) }.getOrNull() ?: return
+        root.optString("stats").takeIf { it.isNotEmpty() }?.let { DahiPhraseStats.importStateJson(it) }
+        root.optString("settings").takeIf { it.isNotEmpty() }?.let { DahiPhraseSuggest.importStateJson(it) }
+    }
+
+    private fun exportPreferencesByFilter(filter: (String) -> Boolean): Map<String, BackupPreference> {
+        val shared = PreferenceManager.getDefaultSharedPreferences(appContext)
+        val result = linkedMapOf<String, BackupPreference>()
+        shared.all.forEach { (key, value) ->
+            if (!filter(key)) return@forEach
+            when (value) {
+                is Boolean -> result[key] = BackupPreference("BOOLEAN", JsonPrimitive(value))
+                is Int -> result[key] = BackupPreference("INT", JsonPrimitive(value))
+                is Long -> result[key] = BackupPreference("LONG", JsonPrimitive(value))
+                is Float -> result[key] = BackupPreference("FLOAT", JsonPrimitive(value))
+                is String -> result[key] = BackupPreference("STRING", JsonPrimitive(value))
+                is Set<*> ->
+                    result[key] =
+                        BackupPreference("STRING_SET", JsonArray(value.map { JsonPrimitive(it.toString()) }))
+            }
+        }
+        return result
+    }
+
+    private fun importPreferences(
+        preferences: Map<String, BackupPreference>,
+        filter: (String) -> Boolean = { true },
+    ) {
+        val shared = PreferenceManager.getDefaultSharedPreferences(appContext)
+        shared.edit {
+            preferences.forEach { (key, pref) ->
+                if (!filter(key)) return@forEach
+                runCatching {
+                    when (pref.type) {
+                        "BOOLEAN" -> putBoolean(key, pref.value.jsonPrimitive.boolean)
+                        "INT" -> putInt(key, pref.value.jsonPrimitive.int)
+                        "LONG" -> putLong(key, pref.value.jsonPrimitive.long)
+                        "FLOAT" -> putFloat(key, pref.value.jsonPrimitive.float)
+                        "STRING" -> putString(key, pref.value.jsonPrimitive.contentOrNull)
+                        "STRING_SET" ->
+                            putStringSet(
+                                key,
+                                pref.value.jsonArray.mapNotNull { it.jsonPrimitive.contentOrNull }.toSet(),
+                            )
+                    }
+                }
+            }
+        }
+    }
+
+    private fun DatabaseBean.toBackupBean() = BackupBean(text, html, type.name, time, pinned, orderIndex, category, useCount)
+
+    private fun BackupBean.toBean() = DatabaseBean(
+        text = text,
+        html = html,
+        type = runCatching { DatabaseBean.BeanType.valueOf(type) }.getOrDefault(DatabaseBean.BeanType.TEXT),
+        time = time,
+        pinned = pinned,
+        orderIndex = orderIndex,
+        category = category,
+        useCount = useCount,
+    )
+}
