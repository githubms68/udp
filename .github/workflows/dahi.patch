+
+/**
+ * 年度回顾。
+ *
+ * 只读已有的每日历史与当年词频 —— **不新增采集、不新增存储**，
+ * 所以这个页面删掉也不会少任何一个数字。
+ */
+class DahiYearReviewFragment : Fragment() {
+    companion object {
+        /** 与「统计分享图」「输入报告」共用同一个模板偏好键：选过一次，三处都记住。 */
+        const val KEY_TEMPLATE = "dahi_stats_image_template"
+    }
+
+    private var offset = 0
+
+    /** 报告范围：本年度 / 本季度（自然季度）。 */
+    private var scope: DahiReport.Scope = DahiReport.Scope.YEAR
+    private var data: DahiReport.Data? = null
+    private var monthlyChars: LongArray = LongArray(12)
+
+    private lateinit var content: LinearLayout
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        content = LinearLayout(ctx).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(ctx, 20), dp(ctx, 16), dp(ctx, 20), dp(ctx, 32))
+        }
+        return ScrollView(ctx).apply {
+            addView(content, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        load()
+    }
+
+    private fun dp(
+        ctx: Context,
+        value: Int,
+    ): Int = (value * ctx.resources.displayMetrics.density + 0.5f).toInt()
+
+    private fun load() {
+        val ctx = requireContext()
+        val r = runCatching { DahiReport.build(ctx, scope, offset) }.getOrNull()
+        data = r
+        // 12 个月字数：从已有历史里取，不额外采集
+        val year = LocalDate.now().year - offset
+        val months = LongArray(12)
+        runCatching {
+            DahiDailyHistory.monthly(ctx).forEach { m ->
+                val y = m.month.substringBefore('-').toIntOrNull() ?: return@forEach
+                val mo = m.month.substringAfter('-').toIntOrNull() ?: return@forEach
+                if (y == year && mo in 1..12) months[mo - 1] = m.chars
+            }
+        }
+        monthlyChars = months
+        render()
+    }
+
+    private fun render() {
+        val ctx = requireContext()
+        content.removeAllViews()
+        val r = data
+
+        // 范围切换：本年度 / 本季度
+        val scopeRow = LinearLayout(ctx).apply {
+            orientation = LinearLayout.HORIZONTAL
+        }
+        addChip(scopeRow, ctx.getString(R.string.dahi_year_review_scope_year), scope == DahiReport.Scope.YEAR) {
+            if (scope != DahiReport.Scope.YEAR) {
+                scope = DahiReport.Scope.YEAR
+                offset = 0
+                load()
+            }
+        }
+        addChip(scopeRow, ctx.getString(R.string.dahi_year_review_scope_quarter), scope == DahiReport.Scope.QUARTER) {
+            if (scope != DahiReport.Scope.QUARTER) {
+                scope = DahiReport.Scope.QUARTER
+                offset = 0
+                load()
+            }
+        }
+        content.addView(scopeRow)
+
+        // 期次切换：本年 / 去年，或 本季度 / 上季度
+        val chips = LinearLayout(ctx).apply {
+            orientation = LinearLayout.HORIZONTAL
+            setPadding(0, dp(ctx, 8), 0, 0)
+        }
+        if (scope == DahiReport.Scope.QUARTER) {
+            addChip(chips, ctx.getString(R.string.dahi_year_review_this_quarter, quarterLabel(0)), offset == 0) {
+                offset = 0
+                load()
+            }
+            addChip(chips, ctx.getString(R.string.dahi_year_review_last_quarter, quarterLabel(1)), offset == 1) {
+                offset = 1
+                load()
+            }
+        } else {
+            val year = LocalDate.now().year
+            addChip(chips, ctx.getString(R.string.dahi_year_review_this_year, "$year"), offset == 0) {
+                offset = 0
+                load()
+            }
+            addChip(chips, ctx.getString(R.string.dahi_year_review_last_year, "${year - 1}"), offset == 1) {
+                offset = 1
+                load()
+            }
+        }
+        content.addView(chips)
+
+        if (r == null || r.chars <= 0L) {
+            content.addView(
+                TextView(ctx).apply {
+                    setText(R.string.dahi_year_review_empty)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+                    setTextColor(Color.GRAY)
+                    setPadding(0, dp(ctx, 28), 0, 0)
+                },
+            )
+            return
+        }
+
+        // 主数字
+        content.addView(
+            TextView(ctx).apply {
+                text = "${r.chars}"
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 44f)
+                setTypeface(typeface, android.graphics.Typeface.BOLD)
+                setPadding(0, dp(ctx, 20), 0, 0)
+            },
+        )
+        content.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_year_review_chars)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setTextColor(Color.GRAY)
+            },
+        )
+
+        // 摘要行
+        content.addView(
+            TextView(ctx).apply {
+                text =
+                    buildString {
+                        append(getString(R.string.dahi_year_review_days)).append(' ').append(r.days)
+                        append("    ")
+                        append(getString(R.string.dahi_year_review_speed)).append(' ')
+                        append(String.format(Locale.US, "%.1f", r.avgSpeed)).append(" 字/分")
+                        append("    ")
+                        append(getString(R.string.dahi_report_late)).append(' ').append(r.lateDays)
+                        append("    ")
+                        append(getString(R.string.dahi_year_review_streak)).append(' ').append(r.streak).append(" 天")
+                    }
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                setPadding(0, dp(ctx, 14), 0, dp(ctx, 8))
+            },
+        )
+
+        // 最忙的一天
+        if (r.busiestDayChars > 0L) {
+            content.addView(
+                TextView(ctx).apply {
+                    text = "${getString(R.string.dahi_year_review_busiest)}  ${r.busiestDayLabel} · ${r.busiestDayChars} 字"
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                    setTextColor(Color.GRAY)
+                    setPadding(0, dp(ctx, 4), 0, 0)
+                },
+            )
+        }
+
+        // 年度关键词
+        if (r.topWords.isNotEmpty()) {
+            content.addView(
+                TextView(ctx).apply {
+                    text =
+                        "${getString(R.string.dahi_year_review_keywords)}  " +
+                        r.topWords.take(8).joinToString(" · ") { it.first }
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                    setPadding(0, dp(ctx, 16), 0, 0)
+                },
+            )
+        }
+
+        // 分享按钮
+        content.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_year_review_share)
+                gravity = Gravity.CENTER
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+                setTextColor(Color.WHITE)
+                background =
+                    android.graphics.drawable.GradientDrawable().apply {
+                        cornerRadius = dp(ctx, 12).toFloat()
+                        setColor(0xFF3B82F6.toInt())
+                    }
+                setPadding(0, dp(ctx, 14), 0, dp(ctx, 14))
+                isClickable = true
+                setOnClickListener { share() }
+                layoutParams =
+                    LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ).apply { topMargin = dp(ctx, 24) }
+            },
+        )
+    }
+
+    private fun addChip(
+        parent: LinearLayout,
+        label: String,
+        active: Boolean,
+        onClick: () -> Unit,
+    ) {
+        val ctx = requireContext()
+        parent.addView(
+            TextView(ctx).apply {
+                text = label
+                gravity = Gravity.CENTER
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                setTextColor(if (active) Color.WHITE else Color.GRAY)
+                background =
+                    android.graphics.drawable.GradientDrawable().apply {
+                        cornerRadius = dp(ctx, 16).toFloat()
+                        setColor(if (active) 0xFF3B82F6.toInt() else 0x22808080)
+                    }
+                setPadding(dp(ctx, 16), dp(ctx, 8), dp(ctx, 16), dp(ctx, 8))
+                isClickable = true
+                setOnClickListener { onClick() }
+                layoutParams =
+                    LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ).apply { rightMargin = dp(ctx, 10) }
+            },
+        )
+    }
+
+    /** 季度标签，形如 `2026 Q4`；[back] 表示往前数几个季度。 */
+    private fun quarterLabel(back: Int): String {
+        val today = LocalDate.now()
+        val base = YearMonth.of(today.year, ((today.monthValue - 1) / 3) * 3 + 1)
+        val ym = base.minusMonths(3L * back)
+        return "${ym.year} Q${(ym.monthValue - 1) / 3 + 1}"
+    }
+
+    private fun share() {
+        val r = data ?: return
+        if (r.chars <= 0L) return
+        pickTemplate { templateId -> shareWith(templateId) }
+    }
+
+    /** 分享前先选配色模板（与统计分享图、输入报告共用同一份选择）。 */
+    private fun pickTemplate(onPick: (String) -> Unit) {
+        val ctx = requireContext()
+        val templates = DahiStatsImage.Template.values()
+        val names = resources.getStringArray(R.array.dahi_stats_tpl_names)
+        val prefs = PreferenceManager.getDefaultSharedPreferences(ctx)
+        val saved = prefs.getString(KEY_TEMPLATE, DahiStatsImage.Template.DEEP.id)
+        val current = templates.indexOfFirst { it.id == saved }.coerceAtLeast(0)
+        androidx.appcompat.app.AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_stats_share_tpl)
+            .setSingleChoiceItems(names, current) { dialog, which ->
+                dialog.dismiss()
+                val template = templates[which]
+                prefs.edit { putString(KEY_TEMPLATE, template.id) }
+                onPick(template.id)
+            }.setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun shareWith(templateId: String) {
+        val r = data ?: return
+        if (r.chars <= 0L) return
+        val ctx = requireContext()
+        val year =
+            if (scope == DahiReport.Scope.QUARTER) {
+                quarterLabel(offset)
+            } else {
+                "${LocalDate.now().year - offset}"
+            }
+        runCatching {
+            val bitmap: Bitmap = DahiYearReviewImage.render(ctx, year, r, monthlyChars, templateId)
+            val dir = File(ctx.cacheDir, "review").apply { mkdirs() }
+            val file = File(dir, "dahi-year-$year-${System.currentTimeMillis()}.png")
+            file.outputStream().use { out -> bitmap.compress(Bitmap.CompressFormat.PNG, 100, out) }
+            val uri = FileProvider.getUriForFile(ctx, "${ctx.packageName}.fileprovider", file)
+            val intent =
+                Intent(Intent.ACTION_SEND).apply {
+                    type = "image/png"
+                    putExtra(Intent.EXTRA_STREAM, uri)
+                    addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                }
+            startActivity(Intent.createChooser(intent, getString(R.string.dahi_year_review_share)))
+        }.onFailure {
+            Toast.makeText(ctx, R.string.dahi_year_review_failed, Toast.LENGTH_SHORT).show()
+        }
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ui/main/settings/DahiYearReviewImage.kt b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiYearReviewImage.kt
