+  -->
+
+<resources>
+    <!-- 按键动效与音效（大海版） -->
+    <string name="dahi_ke_title">Fingertip bloom</string>
+    <string name="dahi_ke_subtitle">Key effects · sounds · typing speed · characters dropping into a line</string>
+    <string name="dahi_ke_desc">Visual feedback while typing: a live speed ring, four tide shapes, eight press effects and colour schemes… Let your fingertips bloom and let characters drop into a line. Everything is drawn on one transparent layer above the keyboard, so it costs nothing when idle.</string>
+    <string name="dahi_ke_master">Master switch (excludes sound)</string>
+    <string name="dahi_ke_master_summary">Off = effects, speed visuals and sound all off. On = turn the visual ones back on and leave sound as you set it</string>
+    <string name="dahi_ke_enabled">Key press effects</string>
+    <string name="dahi_ke_enabled_summary">On by default. Turn off to keep the keyboard completely still</string>
+    <string name="dahi_ke_group_press">When you press</string>
+    <string name="dahi_ke_group_commit">When text is committed</string>
+    <string name="dahi_ke_style">Effect style</string>
+    <string name="dahi_ke_style_summary">This is what happens the moment you press a key. “Characters dropping into a line” (what happens when text is committed) has its own switch below, and the two stack</string>
+    <string name="dahi_ke_style_ripple">Ripple</string>
+    <string name="dahi_ke_style_water">Splash</string>
+    <string name="dahi_ke_style_star">Stardust</string>
+    <string name="dahi_ke_style_ink">Ink swirl</string>
+    <string name="dahi_ke_style_firefly">Fireflies</string>
+    <string name="dahi_ke_style_petal">Petals</string>
+    <string name="dahi_ke_style_spark">Diamond dust</string>
+    <string name="dahi_ke_style_echo">Sound wave</string>
+    <string name="dahi_ke_collect">Characters dropping into a line</string>
+    <string name="dahi_ke_collect_summary">On by default. Every committed character drops from the key it was pressed on and piles up into one line at the bottom — “big pearls and small pearls falling onto a jade plate”; stacks with any press effect above</string>
