+    /**
+     * 字数范围：直接填数字。
+     *
+     * 原来是两根滑杆 —— 滑杆的粒度由 max 决定（1–20 只能一格一格挪，想精确到某个值很费劲），
+     * 而且到底能调到多少还得先拖到头才知道。改成输入框后想填几就填几，边界写在提示里。
+     */
+    private fun promptLenRange() {
+        val ctx = requireContext()
+        val box =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(dp(20), dp(12), dp(20), dp(4))
+            }
+        val minInput = numberInput(DahiPhraseSuggest.minLen())
+        val maxInput = numberInput(DahiPhraseSuggest.maxLen())
+        box.addView(fieldLabel(getString(R.string.dahi_phrase_suggest_len_min_label)))
+        box.addView(minInput)
+        box.addView(fieldLabel(getString(R.string.dahi_phrase_suggest_len_max_label)))
+        box.addView(maxInput)
+        box.addView(
+            fieldHint(
+                getString(
+                    R.string.dahi_phrase_suggest_len_input_hint,
+                    DahiPhraseSuggest.MIN_LEN_DEFAULT,
+                    DahiPhraseSuggest.LEN_LIMIT,
+                ),
+            ),
+        )
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_phrase_suggest_len_title)
+            .setView(box)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val lo = minInput.text.toString().trim().toIntOrNull()
+                val hi = maxInput.text.toString().trim().toIntOrNull()
+                if (lo == null || hi == null) {
+                    Toast.makeText(ctx, R.string.dahi_phrase_suggest_number_bad, Toast.LENGTH_SHORT).show()
+                } else {
+                    DahiPhraseSuggest.setLenRange(lo, hi)
+                    picked.clear()
+                    rebuild()
+                }
+            }.show()
+    }
+
+    /** 次数门槛：直接填数字（默认 2，最大 99）。 */
+    private fun promptCountRange() {
+        val ctx = requireContext()
+        val box =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(dp(20), dp(12), dp(20), dp(4))
+            }
+        val input = numberInput(DahiPhraseSuggest.minCount())
+        box.addView(fieldLabel(getString(R.string.dahi_phrase_suggest_count_input_label)))
+        box.addView(input)
+        box.addView(
+            fieldHint(
+                getString(
+                    R.string.dahi_phrase_suggest_count_input_hint,
+                    DahiPhraseSuggest.MIN_COUNT_MIN,
+                    DahiPhraseSuggest.MIN_COUNT_MAX,
+                ),
+            ),
+        )
+        box.addView(fieldHint(getString(R.string.dahi_phrase_suggest_count_desc)))
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_phrase_suggest_count_title)
+            .setView(box)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val value = input.text.toString().trim().toIntOrNull()
+                if (value == null || value < DahiPhraseSuggest.MIN_COUNT_MIN) {
+                    Toast.makeText(ctx, R.string.dahi_phrase_suggest_number_bad, Toast.LENGTH_SHORT).show()
+                } else {
+                    DahiPhraseSuggest.setMinCount(value)
+                    picked.clear()
+                    rebuild()
+                }
+            }.show()
+    }
