+    private fun startReview(dueOnly: Boolean) {
+        reviewList =
+            if (dueOnly) {
+                DahiPhraseStats.dueList(10)
+            } else {
+                DahiPhraseStats.list().shuffled().take(10)
+            }
+        reviewIndex = 0
+        reviewDone = 0
+        reviewShown = false
+        reviewInput = ""
+        reviewRight = false
+        reviewWrong = false
+        rebuild()
+    }
+
+    private fun renderReview() {
+        val ctx = requireContext()
+        val box = bodyBox ?: return
+        if (reviewList.isEmpty()) {
+            box.addView(
+                TextView(ctx).apply {
+                    setText(R.string.dahi_phrase_review_empty)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                    setPadding(0, dp(16), 0, dp(8))
+                },
+            )
+            box.addView(
+                Button(ctx).apply {
+                    setText(R.string.dahi_phrase_review_any)
+                    setOnClickListener { startReview(dueOnly = false) }
+                },
+            )
+            return
+        }
+        val meta = reviewList[reviewIndex.coerceIn(0, reviewList.size - 1)]
+        box.addView(
+            TextView(ctx).apply {
+                text =
+                    getString(
+                        R.string.dahi_phrase_review_progress,
+                        reviewIndex + 1,
+                        reviewList.size,
+                        reviewDone,
+                    )
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setTextColor(dahiAccent())
+            },
+        )
+        // 正文大字
+        box.addView(
+            TextView(ctx).apply {
+                text = meta.text
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 26f)
+                setTypeface(typeface, Typeface.BOLD)
+                setPadding(0, dp(18), 0, dp(10))
+            },
+        )
+        val revealed = reviewRight || reviewShown
+        if (revealed) {
+            box.addView(
+                TextView(ctx).apply {
+                    text = getString(R.string.dahi_phrase_saved_code, meta.code)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f)
+                    setTypeface(typeface, Typeface.BOLD)
+                    setTextColor(dahiAccent())
+                },
+            )
+            if (reviewRight) {
+                box.addView(
+                    TextView(ctx).apply {
+                        text = getString(R.string.dahi_phrase_review_right, meta.code)
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                        setTextColor(0xFF2E9E5B.toInt())
+                        setPadding(0, dp(4), 0, 0)
+                    },
+                )
+            }
+            box.addView(
+                TextView(ctx).apply {
+                    text =
+                        getString(R.string.dahi_phrase_saved_used, meta.usedCount) +
+                        " · " + getString(R.string.dahi_phrase_saved_manual, manualCount(meta.text))
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                    setPadding(0, dp(4), 0, dp(10))
+                },
+            )
+            box.addView(
+                LinearLayout(ctx).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    addView(reviewButton(R.string.dahi_phrase_review_hard, 1, meta.code))
+                    addView(reviewButton(R.string.dahi_phrase_review_ok, 2, meta.code))
+                    addView(reviewButton(R.string.dahi_phrase_review_easy, 3, meta.code))
+                },
+            )
+            box.addView(
+                TextView(ctx).apply {
+                    setText(R.string.dahi_phrase_review_tip)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 11f)
+                    setPadding(0, dp(10), 0, 0)
+                },
+            )
+            return
+        }
+        // 打字测试：直接在设置页把编码敲出来，比「干想」记得牢
+        val input =
+            EditText(ctx).apply {
+                hint = getString(R.string.dahi_phrase_review_input)
+                inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+                setSingleLine()
+                setText(reviewInput)
+                setSelection(text.length)
+                setPadding(dp(10), dp(8), dp(10), dp(8))
+                doAfterTextChanged { reviewInput = it?.toString().orEmpty() }
+            }
+        box.addView(input)
+        box.addView(
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                setPadding(0, dp(8), 0, 0)
