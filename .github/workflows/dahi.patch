+    private fun permText(s: Snapshot): String {
+        val sb = StringBuilder()
+        sb.append(getString(R.string.dahi_privacy_perm_total, s.perms.size)).append("\n\n")
+        s.perms.forEach { full ->
+            // 只去掉 android.permission. 前缀：自定义权限（如 asrkb 的）要保留包名，
+            // 否则两个不同 App 定义的同名权限看起来像「重复了一遍」
+            val shown = full.removePrefix("android.permission.")
+            sb.append("· ").append(shown)
+            val use = permUse(shown)
+            if (use.isNotEmpty()) sb.append("  —— ").append(use)
+            sb.append("\n")
+        }
+        sb.append("\n").append(getString(R.string.dahi_privacy_perm_net_title)).append("\n")
+        sb.append(netPermLine(s, "android.permission.INTERNET", "INTERNET"))
+        sb.append("\n")
+        sb.append(netPermLine(s, "android.permission.ACCESS_NETWORK_STATE", "ACCESS_NETWORK_STATE"))
