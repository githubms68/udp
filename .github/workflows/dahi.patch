+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.Typeface
+import android.os.Bundle
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import androidx.core.content.FileProvider
+import androidx.core.content.edit
+import androidx.fragment.app.Fragment
+import androidx.lifecycle.lifecycleScope
+import androidx.preference.PreferenceManager
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiReport
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+import java.io.File
+import java.text.DecimalFormat
+
+/**
+ * 「输入报告」页：本月 / 今年，还有往期。
+ *
+ * 数据全部来自每日历史，不新增采集；页面本身只做聚合展示，
+ * 真正会传播出去的是底部那张分享长图。
+ */
+class DahiReportFragment : Fragment() {
+    private companion object {
+        const val KEY_TEMPLATE = "dahi_stats_image_template"
+    }
+
+    private var scope = DahiReport.Scope.MONTH
+    private var offset = 0
+    private var data: DahiReport.Data? = null
+
+    private var monthChip: TextView? = null
+    private var yearChip: TextView? = null
+    private var prevButton: TextView? = null
+    private var titleView: TextView? = null
+    private var statsView: TextView? = null
+    private var rhythmView: TextView? = null
+    private var wordsView: TextView? = null
+    private var chart: DahiLineChartView? = null
+    private var shareButton: Button? = null
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(24))
+            }
+
+        // ---------- 范围切换 ----------
+        val chips =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+            }
+        val month = chip(ctx, R.string.dahi_report_month) { switchTo(DahiReport.Scope.MONTH) }
+        val year = chip(ctx, R.string.dahi_report_year) { switchTo(DahiReport.Scope.YEAR) }
+        monthChip = month
+        yearChip = year
+        chips.addView(month)
+        chips.addView(year)
+        prevButton =
+            TextView(ctx).apply {
+                setText(R.string.dahi_report_prev)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+                // 弱色：和「本月 / 今年」的选中态区分开
+                setTextColor(dahiText2())
+                setPadding(ctx.dp(10), ctx.dp(6), ctx.dp(10), ctx.dp(6))
+            }
+        prevButton?.let { chips.addView(it) }
+        column.addView(chips)
+
+        // ---------- 标题 ----------
+        titleView =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 22f)
+                setTypeface(typeface, Typeface.BOLD)
+                setPadding(0, ctx.dp(10), 0, 0)
+            }
+        column.addView(titleView)
+
+        // ---------- 数字 ----------
+        statsView =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                setLineSpacing(ctx.dp(5).toFloat(), 1f)
+                setPadding(0, ctx.dp(8), 0, 0)
+            }
+        column.addView(statsView)
+
+        // ---------- 速度曲线 ----------
+        column.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_report_curve)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                setTypeface(typeface, Typeface.BOLD)
+                setPadding(0, ctx.dp(18), 0, ctx.dp(4))
+            },
+        )
+        chart =
+            DahiLineChartView(ctx).apply {
+                setAccent(dahiAccent())
+                setLabelColor(dahiText2())
+                layoutParams =
+                    LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            }
+        chart?.let { column.addView(it) }
+
+        // ---------- 节奏 ----------
+        rhythmView =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                setLineSpacing(ctx.dp(5).toFloat(), 1f)
+                setPadding(0, ctx.dp(18), 0, 0)
+            }
+        column.addView(rhythmView)
+
+        // ---------- 常用词 ----------
+        wordsView =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                setLineSpacing(ctx.dp(4).toFloat(), 1f)
+                setPadding(0, ctx.dp(18), 0, 0)
+            }
+        column.addView(wordsView)
+
+        // ---------- 分享 ----------
+        shareButton =
+            Button(ctx).apply {
+                setText(R.string.dahi_report_share)
+                isEnabled = false
+                setOnClickListener { pickTemplate { id -> share(id) } }
+            }
+        column.addView(
+            shareButton,
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+                .apply { topMargin = ctx.dp(24) },
+        )
+
+        load()
+        return ScrollView(ctx).apply { addView(column) }
+    }
+
+    private fun chip(
+        ctx: android.content.Context,
+        labelRes: Int,
+        onClick: () -> Unit,
+    ): TextView =
+        TextView(ctx).apply {
+            setText(labelRes)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            setPadding(ctx.dp(14), ctx.dp(6), ctx.dp(14), ctx.dp(6))
+            setOnClickListener { onClick() }
+        }
+
+    private fun switchTo(target: DahiReport.Scope) {
+        if (scope == target && offset == 0) return
+        scope = target
+        offset = 0
+        load()
+    }
+
+    private fun load() {
+        val ctx = requireContext()
+        prevButton?.setText(if (offset == 0) R.string.dahi_report_prev else R.string.dahi_report_back_now)
+        prevButton?.setOnClickListener {
+            if (offset == 0) {
+                offset = 1
+            } else {
+                offset = 0
+            }
+            load()
+        }
+        // 选中的 chip 用强调色，另一个用弱色
+        listOf(monthChip to DahiReport.Scope.MONTH, yearChip to DahiReport.Scope.YEAR).forEach { (view, s) ->
+            view?.setTextColor(if (scope == s) dahiAccent() else dahiText2())
+            view?.setTypeface(null, if (scope == s) Typeface.BOLD else Typeface.NORMAL)
+        }
+        shareButton?.isEnabled = false
+        viewLifecycleOwner.lifecycleScope.launch {
+            val r = withContext(Dispatchers.IO) { runCatching { DahiReport.build(ctx, scope, offset) }.getOrNull() }
+            if (!isAdded) return@launch
+            render(r)
+        }
+    }
+
+    private fun render(r: DahiReport.Data?) {
+        if (r == null) {
+            titleView?.text = getString(R.string.dahi_report_empty)
+            chart?.submit(emptyList())
+            shareButton?.isEnabled = false
+            return
+        }
+        data = r
+        val num = DecimalFormat("###,###")
+        titleView?.text =
+            getString(
+                if (r.scope == DahiReport.Scope.YEAR) R.string.dahi_report_title_year else R.string.dahi_report_title_month,
+                r.title,
+            )
+        statsView?.text =
+            buildString {
+                appendLine("${getString(R.string.dahi_report_chars)}  ${num.format(r.chars)}")
+                appendLine("${getString(R.string.dahi_report_commits)}  ${num.format(r.commits)}")
+                appendLine(
+                    "${getString(R.string.dahi_report_hours)}  ${
+                        String.format(java.util.Locale.US, "%.1f", r.activeMinutes / 60.0)
+                    }",
+                )
+                append("${getString(R.string.dahi_report_speed)}  ${String.format(java.util.Locale.US, "%.1f", r.avgSpeed)}")
+            }
+        chart?.submit(r.line)
+        val hourText =
+            if (r.busiestHour >= 0) {
+                String.format(java.util.Locale.US, "%02d:00–%02d:00", r.busiestHour, (r.busiestHour + 1) % 24)
+            } else {
+                "—"
+            }
+        rhythmView?.text =
+            buildString {
+                appendLine(
+                    "${getString(R.string.dahi_report_busiest_day)}  ${
+                        if (r.busiestDayChars > 0L) "${r.busiestDayLabel} · ${num.format(r.busiestDayChars)}" else "—"
+                    }",
+                )
+                appendLine("${getString(R.string.dahi_report_busiest_hour)}  $hourText")
+                appendLine("${getString(R.string.dahi_report_late)}  ${r.lateDays}")
+                append("${getString(R.string.dahi_report_streak)}  ${r.streak}")
+            }
+        wordsView?.text =
+            if (r.topWords.isEmpty()) {
+                getString(R.string.dahi_report_no_words)
+            } else {
+                "${getString(R.string.dahi_stats_wordcloud)}\n" + r.topWords.joinToString(" · ") { it.first }
+            }
+        shareButton?.isEnabled = r.chars > 0L
+    }
+
+    private fun share(templateId: String) {
+        val r = data ?: return
+        if (r.chars <= 0L) return
+        val ctx = requireContext()
+        runCatching {
+            val bitmap = DahiReportImage.render(ctx, r, templateId)
+            val dir = File(ctx.cacheDir, "report").apply { mkdirs() }
+            val file = File(dir, "dahi-report-${System.currentTimeMillis()}.png")
+            file.outputStream().use { out -> bitmap.compress(Bitmap.CompressFormat.PNG, 100, out) }
+            val uri = FileProvider.getUriForFile(ctx, "${ctx.packageName}.fileprovider", file)
+            val intent =
+                Intent(Intent.ACTION_SEND).apply {
+                    type = "image/png"
+                    putExtra(Intent.EXTRA_STREAM, uri)
+                    addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                }
+            startActivity(Intent.createChooser(intent, getString(R.string.dahi_report_share)))
+        }.onFailure {
+            Toast.makeText(ctx, R.string.dahi_privacy_failed, Toast.LENGTH_SHORT).show()
+        }
+    }
+
+
+    /** 分享前先选配色模板（与统计图共用同一份选择，选过就记住）。 */
+    private fun pickTemplate(onPick: (String) -> Unit) {
+        val ctx = requireContext()
+        val templates = DahiStatsImage.Template.values()
+        val names = resources.getStringArray(R.array.dahi_stats_tpl_names)
+        val prefs = PreferenceManager.getDefaultSharedPreferences(ctx)
+        val saved = prefs.getString(KEY_TEMPLATE, DahiStatsImage.Template.DEEP.id)
+        val current = templates.indexOfFirst { it.id == saved }.coerceAtLeast(0)
+        androidx.appcompat.app.AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_stats_share_tpl)
+            .setSingleChoiceItems(names, current) { dialog, which ->
+                dialog.dismiss()
+                val template = templates[which]
+                prefs.edit { putString(KEY_TEMPLATE, template.id) }
+                onPick(template.id)
+            }.setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun dahiAccent(): Int = requireContext().styledColor(android.R.attr.colorAccent)
+
+    private fun dahiText2(): Int = requireContext().styledColor(android.R.attr.textColorSecondary)
+}
diff --git a/app/src/main/java/com/osfans/trime/ui/main/settings/DahiReportImage.kt b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiReportImage.kt
