+
+package com.osfans.trime.ime.candidates
+
+import com.osfans.trime.data.prefs.AppPrefs
+
+/**
+ * 候选序号（1、2、3…）的渲染方式。
+ *
+ * 原来序号是拼进候选正文的（`"${label} ${text}"`）：序号和正文同字号、还带一个空格，
+ * 每个候选项白占 6~8dp。这里把序号改成**候选文字左上角的小上标**：
+ * - 字号 = 候选文字 × [SIZE_RATIO]，颜色与候选文字相同（变小之后再压暗就看不清了）；
+ * - 正文左侧留出序号宽度，避免压住首字；
+ * - 关闭开关则完全回到旧写法。
+ *
+ * 默认开。开关在「候选窗口」设置页（[AppPrefs.Candidates.dahiLabelSuperscript]）。
+ */
+object DahiCandidateLabel {
+    /** 上标字号相对候选文字的比例。 */
+    const val SIZE_RATIO = 0.55f
+
+    private val pref by AppPrefs.defaultInstance().candidates.dahiLabelSuperscript
+
+    /** 当前是否用左上角上标渲染序号。 */
+    fun superscript(): Boolean = runCatching { pref }.getOrDefault(true)
+}
