index 0000000..90785d7
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiLineChartView.kt
@@ -0,0 +1,155 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.Shader
+import android.util.AttributeSet
+import android.view.View
+import androidx.annotation.ColorInt
+import com.osfans.trime.ime.custom.DahiReport
+import splitties.dimensions.dp
+
+/**
+ * 速度曲线。
+ *
+ * 只画折线 + 淡淡的填充，不画网格（报告页不需要精确读值，看趋势就够）。
+ * 最低点不贴底：把 0 也画在基线上会显得"几乎全是 0"，所以纵轴从「最小的非零值的一半」起。
+ */
+class DahiLineChartView
+@JvmOverloads
+constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : View(context, attrs, defStyleAttr) {
+    private val linePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; strokeWidth = dp(2f) }
+    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val dotPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val labelPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { textSize = dp(9f) }
+
+    private var points: List<DahiReport.Point> = emptyList()
+
+    private var accent = 0xFF5B8CFF.toInt()
+    private var dim = 0x66808080
+
+    fun setAccent(
+        @ColorInt color: Int,
+    ) {
+        accent = color
+        linePaint.color = color
+        dotPaint.color = color
+        invalidate()
+    }
+
+    fun setLabelColor(
+        @ColorInt color: Int,
+    ) {
+        dim = color
+        labelPaint.color = color
+        invalidate()
+    }
+
+    fun submit(list: List<DahiReport.Point>) {
+        points = list
+        invalidate()
+    }
+
+    override fun onMeasure(
+        widthMeasureSpec: Int,
+        heightMeasureSpec: Int,
+    ) {
+        setMeasuredDimension(MeasureSpec.getSize(widthMeasureSpec), dp(150f).toInt())
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (points.size < 2) {
+            labelPaint.color = dim
+            labelPaint.textSize = dp(11f)
+            val text = context.getString(com.osfans.trime.R.string.dahi_report_empty)
+            canvas.drawText(text, dp(4f), height / 2f, labelPaint)
+            labelPaint.textSize = dp(9f)
+            return
+        }
+        val left = dp(6f)
+        val right = width - dp(6f)
+        val top = dp(12f)
+        val bottom = height - dp(18f)
+        val speeds = points.map { it.speed }
+        val max = (speeds.maxOrNull() ?: 1.0).coerceAtLeast(1.0)
+        val minNonZero = speeds.filter { it > 0.0 }.minOrNull() ?: 0.0
+        val min = (minNonZero * 0.5).coerceAtMost(max * 0.8)
+
+        fun x(i: Int): Float = left + (right - left) * i / (points.size - 1).toFloat()
+        fun y(v: Double): Float {
+            val t = ((v - min) / (max - min)).coerceIn(0.0, 1.0)
+            return (bottom - (bottom - top) * t).toFloat()
+        }
+
+        val path = Path()
+        val fill = Path()
+        points.forEachIndexed { i, p ->
+            val px = x(i)
+            val py = y(p.speed)
+            if (i == 0) {
+                path.moveTo(px, py)
+                fill.moveTo(px, bottom)
+                fill.lineTo(px, py)
+            } else {
+                path.lineTo(px, py)
+                fill.lineTo(px, py)
+            }
+        }
+        fill.lineTo(x(points.size - 1), bottom)
+        fill.close()
+
+        fillPaint.shader =
+            LinearGradient(0f, top, 0f, bottom, (accent and 0x00FFFFFF) or (0x55000000), 0x00000000, Shader.TileMode.CLAMP)
+        canvas.drawPath(fill, fillPaint)
+
+        linePaint.color = accent
+        canvas.drawPath(path, linePaint)
+
+        dotPaint.color = accent
+        val peakIndex = speeds.indices.maxByOrNull { speeds[it] } ?: 0
+        points.forEachIndexed { i, p ->
+            if (i == peakIndex) {
+                canvas.drawCircle(x(i), y(p.speed), dp(3.2f), dotPaint)
+            }
+        }
+
+        // 首 / 中 / 尾三个标签
+        labelPaint.color = dim
+        listOf(0, points.size / 2, points.size - 1).distinct().forEach { i ->
+            val text = points[i].label
+            val tw = labelPaint.measureText(text)
+            val px =
+                when (i) {
+                    0 -> left
+                    points.size - 1 -> right - tw
+                    else -> x(i) - tw / 2f
+                }
+            canvas.drawText(text, px, height - dp(4f), labelPaint)
+        }
+
+        // 峰值数字标在点上方
+        val peak = points[peakIndex]
+        val peakText = String.format(java.util.Locale.US, "%.0f", peak.speed)
+        val pw = labelPaint.measureText(peakText)
+        canvas.drawText(
+            peakText,
+            (x(peakIndex) - pw / 2f).coerceIn(left, right - pw),
+            (y(peak.speed) - dp(7f)).coerceAtLeast(dp(10f)),
+            labelPaint,
+        )
+    }
+}
