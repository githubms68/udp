new file mode 100644
index 0000000..31f0db1
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/clipboard/DahiPhrasePromptOverlay.kt
@@ -0,0 +1,182 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.clipboard
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.LinearLayout
+import android.widget.TextView
+import com.osfans.trime.R
+import com.osfans.trime.data.theme.ColorManager
+import com.osfans.trime.data.theme.Theme
+import com.osfans.trime.ime.core.TrimeInputMethodService
+import com.osfans.trime.ime.keyboard.KeyboardWindow
+import com.osfans.trime.ime.window.BoardWindowManager
+
+/**
+ * 单行文本输入浮层（贴在同文键盘上方）。
+ *
+ * 复刻剪贴板搜索浮层的输入通路：先把键盘重新显示出来，再把键盘提交的
+ * 纯文本 / 退格经由 [ClipboardSearchBridge] 路由进本浮层，避免「输入法窗口内的
+ * EditText 收不到同文自身键盘输入」的问题。
+ *
+ * 目前用于「设为自定义短语」时输入代码。
+ */
+class DahiPhrasePromptOverlay(
+    private val ctx: Context,
+    private val theme: Theme,
+    private val service: TrimeInputMethodService,
+    private val windowManager: BoardWindowManager,
+    private val title: String,
+    private val onConfirm: (String) -> Unit,
+) {
+    /**
+     * 用户点「取消」时的回调（可选），用于把调用方原来的浮层恢复回去。
+     *
+     * 刻意做成**可变属性**而不是构造参数：Kotlin 的尾随 lambda 只绑定最后一个参数，
+     * 若把可选参数加在末尾，所有 `DahiPhrasePromptOverlay(...) { name -> }` 的调用
+     * 都会把 lambda 当成那个可选参数，导致 onConfirm 缺失、整片编译失败。
+     * 因此构造函数的最后一个参数必须永远是 [onConfirm]。
+     */
+    var onCancel: (() -> Unit)? = null
+
+    private val density = ctx.resources.displayMetrics.density
+
+    private fun dp(value: Int): Int = (value * density + 0.5f).toInt()
+
+    private val barSize = theme.generalStyle.candidateViewHeight + theme.generalStyle.commentHeight
+    private val barHeight = maxOf(dp(52), (barSize * 1.6f * density).toInt())
+
+    private val textColor = ColorManager.getColor("key_text_color")
+
+    private fun isDark(color: Int): Boolean = 0.299 * Color.red(color) + 0.587 * Color.green(color) + 0.114 * Color.blue(color) < 140
+
+    private val fallbackBackground: Int =
+        if (isDark(textColor)) 0xFF303030.toInt() else 0xFFF7F7F7.toInt()
+
+    private val rootBackground: Drawable =
+        ColorManager.getDecorDrawable("key_back_color", "key_border_color", dp(1), dp(8).toFloat())
+            ?: GradientDrawable().apply {
+                setColor(fallbackBackground)
+                cornerRadius = dp(8).toFloat()
+            }
+
+    /** 浮层高度：仅一行加内边距，尽量少占屏幕。 */
+    val heightPx: Int = barHeight + dp(12)
+
+    private var code: String = ""
+
+    private val codeView =
+        TextView(ctx).apply {
+            isSingleLine = true
+            ellipsize = TextUtils.TruncateAt.END
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f)
+            setTextColor(this@DahiPhrasePromptOverlay.textColor)
+            gravity = Gravity.CENTER_VERTICAL
+        }
+
+    private fun actionButton(labelRes: Int, action: () -> Unit): TextView = TextView(ctx).apply {
+        setText(labelRes)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+        setTextColor(textColor)
+        gravity = Gravity.CENTER
+        setPadding(dp(10), 0, dp(10), 0)
+        isClickable = true
+        setOnClickListener { action() }
+    }
+
+    private val confirmButton = actionButton(R.string.dahi_cp_confirm) { confirm() }
+    private val cancelButton = actionButton(R.string.dahi_cp_cancel) { cancel() }
+
+    val root: View =
+        LinearLayout(ctx).apply {
+            orientation = LinearLayout.VERTICAL
+            setBackground(rootBackground)
+            setPadding(dp(8), dp(6), dp(8), dp(6))
+            addView(
+                LinearLayout(ctx).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    gravity = Gravity.CENTER_VERTICAL
+                    addView(codeView, LinearLayout.LayoutParams(0, barHeight, 1f))
+                    addView(cancelButton, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, barHeight))
+                    addView(confirmButton, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, barHeight))
+                },
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, barHeight),
+            )
+        }
+
+    init {
+        render()
+    }
+
+    /**
+     * 把键盘输入接到本浮层，并登记「宿主重建输入视图后重挂自己」。
+     *
+     * 调用时机：**必须**在调用方切完窗口（attachWindow 会触发 onDetached 清桥）之后，
+     * 否则刚接上的桥会被立刻 reset 掉 —— 浮层看得见，但打的字全上屏到宿主 App。
+     */
+    fun activateBridge() {
+        ClipboardSearchBridge.activate(
+            onText = { appendText(it) },
+            onBackspace = { backspace() },
+        )
+        // activate() 不会重置 onReattach：不在这里指向自己，
+        // 残留的旧值（搜索浮层）会在下一次 onStartInputView 时爬上来压住本浮层。
+        ClipboardSearchBridge.onReattach = {
+            if (root.parent == null) service.showBottomOverlay(root, heightPx)
+        }
+    }
+
+    /** 键盘提交的文本追加到代码框。 */
+    fun appendText(text: String) {
+        if (text.isEmpty()) return
+        code += text
+        render()
+    }
+
+    /** 退格：删除代码末位。 */
+    fun backspace() {
+        if (code.isEmpty()) return
+        code = code.dropLast(1)
+        render()
+    }
+
+    private fun render() {
+        codeView.text =
+            if (code.isEmpty()) {
+                title
+            } else {
+                code
+            }
+        codeView.alpha = if (code.isEmpty()) 0.6f else 1f
+    }
+
+    /** 先清理本浮层，再交给调用方处理：这样调用方在 onConfirm 里可以安全地显示别的浮层。 */
+    private fun confirm() {
+        val value = code.trim()
+        exit()
+        if (value.isNotEmpty()) onConfirm(value)
+    }
+
+    private fun cancel() {
+        exit()
+        onCancel?.invoke()
+    }
+
+    /** 退出：清理桥接与浮层，回到键盘。 */
+    fun exit() {
+        ClipboardSearchBridge.reset()
+        service.hideBottomOverlay()
+        windowManager.attachWindow(KeyboardWindow)
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/clipboard/DahiWindowPanel.kt b/app/src/main/java/com/osfans/trime/ime/clipboard/DahiWindowPanel.kt
new file mode 100644
index 0000000..d7d7c93
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/clipboard/DahiWindowPanel.kt
@@ -0,0 +1,312 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.clipboard
+
+import android.content.Context
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+
+/**
+ * 输入法窗口内自绘的菜单 / 弹层。
+ *
+ * 为什么不用 PopupMenu 或 Dialog：它们都是**独立的窗口**。ima、豆包、应用内「输入测试」
+ * 这类宿主在输入法窗口之外出现任何窗口时，会把输入法窗口收起，并让 input session 作废 ——
+ * 此后所有提交都「返回成功、内容被丢弃」，而且再收起 / 重新显示也救不回那根旧连接。
+ * 自绘层是普通 View，挂在输入法自己的视图树里，不会创建窗口，也就不会触发上述行为。
+ *
+ * 挂载点：由 [showLayer] 追加到 InputView（ConstraintLayout）上，与搜索浮层同尺寸同位。
+ * 不能挂进搜索浮层自己的 LinearLayout —— 那里加一个撑满高度的子视图会挤压列表，条目全变空白。
+ *
+ * @param rootViewProvider 取搜索浮层根视图，只用来量可用高度与做坐标换算
+ */
+internal class DahiWindowPanel(
+    private val ctx: Context,
+    private val showLayer: (view: View, heightPx: Int) -> Unit,
+    private val hideLayer: () -> Unit,
+    private val rootViewProvider: () -> View?,
+) {
+    data class Item(
+        val iconRes: Int,
+        val label: String,
+        /** 是否标为「当前值」（前面打勾 + 强调色）。 */
+        val highlighted: Boolean = false,
+        val action: () -> Unit,
+    )
+
+    private var layer: FrameLayout? = null
+
+    private val textColor = 0xFFF2F5FA.toInt()
+    private val subColor = 0xFFA9B4C6.toInt()
+    private val accentColor = 0xFF8AB4F8.toInt()
+    private val cardColor = 0xF21E242E.toInt()
+
+    private val density = ctx.resources.displayMetrics.density
+
+    private fun dp(v: Int): Int = (v * density).toInt()
+
+    /** 列表菜单。[anchor] 是长按的那一行，卡片贴着它弹出（和原来的 PopupMenu 观感一致）。 */
+    fun showList(
+        anchor: View?,
+        items: List<Item>,
+    ) {
+        dismiss()
+        if (items.isEmpty()) return
+        val area = areaOf()
+        val card =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(dp(6), dp(8), dp(6), dp(8))
+                background =
+                    GradientDrawable().apply {
+                        cornerRadius = dp(14).toFloat()
+                        setColor(cardColor)
+                    }
+                clipToOutline = true
+            }
+        val list = LinearLayout(ctx).apply { orientation = LinearLayout.VERTICAL }
+        items.forEach { item ->
+            list.addView(
+                rowView(item),
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(ROW_HEIGHT_DP)),
+            )
+        }
+        val scroller =
+            ScrollView(ctx).apply {
+                isVerticalScrollBarEnabled = false
+                addView(
+                    list,
+                    ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
+                )
+            }
+        // ScrollView 必须拿到「真实可视高度」，否则它以为内容全显示而拒绝滚动（r133b 的滑不动）。
+        // 卡片总高 = listH + 上下内边距 16dp，再给上下各 8dp 外边距 → listH ≤ 可用高 - 32dp。
+        val listH = dp(items.size * ROW_HEIGHT_DP)
+            .coerceAtMost(area.height - dp(32))
+            .coerceAtLeast(dp(ROW_HEIGHT_DP * 2))
+        card.addView(scroller, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, listH))
+
+        val cardW = dp(CARD_WIDTH_DP)
+        val cardH = listH + dp(16)
+        var left = dp(8)
+        var top = (area.height - cardH) / 2
+        if (anchor != null && anchor.height > 0) {
+            val a = IntArray(2).also { anchor.getLocationOnScreen(it) }
+            // 相对浮层左上角（自绘层与浮层同位置同尺寸，坐标系一致）
+            val ax = a[0] - area.left
+            val ay = a[1] - area.top
+            left = (ax + dp(14)).coerceIn(dp(8), (area.width - cardW - dp(8)).coerceAtLeast(dp(8)))
+            top = (ay + anchor.height / 2 - cardH / 2)
+                .coerceIn(dp(8), (area.height - cardH - dp(8)).coerceAtLeast(dp(8)))
+        }
+        attach(card, cardW, cardH, left, top, area.height)
+    }
+
+    /**
+     * 分类选择列表：分类项 + 末尾「新建分类…」。
+     *
+     * 为什么也自绘：这个菜单是从「长按条目 → 分类」进来的，此时搜索浮层与键盘都还在屏上。
+     * 原来用 PopupMenu（独立窗口），在 ima / 豆包 / 应用内测试输入框里选「新建分类」会让
+     * 宿主把浮层连键盘一起收掉，分类名根本没法输入（微信、高德这类宿主则无没事）。
+     */
+    fun showCategories(
+        anchor: View?,
+        categories: List<String>,
+        current: String?,
+        mixed: Boolean,
+        noneLabel: String,
+        newLabel: String,
+        onPick: (String?) -> Unit,
+        onNew: () -> Unit,
+    ) {
+        val items = ArrayList<Item>(categories.size + 2)
+        // 勾出「这条现在属于哪个分类」：批量里选中的条目分类不一致时（mixed）一律不勾，
+        // 免得把某一项误标成共同归属。
+        items.add(Item(iconFolder, noneLabel, highlighted = !mixed && current == null) { onPick(null) })
+        categories.forEach { name ->
+            items.add(Item(iconFolder, name, highlighted = !mixed && current == name) { onPick(name) })
+        }
+        items.add(Item(iconAdd, newLabel) { onNew() })
+        showList(anchor, items)
+    }
+
+    /** 全文预览：可滚动正文 + 「取消 / 直接上屏」。 */
+    fun showText(
+        title: String,
+        text: String,
+        onSend: () -> Unit,
+    ) {
+        dismiss()
+        val area = areaOf()
+        val cardW = (area.width - dp(24)).coerceAtLeast(dp(200))
+        val cardH = (area.height - dp(16)).coerceAtLeast(dp(160))
+        val card =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(dp(16), dp(14), dp(16), dp(12))
+                background =
+                    GradientDrawable().apply {
+                        cornerRadius = dp(14).toFloat()
+                        setColor(cardColor)
+                    }
+                clipToOutline = true
+            }
+        card.addView(
+            TextView(ctx).apply {
+                this.text = title
+                setTextColor(textColor)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+                setPadding(0, 0, 0, dp(8))
+            },
+        )
+        card.addView(
+            ScrollView(ctx).apply {
+                isVerticalScrollBarEnabled = true
+                addView(
+                    TextView(ctx).apply {
+                        this.text = text
+                        setTextColor(subColor)
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                        setTextIsSelectable(true)
+                    },
+                    ViewGroup.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ),
+                )
+            },
+            // 权重 1：正文吃掉卡片剩余高度
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f),
+        )
+        val buttons =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.END
+                setPadding(0, dp(10), 0, 0)
+            }
+        buttons.addView(buttonView(ctx.getString(android.R.string.cancel)) { dismiss() })
+        buttons.addView(
+            buttonView(ctx.getString(com.osfans.trime.R.string.dahi_cp_send_to_host)) {
+                dismiss()
+                onSend()
+            },
+        )
+        card.addView(buttons)
+        attach(card, cardW, cardH, (area.width - cardW) / 2, (area.height - cardH) / 2, area.height)
+    }
+
+    fun dismiss() {
+        if (layer == null) return
+        runCatching { hideLayer() }
+        layer = null
+    }
+
+    fun isShowing(): Boolean = layer != null
+
+    private class Area(
+        val left: Int,
+        val top: Int,
+        val width: Int,
+        val height: Int,
+    )
+
+    /** 浮层在屏幕上占的矩形；浮层还没布局完时退回屏幕高度的 42%。 */
+    private fun areaOf(): Area {
+        val dm = ctx.resources.displayMetrics
+        val fallback = Area(0, (dm.heightPixels * 0.58f).toInt(), dm.widthPixels, (dm.heightPixels * 0.42f).toInt())
+        val root = rootViewProvider() ?: return fallback
+        val w = root.width
+        val h = root.height
+        if (w <= 0 || h <= 0) return fallback
+        val loc = IntArray(2).also { root.getLocationOnScreen(it) }
+        return Area(loc[0], loc[1], w, h)
+    }
+
+    private fun attach(
+        card: View,
+        cardW: Int,
+        cardH: Int,
+        left: Int,
+        top: Int,
+        heightPx: Int,
+    ) {
+        // 透明捕获层：只负责「点外部关闭」，不压暗、不遮挡后面的列表
+        val scrim =
+            FrameLayout(ctx).apply {
+                setBackgroundColor(0x00000000)
+                isClickable = true
+                setOnClickListener { dismiss() }
+            }
+        card.isClickable = true
+        scrim.addView(
+            card,
+            FrameLayout.LayoutParams(cardW, cardH, Gravity.TOP or Gravity.START).apply {
+                leftMargin = left
+                topMargin = top
+            },
+        )
+        runCatching { showLayer(scrim, heightPx) }
+        layer = scrim
+    }
+
+    private fun rowView(item: Item): View = LinearLayout(ctx).apply {
+        orientation = LinearLayout.HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        setPadding(dp(12), 0, dp(14), 0)
+        isClickable = true
+        setOnClickListener {
+            dismiss()
+            runCatching { item.action() }
+        }
+        addView(
+            ImageView(ctx).apply {
+                setImageResource(item.iconRes)
+                setColorFilter(textColor)
+                scaleType = ImageView.ScaleType.CENTER_INSIDE
+            },
+            LinearLayout.LayoutParams(dp(20), dp(20)).apply { rightMargin = dp(12) },
+        )
+        addView(
+            TextView(ctx).apply {
+                // 「当前值」前面打勾并用全角空格对齐，颜色也更亮，扫一眼就知道这条现在属于哪一类
+                text = if (item.highlighted) "\u2713 ${item.label}" else "\u3000${item.label}"
+                setTextColor(if (item.highlighted) accentColor else textColor)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+                typeface = if (item.highlighted) Typeface.DEFAULT_BOLD else Typeface.DEFAULT
+                isSingleLine = true
+            },
+        )
+    }
+
+    private fun buttonView(
+        label: String,
+        onTap: () -> Unit,
+    ): TextView = TextView(ctx).apply {
+        text = label
+        setTextColor(textColor)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        setPadding(dp(14), dp(8), dp(14), dp(8))
+        isClickable = true
+        setOnClickListener { onTap() }
+    }
+
+    companion object {
+        const val ROW_HEIGHT_DP = 44
+        const val CARD_WIDTH_DP = 200
+
+        val iconFolder = com.osfans.trime.R.drawable.ic_baseline_folder_24
+        val iconAdd = com.osfans.trime.R.drawable.ic_baseline_add_24
+    }
+}
