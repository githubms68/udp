@@ -0,0 +1,58 @@
+<?xml version="1.0" encoding="utf-8"?>
+
+<resources>
+    <string name="dahi_privacy_title">Privacy check</string>
+    <string name="dahi_privacy_claim_title">This keyboard cannot go online.</string>
+    <string name="dahi_privacy_claim_body">Not “network turned off” — the package never requests any INTERNET permission at all. Those are very different things.</string>
+    <string name="dahi_privacy_perm_section">Permissions it asks for</string>
+    <string name="dahi_privacy_loading">Loading…</string>
+    <string name="dahi_privacy_data_section">Where your data lives</string>
+    <string name="dahi_privacy_out_section">What can leave this device</string>
+    <string name="dahi_privacy_out_clip">Clipboard — never leaves (unless you export or share it yourself)</string>
+    <string name="dahi_privacy_out_stats">Typing statistics — never leave (unless you export or share them yourself)</string>
+    <string name="dahi_privacy_out_crash">Crash logs — written to local files only, never uploaded</string>
+    <string name="dahi_privacy_out_voice">Voice input — this app never uploads audio. Recognition is done by the "说点啥" app you installed; audio never passes through this app.</string>
+    <string name="dahi_privacy_backup_section">How encrypted backups are stored</string>
+    <string name="dahi_privacy_backup_body">Encrypted export: AES-256-GCM, with the key derived from the password you set (PBKDF2-HMAC-SHA256, 200,000 rounds). Nothing readable inside the file.\n\nDaily auto-backup (if enabled, clipboard &amp; collection only) is plain JSON, stored only in the app private directory — unreadable by other apps, never uploaded.</string>
+    <string name="dahi_privacy_verify_section">Verify it yourself</string>
+    <string name="dahi_privacy_verify_body">The permission list above is read live from the system API, not a hard-coded text.\n\nSettings → Apps → 同文输入法大海版 → Permissions\nOr on a computer: adb shell dumpsys package com.osfans.trime.dahi</string>
+    <string name="dahi_privacy_share">Create share image</string>
+    <string name="dahi_privacy_export">Export report</string>
+    <string name="dahi_privacy_export_done">Exported</string>
+    <string name="dahi_privacy_failed">Operation failed</string>
+    <string name="dahi_privacy_perm_total">%1$d permission(s):</string>
+    <string name="dahi_privacy_perm_net_title">Network permissions:</string>
+    <string name="dahi_privacy_perm_none">not requested</string>
+    <string name="dahi_privacy_perm_vibrate">key vibration feedback</string>
+    <string name="dahi_privacy_perm_mic">record during voice input; audio goes to the "说点啥" app</string>
+    <string name="dahi_privacy_perm_notify">notifications for voice effects</string>
+    <string name="dahi_privacy_perm_boot">restore service after reboot</string>
+    <string name="dahi_privacy_perm_speech">talk to the "说点啥" app (its own permission)</string>
+    <string name="dahi_privacy_data_total">Local data total %1$s</string>
