+    /** 轻点热力图上的某个键：报这个键在本周期内被按了多少次、排第几。 */
+    private fun onKeyTapped(label: String) {
+        val snap = runCatching { DahiInputStats.snapshot(period) }.getOrNull() ?: return
+        val heat = snap.keyHeat
+        // 排名只在「当前这把键盘上真实出现过的键」里比，免得历史上别的键盘按过的键跑进来
+        val onKeyboard =
+            runCatching {
+                DahiInputStats.lastLayout().flatten().map { it.label }.filter { it.isNotEmpty() }.toSet()
+            }.getOrDefault(emptySet())
+        val pool = if (onKeyboard.isEmpty()) heat else heat.filterKeys { it in onKeyboard }
+        val ordered = pool.entries.sortedByDescending { it.value }
+        val rank = ordered.indexOfFirst { it.key == label }.let { if (it < 0) 0 else it + 1 }
+        val text =
+            getString(
+                R.string.dahi_stats_heat_key,
+                label,
+                heat[label] ?: 0L,
+                if (rank == 0) ordered.size.coerceAtLeast(1) else rank,
+                ordered.size.coerceAtLeast(1),
+            )
+        Toast.makeText(requireContext(), text, Toast.LENGTH_SHORT).show()
+    }
