+/**
+ * 大海版：候选里「快打」角标长什么样。
+ *
+ * 新用户看到 ⚡ 未必知道是什么意思，所以默认仍是「快打」两个字；
+ * 嫌占地方的老用户可以换成 ⚡；完全不需要角标的人可以关掉 ——
+ * 关掉只是去掉前缀文字，**逐字打全码命中已设快打时仍会提示编码本身**（如 dy），功能不丢。
+ */
+enum class DahiPhraseBadge(
+    override val stringRes: Int,
+) : PreferenceDelegateEnum {
+    /** 显示「快打」两个字（默认，最好懂）。 */
+    TEXT(R.string.dahi_phrase_badge_text),
+
+    /** 只显示一个 ⚡（更省地方）。 */
+    BOLT(R.string.dahi_phrase_badge_bolt),
+
+    /** 不显示角标；全码提示只保留编码本身。 */
+    NONE(R.string.dahi_phrase_badge_none),
+}
