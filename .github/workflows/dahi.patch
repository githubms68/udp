+                DahiInputStats.clearPeriod(period)
+                render()
+                toast(R.string.dahi_stats_cleared)
+            }.setNegativeButton(R.string.cancel, null)
+            .show()
+    }
+
+    private fun confirmClearVoice() {
+        AlertDialog
+            .Builder(requireContext())
+            .setTitle(R.string.dahi_stats_voice_clear)
+            .setMessage(R.string.dahi_stats_voice_clear_msg)
+            .setPositiveButton(R.string.ok) { _, _ ->
+                DahiVoiceStats.clear()
+                render()
+                toast(R.string.dahi_stats_voice_cleared)
+            }.setNegativeButton(R.string.cancel, null)
+            .show()
+    }
+
+    private fun toast(
+        @StringRes resId: Int,
+    ) {
+        Toast.makeText(requireContext(), resId, Toast.LENGTH_SHORT).show()
+    }
+
+    private fun format(value: Double): String = if (value <= 0.0) "—" else String.format("%.1f", value)
+
+    private fun formatPct(value: Double): String = if (value <= 0.0) "—" else String.format("%.0f%%", value * 100)
+
+    private fun format2(value: Double): String = if (value <= 0.0) "—" else String.format("%.2f", value)
+
+    private val valueViews = mutableMapOf<Int, TextView>()
+}
