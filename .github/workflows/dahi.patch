+    /** 点柱子的当天摘要。 */
+    private fun showDayDialog(day: DahiDailyHistory.Day) {
+        val ctx = requireContext()
+        val peak =
+            if (day.peakHour in 0..23) {
+                "${day.peakHour}:00–${(day.peakHour + 1) % 24}:00"
+            } else {
+                getString(R.string.dahi_stats_daily_none)
+            }
+        // 日期带上星期：看「哪天熬的」比看一串数字直观
+        val weekday =
+            runCatching {
+                val d = java.time.LocalDate.parse(day.date)
+                java.time.format.DateTimeFormatter
+                    .ofPattern("EEEE", java.util.Locale.getDefault())
+                    .format(d)
+            }.getOrDefault("")
+        val dayLabel = if (weekday.isEmpty()) day.date else "${day.date} $weekday"
+        var text =
+            getString(
+                R.string.dahi_stats_daily_summary,
+                dayLabel,
+                day.chars,
+                day.commits,
+                format(day.activeMs / 60000.0),
+                format2(day.speed),
+                peak,
+            )
+        // 加一行「比前一天 ±X%」：单独一个绝对数字没有参照，和前一天比才有意义
+        val idx = dayCache.indexOfFirst { it.date == day.date }
+        if (idx > 0) {
+            val prev = dayCache[idx - 1]
+            if (prev.chars > 0L) {
+                val pct = ((day.chars - prev.chars) * 100.0 / prev.chars).toInt()
+                val delta =
+                    when {
+                        pct > 0 -> "+$pct%"
+                        pct < 0 -> "$pct%"
+                        else -> getString(R.string.dahi_stats_week_flat)
+                    }
+                text += "\n" + getString(R.string.dahi_stats_day_vs, delta)
+            }
+        }
+        runCatching {
+            AlertDialog
+                .Builder(ctx)
+                .setTitle(R.string.dahi_stats_daily_title)
+                .setMessage(text)
+                .setPositiveButton(android.R.string.ok, null)
+                .show()
+        }
+    }
