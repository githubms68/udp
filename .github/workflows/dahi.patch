+    private fun addSlider(
+        titleRes: Int,
+        initial: Int,
+        min: Int = 0,
+        max: Int = 100,
+        suffix: String = "",
+        previewSound: Boolean = false,
+        onChange: (Int) -> Unit,
+    ) {
+        val ctx = requireContext()
+        val span = (max - min).coerceAtLeast(1)
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(0, ctx.dp(10), 0, ctx.dp(6))
+            }
+        val label =
+            TextView(ctx).apply {
+                text = "${ctx.getString(titleRes)}  $initial$suffix"
+                textSize = 16f
+                setTextColor(titleColor())
+            }
+        column.addView(label)
+        column.addView(
+            SeekBar(ctx).apply {
+                this.max = span
+                progress = (initial - min).coerceIn(0, span)
+                setOnSeekBarChangeListener(
+                    object : SeekBar.OnSeekBarChangeListener {
+                        override fun onProgressChanged(
+                            seekBar: SeekBar?,
+                            value: Int,
+                            fromUser: Boolean,
+                        ) {
+                            val real = value + min
+                            label.text = "${ctx.getString(titleRes)}  $real$suffix"
+                            if (fromUser) onChange(real)
+                        }
+
+                        override fun onStartTrackingTouch(seekBar: SeekBar?) {}
+
+                        override fun onStopTrackingTouch(seekBar: SeekBar?) {
+                            if (previewSound) DahiKeySound.preview(DahiKeyEffectsConfig.soundStyle)
+                        }
+                    },
+                )
+            },
+        )
+        content.addView(column)
+    }
+
+    /** 跟随主题的标题色 / 说明色 —— 不用 alpha 硬压，亮色主题下才不会发灰。 */
+    private fun titleColor(): Int = themeColor(android.R.attr.textColorPrimary, 0xDE000000.toInt())
+
+    private fun summaryColor(): Int = themeColor(android.R.attr.textColorSecondary, 0x8A000000.toInt())
+
+    private fun accentColor(): Int = themeColor(androidx.appcompat.R.attr.colorAccent, 0xFF3F6FE0.toInt())
+
+    private fun themeColor(
+        attr: Int,
+        fallback: Int,
+    ): Int {
+        val ta = requireContext().obtainStyledAttributes(intArrayOf(attr))
+        return try {
+            ta.getColor(0, fallback)
+        } finally {
+            ta.recycle()
+        }
+    }
+
+    /** 8 种按键动效的一句话说明（长度统一 6 字，弹窗里排起来整齐）。 */
+    private fun styleDesc(style: DahiKeyEffectsConfig.Style): Int = when (style) {
+        DahiKeyEffectsConfig.Style.WATER -> R.string.dahi_ke_style_water_desc
+        DahiKeyEffectsConfig.Style.RIPPLE -> R.string.dahi_ke_style_ripple_desc
+        DahiKeyEffectsConfig.Style.STAR -> R.string.dahi_ke_style_star_desc
+        DahiKeyEffectsConfig.Style.INK -> R.string.dahi_ke_style_ink_desc
+        DahiKeyEffectsConfig.Style.FIREFLY -> R.string.dahi_ke_style_firefly_desc
+        DahiKeyEffectsConfig.Style.PETAL -> R.string.dahi_ke_style_petal_desc
+        DahiKeyEffectsConfig.Style.SPARK -> R.string.dahi_ke_style_spark_desc
+        DahiKeyEffectsConfig.Style.ECHO -> R.string.dahi_ke_style_echo_desc
+    }
+
+    /** 4 种潮汐形态的一句话说明（同样 6 字）。 */
+    private fun tideDesc(style: DahiKeyEffectsConfig.TideStyle): Int = when (style) {
+        DahiKeyEffectsConfig.TideStyle.SOFT -> R.string.dahi_ke_tide_style_soft_desc
+        DahiKeyEffectsConfig.TideStyle.SWELL -> R.string.dahi_ke_tide_style_swell_desc
+        DahiKeyEffectsConfig.TideStyle.BARS -> R.string.dahi_ke_tide_style_bars_desc
+        DahiKeyEffectsConfig.TideStyle.STARS -> R.string.dahi_ke_tide_style_stars_desc
+    }
