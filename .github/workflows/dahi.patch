+                R.string.advanced,
+                R.drawable.ic_baseline_more_horiz_24,
+                NavigationRoute.Advanced,
+                "高级 开发者 advanced",
+            ),
+        )
+
+    /** 默认顺序（全部 key）。 */
+    fun defaultOrder(): List<String> = entries.map { it.key }
+
+    /** 当前顺序：已保存的部分在前，缺失项按默认顺序补在后面。 */
+    fun order(): List<String> {
+        // 注意：迁移只能在这里做 —— object 的 init 块跑在 `entries` 初始化之前，
+        // 那里遍历 entries 会拿到 null。
+        migrateIfNeeded()
+        val known = entries.map { it.key }.toSet()
+        val saved =
+            prefs
+                .getString(PREF_KEY, null)
+                ?.split(',')
+                ?.map { it.trim() }
+                ?.filter { it.isNotEmpty() && it in known }
+                ?.distinct()
+                .orEmpty()
+        val result = saved.toMutableList()
+        // 先按默认顺序补齐缺失项（保证锚点一定存在）
+        entries.forEach { if (it.key !in result) result.add(it.key) }
+        // 再给「新入口」做**一次性**定位：做完记标记，之后完全交给用户自己排序。
+        // 早前写成「每次 order() 都强制移动」，导致排序页拖完不生效（r141 实测）。
+        if (placeNewEntries(result)) saveOrder(result)
+        return result
+    }
+
+    /**
+     * 把新入口挪到锚点后面（只做一次）。
+     *
+     * 每个 key 一个布尔标记，置位后永不再干预 —— 否则用户把「词库体检」拖到别处，
+     * 下次进首页又会被挪回去。
+     *
+     * @return 顺序是否被改动（需要落盘）
+     */
+    private fun placeNewEntries(result: MutableList<String>): Boolean {
+        var changed = false
+        insertAfter.forEach { (key, anchor) ->
+            val flag = PLACED_PREFIX + key
+            if (prefs.getBoolean(flag, false)) return@forEach
+            prefs.edit { putBoolean(flag, true) }
+            val at = result.indexOf(anchor)
+            val cur = result.indexOf(key)
+            if (at < 0 || cur < 0) return@forEach
+            if (cur != at + 1) {
+                result.removeAt(cur)
+                result.add(if (cur < at) at else at + 1, key)
+                changed = true
+            }
+        }
+        return changed
+    }
+
+    fun saveOrder(order: List<String>) {
+        prefs.edit { putString(PREF_KEY, order.joinToString(",")) }
+    }
+
+    /** 按当前顺序排好的入口（供首页渲染）。 */
+    fun orderedEntries(): List<HomeEntry> {
+        val map = entries.associateBy { it.key }
+        return order().mapNotNull { map[it] }
+    }
+
+    fun entry(key: String): HomeEntry? = entries.firstOrNull { it.key == key }
+
+    /** 把 [key] 移动到第 [index] 位。 */
+    fun moveTo(
+        key: String,
+        index: Int,
+    ) {
+        val list = order().toMutableList()
+        val from = list.indexOf(key)
+        if (from < 0) return
+        list.removeAt(from)
+        list.add(index.coerceIn(0, list.size), key)
+        saveOrder(list)
+    }
+
+    fun moveUp(key: String) {
+        val list = order()
+        val index = list.indexOf(key)
+        if (index > 0) moveTo(key, index - 1)
+    }
+
+    fun moveDown(key: String) {
+        val list = order()
+        val index = list.indexOf(key)
+        if (index >= 0 && index < list.size - 1) moveTo(key, index + 1)
+    }
+
+    fun moveTop(key: String) {
+        moveTo(key, 0)
+    }
+
+    fun moveBottom(key: String) {
+        moveTo(key, order().size - 1)
+    }
+
+    /** 恢复默认顺序 + 默认分组 + 默认分组名。 */
+    fun reset() {
+        prefs.edit {
+            remove(PREF_KEY)
+            entries.forEach { remove(GROUP_OVERRIDE_PREFIX + it.key) }
+            HomeGroup.values().forEach { remove(groupNameKey(it)) }
+        }
+    }
+
+    /** 关键词搜索（标题 + 别名），用于「搜索设置项」。 */
+    fun search(query: String): List<HomeEntry> {
+        val q = query.trim().lowercase()
+        if (q.isEmpty()) return orderedEntries()
+        return orderedEntries().filter { entry ->
+            val title = runCatching { appContext.getString(entry.title) }.getOrDefault("")
+            title.lowercase().contains(q) || entry.keywords.lowercase().contains(q)
+        }
+    }
+}
