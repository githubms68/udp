@@ -0,0 +1,122 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.graphics.Bitmap
+
+/**
+ * 轻量图片特效（大海版）：键盘背景「高斯模糊」效果的纯 Kotlin 实现。
+ *
+ * 为避免大图在输入法进程里做重计算造成卡顿，先在较小分辨率上做模糊、再交给绘制层放大，
+ * 效果对「背景」场景已足够。算法为两次水平 + 两次垂直的盒式模糊（近似高斯）。
+ */
+object DahiImageEffects {
+    /** 模糊时使用的最大边长；越小越快，取 640 折中。 */
+    private const val BLUR_MAX_DIM = 640
+
+    /** 返回模糊后的位图；[radius] 为 0 时原样返回。 */
+    fun blur(
+        src: Bitmap,
+        radius: Int,
+    ): Bitmap {
+        if (radius <= 0 || src.width <= 1 || src.height <= 1) return src
+        val scale = minOf(1f, BLUR_MAX_DIM.toFloat() / maxOf(src.width, src.height))
+        val small =
+            if (scale < 1f) {
+                val w = (src.width * scale).toInt().coerceAtLeast(1)
+                val h = (src.height * scale).toInt().coerceAtLeast(1)
+                Bitmap.createScaledBitmap(src, w, h, true)
+            } else {
+                src
+            }
+        val r = (radius * scale).toInt().coerceAtLeast(1)
+        val out = boxBlur(small, r)
+        if (small !== src) small.recycle()
+        return out
+    }
+
+    private fun boxBlur(
+        src: Bitmap,
+        radius: Int,
+    ): Bitmap {
+        val w = src.width
+        val h = src.height
+        val pixels = IntArray(w * h)
+        src.getPixels(pixels, 0, w, 0, 0, w, h)
+        val tmp = IntArray(w * h)
+        repeat(2) {
+            boxBlurH(pixels, tmp, w, h, radius)
+            boxBlurV(tmp, pixels, w, h, radius)
+        }
+        return Bitmap.createBitmap(pixels, w, h, Bitmap.Config.ARGB_8888)
+    }
+
+    private fun boxBlurH(
+        src: IntArray,
+        dst: IntArray,
+        w: Int,
+        h: Int,
+        r: Int,
+    ) {
+        val div = r * 2 + 1
+        for (y in 0 until h) {
+            val row = y * w
+            var a = 0
+            var rr = 0
+            var gg = 0
+            var bb = 0
+            for (i in -r..r) {
+                val c = src[row + i.coerceIn(0, w - 1)]
+                a += (c ushr 24) and 0xFF
+                rr += (c ushr 16) and 0xFF
+                gg += (c ushr 8) and 0xFF
+                bb += c and 0xFF
+            }
+            for (x in 0 until w) {
+                dst[row + x] = ((a / div) shl 24) or ((rr / div) shl 16) or ((gg / div) shl 8) or (bb / div)
+                val out = src[row + (x - r).coerceIn(0, w - 1)]
+                val inn = src[row + (x + r + 1).coerceIn(0, w - 1)]
+                a += ((inn ushr 24) and 0xFF) - ((out ushr 24) and 0xFF)
+                rr += ((inn ushr 16) and 0xFF) - ((out ushr 16) and 0xFF)
+                gg += ((inn ushr 8) and 0xFF) - ((out ushr 8) and 0xFF)
+                bb += (inn and 0xFF) - (out and 0xFF)
+            }
+        }
+    }
+
+    private fun boxBlurV(
+        src: IntArray,
+        dst: IntArray,
+        w: Int,
+        h: Int,
+        r: Int,
+    ) {
+        val div = r * 2 + 1
+        for (x in 0 until w) {
+            var a = 0
+            var rr = 0
+            var gg = 0
+            var bb = 0
+            for (i in -r..r) {
+                val c = src[i.coerceIn(0, h - 1) * w + x]
+                a += (c ushr 24) and 0xFF
+                rr += (c ushr 16) and 0xFF
+                gg += (c ushr 8) and 0xFF
+                bb += c and 0xFF
+            }
+            for (y in 0 until h) {
+                dst[y * w + x] = ((a / div) shl 24) or ((rr / div) shl 16) or ((gg / div) shl 8) or (bb / div)
+                val out = src[(y - r).coerceIn(0, h - 1) * w + x]
+                val inn = src[(y + r + 1).coerceIn(0, h - 1) * w + x]
+                a += ((inn ushr 24) and 0xFF) - ((out ushr 24) and 0xFF)
+                rr += ((inn ushr 16) and 0xFF) - ((out ushr 16) and 0xFF)
+                gg += ((inn ushr 8) and 0xFF) - ((out ushr 8) and 0xFF)
+                bb += (inn and 0xFF) - (out and 0xFF)
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiInputStats.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiInputStats.kt
new file mode 100644
index 0000000..08d8f53
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiInputStats.kt
@@ -0,0 +1,1309 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import android.os.SystemClock
+import android.view.KeyEvent
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import timber.log.Timber
+import java.io.File
+import java.time.DayOfWeek
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import java.util.LinkedHashMap
+
+/**
+ * 输入统计引擎（大海版自研）。
+ *
+ * 设计原则（与常见实现的关键差别）：
+ *
+ * 1. **数据来自真实事件**，不靠"输入串长度有没有变"去猜。
+ *    按键在 [KeyView] 按下时逐次计数，因此空格 / 退格 / 数字键选词 / 翻页都算得准，
+ *    且与键盘热力图同源 —— 两个数字永远对得上。
+ * 2. **不丢混排**：上屏文本按字符分类累加（汉字 / 英文 / 数字 / 标点），
+ *    打英文、打数字、中英混排都不会被整条丢弃。
+ * 3. **四个周期的热力同时累加**：今日 / 本周 / 本月 / 今年的键位计数各自独立增长，
+ *    切到"本月"也能看到完整热力图，而不是空白。
+ * 4. **修正率用真实口径**：退格次数 ÷ 字符键击键数（可解释、可复核），
+ *    不是两个不同估算量相减得到的误差。
+ * 5. **隐私优先**：密码 / 验证码等敏感输入框内完全不计；统计可随时关闭；
+ *    只存聚合计数，永不记录输入内容。
+ *
+ * 数据落在 `filesDir/dahi_input_stats.json`，按输入方案分桶，写盘带 2 秒防抖。
+ */
+object DahiInputStats {
