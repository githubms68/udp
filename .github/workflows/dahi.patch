+        content.addView(
+            infoRow(
+                ctx.getString(R.string.dahi_vs_clear_models),
+                ctx.getString(R.string.dahi_vs_model_count, models.size),
+                clickable = models.isNotEmpty(),
+            ) {
+                confirmClearModels()
+            },
