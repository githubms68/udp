+
+    private fun actionRow(): View {
+        val ctx = requireContext()
+        return LinearLayout(ctx).apply {
+            orientation = LinearLayout.HORIZONTAL
+            setPadding(0, ctx.dp(16), 0, 0)
+            val clean =
+                Button(ctx).apply {
+                    setText(getString(R.string.dahi_health_clean, 0))
+                    setOnClickListener { confirmClean() }
+                }
+            addView(clean)
