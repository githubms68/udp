+    private fun titleColor(): Int = themeColor(android.R.attr.textColorPrimary, 0xDE000000.toInt())
+
+    private fun summaryColor(): Int = themeColor(android.R.attr.textColorSecondary, 0x8A000000.toInt())
+
+    private fun accentColor(): Int = themeColor(androidx.appcompat.R.attr.colorAccent, 0xFF3F6FE0.toInt())
+
+    private fun themeColor(
+        attr: Int,
+        fallback: Int,
+    ): Int = runCatching {
+        val tv = android.util.TypedValue()
+        requireContext().theme.resolveAttribute(attr, tv, true)
+        if (tv.resourceId != 0) ContextCompat.getColor(requireContext(), tv.resourceId) else tv.data
+    }.getOrDefault(fallback)
+
+    // ---------------- 行模型 / 适配器 ----------------
+
+    private sealed interface Row {
+        data class Header(
+            val label: String,
+        ) : Row
+
+        data class Entry(
+            val bean: AsrHistoryBean,
+        ) : Row
+    }
+
+    private inner class HistoryAdapter : RecyclerView.Adapter<RecyclerView.ViewHolder>() {
+        private var data: List<Row> = emptyList()
+
+        fun submit(list: List<Row>) {
+            data = list
+            notifyDataSetChanged()
+        }
+
+        override fun getItemViewType(position: Int): Int = if (data[position] is Row.Header) TYPE_HEADER else TYPE_ENTRY
+
+        override fun getItemCount(): Int = data.size
+
+        override fun onCreateViewHolder(
+            parent: ViewGroup,
+            viewType: Int,
+        ): RecyclerView.ViewHolder {
+            val ctx = parent.context
+            if (viewType == TYPE_HEADER) {
+                return HeaderHolder(
+                    TextView(ctx).apply {
+                        textSize = 12f
+                        setTextColor(summaryColor())
+                        setPadding(ctx.dp(4), ctx.dp(14), 0, ctx.dp(6))
+                    },
+                )
+            }
+
+            val card =
+                LinearLayout(ctx).apply {
+                    orientation = LinearLayout.VERTICAL
+                    setPadding(ctx.dp(12), ctx.dp(10), ctx.dp(12), ctx.dp(10))
+                    background = rounded(0x14808080, 10f)
+                    isClickable = true
+                }
+            val head =
+                LinearLayout(ctx).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    gravity = Gravity.CENTER_VERTICAL
+                }
+            val timeView =
+                TextView(ctx).apply {
+                    textSize = 11f
+                    setTextColor(summaryColor())
+                }
+            head.addView(timeView, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            val copyView =
+                TextView(ctx).apply {
+                    text = getString(R.string.dahi_ah_copy)
+                    textSize = 11f
+                    setTextColor(accentColor())
+                    setPadding(ctx.dp(8), ctx.dp(2), ctx.dp(8), ctx.dp(2))
+                    background = rounded(0x1A808080, 6f)
+                }
+            head.addView(copyView)
+            val bodyView =
+                TextView(ctx).apply {
+                    textSize = 15f
+                    setTextColor(titleColor())
+                    maxLines = 3
+                    ellipsize = TextUtils.TruncateAt.END
+                    setPadding(0, ctx.dp(6), 0, ctx.dp(4))
+                }
+            val metaView =
+                TextView(ctx).apply {
+                    textSize = 11f
+                    setTextColor(summaryColor())
+                }
+            card.addView(head)
+            card.addView(bodyView)
+            card.addView(metaView)
+
+            val holder = EntryHolder(card, timeView, copyView, bodyView, metaView)
+
+            card.setOnClickListener {
+                rowAt(holder)?.let { row ->
+                    if (selecting) toggleSelected(row.bean.id) else showDetail(row.bean)
+                }
+            }
+            card.setOnLongClickListener {
+                val row = rowAt(holder)
+                if (row == null) {
+                    false
+                } else {
+                    selecting = true
+                    toggleSelected(row.bean.id)
+                    true
+                }
+            }
+            copyView.setOnClickListener {
+                rowAt(holder)?.let { copyText(it.bean.text) }
+            }
+            return holder
+        }
+
+        override fun onBindViewHolder(
+            holder: RecyclerView.ViewHolder,
+            position: Int,
+        ) {
+            val row = data[position]
+            if (row is Row.Header) {
+                (holder as HeaderHolder).label.text = row.label
+                return
+            }
+            val entry = row as Row.Entry
+            val h = holder as EntryHolder
+            h.time.text = timeFormat.format(Date(entry.bean.createdAt))
+            h.body.text = entry.bean.text
+            h.meta.text = metaOf(entry.bean)
+            h.copy.visibility = if (selecting) View.GONE else View.VISIBLE
+            h.card.background = rounded(if (entry.bean.id in selected) 0x334F8DF7 else 0x14808080, 10f)
+        }
+
+        private fun rowAt(holder: EntryHolder): Row.Entry? {
+            val pos = holder.bindingAdapterPosition
+            if (pos == RecyclerView.NO_POSITION) return null
+            return data.getOrNull(pos) as? Row.Entry
+        }
+    }
+
+    private class HeaderHolder(
+        val label: TextView,
+    ) : RecyclerView.ViewHolder(label)
+
+    private class EntryHolder(
+        val card: View,
+        val time: TextView,
+        val copy: TextView,
+        val body: TextView,
+        val meta: TextView,
+    ) : RecyclerView.ViewHolder(card)
+
+    private companion object {
+        const val TYPE_HEADER = 0
+        const val TYPE_ENTRY = 1
+        const val BUCKET_TODAY = 0
+        const val BUCKET_YESTERDAY = 1
+        const val BUCKET_WEEK = 2
+        const val BUCKET_EARLIER = 3
+        const val DAY_MS = 24 * 60 * 60 * 1000L
+    }
+}
