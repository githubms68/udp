--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiWordHidden.kt
@@ -0,0 +1,79 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import androidx.preference.PreferenceManager
+
+/**
+ * 词云隐藏名单。
+ *
+ * 为什么是「隐藏」而不是「删除」：
+ * - 词云数据按周期分桶（今日 / 本周 / 本月 / 生涯），删掉当前桶里的词，换个周期它又回来了；
+ * - 删了不可逆，隐藏随时能恢复；
+ * - 隐私诉求是「别显示」，不是「别统计」。
+ *
+ * 所以这里**只在读取时过滤**：桶里的统计数字一个都不动，
+ * 输入法热路径（打字埋点）完全不碰这份名单 —— 它只在画词云那一下被读一次。
+ *
+ * 名单是全局的（不分周期、不分方案）：保护隐私要求「这个词永远别出现」，
+ * 而不是「本周别出现、本月又冒出来」。
+ */
+object DahiWordHidden {
+    /** 存储键。备份与还原也按这个键识别。 */
+    const val PREF_KEY = "dahi_word_hidden"
+
+    private fun prefs(ctx: Context) = PreferenceManager.getDefaultSharedPreferences(ctx)
+
+    /** 当前被隐藏的词（副本，外部随便改都不影响存储）。 */
+    fun load(ctx: Context): Set<String> =
+        runCatching { prefs(ctx).getStringSet(PREF_KEY, emptySet()) ?: emptySet() }
+            .getOrDefault(emptySet())
+            .toSet()
+
+    fun hide(
+        ctx: Context,
+        word: String,
+    ) {
+        if (word.isEmpty()) return
+        runCatching {
+            val set = load(ctx).toMutableSet()
+            set.add(word)
+            prefs(ctx).edit().putStringSet(PREF_KEY, set).apply()
+        }
+    }
+
+    fun restore(
+        ctx: Context,
+        word: String,
+    ) {
+        if (word.isEmpty()) return
+        runCatching {
+            val set = load(ctx).toMutableSet()
+            if (set.remove(word)) prefs(ctx).edit().putStringSet(PREF_KEY, set).apply()
+        }
+    }
+
+    fun clear(ctx: Context) {
+        runCatching { prefs(ctx).edit().remove(PREF_KEY).apply() }
+    }
+
+    /**
+     * 过滤一个词频表。
+     *
+     * 名单为空时原样返回（不复制、不新建集合），所以没设过隐藏的用户零额外开销。
+     */
+    fun filter(
+        ctx: Context,
+        words: Map<String, Long>,
+    ): Map<String, Long> {
+        if (words.isEmpty()) return words
+        val hidden = load(ctx)
+        if (hidden.isEmpty()) return words
+        return words.filterKeys { it !in hidden }
+    }
+}
