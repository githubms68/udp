+    /** 「最近一次」的时间点：统一由 DahiVoiceStats 提供，三处显示不会各写一套。 */
+    private fun lastTimeText(at: Long): String = DahiVoiceStats.lastTimeText(at)
+
+    /** 小时 → 两位数字（09 这种），用于「09–10」这种时段表达。 */
+    private fun hh(hour: Int): String {
+        val h = ((hour % 24) + 24) % 24
+        return String.format(java.util.Locale.US, "%02d", h)
+    }
+
+    /**
+     * Calendar.DAY_OF_WEEK（1 = 周日）→ 本地化「周几」。
+     *
+     * 埋点记的是 Calendar.DAY_OF_WEEK（1..7，1 是周日），
+     * 而 dahi_week_names 是 Mon..Sun（0 = 周一），所以要换算。
+     */
+    private fun weekName(day: Int): String {
+        val names = resources.getStringArray(R.array.dahi_week_names)
+        val index = if (day == 1) 6 else day - 2
+        return names.getOrElse(index) { day.toString() }
+    }
+
+    /** 毫秒 → `m:ss`（超过一小时用 `h:mm:ss`）。 */
+    private fun clock(ms: Long): String {
+        val total = ms / 1000
+        val h = total / 3600
+        val m = (total % 3600) / 60
+        val s = total % 60
+        return if (h > 0) String.format("%d:%02d:%02d", h, m, s) else String.format("%d:%02d", m, s)
+    }
+
+    private fun applyProgress(progress: Float) {
+        val fill = expFill ?: return
+        val rest = expRest ?: return
+        val p = progress.coerceIn(0.002f, 1f)
+        (fill.layoutParams as? LinearLayout.LayoutParams)?.let {
+            it.weight = p
+            fill.layoutParams = it
+        }
+        (rest.layoutParams as? LinearLayout.LayoutParams)?.let {
+            it.weight = (1f - p).coerceAtLeast(0.002f)
+            rest.layoutParams = it
+        }
+    }
+
