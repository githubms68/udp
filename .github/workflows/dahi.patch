index 0000000..16995bc
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiPhraseImport.kt
@@ -0,0 +1,125 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+/**
+ * 自定义短语的批量导入（纯文本解析）。
+ *
+ * 支持的每一行写法（尽量宽容，用户是从别处复制来的）：
+ * - `编码<TAB>正文`；
+ * - rime `custom_phrase.txt` 的 `正文<TAB>编码<TAB>权重`（三段且末段是数字时按此解析）；
+ * - `编码,正文` / `编码=正文` / `编码:正文`；
+ * - `编码 正文`（空格分一次）。
+ *
+ * `#` 开头与空行直接跳过；一行解析不出编码或正文就计入跳过，不抛异常。
+ * 解析是纯函数，便于自查（见 [parse] 的注释示例）。
+ */
+object DahiPhraseImport {
+    data class Item(
+        val code: String,
+        val text: String,
+    )
+
+    data class Result(
+        val added: Int,
+        val skipped: Int,
+    )
+
+    /** 一行是否像「编码」：只含 ASCII 字母数字与常见分隔符。 */
+    private fun looksLikeCode(s: String): Boolean {
+        val t = s.trim()
+        if (t.isEmpty() || t.length > 40) return false
+        return t.all { it.code in 0x21..0x7E } && t.none { it.isLetter() && it.code > 0x7F }
+    }
+
+    private fun splitOnce(
+        line: String,
+        vararg seps: Char,
+    ): Pair<String, String>? {
+        seps.forEach { sep ->
+            val i = line.indexOf(sep)
+            if (i > 0 && i < line.length - 1) {
+                return line.substring(0, i).trim() to line.substring(i + 1).trim()
+            }
+        }
+        return null
+    }
+
+    /** 解析整段文本；同一编码出现多次时以**最后一次**为准。 */
+    fun parse(raw: String): List<Item> {
+        val out = LinkedHashMap<String, String>()
+        raw.lineSequence().forEach { rawLine ->
+            val line = rawLine.trimEnd()
+            if (line.isBlank() || line.trimStart().startsWith("#")) return@forEach
+            val cells = line.split('\t').map { it.trim() }.filter { it.isNotEmpty() }
+            var code: String? = null
+            var text: String? = null
+            when {
+                // rime custom_phrase：正文 <TAB> 编码 <TAB> 权重
+                cells.size >= 3 && cells.last().toIntOrNull() != null -> {
+                    text = cells[0]
+                    code = cells[1]
+                }
+                cells.size == 2 -> {
+                    val (a, b) = cells
+                    if (looksLikeCode(a) && !looksLikeCode(b)) {
+                        code = a
+                        text = b
+                    } else if (!looksLikeCode(a) && looksLikeCode(b)) {
+                        code = b
+                        text = a
+                    } else {
+                        code = a
+                        text = b
+                    }
+                }
+                cells.size == 1 -> {
+                    val pair = splitOnce(line, ',', '=', ':', '：', '，')
+                    if (pair != null) {
+                        code = pair.first
+                        text = pair.second
+                    } else {
+                        // `编码 正文`：以第一个空白切
+                        val idx = line.indexOfFirst { it == ' ' || it == '\u3000' }
+                        if (idx > 0 && idx < line.length - 1) {
+                            code = line.substring(0, idx).trim()
+                            text = line.substring(idx + 1).trim()
+                        }
+                    }
+                }
+            }
+            val c = DahiCustomPhrase.loose(code.orEmpty())
+            val t = text.orEmpty()
+            if (c.isEmpty() || t.isEmpty()) return@forEach
+            out[c] = t
+        }
+        return out.map { Item(it.key, it.value) }
+    }
+
+    /**
+     * 导入。[overwrite] = false 时「同码只保留已有短语」（合并模式）；
+     * true 时以导入内容为准（覆盖模式）。
+     */
+    fun import(
+        raw: String,
+        overwrite: Boolean,
+    ): Result {
+        val items = parse(raw)
+        if (items.isEmpty()) return Result(0, raw.lineSequence().count { it.isNotBlank() })
+        val existing = DahiCustomPhrase.all()
+        var added = 0
+        var skipped = 0
+        items.forEach { item ->
+            if (!overwrite && existing.containsKey(item.code)) {
+                skipped++
+            } else {
+                DahiCustomPhrase.put(item.code, item.text)
+                added++
+            }
+        }
+        return Result(added, skipped)
+    }
+}
