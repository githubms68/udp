+        AlertDialog
+            .Builder(ctx)
+            .setTitle(getString(R.string.dahi_order_menu_title, getString(entry.title)))
+            .setItems(labels) { _, which ->
+                when (which) {
+                    0 -> HomeLayout.moveTop(entry.key)
+                    1 -> HomeLayout.moveUp(entry.key)
+                    2 -> HomeLayout.moveDown(entry.key)
+                    3 -> HomeLayout.moveBottom(entry.key)
+                    else -> HomeLayout.reset()
+                }
+                rebuildScreen()
+            }.show()
+    }
+
+    /** 顺序变化后重建列表（顺序来自偏好，直接重新生成即可）。 */
+    private fun rebuildScreen() {
+        onCreatePreferences(null, null)
     }
 }
