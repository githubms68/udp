+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    /**
+     * 旧版本没有「分组版本」概念，用户可能拖过顺序。
+     * 分类体系整体换过一次（v2），旧顺序会让新分类看起来错位，所以清空一次。
+     */
+    private fun migrateIfNeeded() {
+        val version = prefs.getInt(LAYOUT_VERSION_KEY, 0)
+        if (version >= LAYOUT_VERSION) return
+        prefs.edit {
+            remove(PREF_KEY)
+            entries.forEach { remove(GROUP_OVERRIDE_PREFIX + it.key) }
+            putInt(LAYOUT_VERSION_KEY, LAYOUT_VERSION)
+        }
+    }
+
+    /** 某一项实际所属的分组（用户在排序页拖到别的组里就以覆盖为准）。 */
+    fun groupOf(key: String): HomeGroup {
+        val saved = prefs.getString(GROUP_OVERRIDE_PREFIX + key, null)
+        if (saved != null) {
+            runCatching { HomeGroup.valueOf(saved) }.getOrNull()?.let { return it }
+        }
+        return defaultGroupOf(key)
+    }
+
+    /** 某个入口**默认**属于哪个分组（不受用户覆盖影响）。 */
+    fun defaultGroupOf(key: String): HomeGroup = groupMap[key] ?: HomeGroup.SYSTEM
+
+    /** 把某一项归到指定分组（排序页跨组拖动时调用）；传 null 恢复默认分组。 */
+    fun setGroupOf(
