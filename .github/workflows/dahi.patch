+            DahiDailyHistory.archive(
+                ctx,
+                DahiDailyHistory.Day(
+                    date = DahiDailyHistory.dateOf(bucket.ts),
+                    chars = bucket.chars,
+                    commits = bucket.commits,
+                    activeMs = bucket.activeMs,
+                    peakHour = if (peak >= 0 && hours[peak] > 0) peak else -1,
+                    hours = hours.toList(),
+                ),
+            )
+        }
+    }
+
+    private fun statsOf(schemaId: String): SchemaStats = store.schemas.getOrPut(schemaId.ifEmpty { "_" }) { SchemaStats() }
+
+    /**
+     * 清空当前方案的键位热力（五个桶一起清，含生涯）。
+     *
+     * 热力图是「按方案累计、不分键盘」的，所以换一把键盘后同名的键仍会带着旧数据；
+     * 想从零开始就点「热力图清零」。其它统计（字数、速度、上屏次数）都不动。
+     */
+    fun clearHeat() {
+        if (!enabled || appContext == null) return
+        synchronized(lock) {
+            val stats = statsOf(store.activeSchema)
+            allBuckets(stats, System.currentTimeMillis()).forEach { it.keyHeat.clear() }
+            dirty = true
+        }
+        scheduleSave()
+    }
+
+    // ------------------------------------------------------------------ 埋点
+
+    /**
+     * 一次真实按键。[code] 为 CLICK 行为对应的键码，[label] 为键面文字。
+     *
+     * 字符键（可打印 ASCII，含字母 / 数字 / 符号）计入 [Bucket.charKeys]，
+     * 其余（空格 / 退格 / 回车 / 切换键…）计入 [Bucket.otherKeys]。
+     */
+    fun onKey(
+        code: Int,
+        label: String,
+        nowMs: Long = SystemClock.elapsedRealtime(),
+    ) {
+        if (!enabled || sensitive || appContext == null) return
+        // 注意：这里收到的 code 是 **Android keycode**（KEYCODE_A=29…），
+        // 不是 keysym。早期用 `code in 0x20..0x7E` 判断「字符键」，
+        // 结果字母 A~C(29~31)、数字 0~9(7~16) 全漏掉，而退格(67)/回车(66)/空格(62) 反被算进去，
+        // 修正率的分母一直是错的。改成看键面文字：单字符（且不是空白）才算字符键。
+        val charKey =
+            if (label.length == 1) {
+                val c = label[0]
+                !c.isWhitespace() && !c.isISOControl()
+            } else {
+                code in KeyEvent.KEYCODE_A..KeyEvent.KEYCODE_Z || code in KeyEvent.KEYCODE_0..KeyEvent.KEYCODE_9
+            }
+        synchronized(lock) {
+            val stats = statsOf(store.activeSchema)
+            // bucketOf 可能为 null（CAREER 无对应桶），用 listOfNotNull 保证下面拿到的是非空 Bucket
+            val buckets = allBuckets(stats, System.currentTimeMillis())
+            buckets.forEach { b ->
+                if (charKey) b.charKeys++ else b.otherKeys++
+                if (code == KEYCODE_BACKSPACE || code == KEYCODE_DEL) {
+                    b.backspaces++
+                    // 语音上屏后 20 秒内的退格，计到「语音返工」上（改字率用）
+                    runCatching { DahiVoiceStats.onBackspace() }
+                }
+                if (label.isNotEmpty()) b.keyHeat[label] = (b.keyHeat[label] ?: 0L) + 1L
+            }
+            // 有效时长：只有连续输入的间隔才算"在打字"
+            if (lastKeyMs != 0L) {
+                val gap = nowMs - lastKeyMs
+                if (gap in 0..ACTIVE_GAP_MS) buckets.forEach { it.activeMs += gap }
+            }
+            lastKeyMs = nowMs
+            dirty = true
+        }
+        scheduleSave()
+    }
+
+    /**
+     * 一次上屏。[text] 是最终提交给应用的内容，[rawBefore] 是触发它的原始编码。
+     *
+     * 文本按字符分类累加，中英混排不会被丢弃。
+     */
+    fun onCommit(
+        text: String,
+        rawBefore: String,
+        schemaId: String,
+        nowMs: Long = SystemClock.elapsedRealtime(),
+    ) {
+        if (!enabled || sensitive || appContext == null || text.isEmpty()) return
+        // 本次上屏是不是「点候选 / 数字键」触发的（那些路径已经自己记过 picks）。
+        // 不是的话就是空格 / 回车 / 唯一候选自动上屏 —— 等价于「选了第一个」。
+        // 不补这一条，「首选率」只统计了点选那一小撮人，数值会一直偏高。
+        val picked = pendingPick
+        pendingPick = false
+        var han = 0
+        var eng = 0
+        var num = 0
+        var punct = 0
+        var inWord = false
+        text.forEach { c ->
+            when {
+                isHanzi(c) -> {
+                    han++
+                    inWord = false
+                }
+                c.isLetter() -> {
+                    if (!inWord) {
+                        eng++
+                        inWord = true
+                    }
+                }
+                c.isDigit() -> {
+                    num++
+                    inWord = false
+                }
+                c.isWhitespace() -> inWord = false
+                else -> {
+                    punct++
+                    inWord = false
+                }
+            }
+        }
+        if (han == 0 && eng == 0 && num == 0 && punct == 0) return
+
+        val rawLen = rawBefore.length
+        val spd = windowSpeed(nowMs, han, rawLen)
+        synchronized(lock) {
+            val stats = statsOf(schemaId)
+            val now = System.currentTimeMillis()
+            val buckets = allBuckets(stats, now)
+            buckets.forEach { b ->
+                b.chars += han.toLong()
+                if (han > 0) {
+                    // 时段分布：按「上屏那一刻」的小时 / 星期归桶
+                    val hour = currentHour()
+                    val hk = hour.toString()
+                    b.hours[hk] = (b.hours[hk] ?: 0L) + han.toLong()
+                    val wd = currentWeekday().toString()
+                    b.weekdays[wd] = (b.weekdays[wd] ?: 0L) + han.toLong()
+                    if (wordCloudEnabled) recordWord(b, text)
+                }
+                b.words += eng.toLong()
+                b.digits += num.toLong()
+                b.puncts += punct.toLong()
+                b.commits++
+                if (han > 0 && !picked && rawLen > 0) {
+                    b.picks++
+                    b.firstPicks++
+                }
+                if (han > 0) {
+                    // 只统计「由编码产生」的上屏：语音输入 / 直接上屏（rawLen=0）不该稀释平均码长
+                    if (rawLen > 0) {
+                        b.typedChars += han.toLong()
+                        b.codeLenChars += han.toLong()
+                        b.codeLenSum += rawLen.toLong()
+                        b.codeLenCnt++
+                    }
+                    val key = han.coerceAtMost(9).toString()
+                    b.wordLen[key] = (b.wordLen[key] ?: 0L) + 1L
+                    if (rawLen > 0) {
+                        val ck = rawLen.coerceAtMost(12).toString()
+                        b.codeLen[ck] = (b.codeLen[ck] ?: 0L) + 1L
+                    }
+                    if (spd > b.fastest) b.fastest = spd
+                }
+            }
+            stats.careerChars += han.toLong()
+            stats.careerCommits++
+            dirty = true
+        }
+        scheduleSave()
+    }
+
+    /**
+     * 一次候选选择：[index] 从 0 开始，[pageFlipped] 表示选中前翻过页。
+     * 用于首选率、平均候选位置与翻页率。
+     */
+    fun onCandidatePick(
+        index: Int,
+        pageFlipped: Boolean = false,
+    ) {
+        if (!enabled || sensitive || appContext == null || index < 0) return
+        pendingPick = true
+        synchronized(lock) {
+            val stats = statsOf(store.activeSchema)
+            val now = System.currentTimeMillis()
+            allBuckets(stats, now).forEach { b ->
+                b.picks++
+                if (index == 0) b.firstPicks++
+                if (pageFlipped) b.pagedPicks++
+                b.pickIdxSum += index.toLong()
+            }
+            dirty = true
+        }
+        scheduleSave()
+    }
+
+    /**
+     * 当前输入方案（由 [Rime] 在每次按键时同步，用于把选词归到正确方案）。
+     *
+     * [name] 是方案的中文名（来自 libRime 的 status.schemaName），仅用于展示。
+     * 记下它之后，统计页与分享图就能明确写出「这些数字是用哪个方案打出来的」——
+     * 同一个用户换方案后数据会分桶，光看数字无法判断，加上方案名才有解释力。
+     */
+    fun setActiveSchema(
+        schemaId: String,
+        name: String = "",
+    ) {
+        if (schemaId.isEmpty()) return
+        val changed =
+            synchronized(lock) {
+                var c = false
+                if (store.activeSchema != schemaId) {
+                    store.activeSchema = schemaId
+                    c = true
+                }
+                if (name.isNotEmpty() && !name.startsWith(".")) {
+                    if (store.activeSchemaName != name) {
+                        store.activeSchemaName = name
+                        c = true
+                    }
+                    val st = store.schemas.getOrPut(schemaId) { SchemaStats() }
+                    if (st.name != name) {
+                        st.name = name
+                        c = true
+                    }
+                }
+                if (c) dirty = true
+                c
+            }
+        if (changed) scheduleSave()
+    }
+
+    /** 当前方案的 id（如 `luna_pinyin`）；未知时返回空串。 */
+    fun activeSchemaId(): String = synchronized(lock) { store.activeSchema }
+
+    /** 当前方案的显示名；未知时返回空串。 */
+    fun activeSchemaName(): String = synchronized(lock) {
+        store.activeSchemaName.ifEmpty { store.schemas[store.activeSchema]?.name.orEmpty() }
+    }
+
+    /** 某个方案的显示名（[schemaId] 为空时取当前方案）。 */
+    fun schemaNameOf(schemaId: String? = null): String = synchronized(lock) {
+        val id = schemaId?.takeIf { it.isNotEmpty() } ?: store.activeSchema
+        store.schemas[id]?.name.orEmpty()
+    }
+
+    /**
+     * 记录一次键盘布局的几何。
+     *
+     * 主键盘 / 数字键盘 / 符号键盘都会来登记，所以按「布局签名」分别留存（最多 [LAYOUT_LIMIT] 套），
+     * 展示时由 [lastLayout] 挑出主键盘。这样偶尔按一次数字键盘，再也不会把热力图带偏。
+     */
+    fun recordLayout(rows: List<List<HeatKey>>) {
+        if (rows.isEmpty()) return
+        synchronized(lock) {
+            val signature = signatureOf(rows)
+            val list = store.layouts
+            val idx = list.indexOfFirst { signatureOf(it) == signature }
+            if (idx >= 0) {
+                // 见过这套布局：挪到末尾表示「最近还在用」，超出上限时优先淘汰最久未用的
+                if (idx != list.lastIndex) list.add(list.removeAt(idx))
+                return
+            }
+            list.add(rows)
+            while (list.size > LAYOUT_LIMIT) list.removeAt(0)
+            store.layout = rows
+            dirty = true
+        }
+        scheduleSave()
+    }
+
+    /**
+     * 展示用的键盘布局：在所有记录过的布局里挑「最像主键盘」的那一套。
+     *
+     * 判据是字母键（单个 a-z 字符的键面）的数量 —— 主键盘几十个，数字键盘 / 符号键盘几乎为零。
+     * 同分时取较晚登记的一套，等于「最近使用」。
+     */
+    fun lastLayout(): List<List<HeatKey>> = synchronized(lock) {
+        val list = store.layouts
+        if (list.isEmpty()) return@synchronized emptyList()
+        // 只排除「几乎没有字母键」的布局（数字键盘 / 符号键盘），
+        // 其余一律取**最近登记的那一套**。
+        // 早前用的是「字母键最多优先」，结果 26 键的 QWERTY 永远压住 21 键的 7 列布局 ——
+        // 用户换键盘后热力图「卡在 QWER 不动」就是这个原因。
+        val main = list.filter { letterScore(it) >= MIN_MAIN_LETTERS }
+        main.lastOrNull() ?: list.last()
+    }
+
+    /** 字母键数量：用于判断一套布局是不是主键盘。 */
+    private fun letterScore(rows: List<List<HeatKey>>): Int = rows.sumOf { row ->
+        row.count { k -> k.label.length == 1 && k.label[0].isLetter() }
+    }
+
+    private fun signatureOf(rows: List<List<HeatKey>>): String = rows.joinToString("|") { row -> row.joinToString(",") { it.label } }
+
+    // ------------------------------------------------------------------ 读取
+
+    /** 读取指定周期 / 方案的数据快照（UI 用，返回副本，不影响内部状态）。 */
+
+    /**
+     * snapshot 的进程内缓存。
+     *
+     * 统计页每次进入、分享图每次导出都会取快照，而 deepCopy 一份完整桶（词频、热力、
+     * 时段都是 map）在生涯周期上开销不小 —— 这就是「进统计页要等一下」的主要来源。
+     * 缓存键里带了数据指纹：任何一次上屏都会改 chars / commits，键随之变化，缓存自动失效；
+     * 热力图清零这类不动字数的操作，靠 keyHeat.size 感知。
+     *
+     * 注意：命中时返回的是**同一个对象**，调用方只读、不要改（现有调用全部只读）。
+     */
+    private val snapCache = LinkedHashMap<String, Bucket>()
+
+    private fun fingerprintLocked(period: Period): String {
+        val sb = StringBuilder()
+        sb.append(store.activeSchema).append('#').append(period.name)
+        // 非生涯周期是「按当前时间聚合」出来的，跨分钟就得重算，否则零点后还显示昨天的数
+        if (period != Period.CAREER) sb.append('#').append(System.currentTimeMillis() / 60_000L)
+        store.schemas.forEach { (k, st) ->
+            val c = st.career
+            sb.append('|').append(k)
+                .append(':').append(c.chars).append(',').append(c.commits)
+                .append(',').append(c.words).append(',').append(c.digits).append(',').append(c.puncts)
+                .append(',').append(c.picks)
+                .append(',').append(c.keyHeat.size).append(',').append(c.hours.size)
+                .append(',').append(c.wordFreq.size)
+        }
+        return sb.toString()
+    }
+
+    fun snapshot(
+        period: Period,
+        schemaId: String? = null,
+    ): Bucket = synchronized(lock) {
+        val id = schemaId?.takeIf { it.isNotEmpty() } ?: store.activeSchema.ifEmpty { "_" }
+        val stats = store.schemas[id] ?: return@synchronized Bucket()
+        val key = id + "@" + fingerprintLocked(period)
+        snapCache[key]?.let { return@synchronized it }
+        val now = System.currentTimeMillis()
+        val result =
+            when (period) {
+                // 生涯直接返回全量桶的副本：击键、速度、分布、候选质量、热力全部都有数
+                Period.CAREER -> stats.career.deepCopy()
+                else -> (bucketOf(stats, period, now) ?: Bucket()).deepCopy()
+            }
+        // 只留最近几次，别让缓存无限长
+        if (snapCache.size >= 4) snapCache.clear()
+        snapCache[key] = result
+        // 打开今天的统计时，把今天也刷进每日历史（否则「今天」这根柱要等到明天才出现）
+        if (period == Period.TODAY) {
+            appContext?.let { ctx -> runCatching { upsertTodayLocked(ctx, result) } }
+        }
+        result
+    }
+
+    private fun upsertTodayLocked(
+        ctx: Context,
+        today: Bucket,
+    ) {
+        if (today.chars <= 0L) return
+        val hours = IntArray(24)
+        today.hours.forEach { (k, v) ->
+            val h = k.toIntOrNull() ?: return@forEach
+            if (h in 0..23) hours[h] = v.toInt()
+        }
+        val peak = hours.indices.maxByOrNull { hours[it] } ?: -1
+        DahiDailyHistory.upsertToday(
+            ctx,
+            DahiDailyHistory.Day(
+                date = DahiDailyHistory.today(),
+                chars = today.chars,
+                commits = today.commits,
+                activeMs = today.activeMs,
+                peakHour = if (peak >= 0 && hours[peak] > 0) peak else -1,
+                hours = hours.toList(),
+            ),
+        )
+    }
+
+    /** 单个方案的生涯汇总（用于「方案对比」）。 */
+    data class SchemaSummary(
+        val id: String,
+        val name: String,
+        val chars: Long,
+        val commits: Long,
+        val avgSpeed: Double,
+        val firstPick: Double,
+    )
+
+    /**
+     * 各方案的生涯汇总，按汉字数倒序。
+     *
+     * 统计本来就是按方案分桶的，所以「换方案前后」的数据天然可比 ——
+     * 只差一个能看的地方。这里把每个方案的生涯字数 / 上屏 / 均速 / 首选率取出来。
+     */
+    fun schemaSummary(): List<SchemaSummary> = synchronized(lock) {
+        store.schemas.entries
+            .filter { it.value.career.chars > 0L }
+            .map { (id, st) ->
+                SchemaSummary(
+                    id = id,
+                    name = st.name.ifEmpty { id },
+                    chars = st.career.chars,
+                    commits = st.career.commits,
+                    avgSpeed = st.career.avgSpeed,
+                    firstPick = st.career.firstPickRatio,
+                )
+            }.sortedByDescending { it.chars }
+    }
+
+    /** 有数据的方案列表（id → 汉字数），按汉字数倒序。 */
+    fun schemaList(): List<Pair<String, Long>> = synchronized(lock) {
+        store.schemas.entries
+            .map { it.key to (it.value.daily.chars + it.value.careerChars) }
+            .sortedByDescending { it.second }
+    }
+
+    // ------------------------------------------------------------------ 维护
+
+    fun clearAll() {
+        synchronized(lock) {
+            // 键位几何与方案名不是「输入数据」，清统计时保留，否则热力图会变成空白
+            val keepLayouts = store.layouts
+            val keepLayout = store.layout
+            val keepName = store.activeSchemaName
+            val keepActive = store.activeSchema
+            store = Store()
+            store.layouts = keepLayouts
+            store.layout = keepLayout
+            store.activeSchemaName = keepName
+            store.activeSchema = keepActive
+            dirty = true
+        }
+        flush()
+    }
+
+    fun clearPeriod(period: Period) {
+        synchronized(lock) {
+            store.schemas.values.forEach { stats ->
+                when (period) {
+                    Period.TODAY -> stats.daily.reset(0)
+                    Period.WEEK -> stats.weekly.reset(0)
+                    Period.MONTH -> stats.monthly.reset(0)
+                    Period.YEAR -> stats.yearly.reset(0)
+                    Period.CAREER -> {
+                        // 清生涯 = 只清生涯桶，不动键位几何
+                        stats.career.reset(0)
+                        stats.careerChars = 0L
+                        stats.careerCommits = 0L
+                    }
+                }
+            }
+            dirty = true
+        }
+        flush()
+    }
+
+    /** 导出为可读 JSON（供备份 / 迁移，不含任何输入内容）。 */
+    fun exportJson(): String = synchronized(lock) { json.encodeToString(Store.serializer(), store) }
+
+    /** 从 JSON 恢复（备份还原用）；失败返回 false，不影响现有数据。 */
+    fun importJson(text: String): Boolean {
+        val loaded = runCatching { json.decodeFromString(Store.serializer(), text) }.getOrNull() ?: return false
+        synchronized(lock) {
+            store = loaded
+            dirty = true
+        }
+        flush()
+        return true
+    }
+
+    // ------------------------------------------------------------------ 段位 / 等级 / 评级
+
+    /** 段位档案（三期游戏化）。 */
+    data class Rank(
+        /** 境界名，按生涯汉字数分档。 */
+        val realm: String,
+        val level: Int,
+        /** 生涯累计汉字数（= 经验值）。 */
+        val exp: Long,
+        /** 当前等级内已获得。 */
+        val inLevel: Long,
+        /** 升到下一级还需的总量。 */
+        val levelSpan: Long,
+    ) {
+        /** 当前等级进度 0~1。 */
+        val progress: Float
+            get() = if (levelSpan > 0) (inLevel.toFloat() / levelSpan).coerceIn(0f, 1f) else 0f
+    }
+
+    private val realms =
+        arrayOf(
+            0L to "初执笔",
+            1_000L to "入门",
+            5_000L to "渐熟",
+            20_000L to "得心应手",
+            60_000L to "游刃有余",
+            150_000L to "出神入化",
+            400_000L to "键上飞仙",
+        )
+
+    /**
+     * 按生涯汉字数算段位：境界看总量，等级用递增曲线（每级所需 100 + 20×(lv-1)）。
+     * 与"直接用字数除以常数"相比，前期升级更快、后期不膨胀，视觉上更有节奏。
+     */
+    fun rankOf(careerChars: Long): Rank {
+        var realm = realms[0].second
+        realms.forEach { (need, name) -> if (careerChars >= need) realm = name }
+
+        var left = careerChars
+        var level = 1
+        var span = 100L
+        while (left >= span && level < 99) {
+            left -= span
+            level++
+            span = 100L + 20L * (level - 1)
+        }
+        return Rank(realm, level, careerChars, left, span)
+    }
+
+    /** 迅捷评级：看均速（字/分）。 */
+    fun attrSpeed(spd: Double): String = when {
+        spd >= 80 -> "S"
+        spd >= 60 -> "A"
+        spd >= 40 -> "B+"
+        spd >= 25 -> "B"
+        else -> "C"
+    }
+
+    /** 精准评级：看修正率（退格 ÷ 字符键），越低越好。 */
+    fun attrAccuracy(ratio: Double): String = when {
+        ratio <= 0.02 -> "S"
+        ratio <= 0.04 -> "A+"
+        ratio <= 0.07 -> "A"
+        ratio <= 0.12 -> "B+"
+        else -> "B"
+    }
+
+    /** 博学评级：看首选率（词库贴合度）。 */
+    fun attrBreadth(firstPick: Double): String = when {
+        firstPick >= 0.80 -> "S"
+        firstPick >= 0.65 -> "A"
+        firstPick >= 0.50 -> "B+"
+        firstPick >= 0.35 -> "B"
+        else -> "C"
+    }
+
+    /** 效率诊断结论：由规则从当期数据推出，UI 直接映射成一句人话。 */
+    enum class Advice { NONE, OK, FAST, DICT, PAGING, CORRECTION, CODELEN }
+
+    /**
+     * 给当期数据下一句「诊断」。
+     *
+     * 只做**可执行**的判断：每一条都对应一个用户马上能做的动作
+     * （换码表 / 调候选顺序 / 改键位 / 换方案），而不是把数字再念一遍。
+     * 阈值都带最小样本量，避免刚装上就冒出一堆结论。
+     */
+    fun adviceOf(b: Bucket): Advice = when {
+        b.picks >= 20 && b.firstPickRatio < 0.5 -> Advice.DICT
+        b.picks >= 20 && b.pageFlipRatio > 0.25 -> Advice.PAGING
+        b.charKeys >= 200 && b.correctionRatio > 0.12 -> Advice.CORRECTION
+        b.chars >= 50 && b.avgCodeLen > 3.6 -> Advice.CODELEN
+        b.chars >= 50 && b.avgSpeed >= 40 -> Advice.FAST
+        b.chars >= 50 -> Advice.OK
+        else -> Advice.NONE
+    }
+
+    /** 今日称号：按当期数据给一句人话，数据不足时返回空串。 */
+    fun titleOf(b: Bucket): String = when {
+        b.chars < 20 -> ""
+        b.avgSpeed >= 80 && b.correctionRatio <= 0.05 -> "指尖生风"
+        b.correctionRatio <= 0.03 && b.firstPickRatio >= 0.70 -> "心有灵犀"
+        b.fastest >= 100 -> "手速惊人"
+        b.avgSpeed >= 60 -> "疾笔如飞"
+        b.firstPickRatio >= 0.75 -> "词库对口"
+        b.avgCodeLen in 0.1..2.9 -> "码上生花"
+        b.pageFlipRatio <= 0.15 -> "一页即中"
+        else -> "稳步前行"
+    }
+
+    // ------------------------------------------------------------------ 内部工具
+
+    /**
+     * 深拷贝一个桶。
+     *
+     * 三个分布字段都是 [MutableMap]，`copy()` 只会复制引用 —— 界面线程在遍历时
+     * 输入法线程可能正在写入，会偶发 ConcurrentModificationException。UI 一律拿深拷贝。
+     */
+
+    /** 当前小时（0~23）。抽出来便于统一取值来源。 */
+    private fun currentHour(): Int = java.util.Calendar.getInstance().get(java.util.Calendar.HOUR_OF_DAY)
+
+    /**
+     * 词云开关（默认关）。改它需要用户明确同意，因为它会记录「输入过的词」。
+     *
+     * **纯本地**：词频只写在应用自己的 SharedPreferences / 统计 JSON 里，
+     * 本应用连 `INTERNET` 权限都没有声明，不存在任何上传路径。
+     */
+    @Volatile
+    private var wordCloudEnabled: Boolean =
+        runCatching {
+            // 默认 **开启**：只有用户自己关过（存了 false）才算关。
+            // 以前默认 false，导致「升级 / 重装后词云开关变回关闭」，用户会以为历史词频被清空了。
+            appContext
+                ?.getSharedPreferences("dahi_stats", android.content.Context.MODE_PRIVATE)
+                ?.getBoolean(KEY_WORD_CLOUD, true) != false
+        }.getOrDefault(true)
+
+    fun isWordCloudEnabled(): Boolean = wordCloudEnabled
+
+    fun setWordCloudEnabled(enabled: Boolean) {
+        wordCloudEnabled = enabled
+        runCatching {
+            appContext
+                ?.getSharedPreferences("dahi_stats", android.content.Context.MODE_PRIVATE)
+                ?.edit()
+                ?.putBoolean(KEY_WORD_CLOUD, enabled)
+                ?.apply()
+        }
+        // 关闭时顺手清空，避免残留「历史输入过的词」
+        if (!enabled) {
+            synchronized(lock) {
+                store.schemas.values.forEach { st ->
+                    st.daily.wordFreq.clear()
+                    st.weekly.wordFreq.clear()
+                    st.monthly.wordFreq.clear()
+                    st.yearly.wordFreq.clear()
+                    st.career.wordFreq.clear()
+                    st.daily.wordTimes.clear()
+                    st.weekly.wordTimes.clear()
+                    st.monthly.wordTimes.clear()
+                    st.yearly.wordTimes.clear()
+                    st.career.wordTimes.clear()
+                }
+                dirty = true
+            }
+            flush()
+        }
+    }
+
+    /** 记录一次上屏里的「词」（只认 2~6 字纯汉字，超出上限后不再新增）。 */
+
+    /** 某个词的时间分布数据。 */
+    data class WordTimeStat(
+        /** 本周期内出现次数。 */
+        val count: Long,
+        /** 最近若干次出现的时间点（可能少于 count）。 */
+        val samples: List<Long>,
+    )
+
+    /** 取某个词在本周期的时间分布；没记录过返回 null。 */
+    fun wordTimeStat(
+        period: Period,
+        word: String,
+    ): WordTimeStat? = runCatching {
+        val b = bucketOf(statsOf(store.activeSchema), period, System.currentTimeMillis()) ?: return null
+        val c = b.wordFreq[word] ?: return null
+        WordTimeStat(c, b.wordTimes[word]?.toList().orEmpty())
+    }.getOrNull()
+
+    private fun recordWord(
+        bucket: Bucket,
+        text: String,
+    ) {
+        val word = text.trim()
+        if (word.length !in 2..6) return
+        if (!word.all { isHanzi(it) }) return
+        val old = bucket.wordFreq[word]
+        if (old == null && bucket.wordFreq.size >= WORD_CLOUD_LIMIT) return
+        bucket.wordFreq[word] = (old ?: 0L) + 1L
+        // 最近 N 次的时间点（滚动的，只留尾巴）
+        runCatching {
+            val list = bucket.wordTimes.getOrPut(word) { mutableListOf() }
+            list.add(System.currentTimeMillis())
+            val overflow = list.size - WORD_TIME_SAMPLES
+            if (overflow > 0) list.subList(0, overflow).clear()
+        }
+    }
+
+    /** 今天星期几（Calendar.DAY_OF_WEEK：1=周日 … 7=周六）。 */
+    private fun currentWeekday(): Int = java.util.Calendar.getInstance().get(java.util.Calendar.DAY_OF_WEEK)
+
+    private fun Bucket.deepCopy(): Bucket = copy(
+        wordLen = wordLen.toMutableMap(),
+        codeLen = codeLen.toMutableMap(),
+        keyHeat = keyHeat.toMutableMap(),
+        hours = hours.toMutableMap(),
+        weekdays = weekdays.toMutableMap(),
+        wordFreq = wordFreq.toMutableMap(),
+    )
+
+    /** 一次埋点要同步累加的全部桶：今日 / 本周 / 本月 / 今年 / 生涯。 */
+    private fun allBuckets(
+        stats: SchemaStats,
+        now: Long,
+    ): List<Bucket> = listOfNotNull(
+        bucketOf(stats, Period.TODAY, now),
+        bucketOf(stats, Period.WEEK, now),
+        bucketOf(stats, Period.MONTH, now),
+        bucketOf(stats, Period.YEAR, now),
+        stats.career,
+    )
+
+    /**
+     * 单个「极速」值的合理性校准。
+     *
+     * 200 字/分 ≈ 3.3 字/秒，双拼要 6~7 键/秒**持续 5 秒**才做得到 —— 超过这个数，
+     * 基本是旧口径把「语音整句上屏」「快打短语整段上屏」算进了 5 秒窗口。
+     */
+    private fun capFastest(v: Double): Double = if (v > 200.0) 0.0 else v
+
+    /** 旧数据文件迁移：补齐生涯桶、并轨历史布局字段。 */
+    private fun migrate(s: Store) {
+        if (s.version < 3) {
+            // v3：极速口径修正（旧版把语音 / 快打整段上屏也算进速度窗口）。
+            // 只清理明显不可能的值，其余历史峰值原样保留。
+            s.schemas.values.forEach { st ->
+                st.daily.fastest = capFastest(st.daily.fastest)
+                st.weekly.fastest = capFastest(st.weekly.fastest)
+                st.monthly.fastest = capFastest(st.monthly.fastest)
+                st.yearly.fastest = capFastest(st.yearly.fastest)
+                st.career.fastest = capFastest(st.career.fastest)
+            }
+            s.version = 3
+        }
+        if (s.layouts.isEmpty() && s.layout.isNotEmpty()) s.layouts.add(s.layout)
+        s.schemas.values.forEach { st ->
+            // 旧版本只记了 careerChars / careerCommits 两个标量，先垫进生涯桶，避免升级后生涯页归零
+            if (st.career.chars == 0L && st.career.commits == 0L) {
+                st.career.chars = st.careerChars
+                st.career.commits = st.careerCommits
+            }
+            // 旧版本生涯桶只有两个标量，击键 / 速度 / 分布 / 热力都无从恢复。
+            // 用「今年」桶兜底补齐：今年之前的数据本来就取不到，但至少不会升级后一片空白。
+            if (st.career.charKeys == 0L && st.career.otherKeys == 0L && st.yearly.chars > 0) {
+                st.career = st.yearly.deepCopy().apply { ts = 0L }
+            }
+            if (st.careerChars < st.career.chars) st.careerChars = st.career.chars
+            if (st.careerCommits < st.career.commits) st.careerCommits = st.career.commits
+        }
+    }
+
+    private fun windowSpeed(
+        nowMs: Long,
+        chars: Int,
+        rawLen: Int,
+    ): Double {
+        if (chars <= 0) return 0.0
+        // 一次上屏超过 20 个汉字：几乎不可能是「打字」出来的（粘贴整段 / 长词条 / 外部上屏），
+        // 计进去会让「极速」瞬间飙到几百字/分，比均速高一个数量级。
+        if (chars > 20) return 0.0
+        // rawLen = 上屏前的原始编码长度。语音输入、剪贴板、直接上屏都是 0 ——
+        // 它们和「手速」无关，却同样会把 5 秒窗口塞满，是「极速」虚高的主要来源。
+        if (rawLen <= 0) return 0.0
+        // 字数明显多于编码能产出的量（自定义短语快打、整句联想直接上屏）：
+        // 双拼两码换一个字已经是上限，超过 rawLen*2 的一律不算打字速度。
+        if (chars > rawLen * 2) return 0.0
+        speedWindow.addLast(nowMs to chars)
+        while (speedWindow.isNotEmpty() && nowMs - speedWindow.first().first > SPEED_WINDOW_MS) {
+            speedWindow.removeFirst()
+        }
+        val sum = speedWindow.sumOf { it.second }
+        // 跨度下限从 2 秒提到 5 秒：2 秒内打 6 个字会被算成 180 字/分，那只是手快按了几下，
+        // 不代表持续速度。样本不满 5 个字也不记录，避免开局第一下就冲上峰值。
+        if (sum < 5) return 0.0
+        val span = (nowMs - speedWindow.first().first).coerceIn(5000L, SPEED_WINDOW_MS)
+        return sum * 60000.0 / span
+    }
+
+    private fun isHanzi(c: Char): Boolean = c.code in 0x4E00..0x9FFF ||
+        c.code in 0x3400..0x4DBF ||
+        c.code in 0xF900..0xFAFF
+
+    private const val KEY_WORD_CLOUD = "dahi_word_cloud"
+
+    /** 每个统计周期最多保留多少个词（防止长期累积）。 */
+    private const val WORD_CLOUD_LIMIT = 300
+
+    /** 每个词保留多少个时间点（点击查看时间分布用）。 */
+    private const val WORD_TIME_SAMPLES = 60
+
+    private const val KEY_ENABLED = "dahi_stats_enabled"
+
+    /**
+     * 退格键。
+     *
+     * [onKey] 收到的是 **Android keycode**（[KEYCODE_DEL] = 67）—— 修正率的分子一直是对的。
+     * 0xFF08 只是兜底：个别主题把 keysym 直接写进 `click`，那种键不该被漏掉。
+     */
+    private const val KEYCODE_BACKSPACE = 0xFF08
+
+    /** Android 键码口径的退格。 */
+    private const val KEYCODE_DEL = 67
+}
