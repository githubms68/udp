diff --git a/app/src/main/jni/librime_jni/rime_jni.cc b/app/src/main/jni/librime_jni/rime_jni.cc
index 22436e2..ebe654c 100644
--- a/app/src/main/jni/librime_jni/rime_jni.cc
+++ b/app/src/main/jni/librime_jni/rime_jni.cc
@@ -48,8 +48,36 @@ class Rime {
     trime_traits.user_data_dir = userDir;
     trime_traits.log_dir = "";  // set empty log_dir to log to logcat only
     trime_traits.app_name = "rime.trime";
-    trime_traits.distribution_name = "Trime";
-    trime_traits.distribution_code_name = "trime";
+    // 大海版：前端自报名称。
+    // 万象的「输入统计」显示的是 rime_api.get_distribution_code_name()：
+    // 它先用一张精确匹配表（trime→同文输入法、Weasel→小狼毫…）取中文名，取不到就直接显示原始代号。
+    // 所以两个字段都写成「同文输入法大海版Plus V6」——
+    // 统计里就会显示「◉ 前端：同文输入法大海版Plus V6 3.3.12」。
+    //
+    // 安全性：万象判断「是否移动端」虽然也读这个字段，但它是
+    //   ① 精确匹配白名单（trime/hamster/…）② 再看用户目录路径是否含 /android/、/storage/emulated/ 等
+    //   ③ 再看 jit.os 是否 android
+    // 本 App 的用户目录固定是 /storage/emulated/0/Android/data/com.osfans.trime.dahi/files/rime，
+    // ②③ 必然命中，所以改掉代号不会让万象误判成桌面端。
+    //
+    // 代号不再硬编码：从 buildVersionName（形如 3.3.12-plus.v6）里现算，
+    // gradle 改了版本线，统计里的前端名会自动跟上，不会再三番五次出现「实际 V6、显示 V1」。
+    std::string frontendName = "同文输入法大海版Plus";
+    if (versionName != nullptr) {
+      const std::string ver(versionName);
+      auto pos = ver.rfind(".v");
+      if (pos == std::string::npos) pos = ver.rfind("-v");
+      if (pos != std::string::npos) {
+        std::string code;
+        for (auto i = pos + 2; i < ver.size(); ++i) {
+          if (ver[i] < '0' || ver[i] > '9') break;
+          code += ver[i];
+        }
+        if (!code.empty()) frontendName += " V" + code;
+      }
+    }
+    trime_traits.distribution_name = frontendName.c_str();
+    trime_traits.distribution_code_name = frontendName.c_str();
     trime_traits.distribution_version = versionName;
 
     rime->setup(&trime_traits);
diff --git a/app/src/main/res/drawable/dahi_mark.xml b/app/src/main/res/drawable/dahi_mark.xml
new file mode 100644
index 0000000..16cfbc2
--- /dev/null
+++ b/app/src/main/res/drawable/dahi_mark.xml
@@ -0,0 +1,48 @@
+<?xml version="1.0" encoding="utf-8"?>
+
+<!--
+  「同文·大海版 PLUS」的标记：ㄓ（双横起浪）+ 太极（右凹陷处）
+  ㄓ 的骨架取自上游 ic_app_icon_foreground.xml 的字形比例；
+  中横与底横同为波浪（幅度 ×1.25），左竖—中横—右竖是一条连续路径，接缝自然。
+  SPDX-License-Identifier: GPL-3.0-or-later
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="24"
+    android:viewportHeight="24">
+
+    <!-- 左竖 → 中横（波浪）→ 右竖：一条连续笔画，拐弯处用 round join，不会出现重叠的线头 -->
+    <path
+        android:pathData="M4.9,4.65 L4.9,11.95 C6.6,10.83 9.0,10.83 12.0,11.95 C15.0,13.07 17.4,13.07 19.1,11.95 L19.1,4.65"
+        android:strokeColor="#EEC57A"
+        android:strokeWidth="2.2"
+        android:strokeLineCap="round"
+        android:strokeLineJoin="round" />
+
+    <!-- 中竖：贯穿到底浪 -->
+    <path
+        android:pathData="M12.0,3.45 L12.0,19.05"
+        android:strokeColor="#EEC57A"
+        android:strokeWidth="2.2"
+        android:strokeLineCap="round" />
+
+    <!-- 底浪：与中横同相位，幅度略大 -->
+    <path
+        android:pathData="M2.8,19.05 C5.4,17.55 9.0,17.55 12.0,19.05 C15.0,20.55 18.6,20.55 21.2,19.05"
+        android:strokeColor="#EEC57A"
+        android:strokeWidth="2.2"
+        android:strokeLineCap="round" />
+
+    <!-- 太极：亮金 = 阳，古铜 = 阴，加一圈细环界定圆形。
+         这里**不画两个鱼眼**：标题里图标只有 23dp（约 69px），鱼眼直径算下来只有 1.7px，
+         画上去只会变成几块不对称的脏像素，反而降低清晰度。 -->
+    <path
+        android:pathData="M13.65,7.85 a1.75,1.75 0 1,0 3.5,0 a1.75,1.75 0 1,0 -3.5,0 Z"
+        android:fillColor="#EEC57A"
+        android:strokeColor="#EEC57A"
+        android:strokeWidth="0.28" />
+    <path
+        android:pathData="M15.4,6.1 a1.75,1.75 0 1,1 0,3.5 a0.875,0.875 0 1,1 0,-1.75 a0.875,0.875 0 1,0 0,-1.75 Z"
+        android:fillColor="#7A5E2C" />
+</vector>
diff --git a/app/src/main/res/drawable/dahi_splash_mark.xml b/app/src/main/res/drawable/dahi_splash_mark.xml
