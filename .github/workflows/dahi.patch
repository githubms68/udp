+    private fun renderDistribution(
+        box: LinearLayout,
+        data: Map<String, Long>,
+        unitRes: Int,
+        titleRes: Int,
+    ) {
+        val ctx = requireContext()
+        box.removeAllViews()
+        val total = data.values.sum()
+        if (total <= 0L) {
+            box.addView(
+                TextView(ctx).apply {
+                    setText(R.string.dahi_stats_empty)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                    setTextColor(dahiText2())
+                },
+            )
+            return
+        }
+        val ordered = data.entries.sortedByDescending { it.value }
+        val rankOf = ordered.mapIndexed { index, e -> e.key to index + 1 }.toMap()
+        data.entries
+            .sortedBy { it.key.toIntOrNull() ?: Int.MAX_VALUE }
+            .take(8)
+            .forEach { (key, count) ->
+                val ratio = count.toDouble() / total
+                val row =
+                    LinearLayout(ctx).apply {
+                        orientation = LinearLayout.HORIZONTAL
+                        gravity = Gravity.CENTER_VERTICAL
+                        setPadding(0, ctx.dp(1), 0, ctx.dp(1))
+                    }
+                row.addView(
+                    TextView(ctx).apply {
+                        text = "$key${ctx.getString(unitRes)}"
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                        layoutParams = LinearLayout.LayoutParams(ctx.dp(58), ViewGroup.LayoutParams.WRAP_CONTENT)
+                    },
+                )
+                val bar =
+                    View(ctx).apply {
+                        background =
+                            GradientDrawable().apply {
+                                cornerRadius = ctx.dp(3).toFloat()
+                                setColor(dahiAccent())
+                            }
+                        layoutParams =
+                            LinearLayout.LayoutParams(0, ctx.dp(7), ratio.toFloat().coerceAtLeast(0.01f))
+                    }
+                row.addView(bar)
+                row.addView(
+                    View(ctx).apply {
+                        layoutParams =
+                            LinearLayout.LayoutParams(0, ctx.dp(7), (1f - ratio.toFloat()).coerceAtLeast(0.01f))
+                    },
+                )
+                row.addView(
+                    TextView(ctx).apply {
+                        text = formatPct(ratio)
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                        setTextColor(dahiText2())
+                        gravity = Gravity.END
+                        layoutParams = LinearLayout.LayoutParams(ctx.dp(46), ViewGroup.LayoutParams.WRAP_CONTENT)
+                    },
+                )
+                // 点这一行 → 看具体次数 / 占比 / 排名（和时段分布的柱子一致）
+                row.setOnClickListener {
+                    runCatching {
+                        AlertDialog
+                            .Builder(ctx)
+                            .setTitle(getString(titleRes))
+                            .setMessage(
+                                getString(
+                                    R.string.dahi_stats_dist_summary,
+                                    "$key${ctx.getString(unitRes)}",
+                                    count,
+                                    formatPct(ratio),
+                                    rankOf[key] ?: 0,
+                                    ordered.size,
+                                ),
+                            ).setPositiveButton(android.R.string.ok, null)
+                            .show()
+                    }
+                }
+                box.addView(row)
+            }
+    }
