+# SPDX-FileCopyrightText: 2026 Rime community
+#
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# 一键在 GitHub Actions 上编译「同文输入法大海版」（自用版）。
+# 用法：把本仓库（含本文件）推到自己的 GitHub 仓库，
+#   然后 Actions -> "Build Dahi Trime APK" -> Run workflow。
+# 编译完成后在本次运行的 Artifacts 中下载 APK。
+# 原生依赖（librime/OpenCC/...）由 script/fetch-dahi-deps.sh 按 v3.3.12 锁定版本自动拉取，
+# 因此**无需**一并上传 git 子模块。
+#
+# 签名（重要）：
+#   - 若仓库配置了 Secrets（SIGNING_KEY / KEY_STORE_PASSWORD / KEY_PASSWORD / ALIAS），
+#     **优先使用你既有密钥签名** —— 这样新包与以前签发的安装包同签名，可**直接覆盖升级**。
+#   - 若未配置上述 Secrets，则退回「构建时生成的临时自签名密钥」，
+#     仅供本机自测；它每次构建都会变，**无法覆盖升级**已安装的旧版。
+
+name: Build Dahi Trime APK
+
+on:
+  workflow_dispatch:
+  push:
+    branches:
+      - develop
+      - main
+      - dahi
+
+env:
+  CI_NAME: Dahi Build
+
+jobs:
+  build:
+    runs-on: ubuntu-26.04
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          submodules: false
+          fetch-depth: 0
+
+      - name: 拉取原生依赖（按 v3.3.12 锁定版本）
+        run: bash script/fetch-dahi-deps.sh
+
+      - name: Setup Java
+        uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: 25
+          cache: gradle
+
+      - name: Setup Android SDK
+        uses: android-actions/setup-android@v4
+
+      - name: Install CMake
+        run: |
+          sdkmanager --install "cmake;3.31.6"
+
+      - name: 准备签名密钥
+        env:
+          SIGNING_KEY: ${{ secrets.SIGNING_KEY }}
+          KEY_STORE_PASSWORD: ${{ secrets.KEY_STORE_PASSWORD }}
+          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
+          KEY_ALIAS: ${{ secrets.ALIAS }}
+        run: |
+          if [ -n "${SIGNING_KEY:-}" ]; then
+            echo ">> 检测到 SIGNING_KEY：使用你既有的正式密钥签名（与旧安装包同签名，可覆盖升级）。"
+            printf '%s' "$SIGNING_KEY" | base64 -d > dahi.keystore
+            # 自检：密码不对会在这里立刻报错，而不是等到 30 分钟后 packageRelease 才失败
+            echo "== 校验密钥（能列出条目即密码/别名正确）=="
+            keytool -list -keystore dahi.keystore -storepass "$KEY_STORE_PASSWORD"
+            {
+              echo "storePassword=$KEY_STORE_PASSWORD"
+              echo "keyPassword=${KEY_PASSWORD:-$KEY_STORE_PASSWORD}"
+              echo "keyAlias=$KEY_ALIAS"
+              echo "storeFile=$PWD/dahi.keystore"
+            } > keystore.properties
+          else
+            echo ">> 未配置 SIGNING_KEY：退回一次性自签名密钥（仅供自测，无法覆盖升级已装旧版）。"
+            keytool -genkeypair -v -keystore dahi.keystore -alias dahi \
+              -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12 \
+              -storepass dahipass -keypass dahipass \
+              -dname "CN=Dahi Trime, OU=Dahi, O=Dahi, L=City, ST=State, C=CN"
+            {
+              echo "storePassword=dahipass"
+              echo "keyPassword=dahipass"
+              echo "keyAlias=dahi"
+              echo "storeFile=$PWD/dahi.keystore"
+            } > keystore.properties
+          fi
+          echo "== keystore.properties（已脱敏）=="
+          sed -e 's/^storePassword=.*/storePassword=***/' -e 's/^keyPassword=.*/keyPassword=***/' keystore.properties
+
+      - name: Build release APKs
+        run: make release
+
+      - name: Upload APKs
+        uses: actions/upload-artifact@v4
+        with:
+          name: dahi-trime-apk
+          path: app/build/outputs/apk/release/*.apk
+          if-no-files-found: error
