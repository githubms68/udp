+
+    private fun addSwitch(
+        titleRes: Int,
+        summaryRes: Int?,
+        getter: () -> Boolean,
+        onChange: (Boolean) -> Unit,
+    ) {
+        val ctx = requireContext()
+        val row =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(0, ctx.dp(10), 0, ctx.dp(10))
+            }
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                addView(
+                    TextView(ctx).apply {
+                        text = ctx.getString(titleRes)
+                        textSize = 16f
+                        setTextColor(titleColor())
+                    },
+                )
+            }
+        if (summaryRes != null) {
+            column.addView(
+                TextView(ctx).apply {
+                    text = ctx.getString(summaryRes)
+                    textSize = 12f
+                    setTextColor(summaryColor())
+                },
+            )
+        }
+        row.addView(column, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        row.addView(
+            Switch(ctx).apply {
+                isChecked = getter()
+                setOnCheckedChangeListener { _, checked -> onChange(checked) }
+            },
+        )
+        content.addView(row)
+    }
+
+    private fun addChoice(
+        titleRes: Int,
+        summaryRes: Int?,
+        options: List<Int>,
+        current: Int,
+        onPick: (Int) -> Unit,
+    ) {
+        val ctx = requireContext()
+        addChoices(titleRes, summaryRes, options.map { ctx.getString(it) }, null, current, onPick)
+    }
+
+    /** 带一句话说明的单选（弹窗里每项两行：名称 + 等长描述）。 */
+    private fun addChoiceWithDesc(
+        titleRes: Int,
+        summaryRes: Int?,
+        options: List<Int>,
+        descriptions: List<Int>,
+        current: Int,
+        onPick: (Int) -> Unit,
+    ) {
+        val ctx = requireContext()
+        addChoices(
+            titleRes,
+            summaryRes,
+            options.map { ctx.getString(it) },
+            descriptions.map { ctx.getString(it) },
+            current,
+            onPick,
+        )
+    }
+
+    private fun addChoices(
+        titleRes: Int,
+        summaryRes: Int?,
+        labels: List<String>,
+        descriptions: List<String>?,
+        current: Int,
+        onPick: (Int) -> Unit,
+    ) {
+        val ctx = requireContext()
+        val row =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(0, ctx.dp(10), 0, ctx.dp(10))
+                isClickable = true
+            }
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                addView(
+                    TextView(ctx).apply {
+                        text = ctx.getString(titleRes)
+                        textSize = 16f
+                        setTextColor(titleColor())
+                    },
+                )
+            }
+        if (summaryRes != null) {
+            column.addView(
+                TextView(ctx).apply {
+                    text = ctx.getString(summaryRes)
+                    textSize = 12f
+                    setTextColor(summaryColor())
+                },
+            )
+        }
+        row.addView(column, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        row.addView(
+            TextView(ctx).apply {
+                text = "${labels.getOrNull(current).orEmpty()} ›"
+                textSize = 14f
+                setTextColor(summaryColor())
+            },
+        )
+        row.setOnClickListener {
+            val builder = AlertDialog.Builder(ctx).setTitle(titleRes)
+            if (descriptions == null) {
+                builder
+                    .setSingleChoiceItems(labels.toTypedArray(), current) { dialog, which ->
+                        dialog.dismiss()
+                        onPick(which)
+                    }.setNegativeButton(android.R.string.cancel, null)
+                    .show()
+                return@setOnClickListener
+            }
+            // 有描述：两行（名称 + 说明），名称跟随主题标题色、说明用主题次要色；
+            // 当前项加 ✓ 并用强调色，避免丢了原单选按钮的「选中」线索
+            val titleTint = titleColor()
+            val summaryTint = summaryColor()
+            val accent = accentColor()
+            val adapter =
+                object : BaseAdapter() {
+                    override fun getCount(): Int = labels.size
+
+                    override fun getItem(position: Int): Any = labels[position]
+
+                    override fun getItemId(position: Int): Long = position.toLong()
+
+                    override fun getView(
+                        position: Int,
+                        convertView: View?,
+                        parent: ViewGroup?,
+                    ): View {
+                        val checked = position == current
+                        val cell =
+                            LinearLayout(ctx).apply {
+                                orientation = LinearLayout.VERTICAL
+                                setPadding(ctx.dp(24), ctx.dp(10), ctx.dp(24), ctx.dp(10))
+                            }
+                        cell.addView(
+                            TextView(ctx).apply {
+                                text = if (checked) "✓  ${labels[position]}" else labels[position]
+                                textSize = 16f
+                                setTextColor(if (checked) accent else titleTint)
+                            },
+                        )
+                        cell.addView(
+                            TextView(ctx).apply {
+                                text = descriptions.getOrNull(position).orEmpty()
+                                textSize = 12.5f
+                                setTextColor(summaryTint)
+                                setPadding(0, ctx.dp(2), 0, 0)
+                            },
+                        )
+                        return cell
+                    }
+                }
+            builder
+                .setAdapter(adapter) { dialog, which ->
+                    dialog.dismiss()
+                    onPick(which)
+                }.setNegativeButton(android.R.string.cancel, null)
+                .show()
+        }
+        content.addView(row)
+    }
