+    ) = GradientDrawable().apply {
+        cornerRadius = radiusDp * resources.displayMetrics.density
+        setColor(color)
+    }
+
+    private fun fmtSeconds(ms: Long): String = String.format(Locale.US, "%.1f s", ms / 1000.0)
+
+    private fun metaOf(bean: AsrHistoryBean): String {
+        val sourceLabel =
+            when (bean.source) {
+                AsrHistoryBean.SOURCE_BUILTIN -> getString(R.string.dahi_ah_src_builtin)
+                AsrHistoryBean.SOURCE_EXTERNAL -> getString(R.string.dahi_ah_src_external)
+                else -> getString(R.string.dahi_ah_src_system)
+            }
+        val totalMs = bean.durRecordMs + bean.durAsrMs + bean.durPostMs + bean.durCommitMs
+        return "${bean.engine} · $sourceLabel · ${getString(R.string.dahi_ah_chars, bean.chars)} · ${fmtSeconds(totalMs)}"
+    }
