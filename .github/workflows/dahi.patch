+/** 声情意象设置页的列表：第 0 项为顶部参数区，其后为 11 个可拖动排序的动效选项。 */
+class VoiceImageryAdapter(
+    private val onReset: () -> Unit,
+) : RecyclerView.Adapter<RecyclerView.ViewHolder>() {
+    companion object {
+        const val TYPE_HEADER = 0
+        const val TYPE_OPTION = 1
+    }
+
+    private val items: MutableList<VoiceImageryStyle> = VoiceImagery.order().toMutableList()
+
+    override fun getItemCount(): Int = items.size + 1
+
+    override fun getItemViewType(position: Int): Int = if (position == 0) TYPE_HEADER else TYPE_OPTION
+
+    override fun onCreateViewHolder(
+        parent: ViewGroup,
+        viewType: Int,
+    ): RecyclerView.ViewHolder {
+        val inflater = LayoutInflater.from(parent.context)
+        return if (viewType == TYPE_HEADER) {
+            HeaderHolder(inflater.inflate(R.layout.item_dahi_vi_header, parent, false))
+        } else {
+            OptionHolder(inflater.inflate(R.layout.item_dahi_vi_option, parent, false))
+        }
+    }
+
+    override fun onBindViewHolder(
+        holder: RecyclerView.ViewHolder,
+        position: Int,
+    ) {
+        when (holder) {
+            is HeaderHolder -> holder.bind()
+            is OptionHolder -> holder.bind(items[position - 1], position)
+        }
+    }
+
+    /** 拖动后有待重绑的标记（见 [rebindOptionsIfNeeded]）。 */
+    private var pendingRebind = false
+
+    fun moveItem(
+        from: Int,
+        to: Int,
+    ): Boolean {
+        if (from == to) return false
+        if (from !in items.indices || to !in items.indices) return false
+        items.add(to, items.removeAt(from))
+        // 注意：notify* 用的是 **adapter position**（第 0 项是顶部参数区），
+        // 而 from/to 是 items 下标，因此必须 +1。
+        // 曾经漏了 +1：通知错位到 header 行，选项行不重绑，
+        // 表现为「位置交换成功、但两行显示同一個名字」，退出重进才恢复正常。
+        notifyItemMoved(from + 1, to + 1)
+        // 不在拖动中紧跟着发 notifyItemRangeChanged：moved 与 changed 连发是
+        // RecyclerView「Inconsistency detected」崩溃的已知配方；统一放到收尾后重绑。
+        pendingRebind = true
+        return true
+    }
+
+    /** 拖拽收尾后调用：统一重绑整个选项区（第 1 项起），刷新序号 / 文案 / 勾选。 */
+    fun rebindOptionsIfNeeded() {
+        if (!pendingRebind) return
+        pendingRebind = false
+        if (items.isNotEmpty()) notifyItemRangeChanged(1, items.size)
+    }
+
+    fun persistOrder() {
+        VoiceImagery.setOrder(items)
+    }
+
+    /** 恢复初始设置后重新载入并刷新。 */
+    fun reload() {
+        items.clear()
+        items.addAll(VoiceImagery.order())
+        notifyDataSetChanged()
+    }
+
+    inner class HeaderHolder(
+        root: View,
+    ) : RecyclerView.ViewHolder(root) {
+        private val resetRow: View = root.findViewById(R.id.dahi_vi_reset_row)
+        private val micSensitivity: SeekBar = root.findViewById(R.id.dahi_vi_header_mic_sensitivity)
+        private val micSensitivityValue: TextView = root.findViewById(R.id.dahi_vi_header_mic_sensitivity_value)
+        private val maxAmplitude: SeekBar = root.findViewById(R.id.dahi_vi_header_max_amp)
+        private val maxAmplitudeValue: TextView = root.findViewById(R.id.dahi_vi_header_max_amp_value)
+        private val speed: SeekBar = root.findViewById(R.id.dahi_vi_header_speed)
+        private val speedValue: TextView = root.findViewById(R.id.dahi_vi_header_speed_value)
+        private val colorStrength: SeekBar = root.findViewById(R.id.dahi_vi_header_color)
+        private val colorStrengthValue: TextView = root.findViewById(R.id.dahi_vi_header_color_value)
+        private val effectColorSwatch: View = root.findViewById(R.id.dahi_vi_header_color_swatch)
+        private val effectColorHex: TextView = root.findViewById(R.id.dahi_vi_header_color_hex)
+        private val effectColorFollow: Button = root.findViewById(R.id.dahi_vi_header_color_follow)
+        private val sensitivity: SeekBar = root.findViewById(R.id.dahi_vi_header_sensitivity)
+        private val sensitivityValue: TextView = root.findViewById(R.id.dahi_vi_header_sensitivity_value)
+        private val toolbarSwitch: SwitchCompat = root.findViewById(R.id.dahi_vi_header_toolbar_switch)
+
+        fun bind() {
+            resetRow.setOnClickListener { onReset() }
+
+            micSensitivity.max = VoiceImagery.MAX_MIC_SENSITIVITY - VoiceImagery.MIN_MIC_SENSITIVITY
+            micSensitivity.progress = VoiceImagery.micSensitivity() - VoiceImagery.MIN_MIC_SENSITIVITY
+            micSensitivityValue.text = "${VoiceImagery.micSensitivity()}%"
+            micSensitivity.setOnSeekBarChangeListener(
+                object : SeekBar.OnSeekBarChangeListener {
+                    override fun onProgressChanged(
+                        seekBar: SeekBar,
+                        progress: Int,
+                        fromUser: Boolean,
+                    ) {
+                        val value = VoiceImagery.MIN_MIC_SENSITIVITY + progress
+                        micSensitivityValue.text = "$value%"
+                        VoiceImagery.setMicSensitivity(value)
+                    }
+
+                    override fun onStartTrackingTouch(seekBar: SeekBar) = Unit
+
+                    override fun onStopTrackingTouch(seekBar: SeekBar) = Unit
+                },
+            )
+
+            maxAmplitude.max = 100 - VoiceImagery.MIN_MAX_AMPLITUDE
+            maxAmplitude.progress = VoiceImagery.maxAmplitude() - VoiceImagery.MIN_MAX_AMPLITUDE
+            maxAmplitudeValue.text = "${VoiceImagery.maxAmplitude()}%"
+            maxAmplitude.setOnSeekBarChangeListener(
+                object : SeekBar.OnSeekBarChangeListener {
+                    override fun onProgressChanged(
+                        seekBar: SeekBar,
+                        progress: Int,
+                        fromUser: Boolean,
+                    ) {
+                        val value = VoiceImagery.MIN_MAX_AMPLITUDE + progress
+                        maxAmplitudeValue.text = "$value%"
+                        VoiceImagery.setMaxAmplitude(value)
+                    }
+
+                    override fun onStartTrackingTouch(seekBar: SeekBar) = Unit
+
+                    override fun onStopTrackingTouch(seekBar: SeekBar) = Unit
+                },
+            )
+
+            speed.max = VoiceImagery.MAX_SPEED - VoiceImagery.MIN_SPEED
+            speed.progress = VoiceImagery.speed() - VoiceImagery.MIN_SPEED
+            speedValue.text = "${VoiceImagery.speed()}%"
+            speed.setOnSeekBarChangeListener(
+                object : SeekBar.OnSeekBarChangeListener {
+                    override fun onProgressChanged(
+                        seekBar: SeekBar,
+                        progress: Int,
+                        fromUser: Boolean,
+                    ) {
+                        val value = VoiceImagery.MIN_SPEED + progress
+                        speedValue.text = "$value%"
+                        VoiceImagery.setSpeed(value)
+                    }
+
+                    override fun onStartTrackingTouch(seekBar: SeekBar) = Unit
+
+                    override fun onStopTrackingTouch(seekBar: SeekBar) = Unit
+                },
+            )
+
+            // 「动效颜色」：未设置时跟随键盘颜色，点按色块打开取色器固定颜色
+            bindEffectColor()
+
+            colorStrength.max = VoiceImagery.MAX_COLOR_STRENGTH - VoiceImagery.MIN_COLOR_STRENGTH
+            colorStrength.progress = VoiceImagery.colorStrength() - VoiceImagery.MIN_COLOR_STRENGTH
+            colorStrengthValue.text = "${VoiceImagery.colorStrength()}%"
+            colorStrength.setOnSeekBarChangeListener(
+                object : SeekBar.OnSeekBarChangeListener {
+                    override fun onProgressChanged(
+                        seekBar: SeekBar,
+                        progress: Int,
+                        fromUser: Boolean,
+                    ) {
+                        val value = VoiceImagery.MIN_COLOR_STRENGTH + progress
+                        colorStrengthValue.text = "$value%"
+                        VoiceImagery.setColorStrength(value)
+                    }
+
+                    override fun onStartTrackingTouch(seekBar: SeekBar) = Unit
+
+                    override fun onStopTrackingTouch(seekBar: SeekBar) = Unit
+                },
+            )
+
+            sensitivity.max = 100
+            sensitivity.progress = VoiceImagery.sensitivity()
+            sensitivityValue.text = "${VoiceImagery.sensitivity()}%"
+            sensitivity.setOnSeekBarChangeListener(
+                object : SeekBar.OnSeekBarChangeListener {
+                    override fun onProgressChanged(
+                        seekBar: SeekBar,
+                        progress: Int,
+                        fromUser: Boolean,
+                    ) {
+                        sensitivityValue.text = "$progress%"
+                        VoiceImagery.setSensitivity(progress)
+                    }
+
+                    override fun onStartTrackingTouch(seekBar: SeekBar) = Unit
+
+                    override fun onStopTrackingTouch(seekBar: SeekBar) = Unit
+                },
+            )
+
+            toolbarSwitch.isChecked = VoiceImagery.toolbarButtonEnabled()
+            toolbarSwitch.setOnCheckedChangeListener { _, checked ->
+                VoiceImagery.setToolbarButtonEnabled(checked)
+            }
+        }
+
+        /**
+         * 「动效颜色」行：色块点按打开取色器；未设置时显示「跟随键盘」，
+         * 点「跟随键盘」按钮清除已固定的颜色。改动即时生效（语音浮层重建即读取）。
+         */
+        private fun bindEffectColor() {
+            val ctx = itemView.context
+            refreshEffectColorUi()
+            effectColorSwatch.setOnClickListener {
+                val fallback =
+                    runCatching { ColorManager.getColor("candidate_text_color") }
+                        .getOrDefault(android.graphics.Color.WHITE)
+                DahiColorPickerDialog(
+                    ctx,
+                    VoiceImagery.effectColor() ?: fallback,
+                    onPicked = {
+                        VoiceImagery.setEffectColor(it)
+                        refreshEffectColorUi()
+                    },
+                    onCleared = {
+                        // 取色器里的「恢复主题色」= 恢复跟随键盘，与下方按钮等效
+                        VoiceImagery.clearEffectColor()
+                        refreshEffectColorUi()
+                    },
+                ).show()
+            }
+            effectColorFollow.setOnClickListener {
+                VoiceImagery.clearEffectColor()
+                refreshEffectColorUi()
+            }
+        }
+
+        private fun refreshEffectColorUi() {
+            val argb = VoiceImagery.effectColor()
+            // 描边跟随主题（浅色=深灰/深色=浅灰）：原来硬编码 0x44FFFFFF，
+            // 白色主题下色块与背景融为一体，取色入口直接「消失」。
+            effectColorSwatch.background =
+                DahiColorSwatch.draw(itemView.context, argb ?: android.graphics.Color.TRANSPARENT)
+            effectColorHex.text =
+                if (argb != null) {
+                    String.format("#%08X", argb)
+                } else {
+                    itemView.context.getString(R.string.dahi_vi_effect_color_follow)
+                }
+            effectColorFollow.visibility = if (argb != null) View.VISIBLE else View.INVISIBLE
+        }
+    }
+
+    inner class OptionHolder(
+        root: View,
+    ) : RecyclerView.ViewHolder(root) {
+        private val index: TextView = root.findViewById(R.id.dahi_vi_option_index)
+        private val name: TextView = root.findViewById(R.id.dahi_vi_option_name)
+        private val note: TextView = root.findViewById(R.id.dahi_vi_option_note)
+        private val check: TextView = root.findViewById(R.id.dahi_vi_option_check)
+
+        fun bind(
+            style: VoiceImageryStyle,
+            position: Int,
+        ) {
+            val ctx = itemView.context
+            // 序号列按"行位置"编号：永远是 1–11 顺序排列，移动的只是右侧动效条
+            index.text = position.toString()
+            name.text = ctx.getString(style.nameRes)
+            note.text = ctx.getString(style.noteRes)
+            val selected = VoiceImagery.current() == style
+            check.text = if (selected) "✓" else ""
+            check.setTextColor(ctx.styledColor(android.R.attr.colorAccent))
+            itemView.setOnClickListener {
+                VoiceImagery.setCurrent(style)
+                notifyItemRangeChanged(1, items.size)
+            }
+        }
+    }
