+++ b/app/src/main/java/com/osfans/trime/ui/main/settings/DahiPrivacyImage.kt
@@ -0,0 +1,239 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Shader
+import com.osfans.trime.R
+
+/**
+ * 「隐私体检」分享图。
+ *
+ * 与统计长图不同，这张图不画图表，只画四行数字和一句话 —— 目的是让人一眼看懂
+ * 「这个输入法没有网络权限，数据都在这台机器上」，所以信息越少越好。
+ *
+ * 配色沿用统计图那四套模板（同一份 key，用户在统计页选了什么这里就是什么）。
+ */
+object DahiPrivacyImage {
+    private const val WIDTH = 1080
+    private const val PAD = 64f
+
+    /** 画这张图需要的全部数字（页面里已经算好，绘制阶段不再访问存储）。 */
+    data class Data(
+        val netPermCount: Int,
+        val permCount: Int,
+        val totalBytes: Long,
+        val clipCount: Int,
+        val collCount: Int,
+        val statsDays: Int,
+    )
+
+    private class Palette(
+        val bgTop: Int,
+        val bgBottom: Int,
+        val cardBg: Int,
+        val textMain: Int,
+        val textSub: Int,
+        val textDim: Int,
+        val accent: Int,
+    )
+
+    private fun paletteOf(id: String): Palette =
+        when (id) {
+            "ink" ->
+                Palette(
+                    Color.parseColor("#F7F7F4"), Color.parseColor("#ECEDE8"), Color.parseColor("#FFFFFF"),
+                    Color.parseColor("#1A1D22"), Color.parseColor("#565E6B"), Color.parseColor("#8A919D"),
+                    Color.parseColor("#2F6BFF"),
+                )
+
+            "neon" ->
+                Palette(
+                    Color.parseColor("#07070C"), Color.parseColor("#120C1F"), Color.parseColor("#151021"),
+                    Color.parseColor("#FFFFFF"), Color.parseColor("#BBA9E6"), Color.parseColor("#7C6B9E"),
+                    Color.parseColor("#22D3EE"),
+                )
+
+            "sand" ->
+                Palette(
+                    Color.parseColor("#14110C"), Color.parseColor("#1E1911"), Color.parseColor("#221D15"),
+                    Color.parseColor("#FBF6EC"), Color.parseColor("#CDBFA8"), Color.parseColor("#94896F"),
+                    Color.parseColor("#E0A458"),
+                )
+
+            else ->
+                Palette(
+                    Color.parseColor("#0E1118"), Color.parseColor("#171E2B"), Color.parseColor("#1B2230"),
+                    Color.parseColor("#FFFFFF"), Color.parseColor("#98A4BC"), Color.parseColor("#6B7688"),
+                    Color.parseColor("#5B8CFF"),
+                )
+        }
+
+    /** 生成分享图。[templateId] 与统计图共用，见 DahiStatsImage.Template。 */
+    @Synchronized
+    fun render(
+        ctx: Context,
+        data: Data,
+        templateId: String,
+    ): Bitmap {
+        val p = paletteOf(templateId)
+        // 先画到 1×1 上测高度（语言不同行数会变），再按真实高度重画
+        val height = draw(ctx, Canvas(Bitmap.createBitmap(1, 1, Bitmap.Config.ARGB_8888)), data, p, 0f)
+            .toInt()
+            .coerceIn(600, 4000)
+        val bitmap = Bitmap.createBitmap(WIDTH, height, Bitmap.Config.ARGB_8888)
+        draw(ctx, Canvas(bitmap), data, p, height.toFloat())
+        return bitmap
+    }
+
+    private fun tp(
+        size: Float,
+        color: Int,
+        bold: Boolean = false,
+    ): Paint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            textSize = size
+            this.color = color
+            isFakeBoldText = bold
+        }
+
+    private fun fmtSize(bytes: Long): String =
+        when {
+            bytes >= 1024L * 1024 -> String.format(java.util.Locale.US, "%.1f MB", bytes / 1024f / 1024f)
+            bytes >= 1024L -> String.format(java.util.Locale.US, "%.0f KB", bytes / 1024f)
+            else -> "$bytes B"
+        }
+
+    /** 按像素宽度折行（中英混排逐字判断，够用且不依赖系统换行 API）。 */
+    private fun wrapLines(
+        text: String,
+        paint: Paint,
+        maxWidth: Float,
+    ): List<String> {
+        val out = ArrayList<String>()
+        var line = StringBuilder()
+        text.replace("\r", "").split('\n').forEachIndexed { index, para ->
+            if (index > 0) {
+                out.add(line.toString())
+                line = StringBuilder()
+            }
+            para.forEach { ch ->
+                line.append(ch)
+                if (paint.measureText(line.toString()) > maxWidth) {
+                    line.deleteCharAt(line.length - 1)
+                    if (line.isNotEmpty()) out.add(line.toString())
+                    line = StringBuilder().append(ch)
+                }
+            }
+        }
+        if (line.isNotEmpty()) out.add(line.toString())
+        return out
+    }
+
+    /** 画一遍，返回内容底部 y（画布高度为 0 时等价于测量）。 */
+    private fun draw(
+        ctx: Context,
+        canvas: Canvas,
+        d: Data,
+        p: Palette,
+        canvasH: Float,
+    ): Float {
+        if (canvasH > 2f) {
+            val shader = LinearGradient(0f, 0f, 0f, canvasH, p.bgTop, p.bgBottom, Shader.TileMode.CLAMP)
+            canvas.drawRect(0f, 0f, WIDTH.toFloat(), canvasH, Paint().apply { this.shader = shader })
+        }
+        var y = PAD + 42f
+        canvas.drawText(ctx.getString(R.string.dahi_privacy_img_brand), PAD, y, tp(30f, p.textSub))
+        // 右上角的品牌标记：原来这里跟在「大海版」后面的 PLUS 字样，换成图形更干净
+        DahiMark.load(ctx)?.let { mark ->
+            val size = 44f
+            canvas.drawBitmap(
+                mark,
+                null,
+                RectF(WIDTH - PAD - size, PAD + 2f, WIDTH - PAD, PAD + 2f + size),
+                Paint(Paint.ANTI_ALIAS_FLAG),
+            )
+        }
+
+        y += 86f
+        canvas.drawText(ctx.getString(R.string.dahi_privacy_claim_title), PAD, y, tp(62f, p.textMain, true))
+        y += 44f
+        // 正文按画布宽度自动折行：原来是一整行画过去，右边直接被裁掉
+        val bodyPaint = tp(28f, p.textDim)
+        wrapLines(ctx.getString(R.string.dahi_privacy_claim_body), bodyPaint, WIDTH - PAD * 2).forEach { line ->
+            canvas.drawText(line, PAD, y, bodyPaint)
+            y += 38f
+        }
+
+        // 四行数字卡
+        y += 16f
+        val cardH = 300f
+        val card =
+            RectF(PAD, y, WIDTH - PAD, y + cardH)
+        canvas.drawRoundRect(card, 28f, 28f, Paint(Paint.ANTI_ALIAS_FLAG).apply { color = p.cardBg })
+        val rows =
+            listOf(
+                ctx.getString(R.string.dahi_privacy_img_net) to
+                    if (d.netPermCount == 0) {
+                        ctx.getString(R.string.dahi_privacy_img_net_zero)
+                    } else {
+                        ctx.getString(R.string.dahi_privacy_img_net_some, d.netPermCount)
+                    },
+                ctx.getString(R.string.dahi_privacy_img_total_perm) to "${d.permCount}",
+                ctx.getString(R.string.dahi_privacy_img_data) to fmtSize(d.totalBytes),
+                ctx.getString(R.string.dahi_privacy_img_where) to ctx.getString(R.string.dahi_privacy_img_local),
+            )
+        var ry = y + 62f
+        rows.forEach { (label, value) ->
+            canvas.drawText(label, PAD + 36f, ry, tp(30f, p.textSub))
+            val valuePaint = tp(34f, p.accent, true)
+            val vw = valuePaint.measureText(value)
+            canvas.drawText(value, WIDTH - PAD - 36f - vw, ry, valuePaint)
+            ry += 72f
+        }
+
+        // 结论句
+        y += cardH + 56f
+        canvas.drawText(ctx.getString(R.string.dahi_privacy_img_claim2), PAD, y, tp(32f, p.textMain, true))
+        y += 40f
+
+        // 数据与备份的细项
+        y += 38f
+        canvas.drawText(
+            ctx.getString(R.string.dahi_privacy_img_counts, d.clipCount, d.collCount, d.statsDays),
+            PAD,
+            y,
+            tp(26f, p.textDim),
+        )
+        y += 40f
+        canvas.drawText(ctx.getString(R.string.dahi_privacy_img_backup), PAD, y, tp(26f, p.textDim))
+
+        // 底部署名
+        y += 76f
+        canvas.drawText(ctx.getString(R.string.dahi_stats_share_footer), PAD, y, tp(26f, p.textMain, true))
+
+        // 底部署名右侧的品牌标记
+        DahiMark.load(ctx)?.let { mark ->
+            val size = 52f
+            val footerW = tp(26f, p.textMain, true).measureText(ctx.getString(R.string.dahi_stats_share_footer))
+            val left = minOf(PAD + footerW + 12f, WIDTH - PAD - size)
+            canvas.drawBitmap(
+                mark,
+                null,
+                android.graphics.RectF(left, y - size + 8f, left + size, y + 8f),
+                Paint(Paint.ANTI_ALIAS_FLAG).apply { alpha = 220 },
+            )
+        }
+        return y + PAD
+    }
+}
