+     */
+    private fun moveSizeItem(
+        field: String,
+        mode: Int,
+    ) {
+        val sections = DahiStyleOverlay.sizeSections()
+        val order = sections.flatMap { it.third }.map { it.field }
+        if (field !in order) return
+        val sectionIdx = sections.indexOfFirst { section -> section.third.any { it.field == field } }
+        if (sectionIdx < 0) return
+        val members = sections[sectionIdx].third.map { it.field }
+        val pos = members.indexOf(field)
+        if (pos < 0) return
+        val target =
+            when (mode) {
+                MODE_UP -> if (pos > 0) pos - 1 else -1
+                MODE_DOWN -> if (pos < members.lastIndex) pos + 1 else -1
