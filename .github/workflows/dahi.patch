+    /** 方案对比的行渲染（每次 render 重建）。 */
+    private fun renderSchemas(box: LinearLayout) {
+        val ctx = requireContext()
+        box.removeAllViews()
+        val list = DahiInputStats.schemaSummary()
+        if (list.isEmpty()) {
+            box.addView(
+                TextView(ctx).apply {
+                    setText(R.string.dahi_stats_empty)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                    setTextColor(dahiText2())
+                },
+            )
+            return
+        }
+        val max = list.maxOf { it.chars }.coerceAtLeast(1L)
+        list.take(6).forEach { row ->
+            box.addView(
+                TextView(ctx).apply {
+                    text = row.name
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                    setPadding(0, ctx.dp(4), 0, 0)
+                },
+            )
+            val bar =
+                LinearLayout(ctx).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    gravity = Gravity.CENTER_VERTICAL
+                }
+            val ratio = (row.chars.toDouble() / max).toFloat().coerceIn(0.02f, 1f)
+            bar.addView(
+                View(ctx).apply {
+                    background =
+                        GradientDrawable().apply {
+                            cornerRadius = ctx.dp(3).toFloat()
+                            setColor(dahiAccent())
+                        }
+                    layoutParams = LinearLayout.LayoutParams(0, ctx.dp(8), ratio)
+                },
+            )
+            bar.addView(
+                View(ctx).apply {
+                    layoutParams = LinearLayout.LayoutParams(0, ctx.dp(8), (1f - ratio).coerceAtLeast(0.02f))
+                },
+            )
+            box.addView(bar)
+            box.addView(
+                TextView(ctx).apply {
+                    text =
+                        "${ctx.getString(R.string.dahi_stats_chars)} ${row.chars}  ·  " +
+                        "${ctx.getString(R.string.dahi_stats_speed)} ${format(row.avgSpeed)}  ·  " +
+                        "${ctx.getString(R.string.dahi_stats_firstpick)} ${formatPct(row.firstPick)}"
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 11.5f)
+                    setTextColor(dahiText2())
+                },
+            )
+        }
+    }
