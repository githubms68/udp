+    /** 自定义主色：色块 + 色值，点开复用项目自带的取色器。 */
+    private fun addColorRow() {
+        val ctx = requireContext()
+        val current = DahiKeyEffectsConfig.customColor.takeIf { it != 0 } ?: FALLBACK_COLOR
+        val row =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(0, ctx.dp(8), 0, ctx.dp(10))
+                isClickable = true
+            }
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                addView(
+                    TextView(ctx).apply {
+                        text = ctx.getString(R.string.dahi_ke_custom_color)
+                        textSize = 16f
+                        setTextColor(titleColor())
+                    },
+                )
+                addView(
+                    TextView(ctx).apply {
+                        text = ctx.getString(R.string.dahi_ke_custom_color_summary)
+                        textSize = 12f
+                        setTextColor(summaryColor())
+                    },
+                )
+            }
+        row.addView(column, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        row.addView(
+            View(ctx).apply {
+                layoutParams =
+                    LinearLayout.LayoutParams(ctx.dp(22), ctx.dp(22)).apply {
+                        rightMargin = ctx.dp(8)
+                    }
+                background =
+                    GradientDrawable().apply {
+                        cornerRadius = ctx.dp(6).toFloat()
+                        setColor(current)
+                        setStroke(ctx.dp(1), 0x44808080)
+                    }
+            },
+        )
+        row.addView(
+            TextView(ctx).apply {
+                text = String.format(java.util.Locale.US, "#%06X", 0xFFFFFF and current)
+                textSize = 13f
+                setTextColor(summaryColor())
+            },
+        )
+        row.setOnClickListener {
+            DahiColorPickerDialog(
+                requireContext(),
+                current,
+                onPicked = { color ->
+                    // 动效的透明度由生命周期决定，这里只保存色相：强制不透明，
+                    // 免得用户在外观上选了 30% 透明、键盘上却看不出效果
+                    DahiKeyEffectsConfig.customColor = (color and 0x00FFFFFF) or 0xFF000000.toInt()
+                    build()
+                },
+                onCleared = {
+                    DahiKeyEffectsConfig.customColor = 0
+                    build()
+                },
+            ).show()
+        }
+        content.addView(row)
+    }
