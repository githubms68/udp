+    /** 词云：开关关着就只放一句说明，开着才排词。 */
+    private fun renderWordCloud(snap: DahiInputStats.Bucket) {
+        val view = wordCloudView ?: return
+        val tip = wordCloudTip ?: return
+        // 隐藏名单那一行和词云开关无关：关掉词云也照样能进去恢复
+        val hiddenCount = DahiWordHidden.load(requireContext()).size
+        wordHiddenView?.let { line ->
+            if (hiddenCount <= 0) {
+                line.visibility = View.GONE
+            } else {
+                line.visibility = View.VISIBLE
+                line.text = getString(R.string.dahi_stats_word_hidden_manage, hiddenCount)
+            }
+        }
+        if (!DahiInputStats.isWordCloudEnabled()) {
+            view.visibility = View.GONE
+            tip.text = getString(R.string.dahi_stats_wordcloud_off)
+            return
+        }
+        view.visibility = View.VISIBLE
+        // 被隐藏的词只在这里被剔除：桶里的统计数字一个都不动
+        val visible = DahiWordHidden.filter(requireContext(), snap.wordFreq)
+        val top =
+            visible.entries
+                .sortedByDescending { it.value }
+                .take(40)
+                .map { it.key to it.value }
+        view.submit(top)
+        tip.text =
+            if (top.isEmpty()) {
+                getString(R.string.dahi_stats_wordcloud_empty)
+            } else {
+                getString(R.string.dahi_stats_wordcloud_tip, visible.size)
+            }
+    }
