+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.db
+
+import android.content.Context
+import androidx.sqlite.db.SimpleSQLiteQuery
+import androidx.sqlite.db.SupportSQLiteQuery
+import com.osfans.trime.R
+
+/**
+ * 剪贴板 / 收藏夹列表的排序方式。
+ *
+ * 排序必须下沉到 SQL：列表是 Paging3，只有让数据库按同一顺序分页，
+ * 滚动加载下一页时顺序才不会乱（在 adapter 层重排只能对已加载的页生效）。
+ *
+ * 每一项都以 `pinned DESC` 开头 —— 置顶条目永远在最前，这是既有语义，
+ * 不因为换排序方式而失效。
+ */
+enum class ClipSort(
+    val id: String,
+    /** 直接拼在 ORDER BY 后面的子句。 */
+    val orderBy: String,
+) {
+    /** 时间：由近及远（默认，也是历史行为）。 */
+    TIME_DESC("time_desc", "pinned DESC, orderIndex ASC, time DESC"),
+
+    /** 时间：由远及近。 */
+    TIME_ASC("time_asc", "pinned DESC, time ASC"),
+
+    /** 长度：从短到长。 */
+    LEN_ASC("len_asc", "pinned DESC, LENGTH(text) ASC, time DESC"),
+
+    /** 长度：从长到短。 */
+    LEN_DESC("len_desc", "pinned DESC, LENGTH(text) DESC, time DESC"),
+
+    /** 频数：上屏次数由多到少。 */
+    FREQ_DESC("freq_desc", "pinned DESC, useCount DESC, time DESC"),
+
+    /** 频数：上屏次数由少到多。 */
+    FREQ_ASC("freq_asc", "pinned DESC, useCount ASC, time DESC"),
+    ;
+
+    companion object {
+        fun of(id: String?): ClipSort = values().firstOrNull { it.id == id } ?: TIME_DESC
+    }
+}
+
+/**
+ * 排序选择的持久化。
+ *
+ * 单独用一个小 SharedPreferences（不动 AppPrefs 那套自动生成界面的体系），
+ * 剪贴板与收藏夹共用同一个选择。
+ */
+object ClipSortStore {
+    private const val FILE = "dahi_clip_sort"
+    private const val KEY = "sort"
+
+    fun load(context: Context): ClipSort = ClipSort.of(prefs(context).getString(KEY, ClipSort.TIME_DESC.id))
+
+    fun save(
+        context: Context,
+        sort: ClipSort,
+    ) {
+        prefs(context).edit().putString(KEY, sort.id).apply()
+    }
+
+    private fun prefs(context: Context) = context.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+}
+
+/** 排序方式的显示名（菜单里用）。 */
+fun ClipSort.label(ctx: Context): String = ctx.getString(
+    when (this) {
+        ClipSort.TIME_DESC -> R.string.dahi_cp_sort_time_desc
+        ClipSort.TIME_ASC -> R.string.dahi_cp_sort_time_asc
+        ClipSort.LEN_ASC -> R.string.dahi_cp_sort_len_asc
+        ClipSort.LEN_DESC -> R.string.dahi_cp_sort_len_desc
+        ClipSort.FREQ_DESC -> R.string.dahi_cp_sort_freq_desc
+        ClipSort.FREQ_ASC -> R.string.dahi_cp_sort_freq_asc
+    },
+)
+
+/** 排序方式的极短标签（搜索框提示里用，两三个字）。 */
+fun ClipSort.shortLabel(ctx: Context): String = ctx.getString(
+    when (this) {
+        ClipSort.TIME_DESC -> R.string.dahi_cp_sort_short_time_desc
+        ClipSort.TIME_ASC -> R.string.dahi_cp_sort_short_time_asc
+        ClipSort.LEN_ASC -> R.string.dahi_cp_sort_short_len_asc
+        ClipSort.LEN_DESC -> R.string.dahi_cp_sort_short_len_desc
+        ClipSort.FREQ_DESC -> R.string.dahi_cp_sort_short_freq_desc
+        ClipSort.FREQ_ASC -> R.string.dahi_cp_sort_short_freq_asc
+    },
+)
+
+/**
+ * 构造「按当前排序取一页」的查询（剪贴板与收藏夹共用一个 DatabaseDao）。
+ *
+ * 用 RawQuery 而不是在 DAO 里写死 ORDER BY：排序方式有六种、过滤条件有四种，
+ * 组合起来十几个方法不现实；拼一条 SQL 就够了。
+ * [uncategorized] 为 true 时表示只看「未分类」（category 为 NULL 或空串）。
+ */
+internal fun clipPagingQuery(
+    sort: ClipSort,
+    category: String? = null,
+    uncategorized: Boolean = false,
+    query: String? = null,
+): SupportSQLiteQuery {
+    val sb = StringBuilder("SELECT * FROM ")
+    sb.append(DatabaseBean.TABLE_NAME)
+    val args = ArrayList<String>()
+    val like = "text LIKE '%' || ? || '%' ESCAPE '\\'"
+    when {
+        uncategorized && query == null -> sb.append(" WHERE (category IS NULL OR category = '')")
+        uncategorized -> {
+            sb.append(" WHERE (category IS NULL OR category = '') AND ").append(like)
+            args.add(query.orEmpty())
+        }
+        category != null && query == null -> {
+            sb.append(" WHERE category = ?")
+            args.add(category)
+        }
+        category != null -> {
+            sb.append(" WHERE category = ? AND ").append(like)
+            args.add(category)
+            args.add(query.orEmpty())
+        }
+        query != null -> {
+            sb.append(" WHERE ").append(like)
+            args.add(query)
+        }
+    }
+    sb.append(" ORDER BY ").append(sort.orderBy)
+    return SimpleSQLiteQuery(sb.toString(), args.toTypedArray())
+}
