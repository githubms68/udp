+    // ---------------- 自定义模板 ----------------
+
+    /** 自定义模板槽位：1 / 2。 */
+    fun hasCustomTemplate(slot: Int): Boolean = prefs.contains(KEY_CUSTOM + slot)
+
+    /** 模板的自定义名称；未命名为 null（回落到「自定义模板 1/2」）。 */
+    fun customTemplateName(slot: Int): String? = prefs.getString(KEY_CUSTOM_NAME + slot, null)?.takeIf { it.isNotBlank() }
+
+    /** 重命名模板（传 null / 空串 = 取消命名）。 */
+    fun setCustomTemplateName(
+        slot: Int,
+        name: String?,
+    ) {
+        prefs.edit {
+            if (name.isNullOrBlank()) remove(KEY_CUSTOM_NAME + slot) else putString(KEY_CUSTOM_NAME + slot, name.trim())
+        }
+    }
+
+    /** 当前「颜色 + 尺寸」覆盖快照（颜色按分组名、尺寸按 field 名）。 */
+    fun snapshotJson(): JSONObject {
+        val colors = readColors()
+        val colorGroups = JSONObject()
+        COLOR_GROUPS.forEach { (group, keys) ->
+            keys.forEach { k -> colors[k]?.let { colorGroups.put(group, it) } }
+        }
+        val sizeJson = JSONObject()
+        readSizes().forEach { (f, v) -> sizeJson.put(f, v.toDouble()) }
+        return JSONObject().apply {
+            put("colors", colorGroups)
+            put("sizes", sizeJson)
+        }
+    }
+
+    /**
+     * 保存当前「颜色 + 尺寸」为自定义模板（槽位 1 / 2）。
+     *
+     * 颜色按**分组名**存（与快速模板一致），尺寸按 field 存；
+     * 只存用户实际覆盖过的项，未覆盖的自然恢复主题原生值。
+     */
+    fun saveCustomTemplate(slot: Int) {
+        prefs.edit { putString(KEY_CUSTOM + slot, snapshotJson().toString()) }
+    }
+
+    /**
+     * 应用自定义模板：整表替换颜色与尺寸覆盖（未存的项恢复主题原生），并自动启用总开关。
+     */
+    fun applyCustomTemplate(slot: Int) {
+        val raw = prefs.getString(KEY_CUSTOM + slot, null) ?: return
+        runCatching { applySnapshot(JSONObject(raw)) }
+            .onFailure { Timber.tag(TAG).w(it, "应用自定义模板 %s 失败", slot) }
+    }
+
+    // ---------------- 模板导出 / 导入（本地文件，便于与他人分享） ----------------
+
+    /**
+     * 导出为可分享的模板文本。
+     *
+     * **刻意不加密**：样式模板只含颜色值与小数值，没有任何隐私数据；
+     * 不加密才能「发出去、对方直接导入」，方便社区交流配色。
+     * 它与「备份与还原」的 AES 加密是两套完全独立的功能，互不影响。
+     */
+    fun exportTemplateText(): String {
+        val snapshot = snapshotJson()
+        return JSONObject()
+            .apply {
+                put("app", "dahi-style")
+                put("version", TEMPLATE_VERSION)
+                put("created", System.currentTimeMillis())
+                put("colors", snapshot.optJSONObject("colors") ?: JSONObject())
+                put("sizes", snapshot.optJSONObject("sizes") ?: JSONObject())
+            }.toString(2)
+    }
+
+    /**
+     * 导入模板文本；成功返回 true。
+     *
+     * 接受本 App 导出的 JSON，也兼容只有 `colors` / `sizes` 的简版；
+     * 无法识别的条目会被忽略，不会污染当前设置。
+     */
+    fun importTemplateText(text: String): Boolean {
+        val ok = runCatching { applySnapshot(JSONObject(text)) }
+            .onFailure { Timber.tag(TAG).w(it, "导入样式模板失败") }
+            .isSuccess
+        return ok
+    }
+
+    /** 把「colors / sizes」快照套用到当前覆盖（整表替换）并启用总开关。 */
+    private fun applySnapshot(json: JSONObject) {
+        val colorGroups = json.optJSONObject("colors")
+        val newColors = linkedMapOf<String, Int>()
+        COLOR_GROUPS.forEach { (group, keys) ->
+            if (colorGroups != null && colorGroups.has(group)) {
+                val value = colorGroups.optInt(group)
+                keys.forEach { newColors[it] = value }
+            }
+        }
+        val newSizes = linkedMapOf<String, Float>()
+        json.optJSONObject("sizes")?.let { sj ->
+            sj.keys().forEach { f ->
+                if (SIZE_ITEMS.any { it.field == f }) newSizes[f] = sj.optDouble(f, 0.0).toFloat()
+            }
+        }
+        prefs.edit { putBoolean(KEY_ENABLED, true) }
+        writeColors(newColors)
+        writeSizes(newSizes)
+        applyTheme()
+    }
+
+    /** 删除自定义模板槽位（只删模板，不影响当前样式）。 */
+    fun clearCustomTemplate(slot: Int) {
+        prefs.edit {
+            remove(KEY_CUSTOM + slot)
+            remove(KEY_CUSTOM_NAME + slot)
+        }
+    }
+
+    fun setSize(
+        field: String,
+        value: Float,
+    ) {
+        val sizes = readSizes()
+        sizes[field] = value
+        writeSizes(sizes)
+        applyTheme()
+    }
+
+    /** 把尺寸覆盖套用到 [GeneralStyle]。 */
+    fun patchGeneralStyle(style: GeneralStyle): GeneralStyle {
+        if (!isEnabled()) return style
+        val s = readSizes()
+        if (s.isEmpty()) return style
+
+        // 「按键高度」在 trime 里只是**相对值**：每行高度最后都会被按键盘总高等比缩放，
+        // 所以单独调它原先看不出任何变化。这里把它换算成「键盘总高度的等比缩放」，才真正生效。
+        val baseKeyHeight = style.keyHeight.toFloat().takeIf { it > 0f } ?: 45f
+        val keyHeight = s["keyHeight"] ?: baseKeyHeight
+        val keyScale = (keyHeight / baseKeyHeight).coerceIn(0.4f, 3f)
+        val keyboardHeight = ((s["keyboardHeight"] ?: style.keyboardHeight.toFloat()) * keyScale).toInt()
+        val landHeight =
+            when {
+                s["keyboardHeightLand"] != null -> (s.getValue("keyboardHeightLand") * keyScale).toInt()
+                style.keyboardHeightLand > 0 -> (style.keyboardHeightLand * keyScale).toInt()
+                else -> 0
+            }
+
+        return style.copy(
+            roundCorner = s["roundCorner"] ?: style.roundCorner,
+            keyBorder = (s["keyBorder"] ?: style.keyBorder.toFloat()).toInt(),
+            keyTextSize = s["keyTextSize"] ?: style.keyTextSize,
+            candidateTextSize = s["candidateTextSize"] ?: style.candidateTextSize,
+            horizontalGap = (s["horizontalGap"] ?: style.horizontalGap.toFloat()).toInt(),
+            verticalGap = (s["verticalGap"] ?: style.verticalGap.toFloat()).toInt(),
+            shadowRadius = s["shadowRadius"] ?: style.shadowRadius,
+            commentTextSize = s["commentTextSize"] ?: style.commentTextSize,
+            labelTextSize = s["labelTextSize"] ?: style.labelTextSize,
+            keyTextOffsetX = s["keyTextOffsetX"] ?: style.keyTextOffsetX,
+            keyTextOffsetY = s["keyTextOffsetY"] ?: style.keyTextOffsetY,
+            keyHeight = keyHeight.toInt(),
+            keyboardHeight = keyboardHeight,
+            keyboardHeightLand = landHeight,
+            symbolTextSize = s["symbolTextSize"] ?: style.symbolTextSize,
+            keyLongTextSize = s["keyLongTextSize"] ?: style.keyLongTextSize,
+            keyboardPadding = (s["keyboardPadding"] ?: style.keyboardPadding.toFloat()).toInt(),
+            keyboardPaddingLeft = (s["keyboardPaddingLeft"] ?: style.keyboardPaddingLeft.toFloat()).toInt(),
+            keyboardPaddingRight = (s["keyboardPaddingRight"] ?: style.keyboardPaddingRight.toFloat()).toInt(),
+            keyboardPaddingBottom = (s["keyboardPaddingBottom"] ?: style.keyboardPaddingBottom.toFloat()).toInt(),
+            keyboardPaddingLand = (s["keyboardPaddingLand"] ?: style.keyboardPaddingLand.toFloat()).toInt(),
+            keyboardPaddingLandBottom = (s["keyboardPaddingLandBottom"] ?: style.keyboardPaddingLandBottom.toFloat()).toInt(),
+            candidateViewHeight = (s["candidateViewHeight"] ?: style.candidateViewHeight.toFloat()).toInt(),
+            candidateCornerRadius = s["candidateCornerRadius"] ?: style.candidateCornerRadius,
+            candidateBorder = (s["candidateBorder"] ?: style.candidateBorder.toFloat()).toInt(),
+            candidatePadding = (s["candidatePadding"] ?: style.candidatePadding.toFloat()).toInt(),
+            candidateSpacing = s["candidateSpacing"] ?: style.candidateSpacing,
+            commentHeight = (s["commentHeight"] ?: style.commentHeight.toFloat()).toInt(),
+            popupTextSize = s["popupTextSize"] ?: style.popupTextSize,
+            popupWidth = (s["popupWidth"] ?: style.popupWidth.toFloat()).toInt(),
+            popupHeight = (s["popupHeight"] ?: style.popupHeight.toFloat()).toInt(),
+        )
+    }
+
+    /** 由 [ThemeManager] 在构建 / 重载主题时调用。 */
+    fun patchTheme(theme: Theme): Theme {
+        if (!isEnabled()) return theme
+        val styled = theme.copy(generalStyle = patchGeneralStyle(theme.generalStyle))
+        // 「预编辑文字大小」不在 GeneralStyle 里（在 Preedit.foreground.fontSize），单独套一层。
+        // 速度环的高度跟着预编辑行走，所以字号一调，环也会一起变大。
+        val preeditSize = readSizes()["preeditFontSize"]
+        return if (preeditSize != null && preeditSize > 0f) {
+            styled.copy(
+                preedit =
+                styled.preedit.copy(
+                    foreground = styled.preedit.foreground.copy(fontSize = preeditSize),
+                ),
+            )
+        } else {
+            styled
+        }
+    }
+
+    // ---------------- 模板 / 重置 ----------------
+
+    fun reset() {
+        prefs.edit {
+            remove(KEY_COLORS)
+            remove(KEY_SIZES)
+        }
+        applyTheme()
+    }
+
+    /**
+     * 快速模板：`default` / `transparent` / `dark` / `light`。
+     *
+     * 注意：颜色表的键必须是**分组名**（与 [COLOR_GROUPS] 一致），
+     * 早期版本误写成了颜色键名（如 `key_back_color`），导致匹配不到分组、模板基本失效。
+     */
+    fun applyPreset(preset: String) {
+        val colors =
+            when (preset) {
+                "transparent" ->
+                    mapOf(
+                        "key_back" to 0x2BFFFFFF,
+                        "key_back_hl" to 0x66FFFFFF,
+                        "key_border" to 0x33FFFFFF,
+                    )
+                "dark" ->
+                    mapOf(
+                        "key_back" to 0xCC1E1E1E.toInt(),
+                        "key_back_hl" to 0xCC3A3A3A.toInt(),
+                        "key_text" to 0xFFFFFFFF.toInt(),
+                        "key_text_hl" to 0xFFFFFFFF.toInt(),
+                        "key_border" to 0x33FFFFFF,
+                        "cand_text" to 0xFFDDDDDD.toInt(),
+                        "cand_back" to 0xCC1E1E1E.toInt(),
+                        "cand_back_hl" to 0xCC3A3A3A.toInt(),
+                        "preedit_text" to 0xFFDDDDDD.toInt(),
+                        "preedit_back" to 0xCC1E1E1E.toInt(),
+                        "popup_back" to 0xCC1E1E1E.toInt(),
+                        "popup_text" to 0xFFDDDDDD.toInt(),
+                        "popup_hl_back" to 0xCC3A3A3A.toInt(),
+                        "popup_hl_text" to 0xFFFFFFFF.toInt(),
+                        "keybg" to 0xFF1E1E1E.toInt(),
+                    )
+                "light" ->
+                    mapOf(
+                        "key_back" to 0xFFEFEFEF.toInt(),
+                        "key_back_hl" to 0xFFFFFFFF.toInt(),
+                        "key_text" to 0xFF222222.toInt(),
+                        "key_text_hl" to 0xFF000000.toInt(),
+                        "key_border" to 0x22000000,
+                        "cand_text" to 0xFF333333.toInt(),
+                        "cand_back" to 0xFFF5F5F5.toInt(),
+                        "cand_back_hl" to 0xFFFFFFFF.toInt(),
+                        "preedit_text" to 0xFF333333.toInt(),
+                        "preedit_back" to 0xFFF5F5F5.toInt(),
+                        "popup_back" to 0xFFF5F5F5.toInt(),
+                        "popup_text" to 0xFF333333.toInt(),
+                        "popup_hl_back" to 0xFFFFFFFF.toInt(),
+                        "popup_hl_text" to 0xFF000000.toInt(),
+                        "keybg" to 0xFFEFEFEF.toInt(),
+                    )
+                else -> emptyMap()
+            }
+        val map = linkedMapOf<String, Int>()
+        COLOR_GROUPS.forEach { (group, keys) ->
+            val value = colors[group] ?: return@forEach
+            keys.forEach { map[it] = value }
+        }
+        prefs.edit {
+            putBoolean(KEY_ENABLED, true)
+            remove(KEY_SIZES)
+        }
+        writeColors(map)
+        applyTheme()
+    }
+
+    /**
+     * 应用样式覆盖并**强制重建输入视图**。
+     *
+     * 1. 重载被覆盖的主题（会触发主题变更回调）；
+     * 2. 刷新 ColorManager（触发配色变更回调）；
+     * 3. 自增「应用令牌」——与「键盘透明度」等偏好走同一套重建机制，
+     *    确保在当前主题对象结构未变（只改颜色）时键盘也能真正刷新。
+     */
+    private fun applyTheme() {
+        runCatching { ThemeManager.reloadActiveTheme() }
+            .onFailure { Timber.tag(TAG).w(it, "reloadActiveTheme 失败") }
+        runCatching { ColorManager.refresh() }
+            .onFailure { Timber.tag(TAG).w(it, "refresh 失败") }
+        runCatching {
+            val keyboard = AppPrefs.defaultInstance().keyboard
+            keyboard.dahiStyleApplyToken.setValue(keyboard.dahiStyleApplyToken.getValue() + 1)
+        }.onFailure { Timber.tag(TAG).w(it, "应用令牌自增失败") }
+    }
+}
