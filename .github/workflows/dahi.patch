+ * 独立于剪贴板 / 收藏夹的库（asr.db）：识别历史有自己的清理策略与搜索需求，
+ * 塞进 clipboard.db 只会让两边的 Bean / 迁移互相牵连。
+ *
+ * 时长字段单位都是毫秒；外部引擎（说点啥）拿不到分段，只有 [durRecordMs] 有值，
+ * 其余为 0，界面据此显示「外部引擎 · 无明细」。
+ */
+@Entity(tableName = AsrHistoryBean.TABLE_NAME)
+data class AsrHistoryBean(
+    @PrimaryKey(autoGenerate = true)
+    val id: Long = 0,
+    val createdAt: Long = System.currentTimeMillis(),
+    /** 最终上屏的文本。 */
+    val text: String,
+    /** 引擎原始输出（含未润色的内容）；外部引擎与 text 相同。 */
+    val rawText: String? = null,
+    /** 引擎标识，如 X-ASR / SenseVoice / 说点啥。 */
+    val engine: String,
+    /** builtin / external / system。 */
+    val source: String,
+    val chars: Int,
+    val durRecordMs: Long = 0,
+    val durAsrMs: Long = 0,
+    val durPostMs: Long = 0,
+    val durCommitMs: Long = 0,
+    /** 「重新识别」用的音频路径；未开启记录音频时为 null。 */
+    val audioPath: String? = null,
+) {
+    companion object {
+        const val TABLE_NAME = "asr_history"
+
+        const val SOURCE_BUILTIN = "builtin"
+        const val SOURCE_EXTERNAL = "external"
+        const val SOURCE_SYSTEM = "system"
+    }
+}
