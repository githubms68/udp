@@ -0,0 +1,36 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.link
+
+/**
+ * 语音输入「开 / 关」的统一入口。
+ *
+ * 工具栏麦克风按钮与主题预设键（`command: voice_toggle`）共用同一个会话控制器，
+ * 任何入口触发都按「没在录音就开、正在录音就关」处理，不必各自维护一份状态，
+ * 也就不容易出现「卡在小方块、再点没反应」这类状态不一致的问题。
+ *
+ * 输入栏挂载时用 [attach] 登记自己创建的控制器，卸载时用 [detach] 注销。
+ */
+internal object AsrkbVoiceToggle {
+    private var controller: AsrkbVoiceHoldSessionController? = null
+
+    fun attach(value: AsrkbVoiceHoldSessionController) {
+        controller = value
+    }
+
+    fun detach(value: AsrkbVoiceHoldSessionController) {
+        if (controller === value) controller = null
+    }
+
+    /** 是否正在录音：控制器在跑，或底层语音会话仍在进行中。 */
+    fun isRunning(): Boolean = controller?.isRunning() == true || AsrEngineProvider.isActive()
+
+    /** 点按式开关：没在录音就开，正在录音就关。 */
+    fun toggle() {
+        val current = controller ?: return
+        if (isRunning()) current.stop() else current.start()
+    }
+}
