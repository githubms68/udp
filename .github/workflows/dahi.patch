+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import com.osfans.trime.R
+import com.osfans.trime.data.base.DataManager
+import com.osfans.trime.data.db.ClipboardHelper
+import com.osfans.trime.data.db.CollectionHelper
+import com.osfans.trime.data.db.DatabaseBean
+import com.osfans.trime.data.userdict.UserDictManager
+import com.osfans.trime.util.appContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.ByteArrayOutputStream
+import java.io.File
+
+/**
+ * 词库体检：扫描「用户词库 / 自定义短语 / 候选排序 / 分类 / 剪贴板」里的可疑数据。
+ *
+ * 设计原则：
+ * - **用户词库只读**。librime 没有「删除单个 userdb 词条」的 API，要清理只能
+ *   「导出 → 过滤 → 清空 → 全量导入（重建）」，那会让调频次数重置，风险远大于收益。
+ *   所以这一组只给清单，一个词都不动。
+ * - 其余四组都是 dahi 自己的数据（SharedPreferences / Room），可以精确清理，
+ *   并且清理前会把原值写进 [UNDO_KEY]，支持「撤销上次清理」。
+ * - 默认什么都不勾，全部由用户手动选择。
+ */
+object DahiHealth {
+    enum class Group { RIME, PHRASE, ORDER, CATEGORY, CLIPBOARD }
+
+    /** 一条具体问题记录。[key] 的语义由所属分组决定（见 [clean]）。 */
+    data class Entry(
+        val key: String,
+        val label: String,
+        val extra: String = "",
+    )
+
+    data class Finding(
+        val id: String,
+        val group: Group,
+        val titleRes: Int,
+        val hintRes: Int,
+        val cleanable: Boolean,
+        val entries: List<Entry>,
+    )
+
+    data class Report(
+        val findings: List<Finding>,
+        val at: Long = System.currentTimeMillis(),
+    ) {
+        fun countOf(group: Group): Int = findings.filter { it.group == group }.sumOf { it.entries.size }
+
+        fun totalOf(group: Group): Int = findings.filter { it.group == group }.size
+
+        val cleanableCount: Int get() = findings.count { it.cleanable }
+    }
+
+    private const val UNDO_KEY = "dahi_health_undo"
+    private const val KIND_PHRASE = "phrase"
+    private const val KIND_ORDER = "order"
+    private const val KIND_CATEGORY = "category"
+    private const val WHITELIST_KEY = "dahi_health_whitelist"
+
+    /** 预览上限：清单可能上千条，界面只展示前这么多，避免卡顿。 */
+    const val PREVIEW_LIMIT = 60
+
+    /** 分组展示顺序：能直接清理的在前，只读的用户词库放最后。 */
+    private val GROUP_ORDER =
+        listOf(Group.CLIPBOARD, Group.PHRASE, Group.CATEGORY, Group.ORDER, Group.RIME)
+
+    private val CODE_KEYWORD =
+        Regex("验证码|校验码|动态码|确认码|verification code|OTP", RegexOption.IGNORE_CASE)
+    private val PURE_CODE = Regex("^\\d{4,8}$")
+    private val CODE_IN_TEXT = Regex("\\d{4,8}")
+
+    /** 关键字型验证码消息的长度上限：再长就是「聊到验证码」的文章，不是验证码本身。 */
+    private const val CODE_TEXT_MAX = 32
+
+    /**
+     * 是不是「过期的验证码」。
+     *
+     * 老规则只看「文本里含验证码三个字」，于是任何一句聊到验证码的话
+     * （"验证码这个场景现在基本是…"）都会被列进待清理清单 —— 这是纯噪音。
+     * 现在的规则：
+     *  - 整条就是 4~8 位纯数字；或
+     *  - 短文本（≤32 字）且**同时**含关键字与 4~8 位连续数字（"验证码 123456" 这类）。
+     */
+    private fun looksLikeCode(text: String): Boolean {
+        val t = text.trim()
+        if (PURE_CODE.matches(t)) return true
+        if (t.length > CODE_TEXT_MAX) return false
+        if (!CODE_KEYWORD.containsMatchIn(t)) return false
+        return CODE_IN_TEXT.containsMatchIn(t)
+    }
+
+    /** 验证码有效期：超过这个时间就算过期，可以清理。 */
+    private const val CODE_TTL_MS = 20 * 60 * 1000L
+
+    /** 常用叠词白名单：这些是正常用法，不该被当成叠字噪点。 */
+    private val DUP_CHAR_OK =
+        setOf(
+            "妈妈", "爸爸", "爷爷", "奶奶", "哥哥", "姐姐", "弟弟", "妹妹", "宝宝", "谢谢",
+            "看看", "想想", "试试", "问问", "走走", "坐坐", "聊聊", "说说", "听听", "找找",
+            "刚刚", "慢慢", "好好", "常常", "渐渐", "悄悄", "偷偷", "偏偏", "明明", "仅仅",
+            "天天", "年年", "人人", "家家", "时时", "处处", "样样", "件件", "个个", "种种",
+            "星星", "多多", "点点", "条条", "层层", "步步", "面面", "头头", "本本", "串串",
+        )
+
+    /** 合法短语编码：小写字母、数字、单引号（与 Rime 编码习惯一致）。 */
+    private val CODE_PATTERN = Regex("^[a-z0-9']+$")
+
+    private const val WEIGHT_LOW = 1.2
+    private const val MAX_WORD_LEN = 12
+    private const val MAX_PHRASE_LEN = 200
+    private const val MAX_CLIP_LEN = 20000
+
+    private fun prefs() = appContext!!.getSharedPreferences("dahi_health_pref", Context.MODE_PRIVATE)
+
+    fun whitelist(): Set<String> = prefs().getStringSet(WHITELIST_KEY, emptySet())?.toSet() ?: emptySet()
+
+    fun addWhitelist(key: String) {
+        val set = whitelist().toMutableSet()
+        set.add(key)
+        prefs().edit().putStringSet(WHITELIST_KEY, set).apply()
+    }
+
+    fun removeWhitelist(key: String) {
+        val set = whitelist().toMutableSet()
+        if (set.remove(key)) prefs().edit().putStringSet(WHITELIST_KEY, set).apply()
+    }
+
+    fun clearWhitelist() {
+        prefs().edit().remove(WHITELIST_KEY).apply()
+    }
+
+    /** 已忽略项的展示文本（键里带分隔符，只取最后一段给用户看）。 */
+    fun whitelistDisplay(): List<Pair<String, String>> = whitelist()
+        .map { key ->
+            val label = key.substringAfter(':').substringAfterLast('\u0000')
+            key to label.ifEmpty { key }
+        }.sortedBy { it.second }
+
+    fun hasUndo(): Boolean = prefs().contains(UNDO_KEY)
+
+    fun undoLabel(): String = prefs().getString(UNDO_KEY, "").orEmpty()
+
+    fun clearUndo() {
+        prefs().edit().remove(UNDO_KEY).apply()
+    }
+
+    // ---------------------------------------------------------------- 扫描
+
+    suspend fun scan(): Report = withContext(Dispatchers.IO) {
+        val wl = whitelist()
+        val findings = ArrayList<Finding>()
+
+        val dictWords = runCatching { mainDictWords() }.getOrDefault(emptySet())
+        val userWords = runCatching { userDictEntries() }.getOrDefault(emptyMap())
+        val phrases = runCatching { DahiCustomPhrase.all() }.getOrDefault(emptyMap())
+        val phraseTexts = phrases.values.toSet()
+
+        findings += rimeFindings(userWords)
+        findings += phraseFindings(phrases)
+        findings += orderFindings(dictWords, userWords, phraseTexts)
+        findings += categoryFindings()
+        findings += clipboardFindings()
+        // 白名单统一在这里过滤，两种键都认：
+        //  · 检查项 id + 条目 key（可清理组，跟具体那条记录绑定）
+        //  · 检查项 id + "t:" + 预览文本（按内容忽略：记录删了/ID 变了也照样不报，
+        //    用于「这条其实不是验证码」这类误报）
+        Report(
+            findings
+                .map { f ->
+                    f.copy(
+                        entries = f.entries.filter {
+                            "${f.id}:${it.key}" !in wl && "${f.id}:t:${it.label}" !in wl
+                        },
+                    )
+                }
+                .filter { it.entries.isNotEmpty() }
+                // 排序：可清理的组在前，只读的用户词库压到最后；
+                // 组内按条目数从少到多 —— 几百条的长清单不该挡在几条的前面。
+                .sortedWith(compareBy({ GROUP_ORDER.indexOf(it.group) }, { it.entries.size })),
+        )
+    }
+
+    /** 把「多久以前」说成人话：分钟 / 小时 / 天。 */
+    private fun ageText(time: Long): String {
+        val minutes = ((System.currentTimeMillis() - time).coerceAtLeast(0)) / 60_000L
+        val ctx = appContext!!
+        return when {
+            minutes < 60 -> ctx.getString(R.string.dahi_health_age_min, minutes)
+            minutes < 60 * 24 -> ctx.getString(R.string.dahi_health_age_hour, minutes / 60)
+            else -> ctx.getString(R.string.dahi_health_age_day, minutes / (60 * 24))
+        }
+    }
+
+    /** 主词库的全部词条（`*.dict.yaml` 每行第一列）。用于判断排序里的失效项。 */
+    private fun mainDictWords(): Set<String> {
+        val files = dictFiles()
+        if (files.isEmpty()) return emptySet()
+        val words = HashSet<String>(1 shl 17)
+        files.forEach { f ->
+            runCatching {
+                f.bufferedReader().useLines { lines ->
+                    var inBody = false
+                    lines.forEach { raw ->
+                        if (!inBody) {
+                            // dict.yaml 上半部分是 YAML 头，遇到单独一行的 `...` 才是词表开始
+                            if (raw.trim() == "...") inBody = true
+                            return@forEach
+                        }
+                        if (raw.isBlank() || raw.startsWith("#")) return@forEach
+                        val tab = raw.indexOf('\t')
+                        val word = if (tab > 0) raw.substring(0, tab) else raw.substringBefore(' ')
+                        if (word.isNotEmpty()) words.add(word)
+                    }
+                }
+            }
+        }
+        return words
+    }
+
+    /** 用户词库：`词 \t 编码 \t 权重`。返回 `词 → 权重列表`。 */
+    private fun userDictEntries(): Map<String, List<Double>> {
+        val result = HashMap<String, MutableList<Double>>()
+        runCatching {
+            UserDictManager.getUserDictList().forEach { dict ->
+                val out = ByteArrayOutputStream()
+                val ok = UserDictManager.exportUserDict(out, dict, "dahi-health-$dict.txt")
+                if (!ok.isSuccess) return@forEach
+                out.toString("UTF-8").lineSequence().forEach { line ->
+                    if (line.isBlank()) return@forEach
+                    val parts = line.split('\t')
+                    val word = parts.getOrNull(0)?.trim().orEmpty()
+                    if (word.isEmpty()) return@forEach
+                    val weight = parts.getOrNull(2)?.toDoubleOrNull() ?: 1.0
+                    result.getOrPut(word) { ArrayList() }.add(weight)
+                }
+            }
+        }
+        return result
+    }
+
+    private fun rimeFindings(userWords: Map<String, List<Double>>): List<Finding> {
+        val single = ArrayList<Entry>()
+        val lowWeight = ArrayList<Entry>()
+        val dupChar = ArrayList<Entry>()
+        val tooLong = ArrayList<Entry>()
+        val hasSpace = ArrayList<Entry>()
+
+        userWords.forEach { (word, weights) ->
+            val w = weights.minOrNull() ?: 1.0
+            val extra = appContext!!.getString(R.string.dahi_health_weight, w)
+            when {
+                word.length == 1 -> single.add(Entry("r\u0000$word", word, extra))
+                word.length >= MAX_WORD_LEN -> tooLong.add(Entry("r\u0000$word", word, extra))
+                word.any { it.isWhitespace() } -> hasSpace.add(Entry("r\u0000$word", word, extra))
+                isDupCharNoise(word) -> dupChar.add(Entry("r\u0000$word", word, extra))
+                word.length <= 2 && w < WEIGHT_LOW -> lowWeight.add(Entry("r\u0000$word", word, extra))
+            }
+        }
+
+        return listOf(
+            Finding(
+                "rime_single",
+                Group.RIME,
+                R.string.dahi_health_rime_single,
+                R.string.dahi_health_rime_single_hint,
+                false,
+                single.take(PREVIEW_LIMIT * 4).sortedBy { it.label },
+            ),
+            Finding(
+                "rime_lowweight",
+                Group.RIME,
+                R.string.dahi_health_rime_lowweight,
+                R.string.dahi_health_rime_lowweight_hint,
+                false,
+                lowWeight.take(PREVIEW_LIMIT * 4).sortedBy { it.extra },
+            ),
+            Finding(
+                "rime_dupchar",
+                Group.RIME,
+                R.string.dahi_health_rime_dupchar,
+                R.string.dahi_health_rime_dupchar_hint,
+                false,
+                dupChar.take(PREVIEW_LIMIT * 4),
+            ),
+            Finding(
+                "rime_long",
+                Group.RIME,
+                R.string.dahi_health_rime_long,
+                R.string.dahi_health_rime_long_hint,
+                false,
+                tooLong.take(PREVIEW_LIMIT * 4),
+            ),
+            Finding(
+                "rime_space",
+                Group.RIME,
+                R.string.dahi_health_rime_space,
+                R.string.dahi_health_rime_space_hint,
+                false,
+                hasSpace.take(PREVIEW_LIMIT * 4),
+            ),
+        )
+    }
+
+    /** `AA` 型叠字且不在白名单里（的的、了了、是是…）。 */
+    private fun isDupCharNoise(word: String): Boolean {
+        if (word.length != 2) return false
+        if (word[0] != word[1]) return false
+        if (word in DUP_CHAR_OK) return false
+        return true
+    }
+
+    private fun phraseFindings(phrases: Map<String, String>): List<Finding> {
+        val badCode = ArrayList<Entry>()
+        val longText = ArrayList<Entry>()
+        val emptyText = ArrayList<Entry>()
+        val byText = HashMap<String, MutableList<String>>()
+
+        phrases.forEach { (code, text) ->
+            val extra = if (text.length > 24) text.take(24) + "…" else text
+            if (code.isEmpty() || !CODE_PATTERN.matches(code)) badCode.add(Entry("p\u0000$code", code, extra))
+            if (text.isBlank()) emptyText.add(Entry("p\u0000$code", code, extra))
+            if (text.length > MAX_PHRASE_LEN) longText.add(Entry("p\u0000$code", code, extra))
+            if (text.isNotBlank()) byText.getOrPut(text) { ArrayList() }.add(code)
+        }
+
+        // 正文重复：同一个正文挂在多个编码上（保留编码最短的那个，其余建议删）
+        val dupText = ArrayList<Entry>()
+        byText.forEach { (text, codes) ->
+            if (codes.size <= 1) return@forEach
+            val keep = codes.minByOrNull { it.length } ?: return@forEach
+            codes.filter { it != keep }.forEach { code ->
+                dupText.add(Entry("p\u0000$code", code, text.take(24)))
+            }
+        }
+
+        return listOf(
+            Finding(
+                "phrase_badcode",
+                Group.PHRASE,
+                R.string.dahi_health_phrase_badcode,
+                R.string.dahi_health_phrase_badcode_hint,
+                true,
+                badCode,
+            ),
+            Finding(
+                "phrase_empty",
+                Group.PHRASE,
+                R.string.dahi_health_phrase_empty,
+                R.string.dahi_health_phrase_empty_hint,
+                true,
+                emptyText,
+            ),
+            Finding(
+                "phrase_long",
+                Group.PHRASE,
+                R.string.dahi_health_phrase_long,
+                R.string.dahi_health_phrase_long_hint,
+                true,
+                longText,
+            ),
+            Finding(
+                "phrase_duptext",
+                Group.PHRASE,
+                R.string.dahi_health_phrase_duptext,
+                R.string.dahi_health_phrase_duptext_hint,
+                true,
+                dupText,
+            ),
+        )
+    }
+
+    private fun orderFindings(
+        dictWords: Set<String>,
+        userWords: Map<String, List<Double>>,
+        phraseTexts: Set<String>,
+    ): List<Finding> {
+        val missing = ArrayList<Entry>()
+        val dup = ArrayList<Entry>()
+
+        DahiCandidateOrder.entries().forEach { (input, words) ->
+            val seen = HashSet<String>()
+            words.forEach { word ->
+                if (!seen.add(word)) {
+                    dup.add(Entry("o\u0000$input\u0000$word", "$input → $word", word))
+                    return@forEach
+                }
+                val exists = word in dictWords || word in userWords || word in phraseTexts
+                if (!exists) missing.add(Entry("o\u0000$input\u0000$word", "$input → $word", word))
+            }
+        }
+        return listOf(
+            Finding(
+                "order_missing",
+                Group.ORDER,
+                R.string.dahi_health_order_missing,
+                R.string.dahi_health_order_missing_hint,
+                true,
+                missing,
+            ),
+            Finding(
+                "order_dup",
+                Group.ORDER,
+                R.string.dahi_health_order_dup,
+                R.string.dahi_health_order_dup_hint,
+                false,
+                dup,
+            ),
+        )
+    }
+
+    private suspend fun categoryFindings(): List<Finding> {
+        val used = HashSet<String>()
+        runCatching { ClipboardHelper.categories() }.getOrDefault(emptyList()).forEach { used.add(it) }
+        runCatching { CollectionHelper.categories() }.getOrDefault(emptyList()).forEach { used.add(it) }
+
+        val empty = ArrayList<Entry>()
+        val spaced = ArrayList<Entry>()
+        DahiCategoryStore.loadOrdered().forEach { name ->
+            if (DahiCategoryStore.isPseudo(name)) return@forEach
+            if (name.trim() != name) {
+                spaced.add(Entry("c\u0000$name", name, appContext!!.getString(R.string.dahi_health_cat_space_extra)))
+            } else if (name !in used) {
+                empty.add(Entry("c\u0000$name", name, appContext!!.getString(R.string.dahi_health_cat_empty_extra)))
+            }
+        }
+        return listOf(
+            Finding(
+                "cat_empty",
+                Group.CATEGORY,
+                R.string.dahi_health_cat_empty,
+                R.string.dahi_health_cat_empty_hint,
+                true,
+                empty,
+            ),
+            Finding(
+                "cat_spaced",
+                Group.CATEGORY,
+                R.string.dahi_health_cat_spaced,
+                R.string.dahi_health_cat_spaced_hint,
+                true,
+                spaced,
+            ),
+        )
+    }
+
+    private suspend fun clipboardFindings(): List<Finding> {
+        val clip = runCatching { ClipboardHelper.all() }.getOrDefault(emptyList())
+        val coll = runCatching { CollectionHelper.all() }.getOrDefault(emptyList())
+
+        val dup = ArrayList<Entry>()
+        val tooLong = ArrayList<Entry>()
+        val expiredCode = ArrayList<Entry>()
+        listOf("c" to clip, "f" to coll).forEach { (tag, beans) ->
+            val byText = HashMap<String, MutableList<DatabaseBean>>()
+            beans.forEach { b ->
+                val text = b.text ?: return@forEach
+                byText.getOrPut(text) { ArrayList() }.add(b)
+            }
+            byText.forEach { (text, list) ->
+                if (list.size <= 1) return@forEach
+                // 保留：置顶优先 → 用过的（useCount 高）→ 最新的
+                val keep =
+                    list.sortedWith(
+                        compareByDescending<DatabaseBean> { it.pinned }
+                            .thenByDescending { it.useCount }
+                            .thenByDescending { it.time },
+                    ).first()
+                list.filter { it.id != keep.id }.forEach { b ->
+                    val key = "$tag:${b.id}"
+                    dup.add(Entry("l\u0000$key", text.take(30), appContext!!.getString(R.string.dahi_health_clip_dup_extra)))
+                }
+            }
+            beans.forEach { b ->
+                val text = b.text ?: return@forEach
+                if (text.length <= MAX_CLIP_LEN) return@forEach
+                val key = "$tag:${b.id}"
+                tooLong.add(
+                    Entry(
+                        "l\u0000$key",
+                        text.take(30),
+                        appContext!!.getString(R.string.dahi_health_clip_len_extra, text.length),
+                    ),
+                )
+            }
+            // 过期验证码：含关键字或整条是 4~8 位纯数字，且已超过 20 分钟
+            beans.forEach { b ->
+                val text = b.text ?: return@forEach
+                if (System.currentTimeMillis() - b.time < CODE_TTL_MS) return@forEach
+                if (!looksLikeCode(text)) return@forEach
+                val key = "$tag:${b.id}"
+                expiredCode.add(
+                    Entry(
+                        "l\u0000$key",
+                        text.take(30),
+                        appContext!!.getString(R.string.dahi_health_clip_code_extra, ageText(b.time)),
+                    ),
+                )
+            }
+        }
+        return listOf(
+            Finding(
+                "clip_code",
+                Group.CLIPBOARD,
+                R.string.dahi_health_clip_code,
+                R.string.dahi_health_clip_code_hint,
+                true,
+                expiredCode,
+            ),
+            Finding(
+                "clip_dup",
+                Group.CLIPBOARD,
+                R.string.dahi_health_clip_dup,
+                R.string.dahi_health_clip_dup_hint,
+                true,
+                dup,
+            ),
+            Finding(
+                "clip_long",
+                Group.CLIPBOARD,
+                R.string.dahi_health_clip_long,
+                R.string.dahi_health_clip_long_hint,
+                true,
+                tooLong,
+            ),
+        )
+    }
+
+    // ---------------------------------------------------------------- 清理
+
+    /**
+     * 清理某个检查项下的指定条目，返回实际处理条数。
+     *
+     * 清理前会把「原值」写进 [UNDO_KEY]（只保留最近一次），供 [undoLast] 还原。
+     */
+    suspend fun clean(
+        finding: Finding,
+        entries: List<Entry>,
+    ): Int = withContext(Dispatchers.IO) {
+        if (!finding.cleanable || entries.isEmpty()) return@withContext 0
+        when (finding.group) {
+            Group.RIME -> 0
+            Group.PHRASE -> {
+                val codes = entries.map { it.key.substringAfter('\u0000') }
+                val backup = codes.mapNotNull { c -> DahiCustomPhrase.all()[c]?.let { c to it } }
+                saveUndo(KIND_PHRASE, backup.joinToString("\u0001") { "${it.first}\u0002${it.second}" })
+                DahiCustomPhrase.remove(*codes.toTypedArray())
+                codes.size
+            }
+
+            Group.ORDER -> {
+                val pairs = entries.mapNotNull { e ->
+                    val body = e.key.substringAfter('\u0000')
+                    val idx = body.indexOf('\u0000')
+                    if (idx <= 0) null else body.substring(0, idx) to body.substring(idx + 1)
+                }
+                val before = DahiCandidateOrder.entries()
+                saveUndo(KIND_ORDER, before.joinToString("\u0001") { "${it.first}\u0002${it.second.joinToString("\u0003")}" })
+                pairs.groupBy({ it.first }, { it.second }).forEach { (input, words) ->
+                    DahiCandidateOrder.removeWords(input, words)
+                }
+                pairs.size
+            }
+
+            Group.CATEGORY -> {
+                val names = entries.map { it.key.substringAfter('\u0000') }
+                saveUndo(KIND_CATEGORY, names.joinToString("\u0001"))
+                names.forEach { runCatching { DahiCategoryStore.delete(it) } }
+                names.size
+            }
+
+            Group.CLIPBOARD -> {
+                var n = 0
+                entries.forEach { e ->
+                    val key = e.key.substringAfter('\u0000')
+                    val isFav = key.startsWith("f:")
+                    val id = key.substringAfter(':').toIntOrNull() ?: return@forEach
+                    runCatching {
+                        if (isFav) CollectionHelper.delete(id) else ClipboardHelper.delete(id)
+                        n++
+                    }
+                }
+                // 剪贴板删除不可撤销（数据库没有回收站），这里不写 undo
+                n
+            }
+        }
+    }
+
+    /** 撤销上一次清理（仅短语 / 排序 / 分类三组支持）。 */
+    fun undoLast(): Boolean {
+        val raw = prefs().getString(UNDO_KEY, "").orEmpty()
+        if (raw.isEmpty()) return false
+        val sep = raw.indexOf('\u0000')
+        if (sep <= 0) return false
+        val kind = raw.substring(0, sep)
+        val body = raw.substring(sep + 1)
+        runCatching {
+            when (kind) {
+                KIND_PHRASE -> {
+                    body.split('\u0001').filter { it.isNotBlank() }.forEach { line ->
+                        val i = line.indexOf('\u0002')
+                        if (i > 0) DahiCustomPhrase.put(line.substring(0, i), line.substring(i + 1))
+                    }
+                }
+
+                KIND_ORDER -> {
+                    body.split('\u0001').filter { it.isNotBlank() }.forEach { line ->
+                        val i = line.indexOf('\u0002')
+                        if (i <= 0) return@forEach
+                        val input = line.substring(0, i)
+                        val words = line.substring(i + 1).split('\u0003').filter { it.isNotBlank() }
+                        DahiCandidateOrder.importOrders(mapOf(input to words), merge = false)
+                    }
+                }
+
+                KIND_CATEGORY -> {
+                    body.split('\u0001').filter { it.isNotBlank() }.forEach { DahiCategoryStore.add(it) }
+                }
+            }
+        }
+        clearUndo()
+        return true
+    }
+
+    private fun saveUndo(kind: String, body: String) {
+        prefs().edit().putString(UNDO_KEY, "$kind\u0000$body").apply()
+    }
+
+    /** 用户词库的「清单导出」文本（可复制到剪贴板 / 存成文件）。 */
+    suspend fun exportRimeList(finding: Finding): String = withContext(Dispatchers.IO) {
+        val sb = StringBuilder()
+        sb.append("# dahi 词库体检 · ").append(appContext!!.getString(finding.titleRes)).append('\n')
+        finding.entries.forEach { e ->
+            sb.append(e.label)
+            if (e.extra.isNotEmpty()) sb.append('\t').append(e.extra)
+            sb.append('\n')
+        }
+        sb.toString()
+    }
+
+    /**
+     * 供界面显示用：实际被扫描的词库文件名。
+     *
+     * 必须与 [mainDictWords] 的扫描范围**完全一致**：那边扫 shared + user 两个目录
+     * （万象这类方案的主词库部署在用户目录，只看 shared 会漏掉它，
+     * 界面上就会显示成「只读了 luna_pinyin、stroke」这种明显不对的结果）。
+     */
+    fun dictFileNames(): List<String> = dictFiles().map { it.name }
+
+    /** 实际参与扫描的词典文件（shared 目录 + 用户目录，按文件名去重）。 */
+    private fun dictFiles(): List<File> {
+        val dirs = listOf(DataManager.sharedDataDir, DataManager.userDataDir)
+        val seen = LinkedHashSet<String>()
+        val files = ArrayList<File>()
+        dirs.forEach { dir ->
+            dir.listFiles { f -> f.isFile && f.name.endsWith(".dict.yaml") }
+                ?.sortedBy { it.name }
+                ?.forEach { f -> if (seen.add(f.name)) files.add(f) }
+        }
+        return files
+    }
+
+    fun dictFileCount(): Int = dictFileNames().size
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiHomeSlogan.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiHomeSlogan.kt
