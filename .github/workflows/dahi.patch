+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.util.appContext
+import java.util.Calendar
+
+/**
+ * 备份自动提醒（大海版）。
+ *
+ * 加密备份是唯一能把「候选顺序 / 短语 / 键盘背景 / 剪贴板」带走的途径，
+ * 但此前完全靠用户自己想起来。这里提供：
+ * - **间隔天数**（默认 7 天，1~365 可调）；
+ * - **提醒时段**（默认 9:00~23:00，只在指定小时区间内提醒，避免深夜打扰）；
+ * - 每 6 小时最多提醒一次（防止一进首页就反复弹）。
+ */
+object DahiBackupReminder {
+    const val KEY_ENABLED = "dahi_backup_remind_enabled"
+    const val KEY_DAYS = "dahi_backup_remind_days"
+    const val KEY_START = "dahi_backup_remind_start_hour"
+    const val KEY_END = "dahi_backup_remind_end_hour"
+    const val KEY_LAST_BACKUP = "dahi_backup_remind_last_backup"
+    const val KEY_LAST_REMIND = "dahi_backup_remind_last_remind"
+    const val KEY_LAST_DIALOG = "dahi_backup_remind_last_dialog"
+    const val KEY_INSTALLED = "dahi_backup_remind_installed_at"
+
+    private const val THROTTLE_MS = 6 * 60 * 60 * 1000L
+
+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    fun enabled(): Boolean = prefs.getBoolean(KEY_ENABLED, false)
+
+    fun setEnabled(value: Boolean) {
+        prefs.edit { putBoolean(KEY_ENABLED, value) }
+    }
+
+    fun days(): Int = prefs.getInt(KEY_DAYS, 7).coerceIn(1, 365)
+
+    fun setDays(value: Int) {
+        prefs.edit { putInt(KEY_DAYS, value.coerceIn(1, 365)) }
+    }
+
+    fun startHour(): Int = prefs.getInt(KEY_START, 9).coerceIn(0, 23)
+
+    fun endHour(): Int = prefs.getInt(KEY_END, 23).coerceIn(0, 23)
+
+    fun setWindow(
+        start: Int,
+        end: Int,
+    ) {
+        prefs.edit {
+            putInt(KEY_START, start.coerceIn(0, 23))
+            putInt(KEY_END, end.coerceIn(0, 23))
+        }
+    }
+
+    /** 记一次「刚备份过」（备份成功时调用）。 */
+    fun noteBackup() {
+        prefs.edit { putLong(KEY_LAST_BACKUP, System.currentTimeMillis()) }
+    }
+
+    fun lastBackupAt(): Long = prefs.getLong(KEY_LAST_BACKUP, 0L)
+
+    fun lastRemindAt(): Long = prefs.getLong(KEY_LAST_REMIND, 0L)
+
+    /** 记录首次使用时间（用于「从未备份过」的起算点）。 */
+
+    /** 两条通知之间的最小间隔（避免每次弹键盘都提醒）。 */
+    private const val REMIND_MIN_GAP_MS = 12 * 60 * 60 * 1000L
+
+    /** 两次弹窗之间的最小间隔。 */
+    private const val DIALOG_MIN_GAP_MS = 6 * 60 * 60 * 1000L
+
+    private const val CHANNEL_ID = "dahi_backup_remind"
+
+    private const val NOTIFY_ID = 0x0DA41
+
+    private fun baselineAt(now: Long): Long {
+        val installed = prefs.getLong(KEY_INSTALLED, 0L)
+        if (installed <= 0L) {
+            prefs.edit { putLong(KEY_INSTALLED, now) }
+            return now
+        }
+        return installed
+    }
+
+    /** 距上次备份（或首次使用）已过多少天。 */
+    fun daysSinceLastBackup(now: Long = System.currentTimeMillis()): Int {
+        val last = lastBackupAt()
+        val base = if (last > 0L) last else baselineAt(now)
+        val diff = (now - base).coerceAtLeast(0L)
+        return (diff / (24 * 60 * 60 * 1000L)).toInt()
+    }
+
+    /** 当前小时是否落在提醒时段内；起止相同视为全天。 */
+    fun inWindow(now: Long = System.currentTimeMillis()): Boolean {
+        val hour = Calendar.getInstance().apply { timeInMillis = now }.get(Calendar.HOUR_OF_DAY)
+        val start = startHour()
+        val end = endHour()
+        return if (start == end) {
+            true
+        } else if (start < end) {
+            hour in start..end
+        } else {
+            hour >= start || hour <= end
+        }
+    }
+
+    /** 现在是否该提醒了。 */
+    fun dueNow(now: Long = System.currentTimeMillis()): Boolean {
+        if (!enabled()) return false
+        if (daysSinceLastBackup(now) < days()) return false
+        if (!inWindow(now)) return false
+        if (now - lastRemindAt() < THROTTLE_MS) return false
+        return true
+    }
+
+    fun markReminded(now: Long = System.currentTimeMillis()) {
+        prefs.edit { putLong(KEY_LAST_REMIND, now) }
+    }
+
+    /**
+     * 打开设置 App 时该不该弹提醒框。
+     *
+     * 与 [notifyIfDue] **各用各的节流**：通知是「弹键盘时」发的，用户当时很可能没看通知栏，
+     * 之后打开 App 却因为共用时间戳被挡掉 6 小时 —— 表现就是「打开应用从来没见过提醒」。
+     */
+    fun dialogDueNow(now: Long = System.currentTimeMillis()): Boolean {
+        if (!enabled()) return false
+        if (daysSinceLastBackup(now) < days()) return false
+        if (!inWindow(now)) return false
+        if (now - prefs.getLong(KEY_LAST_DIALOG, 0L) < DIALOG_MIN_GAP_MS) return false
+        return true
+    }
+
+    fun markDialogShown(now: Long = System.currentTimeMillis()) {
+        prefs.edit { putLong(KEY_LAST_DIALOG, now) }
+    }
+
+    /** 给设置页用的一句话状态：现在为什么提醒 / 为什么不提醒。 */
+    fun stateCode(now: Long = System.currentTimeMillis()): String {
+        if (!enabled()) return "off"
+        val passed = daysSinceLastBackup(now)
+        if (passed < days()) return "wait"
+        if (!inWindow(now)) return "window"
+        return "due"
+    }
+
+    /** 还差几天到期（为负表示已过期）。 */
+    fun daysUntilDue(now: Long = System.currentTimeMillis()): Int = days() - daysSinceLastBackup(now)
+
+    /**
+     * 到期就发一条系统通知（每个间隔最多打扰一次）。
+     *
+     * 提醒方式说明：本应用**没有**闹钟/后台定时任务（省电优先），
+     * 只在两个时机检查：① 打开设置 App 时弹窗；② 输入法弹出时发通知。
+     * 用户几乎每天都在打字，所以第二种方式能保证提醒真的送达。
+     */
+    fun notifyIfDue(context: android.content.Context) {
+        if (!enabled()) return
+        val now = System.currentTimeMillis()
+        if (!dueNow(now)) return
+        if (now - lastRemindAt() < REMIND_MIN_GAP_MS) return
+        // 通知被系统关掉时**不要**记账：否则这一次提醒白白消耗掉，
+        // 接下来 12 小时都不再尝试，用户只会觉得「提醒从来没出现过」。
+        if (!canNotify(context)) return
+        markReminded(now)
+        showNotification(context, daysSinceLastBackup(now))
+    }
+
+    /**
+     * 通知此刻是否真的能弹出来。
+     *
+     * 两类拦路虎：① Android 13+ 没有授予 POST_NOTIFICATIONS；② 用户把本应用的
+     * 「备份提醒」这个通道手动关成了「关闭」。任一成立时，发出去也是石沉大海。
+     */
+    fun canNotify(context: android.content.Context): Boolean {
+        // 用 ContextCompat / NotificationManagerCompat：本项目 minSdk = 21，
+        // 直接写 Context.checkSelfPermission（API 23）或 NotificationManager.areNotificationsEnabled（API 24）
+        // 在低版本设备上会 NoSuchMethodError。
+        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.TIRAMISU &&
+            androidx.core.content.ContextCompat.checkSelfPermission(
+                context,
+                android.Manifest.permission.POST_NOTIFICATIONS,
+            ) != android.content.pm.PackageManager.PERMISSION_GRANTED
+        ) {
+            return false
+        }
+        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.O) {
+            val manager =
+                context.getSystemService(android.app.NotificationManager::class.java) ?: return false
+            val channel = manager.getNotificationChannel(CHANNEL_ID) ?: return true
+            return channel.importance != android.app.NotificationManager.IMPORTANCE_NONE
+        }
+        return androidx.core.app.NotificationManagerCompat.from(context).areNotificationsEnabled()
+    }
+
+    /** 手动发一条（设置页的「测试提醒」按钮用）。 */
+    fun showNotification(
+        context: android.content.Context,
+        days: Int,
+    ) {
+        runCatching {
+            val manager = context.getSystemService(android.app.NotificationManager::class.java) ?: return
+            if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.O) {
+                manager.createNotificationChannel(
+                    android.app.NotificationChannel(
+                        CHANNEL_ID,
+                        context.getString(com.osfans.trime.R.string.dahi_backup_remind_title),
+                        android.app.NotificationManager.IMPORTANCE_DEFAULT,
+                    ),
+                )
+            }
+            val intent =
+                android.content.Intent(context, com.osfans.trime.ui.main.MainActivity::class.java).apply {
+                    addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK or android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP)
+                }
+            val pending =
+                android.app.PendingIntent.getActivity(
+                    context,
+                    0,
+                    intent,
+                    android.app.PendingIntent.FLAG_IMMUTABLE or android.app.PendingIntent.FLAG_UPDATE_CURRENT,
+                )
+            val notification =
+                androidx.core.app.NotificationCompat
+                    .Builder(context, CHANNEL_ID)
+                    .setSmallIcon(com.osfans.trime.R.drawable.ic_baseline_notifications_24)
+                    .setContentTitle(context.getString(com.osfans.trime.R.string.dahi_backup_remind_title))
+                    .setContentText(
+                        context.getString(com.osfans.trime.R.string.dahi_backup_remind_msg, days),
+                    ).setAutoCancel(true)
+                    .setContentIntent(pending)
+                    .build()
+            manager.notify(NOTIFY_ID, notification)
+        }
+    }
+
+    fun reset() {
+        prefs.edit {
+            remove(KEY_ENABLED)
+            remove(KEY_DAYS)
+            remove(KEY_START)
+            remove(KEY_END)
+            remove(KEY_LAST_BACKUP)
+            remove(KEY_LAST_REMIND)
+            remove(KEY_LAST_DIALOG)
+            remove(KEY_INSTALLED)
+        }
+    }
+}
