+        val voice: DahiVoiceStats.PeriodStat?,
+        val voiceCareer: DahiVoiceStats.PeriodStat?,
+        /** 「累计…」那一行，已格式化好（绘制阶段没有 Context）。 */
+        val voiceCareerText: String,
+        /** 「最近一次…」那一行，已格式化好；空串表示不显示。 */
+        val voiceLastText: String,
