+    /**
+     * 已隐藏的词：点一项恢复；也可以一次全部恢复。
+     *
+     * 说明文字和列表必须放进**同一个自定义 View**：
+     * AlertDialog 的 `setMessage` 与 `setItems` 共用同一块内容区，后设的会把先设的顶掉 ——
+     * 之前同时用了这两个，结果列表整块消失，只剩一句说明和两个按钮。
+     */
+    private fun showHiddenWords() {
+        if (!isAdded) return
+        val ctx = requireContext()
+        val list = DahiWordHidden.load(ctx).sorted()
+        if (list.isEmpty()) {
+            Toast.makeText(ctx, R.string.dahi_stats_word_hidden_empty, Toast.LENGTH_SHORT).show()
+            return
+        }
+        val box =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(20), ctx.dp(2), ctx.dp(20), ctx.dp(4))
+            }
+        box.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_stats_word_hidden_note)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 11.5f)
+                setTextColor(dahiText2())
+                setPadding(0, 0, 0, ctx.dp(6))
+            },
+        )
+        var dialog: androidx.appcompat.app.AlertDialog? = null
+        val rows =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+            }
+
+        fun rowOf(word: String): TextView = TextView(ctx).apply {
+            text = word
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+            setTextColor(dahiText())
+            setPadding(0, ctx.dp(11), 0, ctx.dp(11))
+            setOnClickListener {
+                DahiWordHidden.restore(ctx, word)
+                render()
+                Toast
+                    .makeText(ctx, getString(R.string.dahi_stats_word_hidden_restored, word), Toast.LENGTH_SHORT)
+                    .show()
+                dialog?.dismiss()
+                // 重开一次，让列表立刻少掉刚恢复的那一项
+                showHiddenWords()
+            }
+        }
+
+        fun renderRows(keyword: String) {
+            rows.removeAllViews()
+            val key = keyword.trim()
+            val hits = if (key.isEmpty()) list else list.filter { it.contains(key, ignoreCase = true) }
+            if (hits.isEmpty()) {
+                rows.addView(
+                    TextView(ctx).apply {
+                        setText(R.string.dahi_stats_word_hidden_no_match)
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                        setTextColor(dahiText2())
+                        setPadding(0, ctx.dp(10), 0, ctx.dp(10))
+                    },
+                )
+            } else {
+                hits.forEach { rows.addView(rowOf(it)) }
+            }
+        }
+
+        // 词少于十条时不给搜索框：弹出键盘反而挡住列表
+        if (list.size > 10) {
+            box.addView(
+                EditText(ctx).apply {
+                    hint = getString(R.string.dahi_stats_word_hidden_search)
+                    setSingleLine()
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                    setPadding(0, ctx.dp(4), 0, ctx.dp(4))
+                    doAfterTextChanged { renderRows(it?.toString().orEmpty()) }
+                },
+            )
+        }
+        renderRows("")
+        box.addView(rows)
+        dialog =
+            androidx.appcompat.app.AlertDialog
+                .Builder(ctx)
+                .setTitle(getString(R.string.dahi_stats_word_hidden_title, list.size))
+                .setView(ScrollView(ctx).apply { addView(box) })
+                .setNegativeButton(R.string.dahi_stats_word_hidden_restore_all) { _, _ ->
+                    confirmRestoreAll(list.size)
+                }.setPositiveButton(android.R.string.cancel, null)
+                .show()
+    }
