+
+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiTypingStyle
+import java.text.DecimalFormat
+import java.util.Locale
+
+/**
+ * 「我的打字风格」小卡（1080×1350，朋友圈竖图比例）。
+ *
+ * 只讲一件事：**你是哪种打字的人**。所以画面上一共四样东西 ——
+ * 主标签、一句解释、几个小标签、四个数字，其余都是留白。
+ *
+ * 配色走 [DahiSharePalette]，与统计分享图、年度回顾共用同一个模板键。
+ */
+object DahiStyleCardImage {
+    private const val WIDTH = 1080
+    private const val HEIGHT = 1350
+    private const val PAD = 80f
+
+    private val numFmt = DecimalFormat("###,###")
+
+    private fun num(v: Long): String = numFmt.format(v)
+
+    private fun tp(
+        size: Float,
+        color: Int,
+        bold: Boolean = false,
+    ): Paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        textSize = size
+        this.color = color
+        typeface = if (bold) Typeface.DEFAULT_BOLD else Typeface.DEFAULT
+    }
+
+    fun render(
+        ctx: Context,
+        style: DahiTypingStyle.Style,
+        template: String = "deep",
+    ): Bitmap {
+        val p = DahiSharePalette.of(template)
+        val bmp = Bitmap.createBitmap(WIDTH, HEIGHT, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bmp)
+        val w = WIDTH.toFloat()
+
+        val bg = Paint(Paint.ANTI_ALIAS_FLAG)
+        bg.shader =
+            LinearGradient(
+                0f,
+                0f,
+                0f,
+                HEIGHT.toFloat(),
+                p.bgTop,
+                p.bgBottom,
+                Shader.TileMode.CLAMP,
+            )
+        canvas.drawRect(0f, 0f, w, HEIGHT.toFloat(), bg)
+
+        // ── 品牌 ──
+        canvas.drawText("同文输入法 · 大海版", PAD, 120f, tp(26f, p.textDim))
+
+        // ── 小标题 ──
+        canvas.drawText(ctx.getString(R.string.dahi_ts_title), PAD, 230f, tp(34f, p.textSub))
+
+        // ── 主标签 ──
+        canvas.drawText(style.title, PAD, 400f, tp(140f, p.textMain, true))
+
+        // ── 副标题（可能较长，按可用宽度自动缩字号）──
+        val subPaint = tp(32f, p.textSub)
+        val maxSub = w - PAD * 2
+        if (subPaint.measureText(style.subtitle) > maxSub) {
+            subPaint.textSize = 32f * maxSub / subPaint.measureText(style.subtitle)
+        }
+        canvas.drawText(style.subtitle, PAD, 470f, subPaint)
+
+        // ── 标签 chips ──
+        val chipPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = DahiSharePalette.tint(p.accent, 0x33) }
+        val chipText = tp(30f, p.accent)
+        var cx = PAD
+        var cy = 520f
+        style.tags.forEach { tag ->
+            val tw = chipText.measureText(tag)
+            val boxW = tw + 56f
+            if (cx + boxW > w - PAD) {
+                cx = PAD
+                cy += 78f
+            }
+            canvas.drawRoundRect(RectF(cx, cy, cx + boxW, cy + 60f), 30f, 30f, chipPaint)
+            canvas.drawText(tag, cx + 28f, cy + 42f, chipText)
+            cx += boxW + 18f
+        }
+
+        // ── 分隔线 ──
+        val lineY = cy + 130f
+        canvas.drawLine(
+            PAD,
+            lineY,
+            w - PAD,
+            lineY,
+            Paint(Paint.ANTI_ALIAS_FLAG).apply {
+                color = p.divider
+                strokeWidth = 2f
+            },
+        )
+
+        // ── 四个数字 ──
+        val colW = (w - PAD * 2) / 4f
+        val cells =
+            listOf(
+                ctx.getString(R.string.dahi_ts_cell_chars) to num(style.totalChars),
+                ctx.getString(R.string.dahi_ts_cell_daily) to num(style.dailyChars),
+                ctx.getString(R.string.dahi_ts_cell_speed) to String.format(Locale.US, "%.0f", style.avgSpeed),
+                ctx.getString(R.string.dahi_ts_cell_streak) to "${style.streak}",
+            )
+        val cellLabel = tp(22f, p.textDim)
+        val cellValue = tp(48f, p.textMain, true)
+        cells.forEachIndexed { i, (label, value) ->
+            val x = PAD + colW * i
+            canvas.drawText(label, x, lineY + 70f, cellLabel)
+            canvas.drawText(value, x, lineY + 134f, cellValue)
+        }
+
+        // ── 底部 ──
+        canvas.drawText(
+            ctx.getString(R.string.dahi_ts_foot, style.days),
+            PAD,
+            HEIGHT - 64f,
+            tp(22f, p.textDim),
+        )
+
+        return bmp
+    }
+}
