+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiRimeFreqImport.kt
@@ -0,0 +1,59 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+/**
+ * 解析「Rime 调频词表」并把顺序写回本机的候选排序。
+ *
+ * 文件格式（与本应用导出的 txt 一致，也是 Rime 用户词典的导入格式）：
+ *
+ *     词 <TAB> 编码 <TAB> 权重
+ *
+ * `#` 开头是注释；权重缺失按 0 处理。同一编码内按权重从大到小排列
+ * （权重相同时保持文件里的先后），这样「导回手机」得到的顺序与电脑端一致。
+ *
+ * 注意：这里只解析，不写盘 —— 写入由 [DahiCandidateOrder.importOrders] 负责，
+ * 便于调用方先弹确认框（合并 / 覆盖）再落盘。
+ */
+object DahiRimeFreqImport {
+    /** 解析结果。[lines] = 有效行数，[skipped] = 格式不对被跳过的行数。 */
+    data class Parsed(
+        val orders: Map<String, List<String>>,
+        val lines: Int,
+        val skipped: Int,
+    )
+
+    fun parse(text: String): Parsed {
+        val grouped = linkedMapOf<String, MutableList<Pair<String, Double>>>()
+        var lines = 0
+        var skipped = 0
+        text.lineSequence().forEach { raw ->
+            val line = raw.trimEnd('\r')
+            if (line.isBlank() || line.startsWith("#")) return@forEach
+            val parts = line.split('\t')
+            if (parts.size < 2) {
+                skipped++
+                return@forEach
+            }
+            val word = parts[0].trim()
+            val code = parts[1].trim()
+            if (word.isEmpty() || code.isEmpty()) {
+                skipped++
+                return@forEach
+            }
+            val weight = parts.getOrNull(2)?.trim()?.toDoubleOrNull() ?: 0.0
+            grouped.getOrPut(code) { mutableListOf() }.add(word to weight)
+            lines++
+        }
+        val orders = linkedMapOf<String, List<String>>()
+        grouped.forEach { (code, list) ->
+            // sortedByDescending 是稳定排序：权重相同时保持文件里的先后
+            orders[code] = list.sortedByDescending { it.second }.map { it.first }
+        }
+        return Parsed(orders, lines, skipped)
+    }
+}
