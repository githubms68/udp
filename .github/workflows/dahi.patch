+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.clipboard
+
+import android.content.Context
+import android.view.View
+import android.widget.PopupMenu
+import com.osfans.trime.R
+
+/**
+ * 「设置分类」快速选择菜单。
+ *
+ * **为什么不用 AlertDialog**：剪贴板窗口本身是输入法自己的窗口，此时用输入法服务（Service）
+ * 的 Context 去 `AlertDialog.Builder(...).show()` 拿不到可用的 window token，
+ * 会抛 `WindowManager$BadTokenException: token null is not valid`，表现为「点一次崩一次」。
+ * 这里改成 [PopupMenu]，锚定在长按的那一行条目上 —— 条目本身就在一个已附加到窗口的视图里，
+ * 因此不需要额外的 token，也就不会崩。
+ *
+ * 「新建分类」需要输入文字：交给键盘上方的单行输入浮层（[DahiPhrasePromptOverlay]）处理，
+ * 复用剪贴板搜索浮层那条已经被验证可用的「键盘 → 浮层」文本通路。
+ */
+internal object ClipboardCategoryPrompt {
+    fun show(
+        ctx: Context,
+        anchor: View,
+        categories: List<String>,
+        onPick: (String?) -> Unit,
+        onNew: () -> Unit,
+    ) {
+        val popup = PopupMenu(ctx, anchor)
+        val menu = popup.menu
+        menu.add(R.string.dahi_cp_category_none).setOnMenuItemClickListener {
+            onPick(null)
+            true
+        }
+        // 过滤掉内部伪分类键（全部 / 未分类由「不分类」一项代表），否则会显示成 all / uncategorized
+        categories.filterNot { it.startsWith("\u0000") }.forEach { name ->
+            menu.add(name).setOnMenuItemClickListener {
+                onPick(name)
+                true
+            }
+        }
+        menu.add(R.string.dahi_cp_category_new).setOnMenuItemClickListener {
+            onNew()
+            true
+        }
+        popup.show()
+    }
+}
