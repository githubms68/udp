+                    )
+                "window" -> getString(R.string.dahi_backup_remind_state_window, hours)
+                else -> getString(R.string.dahi_backup_remind_state_due)
+            }
+        statusView?.text =
+            getString(
+                R.string.dahi_backup_remind_status,
+                lastText,
+                DahiBackupReminder.daysSinceLastBackup(),
+                hours,
+                state,
+            )
+    }
+
+    private fun save() {
+        DahiBackupReminder.setEnabled(enabledCheck?.isChecked == true)
+        daysInput?.text?.toString()?.toIntOrNull()?.let { DahiBackupReminder.setDays(it) }
+        val start = startInput?.text?.toString()?.toIntOrNull()?.coerceIn(0, 23) ?: DahiBackupReminder.startHour()
+        val end = endInput?.text?.toString()?.toIntOrNull()?.coerceIn(0, 23) ?: DahiBackupReminder.endHour()
+        DahiBackupReminder.setWindow(start, end)
+        refresh()
+        toast(getString(R.string.dahi_slogan_saved))
+    }
+
+    private fun toast(text: String) {
+        if (isAdded) Toast.makeText(requireContext(), text, Toast.LENGTH_SHORT).show()
+    }
+}
