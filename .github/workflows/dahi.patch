+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.appcompat.app.AlertDialog
+import androidx.fragment.app.Fragment
+import androidx.lifecycle.lifecycleScope
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiCandidateOrder
+import com.osfans.trime.ime.custom.DahiCustomPhrase
+import com.osfans.trime.ime.custom.DahiPhraseImport
+import com.osfans.trime.ime.custom.DahiRimeFreqExport
+import com.osfans.trime.ime.custom.DahiRimeFreqImport
+import com.osfans.trime.util.toast
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.launch
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+
+/**
+ * 「候选排序 / 自定义短语管理」设置页（大海版）。
+ *
+ * 这两类记录此前**只能在校验时一条条重置**，没有任何总览入口。本页提供：
+ * - 候选排序：列出被手动调整过的全部输入码（含词数），可单条删除或整体清空；
+ * - 自定义短语：列出全部「代码 → 正文」，可单条删除或整体清空。
+ */
+class DahiManageFragment : Fragment() {
+    private var query: String = ""
+
+    private var orderContainer: LinearLayout? = null
+    private var phraseContainer: LinearLayout? = null
+    private var orderEmpty: TextView? = null
+    private var phraseEmpty: TextView? = null
+
+    /** 待写入的调频词表内容（等用户选好保存位置）。 */
+    private var pendingFreqText: String? = null
+
+    /** 批量选择模式（短语行前面出现复选框）。 */
+    private var selecting = false
+
+    /** 已勾选的短语编码。 */
+    private val selected = linkedSetOf<String>()
+
+    /** 候选顺序段的批量选择状态（与短语段互不影响）。 */
+    private var orderSelecting = false
+
+    private val selectedOrders = linkedSetOf<String>()
+
+    /** 从文件导入短语（UTF-8 文本，格式与粘贴导入一致）。 */
+    private val importFileLauncher =
+        registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+            if (uri == null) return@registerForActivityResult
+            val text =
+                runCatching {
+                    requireContext().contentResolver.openInputStream(uri)?.use {
+                        it.readBytes().toString(Charsets.UTF_8)
+                    }
+                }.getOrNull()
+            if (text.isNullOrBlank()) {
+                Toast.makeText(requireContext(), R.string.dahi_phrase_import_file_failed, Toast.LENGTH_SHORT).show()
+                return@registerForActivityResult
+            }
+            val lines = text.count { it == '\n' } + 1
+            AlertDialog
+                .Builder(requireContext())
+                .setTitle(R.string.dahi_phrase_import)
+                .setMessage(getString(R.string.dahi_phrase_import_file_confirm, lines))
+                .setPositiveButton(R.string.dahi_phrase_import_merge) { _, _ -> doImport(text, false) }
+                .setNegativeButton(R.string.dahi_phrase_import_overwrite) { _, _ -> doImport(text, true) }
+                .show()
+        }
+
+    private val freqLauncher =
+        registerForActivityResult(ActivityResultContracts.CreateDocument("text/plain")) { uri ->
+            val text = pendingFreqText
+            pendingFreqText = null
+            if (uri == null || text == null) return@registerForActivityResult
+            runCatching {
+                requireContext().contentResolver.openOutputStream(uri)?.use { out ->
+                    out.write(text.toByteArray(Charsets.UTF_8))
+                } ?: error("no stream")
+            }.onSuccess {
+                Toast.makeText(requireContext(), R.string.dahi_rime_freq_saved, Toast.LENGTH_LONG).show()
+            }.onFailure {
+                Toast.makeText(requireContext(), R.string.dahi_rime_freq_failed, Toast.LENGTH_SHORT).show()
+            }
+        }
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(4), ctx.dp(16), ctx.dp(24))
+            }
+
+        val search =
+            android.widget.EditText(ctx).apply {
+                hint = getString(R.string.dahi_manage_search_hint)
+                setSingleLine()
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+                addTextChangedListener(
+                    object : android.text.TextWatcher {
+                        override fun beforeTextChanged(
+                            s: CharSequence?,
+                            start: Int,
+                            count: Int,
+                            after: Int,
+                        ) = Unit
+
+                        override fun onTextChanged(
+                            s: CharSequence?,
+                            start: Int,
+                            before: Int,
+                            count: Int,
+                        ) = Unit
+
+                        override fun afterTextChanged(s: android.text.Editable?) {
+                            query = s?.toString().orEmpty()
+                            reload()
+                        }
+                    },
+                )
+            }
+
+        // ---------- 自定义短语（放在前面） ----------
+        column.addView(
+            sectionHeader(R.string.dahi_manage_phrase_section) { confirmClearPhrase() },
+        )
+        phraseEmpty = emptyTip(R.string.dahi_manage_empty_phrase)
+        column.addView(phraseEmpty)
+        phraseContainer = LinearLayout(ctx).apply { orientation = LinearLayout.VERTICAL }
+        column.addView(phraseContainer)
+
+        // ---------- 候选词自定义顺序 ----------
+        val orderHeader = sectionHeader(R.string.dahi_manage_order_section) { confirmClearOrder() }
+        orderHeaderRef = orderHeader
+        column.addView(orderHeader)
+        orderEmpty = emptyTip(R.string.dahi_manage_empty_order)
+        column.addView(orderEmpty)
+        orderContainer = LinearLayout(ctx).apply { orientation = LinearLayout.VERTICAL }
+        column.addView(orderContainer)
+
+        // 搜索框固定在顶部：条目攒到几百条时，往下一滚就再也够不到它了
+        // 「回到顶部」：放在搜索框右侧（固定不滚动）。
+        // 不用悬浮球 —— 页面右侧是条目上的删除/编辑按钮，悬浮球一定会挡住它们；
+        // 这里贴着搜索框，任何时候都看得见，也不会挡任何东西。
+        val backToTop =
+            TextView(ctx).apply {
+                setText("↑")
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 18f)
+                setTextColor(dahiAccent())
+                gravity = Gravity.CENTER
+                contentDescription = getString(R.string.dahi_manage_back_to_top)
+                background =
+                    android.graphics.drawable.GradientDrawable().apply {
+                        cornerRadius = ctx.dp(18).toFloat()
+                        setColor(0x1F3B82F6)
+                    }
+                layoutParams = LinearLayout.LayoutParams(ctx.dp(36), ctx.dp(36)).apply {
+                    leftMargin = ctx.dp(8)
+                }
+                setOnClickListener { pageScroll?.smoothScrollTo(0, 0) }
+            }
+        val searchBar =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(2))
+                addView(
+                    LinearLayout(ctx).apply {
+                        orientation = LinearLayout.HORIZONTAL
+                        gravity = Gravity.CENTER_VERTICAL
+                        addView(
+                            search,
+                            LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f),
+                        )
+                        addView(backToTop)
+                    },
+                )
+            }
+        // 快捷操作行（两行）：
+        //   第一行：导出短语 / 导出 Rime 调频表 —— 横向可滑，字号放大也不会被挤掉；
+        //   第二行：跳到「候选词自定义顺序」。
+        // 「导入」不放这里：下面那排已经有「粘贴导入 / 文件导入」，重复没有意义。
+        val quickRow =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), 0, ctx.dp(16), ctx.dp(8))
+                addView(
+                    android.widget.HorizontalScrollView(ctx).apply {
+                        isHorizontalScrollBarEnabled = false
+                        addView(
+                            LinearLayout(ctx).apply {
+                                orientation = LinearLayout.HORIZONTAL
+                                addView(chip(R.string.dahi_phrase_export) { exportPhrases() })
+                                addView(chip(R.string.dahi_freq_export_chip) { exportRimeFreq() })
+                                addView(chip(R.string.dahi_freq_import_chip) { freqImportLauncher.launch(arrayOf("text/plain", "*/*")) })
+                            },
+                        )
+                    },
+                )
+                addView(
+                    LinearLayout(ctx).apply {
+                        orientation = LinearLayout.HORIZONTAL
+                        setPadding(0, ctx.dp(6), 0, 0)
+                        addView(chip(R.string.dahi_manage_jump_order) { jumpToOrderSection() })
+                    },
+                )
+            }
+        return LinearLayout(ctx).apply {
+            orientation = LinearLayout.VERTICAL
+            addView(searchBar)
+            addView(quickRow)
+            addView(
+                ScrollView(ctx).apply {
+                    // 占据剩余高度，否则长列表会被裁掉
+                    layoutParams =
+                        LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f)
+                    addView(column)
+                    pageScroll = this
+                },
+            )
+        }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        reload()
+    }
+
+    /** 深/浅色模式都看得清的主题色（不要再用硬编码灰，深色下会看不清）。 */
+    private fun dahiAccent(): Int = requireContext().styledColor(android.R.attr.colorAccent)
+
+    private fun dahiText2(): Int = requireContext().styledColor(android.R.attr.textColorSecondary)
+
+    /** 长页面的滚动锚点（跳到「候选词自定义顺序」那块）。 */
+    private var pageScroll: ScrollView? = null
+
+    private var orderHeaderRef: View? = null
+
+    /** 顶部快捷行里的小按钮。 */
+    private fun chip(
+        @androidx.annotation.StringRes label: Int,
+        onTap: () -> Unit,
+    ): TextView {
+        val ctx = requireContext()
+        return TextView(ctx).apply {
+            setText(label)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+            setTextColor(dahiAccent())
+            setPadding(ctx.dp(12), ctx.dp(6), ctx.dp(12), ctx.dp(6))
+            background =
+                android.graphics.drawable.GradientDrawable().apply {
+                    cornerRadius = ctx.dp(14).toFloat()
+                    setColor(0x1F3B82F6)
+                }
+            layoutParams = LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT,
+            ).apply { rightMargin = ctx.dp(8) }
+            setOnClickListener { onTap() }
+        }
+    }
+
+    /** 一键滚到「候选词自定义顺序」。 */
+    private fun jumpToOrderSection() {
+        val v = orderHeaderRef ?: return
+        val sv = pageScroll ?: return
+        sv.post {
+            runCatching { sv.smoothScrollTo(0, v.top) }
+        }
+    }
+
+    /** 导出全部自定义短语为 txt（每行 `编码,正文`，可直接再导入）。 */
+    private fun exportPhrases() {
+        val ctx = requireContext()
+        val list = runCatching { com.osfans.trime.ime.custom.DahiCustomPhrase.entries() }.getOrDefault(emptyList())
+        if (list.isEmpty()) {
+            android.widget.Toast
+                .makeText(ctx, R.string.dahi_phrase_export_empty, android.widget.Toast.LENGTH_SHORT)
+                .show()
+            return
+        }
+        pendingPhraseText = list.joinToString("\n") { (code, body) -> "$code,$body" }
+        pendingPhraseCount = list.size
+        val stamp =
+            java.text.SimpleDateFormat("yyyyMMdd-HHmm", java.util.Locale.US).format(java.util.Date())
+        runCatching { exportPhraseLauncher.launch("dahi-phrases-$stamp.txt") }
+            .onFailure { pendingPhraseText = null }
+    }
+
+    /** 待写入的短语文本（SAF 选完位置后写盘）。 */
+    private var pendingPhraseText: String? = null
+
+    /** 待写入的短语条数（导出完成后提示用）。 */
+    private var pendingPhraseCount: Int = 0
+
+    /** 导出短语：走「另存为」，落成 txt 而不是分享一段文本。 */
+    private val exportPhraseLauncher =
+        registerForActivityResult(
+            androidx.activity.result.contract.ActivityResultContracts.CreateDocument("text/plain"),
+        ) { uri ->
+            val text = pendingPhraseText
+            val count = pendingPhraseCount
+            pendingPhraseText = null
+            if (uri == null || text == null) return@registerForActivityResult
+            viewLifecycleOwner.lifecycleScope.launch {
+                val ok =
+                    withContext(Dispatchers.IO) {
+                        runCatching {
+                            requireContext().contentResolver.openOutputStream(uri)?.use {
+                                it.write(text.toByteArray(Charsets.UTF_8))
+                            } ?: error("no output stream")
+                        }.isSuccess
+                    }
+                android.widget.Toast
+                    .makeText(
+                        requireContext(),
+                        if (ok) {
+                            getString(R.string.dahi_phrase_export_done_n, count)
+                        } else {
+                            getString(R.string.dahi_backup_failure)
+                        },
+                        android.widget.Toast.LENGTH_SHORT,
+                    ).show()
+            }
+        }
+
+    private fun sectionHeader(
+        titleRes: Int,
+        extraLabel: Int? = null,
+        onExtra: (() -> Unit)? = null,
+        onClear: () -> Unit,
+    ): LinearLayout {
+        val ctx = requireContext()
+        return LinearLayout(ctx).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(0, ctx.dp(10), 0, ctx.dp(4))
+            addView(
+                TextView(ctx).apply {
+                    setText(titleRes)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+                    setTypeface(typeface, android.graphics.Typeface.BOLD)
+                    layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+                },
+            )
+            if (extraLabel != null && onExtra != null) {
+                addView(
+                    Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                        setText(extraLabel)
+                        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                        minWidth = 0
+                        minimumWidth = 0
+                        setPadding(dp(6), 0, dp(6), 0)
+                        setOnClickListener { onExtra() }
+                    },
+                )
+            }
+            addView(
+                Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                    setText(R.string.dahi_manage_clear_all)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                    minWidth = 0
+                    minimumWidth = 0
+                    setPadding(dp(6), 0, dp(6), 0)
+                    setOnClickListener { onClear() }
+                },
+            )
+        }
+    }
+
+    /** 导入 Rime 调频词表：解析后写进本机的候选排序表（不碰 Rime 词典）。 */
+    private val freqImportLauncher =
+        registerForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+            if (uri == null) return@registerForActivityResult
+            val text =
+                runCatching {
+                    requireContext().contentResolver.openInputStream(uri)?.use {
+                        it.readBytes().toString(Charsets.UTF_8)
+                    }
+                }.getOrNull()
+            if (text.isNullOrBlank()) {
+                Toast.makeText(requireContext(), R.string.dahi_freq_import_failed, Toast.LENGTH_SHORT).show()
+                return@registerForActivityResult
+            }
+            val parsed = DahiRimeFreqImport.parse(text)
+            if (parsed.orders.isEmpty()) {
+                Toast.makeText(requireContext(), R.string.dahi_freq_import_empty, Toast.LENGTH_LONG).show()
+                return@registerForActivityResult
+            }
+            AlertDialog
+                .Builder(requireContext())
+                .setTitle(R.string.dahi_freq_import_title)
+                .setMessage(getString(R.string.dahi_freq_import_confirm, parsed.lines))
+                .setPositiveButton(R.string.dahi_freq_import_merge) { _, _ -> applyFreqImport(parsed, true) }
+                .setNegativeButton(R.string.dahi_freq_import_overwrite) { _, _ -> applyFreqImport(parsed, false) }
