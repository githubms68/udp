+    /**
+     * 一句话小结：本周多少字、比上周多还是少。
+     *
+     * 有对比才有感觉 —— 单看「本周 8420 字」是个孤零零的数字。
+     * 周从周一开始算（中文习惯），上周取完整的上一周。
+     */
+    private fun refreshWeekLine() {
+        val view = weekLineView ?: return
+        val ctx = requireContext()
+        // 注意：这里**不能**因为「每日历史为空」就整行隐藏 ——
+        // 本周字数取自引擎的本周桶，与历史无关；第一天历史还是空的时候，
+        // 这一行照样应该显示「本周 566 字」。
+        val days = runCatching { DahiDailyHistory.recent(ctx, 15) }.getOrDefault(emptyList())
+        val monday = java.time.LocalDate.now().with(java.time.DayOfWeek.MONDAY)
+        // 本周直接取引擎的「本周桶」—— 它从装上就一直在累加，
+        // 不像每日历史要从本版才开始记，所以第一天打开就有数字。
+        val thisWeek =
+            runCatching { DahiInputStats.snapshot(DahiInputStats.Period.WEEK).chars }.getOrDefault(0L)
+        // 上周只能靠每日历史（今天之前没有按日数据时，这里就是 0，于是不显示对比）
+        var lastWeek = 0L
+        days.forEach { d ->
+            val date = runCatching { java.time.LocalDate.parse(d.date) }.getOrNull() ?: return@forEach
+            if (date.isBefore(monday) && !date.isBefore(monday.minusWeeks(1))) lastWeek += d.chars
+        }
+        if (thisWeek <= 0L && lastWeek <= 0L) {
+            view.visibility = View.GONE
+            return
+        }
+        view.visibility = View.VISIBLE
+        val num = java.text.DecimalFormat("###,###").format(thisWeek)
+        view.text =
+            if (lastWeek <= 0L) {
+                getString(R.string.dahi_stats_week_line, num)
+            } else {
+                val pct = ((thisWeek - lastWeek) * 100.0 / lastWeek).toInt()
+                val delta =
+                    when {
+                        pct > 0 -> "+$pct%"
+                        pct < 0 -> "$pct%"
+                        else -> getString(R.string.dahi_stats_week_flat)
+                    }
+                getString(R.string.dahi_stats_week_delta, num, delta)
+            }
+    }
