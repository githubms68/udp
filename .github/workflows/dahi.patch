+
+/**
+ * 识别历史。
+ *
+ * 结构照「说点啥」那套：搜索框 + 筛选 + 全选，列表按今天 / 昨天 / 近一周 / 更早分组，
+ * 每条是「时间 + 复制 + 文本 + 元信息」，点击看详情（含耗时分解），长按进入多选。
+ *
+ * 数据在独立的 asr.db 里：外部联动在 AsrkbSpeechClient 的 onFinal 写入，
+ * 内置引擎以后在自己那边写入。
+ */
+class AsrHistoryFragment : Fragment() {
+    private lateinit var searchInput: EditText
+    private lateinit var listView: RecyclerView
+    private lateinit var emptyView: TextView
+    private lateinit var selectionBar: LinearLayout
+    private lateinit var selectionText: TextView
+
+    private val adapter = HistoryAdapter()
+
+    private var rows: List<Row> = emptyList()
+    private var query: String = ""
+    private var sourceFilter: String? = null
+    private var selecting = false
+    private val selected = linkedSetOf<Long>()
+
+    private val timeFormat = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.getDefault())
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val root =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(12), ctx.dp(10), ctx.dp(12), 0)
+            }
+
+        val tools =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+            }
+        tools.addView(toolButton(ctx.getString(R.string.dahi_ah_filter)) { showFilterDialog() })
+        tools.addView(toolButton(ctx.getString(R.string.dahi_ah_select_all)) { toggleSelectAll() })
+        tools.addView(toolButton(ctx.getString(R.string.dahi_ah_policy)) { showPolicyDialog() })
+        root.addView(tools)
+
+        searchInput =
+            EditText(ctx).apply {
+                hint = ctx.getString(R.string.dahi_ah_search_hint)
+                textSize = 14f
+                setSingleLine()
+                setPadding(ctx.dp(12), ctx.dp(8), ctx.dp(12), ctx.dp(8))
+                background = rounded(0x14808080, 8f)
+                addTextChangedListener(
+                    object : TextWatcher {
+                        override fun beforeTextChanged(
+                            s: CharSequence?,
+                            start: Int,
+                            count: Int,
+                            after: Int,
+                        ) {}
+
+                        override fun onTextChanged(
+                            s: CharSequence?,
+                            start: Int,
+                            before: Int,
+                            count: Int,
+                        ) {}
+
+                        override fun afterTextChanged(s: Editable?) {
+                            query = s?.toString().orEmpty()
+                            load()
+                        }
+                    },
+                )
+            }
+        root.addView(
+            searchInput,
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+                topMargin = ctx.dp(8)
+            },
+        )
+
+        listView =
+            RecyclerView(ctx).apply {
+                layoutManager = LinearLayoutManager(ctx)
+                adapter = this@AsrHistoryFragment.adapter
+                setPadding(0, ctx.dp(6), 0, ctx.dp(6))
+                clipToPadding = false
+            }
+        root.addView(listView, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f))
+
+        emptyView =
+            TextView(ctx).apply {
+                text = ctx.getString(R.string.dahi_ah_empty)
+                textSize = 13f
+                gravity = Gravity.CENTER
+                visibility = View.GONE
+                setPadding(0, ctx.dp(40), 0, ctx.dp(40))
+            }
+        root.addView(emptyView)
+
+        selectionBar =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                visibility = View.GONE
+                setPadding(0, ctx.dp(6), 0, ctx.dp(10))
+            }
+        selectionText =
+            TextView(ctx).apply {
+                textSize = 13f
+                setPadding(ctx.dp(4), 0, ctx.dp(8), 0)
+            }
+        selectionBar.addView(selectionText, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        selectionBar.addView(toolButton(ctx.getString(R.string.dahi_ah_copy)) { copySelected() })
+        selectionBar.addView(toolButton(ctx.getString(R.string.dahi_ah_delete)) { deleteSelected() })
+        selectionBar.addView(toolButton(ctx.getString(R.string.dahi_ah_cancel)) { exitSelection() })
+        root.addView(selectionBar)
+
+        return root
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        load()
+    }
+
+    override fun onResume() {
+        super.onResume()
+        load()
+    }
+
+    // ---------------- 数据 ----------------
+
+    private fun load() {
+        val ctx = requireContext()
+        viewLifecycleOwner.lifecycleScope.launch {
+            val list = AsrHistoryStore.list(ctx, query)
+            val filtered = if (sourceFilter == null) list else list.filter { it.source == sourceFilter }
+            val built = buildRows(filtered)
+            rows = built
+            // 不在 RecyclerView 计算布局时直接改数据，延后一帧更稳。
+            listView.post {
+                adapter.submit(built)
+                emptyView.visibility = if (built.none { it is Row.Entry }) View.VISIBLE else View.GONE
+                syncSelectionUi()
+            }
+        }
+    }
+
+    private fun buildRows(list: List<AsrHistoryBean>): List<Row> {
+        if (list.isEmpty()) return emptyList()
+        val now = Calendar.getInstance()
+        val out = ArrayList<Row>(list.size + 4)
+        var lastBucket = -1
+        for (bean in list) {
+            val bucket = bucketOf(bean.createdAt, now)
+            if (bucket != lastBucket) {
+                out.add(Row.Header(bucketLabel(bucket)))
+                lastBucket = bucket
+            }
+            out.add(Row.Entry(bean))
+        }
+        return out
+    }
+
+    private fun bucketOf(
+        time: Long,
+        now: Calendar,
+    ): Int {
+        val startToday =
+            (now.clone() as Calendar).apply {
+                set(Calendar.HOUR_OF_DAY, 0)
+                set(Calendar.MINUTE, 0)
+                set(Calendar.SECOND, 0)
+                set(Calendar.MILLISECOND, 0)
+            }.timeInMillis
+        return when {
+            time >= startToday -> BUCKET_TODAY
+            time >= startToday - DAY_MS -> BUCKET_YESTERDAY
+            time >= startToday - 7 * DAY_MS -> BUCKET_WEEK
+            else -> BUCKET_EARLIER
+        }
+    }
+
+    private fun bucketLabel(bucket: Int): String = getString(
+        when (bucket) {
+            BUCKET_TODAY -> R.string.dahi_ah_group_today
+            BUCKET_YESTERDAY -> R.string.dahi_ah_group_yesterday
+            BUCKET_WEEK -> R.string.dahi_ah_group_week
+            else -> R.string.dahi_ah_group_earlier
+        },
+    )
+
+    private fun refresh() {
+        listView.post {
+            runCatching { adapter.notifyDataSetChanged() }
+            syncSelectionUi()
+        }
+    }
+
+    // ---------------- 交互 ----------------
+
+    private fun toggleSelectAll() {
+        val all = rows.filterIsInstance<Row.Entry>().map { it.bean.id }
+        if (all.isEmpty()) return
+        if (selected.size == all.size) {
+            exitSelection()
+            return
+        }
+        selecting = true
+        selected.clear()
+        selected.addAll(all)
+        refresh()
+    }
+
+    private fun exitSelection() {
+        selecting = false
+        selected.clear()
+        refresh()
+    }
+
+    private fun syncSelectionUi() {
+        if (selecting && selected.isNotEmpty()) {
+            selectionBar.visibility = View.VISIBLE
+            selectionText.text = getString(R.string.dahi_ah_selected, selected.size)
+        } else {
+            selectionBar.visibility = View.GONE
+        }
+    }
+
+    private fun toggleSelected(id: Long) {
