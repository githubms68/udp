+                                .setNegativeButton(android.R.string.cancel, null)
+                                .setPositiveButton(android.R.string.ok) { _, _ ->
+                                    DahiHealth.addWhitelist(key)
+                                    Toast.makeText(ctx, R.string.dahi_health_ignore, Toast.LENGTH_SHORT).show()
+                                    scan()
