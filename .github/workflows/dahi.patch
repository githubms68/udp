index 0000000..117bfb3
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiSpeedMeter.kt
@@ -0,0 +1,207 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.os.SystemClock
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * 打字速度表。
+ *
+ * 为什么单独抽出来：速度环画在**预编辑行**里（[DahiSpeedRingView]，主键盘与浮窗候选各有一份），
+ * 潮汐与残影还画在键盘上（[DahiKeyEffectOverlay]），两边都要同一份速度，
+ * 但两边是各自重绘的。做一个进程内单例，谁画谁读，不用互相持有引用。
+ *
+ * ## 口径（r181 起：按「活跃打字时间」算，排除思考停顿）
+ *
+ * 老口径是「最近 6 秒的按键数 ÷ 6 秒」，有两个毛病：
+ *  · 想词的时候手指停了，速度照样往下掉，看着像刀刀在掉速；
+ *  · 段落小结那边用的是「第一次按键到最后一次」的墙钟时间，第一段的组字时间
+ *    要么被漏掉（虚高到几百字/分）、要么分母拉成几十秒（虚低到"每分钟几个字"）。
+ *
+ * 现在统一成：**相邻按键间隔 ≤ [MAX_GAP_MS] 才算「在打字」，把这些间隔加起来 = 活跃时间**。
+ * 停顿不计入分母 —— 这也是打字测速软件的通行做法（"净打字速度"）。
+ *
+ *  · [kpm] 键/分 = (按键数 − 1) × 60000 ÷ 活跃时间
+ *  · [cpm] 字/分 = kpm ÷ 平均码长（最近 8 次上屏的「编码键数 / 字数」）
+ *
+ * 两个数字单位一致，速度环与段落小结不会再互相打脸。
+ */
+object DahiSpeedMeter {
+    /** 统计窗口：只看最近这么久内的按键。 */
+    private const val WINDOW_MS = 6000L
+
+    /** 相邻两次按键间隔超过它，就当成了停顿，不计入活跃时间。 */
+    const val MAX_GAP_MS = 900L
+
+    /**
+     * 活跃时间的最小分母（毫秒）。
+     *
+     * 以前是 400ms：窗口里只有 2~3 个按键时（比如刚打「dy」两个字），分母小得可怜，
+     * 一个 130ms 的快间隔就能算出 450+ 字/分 —— 数字本身没错，但作为"速度"看着离谱。
+     * 抬到 700ms 后，这种 2~3 键的爆发最多显示 ~170 键/分，正常连打（几十键）完全不受影响。
+     */
+    private const val MIN_SPAN_MS = 700L
+
+    /** 会话累计码长的最少样本字数（不足就只用最近几次上屏，避免刚开机就算错）。 */
+    private const val OVERALL_MIN_CHARS = 20
+
+    /** 统计窗口内「至少还有速度」的宽限期：超过它速度环就不再重绘。 */
+    private const val ACTIVE_MS = 4000L
+
+    /** 一次上屏：时间、字数、这一段用掉的编码键数。 */
+    private class Commit(
+        val at: Long,
+        val chars: Int,
+        val keys: Int,
+    )
+
+    private val keyTimes = ArrayDeque<Long>()
+    private val commits = ArrayDeque<Commit>(8)
+
+    /** 会话累计：编码键数与字数，用来算一个稳定的「平均码长」基准。 */
+    private var totalKeys = 0
+    private var totalChars = 0
+
+    /** 速度变化通知（速度环用它重新绘制 —— 否则停手后不再重绘，再打字也不刷新）。 */
+    private val listeners = CopyOnWriteArrayList<() -> Unit>()
+
+    @Volatile
+    var lastKeyAt: Long = 0L
+        private set
+
+    @Volatile
+    var lastCommitAt: Long = 0L
+        private set
+
+    fun addListener(listener: () -> Unit) {
+        listeners.addIfAbsent(listener)
+    }
+
+    fun removeListener(listener: () -> Unit) {
+        listeners.remove(listener)
+    }
+
+    /** 记录一次按键。 */
+    @Synchronized
+    fun record(now: Long = SystemClock.uptimeMillis()) {
+        keyTimes.addLast(now)
+        trim(now)
+        lastKeyAt = now
+        notifyListeners()
+    }
+
+    /**
+     * 记录一次上屏，用于算平均码长（字/分 = 键/分 ÷ 码长）。
+     *
+     * @param keys 这一段输入按下的编码键数。语音 / 剪贴板上屏没有按键，传 0 即可（不参与平均）。
+     */
+    @Synchronized
+    fun recordCommit(
+        now: Long,
+        chars: Int,
+        keys: Int,
+    ) {
+        if (chars <= 0) return
+        lastCommitAt = now
+        if (keys <= 0) return
+        commits.addLast(Commit(now, chars, keys))
+        while (commits.size > 8) commits.removeFirst()
+        totalKeys += keys
+        totalChars += chars
+    }
+
+    /** 最近 6 秒内**真正在打字**的时间（毫秒）：只累加 ≤ [MAX_GAP_MS] 的相邻间隔。 */
+    @Synchronized
+    fun activeSpan(now: Long = SystemClock.uptimeMillis()): Long = activeSpanAndGaps(now).first
+
+    /**
+     * 活跃时间 + 被计入的间隔数。
+     *
+     * 必须成对返回：间隔数决定速度的**分子**。以前分子用「按键数 − 1」，
+     * 而分母只累加 ≤ [MAX_GAP_MS] 的间隔 —— 中间夹一个 2 秒的停顿，分母少算一段、
+     * 分子照旧，速度就会虚高（10 键里有 1 个长停顿，虚高 9/8）。
+     */
+    private fun activeSpanAndGaps(now: Long): Pair<Long, Int> {
+        trim(now)
+        if (keyTimes.size < 2) return 0L to 0
+        var sum = 0L
+        var gaps = 0
+        var prev = -1L
+        for (t in keyTimes) {
+            if (prev >= 0L) {
+                val gap = t - prev
+                if (gap <= MAX_GAP_MS) {
+                    sum += gap
+                    gaps++
+                }
+            }
+            prev = t
+        }
+        return sum to gaps
+    }
+
+    /** 键/分（最近的活跃打字速度）：分子分母都只算「真正在连续打」的那几段。 */
+    @Synchronized
+    fun kpm(now: Long = SystemClock.uptimeMillis()): Int {
+        val (sum, gaps) = activeSpanAndGaps(now)
+        if (gaps <= 0) return 0
+        val span = sum.coerceAtLeast(MIN_SPAN_MS)
+        return (gaps * 60000L / span).toInt().coerceIn(0, 999)
+    }
+
+    /** 字/分（速度环显示这个） */
+    @Synchronized
+    fun cpm(now: Long = SystemClock.uptimeMillis()): Int {
+        val keys = kpm(now)
+        if (keys <= 0) return 0
+        return (keys / averageCodeLength()).toInt().coerceIn(0, 9999)
+    }
+
+    /**
+     * 平均码长：最近几次上屏的「编码键数 / 字数」，没有样本时按双拼的 2 估计。
+     *
+     * 取「最近 8 次」与「会话累计」中的**较大值**：
+     * 最近几次如果刚好都是自定义短语（`dy` → 道义，2 键 2 字，码长 1），
+     * 码长会被压到 1 —— 等于直接把键速当字速，数字瞬间翻倍（这就是「dy 打出 450」的另一半原因）。
+     * 用累计值兜底后，短语再快也不会把码长拉到 1 以下。
+     */
+    @Synchronized
+    fun averageCodeLength(): Float {
+        var chars = 0
+        var keys = 0
+        for (c in commits) {
+            chars += c.chars
+            keys += c.keys
+        }
+        val recent = if (chars > 0) keys.toFloat() / chars else 0f
+        val overall = if (totalChars >= OVERALL_MIN_CHARS) totalKeys.toFloat() / totalChars else 0f
+        val picked = maxOf(recent, overall)
+        return if (picked <= 0f) 2f else picked.coerceIn(1f, 6f)
+    }
+
+    /** 最近几秒还有没有在打字（速度环/潮汐据此决定要不要继续重绘）。 */
+    fun isActive(now: Long = SystemClock.uptimeMillis()): Boolean = now - lastKeyAt < ACTIVE_MS
+
+    @Synchronized
+    fun reset() {
+        keyTimes.clear()
+        commits.clear()
+        totalKeys = 0
+        totalChars = 0
+        lastKeyAt = 0L
+        lastCommitAt = 0L
+    }
+
+    private fun trim(now: Long) {
+        while (keyTimes.isNotEmpty() && now - keyTimes.first() > WINDOW_MS) keyTimes.removeFirst()
+    }
+
+    private fun notifyListeners() {
+        listeners.forEach { runCatching { it() } }
+    }
+}
