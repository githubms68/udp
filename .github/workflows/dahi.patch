+    /** 打字测试判定：宽松比较（大小写、分隔符差异都不算错）。 */
+    private fun checkReview(
+        meta: DahiPhraseStats.Meta,
+        typed: String,
+    ) {
+        val ok =
+            typed.isNotBlank() &&
+                DahiCustomPhrase.loose(typed) == DahiCustomPhrase.loose(meta.code)
+        reviewRight = ok
+        reviewWrong = !ok
+        rebuild()
+    }
+
+    private fun reviewButton(
+        label: Int,
+        level: Int,
+        code: String,
+    ): Button = Button(requireContext()).apply {
+        setText(label)
+        setOnClickListener {
+            DahiPhraseStats.review(code, level)
+            reviewDone++
+            reviewIndex++
+            reviewShown = false
+            reviewRight = false
+            reviewWrong = false
+            reviewInput = ""
+            if (reviewIndex >= reviewList.size) {
+                reviewList = emptyList()
+            }
+            rebuild()
+        }
+    }
