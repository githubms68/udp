+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="dahi_plain_title">Export as plain text (use with care!)</string>
+    <string name="dahi_plain_summary">Export clipboard, collection and phrases as readable text or CSV, for use on other devices</string>
+    <string name="dahi_plain_format">Choose a format</string>
+    <string name="dahi_plain_fmt_txt">TXT — one readable file with sections</string>
+    <string name="dahi_plain_fmt_csv">CSV — for Excel / spreadsheets</string>
+    <string name="dahi_plain_fmt_rime">rime custom_phrase — phrases only, ready for rime</string>
+    <string name="dahi_plain_warning">The exported file is NOT encrypted. Once saved, any app with storage access (file managers, cloud auto-backup, gallery scanners) can read it. Keep it safe and delete it when done.
+
+If you only want to VIEW it on a computer, use “encrypted backup + offline single-file decryptor” instead — the file stays encrypted and decryption happens in your own browser.
+
+Nothing leaves this device until you pick a save location.</string>
+    <string name="dahi_plain_file_warning">This file is PLAIN TEXT — anyone who gets it can read it. Delete it after use.</string>
