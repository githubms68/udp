+package com.osfans.trime.ui.main.settings
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import androidx.appcompat.content.res.AppCompatResources
+import com.osfans.trime.R
+
+/**
+ * 分享图底部的品牌标记（ㄓ + 太极）。
+ *
+ * 统计图、隐私体检图、报告图共用这一份：先栅格化成位图，
+ * 再把太极「阴」那半（古铜）压深一点 —— 否则缩到 50 像素时
+ * 两种金挤在同色系里，看不出阴阳，只剩一个实心圆。
+ */
+object DahiMark {
+    private var cache: Bitmap? = null
+
+    fun load(ctx: Context): Bitmap? {
+        cache?.let { return it }
+        val d =
+            runCatching { AppCompatResources.getDrawable(ctx, R.drawable.dahi_mark) }
+                .getOrNull() ?: return null
+        return runCatching {
+            val px = 128
+            val bmp = Bitmap.createBitmap(px, px, Bitmap.Config.ARGB_8888)
+            d.setBounds(0, 0, px, px)
+            d.draw(Canvas(bmp))
+            for (x in 0 until px) {
+                for (y in 0 until px) {
+                    val c = bmp.getPixel(x, y)
+                    val a = Color.alpha(c)
+                    if (a == 0) continue
+                    val r = Color.red(c)
+                    val g = Color.green(c)
+                    if (r in 0x50..0xA0 && g in 0x40..0x80) {
+                        bmp.setPixel(
+                            x,
+                            y,
+                            Color.argb(a, r * 42 / 100, g * 40 / 100, Color.blue(c) * 36 / 100),
+                        )
+                    }
+                }
+            }
+            cache = bmp
+            bmp
+        }.getOrNull()
+    }
+}
