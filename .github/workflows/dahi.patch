+    private fun refreshDaily() {
+        val ctx = requireContext()
+        val view = dailyView ?: return
+        val items: List<DahiDailyTrendView.Item>
+        if (dailyRange == 0) {
+            // 按月：一个自然月一根柱，十年也只有 120 根
+            monthCache = runCatching { DahiDailyHistory.monthly(ctx) }.getOrDefault(emptyList())
+            dayCache = emptyList()
+            items =
+                monthCache.map { m ->
+                    val late = DahiDailyHistory.isLateNightBucket(m.peakHour, m.lateChars, m.chars)
+                    val monthLabel = runCatching { getString(R.string.dahi_stats_month_unit, m.month.substring(5)) }.getOrDefault(m.month)
+                    DahiDailyTrendView.Item(label = monthLabel, chars = m.chars, late = late)
+                }
+        } else {
+            dayCache = runCatching { DahiDailyHistory.recent(ctx, dailyRange) }.getOrDefault(emptyList())
+            monthCache = emptyList()
+            items =
+                dayCache.map { d ->
+                    val (weekend, late) = DahiDailyTrendView.flagsOf(d.date, d.peakHour, d.hours, d.chars)
+                    DahiDailyTrendView.Item(
+                        label = d.date.takeLast(5),
+                        chars = d.chars,
+                        late = late,
+                        weekend = weekend,
+                    )
+                }
+        }
+        view.setAccent(runCatching { ctx.styledColor(android.R.attr.colorAccent) }.getOrDefault(dahiText2()))
+        view.setLabelColor(dahiText2())
+        view.submit(items)
+        dailyTip?.visibility = if (items.isEmpty()) View.GONE else View.VISIBLE
+    }
