+     * 位置记忆（r183 起）：按「可用位移的百分比」存（0~1）。
+     *
+     * 为什么不用像素：像素位置绑死当时的分辨率与键盘尺寸，换设备、转屏、改缩放比例之后
+     * 就会跑到屏幕外或半截露在边上。百分比是相对「横向可移动范围 / 纵向可移动范围」的，
+     * 这些条件一变，换算出来的位置依然落在同一个相对位置。
+     */
+    private const val KEY_X_RATIO = "x_ratio"
+    private const val KEY_Y_RATIO = "y_ratio"
+
+    private const val LEGACY_KEY_ENABLED = "enabled"
+    private const val LEGACY_KEY_SCALE = "scale"
+
+    const val KEY_ENABLED = "floating_keyboard_enabled"
+    const val KEY_SCALE = "floating_keyboard_scale"
+
+    /** 「记住悬浮键盘位置」开关（默认开）。与缩放一样放在默认偏好里，随备份一起导出。 */
+    const val KEY_REMEMBER_POSITION = "floating_keyboard_remember_position"
+
+    /** 分轴缩放（拖动右下角比例把手得到）；横屏单独记录，避免竖屏调好的比例影响横屏。 */
+    const val KEY_SCALE_X = "floating_keyboard_scale_x"
+    const val KEY_SCALE_Y = "floating_keyboard_scale_y"
+    const val KEY_SCALE_X_LAND = "floating_keyboard_scale_x_land"
+    const val KEY_SCALE_Y_LAND = "floating_keyboard_scale_y_land"
+
+    const val DEFAULT_SCALE_PERCENT = 90
+    const val MIN_SCALE_PERCENT = 50
+    const val MAX_SCALE_PERCENT = 100
+
+    const val DEFAULT_SCALE = DEFAULT_SCALE_PERCENT / 100f
+    val MIN_SCALE = MIN_SCALE_PERCENT / 100f
+    val MAX_SCALE = MAX_SCALE_PERCENT / 100f
+
+    const val SCALE_STEP = 0.1f
+
+    private val prefs: SharedPreferences by lazy {
+        appContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+    }
+
+    private val uiPrefs: SharedPreferences by lazy {
+        PreferenceManager.getDefaultSharedPreferences(appContext).also { migrateLegacyState(it) }
+    }
+
+    /** 旧版本把开关/缩放放在独立文件里，这里做一次性迁移，避免升级后丢失原有状态。 */
+    private fun migrateLegacyState(target: SharedPreferences) {
+        if (!prefs.contains(LEGACY_KEY_ENABLED)) return
+        if (target.contains(KEY_ENABLED)) return
+        target.edit {
+            putBoolean(KEY_ENABLED, prefs.getBoolean(LEGACY_KEY_ENABLED, false))
+            if (prefs.contains(LEGACY_KEY_SCALE)) {
+                putInt(KEY_SCALE, (prefs.getFloat(LEGACY_KEY_SCALE, DEFAULT_SCALE) * 100f).roundToInt())
+            }
+        }
+    }
+
+    fun isEnabled(): Boolean = uiPrefs.getBoolean(KEY_ENABLED, false)
+
+    fun setEnabled(value: Boolean) {
+        uiPrefs.edit { putBoolean(KEY_ENABLED, value) }
+    }
+
+    fun toggle() {
+        setEnabled(!isEnabled())
+    }
+
+    /** 缩放比例（百分数，50–100）。 */
+    fun getScalePercent(): Int = uiPrefs.getInt(KEY_SCALE, DEFAULT_SCALE_PERCENT).coerceIn(MIN_SCALE_PERCENT, MAX_SCALE_PERCENT)
+
+    fun setScalePercent(value: Int) {
+        uiPrefs.edit { putInt(KEY_SCALE, value.coerceIn(MIN_SCALE_PERCENT, MAX_SCALE_PERCENT)) }
+    }
+
+    fun getScale(): Float = getScalePercent() / 100f
+
+    fun setScale(value: Float) {
+        setScalePercent((value * 100f).roundToInt())
+    }
+
+    private fun axisKeys(landscape: Boolean): Pair<String, String> = if (landscape) KEY_SCALE_X_LAND to KEY_SCALE_Y_LAND else KEY_SCALE_X to KEY_SCALE_Y
+
+    /** 是否已单独调过横/纵比例（未调过时跟随等比滑块）。 */
+    fun hasCustomAxisScale(landscape: Boolean): Boolean = axisKeys(landscape).let { (kx, ky) -> uiPrefs.contains(kx) && uiPrefs.contains(ky) }
+
+    /** 当前生效的横向/纵向缩放；未自定义时都取等比滑块的值。 */
+    fun getScaleX(landscape: Boolean): Float = getAxisPercent(landscape, 0)
+    fun getScaleY(landscape: Boolean): Float = getAxisPercent(landscape, 1)
+
+    private fun getAxisPercent(landscape: Boolean, index: Int): Float {
+        val key = axisKeys(landscape).let { if (index == 0) it.first else it.second }
+        val fallback = getScalePercent()
+        return uiPrefs.getInt(key, fallback).coerceIn(MIN_AXIS_SCALE_PERCENT, MAX_SCALE_PERCENT) / 100f
+    }
+
+    /** 记录某个方向下的横/纵缩放（拖动比例把手时调用）。 */
+    fun setAxisScale(
+        landscape: Boolean,
+        xPercent: Int,
+        yPercent: Int,
+    ) {
+        val (kx, ky) = axisKeys(landscape)
+        uiPrefs.edit {
+            putInt(kx, xPercent.coerceIn(MIN_AXIS_SCALE_PERCENT, 100))
+            putInt(ky, yPercent.coerceIn(MIN_AXIS_SCALE_PERCENT, 100))
+        }
+    }
+
+    /** 清除自定义比例，恢复跟随等比滑块。 */
+    fun clearAxisScale(landscape: Boolean) {
+        val (kx, ky) = axisKeys(landscape)
+        if (!uiPrefs.contains(kx) && !uiPrefs.contains(ky)) return
+        uiPrefs.edit {
+            remove(kx)
+            remove(ky)
+        }
+    }
+
+    /** 自定义时的最小百分比（等比滑块的最小值是 [MIN_SCALE_PERCENT]）。 */
+    const val MIN_AXIS_SCALE_PERCENT = 30
+
+    fun getX(): Float = prefs.getFloat(KEY_X, 0f)
+
+    fun getY(): Float = prefs.getFloat(KEY_Y, 0f)
+
+    fun setPosition(
+        x: Float,
+        y: Float,
+    ) {
+        prefs.edit {
+            putFloat(KEY_X, x)
+            putFloat(KEY_Y, y)
+        }
+    }
+
+    /** 是否记住悬浮位置（默认开）。 */
+    fun isRememberPosition(): Boolean = runCatching { uiPrefs.getBoolean(KEY_REMEMBER_POSITION, true) }.getOrDefault(true)
+
+    /** 存「可用位移的百分比」位置：xRatio / yRatio ∈ [0, 1]。 */
+    fun setPositionRatio(
+        xRatio: Float,
+        yRatio: Float,
+    ) {
+        prefs.edit {
+            putFloat(KEY_X_RATIO, xRatio.coerceIn(0f, 1f))
+            putFloat(KEY_Y_RATIO, yRatio.coerceIn(0f, 1f))
+        }
+    }
+
+    /** 取百分比位置；null = 还没记过（第一次悬浮，用默认停靠位置）。 */
+    fun getXRatio(): Float? = prefs.getFloat(KEY_X_RATIO, -1f).takeIf { it in 0f..1f }
+
+    fun getYRatio(): Float? = prefs.getFloat(KEY_Y_RATIO, -1f).takeIf { it in 0f..1f }
+
+    fun registerListener(listener: SharedPreferences.OnSharedPreferenceChangeListener) {
+        uiPrefs.registerOnSharedPreferenceChangeListener(listener)
+    }
+
+    fun unregisterListener(listener: SharedPreferences.OnSharedPreferenceChangeListener) {
+        uiPrefs.unregisterOnSharedPreferenceChangeListener(listener)
+    }
+}
