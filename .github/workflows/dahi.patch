+/*
+ * SPDX-FileCopyrightText: 2026 Dahi
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.db.asr
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.Query
+
+@Dao
+interface AsrHistoryDao {
+    @Insert
+    suspend fun insert(bean: AsrHistoryBean): Long
+
+    @Query("SELECT * FROM ${AsrHistoryBean.TABLE_NAME} ORDER BY createdAt DESC LIMIT :limit")
+    suspend fun recent(limit: Int): List<AsrHistoryBean>
+
+    @Query(
+        "SELECT * FROM ${AsrHistoryBean.TABLE_NAME} WHERE text LIKE '%' || :q || '%' " +
+            "ORDER BY createdAt DESC LIMIT :limit",
+    )
+    suspend fun search(
+        q: String,
+        limit: Int,
+    ): List<AsrHistoryBean>
+
+    @Query("SELECT * FROM ${AsrHistoryBean.TABLE_NAME} WHERE id = :id")
+    suspend fun find(id: Long): AsrHistoryBean?
+
+    @Query("DELETE FROM ${AsrHistoryBean.TABLE_NAME} WHERE id IN (:ids)")
+    suspend fun deleteByIds(ids: List<Long>)
+
+    @Query("DELETE FROM ${AsrHistoryBean.TABLE_NAME}")
+    suspend fun clear()
+
+    @Query("DELETE FROM ${AsrHistoryBean.TABLE_NAME} WHERE createdAt < :before")
+    suspend fun deleteOlderThan(before: Long): Int
+
+    @Query(
+        "DELETE FROM ${AsrHistoryBean.TABLE_NAME} WHERE id NOT IN " +
+            "(SELECT id FROM ${AsrHistoryBean.TABLE_NAME} ORDER BY createdAt DESC LIMIT :keep)",
+    )
+    suspend fun trimToCount(keep: Int): Int
+
+    @Query("SELECT COUNT(*) FROM ${AsrHistoryBean.TABLE_NAME}")
+    suspend fun count(): Int
+
+    @Query("SELECT * FROM ${AsrHistoryBean.TABLE_NAME} ORDER BY createdAt DESC")
+    suspend fun all(): List<AsrHistoryBean>
+}
