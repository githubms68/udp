+    /** 「逐字输入」次数来自 [DahiPhraseSuggest]（近 90 天，且只算没用短语打出来的）。 */
+    private fun manualCount(text: String): Int = DahiPhraseSuggest.count90(text)
+
+    private fun ageText(ts: Long): String {
+        if (ts <= 0) return "—"
+        val days = (System.currentTimeMillis() - ts) / (24L * 60 * 60 * 1000)
+        val ctx = requireContext()
+        return when {
+            days <= 0 -> ctx.getString(R.string.dahi_phrase_age_today)
+            days < 30 -> ctx.getString(R.string.dahi_phrase_age_day, days.toInt())
+            else -> ctx.getString(R.string.dahi_phrase_age_month, (days / 30).toInt())
+        }
+    }
