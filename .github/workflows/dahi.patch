+    private fun sample(
+        ctx: Context,
+        period: DahiInputStats.Period,
+        detailed: Boolean,
+        showHeat: Boolean,
+        showSchemas: Boolean,
+        showAdvice: Boolean,
+        showVoice: Boolean,
+        showHours: Boolean,
+        showCloud: Boolean,
+        showDaily: Boolean,
+        showSpeed: Boolean,
+        showCandidate: Boolean,
+        showDistribution: Boolean,
+        showChips: Boolean,
+    ): Model {
+        val bucket = DahiInputStats.snapshot(period)
+        // 词云里被隐藏的词，分享图也不显示；snapshot 返回的是副本，改它不影响统计
+        runCatching { bucket.wordFreq.keys.removeAll(DahiWordHidden.load(ctx)) }
+        val career = DahiInputStats.snapshot(DahiInputStats.Period.CAREER)
+        val rank = DahiInputStats.rankOf(career.chars)
+        // 称号与三属性跟着「当前所选周期」走：看今日就是今天的状态，看生涯就是长期画像
+        val basis = if (period == DahiInputStats.Period.CAREER) career else bucket
+        // 每日柱只读一次盘，柱子和「最忙那天」共用这一份
+        val bars = dailyBars(ctx, showDaily)
+        return Model(
+            periodLabel = periodLabel(ctx, period),
+            schemaName = DahiInputStats.activeSchemaName(),
+            bucket = bucket,
+            rank = rank,
+            title = DahiInputStats.titleOf(basis),
+            attrSpeed = DahiInputStats.attrSpeed(basis.avgSpeed),
+            attrAccuracy = DahiInputStats.attrAccuracy(basis.correctionRatio),
+            attrBreadth = DahiInputStats.attrBreadth(basis.firstPickRatio),
+            layout = if (showHeat) DahiInputStats.lastLayout() else emptyList(),
+            footer = ctx.getString(R.string.dahi_stats_share_footer),
+            detailed = detailed,
+            l = labels(ctx),
+            schemas = if (showSchemas) DahiInputStats.schemaSummary() else emptyList(),
+            advice = if (showAdvice) adviceText(ctx, DahiInputStats.adviceOf(basis)) else "",
+            showHeat = showHeat,
+            showSchemas = showSchemas,
+            showAdvice = showAdvice,
+            voice = if (showVoice) DahiVoiceStats.statOf(period) else null,
+            voiceCareer = if (showVoice) DahiVoiceStats.statOf(DahiInputStats.Period.CAREER) else null,
+            voiceCareerText =
+            if (showVoice) {
+                val c = DahiVoiceStats.statOf(DahiInputStats.Period.CAREER)
+                if (c.count <= 0L) {
+                    ""
+                } else {
+                    ctx.getString(R.string.dahi_stats_voice_total, c.count, mmss(c.ms), c.chars)
+                }
+            } else {
+                ""
+            },
+            voiceLastText =
+            if (showVoice) {
+                val s = DahiVoiceStats.snapshot()
+                if (s.lastMs <= 0L) {
+                    ""
+                } else {
+                    val at = DahiVoiceStats.lastTimeText(s.lastAt)
+                    if (at.isEmpty()) {
+                        ctx.getString(R.string.dahi_stats_voice_last, mmss(s.lastMs), s.lastChars)
+                    } else {
+                        ctx.getString(R.string.dahi_stats_voice_last_at, at, mmss(s.lastMs), s.lastChars)
+                    }
+                }
+            } else {
+                ""
+            },
+            showVoice = showVoice,
+            showHours = showHours,
+            showCloud = showCloud,
+            dailyAvgText =
+                runCatching {
+                    val days = DahiDailyHistory.recent(ctx, 30).filter { it.chars > 0 }
+                    // 少于 3 天不显示：一天的数据算「日均」没有意义，还容易误导
+                    if (days.size < 3) {
+                        ""
+                    } else {
+                        val avg = days.sumOf { it.chars } / days.size
+                        val num = java.text.DecimalFormat("###,###").format(avg)
+                        ctx.getString(R.string.dahi_stats_image_daily_avg, num)
+                    }
+                }.getOrDefault(""),
+            dailyBars = bars,
+            showSpeed = showSpeed,
+            showCandidate = showCandidate,
+            showDistribution = showDistribution,
+            showChips = showChips,
+            showDaily = showDaily,
+            busiestDayText = busiestDayText(ctx, bars),
+            mark = loadMark(ctx),
+        )
+    }
+
+    /**
+     * 取近 30 天的每日字数，做成柱子。
+     *
+     * 只读 [DahiDailyHistory] 已有的记录，不新增任何存储，也不碰输入法主路径；
+     * 没勾选「每日输入」时直接返回空表，连读盘都省掉。
+     */
+    private fun dailyBars(
+        ctx: Context,
+        showDaily: Boolean,
+    ): List<DahiDailyTrendView.Item> {
+        if (!showDaily) return emptyList()
+        return runCatching {
+            DahiDailyHistory.recent(ctx, 30).map { d ->
+                val (weekend, late) = DahiDailyTrendView.flagsOf(d.date, d.peakHour, d.hours, d.chars)
+                DahiDailyTrendView.Item(
+                    label = if (d.date.length >= 10) d.date.substring(5) else d.date,
+                    chars = d.chars,
+                    late = late,
+                    weekend = weekend,
+                )
+            }
+        }.getOrDefault(emptyList())
+    }
+
+    /** 「最忙 11-03 · 1,240 字」，没有数据时返回空串。 */
+    private fun busiestDayText(
+        ctx: Context,
+        bars: List<DahiDailyTrendView.Item>,
+    ): String {
+        val peak = bars.maxByOrNull { it.chars } ?: return ""
+        if (peak.chars <= 0L) return ""
+        val num = java.text.DecimalFormat("###,###").format(peak.chars)
+        return ctx.getString(R.string.dahi_stats_busiest_day, peak.label, num)
+    }
+
+    /** 把 [R.drawable.dahi_mark] 预先画成位图，供绘制阶段着色使用。 */
+    private fun loadMark(ctx: Context): Bitmap? {
+        // 表达式体里不能写 return，这里必须是块体
+        val d =
+            runCatching { AppCompatResources.getDrawable(ctx, R.drawable.dahi_mark) }
+                .getOrNull() ?: return null
+        return runCatching {
+            val px = 128
+            val bmp = Bitmap.createBitmap(px, px, Bitmap.Config.ARGB_8888)
+            d.setBounds(0, 0, px, px)
+            d.draw(Canvas(bmp))
+            // 把「阴」那一半（古铜 #7A5E2C）压得更深：
+            // 分享图底部的标记只有 50 像素见方，太极圆弧直径不到 10 像素，
+            // 原来两种金在同色系里几乎分不出来，看上去就是一颗实心球。
+            for (x in 0 until px) {
+                for (y in 0 until px) {
+                    val c = bmp.getPixel(x, y)
+                    val a = Color.alpha(c)
+                    if (a == 0) continue
+                    val r = Color.red(c)
+                    val g = Color.green(c)
+                    if (r in 0x50..0xA0 && g in 0x40..0x80) {
+                        bmp.setPixel(
+                            x,
+                            y,
+                            Color.argb(
+                                a,
+                                r * 42 / 100,
+                                g * 40 / 100,
+                                Color.blue(c) * 36 / 100,
+                            ),
+                        )
+                    }
+                }
+            }
+            bmp
+        }.getOrNull()
+    }
+
+    /** 把引擎的 [DahiInputStats.Advice] 映射成一句人话（不显示时返回空串）。 */
