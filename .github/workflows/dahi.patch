+    private fun moveColorItem(
+        group: String,
+        mode: Int,
+    ) {
+        val sections = DahiStyleOverlay.colorSections()
+        val order = sections.flatMap { it.third }
+        if (group !in order) return
+        val sectionIdx = sections.indexOfFirst { section -> section.third.contains(group) }
+        if (sectionIdx < 0) return
+        val members = sections[sectionIdx].third
+        val pos = members.indexOf(group)
+        if (pos < 0) return
+        val target =
+            when (mode) {
+                MODE_UP -> if (pos > 0) pos - 1 else -1
+                MODE_DOWN -> if (pos < members.lastIndex) pos + 1 else -1
+                MODE_TOP -> if (pos > 0) 0 else -1
+                MODE_BOTTOM -> if (pos < members.lastIndex) members.lastIndex else -1
+                else -> -1
+            }
+        if (target < 0 || target == pos) return
+        val newMembers = members.toMutableList()
+        newMembers.removeAt(pos)
+        newMembers.add(target.coerceAtMost(newMembers.size), group)
+        val start = order.indexOf(members.first())
+        val end = order.indexOf(members.last())
+        if (start < 0 || end < start) return
+        val newOrder = mutableListOf<String>()
+        newOrder.addAll(order.subList(0, start))
+        newOrder.addAll(newMembers)
+        newOrder.addAll(order.subList(end + 1, order.size))
