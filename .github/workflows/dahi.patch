index 0000000..532fe20
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/clipboard/ClipSearchHistory.kt
@@ -0,0 +1,74 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.clipboard
+
+import android.content.Context
+import android.preference.PreferenceManager
+
+/**
+ * 剪贴板搜索的最近关键词。
+ *
+ * 只记「搜到东西并真的用上了」的那几次 —— 点某条结果上屏时才写入，
+ * 否则边打字边记会把「我」「你」这类半截词全存进去，历史就没用了。
+ *
+ * 用 \u0001 分隔存成一个字符串：条目最多 5 个、都是短词，没必要建库。
+ */
+object ClipSearchHistory {
+    private const val KEY = "dahi_clip_search_history"
+    private const val SEP = "\u0001"
+    private const val MAX = 5
+
+    fun load(ctx: Context): List<String> =
+        runCatching {
+            PreferenceManager.getDefaultSharedPreferences(ctx.applicationContext)
+                .getString(KEY, "")
+                .orEmpty()
+                .split(SEP)
+                .map { it.trim() }
+                .filter { it.isNotEmpty() }
+                .take(MAX)
+        }.getOrDefault(emptyList())
+
+    fun remember(
+        ctx: Context,
+        word: String,
+    ) {
+        val w = word.trim()
+        // 一个字的词没有检索价值，还会把有用的挤掉
+        if (w.length < 2) return
+        val next = (listOf(w) + load(ctx).filter { it != w }).take(MAX)
+        runCatching {
+            PreferenceManager.getDefaultSharedPreferences(ctx.applicationContext)
+                .edit()
+                .putString(KEY, next.joinToString(SEP))
+                .apply()
+        }
+    }
+
+    /** 删掉其中一条（长按胶囊时用）。 */
+    fun remove(
+        ctx: Context,
+        word: String,
+    ) {
+        val next = load(ctx).filter { it != word }
+        runCatching {
+            PreferenceManager.getDefaultSharedPreferences(ctx.applicationContext)
+                .edit()
+                .putString(KEY, next.joinToString(SEP))
+                .apply()
+        }
+    }
+
+    fun clear(ctx: Context) {
+        runCatching {
+            PreferenceManager.getDefaultSharedPreferences(ctx.applicationContext)
+                .edit()
+                .remove(KEY)
+                .apply()
+        }
+    }
+}
