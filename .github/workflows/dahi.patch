+    private fun doExport(format: DahiRimeFreqExport.Format) {
+        // 导出要现场扫词库（万象 pro 有 16 个子词库、几十万词），可能等 2~5 秒。
+        // 不给提示的话，用户会以为没点中，然后再点一次。
+        val progress =
+            AlertDialog
+                .Builder(requireContext())
+                .setMessage(R.string.dahi_rime_freq_working)
+                .setCancelable(false)
+                .create()
+        progress.show()
+        viewLifecycleOwner.lifecycleScope.launch {
+            val result =
+                try {
+                    DahiRimeFreqExport.build(format)
+                } finally {
+                    runCatching { if (progress.isShowing) progress.dismiss() }
+                }
+            when (result.reason) {
+                DahiRimeFreqExport.Reason.NO_ORDER ->
+                    Toast.makeText(requireContext(), R.string.dahi_rime_freq_no_order, Toast.LENGTH_SHORT).show()
+
+                DahiRimeFreqExport.Reason.NO_DICT ->
+                    AlertDialog
+                        .Builder(requireContext())
+                        .setTitle(R.string.dahi_rime_freq_export)
+                        .setMessage(
+                            getString(
+                                R.string.dahi_rime_freq_no_dict,
+                                result.schemaName.ifEmpty { "—" },
+                                result.searched.joinToString("、").ifEmpty { "—" },
+                            ),
+                        ).setPositiveButton(android.R.string.ok, null)
+                        .show()
+
+                DahiRimeFreqExport.Reason.NO_MATCH ->
+                    AlertDialog
+                        .Builder(requireContext())
+                        .setTitle(R.string.dahi_rime_freq_export)
+                        .setMessage(
+                            getString(
+                                R.string.dahi_rime_freq_no_match,
+                                result.searched.joinToString("、").ifEmpty { result.dictName.ifEmpty { "—" } },
+                            ),
+                        ).setPositiveButton(android.R.string.ok, null)
+                        .show()
+
+                DahiRimeFreqExport.Reason.OK -> {
+                    pendingFreqText = result.text
+                    freqLauncher.launch(result.fileName)
+                }
+            }
+        }
+    }
