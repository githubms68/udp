+package com.osfans.trime.data.asr
+
+import android.content.Context
+
+/**
+ * 语音引擎相关的开关。
+ *
+ * 用独立 SharedPreferences（dahi_asr_engine）：设置页与输入法同进程，
+ * 改完立刻生效，不需要重建输入视图。
+ */
+object AsrEnginePrefs {
+    private const val PREFS = "dahi_asr_engine"
+    private const val KEY_BUILTIN = "builtin_enabled"
+    private const val KEY_SPACE_HOLD = "space_hold_voice"
+    private const val KEY_CURRENT_MODEL = "current_model"
+
+    private fun prefs(context: Context) = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    /** 是否启用「内置离线」引擎（plus 包才有实现）。 */
+    fun builtinEnabled(context: Context): Boolean = prefs(context).getBoolean(KEY_BUILTIN, false)
+
+    fun setBuiltinEnabled(
+        context: Context,
+        on: Boolean,
+    ) {
+        prefs(context).edit().putBoolean(KEY_BUILTIN, on).apply()
+    }
+
+    /** 空格键长按录音（覆盖主题里空格的长按行为）。 */
+    fun spaceVoiceHold(context: Context): Boolean = prefs(context).getBoolean(KEY_SPACE_HOLD, false)
+
+    fun setSpaceVoiceHold(
+        context: Context,
+        on: Boolean,
+    ) {
+        prefs(context).edit().putBoolean(KEY_SPACE_HOLD, on).apply()
+    }
+
+    /** 当前选中的模型目录名（空 = 用第一个已安装的）。 */
+    fun currentModel(context: Context): String = prefs(context).getString(KEY_CURRENT_MODEL, "").orEmpty()
+
+    fun setCurrentModel(
+        context: Context,
+        name: String,
+    ) {
+        prefs(context).edit().putString(KEY_CURRENT_MODEL, name).apply()
+    }
+
+    // ---- 内置离线专属的输入行为（外部联动一律不读这些） ----
+
+    /** 去掉句末标点与 emoji。 */
+    fun trimEndPunctuation(context: Context): Boolean = getBool(context, "trim_end_punct")
+
+    fun setTrimEndPunctuation(context: Context, on: Boolean) = putBool(context, "trim_end_punct", on)
+
+    /** 录音期间屏幕常亮。 */
+    fun keepScreenOn(context: Context): Boolean = getBool(context, "keep_screen_on")
+
+    fun setKeepScreenOn(context: Context, on: Boolean) = putBool(context, "keep_screen_on", on)
+
+    /** 上屏后自动回车。 */
+    fun autoEnter(context: Context): Boolean = getBool(context, "auto_enter")
+
+    fun setAutoEnter(context: Context, on: Boolean) = putBool(context, "auto_enter", on)
+
+    /** true = 点一下开始/再点结束；false = 按住说话。默认保持现状（点按）。 */
+    fun tapToToggle(context: Context): Boolean = getBool(context, "tap_to_toggle", default = true)
+
+    fun setTapToToggle(context: Context, on: Boolean) = putBool(context, "tap_to_toggle", on)
+
+    /** 过滤静音：开头没说话的部分直接丢掉，全程没检测到语音就不上屏。 */
+    fun filterSilence(context: Context): Boolean = getBool(context, "filter_silence")
+
+    fun setFilterSilence(context: Context, on: Boolean) = putBool(context, "filter_silence", on)
+
+    /** 停说自动停止（检测到静音持续到阈值就结束录音）。 */
+    fun autoStop(context: Context): Boolean = getBool(context, "auto_stop")
+
+    fun setAutoStop(context: Context, on: Boolean) = putBool(context, "auto_stop", on)
+
+    /** 判停时间阈值（毫秒）。 */
+    fun silenceMs(context: Context): Int = prefs(context).getInt("silence_ms", 1200)
+
+    fun setSilenceMs(context: Context, value: Int) {
+        prefs(context).edit().putInt("silence_ms", value).apply()
+    }
+
+    /** 判停灵敏度 1~10，越大越容易判定为静音。 */
+    fun sensitivity(context: Context): Int = prefs(context).getInt("sensitivity", 4)
+
+    fun setSensitivity(context: Context, value: Int) {
+        prefs(context).edit().putInt("sensitivity", value).apply()
+    }
+
+    /** 灵敏度换算成判断静音的能量阈值（RMS）。 */
+    fun silenceThreshold(context: Context): Float = 0.001f + sensitivity(context) * 0.0015f
+
+    private fun getBool(
+        context: Context,
+        key: String,
+        default: Boolean = false,
+    ): Boolean = prefs(context).getBoolean(key, default)
+
+    private fun putBool(
+        context: Context,
+        key: String,
+        value: Boolean,
+    ) {
+        prefs(context).edit().putBoolean(key, value).apply()
+    }
+}
