+    private fun heading(title: String): TextView {
+        val ctx = requireContext()
+        return TextView(ctx).apply {
+            text = title
+            textSize = 19f
+            setTextColor(titleColor())
+            setPadding(0, ctx.dp(12), 0, ctx.dp(6))
+        }
+    }
+
+    /** 分组：一条分隔线 + 「」包起来的标题，字号比设置项大一号并加粗 —— 层级才看得出来。 */
+    private fun addGroup(titleRes: Int) {
+        content.addView(divider())
+        content.addView(subHeading(requireContext().getString(titleRes)))
+    }
+
+    private fun subHeading(title: String): TextView {
+        val ctx = requireContext()
+        return TextView(ctx).apply {
+            text = "「$title」"
+            textSize = 17f
+            setTypeface(typeface, Typeface.BOLD)
+            setTextColor(titleColor())
+            setPadding(0, ctx.dp(12), 0, ctx.dp(6))
+        }
+    }
+
+    private fun hint(text: String): TextView {
+        val ctx = requireContext()
+        return TextView(ctx).apply {
+            this.text = text
+            textSize = 12f
+            setTextColor(summaryColor())
+            setPadding(0, ctx.dp(2), 0, ctx.dp(6))
+        }
+    }
+
+    private fun divider(): View {
+        val ctx = requireContext()
+        return View(ctx).apply {
+            setBackgroundColor(0x22808080)
+            layoutParams =
+                LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ctx.dp(1)).apply {
+                    topMargin = ctx.dp(16)
+                }
+        }
+    }
+
+    /** 让输入法重建键盘视图：键面文字是在 KeyView 构造时决定画不画的。 */
+    private fun rebuildKeyboard() {
+        runCatching {
+            val keyboard = AppPrefs.defaultInstance().keyboard
+            keyboard.dahiStyleApplyToken.setValue(keyboard.dahiStyleApplyToken.getValue() + 1)
+        }
+    }
+
+    private companion object {
+        const val FALLBACK_COLOR = 0xFF4FC3F7.toInt()
+    }
