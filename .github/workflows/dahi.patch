+    <!-- 11 个选项：设置页里选项下方的注释文案 -->
+    <string name="dahi_vi_note_gentle_flow">從容舒緩、娓娓道來：水平細線波動   ★☆☆☆☆</string>
+    <string name="dahi_vi_note_quiet_glow">呼吸鬆弛、心境平和：動態漸層呼吸   ★★☆☆☆</string>
+    <string name="dahi_vi_note_star_dots">點點心生、細膩內斂：點狀陣列   ★★☆☆☆</string>
+    <string name="dahi_vi_note_slow_ripple">同頻共振、思緒輕漾：同心圓漣漪   ★★★☆☆</string>
+    <string name="dahi_vi_note_smooth_surge">興致盎然、靈動外放：連續正弦波浪   ★★★★☆</string>
+    <string name="dahi_vi_note_clear_rhythm">理性清醒、條理清晰：等寬豎條頻譜   ★★★★☆</string>
