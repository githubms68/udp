+ * **改名**（一次迁移整类条目）、**删除**（条目保留、回到未分类）、**调整顺序**（只改显示顺序）。
+ * 剪贴板与收藏夹共用同一套分类，因此这里的操作对两个列表同时生效。
+ */
+class ClipboardCategorySettingsFragment : Fragment() {
+    private companion object {
+        const val ACTION_TOP = 1
+        const val ACTION_BOTTOM = 2
+        const val ACTION_DELETE = 3
+    }
+
+    private var listContainer: LinearLayout? = null
+    private var emptyTip: TextView? = null
+
+    private var currentOrder: List<String> = emptyList()
+    private var currentCounts: Map<String, Int> = emptyMap()
+
+    /** 分类在「剪贴板 / 收藏夹」各自的条数：两库共用同一套分类名，分开显示才看得清。 */
+    private var countClipboard: Map<String, Int> = emptyMap()
+    private var countCollection: Map<String, Int> = emptyMap()
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(24))
+            }
+        // 第一项就是「剪贴板设置」：原版的剪贴板设置页此前在首页菜单里没有入口，
+        // 用户既进不去也搜不到（主题 / 候选 / 存储这些开关全在那里）。
+        column.addView(
+            Button(ctx).apply {
+                setText(R.string.dahi_clipboard_settings_title)
+                setOnClickListener {
+                    findNavController().navigateWithAnim(NavigationRoute.Clipboard)
+                }
+            },
+        )
+        column.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_cat_manage_tip)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            },
+        )
+        column.addView(
+            Button(ctx).apply {
+                setText(R.string.dahi_cat_new)
+                setOnClickListener { createCategory() }
+            },
+        )
+        emptyTip =
+            TextView(ctx).apply {
+                setText(R.string.dahi_cat_manage_empty)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                visibility = View.GONE
+            }
+        column.addView(emptyTip)
+        listContainer =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+            }
+        column.addView(listContainer)
+        column.addView(buildPurgeSection(ctx))
+        return ScrollView(ctx).apply { addView(column) }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        reload()
+    }
+
+    /**
+     * 「清理剪贴板」区块。
+     *
+     * 三个关键设计：
+     * 1. 每个按钮上**直接显示会删几条**，点之前就知道后果；
+     * 2. 「最近 N 小时」用于刚复制了敏感内容立即清掉，「X 以前」用于腾空间，方向相反；
+     * 3. **置顶条目与收藏夹一律不受影响**（DAO 的 SQL 自带 pinned=0，收藏夹根本不碰）。
+     */
+    private fun buildPurgeSection(ctx: Context): View {
+        val box =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(0, ctx.dp(28), 0, 0)
+            }
+        box.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_purge_title)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+                setTypeface(typeface, Typeface.BOLD)
+            },
+        )
+        val stats =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                setPadding(0, ctx.dp(6), 0, ctx.dp(10))
+            }
+        box.addView(stats)
+
+        // 最近 N 小时：清掉刚复制的（敏感内容）
+        listOf(1, 2, 4, 12, 24).forEach { hours ->
+            addPurgeRow(
+                box = box,
+                ctx = ctx,
+                label = { n -> ctx.getString(R.string.dahi_purge_recent_fmt, ctx.getString(R.string.clipboard_keep_hours, hours), n) },
+                countFn = {
+                    val since = System.currentTimeMillis() - hours * 3_600_000L
+                    ClipboardHelper.countAfter(since)
+                },
+                execFn = {
+                    val since = System.currentTimeMillis() - hours * 3_600_000L
+                    ClipboardHelper.deleteAfter(since)
+                },
+            )
+        }
+        // X 以前：清旧的腾空间
+        listOf(30 to 30, 365 to 365).forEach { (days, labelDays) ->
+            addPurgeRow(
+                box = box,
+                ctx = ctx,
+                label = { n -> ctx.getString(R.string.dahi_purge_before_fmt, ctx.getString(R.string.clipboard_keep_days, labelDays), n) },
+                countFn = {
+                    val before = System.currentTimeMillis() - days * 86_400_000L
+                    ClipboardHelper.countBefore(before)
+                },
+                execFn = {
+                    val before = System.currentTimeMillis() - days * 86_400_000L
+                    ClipboardHelper.deleteBefore(before)
+                },
+            )
+        }
+        // 指定日期以前：按钮点开日期选择，选完再告诉你会删几条
+        run {
+            val btn =
+                Button(ctx).apply {
+                    setText(R.string.dahi_purge_pick_date)
+                    isAllCaps = false
+                    setOnClickListener { pickDateThenPurge(ctx) }
+                }
+            box.addView(btn)
+        }
+
+        // 全部
+        run {
+            val btn =
+                Button(ctx).apply {
+                    setText(R.string.dahi_purge_all)
+                    isAllCaps = false
+                }
+            box.addView(btn)
+            btn.setOnClickListener {
+                viewLifecycleOwner.lifecycleScope.launch {
+                    val n = withContext(Dispatchers.IO) { ClipboardHelper.countBefore(System.currentTimeMillis() + 1000L) }
+                    if (n <= 0) {
+                        Toast.makeText(ctx, R.string.dahi_purge_empty, Toast.LENGTH_SHORT).show()
+                        return@launch
+                    }
+                    AlertDialog
+                        .Builder(ctx)
+                        .setMessage(ctx.getString(R.string.dahi_purge_confirm, n))
+                        .setPositiveButton(android.R.string.ok) { _, _ ->
+                            viewLifecycleOwner.lifecycleScope.launch {
+                                val done =
+                                    withContext(Dispatchers.IO) {
+                                        runCatching { ClipboardHelper.deleteBefore(System.currentTimeMillis() + 1000L) }.getOrDefault(0)
+                                    }
+                                Toast.makeText(ctx, ctx.getString(R.string.dahi_purge_done, done), Toast.LENGTH_SHORT).show()
+                                reload()
+                            }
+                        }.setNegativeButton(android.R.string.cancel, null)
+                        .show()
+                }
+            }
+        }
+        box.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_purge_note)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setPadding(0, ctx.dp(8), 0, 0)
+            },
+        )
+
+        // 顶部统计：总数 + 最早一条
+        viewLifecycleOwner.lifecycleScope.launch {
+            val info =
+                withContext(Dispatchers.IO) {
+                    val total = ClipboardHelper.totalCount()
+                    val earliest = ClipboardHelper.earliestTime()
+                    total to earliest
+                }
+            val (total, earliest) = info
+            val fmt = SimpleDateFormat("yyyy-MM-dd", Locale.getDefault())
+            stats.text =
+                ctx.getString(
+                    R.string.dahi_purge_stats,
+                    total,
+                    if (earliest > 0) fmt.format(Date(earliest)) else "—",
+                )
+        }
+        return box
+    }
+
+    /** 一个清理按钮：先查会删几条，把数字写进按钮文字；点击需二次确认。 */
+    private fun addPurgeRow(
+        box: LinearLayout,
+        ctx: Context,
+        label: (Int) -> CharSequence,
+        countFn: suspend () -> Int,
+        execFn: suspend () -> Int,
+    ) {
+        val btn =
+            Button(ctx).apply {
+                text = label(0)
+                isAllCaps = false
+            }
+        box.addView(btn)
+        viewLifecycleOwner.lifecycleScope.launch {
+            val n = withContext(Dispatchers.IO) { runCatching { countFn() }.getOrDefault(0) }
+            btn.text = label(n)
+            btn.isEnabled = n > 0
+            btn.setOnClickListener {
+                AlertDialog
+                    .Builder(ctx)
+                    .setMessage(ctx.getString(R.string.dahi_purge_confirm, n))
+                    .setPositiveButton(android.R.string.ok) { _, _ ->
+                        viewLifecycleOwner.lifecycleScope.launch {
+                            // 清理前先存一份快照：误点也能退回来（私有目录，保留 5 份）
+                            runCatching { com.osfans.trime.data.backup.DahiAutoBackup.snapshot("清理") }
+                            val done = withContext(Dispatchers.IO) { runCatching { execFn() }.getOrDefault(0) }
+                            Toast.makeText(ctx, ctx.getString(R.string.dahi_purge_done, done), Toast.LENGTH_SHORT).show()
+                            reload()
+                        }
+                    }.setNegativeButton(android.R.string.cancel, null)
+                    .show()
+            }
+        }
+    }
+
+    /**
+     * 选一个日期，清掉它之前复制的内容。
+     *
+     * 与其它清理按钮同一套安全网：先查条数 → 二次确认 → 清理前快照 → 执行。
+     * 已分类 / 已置顶 / 收藏夹全程不受影响（DAO 的 SQL 自带 pinned=0 与 category 条件）。
+     */
+    private fun pickDateThenPurge(ctx: Context) {
+        val today = java.util.Calendar.getInstance()
+        runCatching {
+            android.app.DatePickerDialog(
+                ctx,
+                { _, y, m, d ->
+                    val cal =
+                        java.util.Calendar.getInstance().apply {
+                            set(y, m, d, 0, 0, 0)
+                            set(java.util.Calendar.MILLISECOND, 0)
+                        }
+                    val before = cal.timeInMillis
+                    val label = SimpleDateFormat("yyyy-MM-dd", Locale.getDefault()).format(Date(before))
+                    viewLifecycleOwner.lifecycleScope.launch {
+                        val n =
+                            withContext(Dispatchers.IO) {
+                                runCatching { ClipboardHelper.countBefore(before) }.getOrDefault(0)
+                            }
+                        if (n <= 0) {
+                            Toast.makeText(ctx, R.string.dahi_purge_empty, Toast.LENGTH_SHORT).show()
+                            return@launch
+                        }
+                        AlertDialog
+                            .Builder(ctx)
+                            .setMessage(ctx.getString(R.string.dahi_purge_pick_confirm, label, n))
+                            .setPositiveButton(android.R.string.ok) { _, _ ->
+                                viewLifecycleOwner.lifecycleScope.launch {
+                                    // 与其它清理按钮一致：先存快照，误点能退回来
+                                    runCatching { com.osfans.trime.data.backup.DahiAutoBackup.snapshot("清理") }
+                                    val done =
+                                        withContext(Dispatchers.IO) {
+                                            runCatching { ClipboardHelper.deleteBefore(before) }.getOrDefault(0)
+                                        }
+                                    Toast.makeText(ctx, ctx.getString(R.string.dahi_purge_done, done), Toast.LENGTH_SHORT).show()
+                                    reload()
+                                }
+                            }.setNegativeButton(android.R.string.cancel, null)
+                            .show()
+                    }
+                },
+                today.get(java.util.Calendar.YEAR),
+                today.get(java.util.Calendar.MONTH),
+                today.get(java.util.Calendar.DAY_OF_MONTH),
+            ).show()
+        }.onFailure { Toast.makeText(ctx, R.string.dahi_purge_empty, Toast.LENGTH_SHORT).show() }
+    }
+
+    private fun reload() {
+        viewLifecycleOwner.lifecycleScope.launch {
+            val data =
+                withContext(Dispatchers.IO) {
+                    val clip = runCatching { ClipboardHelper.categoryCounts() }.getOrDefault(emptyList())
+                    val coll = runCatching { CollectionHelper.categoryCounts() }.getOrDefault(emptyList())
+                    val clipMap = clip.associate { it.category to it.count }
+                    val collMap = coll.associate { it.category to it.count }
+                    val total =
+                        (clip + coll).groupBy { it.category }.mapValues { entry -> entry.value.sumOf { it.count } }
+                    Triple(total, clipMap, collMap)
+                }
+            val counts = data.first
+            countClipboard = data.second
+            countCollection = data.third
+            currentCounts = counts
+            currentOrder =
+                withContext(Dispatchers.IO) {
+                    runCatching { DahiCategoryStore.loadOrdered() }
+                        .getOrDefault(DahiCategoryStore.ordered(counts.keys.toList()))
+                }
+            renderRows()
+        }
+    }
+
+    private fun renderRows() {
+        val box = listContainer ?: return
+        val ctx = requireContext()
+        box.removeAllViews()
+        emptyTip?.visibility = if (currentOrder.isEmpty()) View.VISIBLE else View.GONE
+        currentOrder.forEach { name ->
+            val row =
+                LinearLayout(ctx).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    gravity = Gravity.CENTER_VERTICAL
+                    setPadding(0, ctx.dp(4), 0, ctx.dp(4))
+                }
+            row.addView(
+                TextView(ctx).apply {
+                    text =
+                        if (DahiCategoryStore.isPseudo(name)) {
+                            getString(
+                                if (name == DahiCategoryStore.KEY_ALL) {
+                                    R.string.dahi_cp_category_all
+                                } else {
+                                    R.string.dahi_cp_category_uncategorized
+                                },
+                            )
+                        } else {
+                            getString(
+                                R.string.dahi_cat_row_detail,
+                                name,
+                                countClipboard[name] ?: 0,
+                                countCollection[name] ?: 0,
+                            )
+                        }
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+                    layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+                },
+            )
+            // 行内固定按钮：↑ 改名 ↓（改名只对真分类有意义）；「⋮」里只放低频操作
+            val pseudo = DahiCategoryStore.isPseudo(name)
+            row.addView(actionButton(R.string.dahi_cat_up) { move(name, -1) })
+            if (!pseudo) {
+                row.addView(actionButton(R.string.dahi_cat_rename) { rename(name) })
+            }
+            row.addView(actionButton(R.string.dahi_cat_down) { move(name, 1) })
+            row.addView(
+                TextView(ctx).apply {
+                    text = "\u22ee"
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 20f)
+                    setPadding(dp(10), 0, dp(10), 0)
+                    setOnClickListener { anchor -> showRowMenu(anchor, name) }
+                },
+            )
+            box.addView(row)
+        }
+    }
+
+    private fun actionButton(
+        labelRes: Int,
+        onTap: () -> Unit,
+    ): Button = Button(requireContext(), null, android.R.attr.borderlessButtonStyle).apply {
+        setText(labelRes)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+        minWidth = 0
+        minimumWidth = 0
+        setPadding(dp(6), 0, dp(6), 0)
+        setOnClickListener { onTap() }
+    }
+
+    /** 行菜单：置顶 / 删除 / 垫底（伪分类没有删除，只有置顶 / 垫底）。 */
+    private fun showRowMenu(
+        anchor: View,
+        name: String,
+    ) {
+        val ctx = requireContext()
+        PopupMenu(ctx, anchor).apply {
+            val pseudo = DahiCategoryStore.isPseudo(name)
+            menu.add(0, ACTION_TOP, 0, R.string.dahi_order_top)
+            if (!pseudo) {
+                menu.add(0, ACTION_DELETE, 1, R.string.dahi_cat_delete)
+            }
+            menu.add(0, ACTION_BOTTOM, 2, R.string.dahi_order_bottom)
+            setOnMenuItemClickListener { item ->
+                when (item.itemId) {
+                    ACTION_TOP -> move(name, -currentOrder.size)
+                    ACTION_BOTTOM -> move(name, currentOrder.size)
+                    ACTION_DELETE -> delete(name)
+                }
+                true
+            }
+            show()
+        }
+    }
+
+    private fun move(
+        name: String,
+        delta: Int,
+    ) {
+        val moved = DahiCategoryStore.moved(currentOrder, name, delta)
+        if (moved == currentOrder) return
+        DahiCategoryStore.saveOrder(moved)
+        currentOrder = moved
+        renderRows()
+    }
+
+    /** 新建一个空分类：先登记名字，条目可以在剪贴板里长按归入。 */
+    private fun createCategory() {
+        val ctx = requireContext()
+        val input =
+            EditText(ctx).apply {
+                hint = getString(R.string.dahi_cat_new_hint)
+                setSingleLine()
+            }
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_cat_new)
+            .setView(input)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val name = input.text?.toString()?.trim().orEmpty()
+                if (name.isEmpty()) return@setPositiveButton
+                viewLifecycleOwner.lifecycleScope.launch {
+                    val exists = withContext(Dispatchers.IO) { name in DahiCategoryStore.loadOrdered() }
+                    if (exists) {
+                        toast(getString(R.string.dahi_cat_new_duplicate, name))
+                        return@launch
+                    }
+                    DahiCategoryStore.add(name)
+                    toast(getString(R.string.dahi_cat_new_done, name))
+                    reload()
+                }
+            }.show()
+    }
+
+    private fun rename(oldName: String) {
+        val ctx = requireContext()
+        val input =
+            EditText(ctx).apply {
+                setText(oldName)
+                setSelection(oldName.length)
+                setSingleLine()
+            }
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_cat_rename)
+            .setView(input)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val newName = input.text?.toString()?.trim().orEmpty()
+                if (newName.isEmpty() || newName == oldName) return@setPositiveButton
+                viewLifecycleOwner.lifecycleScope.launch {
+                    withContext(Dispatchers.IO) { DahiCategoryStore.rename(oldName, newName) }
+                    toast(getString(R.string.dahi_cat_renamed, oldName, newName))
+                    reload()
+                }
+            }.show()
+    }
+
+    private fun delete(name: String) {
+        val ctx = requireContext()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_cat_delete)
+            .setMessage(getString(R.string.dahi_cat_delete_confirm, name))
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                viewLifecycleOwner.lifecycleScope.launch {
+                    withContext(Dispatchers.IO) { DahiCategoryStore.delete(name) }
+                    toast(getString(R.string.dahi_cat_deleted, name))
+                    reload()
+                }
+            }.show()
+    }
+
+    private fun toast(text: String) {
+        if (isAdded) Toast.makeText(requireContext(), text, Toast.LENGTH_SHORT).show()
+    }
+}
