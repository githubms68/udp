--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiKeySound.kt
@@ -0,0 +1,96 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.media.AudioAttributes
+import android.media.SoundPool
+import com.osfans.trime.util.appContext
+import timber.log.Timber
+
+/**
+ * 按键音效：6 个程序化生成的短样本（`res/raw/dahi_key_*.wav`，每个 2~6 KB）。
+ *
+ * 用 SoundPool 而不是 MediaPlayer：样本只有 30~130ms，MediaPlayer 每次起播都有
+ * 几十毫秒延迟，连打时会明显拖后。
+ *
+ * 与主题音效（`InputFeedbackManager` / `SoundEffectManager`）互不干扰：
+ * 那条通路绑的是主题 yaml 里的音效包，这里是独立开关、独立音色。
+ */
+object DahiKeySound {
+    private var pool: SoundPool? = null
+
+    /** rawRes → SoundPool 的 soundId。 */
+    private val soundIds = HashMap<Int, Int>()
+
+    private fun ensurePool(): SoundPool? {
+        pool?.let { return it }
+        val p =
+            runCatching {
+                SoundPool.Builder()
+                    .setMaxStreams(6)
+                    .setAudioAttributes(
+                        AudioAttributes.Builder()
+                            .setUsage(AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)
+                            .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+                            .build(),
+                    ).build()
+            }.getOrNull() ?: return null
+        pool = p
+        return p
+    }
+
+    /**
+     * 预加载全部音色：SoundPool 的 load 是异步的，等到第一次按键才加载会「第一下没声音」。
+     * 在输入视图初始化时调一次，之后切换音色也已就绪。
+     */
+    fun ensure() {
+        val p = ensurePool() ?: return
+        DahiKeyEffectsConfig.SoundStyle.entries.forEach { style ->
+            if (soundIds.containsKey(style.rawRes)) return@forEach
+            val id = runCatching { p.load(appContext, style.rawRes, 1) }.getOrDefault(0)
+            if (id != 0) soundIds[style.rawRes] = id
+        }
+    }
+
+    /**
+     * 播放一次按键音。
+     *
+     * @param functional 空格 / 退格 / 回车这类功能键：音量压到 70%、播放速率略低，
+     *   连按退格时不会变得尖锐刺耳。
+     */
+    fun play(functional: Boolean) {
+        if (!DahiKeyEffectsConfig.soundEnabled) return
+        val volume = DahiKeyEffectsConfig.soundVolume
+        if (volume <= 0) return
+        val p = ensurePool() ?: return
+        val style = DahiKeyEffectsConfig.soundStyle
+        val soundId =
+            soundIds.getOrPut(style.rawRes) {
+                runCatching { p.load(appContext, style.rawRes, 1) }.getOrDefault(0)
+            }
+        if (soundId == 0) {
+            Timber.w("DahiKeySound: load failed for ${style.key}")
+            return
+        }
+        val v = volume / 100f
+        val targetVolume = if (functional) v * 0.7f else v
+        val rate = if (functional) 0.92f else 1f
+        runCatching { p.play(soundId, targetVolume, targetVolume, 1, 0, rate) }
+    }
+
+    /** 试听（设置页用）：不受总开关影响。 */
+    fun preview(style: DahiKeyEffectsConfig.SoundStyle) {
+        val p = ensurePool() ?: return
+        val soundId =
+            soundIds.getOrPut(style.rawRes) {
+                runCatching { p.load(appContext, style.rawRes, 1) }.getOrDefault(0)
+            }
+        if (soundId == 0) return
+        val v = (DahiKeyEffectsConfig.soundVolume.coerceAtLeast(30)) / 100f
+        runCatching { p.play(soundId, v, v, 1, 0, 1f) }
+    }
+}
