+    private fun render() {
+        if (!isAdded || !::heatView.isInitialized || !::wordLenBox.isInitialized) return
+        val enabled = DahiInputStats.isEnabled()
+        content.alpha = if (enabled) 1f else 0.45f
+        highlightPeriod()
+
+        // 这一行以前只在「词云开关 / 清空历史」这些回调里才刷新，
+        // 于是页面正常打开时它一直是空的 —— 看起来就像「有时候显示、有时候不显示」。
+        // 本周字数本身取自引擎的本周桶，任何时候都能算出来，所以放进 render() 一起刷。
+        refreshWeekLine()
+        refreshDaily()
