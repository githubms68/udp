+    // ---------------- 颜色 ----------------
+
+    private fun readColors(): MutableMap<String, Int> {
+        val map = linkedMapOf<String, Int>()
+        runCatching {
+            val raw = prefs.getString(KEY_COLORS, null) ?: return@runCatching
+            val json = JSONObject(raw)
+            json.keys().forEach { k -> map[k] = json.optInt(k) }
+        }
+        return map
+    }
+
+    private fun writeColors(map: Map<String, Int>) {
+        val json = JSONObject()
+        map.forEach { (k, v) -> json.put(k, v) }
+        prefs.edit { putString(KEY_COLORS, json.toString()) }
+    }
+
+    /** 该分组当前是否已被覆盖；返回覆盖色（含透明度）。 */
+    fun colorOf(group: String): Int? {
+        if (!isEnabled()) return null
+        val keys = COLOR_GROUPS.firstOrNull { it.first == group }?.second ?: return null
+        val colors = readColors()
+        return keys.firstNotNullOfOrNull { colors[it] }
+    }
+
+    fun setColor(
+        group: String,
+        argb: Int,
+    ) {
+        val keys = COLOR_GROUPS.firstOrNull { it.first == group }?.second ?: return
+        val colors = readColors()
+        keys.forEach { colors[it] = argb }
+        writeColors(colors)
+        applyTheme()
+    }
+
+    fun clearColor(group: String) {
+        val keys = COLOR_GROUPS.firstOrNull { it.first == group }?.second ?: return
+        val colors = readColors()
+        keys.forEach { colors.remove(it) }
+        writeColors(colors)
+        applyTheme()
+    }
