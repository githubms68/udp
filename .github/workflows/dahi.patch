+
+<resources>
+    <!-- 键盘背景 · 自定义底板图片 -->
+    <string name="dahi_keybg_title">Keyboard background</string>
+    <string name="dahi_keybg_preview_title">Live preview</string>
+    <string name="dahi_keybg_enabled">Enable custom keyboard background</string>
+    <string name="dahi_keybg_enabled_summary">Use a custom base image for the keyboard without affecting key styles. Very large images may consume extra memory, so compressed images are recommended.</string>
+    <string name="dahi_keybg_override_hint">When enabled, this overrides the keyboard background bundled with the current theme; when disabled, each theme uses its own native background. This feature does not modify any of your theme files.</string>
+    <string name="dahi_keybg_source_title">Custom background (pick from gallery)</string>
+    <string name="dahi_keybg_separate">Set separate landscape / portrait backgrounds</string>
+    <string name="dahi_keybg_portrait_title">Portrait background</string>
+    <string name="dahi_keybg_landscape_title">Landscape background</string>
+    <string name="dahi_keybg_pick">Choose image (GIF supported)</string>
+    <string name="dahi_keybg_reset">Reset to default</string>
+    <string name="dahi_keybg_blur">Gaussian blur</string>
+    <string name="dahi_keybg_blur_label">Gaussian blur  %1$d</string>
+    <string name="dahi_keybg_blur_hint">The stronger the blur, the softer the background; 0 means no blur.</string>
+    <string name="dahi_keybg_mode">Background fill mode</string>
+    <string name="dahi_keybg_mode_main_title">Fill mode (keyboard background)</string>
+    <string name="dahi_keybg_mode_land_title">Fill mode (landscape background)</string>
+    <string name="dahi_keybg_mode_cand_title">Fill mode (candidate bar background)</string>
+    <string name="dahi_keybg_mode_video_title">Fill mode (video background)</string>
+    <string name="dahi_keybg_mode_stretch">Stretch to fill</string>
+    <string name="dahi_keybg_mode_center">Center (crop to fill)</string>
+    <string name="dahi_keybg_mode_fit">Fit (show whole image)</string>
+    <string name="dahi_keybg_mode_tile">Tile</string>
+    <string name="dahi_keybg_mode_hint">“Fit” shows the whole image or video without distortion, but may leave margins around it; “Center” scales proportionally to fill the area and crops around the center, so it fills without distortion (recommended for animated backgrounds); “Stretch to fill” fills the area but may distort the image; “Tile” repeats the image (including GIFs) in multiple blocks (video does not support tiling — it will be displayed centered).</string>
+    <string name="dahi_keybg_opacity">Background opacity</string>
+    <string name="dahi_keybg_opacity_label">Background opacity  %1$d%%</string>
+    <string name="dahi_keybg_opacity_hint">The higher the opacity, the clearer the image; the lower it is, the easier the key labels are to read.</string>
+    <string name="dahi_keybg_cand_enabled">Separate candidate bar background</string>
+    <string name="dahi_keybg_video_title">Video background</string>
+    <string name="dahi_keybg_pick_video">Choose video</string>
+    <string name="dahi_keybg_video_hint">After you choose a video, the keyboard base plays it on loop (muted). For animated GIFs, use “Choose image (GIF supported)” in the respective background slot — they are detected automatically and need no cropping. Video backgrounds drain the most battery, so enable them only when needed. The fill mode also applies to GIFs and videos: the default “Center” scales proportionally to fill and crops around the center (without distortion); choose “Fit” to watch the whole video (video does not support “Tile” — it will be displayed as “Center”). Note: videos larger than 4 MB are not included in encrypted backups.</string>
