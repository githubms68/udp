+        val existing = (0 until count).map { screen.getPreference(it) }
+        val anchor = existing.firstOrNull { it.key == ANCHOR_KEY } ?: return
+        // 只有 order 生效（而不是按添加顺序）才能插到中间
+        screen.isOrderingAsAdded = false
+        existing.forEachIndexed { index, pref -> pref.order = index * 10 }
