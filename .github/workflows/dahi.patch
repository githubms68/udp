+++ b/app/src/main/res/drawable/dahi_splash_mark.xml
@@ -0,0 +1,56 @@
+<?xml version="1.0" encoding="utf-8"?>
+
+<!--
+  启动画面（Android 12+）用的标记：金色「ㄓ + 太极」，透明底。
+
+  与 dahi_mark.xml 是同一套路径，只是画面尺寸用 108 视口、图形缩到 72
+  （占 2/3，四周留白），避免系统把 24dp 的图标直接拉大导致线条过粗。
+  SPDX-License-Identifier: GPL-3.0-or-later
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+
+    <group
+        android:translateX="18"
+        android:translateY="18"
+        android:scaleX="3"
+        android:scaleY="3">
+
+        <!-- 左竖 → 中横（波浪）→ 右竖 -->
+        <path
+            android:pathData="M4.9,4.65 L4.9,11.95 C6.6,10.83 9.0,10.83 12.0,11.95 C15.0,13.07 17.4,13.07 19.1,11.95 L19.1,4.65"
+            android:strokeColor="#EEC57A"
+            android:strokeWidth="2.2"
+            android:strokeLineCap="round"
+            android:strokeLineJoin="round" />
+
+        <!-- 中竖 -->
+        <path
+            android:pathData="M12.0,3.45 L12.0,19.05"
+            android:strokeColor="#EEC57A"
+            android:strokeWidth="2.2"
+            android:strokeLineCap="round" />
+
+        <!-- 底浪 -->
+        <path
+            android:pathData="M2.8,19.05 C5.4,17.55 9.0,17.55 12.0,19.05 C15.0,20.55 18.6,20.55 21.2,19.05"
+            android:strokeColor="#EEC57A"
+            android:strokeWidth="2.2"
+            android:strokeLineCap="round" />
+
