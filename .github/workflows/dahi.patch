+        if (!selectable) return
+        // 颜色解析必须兜底：主题里若没有 hilited_key_text_color（且 fallback 链也断），
+        // ColorManager 会把「键名」当颜色值再解析一次并抛 IllegalArgumentException。
+        // 这行代码跑在 RecyclerView 的 onBindViewHolder 里 —— 一抛就是整个输入法进程崩溃，
+        // 现场表现正是「点批量后键盘收回、界面空白」。
+        // 这两个 Drawable 以前是**每次 bind** 都新建一次（2000 条列表滚动时会白白产生大量对象）。
+        // 改成每个 ViewHolder 只做一次：状态只有「选中 / 未选中」两种，共用即可。
+        selectMark.imageDrawable = if (selected) selectOn else selectOff
+    }
+
+    /** 选中态图标（已着色），懒加载一次。 */
+    private val selectOn: android.graphics.drawable.Drawable? by lazy {
+        // 颜色解析必须兜底：主题里缺键时 ColorManager 会把键名当颜色值再解析并抛异常
+        runCatching { ColorManager.getColor("hilited_key_text_color") }.getOrDefault(0xFF3B82F6.toInt())
+            .let { tint ->
+                ctx.drawable(R.drawable.ic_dahi_select_on)?.apply { setTint(tint) }
+            }
+    }
+
+    /** 未选中态图标（已着色），懒加载一次。 */
+    private val selectOff: android.graphics.drawable.Drawable? by lazy {
+        runCatching { ColorManager.getColor("key_symbol_color") }.getOrDefault(0xFF888888.toInt())
+            .let { tint ->
+                ctx.drawable(R.drawable.ic_dahi_select_off)?.apply { setTint(tint) }
+            }
+    }
 }
