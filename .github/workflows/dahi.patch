@@ -0,0 +1,99 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.data.prefs.AppPrefs
+import com.osfans.trime.util.appContext
+
+/**
+ * 「最近用过的词」当前是否正在显示。
+ *
+ * UI 侧（候选栏的左右滑动翻页手势）需要**同步**判断：「最近用过的词」开着时，
+ * 即使「左右滑动翻页」总开关关着，也该能横向翻页（一页 10 条，不翻就只有前 10 条）。
+ * 走 Rime 的异步接口拿不到同步值，用一个内存标记最省事。
+ */
+object DahiRecentState {
+    @Volatile
+    var active: Boolean = false
+}
+
+/**
+ * 「首尾字筛选」是否正在生效。
+ *
+ * 长按候选的菜单据此多出一项「显示全部（取消筛选）」—— 以前只靠「再长按一次换个字」
+ * 或等上屏才退出筛选，用户不知道该怎么回到全部候选。
+ */
+object DahiFilterState {
+    @Volatile
+    var active: Boolean = false
+}
+
+/**
+ * 大海版：「最近用过的词」。
+ *
+ * 不依赖方案的反查状态 —— 反查是方案内部行为，应用层只能靠 option 名去猜，
+ * 猜不到就什么也做不了。这里记录的是**上屏内容**：反查出来的词最终一定要上屏，
+ * 所以「最近用过的词」天然覆盖了「最近反查的词」，另外还把选词、取字、短语、
+ * 剪贴板粘贴全都收进来了。方案升级不会让它失效。
+ *
+ * 记录规则（都是为了让 10 条里全是「有用的词」）：
+ *  · 只收**纯汉字**（英文 / 数字 / 标点交给剪贴板，不进这里）；
+ *  · 长度 1~[MAX_LENGTH]；
+ *  · 单字要**限量**：默认只留 [MAX_SINGLE] 条，否则「的、是、我」几分钟就把列表刷满；
+ *    用户可以在设置里关掉单字（一条都不留）。
+ */
+object DahiRecentWords {
+    private const val KEY = "dahi_recent_words"
+    private const val SEP = "\u0001"
+    private const val MAX_LENGTH = 12
+
+    /** 整个列表里单字最多占几条。 */
+    private const val MAX_SINGLE = 3
+
+    private fun prefs() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    /** 最近使用（最新在前）。 */
+    fun list(): List<String> = prefs()
+        .getString(KEY, "")
+        .orEmpty()
+        .split(SEP)
+        .filter { it.isNotEmpty() }
+
+    /** 记一条上屏内容；不符合规则直接忽略。 */
+    fun record(raw: String) {
+        val cand = runCatching { AppPrefs.defaultInstance().candidates }.getOrNull() ?: return
+        if (!runCatching { cand.dahiRecentEnabled.getValue() }.getOrDefault(true)) return
+        val text = raw.trim()
+        if (text.isEmpty() || text.length > MAX_LENGTH) return
+        if (!text.all { isHanzi(it) }) return
+        if (text.length == 1 && !runCatching { cand.dahiRecentSingle.getValue() }.getOrDefault(true)) return
+        val limit = runCatching { cand.dahiRecentCount.getValue() }.getOrDefault(10).coerceIn(1, 50)
+        val items = list().toMutableList()
+        items.remove(text)
+        items.add(0, text)
+        var singles = items.count { it.length == 1 }
+        while (singles > MAX_SINGLE) {
+            val idx = items.indexOfLast { it.length == 1 }
+            if (idx < 0) break
+            items.removeAt(idx)
+            singles--
+        }
+        while (items.size > limit) items.removeAt(items.size - 1)
+        prefs().edit { putString(KEY, items.joinToString(SEP)) }
+    }
+
+    /** 从列表里去掉一条（展开列表里长按「忘记」用）。 */
+    fun remove(text: String) {
+        val items = list().toMutableList()
+        if (items.remove(text.trim())) {
+            prefs().edit { putString(KEY, items.joinToString(SEP)) }
+        }
+    }
+
+    private fun isHanzi(c: Char): Boolean = c.code in 0x4E00..0x9FFF || c.code in 0x3400..0x4DBF || c.code in 0xF900..0xFAFF
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiReport.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiReport.kt
new file mode 100644
index 0000000..076d622
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiReport.kt
@@ -0,0 +1,210 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import java.time.LocalDate
+import java.time.YearMonth
+import java.time.temporal.ChronoUnit
+
+/**
+ * 年度 / 月度报告的聚合。
+ *
+ * 数据全部来自已有的每日历史（[DahiDailyHistory]）与当前年份桶的词频，
+ * **不新增任何采集、不新增存储**：报告只是把已经记着的东西换个方式读一遍。
+ *
+ * 速度曲线：年度按「周」聚合、月度按「天」聚合。
+ * 每个点的均速 = 该区间字数 ÷ 该区间活跃时长 —— 用活跃时长而不是自然时间，
+ * 否则一天只打两分钟也会被摊成很低的数字，曲线就没有意义了。
+ */
+object DahiReport {
+    enum class Scope { YEAR, QUARTER, MONTH }
+
+    /** 速度曲线上的一个点。 */
+    data class Point(
+        val label: String,
+        val chars: Long,
+        val speed: Double,
+    )
+
+    data class Data(
+        val title: String,
+        val scope: Scope,
+        val chars: Long,
+        val commits: Long,
+        val activeMs: Long,
+        val avgSpeed: Double,
+        val peakSpeed: Double,
+        val days: Int,
+        val streak: Int,
+        val busiestDayLabel: String,
+        val busiestDayChars: Long,
+        val busiestHour: Int,
+        val lateDays: Int,
+        val topWords: List<Pair<String, Long>>,
+        val line: List<Point>,
+    ) {
+        val activeMinutes: Long get() = activeMs / 60_000L
+    }
+
+    /**
+     * 生成某年 / 某月的报告。
+     *
+     * [offset] 用于往后翻（0 = 当前年 / 当月，1 = 上一期），页面上的「上一期」按钮用它。
+     */
+    fun build(
+        ctx: Context,
+        scope: Scope,
+        offset: Int = 0,
+    ): Data {
+        val today = LocalDate.now()
+        val days =
+            runCatching { DahiDailyHistory.all(ctx) }
+                .getOrDefault(emptyList())
+                .filter { it.chars > 0L }
+
+        val (from, to, title) =
+            when (scope) {
+                Scope.YEAR -> {
+                    val year = today.year - offset
+                    Triple(LocalDate.of(year, 1, 1), LocalDate.of(year, 12, 31), "$year")
+                }
+
+                Scope.QUARTER -> {
+                    val base = YearMonth.of(today.year, ((today.monthValue - 1) / 3) * 3 + 1)
+                    val ym = base.minusMonths(3L * offset)
+                    Triple(
+                        ym.atDay(1),
+                        ym.plusMonths(2).atEndOfMonth(),
+                        "${ym.year} Q${(ym.monthValue - 1) / 3 + 1}",
+                    )
+                }
+
+                Scope.MONTH -> {
+                    val ym = YearMonth.from(today).minusMonths(offset.toLong())
+                    Triple(ym.atDay(1), ym.atEndOfMonth(), "%d-%02d".format(ym.year, ym.monthValue))
+                }
+            }
+
+        val picked =
+            days.mapNotNull { d ->
+                val date = runCatching { LocalDate.parse(d.date) }.getOrNull() ?: return@mapNotNull null
+                if (date.isBefore(from) || date.isAfter(to)) null else date to d
+            }
+
+        val chars = picked.sumOf { it.second.chars }
+        val commits = picked.sumOf { it.second.commits }
+        val activeMs = picked.sumOf { it.second.activeMs }
+        val avgSpeed = if (activeMs > 0) chars * 60_000.0 / activeMs else 0.0
+
+        // 最忙的一天
+        val busiest = picked.maxByOrNull { it.second.chars }
+        // 时段累加（0~23）
+        val hours = IntArray(24)
+        picked.forEach { (_, d) -> d.hours.forEachIndexed { h, v -> if (h in 0..23) hours[h] += v } }
+        // 注意 takeIf：hours 全是 0（例如只有老数据、没有小时明细）时，
+        // maxByOrNull 会返回下标 0，界面就会把「最忙时段」显示成 00:00–01:00。
+        // 这时候应当显示「—」，所以要有值大于 0 才认这个峰值小时。
+        val peakHour = hours.indices.maxByOrNull { hours[it] }?.takeIf { hours[it] > 0 } ?: -1
+        val lateDays =
+            picked.count {
+                DahiDailyHistory.isLateNightDay(it.second.peakHour, it.second.hours, it.second.chars)
+            }
+
+        // 连续天数（在所选区间内）
+        val sortedDates = picked.map { it.first }.sorted()
+        var streak = 0
+        var run = 0
+        var prev: LocalDate? = null
+        sortedDates.forEach { d ->
+            run = if (prev != null && ChronoUnit.DAYS.between(prev, d) == 1L) run + 1 else 1
+            if (run > streak) streak = run
+            prev = d
+        }
+
+        // 速度曲线：年 → 按周（ISO 周），季 → 按月，月 → 按天
+        val line =
+            when (scope) {
+                Scope.YEAR -> {
+                    val byWeek = linkedMapOf<Int, Pair<Long, Long>>()
+                    picked.forEach { (date, d) ->
+                        val week = date.get(java.time.temporal.WeekFields.ISO.weekOfWeekBasedYear())
+                        val old = byWeek[week] ?: (0L to 0L)
+                        byWeek[week] = (old.first + d.chars) to (old.second + d.activeMs)
+                    }
+                    byWeek.entries
+                        .sortedBy { it.key }
+                        .map { (week, v) ->
+                            Point(
+                                label = "W$week",
+                                chars = v.first,
+                                speed = if (v.second > 0) v.first * 60_000.0 / v.second else 0.0,
+                            )
+                        }
+                }
+
+                Scope.QUARTER -> {
+                    val byMonth = linkedMapOf<Int, Pair<Long, Long>>()
+                    picked.forEach { (date, d) ->
+                        val month = date.monthValue
+                        val old = byMonth[month] ?: (0L to 0L)
+                        byMonth[month] = (old.first + d.chars) to (old.second + d.activeMs)
+                    }
+                    byMonth.entries
+                        .sortedBy { it.key }
+                        .map { (month, v) ->
+                            Point(
+                                label = "%d月".format(month),
+                                chars = v.first,
+                                speed = if (v.second > 0) v.first * 60_000.0 / v.second else 0.0,
+                            )
+                        }
+                }
+
+                Scope.MONTH -> {
+                    picked
+                        .sortedBy { it.first }
+                        .map { (date, d) ->
+                            Point(
+                                label = "%02d".format(date.dayOfMonth),
+                                chars = d.chars,
+                                speed = if (d.activeMs > 0) d.chars * 60_000.0 / d.activeMs else 0.0,
+                            )
+                        }
+                }
+            }
+
+        // 十大高频词：取「本年」桶里的词频（词云没开时为空），并跳过被隐藏的词
+        val hidden = runCatching { DahiWordHidden.load(ctx) }.getOrDefault(emptySet())
+        val words =
+            runCatching { DahiInputStats.snapshot(DahiInputStats.Period.YEAR).wordFreq }
+                .getOrDefault(emptyMap())
+                .filterKeys { it !in hidden }
+                .entries
+                .sortedByDescending { it.value }
+                .take(10)
+                .map { it.key to it.value }
+
+        return Data(
+            title = title,
+            scope = scope,
+            chars = chars,
+            commits = commits,
+            activeMs = activeMs,
+            avgSpeed = avgSpeed,
+            peakSpeed = line.maxOfOrNull { it.speed } ?: 0.0,
+            days = picked.size,
+            streak = streak,
+            busiestDayLabel = busiest?.first?.toString().orEmpty(),
+            busiestDayChars = busiest?.second?.chars ?: 0L,
+            busiestHour = peakHour,
+            lateDays = lateDays,
+            topWords = words,
+            line = line,
+        )
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiRimeFreqExport.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiRimeFreqExport.kt
new file mode 100644
index 0000000..8d6184c
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiRimeFreqExport.kt
@@ -0,0 +1,612 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import com.osfans.trime.data.base.DataManager
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * 把「候选排序」导出成 **Rime 原生可用的调频词表**（大海版）。
+ *
+ * 背景：本应用的候选排序只存在于 App 层（`候选排序` 偏好），Rime 引擎与用户的方案词库
+ * 完全没被改动。于是手机上调好的顺序**带不到电脑端**，用户换了设备就得重排一遍。
+ *
+ * 但 Rime 的排序本质就是「同一个编码下按词条权重降序」，而权重既可以写在词库
+ * （`*.dict.yaml`），也可以写在用户词典（`*.userdb`，导入格式同为 `词<TAB>编码<TAB>权重`）。
+ * 所以只要把「编码 → 词序」翻译成「词 + 编码 + 权重」，电脑端就能吃到同一套顺序：
+ *
+ * - 电脑端小狼毫 / 鼠须管：「用户词典管理 → 导入词典」选本文件即可，不必手改 YAML；
+ * - 本应用 / 同文手机端：同一个入口也能导入。
+ *
+ * **唯一的技术难点是「编码」**：`候选排序` 记的是按键串（双拼如 `ni'hc`），
+ * 而 Rime 词条里的编码是音节拼写串（`ni hao`）。两者不能互转，所以这里**按词反查**：
+ * 流式扫一遍当前方案的主词库 `*.dict.yaml`，只保留排序表里出现过的词，
+ * 取出它自己的编码。也因此本文件**只对使用同一份词库的方案有效**
+ * （全拼 / 双拼共用一份词库的场景完全没问题）。
+ */
+object DahiRimeFreqExport {
+    /** 导出的结果。[reason] 用于让界面显示对应的提示，不在本类里碰资源。 */
+    data class Result(
+        val reason: Reason,
+        val text: String = "",
+        val fileName: String = "",
+        val dictName: String = "",
+        val schemaName: String = "",
+        val words: Int = 0,
+        val missed: Int = 0,
+        /** 实际尝试过的词库文件名（失败时给用户看，便于自查）。 */
+        val searched: List<String> = emptyList(),
+    ) {
+        val ok: Boolean get() = reason == Reason.OK
+    }
+
+    /** 导出格式。 */
+    enum class Format {
+        /** Rime 用户词典导入用：`词⇥编码⇥权重`（小狼毫「导入词典」直接吃）。 */
+        TXT,
+
+        /** 标准 Rime 词库：带 yaml 头的 `*.dict.yaml`，给「替换 / 合并词库」的场景用。 */
+        DICT_YAML,
+    }
+
+    enum class Reason {
+        /** 成功。 */
+        OK,
+
+        /** 还没有任何候选排序记录。 */
+        NO_ORDER,
+
+        /** 找不到当前方案的主词库源文件（有的方案只随包提供编译后的 .bin）。 */
+        NO_DICT,
+
+        /** 词库读完了，但排序表里的一个词都没匹配上。 */
+        NO_MATCH,
+    }
+
+    /** 排序第一名的权重。远大于常见词库权重（一般 < 1e5），确保整体压到最前。 */
+    private const val BASE_WEIGHT = 1_000_000.0
+
+    /** 相邻两名的权重差。名次越靠前权重越大，从而还原相对顺序。 */
+    private const val STEP = 100.0
+
+    // 允许中文目录名、`子目录/词库名` 这种带路径的写法（用户自建词库文件夹很常见）
+    private val DICT_RE = Regex("""^\s*dictionary:\s*["']?([^"'\s#]+)""")
+
+    /** 词库递归搜索的最大深度。用户自建词库常有 4~5 层（如 Chopper_词库/卿云23/零散词库/火影忍者/x）。 */
+    private const val MAX_DICT_SEARCH_DEPTH = 8
+
+    /** `import_tables` 向下展开的最大层数。 */
+    private const val MAX_IMPORT_DEPTH = 5
+
+    private val TIME_FORMAT = SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.US)
+
+    private val STAMP_FORMAT = SimpleDateFormat("yyyyMMdd-HHmm", Locale.US)
+
+    suspend fun build(format: Format = Format.TXT): Result = withContext(Dispatchers.IO) {
+        val orders = DahiCandidateOrder.entries()
+        if (orders.isEmpty()) return@withContext Result(Reason.NO_ORDER)
+
+        // 同一编码下「第几名」→ 词的优先级；一个词可能出现在多个编码下，取名次最好的那个
+        val ranks = HashMap<String, Int>()
+        orders.forEach { (_, list) ->
+            list.forEachIndexed { index, word ->
+                if (word.isEmpty()) return@forEachIndexed
+                val old = ranks[word]
+                if (old == null || index < old) ranks[word] = index
+            }
+        }
+        if (ranks.isEmpty()) return@withContext Result(Reason.NO_ORDER)
+
+        // 编码 → (词 → 名次)。用来实现「只导出用户真正调过的那个编码」：
+        //   形码（虎码 / 五笔 / 郑码）：按键串就是词库编码，能精确对上 → 只导那一条；
+        //   拼音类（双拼 ni'hc、词库 ni hao）：对不上 → 自动退回下面「按词」的老行为。
+        // 没有这一步时，虎码用户调了全码 amlzz，导出会把同词的简码 ama 也写成第一名，
+        // 等于污染了他没动过的简码。
+        val codeRanks = HashMap<String, HashMap<String, Int>>()
+        orders.forEach { (code, list) ->
+            val norm = normalizeCode(code)
+            if (norm.isEmpty()) return@forEach
+            val m = codeRanks.getOrPut(norm) { HashMap() }
+            list.forEachIndexed { index, word ->
+                if (word.isNotEmpty()) m.putIfAbsent(word, index)
+            }
+        }
+
+        val dirs = listOfNotNull(
+            runCatching { DataManager.userDataDir }.getOrNull(),
+            runCatching { DataManager.sharedDataDir }.getOrNull(),
+        )
+        // 方案 ID：优先取「上次按键时记录的」。刚装好还没在输入法里打过字时那里是空的，
+        // 于是退一步读 rime/user.yaml 的 previously_selected_schema。
+        // （此前就因为这个：用户装完新 APK 直接进设置页导出，schemaId 为空，
+        //   方案 yaml 根本没被解析，直接报「找不到方案「—」的词库源文件」。）
+        var schemaId = runCatching { DahiInputStats.activeSchemaId() }.getOrDefault("")
+        if (schemaId.isEmpty()) schemaId = schemaIdFromUserYaml(dirs)
+        // 一个方案 yaml 里往往有多个 `dictionary:`：translator 的主词库、reverse_lookup 的反查词库…
+        // 必须**优先主词库**——反查词库的编码是笔画/部首码，拿它导出的调频表导回主词库是无效的
+        // （此前「万象 pro 导出成功但文件名带 wanxiang_reverse」就是这么来的）。
+        val refs = dictionaryNames(schemaId, dirs)
+
+        val primaryFiles = refs.primary.mapNotNull { findDictFile(it, dirs) }.distinct()
+        val otherFiles =
+            (refs.others.mapNotNull { findDictFile(it, dirs) } +
+                listOfNotNull(findDictFile(schemaId, dirs)))
+                .distinct()
+                .filter { f -> primaryFiles.none { it.absolutePath == f.absolutePath } }
+        val files = primaryFiles + otherFiles
+
+        // 只看「像主词库」的候选：名字带 reverse / lookup / 符号表的一律排除。
+        // 反查词库同样包含全部词、命中数往往最多，以前的「取命中最多」会稳定选到它，
+        // 导出的编码变成部首/笔画码（如 PPSHSHHSN、heng'0），导回主词库完全无效。
+        var bestHits: List<Entry> = emptyList()
+        var bestMatched: Set<String> = emptySet()
+        var bestFile: File? = null
+        val good =
+            files
+                .filter { !isAuxDictName(it.name) }
+                .sortedByDescending { dictScore(schemaId, it) }
+        for (file in good) {
+            val hits = ArrayList<Entry>()
+            val matched = HashSet<String>()
+            collectDictChain(file, dirs).forEach { f ->
+                runCatching { scanDict(f, ranks, codeRanks, hits, matched) }
+            }
+            if (matched.size > bestMatched.size) {
+                bestHits = hits
+                bestMatched = matched
+                bestFile = file
+            }
+        }
+        // ---- 兜底：方案没解析出来、或一个词都没命中时，直接把 rime 目录下所有词库扫一遍 ----
+        // 无论用户的 schema 结构多特殊（`__include` / patch / 多级 translator@xxx）、
+        // 方案名与词库名对不上、甚至根本不知道当前是哪个方案，这一步都能把词找出来。
+        var scannedHint: List<String> = files.map { it.name }
+        if (bestMatched.isEmpty()) {
+            val all = allDictFiles(dirs).filter { !isAuxDictName(it.name) }
+            if (all.isNotEmpty()) {
+                scannedHint = all.map { it.name }
+                for (f in all) {
+                    val hits = ArrayList<Entry>()
+                    val matched = HashSet<String>()
+                    runCatching { scanDict(f, ranks, codeRanks, hits, matched) }
+                    if (matched.size > bestMatched.size) {
+                        bestHits = hits
+                        bestMatched = matched
+                        bestFile = f
+                    }
+                    // 排序表里的词全命中了，不必继续
+                    if (bestMatched.size >= ranks.size) break
+                }
+            }
+        }
+
+        val dictFile = bestFile
+            ?: return@withContext Result(
+                if (scannedHint.isEmpty()) Reason.NO_DICT else Reason.NO_MATCH,
+                dictName = scannedHint.take(6).joinToString("/"),
+                schemaName = schemaId.ifEmpty { "—" },
+                searched = scannedHint.take(30),
+            )
+        // 只要能按「编码」精确对上，就只保留这些条目；对不上（拼音类方案）才退回按词导全部编码。
+        val exactHits = bestHits.filter { it.exact }
+        val hits = ArrayList(if (exactHits.isNotEmpty()) exactHits else bestHits)
+        val matched = HashSet(hits.map { it.word })
+
+        if (hits.isEmpty()) {
+            return@withContext Result(
+                Reason.NO_MATCH,
+                dictName = dictFile.name,
+                schemaName = schemaId,
+                searched = files.map { it.name },
+            )
+        }
+
+        val missed = ranks.keys.filter { it !in matched }
+        val text = render(hits, missed, schemaId, baseNameOf(dictFile), format)
+        Result(
+            reason = Reason.OK,
+            text = text,
+            fileName =
+            if (format == Format.DICT_YAML) {
+                "${baseNameOf(dictFile)}_dahi_freq-${STAMP_FORMAT.format(Date())}.dict.yaml"
+            } else {
+                "dahi-rime-freq-${schemaId.ifEmpty { "rime" }}-${STAMP_FORMAT.format(Date())}.txt"
+            },
+            dictName = baseNameOf(dictFile),
+            schemaName = schemaId,
+            words = matched.size,
+            missed = missed.size,
+        )
+    }
+
+    /** `wanxiang.dict.yaml` → `wanxiang`（给人看的名字）。 */
+    private fun baseNameOf(file: File): String = file.name.removeSuffix(".yaml").removeSuffix(".yml").removeSuffix(".dict")
+
+    /** 导出文件里的一行词条。 */
+    /** 一条命中的词条。[exact] 表示「词库里的编码 == 用户实际调整的那个编码」。 */
+    private data class Entry(val word: String, val code: String, val rank: Int, val exact: Boolean = false)
+
+    /**
+     * 从 `<方案>.schema.yaml` 里读出**全部** `dictionary:` 值。
+     *
+     * 方案 yaml 里除了 `translator/dictionary`（主词库），通常还有
+     * `reverse_lookup/dictionary`（反查词库）等，全部收进来让上层逐个试。
+     */
+    /** 方案 yaml 里读到的词库引用。[primary] 是 `translator` 的主词库，[others] 是反查等。 */
+    private data class SchemaDicts(
+        val primary: List<String> = emptyList(),
+        val others: List<String> = emptyList(),
+    )
+
+    private fun dictionaryNames(
+        schemaId: String,
+        dirs: List<File>,
+    ): SchemaDicts {
+        if (schemaId.isEmpty()) return SchemaDicts()
+        val candidates = listOf("$schemaId.schema.yaml", "$schemaId.schema.yml")
+        val primary = LinkedHashSet<String>()
+        val others = LinkedHashSet<String>()
+        for (dir in dirs) {
+            for (name in candidates) {
+                val file = File(dir, name)
+                if (!file.isFile) continue
+                runCatching {
+                    // 跟踪当前所处的一级段落，从而区分 translator（主词库）与 reverse_lookup（反查）
+                    var section = ""
+                    file.useLines { lines ->
+                        lines.forEach { line ->
+                            val t = line.trim()
+                            if (t.isEmpty() || t.startsWith("#")) return@forEach
+                            val indented = line[0] == ' ' || line[0] == '\t'
+                            if (!indented) section = t.substringBefore(':').trim()
+                            val found = DICT_RE.find(line)?.groupValues?.get(1)
+                            if (!found.isNullOrEmpty()) {
+                                if (section == "translator") primary.add(found) else others.add(found)
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        return SchemaDicts(primary.toList(), others.toList())
+    }
+
+    /**
+     * 名字一看就是「反查 / 辅助」的词库，不是主词库。
+     *
+     * 这类词库同样收录全部词，命中数往往比主词库还多，所以要主动排除——
+     * 否则会导出反查码（部首 / 笔画 / 首字母，如 `PPSHSHHSN`、`heng'0`），
+     * 导回主词库毫无意义。
+     */
+    private fun isAuxDictName(name: String): Boolean {
+        val n = name.lowercase(Locale.US)
+        return n.contains("reverse") || n.contains("lookup") || n.contains("fancha") ||
+            n.contains("_sym") || n.contains("symbol") || n.contains("_emoji")
+    }
+
+    /** 候选词库的「像主词库」评分：越大越优先。 */
+    private fun dictScore(
+        schemaId: String,
+        file: File,
+    ): Int {
+        val n = file.name.removeSuffix(".yaml").removeSuffix(".yml").removeSuffix(".dict")
+        var score = 0
+        if (schemaId.isNotEmpty()) {
+            when {
+                n.equals(schemaId, ignoreCase = true) -> score += 4000
+                n.startsWith(schemaId, ignoreCase = true) ||
+                    schemaId.startsWith(n, ignoreCase = true) -> score += 2200
+            }
+        }
+        if (isAuxDictName(n)) score -= 6000
+        return score
+    }
+
+    /**
+     * 规范化编码：去掉空白、撇号、间隔号、下划线、连字符，统一小写。
+     *
+     * 目的只是让「用户按键串」与「词库编码」可比：
+     *   - 全拼按键 `nihao`   与词库 `ni hao` → 都能规范成 nihao；
+     *   - 双拼按键 `ni'hc`   规范成 nihc，与词库 ni hao 的 nihao 不同 → 自然判定为「对不上」；
+     *   - 虎码按键 `amlzz`   与词库 amlzz 完全一致。
+     * `;` `/` 这些是虎码字母表里的真实按键，不能删。
+     */
+    private fun normalizeCode(code: String): String =
+        buildString(code.length) {
+            code.forEach { c ->
+                when {
+                    c.isWhitespace() -> Unit
+                    c == '\'' || c == '`' || c == '_' || c == '-' -> Unit
+                    else -> append(c.lowercaseChar())
+                }
+            }
+        }
+
+    /** 从 rime/user.yaml 读「上次使用的方案」（刚装好、还没打过字时用）。 */
+    private fun schemaIdFromUserYaml(dirs: List<File>): String {
+        val re = Regex("""^\s*previously_selected_schema:\s*["']?([^"'\s#]+)""")
+        for (dir in dirs) {
+            val file = File(dir, "user.yaml")
+            if (!file.isFile) continue
+            val v = runCatching {
+                file.useLines { lines ->
+                    lines.firstNotNullOfOrNull { re.find(it)?.groupValues?.get(1) }
+                }
+            }.getOrNull()
+            if (!v.isNullOrEmpty()) return v
+        }
+        return ""
+    }
+
+    /** 递归收集 rime 目录下的全部词库源文件（兜底匹配用）。 */
+    private fun allDictFiles(dirs: List<File>): List<File> {
+        val out = LinkedHashSet<File>()
+        for (dir in dirs) {
+            if (!dir.isDirectory) continue
+            runCatching {
+                dir.walkTopDown()
+                    .maxDepth(MAX_DICT_SEARCH_DEPTH)
+                    .onEnter { it.name != "build" && !it.name.startsWith(".") }
+                    .forEach { f ->
+                        if (f.isFile && (f.name.endsWith(".dict.yaml") || f.name.endsWith(".dict.yml"))) {
+                            out += f
+                        }
+                    }
+            }
+        }
+        return out.toList()
+    }
+
+    /**
+     * 在用户目录 / 共享目录里找主词库源文件。
+     *
+     * 三步查找，覆盖真实用户会碰到的所有放法：
+     * 1. `dictionary:` 写的就是**带路径**的名字（`Chopper_词库/Chopper_Word5`）→ 直接按路径找；
+     * 2. 写在 rime 根目录（最常见，如 `wanxiang.dict.yaml`）；
+     * 3. **放在 rime 下的任意子文件夹里**（如 `rime/Chopper_词库/Chopper_Word5.dict.yaml`）→ 递归搜索。
+     *
+     * 第 3 步是为了解决「用户自建词库文件夹，调频导出提示一个词都没匹配到」的问题：
+     * 以前只认 rime 根目录的 `xxx.dict.yaml`，放在子目录里的词库一律找不到。
+     */
+    private fun findDictFile(
+        dictName: String?,
+        dirs: List<File>,
+    ): File? {
+        if (dictName.isNullOrEmpty()) return null
+        val direct = listOf("$dictName.dict.yaml", "$dictName.dict.yml")
+        for (dir in dirs) {
+            for (name in direct) {
+                val file = File(dir, name)
+                if (file.isFile) return file
+            }
+        }
+        // 裸名（去掉可能带的子路径）递归找
+        val bare = dictName.substringAfterLast('/').substringAfterLast('\\')
+        val bareNames = setOf("$bare.dict.yaml", "$bare.dict.yml")
+        for (dir in dirs) {
+            if (!dir.isDirectory) continue
+            val hit = runCatching {
+                dir.walkTopDown()
+                    .maxDepth(MAX_DICT_SEARCH_DEPTH)
+                    .onEnter { it.name != "build" && !it.name.startsWith(".") }
+                    .firstOrNull { it.isFile && it.name in bareNames }
+            }.getOrNull()
+            if (hit != null) return hit
+        }
+        return null
+    }
+
+    /**
+     * 展开「词库引用链」：主词库常见写法是只在头部 `import_tables:` 里列几个子词库，
+     * 词条本体全在子词库里（万象、白霜、以及用户自建的分文件词库都这么干）。
+     * 只扫主词库会一个词都匹配不到，所以沿 `import_tables` 往下走 3 层。
+     */
+    private fun collectDictChain(
+        root: File,
+        dirs: List<File>,
+        depth: Int = 0,
+    ): List<File> {
+        val result = mutableListOf(root)
+        if (depth >= MAX_IMPORT_DEPTH) return result
+        parseImportTables(root).forEach { name ->
+            val child = findDictFile(name, dirs) ?: return@forEach
+            if (result.none { it.absolutePath == child.absolutePath }) {
+                result += collectDictChain(child, dirs, depth + 1)
+            }
+        }
+        return result.distinct()
+    }
+
+    /**
+     * 从词库 YAML 头部读 `import_tables:`（兼容行内数组与 `- xxx` 列表两种写法）。
+     *
+     * 真实词库里这个列表**几乎一定夹着注释和空行**：
+     * ```
+     * import_tables:
+     *   # 绝密
+     *   - Chopper_词库/卿云23/绝密/chopper_secret
+     *
+     *   # 常用短码单字
+     *   - Chopper_词库/卿云23/chopper_10_common_chars1
+     * ```
+     * 旧写法一遇到注释行就结束收集，结果一条引用都拿不到——这正是「主词库只写
+     * import_tables、词条全在子词库」的用户导出时一个词都匹配不上的真正原因。
+     * 现在：注释与空行直接跳过，只有**无缩进的顶层键**才结束本段。
+     */
+    private fun parseImportTables(file: File): List<String> {
+        val out = mutableListOf<String>()
+        var inBody = false
+        var inImports = false
+        runCatching {
+            file.bufferedReader(Charsets.UTF_8).use { reader ->
+                var count = 0
+                while (count++ < 400) {
+                    val raw = reader.readLine() ?: break
+                    val t = raw.trim()
+                    val indented = raw.isNotEmpty() && (raw[0] == ' ' || raw[0] == '\t')
+                    when {
+                        t == "---" -> inBody = true
+                        t == "..." -> {
+                            inBody = false
+                            inImports = false
+                        }
+                        !inBody -> Unit
+                        t.isEmpty() || t.startsWith("#") -> Unit
+                        t.startsWith("import_tables:") -> {
+                            val inline = t.removePrefix("import_tables:").trim()
+                            if (inline.startsWith("[")) {
+                                inline.substringBefore("]").trim('[', ']').split(',').forEach {
+                                    val v = it.substringBefore('#').trim().trim('"', '\'')
+                                    if (v.isNotEmpty()) out += v
+                                }
+                            } else {
+                                inImports = true
+                            }
+                        }
+                        inImports && t.startsWith("-") -> {
+                            // 必须去掉行尾注释：万象这类词库写的是
+                            //   - dicts/zi.pro      #字表，包含了所有带拼音的汉字
+                            // 不截断的话整段中文会被当成文件名，一个子词库都打不开。
+                            val v = t.removePrefix("-").substringBefore('#').trim().trim('"', '\'')
+                            if (v.isNotEmpty()) out += v
+                        }
+                        inImports && !indented -> inImports = false
+                    }
+                }
+            }
+        }
+        return out
+    }
+
+    /**
+     * 流式扫描词库，收集命中词的 `词 / 编码 / 名次`。
+     *
+     * 词库可能有几十 MB（十万级词条），因此**逐行读、只留命中项**，
+     * 内存占用与「排序表里的词数」成正比，与词库大小无关。
+     */
+    private fun scanDict(
+        file: File,
+        ranks: Map<String, Int>,
+        codeRanks: Map<String, Map<String, Int>>,
+        hits: MutableList<Entry>,
+        matched: MutableSet<String>,
+    ) {
+        var bodyStarted = false
+        var inYamlHeader = false
+        val seen = HashSet<String>()
+        file.bufferedReader(Charsets.UTF_8).use { reader ->
+            while (true) {
+                val line = reader.readLine() ?: break
+                if (line.isEmpty()) continue
+                if (line.startsWith("#")) continue
+                if (!bodyStarted) {
+                    val trimmed = line.trim()
+                    if (trimmed == "---" && !inYamlHeader) {
+                        inYamlHeader = true
+                        continue
+                    }
+                    if (inYamlHeader) {
+                        // 头部以单独一行 `...` 结束；头部之内全是 name/version 之类的元信息
+                        if (trimmed == "...") {
+                            inYamlHeader = false
+                            bodyStarted = true
+                        }
+                        continue
+                    }
+                    if (trimmed.isEmpty() || trimmed == "...") continue
+                    // 没有 YAML 头部的词库：除 `键: 值` 形态外，第一行就是词条
+                    if (trimmed.startsWith("name:") || trimmed.startsWith("version:") || trimmed.startsWith("sort:")) {
+                        continue
+                    }
+                    bodyStarted = true
+                }
+                val parts = line.split('\t')
+                if (parts.size < 2) continue
+                val word = parts[0].trim()
+                val code = parts[1].trim()
+                if (word.isEmpty() || code.isEmpty()) continue
+                val rank = ranks[word] ?: continue
+                if (!seen.add(word + '\u0000' + code)) continue
+                val exactRank = codeRanks[normalizeCode(code)]?.get(word)
+                hits.add(Entry(word, code, exactRank ?: rank, exactRank != null))
+                matched.add(word)
+            }
+        }
+    }
+
+    /** 生成导入用文本（`词<TAB>编码<TAB>权重`）。 */
+    private fun render(
+        hits: List<Entry>,
+        missed: List<String>,
+        schemaId: String,
+        dictName: String,
+        format: Format,
+    ): String {
+        val sb = StringBuilder(64 * 1024)
+        sb.append("# Rime 调频词表 · 由「同文输入法大海版」导出\n")
+        sb.append("# 生成时间：").append(TIME_FORMAT.format(Date())).append('\n')
+        sb.append("# 输入方案：").append(schemaId.ifEmpty { "—" })
+            .append("    词库：").append(dictName).append('\n')
+        sb.append("#\n")
+        sb.append("#\n")
+        when (format) {
+            Format.TXT -> {
+                sb.append("# 用法：\n")
+                sb.append("#   电脑端小狼毫 / 鼠须管：用户词典管理 → 选中该方案 → 导入词典 → 选本文件。\n")
+                sb.append("#   本应用：设置 → 用户词典 → 对应方案 → 导入词典 → 选本文件。\n")
+                sb.append("#   导入后重新部署（或直接开始输入）即可看到与手机一致的顺序。\n")
+                sb.append("#\n")
+                sb.append("# 注意：带辅助码的方案（如万象 Pro，编码形如 yī;hq）若导入后没效果，\n")
+                sb.append("#   请改用「导出为 YAML」那份文件，用法写在那份文件的开头。\n")
+            }
+            Format.DICT_YAML -> {
+                sb.append("# 用法（推荐，对带辅助码的方案最稳）：\n")
+                sb.append("#   1) 把本文件复制到电脑端 rime 用户目录（小狼毫：右键托盘图标 → 用户文件夹），\n")
+                sb.append("#      并把文件名改成 ").append(dictName).append("_dahi_freq.dict.yaml（去掉 -日期-时间 那段）；\n")
+                sb.append("#   2) 打开 ").append(dictName.ifEmpty { "主词库" }).append(".dict.yaml，\n")
+                sb.append("#      在它的 import_tables: 列表**最后**加一行：\n")
+                sb.append("#        - ").append(dictName).append("_dahi_freq\n")
+                sb.append("#      （保持同样缩进；放最后，权重才会盖过原词库）\n")
+                sb.append("#   3) 重新部署，之后打这些词就会按手机上的顺序来。\n")
+                sb.append("#\n")
+                sb.append("# 词库更新后：万象等方案升级词库会整个替换主词库文件，\n")
+                sb.append("# 上面那一行会被清掉 —— 重新加一次再部署即可，本文件不用改。\n")
+            }
+        }
+        sb.append("#\n")
+        sb.append("# 注意：只在电脑端与手机使用**同一份词库**时编码才一致；\n")
+        sb.append("#       换成别的词库，编码不同，需要在那一端重新导出一次。\n")
+        sb.append("#\n")
+        sb.append("# 词<tab>编码<tab>权重\n")
+        if (format == Format.DICT_YAML) {
+            // 标准词库头：name 用「原词库名_dahi_freq」，避免与原词库同名互相覆盖
+            sb.append("---\n")
+            sb.append("name: ").append(dictName).append("_dahi_freq\n")
+            sb.append("version: \"1.0\"\n")
+            sb.append("sort: by_weight\n")
+            sb.append("use_preset_vocabulary: false\n")
+            sb.append("...\n")
+        }
+        hits.sortedWith(compareBy({ it.rank }, { it.word })).forEach { e ->
+            val weight = BASE_WEIGHT - e.rank * STEP
+            sb.append(e.word).append('\t').append(e.code).append('\t')
+            sb.append(String.format(Locale.US, "%.0f", weight.coerceAtLeast(1.0))).append('\n')
+        }
+        if (missed.isNotEmpty()) {
+            sb.append("#\n")
+            sb.append("# 以下 ").append(missed.size)
+                .append(" 个词在当前词库里找不到（多半是自定义短语或词库外的词），未写入：\n")
+            missed.take(200).forEach { sb.append("#   ").append(it).append('\n') }
+            if (missed.size > 200) sb.append("#   …（仅列出前 200 个）\n")
+        }
+        return sb.toString()
+    }
+}
