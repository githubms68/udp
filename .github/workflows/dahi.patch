new file mode 100644
index 0000000..ea5c8ad
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/data/backup/DahiAutoBackup.kt
@@ -0,0 +1,204 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.backup
+
+import android.content.Context
+import com.osfans.trime.data.db.ClipboardHelper
+import com.osfans.trime.data.db.CollectionHelper
+import com.osfans.trime.util.appContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.Json
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * 自动备份：把剪贴板与收藏夹定期存一份到 App 私有目录。
+ *
+ * 为什么是明文而不是加密：
+ * - 自动备份的价值在于**免密**。每次恢复都要输密码，用户就不会去看它，
+ *   真出事时也来不及找密码；
+ * - 文件放在 `filesDir/auto_backup/`，Android 10+ 其它应用无法读取，
+ *   不上传、不导出、不联网（本应用本来就没有网络权限）；
+ * - 手动导出的备份仍然走加密（[BackupManager]），那条路径是对外的。
+ *
+ * 三类文件：
+ * - `auto-*.json`：每日自动备份，保留最近 [DAILY_KEEP] 份；
+ * - `snap-*.json`：危险操作前的快照（清理、还原），保留最近 [SNAPSHOT_KEEP] 份。
+ */
+object DahiAutoBackup {
+    private const val DIR = "auto_backup"
+    const val DEFAULT_DAILY_KEEP = 3
+    const val DEFAULT_SNAPSHOT_KEEP = 5
+
+    private val dailyKeep: Int
+        get() = runCatching {
+            com.osfans.trime.data.prefs.AppPrefs.defaultInstance().profile.dahiAutoBackupKeepDaily
+                .getValue().coerceIn(1, 20)
+        }.getOrDefault(DEFAULT_DAILY_KEEP)
+
+    private val snapshotKeep: Int
+        get() = runCatching {
+            com.osfans.trime.data.prefs.AppPrefs.defaultInstance().profile.dahiAutoBackupKeepSnapshot
+                .getValue().coerceIn(1, 20)
+        }.getOrDefault(DEFAULT_SNAPSHOT_KEEP)
+    private const val DAY_MS = 24L * 3600 * 1000
+
+    private val json =
+        Json {
+            prettyPrint = false
+            encodeDefaults = true
+            ignoreUnknownKeys = true
+        }
+
+    /** 一条备份记录（给 UI 用）。 */
+    data class Item(
+        val file: File,
+        val time: Long,
+        val sizeBytes: Long,
+        val isSnapshot: Boolean,
+        /** 触发原因，仅快照有（如「清理前」「还原前」）。 */
+        val reason: String?,
+    )
+
+    private fun dir(ctx: Context = appContext): File =
+        File(ctx.filesDir, DIR).apply { if (!exists()) mkdirs() }
+
+    private fun stamp(now: Long = System.currentTimeMillis()): String =
+        SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(Date(now))
+
+    /** 生成一份备份文件；[reason] 非空表示这是危险操作前的快照。 */
+    private suspend fun write(
+        reason: String? = null,
+    ): File? =
+        withContext(Dispatchers.IO) {
+            runCatching {
+                val data =
+                    BackupData(
+                        timestamp = System.currentTimeMillis(),
+                        appVersion = null,
+                        clipboard = ClipboardHelper.exportBeans().map { it.toBackupBean() },
+                        collection = CollectionHelper.exportBeans().map { it.toBackupBean() },
+                    )
+                // 剪贴板为空时没必要落盘（新装、刚清空）
+                if (data.clipboard.isNullOrEmpty() && data.collection.isNullOrEmpty()) return@runCatching null
+                val prefix = if (reason == null) "auto" else "snap-${reason}"
+                val f = File(dir(), "$prefix-${stamp()}.json")
+                f.writeText(json.encodeToString(BackupData.serializer(), data))
+                prune(reason == null)
+                f
+            }.getOrNull()
+        }
+
+    /** 每日自动备份：距上次超过 24 小时才写。 */
+    suspend fun maybeRunDaily() {
+        if (!isEnabled()) return
+        val last = lastAutoTime()
+        if (System.currentTimeMillis() - last < DAY_MS) return
+        write(null)
+    }
+
+    /** 危险操作前立即存一份（清理 / 还原）。 */
+    suspend fun snapshot(reason: String) {
+        if (!isEnabled()) return
+        write(reason)
+    }
+
+    fun isEnabled(): Boolean =
+        runCatching {
+            com.osfans.trime.data.prefs.AppPrefs.defaultInstance().profile.dahiAutoBackup.getValue()
+        }.getOrDefault(true)
+
+    /** 全部备份记录，按时间从新到旧。 */
+    fun list(): List<Item> =
+        runCatching {
+            dir()
+                .listFiles()
+                ?.filter { it.isFile && it.name.endsWith(".json") }
+                ?.mapNotNull { f ->
+                    val isSnapshot = f.name.startsWith("snap-")
+                    val reason =
+                        if (isSnapshot) {
+                            f.name.removePrefix("snap-").substringBeforeLast('-')
+                        } else {
+                            null
+                        }
+                    // 时间取文件名里的时间戳；解析失败就退回文件修改时间
+                    val t =
+                        runCatching {
+                            SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US)
+                                .parse(f.name.substringAfterLast('-').removeSuffix(".json"))
+                                ?.time
+                        }.getOrNull() ?: f.lastModified()
+                    Item(f, t, f.length(), isSnapshot, reason)
+                }?.sortedByDescending { it.time }
+                .orEmpty()
+        }.getOrDefault(emptyList())
+
+    /** 从某份自动备份恢复（覆盖式，走 ClipboardHelper.restoreBeans 的合并保护）。 */
+    suspend fun restore(item: Item): Boolean =
+        withContext(Dispatchers.IO) {
+            runCatching {
+                val data = json.decodeFromString(BackupData.serializer(), item.file.readText())
+                // 恢复前先给自己留一份，免得恢复错了没退路
+                write("restore")
+                data.clipboard?.let { beans -> ClipboardHelper.restoreBeans(beans.map { it.toBean() }) }
+                data.collection?.let { beans -> CollectionHelper.restoreBeans(beans.map { it.toBean() }) }
+                true
+            }.getOrDefault(false)
+        }
+
+    /** 立即备份一次（用户手动点）。 */
+    suspend fun backupNow(): Boolean = write(null) != null
+
+    private fun lastAutoTime(): Long =
+        list().firstOrNull { !it.isSnapshot }?.time ?: 0L
+
+    /** 清理超出保留份数的旧文件。 */
+    private fun prune(daily: Boolean) {
+        val items = list()
+        val keep = if (daily) dailyKeep else snapshotKeep
+        val group = items.filter { it.isSnapshot == !daily }
+        group.drop(keep).forEach { runCatching { it.file.delete() } }
+    }
+
+    /** 清空全部自动备份（设置页提供，便于隐私清理）。 */
+    fun clearAll(): Int {
+        val items = list()
+        var n = 0
+        items.forEach { if (runCatching { it.file.delete() }.getOrDefault(false)) n++ }
+        return n
+    }
+
+    private fun com.osfans.trime.data.db.DatabaseBean.toBackupBean() =
+        BackupBean(
+            text = text,
+            html = html,
+            type = type.name,
+            time = time,
+            pinned = pinned,
+            orderIndex = orderIndex,
+            category = category,
+            useCount = useCount,
+        )
+
+    private fun BackupBean.toBean() =
+        com.osfans.trime.data.db.DatabaseBean(
+            text = text,
+            html = html,
+            type =
+                runCatching { com.osfans.trime.data.db.DatabaseBean.BeanType.valueOf(type) }
+                    .getOrDefault(com.osfans.trime.data.db.DatabaseBean.BeanType.TEXT),
+            time = time,
+            pinned = pinned,
+            orderIndex = orderIndex,
+            category = category,
+            useCount = useCount,
+        )
+}
diff --git a/app/src/main/java/com/osfans/trime/data/backup/DahiPlainExport.kt b/app/src/main/java/com/osfans/trime/data/backup/DahiPlainExport.kt
new file mode 100644
index 0000000..1ecc4cb
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/data/backup/DahiPlainExport.kt
@@ -0,0 +1,264 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.backup
+
+import android.content.Context
+import androidx.preference.PreferenceManager
+import com.osfans.trime.R
+import com.osfans.trime.data.db.ClipboardHelper
+import com.osfans.trime.data.db.CollectionHelper
+import com.osfans.trime.data.db.DatabaseBean
+import com.osfans.trime.data.userdict.UserDictManager
+import com.osfans.trime.ime.custom.DahiCandidateOrder
+import com.osfans.trime.ime.custom.DahiCustomPhrase
+import com.osfans.trime.ime.custom.DahiInputStats
+import com.osfans.trime.util.appContext
+import java.io.ByteArrayOutputStream
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * **明文导出**（大海版）。
+ *
+ * 与 [BackupManager] 的分工：
+ * - 备份是**加密**的二进制文件，只能在 App 里还原；
+ * - 这里导出的是**明文**，目的是「拿到电脑上用」：记事本打开能读、Excel 能开、rime 能直接用。
+ *
+ * 安全边界必须说清楚（界面上也会提示）：
+ * 导出**之前**没有任何风险 —— 数据只在本应用的私有目录里，备份文件也是加密的；
+ * 风险从**文件落盘那一刻**开始 —— 明文文件放在「下载」目录，任何有存储权限的应用
+ * （文件管理器、云盘自动备份、相册扫描等）都可能读到它。所以导出后请及时删除。
+ */
+object DahiPlainExport {
+    /** 导出内容。 */
+    enum class Section(val id: String, val labelRes: Int) {
+        CLIPBOARD("clipboard", R.string.dahi_backup_clipboard),
+        COLLECTION("collection", R.string.dahi_backup_collection),
+        PHRASE("phrase", R.string.dahi_backup_custom_phrase),
+        STATS("stats", R.string.dahi_backup_stats),
+        ORDER("order", R.string.dahi_backup_cand_order),
+        USERDICT("userdict", R.string.dahi_plain_userdict),
+    }
+
+    /** 导出格式。 */
+    enum class Format {
+        /** 单个文本文件，分段 + 便于阅读。 */
+        TXT,
+
+        /** 单个 CSV，便于 Excel / 表格处理。 */
+        CSV,
+
+        /** rime `custom_phrase` 可直接使用：`正文 <TAB> 编码 <TAB> 权重`。 */
+        PHRASE_RIME,
+    }
+
+    private val TIME_FORMAT = SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.US)
+
+    /** 生成导出内容（纯文本）。 */
+    suspend fun build(
+        ctx: Context,
+        sections: Set<Section>,
+        format: Format,
+    ): String {
+        val now = TIME_FORMAT.format(Date())
+        if (format == Format.PHRASE_RIME) return rimePhrases()
+        return if (format == Format.CSV) buildCsv(ctx, sections, now) else buildTxt(ctx, sections, now)
+    }
+
+    /** 建议的文件名。 */
+    fun fileName(format: Format): String {
+        val stamp = SimpleDateFormat("yyyyMMdd-HHmm", Locale.US).format(Date())
+        return when (format) {
+            Format.TXT -> "dahi-export-$stamp.txt"
+            Format.CSV -> "dahi-export-$stamp.csv"
+            Format.PHRASE_RIME -> "dahi-custom_phrase-$stamp.txt"
+        }
+    }
+
+    // ------------------------------------------------------------------ TXT
+
+    private suspend fun buildTxt(
+        ctx: Context,
+        sections: Set<Section>,
+        now: String,
+    ): String {
+        val sb = StringBuilder()
+        sb.append("# ").append(ctx.getString(R.string.dahi_plain_header)).append('\n')
+        sb.append("# ").append(ctx.getString(R.string.dahi_plain_time)).append(": ").append(now).append('\n')
+        sb.append("# ").append(ctx.getString(R.string.dahi_plain_warning)).append('\n').append('\n')
+
+        if (Section.CLIPBOARD in sections) {
+            val beans = ClipboardHelper.exportBeans()
+            sb.append("==== ").append(ctx.getString(R.string.dahi_backup_clipboard))
+                .append(" (").append(beans.size).append(") ====\n")
+            beans.forEachIndexed { index, bean ->
+                sb.append('[').append(index + 1).append("] ")
+                    .append(TIME_FORMAT.format(Date(bean.time)))
+                    .append("  ").append(bean.type.name)
+                bean.category?.takeIf { it.isNotEmpty() }?.let { sb.append("  ").append(it) }
+                if (bean.pinned) sb.append("  ★")
+                sb.append('\n').append(bean.text.orEmpty()).append("\n\n")
+            }
+        }
+
+        if (Section.COLLECTION in sections) {
+            val beans = CollectionHelper.exportBeans()
+            sb.append("==== ").append(ctx.getString(R.string.dahi_backup_collection))
+                .append(" (").append(beans.size).append(") ====\n")
+            beans.forEachIndexed { index, bean ->
+                sb.append('[').append(index + 1).append("] ")
+                    .append(TIME_FORMAT.format(Date(bean.time)))
+                    .append("  ").append(bean.type.name)
+                bean.category?.takeIf { it.isNotEmpty() }?.let { sb.append("  ").append(it) }
+                sb.append('\n').append(bean.text.orEmpty()).append("\n\n")
+            }
+        }
+
+        if (Section.PHRASE in sections) {
+            val entries = DahiCustomPhrase.entries()
+            sb.append("==== ").append(ctx.getString(R.string.dahi_backup_custom_phrase))
+                .append(" (").append(entries.size).append(") ====\n")
+            entries.forEach { (code, text) -> sb.append(code).append(" → ").append(text).append('\n') }
+            sb.append('\n')
+        }
+
+        if (Section.STATS in sections) {
+            sb.append("==== ").append(ctx.getString(R.string.dahi_backup_stats)).append(" ====\n")
+            sb.append(DahiInputStats.exportJson()).append("\n\n")
+        }
+
+        if (Section.ORDER in sections) {
+            sb.append("==== ").append(ctx.getString(R.string.dahi_backup_cand_order)).append(" ====\n")
+            sb.append(candidateOrderJson()).append("\n\n")
+        }
+
+        if (Section.USERDICT in sections) {
+            sb.append("==== ").append(ctx.getString(R.string.dahi_plain_userdict)).append(" ====\n")
+            userDicts().forEach { (dict, lines) ->
+                sb.append("---- ").append(dict).append(" (").append(lines.size).append(") ----\n")
+                lines.forEach { line -> sb.append(line).append('\n') }
+                sb.append('\n')
+            }
+        }
+        return sb.toString()
+    }
+
+    // ------------------------------------------------------------------ CSV
+
+    private suspend fun buildCsv(
+        ctx: Context,
+        sections: Set<Section>,
+        now: String,
+    ): String {
+        val sb = StringBuilder()
+        // BOM：让 Excel 直接按 UTF-8 打开，不然中文全是乱码
+        sb.append('\uFEFF')
+        sb.append("type,index,time,category,code,pinned,text\n")
+
+        if (Section.CLIPBOARD in sections) {
+            appendBeans(sb, "clipboard", ClipboardHelper.exportBeans())
+        }
+        if (Section.COLLECTION in sections) {
+            appendBeans(sb, "collection", CollectionHelper.exportBeans())
+        }
+        if (Section.PHRASE in sections) {
+            DahiCustomPhrase.entries().forEachIndexed { index, (code, text) ->
+                sb.append("phrase,").append(index + 1).append(',')
+                    .append(csv(now)).append(',')
+                    .append(csv("")).append(',')
+                    .append(csv(code)).append(',')
+                    .append("false,")
+                    .append(csv(text)).append('\n')
+            }
+        }
+        if (Section.STATS in sections) {
+            sb.append("stats,1,").append(csv(now)).append(",,,false,")
