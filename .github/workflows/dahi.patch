+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.clipboard
+
+import android.content.Context
+import android.util.TypedValue
+import android.view.ViewGroup
+import android.widget.ScrollView
+import android.widget.TextView
+import com.osfans.trime.R
+import com.osfans.trime.ime.core.TrimeInputMethodService
+import com.osfans.trime.ime.custom.DahiKeyEffectBus
+
+/**
+ * 「查看全文」弹窗。
+ *
+ * 为什么放在长按菜单里，而不是给条目加个新手势：
+ * 条目上现有三种操作已经占满了手势 ——
+ *   单击 = 上屏、长按 = 弹菜单、左侧把手拖动 = 排序。
+ * 再加双击 / 滑动之类，要么给上屏引入延迟，要么和拖拽抢事件，
+ * 都会把「打字时最常用的动作」变慢。而「看全文」本身是低频操作，
+ * 多进一层菜单完全可以接受，且零冲突。
+ *
+ * 用 [TrimeInputMethodService.showDialog] 而不是 `AlertDialog.show()`：
+ * 输入法自己的窗口没有 Activity 的 window token，直接 show 会 BadTokenException。
+ */
+internal fun showFullTextDialog(
+    ctx: Context,
+    service: TrimeInputMethodService,
+    text: String,
+) {
+    if (text.isEmpty()) return
+    val density = ctx.resources.displayMetrics.density
+    fun dp(value: Int): Int = (value * density + 0.5f).toInt()
+
+    val body =
+        TextView(ctx).apply {
+            setText(text)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+            setPadding(dp(18), dp(12), dp(18), dp(12))
+            // 选中态与可滚动由 setTextIsSelectable 一并处理。
+            // 注意必须直接调方法：Kotlin 把这一对 getter/setter 合成为 `textIsSelectable`，
+            // 写成 isTextSelectable = true 会报 "'val' cannot be reassigned"。
+            setTextIsSelectable(true)
+        }
+    val scroll =
+        ScrollView(ctx).apply {
+            addView(
+                body,
+                ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
+            )
+        }
+
+    val dialog =
+        android.app.AlertDialog
+            .Builder(ctx)
+            .setTitle(ctx.getString(R.string.dahi_cp_full_text))
+            .setView(scroll)
+            .setPositiveButton(R.string.dahi_cp_send_to_host) { _, _ ->
+                // 全文上屏：看完就能直接用，不必退出弹窗再去点条目
+                DahiKeyEffectBus.expectClipboard()
+                runCatching { service.commitText(text) }
+            }.setNegativeButton(android.R.string.cancel, null)
+            .create()
+    runCatching { service.showDialog(dialog) }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/clipboard/ClipboardItemMenu.kt b/app/src/main/java/com/osfans/trime/ime/clipboard/ClipboardItemMenu.kt
new file mode 100644
index 0000000..ce021f5
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/clipboard/ClipboardItemMenu.kt
@@ -0,0 +1,148 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.clipboard
+
+import android.content.Context
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.view.View
+import android.widget.PopupMenu
+import com.osfans.trime.R
+import com.osfans.trime.data.db.DatabaseBean
+import com.osfans.trime.util.DeviceUtils
+import com.osfans.trime.util.item
+import splitties.resources.styledColor
+
+/** 剪贴板 / 收藏夹条目的操作集合（长按菜单用）。 */
+internal interface ClipboardItemActions {
+    fun onEdit(id: Int)
+
+    fun onShare(bean: DatabaseBean)
+
+    fun onSegment(bean: DatabaseBean)
+
+    fun onCollect(bean: DatabaseBean) = Unit
+
+    fun onPin(id: Int)
+
+    fun onUnpin(id: Int)
+
+    fun onDelete(id: Int)
+
+    fun onSetCustomPhrase(bean: DatabaseBean) = Unit
+
+    fun onSetCategory(
+        bean: DatabaseBean,
+        anchor: View,
+    ) = Unit
+
+    /** 「批量选择」：以该条目为起点进入批量模式。 */
+    fun onBatchSelect(bean: DatabaseBean) = Unit
+
+    /** 「查看全文」：条目被截断时，用弹窗看完整内容。 */
+    fun onViewFull(bean: DatabaseBean) = Unit
+}
+
+/**
+ * 统一构建「剪贴板 / 收藏夹条目」长按菜单。
+ *
+ * 剪贴板窗口与搜索结果浮层共用同一份逻辑，保证两处的操作**完全一致**：
+ * 编辑 / 分享 / 分词 / 收藏 / 置顶（取消置顶）/ 设置分类 / 删除 / 设为自定义短语。
+ */
+/** 超过这个字数就认为「可能看不全」，菜单里给一个「查看全文」。 */
+private const val FULL_TEXT_HINT_THRESHOLD = 48
+
+internal fun showClipboardItemMenu(
+    ctx: Context,
+    anchor: View,
+    bean: DatabaseBean,
+    enableCollection: Boolean,
+    supportsCategory: Boolean,
+    actions: ClipboardItemActions,
+    allowBatch: Boolean = false,
+): PopupMenu {
+    val popup = PopupMenu(ctx, anchor)
+    // 让菜单**不抢焦点**。
+    //
+    // PopupMenu 默认是一个 focusable 的独立窗口，弹出的瞬间输入法窗口会失去焦点，
+    // ima / 应用内「输入测试」这类宿主据此把输入法窗口收起；我们再要回来时，
+    // InputConnection 已指向「被收起前」的输入框 —— 之后所有提交都返回成功但内容被丢掉
+    // （现象：长按条目 →「批量」→ 之后单条 / 批量拼接都提示已上屏、框里没字）。
+    // 非 focusable 的 PopupWindow 仍然能接收点击，只是不抢焦点，宿主也就不会收键盘。
+    runCatching {
+        val f = PopupMenu::class.java.getDeclaredField("mPopup")
+        f.isAccessible = true
+        (f.get(popup) as? android.widget.PopupWindow)?.apply {
+            isFocusable = false
+            isOutsideTouchable = true
+        }
+    }
+    val menu = popup.menu
+    val iconTint = ctx.styledColor(android.R.attr.colorControlNormal)
+    // 顺序（从上到下）：
+    //   编辑 / 分享 / 分词 / 收藏 / 置顶 / 批量 / 删除 / 设置分类 / 设为自定义短语
+    // 收藏夹页（enableCollection = false）自动少一项「收藏」。
+    menu.item(R.string.edit, R.drawable.ic_baseline_edit_24, iconTint) {
+        actions.onEdit(bean.id)
+    }
+    menu.item(R.string.share, R.drawable.ic_baseline_share_24, iconTint) {
+        actions.onShare(bean)
+    }
+    menu.item(R.string.word_segment, R.drawable.ic_baseline_view_comfy_24, iconTint) {
+        actions.onSegment(bean)
+    }
+    if (enableCollection) {
+        menu.item(R.string.collect, R.drawable.ic_baseline_star_24, iconTint) {
+            actions.onCollect(bean)
+        }
+    }
+    if (bean.pinned) {
+        menu.item(R.string.simple_key_unpin, R.drawable.ic_outline_push_pin_24, iconTint) {
+            actions.onUnpin(bean.id)
+        }
+    } else {
+        menu.item(R.string.simple_key_pin, R.drawable.ic_baseline_push_pin_24, iconTint) {
+            actions.onPin(bean.id)
+        }
+    }
+    if (allowBatch) {
+        menu.item(R.string.dahi_cp_batch_mode, R.drawable.ic_baseline_checklist_24, iconTint) {
+            // 两点都很关键：
+            // 1) 不要手动 popup.dismiss()：点击项之后系统本来就会关菜单，再手动关一次
+            //    会让部分 ROM 在同一拍里同时「关菜单 + 关输入法窗口」。
+            // 2) 不要用 anchor.post：菜单关闭的瞬间若宿主重排窗口，anchor 可能已经不在
+            //    窗口树上，View.post 的回调就永远排在队列里不会执行 ——
+            //    用户看到的就是「点了批量没有任何反应」。
+            // 改用主线程 Handler 投递，与 View 是否还挂载无关。
+            Handler(Looper.getMainLooper()).post { actions.onBatchSelect(bean) }
+        }
+    }
+    menu.item(R.string.delete, R.drawable.ic_baseline_delete_24, iconTint) {
+        actions.onDelete(bean.id)
+    }
+    if (supportsCategory) {
+        menu.item(R.string.dahi_cp_category, R.drawable.ic_baseline_folder_24, iconTint) {
+            actions.onSetCategory(bean, anchor)
+        }
+    }
+    menu.item(R.string.dahi_cp_set, R.drawable.ic_dahi_phrase_add_24, iconTint) {
+        actions.onSetCustomPhrase(bean)
+    }
+    // 只在确实可能被截断时才给这一项：短条目弹出来也是那几个字，纯属多一次点击
+    val fullText = bean.text.orEmpty()
+    if (fullText.length > FULL_TEXT_HINT_THRESHOLD) {
+        menu.item(R.string.dahi_cp_view_full, R.drawable.ic_baseline_notes_24, iconTint) {
+            actions.onViewFull(bean)
+        }
+    }
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q && !DeviceUtils.isSamsungOneUI) {
+        popup.setForceShowIcon(true)
+    }
+    popup.show()
+    return popup
+}
