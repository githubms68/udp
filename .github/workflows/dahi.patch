+    private fun heatCard(): View {
+        val ctx = requireContext()
+        val card = card()
+        card.addView(sectionTitle(R.string.dahi_stats_heat))
+        heatView = DahiHeatmapView(ctx)
+        // 万一布局没及时换（比如刚从别的键盘切回来），点一下热力图就重新取一次；
+        // 数据没变化时界面看起来「没反应」，所以额外提示一句，让人知道点到了
+        heatView.setOnClickListener {
+            render()
+            toast(R.string.dahi_stats_heat_refreshed)
+        }
+        // 轻点某个键 → 报这个键按了多少次；点和点之间的空白 → 还是走上面那条「刷新」
+        heatView.onKeyTap = { label -> onKeyTapped(label) }
+        card.addView(
+            heatView,
+            LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT),
+        )
+        card.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_stats_heat_tip)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 11.5f)
+                setTextColor(dahiText2())
+                setPadding(0, ctx.dp(6), 0, 0)
+            },
+        )
+        // 点键看数据之后，空白处就不那么好点了，所以给「刷新」一个明确的入口
+        card.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_stats_heat_refresh)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+                setTextColor(dahiAccent())
+                setPadding(0, ctx.dp(8), 0, 0)
+                setOnClickListener {
+                    render()
+                    toast(R.string.dahi_stats_heat_refreshed)
+                }
+            },
+        )
+        // 「热力图清零」：和「点热力图刷新」不是一回事，所以单独做一个按钮 + 两道确认
+        card.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_stats_heat_clear)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+                setTextColor(dahiAccent())
+                setPadding(0, ctx.dp(10), 0, 0)
+                setOnClickListener { confirmClearHeat() }
+            },
+        )
+        return card
