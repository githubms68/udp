+
+    private fun sectionTitle(text: String): TextView {
+        val ctx = requireContext()
+        return TextView(ctx).apply {
+            this.text = text
+            textSize = 12f
+            setTextColor(summaryColor())
+            setPadding(0, ctx.dp(12), 0, ctx.dp(2))
