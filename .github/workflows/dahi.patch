@@ -0,0 +1,208 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Matrix
+import android.graphics.Paint
+import android.graphics.RectF
+import android.view.MotionEvent
+import android.view.ScaleGestureDetector
+import android.view.View
+import android.view.ViewGroup
+import android.widget.LinearLayout
+import androidx.appcompat.app.AlertDialog
+import com.osfans.trime.R
+
+/**
+ * 键盘背景「手动裁剪」页（大海版）。
+ *
+ * 以对话框形式呈现：整块可视区域即为裁剪框，单指拖动、双指缩放，点「确定」输出裁剪好的位图。
+ */
+class DahiCropDialog(
+    private val context: Context,
+    source: Bitmap,
+    aspect: Float,
+    private val onCropped: (Bitmap) -> Unit,
+) {
+    private val cropView = DahiCropView(context, source, aspect.coerceAtLeast(0.1f))
+    private var dialog: AlertDialog? = null
+
+    fun show() {
+        if (dialog?.isShowing == true) return
+        val root =
+            LinearLayout(context).apply {
+                orientation = LinearLayout.VERTICAL
+                addView(
+                    cropView,
+                    LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ),
+                )
+            }
+        dialog =
+            AlertDialog
+                .Builder(context)
+                .setTitle(R.string.dahi_keybg_crop_title)
+                .setMessage(R.string.dahi_keybg_crop_hint)
+                .setView(root)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.dahi_keybg_crop_ok) { _, _ ->
+                    cropView.crop()?.let(onCropped)
+                }.show()
+    }
+}
+
+/** 裁剪视图：整块视图即为裁剪框，内部位图可拖动 / 缩放（始终保持铺满）。 */
+internal class DahiCropView(
+    context: Context,
+    private val source: Bitmap,
+    private val aspect: Float,
+) : View(context) {
+    private val matrix = Matrix()
+    private val drawPaint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private var minScale = 1f
+    private var maxScale = 6f
+    private var ready = false
+    private var lastX = 0f
+    private var lastY = 0f
+
+    private val scaleDetector =
+        ScaleGestureDetector(
+            context,
+            object : ScaleGestureDetector.SimpleOnScaleGestureListener() {
+                override fun onScale(detector: ScaleGestureDetector): Boolean {
+                    val cur = currentScale().coerceAtLeast(0.0001f)
+                    val target = (cur * detector.scaleFactor).coerceIn(minScale, maxScale)
+                    val factor = target / cur
+                    matrix.postScale(factor, factor, detector.focusX, detector.focusY)
+                    clamp()
+                    invalidate()
+                    return true
+                }
+            },
+        )
+
+    init {
+        isClickable = true
+    }
+
+    private fun currentScale(): Float {
+        val values = FloatArray(9)
+        matrix.getValues(values)
+        return values[Matrix.MSCALE_X]
+    }
+
+    override fun onMeasure(
+        widthMeasureSpec: Int,
+        heightMeasureSpec: Int,
+    ) {
+        val w = MeasureSpec.getSize(widthMeasureSpec).coerceAtLeast(1)
+        val h = (w / aspect).toInt().coerceAtLeast(1)
+        setMeasuredDimension(w, h)
+    }
+
+    override fun onSizeChanged(
+        w: Int,
+        h: Int,
+        oldw: Int,
+        oldh: Int,
+    ) {
+        super.onSizeChanged(w, h, oldw, oldh)
+        if (w <= 0 || h <= 0) return
+        val iw = source.width.toFloat()
+        val ih = source.height.toFloat()
+        if (iw <= 0f || ih <= 0f) return
+        val cover = maxOf(w / iw, h / ih)
+        val contain = minOf(w / iw, h / ih)
+        // 允许缩小到「完整显示整张图」，也允许放大；初始按「铺满」显示
+        minScale = contain
+        maxScale = cover * 8f
+        val s = cover
+        matrix.reset()
+        matrix.postScale(s, s)
+        matrix.postTranslate((w - iw * s) / 2f, (h - ih * s) / 2f)
+        ready = true
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        canvas.drawColor(Color.BLACK)
+        if (ready) canvas.drawBitmap(source, matrix, drawPaint)
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        scaleDetector.onTouchEvent(event)
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                lastX = event.x
+                lastY = event.y
+                parent?.requestDisallowInterceptTouchEvent(true)
+            }
+            MotionEvent.ACTION_MOVE -> {
+                if (!scaleDetector.isInProgress) {
+                    matrix.postTranslate(event.x - lastX, event.y - lastY)
+                    clamp()
+                    invalidate()
+                }
+                lastX = event.x
+                lastY = event.y
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                parent?.requestDisallowInterceptTouchEvent(false)
+            }
+            MotionEvent.ACTION_POINTER_UP -> {
+                lastX = event.x
+                lastY = event.y
+            }
+        }
+        return true
+    }
+
+    private fun clamp() {
+        val values = FloatArray(9)
+        matrix.getValues(values)
+        val scale = values[Matrix.MSCALE_X]
+        val iw = source.width * scale
+        val ih = source.height * scale
+        val vw = width.toFloat()
+        val vh = height.toFloat()
+        val tx = values[Matrix.MTRANS_X]
+        val ty = values[Matrix.MTRANS_Y]
+        values[Matrix.MTRANS_X] = clampAxis(tx, vw, iw)
+        values[Matrix.MTRANS_Y] = clampAxis(ty, vh, ih)
+        matrix.setValues(values)
+    }
+
+    /**
+     * 单轴位移限制：图片大于可视区时不允许露出空白；
+     * 小于可视区时可在框内自由移动（不超出边界），因此缩小时也能左右 / 上下移动。
+     */
+    private fun clampAxis(
+        t: Float,
+        view: Float,
+        image: Float,
+    ): Float = if (image <= view) t.coerceIn(0f, view - image) else t.coerceIn(view - image, 0f)
+
+    /** 输出当前可视区域对应的位图（与源图求交，避免出现空白）。 */
+    fun crop(): Bitmap? {
+        if (!ready) return null
+        val inverse = Matrix()
+        if (!matrix.invert(inverse)) return null
+        val rect = RectF(0f, 0f, width.toFloat(), height.toFloat())
+        inverse.mapRect(rect)
+        val x = rect.left.toInt().coerceIn(0, source.width - 1)
+        val y = rect.top.toInt().coerceIn(0, source.height - 1)
+        val right = rect.right.toInt().coerceIn(x + 1, source.width)
+        val bottom = rect.bottom.toInt().coerceIn(y + 1, source.height)
+        return runCatching { Bitmap.createBitmap(source, x, y, right - x, bottom - y) }.getOrNull()
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiCustomPhrase.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiCustomPhrase.kt
new file mode 100644
index 0000000..b364a88
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiCustomPhrase.kt
@@ -0,0 +1,262 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import androidx.core.content.edit
+import androidx.preference.PreferenceManager
+import com.osfans.trime.util.appContext
+import org.json.JSONObject
+
+/**
+ * 客户端「自定义短语」（大海版）。
+ *
+ * 完全独立于输入方案：把「代码 → 短语正文」的映射存在应用自身，
+ * 在 [com.osfans.trime.core.Rime] 生成候选列表时，若当前输入恰好等于某个代码，
+ * 就在候选末尾追加一条短语项；选中它即把整段正文上屏。
+ * 不写入用户 rime 目录，也不依赖 `custom_phrase` 词典，因此与任何输入方案都不冲突。
+ *
+ * 存储在默认 SharedPreferences（键 `dahi_phrase_map`，JSON），随「备份与还原」一起导出。
+ */
+object DahiCustomPhrase {
+    /** 偏好键（供备份 / 还原按名引用）。 */
+    const val PREF_KEY = "dahi_phrase_map"
+    private const val KEY_MAP = PREF_KEY
+
+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(appContext)
+
+    @Volatile
+    private var cache: MutableMap<String, String>? = null
+
+    /** 「正文 → 编码」反查缓存：候选栏每按一次键都要查，不能每次重建。随 [cache] 一起失效。 */
+    @Volatile
+    private var textIndex: Map<String, String>? = null
+
+    init {
+        // 外部写入（例如「备份与还原」恢复）后自动失效缓存，无需重启即可生效
+        runCatching {
+            prefs.registerOnSharedPreferenceChangeListener { _, key ->
+                if (key == KEY_MAP) {
+                    cache = null
+                    textIndex = null
+                }
+            }
+        }
+    }
+
+    private fun load(): MutableMap<String, String> {
+        cache?.let { return it }
+        val map = linkedMapOf<String, String>()
+        runCatching {
+            val raw = prefs.getString(KEY_MAP, null)
+            if (!raw.isNullOrEmpty()) {
+                val json = JSONObject(raw)
+                json.keys().forEach { key -> map[key] = json.optString(key) }
+            }
+        }
+        cache = map
+        return map
+    }
+
+    private fun save() {
+        val map = cache ?: return
+        val json = JSONObject()
+        map.forEach { (key, value) -> json.put(key, value) }
+        prefs.edit { putString(KEY_MAP, json.toString()) }
+        textIndex = null
+    }
+
+    /** 代码规范化：去首尾空白 + 转小写。 */
+    fun normalize(code: String): String = code.trim().lowercase()
+
+    /**
+     * 会被方案/输入法插进编码里的「看不见的字符」。
+     *
+     * 双拼方案（如万象 pro）会把已识别的音节在 preedit / raw input 里分开，
+     * 而且分隔符不一定是半角空格：可能是全角空格、不间断空格（U+00A0）、
+     * 撇号、间隔号，甚至零宽字符。只要漏掉一种，短语就永远匹配不上 ——
+     * 这正是「短语建好了、列表里也有，但打不出来」的老 bug。
+     */
+    private val SEPARATORS = charArrayOf(
+        ' ', '\t', '\n', '\u00A0', '\u3000', '\u2009', '\u202F',
+        '\'', '\u2019', '\u02BC', '`', '\u00B4', '\u30FB', '\u00B7', '\u2022',
+        '\u200B', '\u200C', '\u200D', '\uFEFF', '\uFF3F', '_', '-',
+    )
+
+    /**
+     * 宽松规范化：去掉**所有**空白、分隔符与零宽字符后转小写。
+     *
+     * 用于短语码比较 —— 只要去掉这些东西之后两边一致，就认为命中。
+     */
+    fun loose(code: String): String {
+        val sb = StringBuilder(code.length)
+        code.forEach { c ->
+            // isWhitespace 是 Kotlin 扩展；isSpaceChar 只有 Java 的静态版（含 NBSP 等空白类字符）
+            if (c.isWhitespace() || Character.isSpaceChar(c)) return@forEach
+            if (SEPARATORS.any { it == c }) return@forEach
+            sb.append(c.lowercaseChar())
+        }
+        return sb.toString()
+    }
+
+    /**
+     * 按输入查短语正文；未命中返回 null。
+     *
+     * 支持传入**多个候选输入形态**（原始 raw input、preedit 组字串…）：
+     * 不同方案把同一串按键暴露成的样子并不一样，多试几个来源才稳。
+     * 匹配顺序：严格（原样）→ 宽松（去分隔符）→ 全表宽松比对（兜历史脏键）。
+     */
+    fun get(vararg inputs: String): String? {
+        val map = load()
+        if (map.isEmpty()) return null
+        inputs.forEach { raw ->
+            val strict = normalize(raw)
+            if (strict.isNotEmpty()) map[strict]?.let { return it }
+        }
+        val looseKeys = inputs.map { loose(it) }.filter { it.isNotEmpty() }.distinct()
+        if (looseKeys.isEmpty()) return null
+        looseKeys.forEach { key -> map[key]?.let { return it } }
+        return map.entries.firstOrNull { loose(it.key) in looseKeys }?.value
+    }
+
+    /** 命中的短语码（宽松形态）；供「忘记该词」精确删除。 */
+    fun hitKey(vararg inputs: String): String? {
+        val map = load()
+        val looseKeys = inputs.map { loose(it) }.filter { it.isNotEmpty() }
+        looseKeys.forEach { key -> if (map.containsKey(key)) return key }
+        return map.keys.firstOrNull { loose(it) in looseKeys }
+    }
+
+    fun put(
+        code: String,
+        text: String,
+    ) {
+        val key = loose(code)
+        if (key.isEmpty() || text.isEmpty()) return
+        load()[key] = text
+        save()
+        // 顺手登记创建时间：所有「新建短语」的入口都经过这里，集中处理不会漏
+        runCatching { DahiPhraseStats.ensure(key, text) }
+    }
+
+    /** 删除短语；可一次传入多个输入形态（原始 raw input / preedit），任一命中即删。 */
+    fun remove(vararg codes: String) {
+        val map = load()
+        var changed = false
+        codes.forEach { code ->
+            val looseKey = loose(code)
+            if (looseKey.isEmpty()) return@forEach
+            if (map.remove(looseKey) != null) changed = true
+            // 兼容历史数据里带空格 / 带分隔符的键
+            map.keys.filter { loose(it) == looseKey }.forEach { if (map.remove(it) != null) changed = true }
+        }
+        if (changed) save()
+    }
+
+    /** 最近一次短语匹配的现场：原始组字串、预编辑串、命中与否。 */
+    data class Probe(
+        val raw: String,
+        val preedit: String,
+        val hit: String?,
+    )
+
+    @Volatile
+    private var probe: Probe? = null
+
+    /**
+     * 由 [com.osfans.trime.core.Rime] 在每次生成候选时调用。
+     *
+     * 短语「打不出来」时最常见的原因是：方案把编码切成了带分隔符的形态，
+     * 而用户看不到自己到底打进了什么。把现场留在管理页，用户截个图就能定位。
+     */
+    fun recordProbe(
+        raw: String,
+        preedit: String,
+        hit: String?,
+    ) {
+        probe = Probe(raw, preedit, hit)
+    }
+
+    /** 最近一次匹配现场；从未匹配过时返回 null。 */
+    fun lastProbe(): Probe? = probe
+
+    fun all(): Map<String, String> = load().toMap()
+
+    /**
+     * 正文 → 代码 的反查表（同一正文挂多个码时取最短码）。
+     *
+     * 用途：候选栏给「已经设过快打的词」加「快打dy」提示，以及长按菜单里的「修改编码」。
+     * 每次都从内存缓存重建：短语数量是个位数到几百，比维护一份与写入同步的二级缓存更不易出错。
+     */
+    fun codeByText(): Map<String, String> {
+        textIndex?.let { return it }
+        val map = load()
+        if (map.isEmpty()) return emptyMap()
+        val out = HashMap<String, String>(map.size * 2)
+        map.forEach { (code, text) ->
+            val key = text.trim()
+            if (key.isEmpty()) return@forEach
+            val old = out[key]
+            if (old == null || code.length < old.length) out[key] = code
+        }
+        textIndex = out
+        return out
+    }
+
+    /** 按正文找编码；没有则 null。 */
+    fun codeOfText(text: String): String? = codeByText()[text.trim()]
+
+    /**
+     * 这条候选文本对应哪条快打（只认它**自己**，不看当前输入码命中了谁）。
+     *
+     * 之所以要单独一个函数：长按菜单以前用 `hitKey(raw)` 判断，只要当前输入码本身是
+     * 某个快打码（比如打 dy），栏里**每一条**候选都会被判成「已设过快打」，
+     * 于是所有候选的菜单都变成「修改编码」—— 那是 bug。
+     *
+     * [rawCode] 是当前输入码命中的短语码（可空）。候选栏会把超长短语压成前 12 字 + 「…」，
+     * 这时正文对不上，需要按前缀再认一次，否则长按短语候选会误判成「还没设过快打」。
+     */
+    fun codeOfCandidate(
+        text: String,
+        rawCode: String? = null,
+    ): String? {
+        codeOfText(text)?.let { return it }
+        val shown = text.trim().removeSuffix("…").trim()
+        if (shown.isEmpty()) return null
+        val map = load()
+        if (!rawCode.isNullOrEmpty()) {
+            val body = map[rawCode]?.replace('\n', ' ')?.trim()
+            if (body != null && (body == shown || body.startsWith(shown))) return rawCode
+        }
+        return map.entries
+            .firstOrNull { (_, value) ->
+                val one = value.replace('\n', ' ').trim()
+                one.isNotEmpty() && (one == shown || one.startsWith(shown))
+            }?.key
+    }
+
+    /** 全部短语：`代码 → 正文`，按代码排序（管理页展示用）。 */
+    fun entries(): List<Pair<String, String>> = load().toList().sortedBy { it.first }
+
+    /** 清空全部短语；返回是否真的有内容被清掉。 */
+    fun clearAll(): Boolean {
+        val map = load()
+        if (map.isEmpty()) return false
+        map.clear()
+        save()
+        return true
+    }
+
+    /** 把一段「代码 → 正文」的 JSON 合并进来（供备份“合并还原”使用，同码以传入值为准）。 */
+    fun mergeJson(raw: String?) {
+        if (raw.isNullOrEmpty()) return
+        runCatching {
+            val json = JSONObject(raw)
+            val map = load()
+            json.keys().forEach { key -> map[key] = json.optString(key) }
+            save()
+        }
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiDailyHistory.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiDailyHistory.kt
new file mode 100644
index 0000000..9227292
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiDailyHistory.kt
@@ -0,0 +1,311 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import timber.log.Timber
+import java.io.File
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+
+/**
+ * 按日归档的输入历史（**独立文件**，不进 DahiInputStats 那个 store）。
+ *
+ * 为什么要独立：store 每次击键后都会整棵序列化（debounce 2s），365 条日记录塞进去
+ * 会让每两秒写一次的文件从几十 KB 涨到几百 KB —— 输入法会变卡。这里单独一个
+ * 小文件，只在跨天那一刻写一次。
+ *
+ * 每天约 200 字节（日期 + 5 个标量 + 24 个小时计数），3 年 ≈ 220KB。
+ */
+object DahiDailyHistory {
+    private const val FILE_NAME = "dahi_daily_history.json"
+
+    /** 最多保留多少天（约 3 年）。超了淘汰最旧的。 */
+    private const val MAX_DAYS = 1100
+
+    @Serializable
+    data class Day(
+        /** yyyy-MM-dd */
+        val date: String,
+        val chars: Long = 0,
+        val commits: Long = 0,
+        /** 有效输入时长（毫秒）。 */
+        val activeMs: Long = 0,
+        /** 最活跃的小时（0~23），-1 = 当天没有可用数据。 */
+        val peakHour: Int = -1,
+        /** 24 个小时各自的上屏字数。 */
+        val hours: List<Int> = emptyList(),
+    ) {
+        /** 速度：字 / 分钟。 */
+        val speed: Double
+            get() = if (activeMs < 1000L) 0.0 else chars * 60_000.0 / activeMs
+    }
+
+    private val json =
+        Json {
+            ignoreUnknownKeys = true
+            encodeDefaults = true
+        }
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val lock = Any()
+
+    private var loaded = false
+    private var days: MutableList<Day> = mutableListOf()
+    private var file: File? = null
+
+    private fun fmt(): DateTimeFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd")
+
+    private fun ensureLoaded(ctx: Context) {
+        if (loaded) return
+        synchronized(lock) {
+            if (loaded) return
+            val f = File(ctx.applicationContext.filesDir, FILE_NAME)
+            file = f
+            loaded = true
+            if (!f.exists()) return
+            runCatching {
+                val parsed = json.decodeFromString<List<Day>>(f.readText())
+                days = parsed.sortedBy { it.date }.toMutableList()
+            }.onFailure { Timber.w(it, "读取每日历史失败") }
+        }
+    }
+
+    /** 全部记录（按日期升序）。 */
+    fun all(ctx: Context): List<Day> {
+        ensureLoaded(ctx)
+        synchronized(lock) { return days.toList() }
+    }
+
+    /**
+     * 最近 [n] 天的记录（含今天）；[n] <= 0 表示全部。
+     *
+     * **按日期窗口取，并把中间没输入的日子补成空记录** ——
+     * 否则「30 天」其实是「有输入的最后 30 条」，中间缺几天会看不出来，
+     * 趋势图就会骗人（11-02 和 11-04 挨在一起，像是连着的两天）。
+     */
+    fun recent(
+        ctx: Context,
+        n: Int,
+    ): List<Day> {
+        val list = all(ctx)
+        if (list.isEmpty()) return emptyList()
+        val firstDate = runCatching { LocalDate.parse(list.first().date) }.getOrNull() ?: return list
+        val today = LocalDate.now()
+        val from =
+            if (n <= 0) {
+                firstDate
+            } else {
+                val windowStart = today.minusDays((n - 1).toLong())
+                if (windowStart.isBefore(firstDate)) firstDate else windowStart
+            }
+        val byDate = list.associateBy { it.date }
+        val formatter = fmt()
+        val out = ArrayList<Day>()
+        var d = from
+        var guard = 0
+        while (!d.isAfter(today) && guard < 1300) {
+            val key = formatter.format(d)
+            out.add(byDate[key] ?: Day(date = key))
+            d = d.plusDays(1)
+            guard++
+        }
+        return out
+    }
+
+    /**
+     * 写入（或覆盖）某一天。
+     *
+     * 跨天时由 [DahiInputStats] 在重置「今天」那个桶之前调用，把过去的一天存下来。
+     * 当天字数为 0 的记录直接跳过 —— 没用输入的日子不留空行，数据天然稀疏。
+     */
+    fun archive(
+        ctx: Context,
+        day: Day,
+    ) {
+        if (day.chars <= 0L) return
+        ensureLoaded(ctx)
+        synchronized(lock) {
+            days.removeAll { it.date == day.date }
+            days.add(day)
+            days.sortBy { it.date }
+            if (days.size > MAX_DAYS) {
+                days = days.takeLast(MAX_DAYS).toMutableList()
+            }
+        }
+        val snapshot = synchronized(lock) { days.toList() }
+        scope.launch {
+            runCatching { write(snapshot) }.onFailure { Timber.w(it, "写每日历史失败") }
+        }
+    }
+
+    /** 把「今天」也刷进去（统计页打开时用，保证当天不算空）。 */
+    fun upsertToday(
+        ctx: Context,
+        day: Day,
+    ) {
+        if (day.chars <= 0L) return
+        ensureLoaded(ctx)
+        synchronized(lock) {
+            // 统计页每刷新一次都会走到这里：数据没变就不要再写盘
+            if (days.lastOrNull { it.date == day.date } == day) return
+            days.removeAll { it.date == day.date }
+            days.add(day)
+            days.sortBy { it.date }
+        }
+        val snapshot = synchronized(lock) { days.toList() }
+        scope.launch {
+            runCatching { write(snapshot) }.onFailure { Timber.w(it, "写每日历史失败") }
+        }
+    }
+
+    private fun write(list: List<Day>) {
+        val f = file ?: return
+        val tmp = File(f.parentFile, "$FILE_NAME.tmp")
+        tmp.writeText(json.encodeToString(list))
+        if (!tmp.renameTo(f)) {
+            // rename 失败就退回直接写（少了原子性，但不会丢数据）
+            f.writeText(tmp.readText())
+            tmp.delete()
+        }
+    }
+
+    /** 按月汇总的一条（「按月」视图用）。 */
+    data class Month(
+        /** yyyy-MM */
+        val month: String,
+        val chars: Long,
+        val commits: Long,
+        val activeMs: Long,
+        /** 这个月有输入的天数。 */
+        val days: Int,
+        /** 最活跃的小时（0~23），-1 = 无。 */
+        val peakHour: Int,
+        /** 深夜（23 点 + 凌晨 0～4 点）合计上屏字数，供熬夜判定用。 */
+        val lateChars: Long = 0L,
+    ) {
+        val speed: Double
+            get() = if (activeMs < 1000L) 0.0 else chars * 60_000.0 / activeMs
+    }
+
+    /**
+     * 按月聚合。
+     *
+     * 「全部」这个档位是设计失误：一年 365 根柱子谁也看不清。
+     * 换成一个自然月一根，十年也只有 120 根，语义还更清楚。
+     */
+    fun monthly(ctx: Context): List<Month> {
+        val list = all(ctx)
+        if (list.isEmpty()) return emptyList()
+        val groups = list.groupBy { it.date.take(7) }
+        return groups.entries
+            .sortedBy { it.key }
+            .map { (month, days) ->
+                val hours = IntArray(24)
+                var chars = 0L
+                var commits = 0L
+                var activeMs = 0L
+                var activeDays = 0
+                days.forEach { d ->
+                    chars += d.chars
+                    commits += d.commits
+                    activeMs += d.activeMs
+                    if (d.chars > 0L) activeDays++
+                    d.hours.forEachIndexed { h, v -> if (h in 0..23) hours[h] += v }
+                }
+                val peak = hours.indices.maxByOrNull { hours[it] } ?: -1
+                Month(
+                    month = month,
+                    chars = chars,
+                    commits = commits,
+                    activeMs = activeMs,
+                    days = activeDays,
+                    peakHour = if (peak >= 0 && hours[peak] > 0) peak else -1,
+                    lateChars = (hours[23] + (0..4).sumOf { hours[it] }).toLong(),
+                )
+            }
+    }
+
+    /** 删除全部历史（只删这份归档，DahiInputStats 的累计桶不受影响）。 */
+    fun totalDays(ctx: Context): Int = all(ctx).count { it.chars > 0L }
+
+    /** 深夜档：23 点与凌晨 0～4 点。 */
+    private fun isLateHour(h: Int): Boolean = h == 23 || h in 0..4
+
+    /**
+     * 判定「熬夜输入」的深夜字数下限：深夜合计至少要打这么多字才算认真输入。
+     * 顺手回一句、半夜点个「嗯」都到不了这个量。
+     */
+    const val LATE_MIN_CHARS: Long = 200L
+
+    /**
+     * 日级「熬夜输入」判定 —— **两条路满足任一即可**：
+     *
+     *   ① 峰值小时在深夜（当天最集中的那一小时落在 23 点或 0～4 点）；
+     *   ② 深夜字数达标：23 点 + 凌晨 0～4 点上屏合计 ≥ [LATE_MIN_CHARS] 字，
+     *      且占当天总字数 ≥ 10%。
+     *
+     * 为什么加 ②：只靠 ① 会漏掉「白天写了 2000 字、凌晨 1 点又认真写了 300 字」的日子 ——
+     * 峰值在白天，但那 300 字显然不是顺手回一句。
+     * 为什么 ① 仍然保留：它是「当天最活跃时段就在深夜」的强信号，不该被 ② 的占比条件抹掉。
+     *
+     * 用「或」而不是「且」：只做加法，不推翻已经判对的日子，历史数字只会更准、不会倒退。
+     *
+     * 输入报告、每日柱状图、分享图三处共用本函数，口径只留一份。
+     */
+    fun isLateNightDay(
+        peakHour: Int,
+        hours: List<Int>,
+        chars: Long,
+    ): Boolean = isLateNightBucket(peakHour, lateCharsOf(hours), chars)
+
+    /**
+     * 同上，但入参直接给「深夜合计字数」—— 按月柱状图用的是聚合后的 Month，
+     * 它只有深夜字数、没有 24 小时明细，走这个重载才能和日柱用同一套口径。
+     */
+    fun isLateNightBucket(
+        peakHour: Int,
+        lateChars: Long,
+        chars: Long,
+    ): Boolean {
+        if (isLateHour(peakHour)) return true
+        if (chars <= 0L) return false
+        // lateChars / chars >= 10% 用整数比较，避免浮点误差
+        return lateChars >= LATE_MIN_CHARS && lateChars * 10 >= chars
+    }
+
+    /** 从 24 小时明细里取出深夜合计字数。 */
+    private fun lateCharsOf(hours: List<Int>): Long {
+        if (hours.isEmpty()) return 0L
+        var late = 0L
+        hours.forEachIndexed { h, v -> if (isLateHour(h)) late += v }
+        return late
+    }
+
+    /** 由某个时间戳得到 yyyy-MM-dd（本地时区）。 */
+    fun dateOf(ms: Long): String {
+        val zone = ZoneId.systemDefault()
+        return fmt().format(Instant.ofEpochMilli(ms).atZone(zone).toLocalDate())
+    }
+
+    fun today(): String = fmt().format(LocalDate.now())
+
+    fun clear(ctx: Context) {
+        ensureLoaded(ctx)
+        synchronized(lock) { days.clear() }
+        scope.launch { runCatching { write(emptyList()) } }
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ime/custom/DahiGifDrawable.kt b/app/src/main/java/com/osfans/trime/ime/custom/DahiGifDrawable.kt
new file mode 100644
index 0000000..d871d0c
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/custom/DahiGifDrawable.kt
@@ -0,0 +1,168 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Movie
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.drawable.Drawable
+import android.os.SystemClock
+import kotlin.math.ceil
+
+/**
+ * 动态键盘背景（GIF）绘制（大海版）。
+ *
+ * 用 [Movie] 解码 GIF（兼容 minSdk 21），在 [draw] 中按时间轴逐帧绘制并自请求重绘。
+ * 支持与静态图片一致的三种填充模式：拉伸铺满 / 居中（裁剪铺满）/ 重复平铺。
+ * 超过像素上限的动图会被拒绝，避免输入法进程内存吃紧。
+ */
+class DahiGifDrawable private constructor(
+    private val movie: Movie,
+    private val mode: DahiKeyboardBackground.Mode,
+    alpha: Int,
+) : Drawable() {
+    private val paint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val startedAt = SystemClock.uptimeMillis()
+
+    /** 下一次重绘是否已排入队列（避免重复 schedule）。 */
+    private var scheduled = false
+
+    /** 定时把「下一帧」推给 View：按 ~20fps 而不是屏幕刷新率重绘。 */
+    private val ticker =
+        Runnable {
+            scheduled = false
+            if (isVisible) invalidateSelf()
+        }
+
+    init {
+        paint.alpha = alpha.coerceIn(0, 255)
+    }
+
+    override fun draw(canvas: Canvas) {
+        val area = bounds
+        if (area.isEmpty) return
+        val duration = movie.duration().coerceAtLeast(1)
+        val time = ((SystemClock.uptimeMillis() - startedAt) % duration).toInt()
+        movie.setTime(time)
+        val mw = movie.width().coerceAtLeast(1)
+        val mh = movie.height().coerceAtLeast(1)
+        val w = area.width().toFloat()
+        val h = area.height().toFloat()
+        val save = canvas.save()
+        canvas.translate(area.left.toFloat(), area.top.toFloat())
+        canvas.clipRect(0f, 0f, w, h)
+        when (mode) {
+            DahiKeyboardBackground.Mode.STRETCH -> {
+                canvas.scale(w / mw, h / mh)
+                movie.draw(canvas, 0f, 0f, paint)
+            }
+            DahiKeyboardBackground.Mode.CENTER -> {
+                val s = maxOf(w / mw, h / mh)
+                canvas.scale(s, s)
+                movie.draw(canvas, (w / s - mw) / 2f, (h / s - mh) / 2f, paint)
+            }
+            DahiKeyboardBackground.Mode.FIT -> {
+                val s = minOf(w / mw, h / mh)
+                canvas.scale(s, s)
+                movie.draw(canvas, (w / s - mw) / 2f, (h / s - mh) / 2f, paint)
+            }
+            DahiKeyboardBackground.Mode.TILE -> {
+                val cols = ceil(w / mw).toInt().coerceAtLeast(1)
+                val rows = ceil(h / mh).toInt().coerceAtLeast(1)
+                if (cols.toLong() * rows > MAX_TILES) {
+                    // 图太小、平铺数量过多时退化为拉伸，避免每帧大量绘制造成卡顿
+                    canvas.scale(w / mw, h / mh)
+                    movie.draw(canvas, 0f, 0f, paint)
+                } else {
+                    var y = 0f
+                    while (y < h) {
+                        var x = 0f
+                        while (x < w) {
+                            canvas.save()
+                            canvas.translate(x, y)
+                            movie.draw(canvas, 0f, 0f, paint)
+                            canvas.restore()
+                            x += mw
+                        }
+                        y += mh
+                    }
+                }
+            }
+        }
+        canvas.restoreToCount(save)
+        // 动画循环：按固定帧间隔调度，而不是每帧都 invalidateSelf。
+        // 高刷屏（90/120Hz）上原本每个刷新周期都要重绘一次，动图本身只有 10~20fps，
+        // 多出来的重绘纯属耗电；键盘不可见时也不再排队。
+        scheduleNext()
+    }
+
+    private fun scheduleNext() {
+        if (scheduled || !isVisible) return
+        // 没有宿主 View（callback 为空）时 scheduleSelf 不会生效，此时不要置位，
+        // 否则重新挂到 View 上以后会永远不再排程。
+        if (callback == null) return
+        scheduled = true
+        scheduleSelf(ticker, SystemClock.uptimeMillis() + FRAME_INTERVAL_MS)
+    }
+
+    override fun setVisible(
+        visible: Boolean,
+        restart: Boolean,
+    ): Boolean {
+        val changed = super.setVisible(visible, restart)
+        if (visible) invalidateSelf()
+        return changed
+    }
+
+    override fun setAlpha(alpha: Int) {
+        paint.alpha = alpha.coerceIn(0, 255)
+        invalidateSelf()
+    }
+
+    override fun setColorFilter(colorFilter: ColorFilter?) {
+        paint.colorFilter = colorFilter
+        invalidateSelf()
+    }
+
+    @Deprecated("Deprecated in Java")
+    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+
+    companion object {
+        /** 动图解码像素上限，超过则拒绝。 */
+        private const val MAX_PIXELS = 2_000_000L
+
+        /** 动图重绘间隔（~20fps）：既够顺滑，又不会跟着高刷屏空转。 */
+        private const val FRAME_INTERVAL_MS = 50L
+
+        /** 平铺模式下的最大重复块数，超过则退化为拉伸，避免绘制卡顿。 */
+        private const val MAX_TILES = 300L
+
+        /** 是否为 GIF（魔数 `GIF8`）。 */
+        fun isGif(bytes: ByteArray): Boolean = bytes.size >= 6 &&
+            bytes[0] == 'G'.code.toByte() &&
+            bytes[1] == 'I'.code.toByte() &&
+            bytes[2] == 'F'.code.toByte() &&
+            bytes[3] == '8'.code.toByte()
+
+        /** 从字节构建；非 GIF、解码失败或过大时返回 null。 */
+        fun create(
+            bytes: ByteArray,
+            mode: DahiKeyboardBackground.Mode,
+            alpha: Int,
+        ): DahiGifDrawable? {
+            if (!isGif(bytes)) return null
+            val movie = runCatching { Movie.decodeByteArray(bytes, 0, bytes.size) }.getOrNull() ?: return null
+            val w = movie.width()
+            val h = movie.height()
+            if (w <= 0 || h <= 0) return null
+            if (w.toLong() * h > MAX_PIXELS) return null
+            return DahiGifDrawable(movie, mode, alpha)
+        }
+    }
+}
