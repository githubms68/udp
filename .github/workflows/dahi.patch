+ */
+
+package com.osfans.trime.ui.main.settings
+
+import android.database.sqlite.SQLiteDatabase
+import android.graphics.Typeface
+import android.os.Build
+import android.os.Bundle
+import android.util.TypedValue
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.lifecycle.lifecycleScope
+import kotlinx.coroutines.launch
+import androidx.fragment.app.Fragment
+import androidx.preference.PreferenceManager
+import com.osfans.trime.BuildConfig
+import com.osfans.trime.R
+import com.osfans.trime.data.db.DatabaseBean
+import com.osfans.trime.ime.custom.DahiCrashLog
+import splitties.dimensions.dp
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * 「诊断信息导出」设置页（大海版）。
+ *
+ * 排查问题时最缺的往往不是截图，而是「版本 / 设备 / 关键设置到底是多少」。
+ * 这里一键生成一份纯文本报告（不含剪贴板正文、不含备份密码），可直接发出来。
+ */
+class DahiDiagnosticsFragment : Fragment() {
+    private var crashView: TextView? = null
+
+    private val exportReport =
+        registerForActivityResult(ActivityResultContracts.CreateDocument("text/plain")) { uri ->
+            uri ?: return@registerForActivityResult
+            val ok =
+                runCatching {
+                    requireContext().contentResolver.openOutputStream(uri)?.use { out ->
+                        out.write(buildReport().toByteArray(Charsets.UTF_8))
+                    }
+                    true
+                }.getOrDefault(false)
+            Toast
+                .makeText(
+                    requireContext(),
+                    if (ok) R.string.dahi_diag_done else R.string.dahi_diag_failed,
+                    Toast.LENGTH_SHORT,
+                ).show()
+        }
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(24))
+            }
+        column.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_diag_tip)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            },
+        )
+        column.addView(
+            Button(ctx).apply {
+                setText(R.string.dahi_diag_export)
+                setOnClickListener {
+                    // 文件名带时间戳：连着导几份时不会互相覆盖，排查时也一眼知道是哪次
+                    val stamp =
+                        java.text.SimpleDateFormat("yyyyMMdd-HHmmss", java.util.Locale.getDefault())
+                            .format(java.util.Date())
+                    exportReport.launch("dahi-diagnostics-$stamp.txt")
+                }
+            },
+        )
+
+        // ---------- 数据库自检 ----------
+        // 内容固定、也不长，放前面：一进页面就能看到「东西都还在」
+        column.addView(sectionTitle(ctx, R.string.dahi_diag_db_section))
+        column.addView(
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setTypeface(Typeface.MONOSPACE)
+                text = dbInfo()
+            },
+        )
+
+        // ---------- 自动备份 ----------
+        column.addView(sectionTitle(ctx, R.string.dahi_diag_backup_section))
+        val backupTv =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setTypeface(Typeface.MONOSPACE)
+                text = getString(R.string.dahi_diag_backup_loading)
+            }
+        column.addView(backupTv)
+        viewLifecycleOwner.lifecycleScope.launch {
+            // 每份备份都要读文件数条目，放 IO 线程；最多 5 份
+            val txt = kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.IO) { backupInfo() }
+            if (isAdded) backupTv.text = txt
+        }
+
+        // ---------- 最近崩溃 ----------
+        column.addView(sectionTitle(ctx, R.string.dahi_diag_crash_section))
+        // 清除按钮放**记录之前**：崩溃记录一多，按钮会被顶到最底下，等于找不到
+        val clearBtn =
+            Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                setText(R.string.dahi_diag_clear_crash)
+                setOnClickListener { confirmClearCrash(ctx) }
+            }
+        column.addView(clearBtn)
+        val crash =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setTypeface(Typeface.MONOSPACE)
+                setTextIsSelectable(true)
+            }
+        crashView = crash
+        column.addView(crash)
+
+        refreshCrash()
+        return ScrollView(ctx).apply { addView(column) }
+    }
+
+    /** 最近 5 份自动备份（排查「数据怎么不见了」时最有用）。 */
+    private fun backupInfo(): String {
+        val items = runCatching { com.osfans.trime.data.backup.DahiAutoBackup.list() }.getOrDefault(emptyList())
+        if (items.isEmpty()) return getString(R.string.dahi_diag_backup_empty)
+        val fmt = java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.getDefault())
+        val json = kotlinx.serialization.json.Json { ignoreUnknownKeys = true; encodeDefaults = false }
+        return buildString {
+            appendLine("${getString(R.string.dahi_diag_backup_total)} ${items.size}")
+            items.take(5).forEach { item ->
+                append(fmt.format(java.util.Date(item.time)))
+                append("  ")
+                append(
+                    if (item.isSnapshot) {
+                        getString(R.string.dahi_diag_backup_snap, item.reason.orEmpty())
+                    } else {
+                        getString(R.string.dahi_auto_backup_daily)
+                    },
+                )
+                append("  ")
+                append(fmtSize(item.sizeBytes))
+                // 条目数：直接读备份文件里的 clipboard / collection 大小
+                val counts =
+                    runCatching {
+                        val d =
+                            json.decodeFromString(
+                                com.osfans.trime.data.backup.BackupData.serializer(),
+                                item.file.readText(),
+                            )
+                        (d.clipboard?.size ?: 0) to (d.collection?.size ?: 0)
+                    }.getOrDefault(0 to 0)
+                append("  ")
+                append(getString(R.string.dahi_diag_backup_counts, counts.first, counts.second))
+                appendLine()
+            }
+        }
+    }
+
+    private fun fmtSize(bytes: Long): String =
+        when {
+            bytes >= 1024 * 1024 -> String.format(java.util.Locale.US, "%.1f MB", bytes / 1048576.0)
+            bytes >= 1024 -> String.format(java.util.Locale.US, "%.0f KB", bytes / 1024.0)
+            else -> "$bytes B"
+        }
+
+    /** 清除崩溃记录：二次确认（这类"点一下就没了"的操作一律要问一次）。 */
+    private fun confirmClearCrash(ctx: android.content.Context) {
+        androidx.appcompat.app.AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_diag_clear_crash)
+            .setMessage(R.string.dahi_diag_clear_crash_confirm)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                DahiCrashLog.clear(ctx)
+                refreshCrash()
+            }.setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun sectionTitle(
+        ctx: android.content.Context,
+        titleRes: Int,
+    ): TextView = TextView(ctx).apply {
+        setText(titleRes)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        setTypeface(typeface, Typeface.BOLD)
+        setPadding(0, ctx.dp(14), 0, ctx.dp(4))
+    }
+
+    private fun refreshCrash() {
+        val ctx = requireContext()
+        val text = DahiCrashLog.latest(ctx)
+        crashView?.text =
+            if (text.isBlank()) {
+                getString(R.string.dahi_diag_crash_none)
+            } else {
+                text.take(4000)
+            }
+    }
+
+    /**
+     * 数据库自检：版本号 + 条目数 + 实际列清单。
+     *
+     * 迁移类问题（升级后少一列、表结构不一致导致启动即崩）一直只能靠猜，
+     * 这里直接把两个库的真实结构打出来，和「期望列」一比对就清楚。
+     */
+    private fun dbInfo(): String = buildString {
+        listOf("clipboard.db", "collection.db").forEach { name ->
+            val file = requireContext().getDatabasePath(name)
+            if (!file.exists()) {
+                appendLine("$name：（尚未创建）")
+                return@forEach
+            }
+            val info =
+                runCatching {
+                    SQLiteDatabase.openDatabase(file.path, null, SQLiteDatabase.OPEN_READONLY).use { db ->
+                        val columns = mutableListOf<String>()
+                        db.rawQuery("PRAGMA table_info(${DatabaseBean.TABLE_NAME})", null).use { cursor ->
+                            while (cursor.moveToNext()) columns.add(cursor.getString(1))
+                        }
+                        val count =
+                            db.rawQuery("SELECT COUNT(*) FROM ${DatabaseBean.TABLE_NAME}", null).use { cursor ->
+                                if (cursor.moveToFirst()) cursor.getInt(0) else -1
+                            }
+                        "schema v${db.version} / 条目 $count / 文件 ${fmtSize(file.length())} / 列 ${columns.joinToString(",")}"
+                    }
+                }.getOrElse { "读取失败：${it.message}" }
+            appendLine("$name：$info")
+        }
+        appendLine("期望列：id,text,html,type,time,pinned,orderIndex,category")
+    }
+
+    /** 生成报告文本。刻意只取 `dahi_` 前缀的偏好，且长值截断，避免夹带图片 base64。 */
+    private fun buildReport(): String = buildString {
+        appendLine("=== 同文输入法大海版 · 诊断信息 ===")
+        appendLine("时间: " + SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US).format(Date()))
+        appendLine("应用: ${BuildConfig.APPLICATION_ID}  ${BuildConfig.BUILD_VERSION_NAME}")
+        appendLine("Android: ${Build.VERSION.RELEASE} (API ${Build.VERSION.SDK_INT})")
+        appendLine("设备: ${Build.MANUFACTURER} ${Build.MODEL} / ${Build.DEVICE}")
+        appendLine("语言: ${Locale.getDefault()}")
+        appendLine("屏幕密度: ${resources.displayMetrics.density}")
+        appendLine("versionName: ${BuildConfig.VERSION_NAME}  versionCode: ${BuildConfig.VERSION_CODE}")
+        appendLine("BUILD_VERSION_NAME: ${BuildConfig.BUILD_VERSION_NAME}  buildType: ${BuildConfig.BUILD_TYPE}")
+        appendLine()
+        appendLine("--- 大海版相关设置（键 = 值）---")
+        val prefs = PreferenceManager.getDefaultSharedPreferences(requireContext())
+        prefs.all.entries.sortedBy { it.key }.forEach { (key, value) ->
+            if (!key.startsWith("dahi_")) return@forEach
+            val text = value?.toString().orEmpty()
+            val shown = if (text.length > 120) text.take(120) + "…(共 ${text.length} 字符)" else text
+            appendLine("$key = $shown")
+        }
+        appendLine()
+        appendLine("--- 数据库自检 ---")
+        appendLine(dbInfo())
+        appendLine("--- 最近崩溃 ---")
+        appendLine(DahiCrashLog.latest(requireContext()).ifBlank { "(无)" })
+    }
+}
