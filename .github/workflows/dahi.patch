+
+package com.osfans.trime.ui.main.settings
+
+import android.graphics.Shader
+import android.graphics.drawable.BitmapDrawable
+import android.net.Uri
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.ImageView
+import android.widget.RadioButton
+import android.widget.RadioGroup
+import android.widget.SeekBar
+import android.widget.TextView
+import android.widget.Toast
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.appcompat.widget.SwitchCompat
+import androidx.fragment.app.Fragment
+import com.osfans.trime.R
+import com.osfans.trime.ime.custom.DahiCropDialog
+import com.osfans.trime.ime.custom.DahiGifDrawable
+import com.osfans.trime.ime.custom.DahiKeyboardBackground
+
+/**
+ * 「键盘背景」设置页（大海版）。
+ *
+ * 让普通用户直接相册选图（含手动裁剪）、选 GIF 动图 / 视频，调模糊 / 透明度，
+ * **无需编辑任何 yaml**。数据由 [DahiKeyboardBackground] 管理，改动即时反映到键盘。
+ */
+class KeyboardBackgroundSettingsFragment : Fragment() {
+    private var pickingSlot = DahiKeyboardBackground.Slot.PORTRAIT
+
+    private var previewView: ImageView? = null
+    private var videoTip: TextView? = null
+    private var enabledSwitch: SwitchCompat? = null
+    private var candSwitch: SwitchCompat? = null
+
+    private val pickImage =
+        registerForActivityResult(ActivityResultContracts.GetContent()) { uri ->
+            uri ?: return@registerForActivityResult
+            onImagePicked(uri, pickingSlot)
+        }
+
+    private val pickVideo =
+        registerForActivityResult(ActivityResultContracts.GetContent()) { uri ->
+            uri ?: return@registerForActivityResult
+            onVideoPicked(uri)
+        }
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View = inflater.inflate(R.layout.fragment_dahi_keyboard_bg, container, false)
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        previewView = view.findViewById(R.id.dahi_keybg_preview)
+        previewView?.contentDescription = getString(R.string.dahi_keybg_preview_title)
+        videoTip = view.findViewById(R.id.dahi_keybg_video_tip)
+        enabledSwitch = view.findViewById(R.id.dahi_keybg_enabled)
+        candSwitch = view.findViewById(R.id.dahi_keybg_cand_enabled)
+
+        val separate = view.findViewById<SwitchCompat>(R.id.dahi_keybg_separate)
+        val landscapeBlock = view.findViewById<View>(R.id.dahi_keybg_landscape_block)
+        val pickPortrait = view.findViewById<Button>(R.id.dahi_keybg_pick_portrait)
+        val resetPortrait = view.findViewById<Button>(R.id.dahi_keybg_reset_portrait)
+        val pickLandscape = view.findViewById<Button>(R.id.dahi_keybg_pick_landscape)
+        val resetLandscape = view.findViewById<Button>(R.id.dahi_keybg_reset_landscape)
+        val blur = view.findViewById<SeekBar>(R.id.dahi_keybg_blur)
+        val blurLabel = view.findViewById<TextView>(R.id.dahi_keybg_blur_label)
+        val modeMain = view.findViewById<RadioGroup>(R.id.dahi_keybg_mode_main)
+        val modeLand = view.findViewById<RadioGroup>(R.id.dahi_keybg_mode_land)
+        val modeCand = view.findViewById<RadioGroup>(R.id.dahi_keybg_mode_cand)
+        val modeVideo = view.findViewById<RadioGroup>(R.id.dahi_keybg_mode_video)
+        val opacity = view.findViewById<SeekBar>(R.id.dahi_keybg_opacity)
+        val opacityLabel = view.findViewById<TextView>(R.id.dahi_keybg_opacity_label)
+        val candPick = view.findViewById<Button>(R.id.dahi_keybg_cand_pick)
+        val candReset = view.findViewById<Button>(R.id.dahi_keybg_cand_reset)
+        val pickVideoButton = view.findViewById<Button>(R.id.dahi_keybg_pick_video)
+        val resetVideoButton = view.findViewById<Button>(R.id.dahi_keybg_reset_video)
+
+        // 内置图库：平铺缩略图网格，点图即选
+
+        separate.isChecked = DahiKeyboardBackground.isSeparate()
+        landscapeBlock.visibility = if (separate.isChecked) View.VISIBLE else View.GONE
+        blur.max = DahiKeyboardBackground.MAX_BLUR
+        blur.progress = DahiKeyboardBackground.blurRadius()
+        blurLabel.text = getString(R.string.dahi_keybg_blur_label, blur.progress)
+        opacity.progress = DahiKeyboardBackground.opacityPercent()
+        opacityLabel.text = getString(R.string.dahi_keybg_opacity_label, opacity.progress)
+        // 每个槽位（键盘 / 横屏 / 候选栏 / 视频）各自独立选择填充模式（平铺单选，一次点击即选）
+        installModeGroup(modeMain, DahiKeyboardBackground.Slot.PORTRAIT)
+        installModeGroup(modeLand, DahiKeyboardBackground.Slot.LANDSCAPE)
+        installModeGroup(modeCand, DahiKeyboardBackground.Slot.CANDIDATE)
+        installModeGroup(modeVideo, DahiKeyboardBackground.Slot.VIDEO)
+
+        enabledSwitch?.setOnCheckedChangeListener { _, v ->
+            DahiKeyboardBackground.setEnabled(v)
+            refreshPreview()
+        }
+        separate.setOnCheckedChangeListener { _, v ->
+            DahiKeyboardBackground.setSeparate(v)
+            landscapeBlock.visibility = if (v) View.VISIBLE else View.GONE
+            refreshPreview()
+        }
+        pickPortrait.setOnClickListener {
+            pickingSlot = DahiKeyboardBackground.Slot.PORTRAIT
+            pickImage.launch("image/*")
+        }
+        pickLandscape.setOnClickListener {
+            pickingSlot = DahiKeyboardBackground.Slot.LANDSCAPE
+            pickImage.launch("image/*")
+        }
+        candPick.setOnClickListener {
+            pickingSlot = DahiKeyboardBackground.Slot.CANDIDATE
+            pickImage.launch("image/*")
+        }
+        resetPortrait.setOnClickListener {
+            DahiKeyboardBackground.resetImage(DahiKeyboardBackground.Slot.PORTRAIT)
+            toast(R.string.dahi_keybg_reset_done)
+            refreshPreview()
+        }
+        resetLandscape.setOnClickListener {
+            DahiKeyboardBackground.resetImage(DahiKeyboardBackground.Slot.LANDSCAPE)
+            toast(R.string.dahi_keybg_reset_done)
+            refreshPreview()
+        }
+        candReset.setOnClickListener {
+            DahiKeyboardBackground.resetImage(DahiKeyboardBackground.Slot.CANDIDATE)
+            toast(R.string.dahi_keybg_reset_done)
+            refreshPreview()
+        }
+        pickVideoButton.setOnClickListener { pickVideo.launch("video/*") }
+        resetVideoButton.setOnClickListener {
+            DahiKeyboardBackground.resetImage(DahiKeyboardBackground.Slot.VIDEO)
+            toast(R.string.dahi_keybg_reset_done)
+            refreshPreview()
+        }
+        blur.setOnSeekBarChangeListener(
+            object : SeekBar.OnSeekBarChangeListener {
+                override fun onProgressChanged(
+                    seekBar: SeekBar?,
+                    progress: Int,
+                    fromUser: Boolean,
+                ) {
+                    blurLabel.text = getString(R.string.dahi_keybg_blur_label, progress)
+                }
+
+                override fun onStartTrackingTouch(seekBar: SeekBar?) = Unit
+
+                override fun onStopTrackingTouch(seekBar: SeekBar?) {
+                    DahiKeyboardBackground.setBlurRadius(seekBar?.progress ?: return)
+                    refreshPreview()
+                }
+            },
+        )
+        opacity.setOnSeekBarChangeListener(
+            object : SeekBar.OnSeekBarChangeListener {
+                override fun onProgressChanged(
+                    seekBar: SeekBar?,
+                    progress: Int,
+                    fromUser: Boolean,
+                ) {
+                    opacityLabel.text = getString(R.string.dahi_keybg_opacity_label, progress)
+                    if (fromUser) {
+                        DahiKeyboardBackground.setOpacityPercent(progress)
+                        refreshPreview()
+                    }
+                }
+
+                override fun onStartTrackingTouch(seekBar: SeekBar?) = Unit
+
+                override fun onStopTrackingTouch(seekBar: SeekBar?) = Unit
+            },
+        )
+        candSwitch?.setOnCheckedChangeListener { _, v ->
+            DahiKeyboardBackground.setCandidateBarEnabled(v)
+            refreshPreview()
+        }
+
+        refreshPreview()
+    }
+
+    private fun onImagePicked(
+        uri: Uri,
+        slot: DahiKeyboardBackground.Slot,
+    ) {
+        val ctx = context ?: return
+        val bytes = DahiKeyboardBackground.readUriBytes(uri)
+        if (bytes == null) {
+            toast(R.string.dahi_keybg_load_failed)
+            return
+        }
+        if (DahiGifDrawable.isGif(bytes)) {
+            // GIF 动图：原样保存（不裁剪，保留动画）
+            val ok = DahiKeyboardBackground.importRawBytes(bytes, slot)
+            Toast
+                .makeText(ctx, if (ok) R.string.dahi_keybg_gif_saved else R.string.dahi_keybg_load_failed, Toast.LENGTH_SHORT)
+                .show()
+            refreshPreview()
+            return
+        }
+        val bmp = DahiKeyboardBackground.decodeImage(bytes)
+        if (bmp == null) {
+            toast(R.string.dahi_keybg_load_failed)
+            return
+        }
+        DahiCropDialog(ctx, bmp, aspectFor(slot)) { cropped ->
+            val ok = DahiKeyboardBackground.importBitmap(cropped, slot)
+            Toast
+                .makeText(ctx, if (ok) R.string.dahi_keybg_saved else R.string.dahi_keybg_load_failed, Toast.LENGTH_SHORT)
+                .show()
+            refreshPreview()
+        }.show()
+    }
+
+    private fun onVideoPicked(uri: Uri) {
+        val ctx = context ?: return
+        val bytes = DahiKeyboardBackground.readUriBytes(uri)
+        if (bytes == null) {
+            toast(R.string.dahi_keybg_load_failed)
+            return
+        }
+        val ok = DahiKeyboardBackground.importRawBytes(bytes, DahiKeyboardBackground.Slot.VIDEO)
+        Toast
+            .makeText(ctx, if (ok) R.string.dahi_keybg_saved else R.string.dahi_keybg_load_failed, Toast.LENGTH_SHORT)
+            .show()
+        refreshPreview()
+    }
+
+    private fun aspectFor(slot: DahiKeyboardBackground.Slot): Float = when (slot) {
+        DahiKeyboardBackground.Slot.LANDSCAPE -> 3.0f
+        DahiKeyboardBackground.Slot.CANDIDATE -> 4.0f
+        else -> 1.6f
+    }
+
+    private fun refreshPreview() {
+        val preview = previewView ?: return
+        enabledSwitch?.isChecked = DahiKeyboardBackground.isEnabled()
+        candSwitch?.isChecked = DahiKeyboardBackground.isCandidateBarEnabled()
+        // 视频背景在预览框不显示画面，用一行提示代替
+        val isVideo = DahiKeyboardBackground.source() == DahiKeyboardBackground.SOURCE_VIDEO
+        videoTip?.visibility = if (isVideo) View.VISIBLE else View.GONE
+        val mode = DahiKeyboardBackground.modeFor(DahiKeyboardBackground.Slot.PORTRAIT)
+        val gif = DahiKeyboardBackground.previewGifDrawable()
+        val bmp = if (gif == null) DahiKeyboardBackground.previewBitmap() else null
+        when {
+            gif != null -> {
+                preview.scaleType = ImageView.ScaleType.FIT_XY
+                preview.setImageDrawable(gif)
+            }
+            bmp != null && mode == DahiKeyboardBackground.Mode.TILE -> {
+                preview.scaleType = ImageView.ScaleType.FIT_XY
+                preview.setImageDrawable(
+                    BitmapDrawable(resources, bmp).apply {
+                        setTileModeXY(Shader.TileMode.REPEAT, Shader.TileMode.REPEAT)
+                    },
+                )
+            }
+            else -> {
+                preview.setImageBitmap(bmp)
+                // 预览始终显示整张图片（居中/原图等比），不再裁掉上下两端
+                preview.scaleType =
+                    if (mode == DahiKeyboardBackground.Mode.STRETCH) {
+                        ImageView.ScaleType.FIT_XY
+                    } else {
+                        ImageView.ScaleType.FIT_CENTER
+                    }
+            }
+        }
+        preview.alpha = DahiKeyboardBackground.opacityPercent() / 100f
+    }
+
+    private val modeOrder =
+        listOf(
+            DahiKeyboardBackground.Mode.STRETCH,
+            DahiKeyboardBackground.Mode.CENTER,
+            DahiKeyboardBackground.Mode.FIT,
+            DahiKeyboardBackground.Mode.TILE,
+        )
+
+    private fun modeLabelRes(mode: DahiKeyboardBackground.Mode): Int = when (mode) {
+        DahiKeyboardBackground.Mode.STRETCH -> R.string.dahi_keybg_mode_stretch
+        DahiKeyboardBackground.Mode.FIT -> R.string.dahi_keybg_mode_fit
+        DahiKeyboardBackground.Mode.TILE -> R.string.dahi_keybg_mode_tile
+        else -> R.string.dahi_keybg_mode_center
+    }
+
+    /** 为某个槽位平铺展示「填充模式」单选组（各槽位独立保存，一次点击即选）。 */
+    private fun installModeGroup(
+        group: RadioGroup,
+        slot: DahiKeyboardBackground.Slot,
+    ) {
+        val ctx = context ?: return
+        val current = DahiKeyboardBackground.modeFor(slot)
+        var initialId = View.NO_ID
+        modeOrder.forEach { mode ->
+            val button =
+                RadioButton(ctx).apply {
+                    text = getString(modeLabelRes(mode))
+                    id = View.generateViewId()
+                    tag = mode
+                }
+            group.addView(button)
+            if (mode == current) initialId = button.id
+        }
+        // 先选中再注册监听：初始 check 不会触发回调
+        if (initialId != View.NO_ID) group.check(initialId)
+        group.setOnCheckedChangeListener { g, checkedId ->
+            val mode = g.findViewById<RadioButton>(checkedId).tag as? DahiKeyboardBackground.Mode
+                ?: return@setOnCheckedChangeListener
+            DahiKeyboardBackground.setModeFor(slot, mode)
+            refreshPreview()
+        }
+    }
+
+    private fun toast(res: Int) {
+        Toast.makeText(requireContext(), res, Toast.LENGTH_SHORT).show()
+    }
+
+    private fun dp(value: Int): Int = (value * resources.displayMetrics.density).toInt()
+}
