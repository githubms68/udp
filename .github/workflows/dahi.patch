+            }
+    }
+
+    /**
+     * 导出为**明文**文件（剪贴板 / 收藏夹 / 短语 / 统计 / 候选排序）。
+     *
+     * 与加密备份的区别见 [DahiPlainExport]：加密备份只能在 App 里还原，
+     * 明文导出是为了拿到电脑上用（记事本、Excel、rime custom_phrase）。
+     * 因此流程里加了两次确认，并在文件头写明「明文请妥善保管」。
+     */
+    fun showPlainExportDialog() {
+        val ctx = fragment.requireContext()
+        val sections = DahiPlainExport.Section.entries.toTypedArray()
+        val labels = sections.map { ctx.getString(it.labelRes) }.toTypedArray()
+        val checked = BooleanArray(sections.size) { it != sections.indexOf(DahiPlainExport.Section.ORDER) }
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_plain_title)
+            .setMultiChoiceItems(labels, checked) { _, which, isChecked -> checked[which] = isChecked }
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val chosen = sections.filterIndexed { index, _ -> checked[index] }.toSet()
+                if (chosen.isEmpty()) {
+                    ctx.toast(R.string.dahi_backup_empty_selection)
+                    return@setPositiveButton
+                }
+                askFormat(chosen)
+            }.show()
+    }
+
+    /**
+     * 第二步：选格式。
+     *
+     * 注意这里**只用纯列表、不挂 message**：AlertDialog 同时设置 message 与列表项时，
+     * 较长的 message 会把列表区域挤掉，表现为「只有提示、没有选项、只能取消」。
+     * 安全提示移到下一步的确认框里，既避免布局冲突，也符合「先选做什么、再确认风险」的顺序。
+     */
+    private fun askFormat(sections: Set<DahiPlainExport.Section>) {
+        val ctx = fragment.requireContext()
+        val formats =
+            arrayOf(
+                ctx.getString(R.string.dahi_plain_fmt_txt),
+                ctx.getString(R.string.dahi_plain_fmt_csv),
+                ctx.getString(R.string.dahi_plain_fmt_rime),
+            )
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_plain_format)
+            .setItems(formats) { _, which -> confirmPlainExport(sections, which) }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    /** 第三步：安全确认（含「只想在电脑上看就用加密备份 + 离线单文件解密器」的引导）。 */
+    private fun confirmPlainExport(
+        sections: Set<DahiPlainExport.Section>,
+        which: Int,
+    ) {
+        val ctx = fragment.requireContext()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_plain_confirm_title)
+            .setMessage(R.string.dahi_plain_warning)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(R.string.dahi_plain_confirm_go) { _, _ ->
+                startPlainExport(sections, which)
+            }.show()
+    }
+
+    private fun startPlainExport(
+        sections: Set<DahiPlainExport.Section>,
+        which: Int,
+    ) {
+        val format = when (which) {
+            1 -> DahiPlainExport.Format.CSV
+            2 -> DahiPlainExport.Format.PHRASE_RIME
+            else -> DahiPlainExport.Format.TXT
+        }
+        // rime 格式只对短语有意义，其它内容忽略
+        val effective = if (format == DahiPlainExport.Format.PHRASE_RIME) {
+            setOf(DahiPlainExport.Section.PHRASE)
+        } else {
+            sections
+        }
+        fragment.lifecycleScope.launch {
+            val ctx = fragment.requireContext()
+            val text =
+                runCatching {
+                    withContext(Dispatchers.IO) { DahiPlainExport.build(ctx, effective, format) }
+                }.getOrNull()
+            if (text == null) {
+                ctx.toast(R.string.dahi_backup_failure)
+                return@launch
+            }
+            pendingPlain = text
+            val name = DahiPlainExport.fileName(format)
+            if (format == DahiPlainExport.Format.CSV) plainCsvLauncher.launch(name) else plainTextLauncher.launch(name)
+        }
+    }
+
+    private fun handlePlainSave(uri: Uri?) {
+        val text = pendingPlain
+        pendingPlain = null
+        if (uri == null || text == null) return
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            val ok =
+                runCatching {
+                    withContext(Dispatchers.IO) {
+                        ctx.contentResolver.openOutputStream(uri)?.use { out ->
+                            out.write(text.toByteArray(Charsets.UTF_8))
+                        } ?: error("no output stream")
+                    }
+                    true
+                }.getOrDefault(false)
+            ctx.toast(if (ok) R.string.dahi_plain_done else R.string.dahi_backup_failure)
+        }
+    }
+
+    /**
+     * 备份文件名：`trime_dahi_backup-20261029-2232.dahibak`。
+     *
+     * 用「年月日-时分」而不是毫秒时间戳：用户事后要判断「这是哪一次备份」，
+     * 一串 `1793284317767` 完全看不出时间；同一分钟备份两次会被系统自动加 (1)。
+     */
+    private fun backupFileName(): String {
+        val stamp = SimpleDateFormat("yyyyMMdd-HHmm", Locale.US).format(Date())
+        return "trime_dahi_backup-$stamp.dahibak"
+    }
+
+    fun showBackupDialog() {
+        if (backupInProgress) return
+        val ctx = fragment.requireContext()
+        val items =
+            arrayOf(
+                ctx.getString(R.string.dahi_backup_pref),
+                ctx.getString(R.string.dahi_backup_clipboard),
+                ctx.getString(R.string.dahi_backup_collection),
+                ctx.getString(R.string.dahi_backup_voice_imagery),
+                ctx.getString(R.string.dahi_backup_cand_order),
+                ctx.getString(R.string.dahi_backup_custom_phrase),
+                ctx.getString(R.string.dahi_backup_keybg),
+                ctx.getString(R.string.dahi_backup_stats),
+                ctx.getString(R.string.dahi_backup_word_hidden),
+                ctx.getString(R.string.dahi_backup_phrase_stats),
+            )
+        val checked = booleanArrayOf(true, true, true, true, true, true, true, true, true, true)
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_backup_select_items)
+            .setMultiChoiceItems(items, checked) { _, which, isChecked ->
+                checked[which] = isChecked
+            }.setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                if (!checked.any { it }) {
+                    ctx.toast(R.string.dahi_backup_empty_selection)
+                    return@setPositiveButton
+                }
+                askPassword(R.string.dahi_backup_set_password) { password ->
+                    performBackup(
+                        checked[0],
+                        checked[1],
+                        checked[2],
+                        checked[3],
+                        checked[4],
+                        checked[5],
+                        checked[6],
+                        checked[7],
+                        checked[8],
+                        checked[9],
+                        password,
+                    )
+                }
+            }.show()
+    }
+
+    fun showRestoreDialog() {
+        if (restoreInProgress) return
+        openLauncher.launch(arrayOf(MIME, "application/octet-stream", "*/*"))
+    }
+
+    private fun performBackup(
+        includePreferences: Boolean,
+        includeClipboard: Boolean,
+        includeCollection: Boolean,
+        includeVoiceImagery: Boolean,
+        includeCandidateOrder: Boolean,
+        includeCustomPhrase: Boolean,
+        includeKeyboardBackground: Boolean,
+        includeInputStats: Boolean,
+        includeWordHidden: Boolean,
+        includePhraseStats: Boolean,
+        password: CharArray,
+    ) {
+        if (backupInProgress) return
+        backupInProgress = true
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            var encrypted: ByteArray? = null
+            runCatching {
+                withLoadingDialog(ctx) {
+                    withContext(Dispatchers.IO) {
+                        val data =
+                            BackupManager.createBackup(
+                                includePreferences = includePreferences,
+                                includeClipboard = includeClipboard,
+                                includeCollection = includeCollection,
+                                includeVoiceImagery = includeVoiceImagery,
+                                includeCandidateOrder = includeCandidateOrder,
+                                includeCustomPhrase = includeCustomPhrase,
+                                includeKeyboardBackground = includeKeyboardBackground,
+                                includeInputStats = includeInputStats,
+                                includeWordHidden = includeWordHidden,
+                                includePhraseStats = includePhraseStats,
+                            )
+                        encrypted = BackupManager.encode(data, password)
+                    }
+                }
+            }
+            val bytes = encrypted
+            if (bytes == null) {
+                ctx.toast(R.string.dahi_backup_failure)
+                backupInProgress = false
+                return@launch
+            }
+            // 键盘背景（图片 / GIF / 视频以 base64 内嵌）能把备份撑到几十 MB，
+            // 保存时会有可感知的停顿；先打个招呼，免得用户以为卡死了。
+            if (bytes.size > 20 * 1024 * 1024) {
+                ctx.toast(ctx.getString(R.string.dahi_backup_large, bytes.size / (1024 * 1024)))
+            }
+            pendingBackupBytes = bytes
+            saveLauncher.launch(backupFileName())
+        }
+    }
+
+    private fun handleBackupSave(uri: Uri) {
+        val data = pendingBackupBytes
+        pendingBackupBytes = null
+        val ctx = fragment.requireContext()
+        if (data == null) {
+            ctx.toast(R.string.dahi_backup_failure)
+            backupInProgress = false
+            return
+        }
+        fragment.lifecycleScope.launch {
+            val ok =
+                withContext(Dispatchers.IO) {
+                    runCatching {
+                        ctx.contentResolver.openOutputStream(uri)?.use { it.write(data) }
+                            ?: error("No output stream for uri")
+                    }.isSuccess
+                }
+            ctx.toast(if (ok) R.string.dahi_backup_success else R.string.dahi_backup_failure)
+            // 备份成功即刷新「备份提醒」的计时起点
+            if (ok) {
+                DahiBackupReminder.noteBackup()
+                // 记下时间，设置页「最近备份」那一行才有东西可显示
+                runCatching {
+                    com.osfans.trime.data.prefs.AppPrefs.defaultInstance().profile.dahiLastManualBackup
+                        .setValue(System.currentTimeMillis())
+                }
+            }
+            backupInProgress = false
+        }
+    }
+
+    private fun handleRestoreOpen(uri: Uri) {
+        if (restoreInProgress) return
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            val bytes =
+                withContext(Dispatchers.IO) {
+                    runCatching {
+                        ctx.contentResolver.openInputStream(uri)?.use { it.readBytes() }
+                    }.getOrNull()
+                }
+            if (bytes == null || bytes.isEmpty() || !BackupCrypto.isEncrypted(bytes)) {
+                ctx.toast(R.string.dahi_restore_invalid_file)
+                return@launch
+            }
+            pendingRestoreSize = bytes.size
+            val version = BackupCrypto.readVersion(bytes)
+            if (version != null && version > BackupCrypto.SUPPORTED_VERSION) {
+                // 未来版本的备份：明确告知「不是密码错，而是 App 太旧」
+                AlertDialog
+                    .Builder(ctx)
+                    .setTitle(R.string.dahi_restore_version_title)
+                    .setMessage(
+                        ctx.getString(
+                            R.string.dahi_restore_version_message,
+                            version,
+                            BackupCrypto.SUPPORTED_VERSION,
+                        ),
+                    )
+                    .setPositiveButton(android.R.string.ok, null)
+                    .show()
+                return@launch
+            }
+            askPassword(R.string.dahi_backup_enter_password) { password ->
+                performRestore(bytes, password)
+            }
+        }
+    }
+
+    private fun performRestore(
+        bytes: ByteArray,
+        password: CharArray,
+    ) {
+        restoreInProgress = true
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            var decoded: BackupData? = null
+            var failure: Throwable? = null
+            runCatching {
+                withLoadingDialog(ctx) {
+                    withContext(Dispatchers.IO) {
+                        decoded = BackupManager.decode(bytes, password)
+                    }
+                }
+            }.onFailure { failure = it }
+            val data = decoded
+            if (data == null) {
+                // 区分「密码错」和「文件被截断/损坏」：两者提示不同，否则用户只会怀疑密码
+                val broken = failure?.let { it is javax.crypto.AEADBadTagException || it.cause is javax.crypto.AEADBadTagException } == true
+                ctx.toast(
+                    if (broken) R.string.dahi_restore_wrong_or_broken else R.string.dahi_restore_wrong_password,
+                )
+                restoreInProgress = false
+                return@launch
+            }
+            showRestoreItems(data)
+        }
+    }
+
+    /** 还原前的「备份概览」：时间 / 来源版本 / 文件大小，避免还原错文件。 */
+    private fun restoreSummary(data: BackupData): String {
+        val ctx = fragment.requireContext()
+        val time = SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.getDefault()).format(Date(data.timestamp))
+        val from = data.appVersion ?: ctx.getString(R.string.dahi_restore_unknown_version)
+        val size =
+            when {
+                pendingRestoreSize >= 1024 * 1024 -> String.format(Locale.US, "%.1f MB", pendingRestoreSize / 1024f / 1024f)
+                pendingRestoreSize >= 1024 -> String.format(Locale.US, "%.0f KB", pendingRestoreSize / 1024f)
+                else -> "$pendingRestoreSize B"
+            }
+        return ctx.getString(R.string.dahi_restore_overview, time, from, size)
+    }
+
+    private fun showRestoreItems(data: BackupData) {
+        val ctx = fragment.requireContext()
+        val items =
+            arrayOf(
+                ctx.getString(R.string.dahi_backup_pref),
+                ctx.getString(R.string.dahi_backup_clipboard),
+                ctx.getString(R.string.dahi_backup_collection),
+                ctx.getString(R.string.dahi_backup_voice_imagery),
+                ctx.getString(R.string.dahi_backup_cand_order),
+                ctx.getString(R.string.dahi_backup_custom_phrase),
+                ctx.getString(R.string.dahi_backup_keybg),
+                ctx.getString(R.string.dahi_backup_stats),
+                ctx.getString(R.string.dahi_backup_word_hidden),
+                ctx.getString(R.string.dahi_backup_phrase_stats),
+            )
+        val available =
+            booleanArrayOf(
+                data.preferences != null,
+                data.clipboard != null,
+                data.collection != null,
+                data.voiceImagery != null,
+                data.candidateOrder != null,
+                data.customPhrase != null,
+                data.keyboardBackground != null,
+                data.inputStats != null,
+                data.wordHidden != null,
+                data.phraseStats != null,
+            )
+        val checked = available.copyOf()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_restore_select_items)
+            .setMessage(restoreSummary(data) + "\n\n" + ctx.getString(R.string.dahi_restore_replace_warning))
+            .setMultiChoiceItems(items, checked) { _, which, isChecked ->
+                checked[which] = isChecked
+            }.setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val restorePref = checked[0] && available[0]
+                val restoreClip = checked[1] && available[1]
+                val restoreColl = checked[2] && available[2]
+                val restoreVoice = checked[3] && available[3]
+                val restoreCandOrder = checked[4] && available[4]
+                val restoreCustomPhrase = checked[5] && available[5]
+                val restoreKeybg = checked[6] && available[6]
+                val restoreStats = checked[7] && available[7]
+                val restoreWordHidden = checked[8] && available[8]
+                val restorePhraseStats = checked[9] && available[9]
+                val anySelected =
+                    restorePref || restoreClip || restoreColl || restoreVoice ||
+                        restoreCandOrder || restoreCustomPhrase || restoreKeybg || restoreStats ||
+                        restoreWordHidden || restorePhraseStats
+                if (!anySelected) {
+                    ctx.toast(R.string.dahi_backup_empty_selection)
+                    return@setPositiveButton
+                }
+                if (restoreCustomPhrase) {
+                    // 自定义短语支持“覆盖 / 合并”，由用户选择
+                    askPhraseMergeMode { merge ->
+                        applyRestore(
+                            data,
+                            restorePref,
+                            restoreClip,
+                            restoreColl,
+                            restoreVoice,
+                            restoreCandOrder,
+                            restoreCustomPhrase,
+                            merge,
+                            restoreKeybg,
+                            restoreStats,
+                            restoreWordHidden,
+                            restorePhraseStats,
+                        )
+                    }
+                } else {
+                    applyRestore(
+                        data,
+                        restorePref,
+                        restoreClip,
+                        restoreColl,
+                        restoreVoice,
+                        restoreCandOrder,
+                        restoreCustomPhrase,
+                        false,
+                        restoreKeybg,
+                        restoreStats,
+                        restoreWordHidden,
+                        restorePhraseStats,
+                    )
+                }
+            }.show()
+    }
+
+    private fun askPhraseMergeMode(onChoice: (Boolean) -> Unit) {
+        val ctx = fragment.requireContext()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_restore_phrase_mode_title)
+            .setMessage(R.string.dahi_restore_phrase_mode_message)
+            .setPositiveButton(R.string.dahi_restore_phrase_merge) { _, _ -> onChoice(true) }
+            .setNeutralButton(R.string.dahi_restore_phrase_overwrite) { _, _ -> onChoice(false) }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun applyRestore(
+        data: BackupData,
+        restorePreferences: Boolean,
+        restoreClipboard: Boolean,
+        restoreCollection: Boolean,
+        restoreVoiceImagery: Boolean,
+        restoreCandidateOrder: Boolean,
+        restoreCustomPhrase: Boolean,
+        mergeCustomPhrase: Boolean,
+        restoreKeyboardBackground: Boolean,
+        restoreInputStats: Boolean = false,
+        restoreWordHidden: Boolean = false,
+        restorePhraseStats: Boolean = false,
+    ) {
+        val ctx = fragment.requireContext()
+        fragment.lifecycleScope.launch {
+            val ok =
+                runCatching {
+                    withLoadingDialog(ctx) {
+                        withContext(Dispatchers.IO) {
+                            BackupManager.applyBackup(
+                                data,
+                                restorePreferences,
+                                restoreClipboard,
+                                restoreCollection,
+                                restoreVoiceImagery,
+                                restoreCandidateOrder,
+                                restoreCustomPhrase,
+                                mergeCustomPhrase,
+                                restoreKeyboardBackground,
+                                restoreInputStats,
+                                // 之前这里漏了「词云隐藏」：勾了也不会还原（还原选项形同虚设）
+                                restoreWordHidden,
+                                restorePhraseStats,
+                            )
+                        }
+                    }
+                }.isSuccess
+            ctx.toast(if (ok) R.string.dahi_restore_success else R.string.dahi_restore_failure)
+            restoreInProgress = false
+        }
+    }
+
+    private fun askPassword(
+        @StringRes title: Int,
+        onPassword: (CharArray) -> Unit,
+    ) {
+        val ctx = fragment.requireContext()
+        val input =
+            EditText(ctx).apply {
+                inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+                hint = ctx.getString(R.string.dahi_backup_password_hint)
+                setSingleLine()
+            }
+        val margin = (24 * ctx.resources.displayMetrics.density).toInt()
+        val container =
+            FrameLayout(ctx).apply {
+                addView(
+                    input,
+                    FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                    ).apply { setMargins(margin, 0, margin, 0) },
+                )
+            }
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(title)
+            .setView(container)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val text = input.text?.toString().orEmpty()
+                if (text.isNotEmpty()) onPassword(text.toCharArray())
+            }.show()
+    }
+}
