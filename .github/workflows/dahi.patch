+import androidx.preference.PreferenceScreen
+import com.osfans.trime.R
+import com.osfans.trime.data.db.ClipboardHelper
 import com.osfans.trime.data.prefs.AppPrefs
 import com.osfans.trime.data.prefs.PreferenceDelegateFragment
+import kotlinx.coroutines.launch
 
-class ClipboardSettingsFragment : PreferenceDelegateFragment(AppPrefs.defaultInstance().clipboard)
+/**
+ * 剪贴板设置页。
+ *
+ * 两个「会删数据」的开关（保存时长 / 数量上限）都在这里，处理原则：
+ * 1. **先问再改**：保存时长点选之后不立刻生效，等用户确认；
+ * 2. **取消等于没动**：点取消就保持原值，绝不因为「已经点了一下」而偷偷改掉；
+ * 3. **当前值写在标题下**：不用点开就知道现在是几小时 / 几条。
+ */
+class ClipboardSettingsFragment : PreferenceDelegateFragment(AppPrefs.defaultInstance().clipboard) {
+    override fun onPreferenceUiCreated(screen: PreferenceScreen) {
+        val prefs = AppPrefs.defaultInstance().clipboard
+        val ctx = requireContext()
+
+        // 保存时长：显示当前值 + 点击后确认
+        screen.findPreference<Preference>(prefs.clipboardKeepSpan.key)?.apply {
+            summaryProvider =
+                Preference.SummaryProvider<Preference> {
+                    ctx.getString(
+                        R.string.dahi_keep_span_current,
+                        prefs.keepSpanText(ctx, prefs.keepMinutes()),
+                    )
+                }
+            setOnPreferenceChangeListener { _, newValue ->
+                // 返回 false：先不改值，等用户在弹出的框里确认
+                confirmSpanChange((newValue as? String) ?: "0")
+                false
+            }
+        }
+
+        // 数量上限：显示当前值 + 后果说明
+        screen.findPreference<Preference>(prefs.clipboardLimit.key)?.apply {
+            summaryProvider =
+                Preference.SummaryProvider<Preference> {
+                    val v = prefs.clipboardLimit.getValue()
+                    val current =
+                        if (v <= 0) {
+                            ctx.getString(R.string.dahi_clip_limit_none)
+                        } else {
+                            ctx.getString(R.string.dahi_clip_limit_count, v)
+                        }
+                    current + "\n" + ctx.getString(R.string.dahi_clip_limit_hint)
+                }
+        }
+    }
+
+    /** 真正把值写进去（同时同步列表控件的显示）。 */
+    private fun applySpan(value: String) {
+        val prefs = AppPrefs.defaultInstance().clipboard
+        prefs.clipboardKeepSpan.setValue(value)
+        // ListPreference 的选中项要手动同步，否则再点开对话框还是旧的那一项
+        runCatching {
+            val pref = findPreference<Preference>(prefs.clipboardKeepSpan.key) as? ListPreference
+            if (pref != null && pref.value != value) pref.value = value
+        }
+    }
+
+    private fun confirmSpanChange(value: String) {
+        val prefs = AppPrefs.defaultInstance().clipboard
+        val ctx = requireContext()
+        if (value == "0") {
+            // 切到「永久」不会删任何东西，直接生效
+            applySpan(value)
+            prefs.clipboardKeepSpanFrom.setValue(0L)
+            return
+        }
+        val minutes =
+            runCatching {
+                if (value == AppPrefs.Clipboard.KEEP_SPAN_CUSTOM) {
+                    prefs.clipboardKeepCustomDays.getValue().coerceIn(1, 9999) * 1440
+                } else {
+                    value.toIntOrNull() ?: 0
+                }
+            }.getOrDefault(0)
+        if (minutes <= 0) {
+            applySpan(value)
+            return
+        }
+        val label = prefs.keepSpanText(ctx, minutes)
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(ctx.getString(R.string.dahi_keep_span_will_change, label))
+            .setMessage(ctx.getString(R.string.dahi_keep_span_message))
+            .setPositiveButton(R.string.dahi_keep_span_future) { _, _ ->
+                // 二次确认：这类改动一旦误触，用户会以为「点错了也没事」，所以都再问一次
+                AlertDialog
+                    .Builder(ctx)
+                    .setTitle(R.string.dahi_keep_span_future_confirm_title)
+                    .setMessage(ctx.getString(R.string.dahi_keep_span_future_confirm, label))
+                    .setPositiveButton(android.R.string.ok) { _, _ ->
+                        applySpan(value)
+                        // 老内容全部保留，从现在起才按新时长过期
+                        prefs.clipboardKeepSpanFrom.setValue(System.currentTimeMillis())
+                        Toast.makeText(ctx, R.string.dahi_keep_span_future_toast, Toast.LENGTH_SHORT).show()
+                    }.setNegativeButton(android.R.string.cancel, null)
+                    .show()
+            }.setNegativeButton(R.string.dahi_keep_span_purge) { _, _ ->
+                // 「连历史一起清理」是真正的删除动作：先数清会删多少条，再郑重确认一次
+                lifecycleScope.launch {
+                    val cutoff = System.currentTimeMillis() - minutes * 60_000L
+                    val n = runCatching { ClipboardHelper.countBefore(cutoff) }.getOrDefault(0)
+                    AlertDialog
+                        .Builder(ctx)
+                        .setTitle(R.string.dahi_keep_span_purge_confirm_title)
+                        .setMessage(ctx.getString(R.string.dahi_keep_span_purge_confirm, n))
+                        .setPositiveButton(R.string.dahi_keep_span_purge_confirm_ok) { _, _ ->
+                            applySpan(value)
+                            prefs.clipboardKeepSpanFrom.setValue(0L)
+                            lifecycleScope.launch {
+                                ClipboardHelper.purgeExpired(minutes)
+                                Toast.makeText(ctx, R.string.dahi_keep_span_purged, Toast.LENGTH_SHORT).show()
+                            }
+                        }.setNegativeButton(android.R.string.cancel, null)
+                        .show()
+                }
+            }.setNeutralButton(android.R.string.cancel) { _, _ ->
+                // 取消 = 什么都没发生：既不删内容，也不改保存时长
+            }.show()
+    }
+}
