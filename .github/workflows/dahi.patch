diff --git a/app/src/main/java/com/osfans/trime/ime/clipboard/ClipboardSearchBridge.kt b/app/src/main/java/com/osfans/trime/ime/clipboard/ClipboardSearchBridge.kt
new file mode 100644
index 0000000..50330f8
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/ime/clipboard/ClipboardSearchBridge.kt
@@ -0,0 +1,80 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.clipboard
+
+/**
+ * 让输入法自身的按键输入进入剪贴板/收藏夹的搜索框。
+ *
+ * 输入法窗口内的 EditText 无法直接接收同文自身键盘提交的文本（提交会送往宿主应用），
+ * 因此在搜索框激活时，通过本桥把输入法（Rime）提交的文本重定向到搜索框。
+ * 非激活状态下 [acceptText]/[acceptBackspace] 恒返回 false，不拦截任何输入，
+ * 因此对原版行为零影响。
+ */
+object ClipboardSearchBridge {
+    @Volatile
+    var active: Boolean = false
+        private set
+
+    private var onText: ((String) -> Unit)? = null
+    private var onBackspace: (() -> Unit)? = null
+
+    /** 置位期间 [acceptText] 恒返回 false，用于「把内容真正上屏」而不是写进搜索框。 */
+    @Volatile
+    private var bypass = false
+
+    /**
+     * 宿主重新 bind 输入法（onStartInputView）时，浮层可能已经被重建的输入视图带走。
+     * 由浮层在这里登记一个"重新挂上去"的回调，输入法服务在回调之后调一下。
+     */
+    @Volatile
+    var onReattach: (() -> Unit)? = null
+
+    fun activate(
+        onText: (String) -> Unit,
+        onBackspace: () -> Unit,
+    ) {
+        this.onText = onText
+        this.onBackspace = onBackspace
+        active = true
+    }
+
+    fun reset() {
+        active = false
+        onText = null
+        onBackspace = null
+        onReattach = null
+    }
+
+    /**
+     * 在 [block] 内临时让出输入通路：文本会照常提交给宿主应用。
+     * 用于「点搜索结果上屏」——浮层继续留着，方便连续粘贴多条。
+     */
+    fun <T> withBypass(block: () -> T): T {
+        bypass = true
+        try {
+            return block()
+        } finally {
+            bypass = false
+        }
+    }
+
+    /** 若搜索框激活，则把提交的文本写入搜索框并返回 true（调用方不应再提交给宿主）。 */
+    fun acceptText(text: String): Boolean {
+        if (!active || bypass) return false
+        val handler = onText ?: return false
+        handler(text)
+        return true
+    }
+
+    /** 若搜索框激活，则删除搜索框末位字符并返回 true。 */
+    fun acceptBackspace(): Boolean {
+        if (!active) return false
+        val handler = onBackspace ?: return false
+        handler()
+        return true
+    }
+}
