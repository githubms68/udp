+            "keyboardHeight" -> style.keyboardHeight.toFloat()
+            "keyboardPadding" -> style.keyboardPadding.toFloat()
+            "keyboardPaddingLeft" -> style.keyboardPaddingLeft.toFloat()
+            "keyboardPaddingRight" -> style.keyboardPaddingRight.toFloat()
+            "keyboardPaddingBottom" -> style.keyboardPaddingBottom.toFloat()
+            "keyboardPaddingLand" -> style.keyboardPaddingLand.toFloat()
+            "keyboardPaddingLandBottom" -> style.keyboardPaddingLandBottom.toFloat()
+            "candidateViewHeight" -> style.candidateViewHeight.toFloat()
+            "candidateCornerRadius" -> style.candidateCornerRadius
+            "candidateBorder" -> style.candidateBorder.toFloat()
+            "candidatePadding" -> style.candidatePadding.toFloat()
+            "candidateSpacing" -> style.candidateSpacing
