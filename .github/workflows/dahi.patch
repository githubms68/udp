@@ -0,0 +1,56 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rime community
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.ime.custom
+
+import android.content.Context
+import com.osfans.trime.BuildConfig
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * 崩溃日志落盘（大海版）。
+ *
+ * 原来的崩溃处理只把栈丢进崩溃界面，关掉就没了；「诊断信息」里也没有任何痕迹。
+ * 这里把最近几次崩溃写到 `filesDir/dahi_crash.log`（只保留 64KB），
+ * 诊断页可以直接读出来导出，排查「某个功能一进去就闪退」时非常有用。
+ */
+object DahiCrashLog {
+    private const val FILE_NAME = "dahi_crash.log"
+    private const val MAX_BYTES = 64 * 1024
+
+    fun file(context: Context): File = File(context.filesDir, FILE_NAME)
+
+    /** 记录一次崩溃（追加到文件头部，超出上限时截断）。 */
+    @Synchronized
+    fun record(
+        context: Context,
+        throwable: Throwable,
+    ) {
+        runCatching {
+            val stamp = SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US).format(Date())
+            val block =
+                buildString {
+                    appendLine("=== $stamp ===")
+                    appendLine("version: ${BuildConfig.BUILD_VERSION_NAME} (${BuildConfig.VERSION_CODE})")
+                    appendLine("thread: ${Thread.currentThread().name}")
+                    appendLine(throwable.stackTraceToString())
+                }
+            val target = file(context)
+            val old = runCatching { target.readText() }.getOrDefault("")
+            target.writeText((block + "\n" + old).take(MAX_BYTES))
+        }
+    }
+
+    /** 读取已记录的崩溃文本（可能为空）。 */
+    fun latest(context: Context): String = runCatching { file(context).readText() }.getOrDefault("")
+
+    fun clear(context: Context) {
+        runCatching { file(context).delete() }
+    }
+}
