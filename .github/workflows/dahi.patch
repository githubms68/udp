+    /** 段位卡：徽章 + 境界 / 等级 + 称号 + 经验条 + 三属性。 */
+    private fun drawRankCard(
+        canvas: Canvas,
+        top: Float,
+        m: Model,
+    ): Float {
+        val l = m.l
+        val h = 290f
+        card(canvas, top, h, gradient = true)
+        val left = PAD + 28f
+        val badgeCx = left + 52f
+        val badgeCy = top + 82f
+        drawBadge(canvas, badgeCx, badgeCy, 52f, m.rank.realm)
+
+        canvas.drawText(m.rank.realm, left + 128f, top + 74f, tp(44f, textMain, true))
+        canvas.drawText("Lv.${m.rank.level}", left + 128f, top + 114f, tp(28f, accent2, true))
+        if (m.title.isNotEmpty()) {
+            canvas.drawText(
+                "「${m.title}」",
+                WIDTH - PAD - 28f,
+                top + 74f,
+                tp(27f, warm, true).apply { textAlign = Paint.Align.RIGHT },
+            )
+        }
+        canvas.drawText(
+            "${l.exp} ${m.rank.exp}",
+            WIDTH - PAD - 28f,
+            top + 114f,
+            tp(23f, textSub).apply { textAlign = Paint.Align.RIGHT },
+        )
+
+        // 经验条
+        val barTop = top + 152f
+        val barLeft = left
+        val barRight = WIDTH - PAD - 28f
+        val barW = barRight - barLeft
+        val trackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = trackBg }
+        val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = accent }
+        canvas.drawRoundRect(RectF(barLeft, barTop, barRight, barTop + 14f), 7f, 7f, trackPaint)
+        val fillW = (barW * m.rank.progress).coerceIn(8f, barW)
+        canvas.drawRoundRect(RectF(barLeft, barTop, barLeft + fillW, barTop + 14f), 7f, 7f, fillPaint)
+        canvas.drawText(
+            "${m.rank.inLevel} / ${m.rank.levelSpan}",
+            barLeft,
+            barTop + 42f,
+            tp(21f, textSub),
+        )
+
+        // 三属性 chip
+        val chipY = top + 214f
+        var x = barLeft
+        x = drawAttrChip(canvas, x, chipY, ChipKind.SPEED, l.attrSpeedLabel, m.attrSpeed)
+        x = drawAttrChip(canvas, x + 10f, chipY, ChipKind.ACCURACY, l.attrAccuracyLabel, m.attrAccuracy)
+        drawAttrChip(canvas, x + 10f, chipY, ChipKind.BREADTH, l.attrBreadthLabel, m.attrBreadth)
+        return top + h
+    }
