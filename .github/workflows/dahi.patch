+    /** 只接受整数的输入框（数字键盘）。 */
+    private fun numberInput(initial: Int): EditText = EditText(requireContext()).apply {
+        inputType = InputType.TYPE_CLASS_NUMBER
+        setText(initial.toString())
+        setSelection(text.length)
+        setSingleLine()
