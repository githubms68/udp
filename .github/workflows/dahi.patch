+import com.osfans.trime.data.theme.ThemeManager
+import com.osfans.trime.ime.custom.DahiToolbarConfig
+import splitties.dimensions.dp
+import splitties.resources.styledColor
+
+/**
+ * 工具栏按钮自定义（大海版）。
+ *
+ * 解决的是同文的一个老问题：工具按钮长什么样、有没有、排第几，
+ * 全写在主题 YAML 里，普通用户改不了、改了也会被主题更新覆盖。
+ *
+ * 这里提供三件事，全部落在**本机偏好**里（`dahi_toolbar_layout`）：
+ * 1. 勾选 / 取消：决定显示哪些按钮；
+ * 2. 顶 / ↑ / ↓ / 底：决定显示顺序（**列表从上到下 = 键盘上从右到左**，
+ *    与同文原始的 `tool_bar/buttons` 语义一致）；
+ * 3. 内置按钮池：主题没定义的常用按钮（设置菜单 / 剪贴板 / 输入统计 / 悬浮键盘）也能加上。
+ *
+ * 底部「恢复默认」= 清空偏好，回到主题原样。改完立刻重建输入视图，不需要重启。
+ */
+class DahiToolbarFragment : Fragment() {
+    private lateinit var content: LinearLayout
+
+    /** 当前展示顺序（左→右之外，实际是主题语义的「从右到左」，见页面说明）。 */
+    private var items: MutableList<DahiToolbarConfig.Item> = mutableListOf()
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        content =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(28))
+            }
+        return ScrollView(ctx).apply { addView(content) }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        reload()
+    }
+
+    // ------------------------------------------------------------------ 数据
+
+    /** 主题按钮 + 内置按钮，按「已保存顺序 → 主题原顺序」排列。 */
+
+    /** 深/浅色模式都看得清的主题色（不要再用硬编码灰，深色下会看不清）。 */
+    private fun dahiAccent(): Int = requireContext().styledColor(android.R.attr.colorAccent)
+
+    private fun dahiText2(): Int = requireContext().styledColor(android.R.attr.textColorSecondary)
+
+    private fun loadItems(): MutableList<DahiToolbarConfig.Item> {
+        val raw = ThemeManager.activeTheme.toolBar.buttons
+        val theme = DahiToolbarConfig.themeItems(raw)
+        val extras = DahiToolbarConfig.extraItems()
+        val all = theme + extras
+        val byKey = all.associateBy { it.key }
+        val list = ArrayList<DahiToolbarConfig.Item>(all.size)
+        DahiToolbarConfig.effectiveOrder(all).forEach { key ->
+            byKey[key]?.let { item ->
+                if (list.none { it.key == item.key }) list.add(item)
+            }
+        }
+        all.forEach { item -> if (list.none { it.key == item.key }) list.add(item) }
+        return list
+    }
+
+    private fun isVisible(item: DahiToolbarConfig.Item): Boolean {
+        if (item.key in DahiToolbarConfig.hidden()) return false
+        val extra = item.extra ?: return true
+        return extra.id in DahiToolbarConfig.enabledExtras()
+    }
+
+    // ------------------------------------------------------------------ 渲染
+
+    private fun reload() {
+        items = loadItems()
+        val ctx = requireContext()
+        content.removeAllViews()
+
+        content.addView(
+            TextView(ctx).apply {
+                setText(R.string.dahi_toolbar_tip)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12.5f)
+                setTextColor(dahiText2())
+                setPadding(0, 0, 0, ctx.dp(10))
+            },
+        )
+
+        if (items.isEmpty()) {
+            content.addView(
+                TextView(ctx).apply {
+                    setText(R.string.dahi_toolbar_empty)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+                    setTextColor(dahiText2())
+                },
+            )
+            return
+        }
+
+        var lastWasExtra = false
+        items.forEachIndexed { index, item ->
+            val isExtra = item.extra != null
+            if (isExtra && !lastWasExtra) {
+                content.addView(sectionTitle(R.string.dahi_toolbar_section_extra, topPadding = 14))
+            }
+            lastWasExtra = isExtra
+            content.addView(row(item, index))
+        }
+
+        content.addView(
+            Button(ctx).apply {
+                setText(R.string.dahi_toolbar_reset)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                layoutParams =
+                    LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+                        .apply { topMargin = ctx.dp(18) }
+                setOnClickListener { confirmReset() }
+            },
+        )
+    }
+
+    private fun sectionTitle(
+        label: Int,
+        topPadding: Int = 0,
+    ): TextView {
+        val ctx = requireContext()
+        return TextView(ctx).apply {
+            setText(label)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            setTextColor(dahiAccent())
+            setPadding(0, ctx.dp(topPadding), 0, ctx.dp(4))
+        }
+    }
+
+    private fun row(
+        item: DahiToolbarConfig.Item,
+        index: Int,
+    ): View {
+        val ctx = requireContext()
+        val visible = isVisible(item)
+        val row =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                setPadding(0, ctx.dp(2), 0, ctx.dp(2))
+            }
+        row.addView(
+            CheckBox(ctx).apply {
+                isChecked = visible
+                setOnCheckedChangeListener { _, checked ->
+                    setVisible(item, checked)
+                }
+            },
+        )
+        row.addView(
+            TextView(ctx).apply {
+                text = item.displayName()
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                // 不写死颜色：深色模式下写死 #222 会看不见；用默认文字色 + 透明度区分是否启用
+                alpha = if (visible) 1f else 0.45f
+                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+            },
+        )
+        row.addView(arrowButton("顶", enabled = index > 0) { moveTo(index, 0) })
+        row.addView(arrowButton("↑", enabled = index > 0) { moveTo(index, index - 1) })
+        row.addView(arrowButton("↓", enabled = index < items.size - 1) { moveTo(index, index + 1) })
+        row.addView(arrowButton("底", enabled = index < items.size - 1) { moveTo(index, items.size - 1) })
+        // 长按动作：点一下选「长按这个按钮时做什么」，没配就显示「长按」
+        val alt = DahiToolbarConfig.longPressOf(item.key)
+        val altLabel =
+            alt?.let { id ->
+                DahiToolbarConfig.Extra.entries.firstOrNull { it.id == id }
+                    ?.let { getString(it.labelRes) }
+                    ?: id
+            }
+        row.addView(
+            arrowButton(altLabel ?: "长按", enabled = true) { pickLongPress(item) }.apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+                setTextColor(if (alt == null) dahiText2() else dahiAccent())
+            },
+        )
+        return row
+    }
+
+    /** 给某个按钮选长按动作（复用内置按钮池；选「无」则清除）。 */
+    private fun pickLongPress(item: DahiToolbarConfig.Item) {
+        val ctx = requireContext()
+        val pool = DahiToolbarConfig.Extra.entries
+        val labels = ArrayList<String>(pool.size + 1)
+        labels.add(getString(R.string.dahi_toolbar_longpress_none))
+        pool.forEach { labels.add(getString(it.labelRes)) }
+        val current = DahiToolbarConfig.longPressOf(item.key)
+        val checked = pool.indexOfFirst { it.id == current } + 1
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(getString(R.string.dahi_toolbar_longpress_title, item.displayName()))
+            .setSingleChoiceItems(labels.toTypedArray(), checked) { dialog, which ->
+                if (which == 0) {
+                    DahiToolbarConfig.setLongPress(item.key, null)
+                } else {
+                    DahiToolbarConfig.setLongPress(item.key, pool[which - 1].id)
+                }
+                dialog.dismiss()
+                applyChange()
+                reload()
+            }.setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    private fun arrowButton(
+        text: String,
+        enabled: Boolean,
+        onTap: () -> Unit,
+    ): TextView {
+        val ctx = requireContext()
+        return TextView(ctx).apply {
+            setText(text)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 16f)
+            gravity = Gravity.CENTER
+            setPadding(ctx.dp(12), ctx.dp(6), ctx.dp(12), ctx.dp(6))
+            alpha = if (enabled) 1f else 0.3f
+            isEnabled = enabled
+            setOnClickListener { if (enabled) onTap() }
+        }
+    }
+
+    // ------------------------------------------------------------------ 操作
+
+    private fun setVisible(
+        item: DahiToolbarConfig.Item,
+        visible: Boolean,
+    ) {
+        val hidden = DahiToolbarConfig.hidden().toMutableSet()
+        if (visible) hidden.remove(item.key) else hidden.add(item.key)
+        DahiToolbarConfig.setHidden(hidden)
+
+        val extra = item.extra
+        if (extra != null) {
+            val extras = DahiToolbarConfig.enabledExtras().toMutableSet()
+            if (visible) extras.add(extra.id) else extras.remove(extra.id)
+            DahiToolbarConfig.setExtras(extras)
+        }
+        applyChange()
+    }
+
+    /** 把第 [index] 项移到第 [target] 位（上移/下移/置顶/垫底共用）。 */
+    private fun moveTo(
+        index: Int,
+        target: Int,
+    ) {
+        if (index !in items.indices || target !in items.indices || index == target) return
+        val item = items.removeAt(index)
+        items.add(target, item)
+        DahiToolbarConfig.setOrder(items.map { it.key })
+        applyChange()
+    }
+
+    private fun confirmReset() {
+        val ctx = requireContext()
+        AlertDialog
+            .Builder(ctx)
+            .setTitle(R.string.dahi_toolbar_reset)
+            .setMessage(R.string.dahi_toolbar_reset_msg)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                DahiToolbarConfig.reset()
+                applyChange()
+                Toast.makeText(ctx, R.string.dahi_toolbar_reset_done, Toast.LENGTH_SHORT).show()
+            }.show()
+    }
+
+    /** 保存后立刻让输入法重建工具条（自增令牌 ⇒ replaceInputView）。 */
+    private fun applyChange() {
+        reload()
+        runCatching {
+            val keyboard = AppPrefs.defaultInstance().keyboard
+            keyboard.dahiStyleApplyToken.setValue(keyboard.dahiStyleApplyToken.getValue() + 1)
+        }
+    }
+}
