diff --git a/app/src/plus/java/com/osfans/trime/asr/builtin/SherpaAsrEngine.kt b/app/src/plus/java/com/osfans/trime/asr/builtin/SherpaAsrEngine.kt
new file mode 100644
index 0000000..1b94b62
--- /dev/null
+++ b/app/src/plus/java/com/osfans/trime/asr/builtin/SherpaAsrEngine.kt
@@ -0,0 +1,362 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dahi
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.asr.builtin
+
+import android.content.Context
+import android.media.AudioFormat
+import android.media.AudioRecord
+import android.media.MediaRecorder
+import android.os.SystemClock
+import android.view.KeyEvent
+import androidx.lifecycle.lifecycleScope
+import com.k2fsa.sherpa.onnx.FeatureConfig
+import com.k2fsa.sherpa.onnx.OnlineModelConfig
+import com.k2fsa.sherpa.onnx.OnlineRecognizer
+import com.k2fsa.sherpa.onnx.OnlineRecognizerConfig
+import com.k2fsa.sherpa.onnx.OnlineStream
+import com.k2fsa.sherpa.onnx.OnlineTransducerModelConfig
+import com.osfans.trime.data.asr.AsrEnginePrefs
+import com.osfans.trime.data.asr.AsrModelManager
+import com.osfans.trime.data.db.asr.AsrHistoryBean
+import com.osfans.trime.data.db.asr.AsrHistoryStore
+import com.osfans.trime.ime.core.TrimeInputMethodService
+import com.osfans.trime.ime.custom.DahiKeyEffectBus
+import com.osfans.trime.ime.custom.DahiVoiceStats
+import com.osfans.trime.link.AsrEngine
+import com.osfans.trime.link.VoiceOverlayUiBridge
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import java.io.File
+import kotlin.concurrent.thread
+import kotlin.math.max
+import kotlin.math.sqrt
+
+/**
+ * 内置离线识别（sherpa-onnx / X-ASR 流式）。
+ *
+ * 只在 plus 包里存在：主源集通过反射（`Class.forName`）加载，plain 包里根本没有这个类，
+ * 因此 plain 包不会因为缺少 sherpa 依赖而编译失败。
+ *
+ * 本版实现的是「录完识别」：按住 → 逐块喂给 OnlineStream → 松开后再跑一遍 decode 取最终文本。
+ * 实时出字留到下一版（需要处理中间结果的非破坏性显示）。
+ */
+internal object SherpaAsrEngine : AsrEngine {
+    override val id: String = "builtin"
+
+    private const val SAMPLE_RATE = 16000
+    private const val FRAME_SAMPLES = 1600 // 100 ms
+
+    @Volatile
+    private var running = false
+
+    private var recognizer: OnlineRecognizer? = null
+    private var recognizerKey: String? = null
+    private var stream: OnlineStream? = null
+    private var recorder: AudioRecord? = null
+    private var worker: Thread? = null
+    private var service: TrimeInputMethodService? = null
+    private var label: String = "sherpa-onnx"
+    private var startedAt = 0L
+
+    @Volatile
+    private var voiceDetected = false
+
+    override fun isActive(): Boolean = running
+
+    override fun start(service: TrimeInputMethodService) {
+        if (running) return
+        this.service = service
+        val ctx = service.applicationContext
+
+        val dir = pickModelDir(ctx)
+        if (dir == null) {
+            service.toastText("没有可用模型：请先在「内置离线」里导入一个流式模型")
+            return
+        }
+        val files = resolveModelFiles(dir)
+        if (files == null) {
+            service.toastText("这个模型不是流式结构（需要 encoder/decoder/joiner + tokens.txt），请换成 X-ASR")
+            return
+        }
+        val rec =
+            try {
+                ensureRecognizer(dir, files)
+            } catch (t: Throwable) {
+                Timber.e(t, "load sherpa model failed")
+                service.toastText("模型加载失败：${t.message ?: t.javaClass.simpleName}")
+                return
+            }
+        val s = runCatching { rec.createStream() }.getOrNull()
+        if (s == null) {
+            service.toastText("创建识别流失败")
+            return
+        }
+        val record = openRecorder()
+        if (record == null) {
+            runCatching { s.release() }
+            service.toastText("无法打开麦克风")
+            return
+        }
+
+        label = AsrModelManager.friendlyName(dir.name)
+        stream = s
+        recorder = record
+        running = true
+        voiceDetected = false
+        startedAt = SystemClock.elapsedRealtime()
+        if (AsrEnginePrefs.keepScreenOn(ctx)) {
+            runCatching { service.window?.window?.decorView?.keepScreenOn = true }
+        }
+        runOnMain { VoiceOverlayUiBridge.onRecordingStarted?.invoke() }
+        startWorker(rec, s, record)
+    }
+
+    override fun stop() {
+        if (!running && recorder == null && stream == null) return
+        running = false
+        runCatching { recorder?.stop() }
+        runCatching { recorder?.release() }
+        recorder = null
+        runCatching { worker?.join(500) }
+        worker = null
+
+        val s = stream
+        val rec = recognizer
+        stream = null
+        val text =
+            if (s == null || rec == null) {
+                null
+            } else {
+                try {
+                    s.inputFinished()
+                    while (rec.isReady(s)) rec.decode(s)
+                    rec.getResult(s).text
+                } catch (t: Throwable) {
+                    Timber.w(t, "sherpa finalize failed")
+                    ""
+                } finally {
+                    runCatching { s.release() }
+                }
+            }
+        finish(text)
+    }
+
+    // ---------------- 内部：识别结束 ----------------
+
+    private fun finish(text: String?) {
+        val svc = service
+        val elapsed = if (startedAt > 0) SystemClock.elapsedRealtime() - startedAt else 0L
+        runCatching { svc?.window?.window?.decorView?.keepScreenOn = false }
+        startedAt = 0L
+
+        var finalText = text?.trim().orEmpty()
+        if (svc != null && finalText.isNotEmpty()) {
+            val ctx = svc.applicationContext
+            if (AsrEnginePrefs.trimEndPunctuation(ctx)) {
+                // 去掉句末标点/符号/emoji；整句只剩标点时结果为空，自然不上屏。
+                finalText = finalText.replace(Regex("[\\p{P}\\p{S}\\s]+$"), "")
+            }
+            if (AsrEnginePrefs.filterSilence(ctx) && !voiceDetected) {
+                finalText = ""
+            }
+        }
+
+        if (svc != null && finalText.isNotEmpty()) {
+            val committed = finalText
+            svc.lifecycleScope.launch {
+                runCatching { DahiKeyEffectBus.expectVoice() }
+                runCatching { svc.commitText(committed) }
+                runCatching { DahiVoiceStats.onVoiceText(committed) }
+                if (runCatching { AsrEnginePrefs.autoEnter(svc.applicationContext) }.getOrDefault(false)) {
+                    val ic = runCatching { svc.currentInputConnection }.getOrNull()
+                    if (ic != null) {
+                        runCatching {
+                            ic.sendKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_ENTER))
+                            ic.sendKeyEvent(KeyEvent(KeyEvent.ACTION_UP, KeyEvent.KEYCODE_ENTER))
+                        }
+                    }
+                }
+                runCatching {
+                    AsrHistoryStore.record(
+                        context = svc,
+                        text = committed,
+                        engine = label,
+                        source = AsrHistoryBean.SOURCE_BUILTIN,
+                        durRecordMs = elapsed,
+                    )
+                }
+            }
+        }
+        runOnMain { VoiceOverlayUiBridge.onDone?.invoke() }
+    }
+
+    // ---------------- 内部：录音 ----------------
+
+    private fun startWorker(
+        rec: OnlineRecognizer,
+        stream: OnlineStream,
+        record: AudioRecord,
+    ) {
+        val ctx = service?.applicationContext
+        val filterSilence = ctx != null && AsrEnginePrefs.filterSilence(ctx)
+        val autoStop = ctx != null && AsrEnginePrefs.autoStop(ctx)
+        val threshold = ctx?.let { AsrEnginePrefs.silenceThreshold(it) } ?: 0.007f
+        val holdSilenceMs = ctx?.let { AsrEnginePrefs.silenceMs(it) }?.toLong() ?: 1200L
+
+        worker =
+            thread(name = "dahi-sherpa-asr", start = true) {
+                val buf = ShortArray(FRAME_SAMPLES)
+                var silenceSince = 0L
+                try {
+                    while (running) {
+                        val n = record.read(buf, 0, buf.size)
+                        if (n <= 0) continue
+                        val samples = FloatArray(n) { buf[it] / 32768.0f }
+                        val rms = rmsOf(samples)
+                        val amp = (rms * 6f).coerceIn(0f, 1f)
+                        val voiced = rms > threshold
+
+                        // 「过滤静音」：开口之前的部分整段丢掉，不喂给识别器。
+                        if (filterSilence && !voiceDetected && !voiced) {
+                            runOnMain { VoiceOverlayUiBridge.onAmplitude?.invoke(amp) }
+                            continue
+                        }
+                        if (voiced) {
+                            voiceDetected = true
+                            silenceSince = 0L
+                        } else {
+                            if (silenceSince == 0L) silenceSince = SystemClock.elapsedRealtime()
+                            val quietFor = SystemClock.elapsedRealtime() - silenceSince
+                            if (autoStop && voiceDetected && quietFor >= holdSilenceMs) {
+                                // 交给主线程收尾，避免在工作线程里 join 自己。
+                                runOnMain { stop() }
+                                break
+                            }
+                        }
+
+                        stream.acceptWaveform(samples, SAMPLE_RATE)
+                        while (rec.isReady(stream)) rec.decode(stream)
+                        runOnMain { VoiceOverlayUiBridge.onAmplitude?.invoke(amp) }
+                    }
+                } catch (t: Throwable) {
+                    Timber.w(t, "sherpa worker stopped")
+                }
+            }
+    }
+
+    private fun openRecorder(): AudioRecord? {
+        val minBuf =
+            AudioRecord.getMinBufferSize(
+                SAMPLE_RATE,
+                AudioFormat.CHANNEL_IN_MONO,
+                AudioFormat.ENCODING_PCM_16BIT,
+            )
+        val bufSize = max(minBuf, FRAME_SAMPLES * 2 * 4)
+        val record =
+            runCatching {
+                AudioRecord(
+                    MediaRecorder.AudioSource.VOICE_RECOGNITION,
+                    SAMPLE_RATE,
+                    AudioFormat.CHANNEL_IN_MONO,
+                    AudioFormat.ENCODING_PCM_16BIT,
+                    bufSize,
+                )
+            }.getOrNull() ?: return null
+        if (record.state != AudioRecord.STATE_INITIALIZED) {
+            runCatching { record.release() }
+            return null
+        }
+        val started = runCatching { record.startRecording() }.isSuccess
+        if (!started) {
+            runCatching { record.release() }
+            return null
+        }
+        return record
+    }
+
+    private fun rmsOf(samples: FloatArray): Float {
+        if (samples.isEmpty()) return 0f
+        var sum = 0.0
+        for (v in samples) sum += v * v
+        return sqrt(sum / samples.size).toFloat()
+    }
+
+    // ---------------- 内部：模型 ----------------
+
+    private data class ModelFiles(
+        val encoder: File,
+        val decoder: File,
+        val joiner: File,
+        val tokens: File,
+    )
+
+    private fun pickModelDir(ctx: Context): File? {
+        val models = AsrModelManager.list(ctx)
+        if (models.isEmpty()) return null
+        val name = AsrEnginePrefs.currentModel(ctx)
+        return models.firstOrNull { it.name == name }?.dir ?: models.first().dir
+    }
+
+    private fun resolveModelFiles(dir: File): ModelFiles? {
+        val onnxFiles =
+            runCatching {
+                dir.walkTopDown().filter { it.isFile && it.name.endsWith(".onnx", ignoreCase = true) }.toList()
+            }.getOrDefault(emptyList())
+        val tokens =
+            runCatching {
+                dir.walkTopDown().firstOrNull { it.isFile && it.name.equals("tokens.txt", ignoreCase = true) }
+            }.getOrNull() ?: return null
+        val encoder = onnxFiles.filter { it.name.contains("encoder", ignoreCase = true) }.minByOrNull { it.length() } ?: return null
+        val decoder = onnxFiles.firstOrNull { it.name.contains("decoder", ignoreCase = true) } ?: return null
+        val joiner = onnxFiles.firstOrNull { it.name.contains("joiner", ignoreCase = true) } ?: return null
+        return ModelFiles(encoder, decoder, joiner, tokens)
+    }
+
+    private fun ensureRecognizer(
+        dir: File,
+        files: ModelFiles,
+    ): OnlineRecognizer {
+        val key = dir.absolutePath
+        recognizer?.let { if (recognizerKey == key) return it }
+        runCatching { recognizer?.release() }
+        val config =
+            OnlineRecognizerConfig(
+                featConfig = FeatureConfig(sampleRate = SAMPLE_RATE, featureDim = 80),
+                modelConfig =
+                OnlineModelConfig(
+                    transducer =
+                    OnlineTransducerModelConfig(
+                        encoder = files.encoder.absolutePath,
+                        decoder = files.decoder.absolutePath,
+                        joiner = files.joiner.absolutePath,
+                    ),
+                    tokens = files.tokens.absolutePath,
+                    numThreads = 2,
+                    provider = "cpu",
+                    debug = false,
+                ),
+                enableEndpoint = true,
+                decodingMethod = "greedy_search",
+            )
+        val created = OnlineRecognizer(config = config)
+        recognizer = created
+        recognizerKey = key
+        return created
+    }
+
+    // ---------------- 内部：工具 ----------------
+
+    private fun runOnMain(block: () -> Unit) {
+        val svc = service ?: return
+        svc.lifecycleScope.launch(Dispatchers.Main.immediate) { runCatching { block() } }
+    }
+
+    private fun Context.toastText(text: String) {
+        runCatching { android.widget.Toast.makeText(this, text, android.widget.Toast.LENGTH_SHORT).show() }
+    }
+}
