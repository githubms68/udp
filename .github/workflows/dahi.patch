index 0000000..d465d83
--- /dev/null
+++ b/app/src/main/java/com/osfans/trime/data/asr/AsrModelManager.kt
@@ -0,0 +1,209 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Dahi
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+package com.osfans.trime.data.asr
+
+import android.content.Context
+import android.net.Uri
+import android.provider.OpenableColumns
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.util.zip.ZipInputStream
+
+/**
+ * 离线模型的存放与导入。
+ *
+ * 模型全部放在**应用内部私有目录**（filesDir/asr-models）：其他应用读不到，
+ * 卸载会被一并删除 —— 这是安全换来的代价，设置页会写明。
+ *
+ * 导入流程：SAF 选中 zip → 复制到 cache → 解压 → 校验（必须有 .onnx 与 tokens.txt）
+ * → 搬到 models 目录 → 清缓存。任何一步失败都不会留下半成品。
+ */
+object AsrModelManager {
+    /** 官方模型下载页（在浏览器打开，App 自己不联网）。 */
+    const val DOWNLOAD_PAGE = "https://github.com/Gilgamesh-J/X-ASR/releases"
+
+    private const val DIR_NAME = "asr-models"
+
+    data class ModelInfo(
+        val name: String,
+        val dir: File,
+        val sizeBytes: Long,
+    ) {
+        /** 给界面的友好名，如「X-ASR 480ms 中英」；认不出来的模型原样显示目录名。 */
+        val displayName: String
+            get() = friendlyName(name)
+
+        val sizeText: String
+            get() =
+                when {
+                    sizeBytes >= 1024L * 1024 * 1024 -> String.format("%.1f GB", sizeBytes / 1024.0 / 1024 / 1024)
+                    sizeBytes >= 1024L * 1024 -> String.format("%.1f MB", sizeBytes / 1024.0 / 1024)
+                    else -> String.format("%.0f KB", sizeBytes / 1024.0)
+                }
+    }
+
+    fun modelsDir(context: Context): File = File(context.filesDir, DIR_NAME).apply { if (!exists()) mkdirs() }
+
+    fun list(context: Context): List<ModelInfo> = runCatching {
+        modelsDir(context)
+            .listFiles()
+            ?.filter { it.isDirectory }
+            ?.map { dir -> ModelInfo(dir.name, dir, sizeOf(dir)) }
+            ?.sortedByDescending { it.sizeBytes }
+            .orEmpty()
+    }.getOrDefault(emptyList())
+
+    /**
+     * 从 zip 导入模型。
+     *
+     * @return 成功时返回已安装的模型；失败时带可读的错误说明（直接给用户看）。
+     */
+    suspend fun importZip(
+        context: Context,
+        uri: Uri,
+    ): Result<ModelInfo> = withContext(Dispatchers.IO) {
+        val workDir = File(context.cacheDir, "asr-import-${System.currentTimeMillis()}")
+        try {
+            runCatching { workDir.mkdirs() }
+            val zipFile = File(workDir, "model.zip")
+            context.contentResolver.openInputStream(uri)?.use { input ->
+                zipFile.outputStream().use { output -> input.copyTo(output) }
+            } ?: return@withContext Result.failure(IllegalStateException("无法读取所选文件"))
+
+            val extractDir = File(workDir, "extract").apply { mkdirs() }
+            unzipSafely(zipFile, extractDir)
+
+            val onnx = findFile(extractDir, ".onnx") ?: return@withContext Result.failure(
+                IllegalStateException("压缩包里没有 .onnx 模型文件"),
+            )
+            findFile(extractDir, "tokens.txt") ?: return@withContext Result.failure(
+                IllegalStateException("压缩包里没有 tokens.txt"),
+            )
+
+            val displayName =
+                displayNameOf(context, uri)?.removeSuffix(".zip")?.removeSuffix(".ZIP")
+                    ?: onnx.parentFile?.name
+                    ?: "model"
+            val target = File(modelsDir(context), sanitize(displayName))
+            if (target.exists()) target.deleteRecursively()
+            if (!extractDir.renameTo(target)) {
+                extractDir.copyRecursively(target, overwrite = true)
+                extractDir.deleteRecursively()
+            }
+            Result.success(ModelInfo(target.name, target, sizeOf(target)))
+        } catch (t: Throwable) {
+            Result.failure(t)
+        } finally {
+            runCatching { workDir.deleteRecursively() }
+        }
+    }
+
+    fun delete(
+        context: Context,
+        name: String,
+    ): Boolean = runCatching {
+        val dir = File(modelsDir(context), name)
+        if (!dir.canonicalPath.startsWith(modelsDir(context).canonicalPath)) return@runCatching false
+        dir.deleteRecursively()
+    }.getOrDefault(false)
+
+    fun deleteAll(context: Context): Boolean = runCatching {
+        var ok = true
+        modelsDir(context).listFiles()?.forEach { if (!it.deleteRecursively()) ok = false }
+        ok
+    }.getOrDefault(false)
+
+    /** 从 SAF 的 Uri 读取原始文件名（否则会只剩我们自己的临时文件名 model.zip）。 */
+    private fun displayNameOf(
+        context: Context,
+        uri: Uri,
+    ): String? = runCatching {
+        context.contentResolver
+            .query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)
+            ?.use { cursor -> if (cursor.moveToFirst()) cursor.getString(0) else null }
+    }.getOrNull()
+
+    /** 把 sherpa 的目录名翻译成人能看懂的名字（认不出就原样返回）。 */
+    fun friendlyName(raw: String): String {
+        val n = raw.lowercase()
+        val base =
+            when {
+                n.contains("x-asr") || n.contains("xasr") -> "X-ASR"
+                n.contains("sense-voice") || n.contains("sensevoice") -> "SenseVoice"
+                n.contains("fire-red") || n.contains("firered") -> "FireRedASR"
+                n.contains("qwen3") -> "Qwen3-ASR"
+                n.contains("funasr") -> "FunASR Nano"
+                n.contains("parakeet") -> "Parakeet"
+                else -> return raw
+            }
+        val detail =
+            buildList {
+                if (n.contains("480ms")) add("480ms")
+                if (n.contains("960ms")) add("960ms")
+                if (n.contains("160ms")) add("160ms")
+                when {
+                    n.contains("ja-ko-yue") -> add("中英日韩粤")
+                    n.contains("zh-en") || n.contains("zh_en") -> add("中英")
+                    n.contains("russian") -> add("俄语")
+                }
+                if (n.contains("0.6b")) add("0.6B")
+            }
+        return if (detail.isEmpty()) base else base + " " + detail.joinToString(" ")
+    }
+
+    // ---------------- 内部实现 ----------------
+
+    private fun unzipSafely(
+        zipFile: File,
+        targetDir: File,
+    ) {
+        val targetRoot = targetDir.canonicalPath
+        ZipInputStream(zipFile.inputStream().buffered()).use { zis ->
+            var entry = zis.nextEntry
+            while (entry != null) {
+                val outFile = File(targetDir, entry.name)
+                // 防 Zip Slip：解压目标必须落在 extractDir 之内。
+                if (!outFile.canonicalPath.startsWith(targetRoot)) {
+                    throw IllegalStateException("压缩包里有非法路径：${entry.name}")
+                }
+                if (entry.isDirectory) {
+                    outFile.mkdirs()
+                } else {
+                    outFile.parentFile?.mkdirs()
+                    outFile.outputStream().use { out -> zis.copyTo(out) }
+                }
+                zis.closeEntry()
+                entry = zis.nextEntry
+            }
+        }
+    }
+
+    private fun findFile(
+        root: File,
+        suffix: String,
+    ): File? {
+        val stack = ArrayDeque<File>()
+        stack.add(root)
+        while (stack.isNotEmpty()) {
+            val dir = stack.removeFirst()
+            dir.listFiles()?.forEach { f ->
+                when {
+                    f.isDirectory -> stack.add(f)
+                    f.name.endsWith(suffix, ignoreCase = true) -> return f
+                }
+            }
+        }
+        return null
+    }
+
+    private fun sizeOf(dir: File): Long = runCatching {
+        dir.walkTopDown().filter { it.isFile }.sumOf { it.length() }
+    }.getOrDefault(0L)
+
+    private fun sanitize(name: String): String = name.replace(Regex("[^\\w\\-.]"), "_").take(64).ifBlank { "model" }
+}
