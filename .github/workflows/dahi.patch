+import com.osfans.trime.ime.custom.DahiHomeSlogan
+import splitties.dimensions.dp
+
+/**
+ * 「首页标语」设置页（大海版）。
+ *
+ * 支持三种显示方式：
+ * - **单条固定**：4 条预设之一 / 自定义文本 / 隐藏；
+ * - **每次随机**：勾选若干句子，每次进入首页随机显示其中一句；
+ * - **按时段切换**：按小时自动切换，时段与文案都可以自己写。
+ *
+ * 修复点：旧版点「自定义」会被 refresh 立刻打回预设（导致选不上、没法输入），
+ * 这里把「回显选中状态」和「用户点击」彻底分开，只有用户点击才写设置。
+ */
+class HomeSloganSettingsFragment : Fragment() {
+    private var preview: TextView? = null
+
+    private var modeGroup: RadioGroup? = null
+    private var modeSingleId = 0
+    private var modeRandomId = 0
+    private var modeTimeId = 0
+
+    private var singleBox: LinearLayout? = null
+    private var randomBox: LinearLayout? = null
+    private var timeBox: LinearLayout? = null
+
+    private var singleGroup: RadioGroup? = null
+    private var optionIds: List<Int> = emptyList()
+    private var offId = 0
+    private var customId = 0
+    private var customRow: LinearLayout? = null
+    private var customInput: EditText? = null
+
+    private var presetChecks: MutableList<CheckBox> = mutableListOf()
+    private var extrasBox: LinearLayout? = null
+    private var extraInput: EditText? = null
+    private var extraSentences: MutableList<String> = mutableListOf()
+
+    private var slotsInput: EditText? = null
+
+    /** 代码里主动改控件状态时，不要触发写设置。 */
+    private var suppress = false
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?,
+    ): View {
+        val ctx = requireContext()
+        val column =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(ctx.dp(16), ctx.dp(12), ctx.dp(16), ctx.dp(24))
+            }
+
+        column.addView(tipView(R.string.dahi_slogan_tip))
+
+        val previewView =
+            TextView(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 17f)
+                setPadding(0, ctx.dp(10), 0, ctx.dp(10))
+            }
+        preview = previewView
+        column.addView(previewView)
+
+        // 长句滚动播放：副标题放不下时横向跑马灯，老花眼/小屏也能看完一句话
+        column.addView(
+            CheckBox(ctx).apply {
+                setText(R.string.dahi_slogan_marquee)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                isChecked = DahiHomeSlogan.marqueeEnabled()
+                setOnCheckedChangeListener { _, value ->
+                    DahiHomeSlogan.setMarqueeEnabled(value)
+                    (activity as? com.osfans.trime.ui.main.MainActivity)?.refreshToolbarSlogan()
+                }
+            },
+        )
+
+        // ---------- 显示方式 ----------
+        column.addView(sectionLabel(R.string.dahi_slogan_mode_title))
+        val modes = RadioGroup(ctx).apply { orientation = LinearLayout.VERTICAL }
+        modeSingleId = addRadio(modes, getString(R.string.dahi_slogan_mode_single))
+        modeRandomId = addRadio(modes, getString(R.string.dahi_slogan_mode_random))
+        modeTimeId = addRadio(modes, getString(R.string.dahi_slogan_mode_time))
+        modeGroup = modes
+        modes.setOnCheckedChangeListener { _, checkedId ->
+            if (suppress) return@setOnCheckedChangeListener
+            val mode =
+                when (checkedId) {
+                    modeRandomId -> DahiHomeSlogan.Mode.RANDOM
+                    modeTimeId -> DahiHomeSlogan.Mode.TIME
+                    else -> DahiHomeSlogan.Mode.SINGLE
+                }
+            DahiHomeSlogan.setMode(mode)
+            refreshBoxes()
+        }
+        column.addView(modes)
+
+        // ---------- 单条固定 ----------
+        val single =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                visibility = View.GONE
+            }
+        val singleRadios = RadioGroup(ctx).apply { orientation = LinearLayout.VERTICAL }
+        val ids = mutableListOf<Int>()
+        DahiHomeSlogan.presets().forEach { text ->
+            ids.add(addRadio(singleRadios, text))
+        }
+        optionIds = ids
+        offId = addRadio(singleRadios, getString(R.string.dahi_slogan_none))
+        customId = addRadio(singleRadios, getString(R.string.dahi_slogan_custom))
+        singleGroup = singleRadios
+        singleRadios.setOnCheckedChangeListener { _, checkedId ->
+            if (suppress) return@setOnCheckedChangeListener
+            onSingleChecked(checkedId)
+        }
+        single.addView(singleRadios)
+
+        val input =
+            EditText(ctx).apply {
+                hint = getString(R.string.dahi_slogan_custom_hint)
+                setSingleLine()
+                imeOptions = EditorInfo.IME_ACTION_DONE
+                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+            }
+        customInput = input
+        val row =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+                visibility = View.GONE
+                addView(input)
+                addView(
+                    Button(ctx).apply {
+                        setText(R.string.dahi_slogan_save)
+                        setOnClickListener { saveCustom() }
+                    },
+                )
+            }
+        customRow = row
+        single.addView(row)
+        singleBox = single
+        column.addView(single)
+
+        // ---------- 每次随机 ----------
+        val random =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                visibility = View.GONE
+            }
+        random.addView(tipView(R.string.dahi_slogan_random_tip))
+        presetChecks = mutableListOf()
+        DahiHomeSlogan.presets().forEach { text ->
+            val check =
+                CheckBox(ctx).apply {
+                    setText(text)
+                    setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+                    setPadding(0, ctx.dp(2), 0, ctx.dp(2))
+                    setOnCheckedChangeListener { _, _ ->
+                        if (suppress) return@setOnCheckedChangeListener
+                        commitPool()
+                        updatePreview()
+                    }
+                }
+            presetChecks.add(check)
+            random.addView(check)
+        }
+        extrasBox = LinearLayout(ctx).apply { orientation = LinearLayout.VERTICAL }
+        random.addView(extrasBox)
+        val extraRow =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+                gravity = Gravity.CENTER_VERTICAL
+            }
+        val extra =
+            EditText(ctx).apply {
+                hint = getString(R.string.dahi_slogan_extra_hint)
+                setSingleLine()
+                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+            }
+        extraInput = extra
+        extraRow.addView(extra)
+        extraRow.addView(
+            Button(ctx).apply {
+                setText(R.string.dahi_slogan_add)
+                setOnClickListener { addExtra() }
+            },
+        )
+        random.addView(extraRow)
+        randomBox = random
+        column.addView(random)
+
+        // ---------- 按时段 ----------
+        val time =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.VERTICAL
+                visibility = View.GONE
+            }
+        time.addView(tipView(R.string.dahi_slogan_slots_tip))
+        val slots =
+            EditText(ctx).apply {
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                minLines = 6
+                gravity = Gravity.TOP or Gravity.START
+                inputType =
+                    android.text.InputType.TYPE_CLASS_TEXT or
+                    android.text.InputType.TYPE_TEXT_FLAG_MULTI_LINE
+            }
+        slotsInput = slots
+        time.addView(slots)
+        val slotButtons =
+            LinearLayout(ctx).apply {
+                orientation = LinearLayout.HORIZONTAL
+            }
+        slotButtons.addView(
+            Button(ctx).apply {
+                setText(R.string.dahi_slogan_save)
+                setOnClickListener { saveSlots() }
+            },
+        )
+        slotButtons.addView(
+            Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                setText(R.string.dahi_slogan_template)
+                setOnClickListener { slots.setText(DahiHomeSlogan.DEFAULT_SLOTS) }
+            },
+        )
+        time.addView(slotButtons)
+        timeBox = time
+        column.addView(time)
+
+        column.addView(
+            Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                setText(R.string.dahi_slogan_reset)
+                setOnClickListener {
+                    DahiHomeSlogan.reset()
+                    refreshAll()
+                    toast(getString(R.string.dahi_slogan_saved))
+                }
+            },
+        )
+
+        return ScrollView(ctx).apply { addView(column) }
+    }
+
+    override fun onViewCreated(
+        view: View,
+        savedInstanceState: Bundle?,
+    ) {
+        super.onViewCreated(view, savedInstanceState)
+        refreshAll()
+    }
+
+    // ---------- 构建辅助 ----------
+
+    private fun tipView(textRes: Int): TextView = TextView(requireContext()).apply {
+        setText(textRes)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+    }
+
+    private fun sectionLabel(textRes: Int): TextView = TextView(requireContext()).apply {
+        setText(textRes)
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+        setPadding(0, dp(12), 0, dp(4))
+    }
+
+    private fun addRadio(
+        group: RadioGroup,
+        text: String,
+    ): Int {
+        val ctx = requireContext()
+        val id = View.generateViewId()
+        group.addView(
+            RadioButton(ctx).apply {
+                this.id = id
+                setText(text)
+                setTextSize(TypedValue.COMPLEX_UNIT_SP, 15f)
+                setPadding(0, ctx.dp(4), 0, ctx.dp(4))
+            },
+        )
+        return id
+    }
+
+    // ---------- 回显 ----------
+
+    private fun refreshAll() {
+        suppress = true
+        val mode = DahiHomeSlogan.mode()
+        modeGroup?.check(
+            when (mode) {
+                DahiHomeSlogan.Mode.SINGLE -> modeSingleId
+                DahiHomeSlogan.Mode.RANDOM -> modeRandomId
+                DahiHomeSlogan.Mode.TIME -> modeTimeId
+            },
+        )
+        refreshSingle()
+        refreshRandomChecked()
+        slotsInput?.setText(DahiHomeSlogan.slotsRaw())
+        suppress = false
+        refreshBoxes()
+    }
+
+    private fun refreshBoxes() {
+        val mode = DahiHomeSlogan.mode()
+        singleBox?.visibility = if (mode == DahiHomeSlogan.Mode.SINGLE) View.VISIBLE else View.GONE
+        randomBox?.visibility = if (mode == DahiHomeSlogan.Mode.RANDOM) View.VISIBLE else View.GONE
+        timeBox?.visibility = if (mode == DahiHomeSlogan.Mode.TIME) View.VISIBLE else View.GONE
+        updatePreview()
+    }
+
+    private fun refreshSingle() {
+        val group = singleGroup ?: return
+        val raw = DahiHomeSlogan.raw()
+        val presets = DahiHomeSlogan.presets()
+        val target =
+            when {
+                raw == null -> optionIds.firstOrNull() ?: customId
+                raw.isEmpty() -> offId
+                else -> {
+                    val index = presets.indexOf(raw)
+                    if (index >= 0) optionIds.getOrElse(index) { customId } else customId
+                }
+            }
+        group.check(target)
+        customRow?.visibility = if (target == customId) View.VISIBLE else View.GONE
+        customInput?.setText(if (raw != null && raw !in presets) raw else "")
+    }
+
+    private fun refreshRandomChecked() {
+        suppress = true
+        val pool = DahiHomeSlogan.pool()
+        val presets = DahiHomeSlogan.presets()
+        presetChecks.forEachIndexed { index, check ->
+            check.isChecked = presets.getOrNull(index)?.let { it in pool } ?: false
+        }
+        extraSentences = pool.filter { it !in presets }.toMutableList()
+        suppress = false
+        renderExtras()
+    }
+
+    private fun renderExtras() {
+        val box = extrasBox ?: return
+        val ctx = requireContext()
+        box.removeAllViews()
+        extraSentences.forEach { text ->
+            box.addView(
+                LinearLayout(ctx).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    gravity = Gravity.CENTER_VERTICAL
+                    addView(
+                        TextView(ctx).apply {
+                            this.text = text
+                            setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+                            layoutParams =
+                                LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
+                        },
+                    )
+                    addView(
+                        Button(ctx, null, android.R.attr.borderlessButtonStyle).apply {
+                            setText(R.string.dahi_slogan_remove)
+                            setOnClickListener {
+                                extraSentences.remove(text)
+                                commitPool()
+                                renderExtras()
+                                updatePreview()
+                            }
+                        },
+                    )
+                },
+            )
+        }
+    }
+
+    private fun updatePreview() {
+        val shown = DahiHomeSlogan.resolve()
+        preview?.text =
+            getString(
+                R.string.dahi_slogan_preview,
+                shown.ifEmpty { getString(R.string.dahi_slogan_preview_none) },
+            )
+    }
+
+    // ---------- 用户操作 ----------
+
+    private fun onSingleChecked(checkedId: Int) {
+        val presets = DahiHomeSlogan.presets()
+        val index = optionIds.indexOf(checkedId)
+        when {
+            index >= 0 -> {
+                DahiHomeSlogan.set(presets.getOrElse(index) { presets.first() })
+                customRow?.visibility = View.GONE
+                updatePreview()
+                toast(getString(R.string.dahi_slogan_saved))
+            }
+            checkedId == offId -> {
+                DahiHomeSlogan.set("")
+                customRow?.visibility = View.GONE
+                updatePreview()
+                toast(getString(R.string.dahi_slogan_saved))
+            }
+            checkedId == customId -> {
+                // 只展开输入行；真正写入等用户点「保存」，避免空文本把设置冲掉
+                customRow?.visibility = View.VISIBLE
+                customInput?.requestFocus()
+            }
+        }
+    }
+
+    private fun saveCustom() {
+        val text = customInput?.text?.toString()?.trim().orEmpty()
+        DahiHomeSlogan.set(text)
+        updatePreview()
+        toast(getString(R.string.dahi_slogan_saved))
+    }
+
+    private fun commitPool() {
+        val presets = DahiHomeSlogan.presets()
+        val selected = presets.filterIndexed { index, _ -> presetChecks.getOrNull(index)?.isChecked == true }
+        DahiHomeSlogan.setPool(selected + extraSentences)
+    }
+
+    private fun addExtra() {
+        val text = extraInput?.text?.toString()?.trim().orEmpty()
+        if (text.isEmpty()) return
+        if (text !in extraSentences && text !in DahiHomeSlogan.presets()) {
+            extraSentences.add(text)
+            commitPool()
+            renderExtras()
+            updatePreview()
+        }
+        extraInput?.setText("")
+    }
+
+    private fun saveSlots() {
+        val raw = slotsInput?.text?.toString().orEmpty()
+        DahiHomeSlogan.setSlots(raw)
+        val invalid = DahiHomeSlogan.invalidSlotLines(raw)
+        toast(
+            if (invalid > 0) {
+                getString(R.string.dahi_slogan_slots_invalid, invalid)
+            } else {
+                getString(R.string.dahi_slogan_saved)
+            },
+        )
+        updatePreview()
+    }
+
+    private fun toast(text: String) {
+        if (isAdded) Toast.makeText(requireContext(), text, Toast.LENGTH_SHORT).show()
+    }
+}
diff --git a/app/src/main/java/com/osfans/trime/ui/main/settings/InputStatsFragment.kt b/app/src/main/java/com/osfans/trime/ui/main/settings/InputStatsFragment.kt
