+        val start = order.indexOf(members.first())
+        val end = order.indexOf(members.last())
+        if (start < 0 || end < start) return
+        val newOrder = mutableListOf<String>()
+        newOrder.addAll(order.subList(0, start))
+        newOrder.addAll(newMembers)
+        newOrder.addAll(order.subList(end + 1, order.size))
+        DahiStyleOverlay.setSizeOrder(newOrder)
+        // 重建整区（序号随之重排），再刷值、保持编辑态
+        sizeContainer?.let { buildSizeRows(it) }
